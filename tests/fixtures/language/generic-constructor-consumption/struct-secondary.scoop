package dev.example.consumer.constructors

import dev.example.templates.constructors.*

private class Payload(public val value: Int)

public fun result(): Int {
    val trace = Trace(0)
    val value = Observed<Payload>(Payload(37), trace)
    val _ = Payload(1)
    val _ = Payload(2)
    return value.value.value + trace.count
}

public fun <T> make(value: T): Box<T> = Box<T>(value)
