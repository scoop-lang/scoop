enum Color { Red, Green, Blue }

enum Shape {
    Circle(Int),
    Rect(Int, Int),
    Named { w: Int, h: Int },
    WithDefault(val d: Int = 7)
}

fun main() {
    val c = Color.Red
    when (c) {
        case Red -> println("red")
        case Green -> println("green")
        case Blue -> println("blue")
    }
    val s = Shape.Circle(5)
    when (s) {
        case Circle(val r) -> println(r)
        case Rect(val w, val h) -> println(w + h)
        case Named { val w, .. } -> println(w)
        case WithDefault(val d) -> println(d)
    }
    val r = Shape.Rect(3, 4)
    when (r) {
        case Circle(val x) -> println(x)
        case Rect(val w, val h) -> println(w + h)
        case Named { val w, .. } -> println(w)
        case WithDefault(val d) -> println(d)
    }
    val d = Shape.WithDefault()
    when (d) {
        case WithDefault(val x) -> println(x)
        else -> println("other")
    }
    val d2 = Shape.WithDefault(3)
    when (d2) {
        case WithDefault(val x) -> println(x)
        else -> println("other")
    }
}
