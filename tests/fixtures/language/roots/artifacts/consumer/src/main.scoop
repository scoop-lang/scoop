package dev.m32.roots.consumer
import dev.m32.roots.facade.*

fun main() {
    val boxed: Top = 42
    println(boxed as Int)
    println(blank().size)
    try { never() }
    catch (_: IllegalStateException) { println("generic") }
    try { defaulted() }
    catch (_: IllegalStateException) { println("default") }
    val value = adapted()
    try { value() }
    catch (_: IllegalStateException) { println("adapter") }
    val dynamic: Top = failure()
    println(dynamic is () -> Bottom)
    try { val converted = dynamic as () -> Int; converted() }
    catch (_: IllegalStateException) { println("dynamic") }
    gcCollect()
    println(boxed as Int)
}
