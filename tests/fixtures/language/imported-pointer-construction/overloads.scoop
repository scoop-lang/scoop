package dev.example.consumer.construction

import Ptr as Make
import dev.example.dependency.construction.safely as Make
import dev.example.dependency.construction.IntPointer as Fixed
import dev.example.dependency.construction.shifted as Fixed

public fun <T> exercise(value: T): Int {
    var number = 1
    var _raw = 1uL
    @Unsafe { _raw = addressOf(number).toULong() }
    val ordinary: Ptr<Int> = Make(_raw)
    @Unsafe {
        val fixed: Ptr<Int> = Fixed(_raw)
        if (fixed.toULong() != _raw || ordinary.toULong() != _raw) { return 1 }
        return fixed.load()
    }
}

public fun result(): Int = exercise<Int>(0)
