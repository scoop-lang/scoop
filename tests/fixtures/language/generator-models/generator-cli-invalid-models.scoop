@GenerateWith("scoop.cli", ["CliArguments<Aliases>"])
object AliasesArguments : EntriesOnly<Aliases>
@GenerateWith("scoop.cli", ["CliArguments<Positional>"])
object PositionalArguments : EntriesOnly<Positional>
