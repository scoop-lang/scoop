fun main() {
    try {
        val a = [1, 2]
        println(a[9])
    } catch (_: IndexOutOfBoundsException) {
        println("index")
    }
    try {
        val x: Int? = None
        println(x!!)
    } catch (_: UnwrapException) {
        println("unwrap")
    }
    try {
        val a: Any = 1
        val s = a as String
        println(s)
    } catch (_: ClassCastException) {
        println("cast")
    }
    try {
        println(1 / 0)
    } catch (_: ArithmeticException) {
        println("div")
    }
}
