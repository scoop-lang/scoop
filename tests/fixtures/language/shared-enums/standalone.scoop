package dev.example.consumer.enums
import dev.example.upstream.enums.*

public fun <T> exercise(seed: T, read: (T) -> Int): Int {
    val value: Choice<T> = Choice.Item(seed)
    val selected = when (value) {
        case Empty -> 1
        case Item(val payload) -> read(payload)
        case Named { val payload, .. } -> read(payload)
        case Defaults { val payload, .. } -> read(payload)
    }
    if (selected != 42) { return 1 }
    if (read(select<T>(value, seed)) != 42) { return 2 }
    val defaulted: Choice<T> = Choice.Defaults(seed)
    return when (defaulted) {
        case Defaults { val payload, val amount } -> read(payload) + amount - 2
        else -> 3
    }
}

public fun result(): Int = exercise<Int>(42, { value -> value })
