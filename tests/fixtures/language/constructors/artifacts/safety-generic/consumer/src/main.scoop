package dev.example
fun main() {
    @Unsafe {
        val _box: Box<Int> = Box(42)
        val _alternate: Box<Int> = Box(42, 2)
        val pair: Pair<Int> = Pair(42)
        if (pair.value != 42 || pair.count != 1) { throw IllegalStateException() }
        val _mixed: Mixed = Mixed(42)
        @Safe { val _safe: Mixed = Mixed(true) }
    }
    gcCollect()
}
