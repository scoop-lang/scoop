class Ref()
fun left(label: String, value: Ref): Ref { println(label); return value }
fun fail(): Nothing { throw IllegalStateException() }

fun main() {
    val first = Ref()
    val second = Ref()
    var _selected = first
    println(_selected === if (true) { _selected = second; first } else { second })
    println(_selected !== if (true) { _selected = first; second } else { first })
    println(left("left", _selected) === try {
        println("right")
        _selected = second
        gcCollect()
        first
    } finally { println("cleanup") })
    try {
        println(left("throw-left", first) !== try {
            fail()
        } finally { println("throw-right") })
    } catch (_: IllegalStateException) { println("caught") }
}
