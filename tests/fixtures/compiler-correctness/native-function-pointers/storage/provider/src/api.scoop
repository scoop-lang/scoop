package dev.nativepointers

public typealias Leaf = GCLeafFunPtr<(Int) -> Int>

@CLayout
public struct FunctionTable(val plain: FunPtr<(Int) -> Int>, val leaf: Leaf, val optional: Leaf?)

@Extern(lib = "fixture_native", name = "pointer_table")
public fun table(): FunctionTable

@Extern(lib = "fixture_native", name = "pointer_check_table")
public fun checkTable(value: FunctionTable): Boolean

@Extern(lib = "fixture_native", name = "pointer_check_leaf")
public fun checkLeaf(value: Leaf?): Boolean

public fun <T: value> preserve(value: T): T = value

public fun optional(value: Leaf? = None): Leaf? = value
