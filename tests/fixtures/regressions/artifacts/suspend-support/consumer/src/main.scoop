package test
import test.support.*

class Done : Continuation<Int> {
    public override fun resume(value: Int) { println(value) }
    public override fun resumeWithException(error: Throwable) { throw error }
}

fun main() {
    startCoroutine<Int>({
        val plain = choose(20) { it }
        choose(plain) { throughLambda(direct(after(Counter(), it + 22))) }
    }, Done())
}
