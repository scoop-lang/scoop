package scoop.tests

import scoop.asyncio.*
import scoop.crypto.x509.TrustStore
import scoop.http.client.*
import scoop.time.Duration
import scoop.tls.TlsTrustSource
import scoop.url.Url

private fun progressCheck(value: Boolean) {
    if (!value)
        throw IllegalStateException(Some("redirect network progress check failed"))
}

fun exerciseRedirectNetworkProgress(url: Url, trust: TrustStore) {
    val loop = eventLoop()
    loop.run {
        val scope = this;
        val config =
            httpClientConfig {
                this.tls = httpClientTlsConfig { this.trust = TlsTrustSource.Store(trust) }
            }
        withHttpClient(config) suspend {
            client ->
            client.withResponse(httpRequest(url)) suspend {
                response ->
                response.body.bytes(0L);
                Unit
            }
            val options =
                httpCallOptions {
                    this.timeouts = Some(httpTimeoutOptions { this.connect = Some(Duration.ZERO) })
                }
            try {
                client.execute(
                    httpRequest(url) {
                        this.method = "POST"
                        this.body = RequestBody.fromText("sent")
                        this.options = options
                    }
                ).close()
                progressCheck(false)
            } catch (error: HttpTimeoutException) {
                progressCheck(error.phase == HttpTimeoutPhase.Connect)
                progressCheck(error.limit == Duration.ZERO && error.elapsed >= error.limit)
                progressCheck(error.requestBodyBytes == 4L)
                progressCheck(error.encodedResponseBodyBytes == 0L && error.responseBodyBytes == 0L)
            }
            Unit
        }
        progressCheck(!scope.job.isCancelled)
    }
}
