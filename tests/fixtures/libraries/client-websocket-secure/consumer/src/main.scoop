package scoop.tests

import scoop.asyncio.*
import scoop.tests.scoop.crypto.testdata.*
import scoop.crypto.x509.TrustStore
import scoop.http.*
import scoop.http.asyncio.*
import scoop.http.client.*
import scoop.test.*
import scoop.text.toInt
import scoop.time.Duration
import scoop.tls.*
import scoop.url.Url

fun main(args: Array<String>) {
    try {
        runSecureWs(args[1L], args[2L].toInt())
    }
    catch (error: Exception) {
        eprintln(error.message ?: "secure WebSocket fixture failed");
        throw error
    }
    println("secure client WebSocket case passed: " + args[1L])
}

private fun runSecureWs(mode: String, port: Int) {
    TrustStore.fromPem(rootPem()).use {
        trust -> TlsIdentity.fromPem(clientPem() + intermediatePem(), serverKeyPem()).use {
            identity ->
            val loop = eventLoop()
            loop.run {
                val scope = this;
                val version =
                    if (mode == "mutual" || mode == "no-alpn")
                        TlsVersion.Tls12
                    else
                        TlsVersion.Tls13
                val config =
                    httpClientConfig {
                        this.versionPolicy =
                            if (mode == "h2-only")
                                HttpVersionPolicy.Http2Only
                            else
                                HttpVersionPolicy.Auto
                        this.tls =
                            httpClientTlsConfig {
                                this.trust = TlsTrustSource.Store(trust)
                                this.minimum = version
                                this.maximum = version
                                this.identity =
                                    if (mode == "mutual")
                                        Some(identity)
                                    else
                                        None
                            }
                        this.pool = httpConnectionPoolOptions { this.maxConnectionsPerOrigin = 2L }
                        this.retries = httpRetryOptions { this.maxRetries = 0L }
                        this.timeouts =
                            httpTimeoutOptions { this.poolAcquire = Some(Duration.seconds(5L)) }
                    }
                val client = HttpClient.open(scope, config)
                val url =
                    Url.parse("wss://127.0.0.1:" + port.toString() + "/start/%e9%9b%aa?x=%2f&x=2")
                try {
                    if (mode == "coexist" || mode == "mutual") {
                        val http = url.copy { scheme = Some("https") }.resolve("/hold")
                        client.withResponse(httpRequest(http)) suspend {
                            held ->
                            assertEquals(HttpVersion.Http2, held.head.version)
                            exerciseSecureWs(client, url, mode)
                            assertEquals("hold done", held.body.text(32L))
                        }
                        wsClientProbe(client, url)
                    } else
                        exerciseSecureWs(client, url, mode)
                } finally {
                    client.close()
                }
                assertTrue(client.isClosed)
                assertFalse(scope.job.isCancelled)
            }
        }
    }
}

private suspend fun exerciseSecureWs(client: HttpClient, url: Url, mode: String) {
    val offers =
        if (mode == "deflate")
            [WebSocketDeflateOffer(true, true, Some(15), WebSocketWindowBits.Limit(15))]
        else
            Array<WebSocketDeflateOffer>(0L) { _ -> WebSocketDeflateOffer() }
    val request =
        httpWebSocketRequest(url) {
            this.fields = [HttpField("X-Client".toByteArray(), "scoop".toByteArray())]
        }
    client.withWebSocket(
        request,
        httpWebSocketOptions {
            this.protocols = ["chat"]
            this.deflateOffers = offers
            this.session =
                webSocketSessionOptions {
                    this.outgoingFrameBytes = 7L
                    this.inputBufferBytes = 19L
                }
        }
    ) suspend {
        result -> when (result) {
            case Opened(session) -> {
                assertEquals(Some("wss"), session.url.scheme)
                wsClientSession(
                    client,
                    session,
                    if (mode == "h2-only")
                        "force-h2"
                    else
                        if (mode == "deflate")
                            "deflate"
                        else
                            "plain"
                )
            }
            case Rejected(_, error) -> throw error
        }
    }
}
