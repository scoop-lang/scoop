package scoop.tests

import scoop.asyncio.*
import scoop.http.client.*
import scoop.time.Duration
import scoop.url.Url

internal class TimeoutResult {
    var failure: HttpTimeoutException? = None
}

internal suspend fun timeoutHttp2(client: HttpClient, url: Url, scope: CoroutineScope) {
    val limit = Duration.seconds(15L)
    val result = TimeoutResult()
    val executing =
        scope.launch suspend {
            result.failure =
                Some(
                    timeoutFailure suspend {
                        client.execute(
                            httpRequest(url.resolve("/stalled")) {
                                this.options =
                                    httpCallOptions {
                                        this.timeouts =
                                            Some(
                                                httpTimeoutOptions {
                                                    this.responseHeaders = Some(limit)
                                                }
                                            )
                                    }
                            }
                        );
                        Unit
                    }
                )
        }
    val second = client.execute(httpRequest(url.resolve("/concurrent")))
    executing.join()
    timeoutPhase(result.failure!!, HttpTimeoutPhase.ResponseHeaders, limit)
    timeoutCheck(second.body.text(2L) == "ok");
    second.close()
    client.withResponse(httpRequest(url.resolve("/after"))) suspend {
        response -> timeoutCheck(response.body.text(2L) == "ok")
    }
}
