package scoop.tests

import scoop.asyncio.*
import scoop.tests.scoop.crypto.testdata.rootPem
import scoop.crypto.x509.TrustStore
import scoop.http.client.*
import scoop.test.*
import scoop.text.*
import scoop.tls.TlsTrustSource
import scoop.url.Url

fun main(args: Array<String>) {
    val mode = args[1L]
    if (mode == "invalid-utf8") {
        val error =
            assertFailsWith<CharacterCodingException> { HttpProxySelector.fromEnvironment() }
        assertEquals(0L, error.byteOffset)
    } else {
        TrustStore.fromPem(rootPem()).use {
            trust ->
            val tls = httpClientTlsConfig { this.trust = TlsTrustSource.Store(trust) }
            val selector =
                if (mode == "default")
                    httpClientConfig().proxy
                else
                    HttpProxySelector.fromEnvironment(tls = tls)
            val rewriting = mode.startsWith("redirect-override-")
            val options =
                if (mode == "override" || rewriting)
                    httpCallOptions { this.proxy = Some(HttpProxySelector.direct()) }
                else
                    httpCallOptions()
            val config =
                httpClientConfig {
                    this.tls = tls
                    this.proxy = selector
                    this.retries = httpRetryOptions { this.maxRetries = 0L }
                    this.timeouts =
                        httpTimeoutOptions {
                            this.resolve = None
                            this.connect = None
                            this.tlsHandshake = None
                            this.proxyHandshake = None
                        }
                }
            PlatformEventLoop().run suspend {
                _ -> withHttpClient(config) suspend {
                    client ->
                    val request =
                        if (rewriting)
                            httpRequest(Url.parse(args[2L])) {
                                this.method = "POST"
                                this.body = RequestBody.Empty
                                this.options = options
                            }
                        else
                            httpRequest(Url.parse(args[2L])) { this.options = options }
                    client.withResponse(request) suspend {
                        response ->
                        assertEquals(200U, response.status)
                        assertEquals("environment", response.body.text(32L))
                        assertEquals(0L, response.authenticationCount)
                        assertEquals(0L, response.proxyAuthenticationCount)
                        assertEquals(
                            if (mode == "redirect" || rewriting)
                                1L
                            else
                                0L,
                            response.redirectHistory.size
                        )
                    }
                }
            }
        }
    }
    println("environment proxy " + mode)
}
