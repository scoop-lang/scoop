package scoop.tests

import scoop.asyncio.EventLoop
import scoop.crypto.native.certificateHandle
import scoop.tests.scoop.crypto.testdata.rootPem
import scoop.crypto.x509.Certificate
import scoop.tls.native.*

fun verifyHere(engine: TlsEngine) {
    Certificate.fromPem(rootPem()).use {
        root -> @Unsafe
        {
            val work = engine.takeVerification()
            try {
                check(verifyIsolated(work, certificateHandle(root)) == 1)
                engine.completeVerification(work)
            } finally {
                freeVerification(work)
            }
        }
    }
}

suspend fun verifyOnWorker(loop: EventLoop, engine: TlsEngine) {
    val work =
        Certificate.fromPem(rootPem()).use {
            root -> @Unsafe
            {
                val pointer = newIsolated(engine.takeVerification(), certificateHandle(root))
                return@use pointer
            }
        }
    try {
        gcCollect()
        loop.executor.blocking {
            @Unsafe
            {
                isolatedRun(work)
            }
        }
        @Unsafe
        {
            engine.completeVerification(isolatedResult(work))
        }
    } finally {
        @Unsafe
        {
            isolatedFree(work)
        }
    }
}

@Extern(name = "scoop_test_tls_isolated_verify")
private fun verifyIsolated(work: Ptr<Unit>, root: ULong): Int

@Extern(name = "scoop_test_tls_isolated_work_new")
private fun newIsolated(work: Ptr<Unit>, root: ULong): Ptr<Unit>

@Extern(name = "scoop_test_tls_isolated_work_result")
private fun isolatedResult(work: Ptr<Unit>): Ptr<Unit>

@Extern(name = "scoop_test_tls_isolated_work_run")
private fun isolatedRun(work: Ptr<Unit>)

@Extern(name = "scoop_test_tls_isolated_work_free")
private fun isolatedFree(work: Ptr<Unit>)
