package scoop.tests

import scoop.asyncio.*
import scoop.crypto.x509.TrustStore
import scoop.http.*
import scoop.http.client.*
import scoop.test.*
import scoop.time.Duration
import scoop.tls.TlsTrustSource
import scoop.url.Url

internal fun cookieExternal(trust: TrustStore, mode: String, url: Url, other: Url) {
    eventLoop().run {
        if (mode == "sequence") {
            cookieExternalSequence(trust, url);
            return@run
        }
        val jar = MemoryCookieJar(suffixes = PublicSuffixList.parse("com\n"))
        val target =
            if (mode == "proxy")
                Url.parse("http://origin.invalid/resource")
            else
                url
        cookieSeed(jar, target, "seed=1; Path=/")
        if (mode == "manual")
            cookieSeed(jar, other, "other=2; Path=/")
        val proxy =
            if (mode == "proxy")
                HttpProxySelector.fixed(HttpProxy.Http(HttpProxyEndpoint(url)))
            else
                HttpProxySelector.direct()
        val config =
            httpClientConfig {
                this.tls = httpClientTlsConfig { this.trust = TlsTrustSource.Store(trust) }
                this.cookieJar =
                    if (mode == "default")
                        None
                    else
                        Some(jar)
                this.proxy = proxy
                this.retries = httpRetryOptions { this.maxRetries = 0L }
            }
        withHttpClient(config) suspend {
            client -> if (mode == "proxy") {
                client.withResponse(httpRequest(target)) suspend {
                    response ->
                    assertEquals(407U, response.status)
                    assertEquals("", response.body.text(16L))
                }
                assertEquals(1L, jar.snapshot().size)
                client.withResponse(httpRequest(target)) suspend {
                    response -> assertEquals("done", response.body.text(16L))
                }
                client.withResponse(httpRequest(target)) suspend {
                    response -> assertEquals("done", response.body.text(16L))
                }
                assertEquals(2L, jar.snapshot().size)
            } else {
                val options = httpCallOptions { this.useCookies = mode != "disabled" }
                val request =
                    if (mode == "manual")
                        httpRequest(target) {
                            this.fields = [cookieField("Cookie", "manual=M")]
                            this.options = options
                        }
                    else
                        httpRequest(target) {
                            this.method = "POST"
                            this.body = RequestBody.Empty
                            this.options = options
                        }
                client.withResponse(request) suspend {
                    response ->
                    assertEquals("done", response.body.text(16L))
                    assertEquals(
                        if (mode == "manual")
                            2L
                        else
                            1L,
                        response.redirectHistory.size
                    )
                }
                if (mode != "manual")
                    assertEquals(1L, jar.snapshot().size)
                else
                    Unit
            }
        }
    }
}

private suspend fun cookieExternalSequence(trust: TrustStore, url: Url) {
    val loads = AtomicLong(0L)
    val saves = AtomicLong(0L)
    val informational = AtomicLong(0L)
    val jar =
        CookieCallbacks(
            loading =
                suspend {
                    request ->
                    assertEquals("cookie-callback", cookieMarker())
                    if (loads.fetchAdd(1L) > 0L)
                        assertEquals("GET", request.method)
                },
            saving =
                suspend {
                    _, _ ->
                    assertEquals("cookie-callback", cookieMarker());
                    saves.fetchAdd(1L)
                }
        )
    val provider =
        HttpAuthenticator.basic(url.httpOrigin()) suspend {
            _ -> HttpPasswordCredentials("user", "pass")
        }
    val config =
        httpClientConfig {
            this.tls = httpClientTlsConfig { this.trust = TlsTrustSource.Store(trust) }
            this.cookieJar = Some(jar)
            this.authentication = httpAuthenticationOptions { this.providers = [provider] }
            this.retries =
                httpRetryOptions {
                    this.maxRetries = 1L
                    this.statuses = [503U]
                    this.initialDelay = Duration.ZERO
                    this.maxDelay = Duration.ZERO
                    this.jitter = false
                }
            this.pool = httpConnectionPoolOptions { this.maxConnectionsPerOrigin = 1L }
        }
    context(CookieMarker("cookie-callback")) {
        withHttpClient(config) suspend {
            client ->
            val options =
                httpCallOptions {
                    this.onInformational =
                        suspend {
                            head ->
                            assertEquals(103U, head.status);
                            informational.fetchAdd(1L)
                        }
                }
            client.withResponse(
                httpRequest(url) {
                    this.method = "POST"
                    this.body = RequestBody.Empty
                    this.options = options
                }
            ) suspend {
                response ->
                assertEquals("done", response.body.text(16L))
                assertEquals(1L, response.redirectHistory.size)
                assertEquals(1L, response.authenticationCount)
                assertEquals(1L, response.retryCount)
            }
            client.withResponse(httpRequest(url.resolve("/next"))) suspend {
                response -> assertEquals("done", response.body.text(16L))
            }
        }
    }
    assertEquals(1L, informational.load())
    assertEquals(5L, loads.load())
    assertEquals(5L, saves.load())
    assertEquals(4L, jar.storage.snapshot().size)
}
