package scoop.tests

import scoop.tests.scoop.crypto.testdata.rootPem
import scoop.crypto.x509.TrustStore
import scoop.url.Url

fun main(args: Array<String>) {
    val mode = args[1L]
    TrustStore.fromPem(rootPem()).use {
        trust -> when (mode) {
            case "external" -> cookieExternal(
                trust,
                args[2L],
                Url.parse(args[3L]),
                Url.parse(args[4L])
            )
            else -> throw IllegalArgumentException()
        }
    }
    println("client cookie " + mode)
}
