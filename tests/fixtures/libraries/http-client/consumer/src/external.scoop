package fixture

import scoop.asyncio.*
import fixture.scoop.crypto.testdata.rootPem
import scoop.crypto.x509.TrustStore
import scoop.http.*
import scoop.http.client.*
import scoop.tls.TlsTrustSource
import scoop.url.Url

fun runExternalClient(url: Url) {
    TrustStore.fromPem(rootPem()).use {
        trust ->
        val loop = eventLoop()
        loop.run {
            val config =
                httpClientConfig {
                    this.tls = httpClientTlsConfig { this.trust = TlsTrustSource.Store(trust) }
                }
            withHttpClient(config) suspend {
                client ->
                val information = ArrayList<UInt>()
                val options =
                    httpCallOptions {
                        this.onInformational = suspend { head -> information.add(head.status) }
                    }
                val fields =
                    [
                        HttpField("X-Repeat".toByteArray(), "one".toByteArray()),
                        HttpField("x-repeat".toByteArray(), "two".toByteArray())
                    ]
                val request =
                    httpRequest(url) {
                        this.method = "PATCH"
                        this.fields = fields
                        this.body = RequestBody.fromText("external body 中文")
                        this.options = options
                    }
                client.withResponse(request) suspend {
                    response ->
                    check(response.status == 207U && response.version == HttpVersion.Http11)
                    check(String.fromUtf8(response.head.reason!!) == "Independent response")
                    check(String.fromUtf8(response.body.readAllBytes(100L)) == "Python response 中文")
                    check(response.body.isComplete)
                }
                check(information.size == 1L && information[0L] == 103U)
            }
        }
    }
    println("external HTTP1 client exchange passed")
}
