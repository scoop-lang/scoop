package scoop.tests

import scoop.asyncio.*
import scoop.http.client.*
import scoop.time.Duration
import scoop.url.Url

internal suspend fun networkClear(client: HttpClient, port: String) {
    val zero = Some(Duration.ZERO)
    val dns = Url.parse("http://localhost:" + port + "/dns")
    val ip = Url.parse("http://127.0.0.1:" + port + "/ip")
    val resolve =
        networkFailure suspend {
            client.execute(
                httpRequest(dns) {
                    this.options =
                        httpCallOptions {
                            this.timeouts = Some(httpTimeoutOptions { this.resolve = zero })
                        }
                }
            );
            Unit
        }
    networkPhase(resolve, HttpTimeoutPhase.Resolve, Duration.ZERO)
    val cause = resolve.cause!!
    networkCheck(cause is TcpConnectException)
    if (cause is TcpConnectException) {
        networkCheck(cause.attempts.size == 0L && cause.resolutionFailures.size == 2L)
        for (failure in cause.resolutionFailures)
            networkCheck(failure.cause is TcpResolutionTimeoutException)
    }
    for (url in [dns, ip]) {
        val connect =
            networkFailure suspend {
                client.execute(
                    httpRequest(url) {
                        this.options =
                            httpCallOptions {
                                this.timeouts = Some(httpTimeoutOptions { this.connect = zero })
                            }
                    }
                );
                Unit
            }
        networkPhase(connect, HttpTimeoutPhase.Connect, Duration.ZERO)
        if (url === dns)
            networkCheck(connect.cause!! is TcpConnectTimeoutException)
        else
            when (connect.cause) {
                case Some(_) -> throw IllegalStateException();
                case None -> {}
            }
        client.withResponse(httpRequest(url)) suspend {
            response -> networkCheck(response.body.text(2L) == "ok")
        }
        val allZero =
            httpTimeoutOptions {
                this.resolve = zero
                this.connect = zero
                this.tlsHandshake = zero
            }
        client.withResponse(
            httpRequest(url) { this.options = httpCallOptions { this.timeouts = Some(allZero) } }
        ) suspend { response -> networkCheck(response.body.text(2L) == "ok") }
    }
}

internal suspend fun networkTlsFailure(client: HttpClient, port: String, mode: String) {
    val limit =
        if (mode == "zero-tls")
            Duration.ZERO
        else
            Duration.seconds(15L)
    val options =
        httpTimeoutOptions {
            this.total =
                if (mode == "total")
                    Some(limit)
                else
                    None
            this.tlsHandshake =
                Some(
                    if (mode == "total")
                        Duration.seconds(3600L)
                    else
                        limit
                )
        }
    val started = AtomicBoolean(false)
    val body =
        RequestBody.fromProducer(Some(4L)) suspend {
            _ ->
            started.store(true)
            throw IllegalStateException(Some("a failed handshake started the request body"))
        }
    val error =
        networkFailure suspend {
            client.execute(
                httpRequest(Url.parse("https://127.0.0.1:" + port + "/")) {
                    this.method = "POST"
                    this.body = body
                    this.options = httpCallOptions { this.timeouts = Some(options) }
                }
            );
            Unit
        }
    networkPhase(
        error,
        if (mode == "total")
            HttpTimeoutPhase.Total
        else
            HttpTimeoutPhase.TlsHandshake,
        limit
    )
    networkCheck(!started.load())
}
