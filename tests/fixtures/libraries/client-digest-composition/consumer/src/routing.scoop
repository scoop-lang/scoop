package scoop.tests

import scoop.asyncio.*
import scoop.crypto.x509.TrustStore
import scoop.http.client.*
import scoop.time.Duration
import scoop.tls.TlsTrustSource
import scoop.url.Url

internal fun digestRouting(mode: String, url: Url, trust: TrustStore) {
    val loop = eventLoop()
    loop.run {
        val calls = AtomicLong(0L)
        val algorithms = MutableArray<HttpDigestAlgorithm>(1L) { HttpDigestAlgorithm.Sha256 }
        val provider =
            HttpAuthenticator.digest(
                url.httpOrigin(),
                algorithms = algorithms,
                sendWithoutChallenge = mode != "no-preempt"
            ) suspend {
                _ ->
                calls.fetchAdd(1L)
                digestCheck(digestContext() == "route")
                HttpPasswordCredentials("Mufasa", "Circle of Life")
            }
        algorithms[0L] = HttpDigestAlgorithm.Md5
        withHttpClient(
            httpClientConfig {
                this.tls = httpClientTlsConfig { this.trust = TlsTrustSource.Store(trust) }
                this.authentication = httpAuthenticationOptions { this.providers = [provider] }
                this.retries =
                    httpRetryOptions {
                        this.maxRetries = 1L
                        this.statuses = [503U]
                        this.initialDelay = Duration.ZERO
                        this.maxDelay = Duration.ZERO
                    }
            }
        ) suspend {
            client -> context(DigestContext("route")) {
                val request =
                    if (mode == "routing" || mode == "domain")
                        httpRequest(url) {
                            this.method = "POST"
                            this.body = RequestBody.Empty
                        }
                    else
                        httpRequest(url)
                client.withResponse(request) suspend {
                    response ->
                    digestCheck(response.body.text(4L) == "done")
                    digestCheck(response.authenticationCount == 1L)
                    digestCheck(
                        response.retryCount ==
                            if (mode == "retry")
                                1L
                            else
                                0L
                    )
                    digestCheck(
                        response.redirectHistory.size ==
                            if (mode == "routing" || mode == "domain")
                                3L
                            else
                                0L
                    )
                }
                if (mode == "no-preempt")
                    client.withResponse(httpRequest(url)) suspend {
                        response -> digestCheck(
                            response.authenticationCount == 1L && response.body.text(4L) == "done"
                        )
                    }
                digestCheck(
                    calls.load() ==
                        if (mode == "no-preempt")
                            2L
                        else
                            1L
                )
            }
        }
    }
}
