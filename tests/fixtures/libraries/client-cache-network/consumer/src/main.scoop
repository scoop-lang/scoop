package scoop.tests

import scoop.tests.scoop.crypto.testdata.rootPem
import scoop.crypto.x509.TrustStore
import scoop.platform.fs.Path
import scoop.test.AssertionFailure
import scoop.url.Url

fun main(args: Array<String>) {
    val mode = args[1L]
    TrustStore.fromPem(rootPem()).use {
        trust -> when (mode) {
            case "identity" -> cacheIdentity(trust, Url.parse(args[2L]))
            case "disk" -> cacheDiskNetwork(trust, Url.parse(args[2L]), Path.fromString(args[3L]))
            case "cookies" -> cacheCookies(trust, Url.parse(args[2L]))
            case "digest" -> cacheDigest(trust, Url.parse(args[2L]))
            else -> cacheExternal(trust, mode, Url.parse(args[2L]))
        }
    }
    println("client cache " + mode)
}
