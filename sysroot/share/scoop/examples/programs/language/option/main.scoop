import scoop.*
import scoop.text.toLongOrNone

fun greeting(name: String?): String =
    when (name) {
        case Some(val value) -> f"Hello, ${value}!"
        case None -> "Hello, guest!"
    }

fun main() {
    val name: String? = Some("Ada")
    val missing: String? = None
    println(greeting(name))
    println(greeting(missing))
    println(name?.charLength ?: 0L)

    val raw: String? = Some("42")
    val parsed: Long? = raw.flatMap { it.toLongOrNone() }
    println(parsed.map { it * 2L }.getOrElse { 0L })

    val empty: String? = Some("")
    println(empty.fold({ f"present, scalars=${it.charLength}" }, { "missing" }))
    println(missing.orElse { Some("fallback") }.getOrElse { "guest" })

    when (missing) {
        case Some(val value) -> println(value)
        case None -> Unit
    }
}
