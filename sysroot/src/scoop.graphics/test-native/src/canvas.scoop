package scoop.tests.graphics

/** Draws through public Skia APIs and deliberately leaves nested canvas state. */
@Unsafe
public fun drawNativeMarker(canvas: Ptr<Unit>): Boolean = canvasMarker(canvas)

@Extern(name = "scoop_graphics_test_canvas_marker")
private fun canvasMarker(canvas: Ptr<Unit>): Boolean

/** Reads a single logical point from the real drawing target, for control appearance checks. */
@Unsafe
public fun readNativePixel(canvas: Ptr<Unit>, x: Double, y: Double): Long =
    canvasPixel(canvas, x, y)

@Extern(name = "scoop_graphics_test_canvas_pixel")
private fun canvasPixel(canvas: Ptr<Unit>, x: Double, y: Double): Long

@CLayout
public struct NativeRasterLayerSize(val width: Int, val height: Int)

/** Observes the actual current raster allocation, including a saved offscreen layer. */
@Unsafe
public fun nativeRasterLayerSize(canvas: Ptr<Unit>): NativeRasterLayerSize = rasterLayerSize(canvas)

@Extern(name = "scoop_graphics_test_raster_layer_size")
private fun rasterLayerSize(canvas: Ptr<Unit>): NativeRasterLayerSize
