package scoop.tests.graphics

@Unsafe
public fun testMetalPixelFormat(texture: Ptr<Unit>): ULong = metalPixelFormat(texture)

@Extern(name = "scoop_graphics_test_gpu_metal_format")
private fun metalPixelFormat(texture: Ptr<Unit>): ULong

public class TestMetalWrite private constructor(private var handle: Ptr<Unit>?): Closeable {
    public val isComplete: Boolean get() {
        @Unsafe
        {
            return writeComplete(handle!!)
        }
    }
    public override fun close() {
        when (handle) {
            case Some(val value) -> {
                handle = None;
                @Unsafe
                {
                    writeClose(value)
                }
            }
            case None -> {}
        }
    }
    public companion object {
        @Unsafe
        public fun start(queue: Ptr<Unit>, texture: Ptr<Unit>): TestMetalWrite =
            TestMetalWrite(
                Some(
                    delayedWrite(queue, texture) ?:
                        throw IllegalStateException(Some("delayed Metal write failed"))
                )
            )
    }
}

@Extern(name = "scoop_graphics_test_gpu_delayed_write")
private fun delayedWrite(queue: Ptr<Unit>, texture: Ptr<Unit>): Ptr<Unit>?

@Extern(name = "scoop_graphics_test_gpu_write_complete")
private fun writeComplete(command: Ptr<Unit>): Boolean

@Extern(name = "scoop_graphics_test_gpu_write_close")
private fun writeClose(command: Ptr<Unit>)

/** Real Metal objects for tests that exercise the public cross-Cone target bridge. */
public class TestMetalSurface private constructor(private var handle: Ptr<Unit>?): Closeable {
    @Unsafe
    public fun device(): Ptr<Unit> = metalObject(handle!!, 0)
    @Unsafe
    public fun queue(): Ptr<Unit> = metalObject(handle!!, 1)
    @Unsafe
    public fun texture(): Ptr<Unit> = metalObject(handle!!, 2)
    public override fun close() {
        when (handle) {
            case Some(val value) -> {
                handle = None;
                @Unsafe
                {
                    metalDestroy(value)
                }
            }
            case None -> {}
        }
    }
    public companion object {
        public fun create(width: Int, height: Int): TestMetalSurface {
            @Unsafe
            {
                val pointer =
                    metalCreate(width, height) ?:
                        throw IllegalStateException(Some("Metal device or texture creation failed"))
                return TestMetalSurface(Some(pointer))
            }
        }
    }
}

@Extern(name = "scoop_graphics_test_metal_create")
private fun metalCreate(width: Int, height: Int): Ptr<Unit>?

@Extern(name = "scoop_graphics_test_metal_object")
private fun metalObject(owner: Ptr<Unit>, kind: Int): Ptr<Unit>

@Extern(name = "scoop_graphics_test_metal_destroy")
private fun metalDestroy(owner: Ptr<Unit>)
