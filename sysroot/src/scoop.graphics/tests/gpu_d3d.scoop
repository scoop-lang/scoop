package scoop.graphics

import scoop.graphics.native.RenderTarget
import scoop.graphics.native.windows.D3DContext
import scoop.tests.graphics.TestD3DSurface

internal fun withGpuTestTarget(block: (RenderTarget) -> Unit) {
    TestD3DSurface.create(64, 32).use {
        objects -> @Unsafe
        {
            D3DContext.create(objects.adapter(), objects.device(), objects.queue()).use {
                context -> @Unsafe
                {
                    context.target(objects.texture(), 64, 32, 1.0).use(block)
                }
            }
        }
    }
}
