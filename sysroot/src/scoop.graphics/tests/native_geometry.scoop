package scoop.graphics

import scoop.graphics.native.*
import scoop.test.*
import scoop.tests.graphics.queryNativeGeometry

@Test
private class NativeGeometryTest {
    @Test
    fun `retained native queries preserve transformed holes and viewport after source close`() {
        val geometry =
            RasterSurface(100, 80).use {
                surface -> path(FillRule.EvenOdd) {
                    addRect(Rect(0.0, 0.0, 100.0, 100.0))
                    addRect(Rect(20.0, 20.0, 20.0, 20.0))
                }.use {
                    hole -> surface.draw {
                        canvas ->
                        canvas.translate(10.0, 5.0)
                        canvas.clipPath(hole)
                        @Unsafe
                        {
                            return@draw captureGeometry(canvas, Rect(-20.0, -20.0, 160.0, 160.0))
                        }
                    }
                }
            }
        val retained = retainGeometry(geometry)
        try {
            geometry.close()
            assertNativeHit(retained, Point(15.0, 10.0), 1)
            assertNativeHit(retained, Point(35.0, 30.0), 0)
            assertNativeHit(retained, Point(5.0, 10.0), 0)
            assertNativeHit(retained, Point(99.0, 10.0), 1)
            assertNativeHit(retained, Point(100.0, 10.0), 0)
            assertNativeHit(retained, Point(105.0, 10.0), 0)
            assertNativeHit(retained, Point(15.0, 80.0), 0)
            assertNativeHit(retained, Point(Double.NaN, 10.0), 0)
            @Unsafe
            {
                val local = retained.toLocal(retained.context, 35.0, 30.0)
                assertEquals(1, local.status)
                assertEquals(Point(25.0, 25.0), local.position)
                val full = retained.mapRect(retained.context, Rect(20.0, 20.0, 20.0, 20.0), 0)
                assertEquals(1, full.status)
                assertEquals(Rect(30.0, 25.0, 20.0, 20.0), full.rect)
                assertEquals(
                    0,
                    retained.mapRect(retained.context, Rect(20.0, 20.0, 20.0, 20.0), 1).status
                )
                val partial = retained.mapRect(retained.context, Rect(-20.0, 0.0, 40.0, 20.0), 1)
                assertEquals(1, partial.status)
                assertEquals(Rect(10.0, 5.0, 20.0, 20.0), partial.rect)
                assertEquals(-1, retained.toLocal(retained.context, Double.NaN, 0.0).status)
                assertEquals(
                    -1,
                    retained.mapRect(retained.context, Rect(0.0, 0.0, -1.0, 1.0), 0).status
                )
            }
            assertFailsWith<IllegalStateException> {
                @Unsafe
                {
                    geometry.withNativeGeometry { _ -> Unit }
                }
            }
        } finally {
            geometry.close()
            @Unsafe
            {
                retained.release(retained.context)
            }
        }
    }

    @Test
    fun `native geometry survives an exceptional borrow and rejects singular transforms`() {
        val retained = ArrayList<NativeGeometry>()
        try {
            RasterSurface(20, 20).use {
                surface -> surface.draw {
                    canvas ->
                    canvas.scale(0.0, 1.0)
                    @Unsafe
                    {
                        captureGeometry(canvas, Rect(0.0, 0.0, 10.0, 10.0)).use {
                            geometry -> assertFailsWith<IllegalArgumentException> {
                                @Unsafe
                                {
                                    geometry.withNativeGeometry {
                                        value ->
                                        @Unsafe
                                        {
                                            value.retain(value.context)
                                        }
                                        retained.add(value)
                                        throw IllegalArgumentException(Some("end native borrow"))
                                    }
                                }
                            }
                        }
                    }
                }
            }
            assertEquals(1L, retained.size)
            assertNativeHit(retained[0L], Point(0.0, 5.0), 0)
            @Unsafe
            {
                val value = retained[0L]
                assertEquals(0, value.toLocal(value.context, 0.0, 5.0).status)
                assertEquals(0, value.mapRect(value.context, Rect(0.0, 0.0, 5.0, 5.0), 1).status)
            }
        } finally {
            for (value in retained)
                @Unsafe
                {
                    value.release(value.context)
                }
        }
    }

    @Test
    fun `native rectangle clipping matches rotated scene geometry without changing the snapshot`() {
        RasterSurface(160, 120).use {
            surface -> surface.draw {
                canvas ->
                canvas.translate(30.0, 20.0)
                canvas.rotate(0.3)
                canvas.clipRect(Rect(0.0, 0.0, 70.0, 50.0))
                @Unsafe
                {
                    captureGeometry(canvas, Rect(-20.0, -20.0, 150.0, 130.0)).use {
                        geometry -> @Unsafe
                        {
                            captureGeometry(canvas, Rect(40.0, 20.0, 60.0, 50.0)).use {
                                rectangle -> @Unsafe
                                {
                                    geometry.withNativeGeometry {
                                        native -> @Unsafe
                                        {
                                            val source = Rect(40.0, 20.0, 60.0, 50.0)
                                            val full = native.mapRect(native.context, source, 0)
                                            val clipped = native.mapRect(native.context, source, 1)
                                            assertEquals(1, full.status)
                                            assertEquals(rectangle.bounds, full.rect)
                                            assertEquals(1, clipped.status)
                                            assertEquals(rectangle.visibleBounds!!, clipped.rect)
                                            val point = geometry.toWindow(Point(10.0, 10.0))
                                            assertEquals(
                                                1,
                                                native.contains(native.context, point.x, point.y)
                                            )
                                            val outside =
                                                native.mapRect(
                                                    native.context,
                                                    Rect(100.0, 100.0, 5.0, 5.0),
                                                    1
                                                )
                                            assertEquals(0, outside.status)
                                            assertEquals(
                                                1,
                                                native.contains(native.context, point.x, point.y)
                                            )
                                            assertEquals(
                                                clipped.rect,
                                                native.mapRect(native.context, source, 1).rect
                                            )
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

private fun retainGeometry(geometry: CanvasGeometry): NativeGeometry {
    @Unsafe
    {
        return geometry.withNativeGeometry {
            value -> @Unsafe
            {
                value.retain(value.context)
                return@withNativeGeometry value
            }
        }
    }
}

private fun assertNativeHit(geometry: NativeGeometry, point: Point, expected: Int) {
    @Unsafe
    {
        assertEquals(
            expected,
            queryNativeGeometry(
                geometry.context,
                geometry.retain,
                geometry.release,
                geometry.contains,
                point.x,
                point.y
            )
        )
    }
}
