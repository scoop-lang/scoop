package scoop.graphics.native

import scoop.graphics.Canvas
import scoop.graphics.ownedGraphics

/** Declaring independentTiles promises that native commands can be clipped independently. */
@Unsafe
public fun <T> Canvas.withSkiaCanvas(
    independentTiles: Boolean = false,
    block: (Ptr<Unit>) -> T
): T {
    val borrow =
        ownedGraphics(canvasBorrow(resource.get(), independentTiles), "borrow native canvas")
    return borrow.use {
        value -> @Unsafe
        {
            return@use block(canvasPointer(value.get()))
        }
    }
}

@Extern(name = "scoop_graphics_canvas_borrow")
private fun canvasBorrow(canvas: Ptr<Unit>, independentTiles: Boolean): Ptr<Unit>?

@Extern(name = "scoop_graphics_canvas_pointer")
private fun canvasPointer(borrow: Ptr<Unit>): Ptr<Unit>
