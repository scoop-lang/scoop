package scoop.graphics

/** A canvas borrowed by a render callback. Every operation checks the active scope and owner. */
public class Canvas internal constructor(private val handle: GraphicsResource) {
    private var borrowed = false
    internal val resource: GraphicsResource get() {
        if (borrowed)
            throw IllegalStateException(Some("canvas has an active child scope"))
        return handle
    }
    /** Includes the target DPI root; useful for choosing a raster grid. */
    public val pixelTransform: Transform get() {
        @Unsafe
        {
            val result = canvasPixelTransform(resource.get())
            checkTransform(result)
            return result
        }
    }
    /** Conservative local bounds, not an exact path clip or hit-test result. */
    public val localClipBounds: Rect? get() {
        @Unsafe
        {
            val result = canvasClipBounds(resource.get())
            if (result.found == 0)
                return None
            checkRect(result.rect)
            return Some(result.rect)
        }
    }
    /** Records in an independent local coordinate system, clipped to bounds. */
    public fun recordDrawing(bounds: Rect, block: (Canvas) -> Unit): Drawing {
        checkRect(bounds)
        val pointer = resource.get()
        borrowed = true
        try {
            return recordGraphics(pointer, bounds, block)
        } finally {
            borrowed = false
        }
    }
    public fun drawDrawing(drawing: Drawing) {
        @Unsafe
        {
            graphicsResult(
                canvasDrawing(resource.get(), drawing.resource.get()),
                "draw incompatible drawing"
            )
        }
    }
    public fun isCompatible(drawing: Drawing): Boolean {
        @Unsafe
        {
            return drawingCompatible(resource.get(), drawing.resource.get())
        }
    }
    public fun isCompatible(image: Image): Boolean {
        @Unsafe
        {
            return imageCompatible(resource.get(), image.resource.get())
        }
    }
    /** Creates an independent surface on the same backend without reading pixels. */
    public fun createSurface(
        pixelWidth: Int,
        pixelHeight: Int,
        scale: Double = 1.0
    ): OffscreenSurface = createOffscreen(resource.get(), pixelWidth, pixelHeight, scale)
    /** Borrows a child canvas and restores all state, including on exceptional exit. */
    public fun <T> withState(block: (Canvas) -> T): T {
        val pointer = resource.get()
        @Unsafe
        {
            val child = Canvas(ownedGraphics(canvasScope(pointer), "scope canvas"))
            borrowed = true
            try {
                return block(child)
            } finally {
                try {
                    child.handle.close()
                } finally {
                    borrowed = false
                }
            }
        }
    }
    public fun clear(color: Color) {
        checkColor(color)
        @Unsafe
        {
            graphicsResult(canvasClear(resource.get(), color), "clear canvas")
        }
    }
    public fun save() {
        @Unsafe
        {
            graphicsResult(canvasSave(resource.get(), 1.0, false, None, 0), "save canvas")
        }
    }
    /** Filters the entire group, then applies opacity and blend when restored; no implicit bounds. */
    public fun saveLayer(
        opacity: Double = 1.0,
        filter: ImageFilter? = None,
        blendMode: BlendMode = BlendMode.SrcOver
    ) {
        checkOpacity(opacity)
        @Unsafe
        {
            val pointer =
                when (filter) {
                    case Some(value) -> Some(value.resource.get())
                    case None -> None
                }
            graphicsResult(
                canvasSave(resource.get(), opacity, true, pointer, blendMode.nativeCode()),
                "save layer"
            )
        }
    }
    public fun restore() {
        @Unsafe
        {
            graphicsResult(canvasRestore(resource.get()), "restore without matching save")
        }
    }
    public fun concat(transform: Transform) {
        checkTransform(transform)
        @Unsafe
        {
            graphicsResult(canvasConcat(resource.get(), transform), "canvas transform overflow")
        }
    }
    public fun translate(x: Double, y: Double) {
        concat(Transform.translation(x, y))
    }
    public fun scale(x: Double, y: Double) {
        concat(Transform.scale(x, y))
    }
    public fun rotate(radians: Double) {
        concat(Transform.rotation(radians))
    }
    public fun clipRect(rect: Rect) {
        checkRect(rect)
        @Unsafe
        {
            graphicsResult(canvasClipRect(resource.get(), rect), "clip rectangle")
        }
    }
    public fun clipPath(path: Path) {
        @Unsafe
        {
            graphicsResult(canvasClipPath(resource.get(), path.resource.get()), "clip path")
        }
    }
    public fun drawRect(rect: Rect, paint: Paint = Paint()) {
        shape(0, rect, paint)
    }
    public fun drawOval(rect: Rect, paint: Paint = Paint()) {
        shape(1, rect, paint)
    }
    public fun drawRoundRect(
        rect: Rect,
        radiusX: Double,
        radiusY: Double,
        paint: Paint = Paint()
    ): Unit = drawRoundRect(rect, CornerRadii.all(Size(radiusX, radiusY)), paint)
    public fun drawRoundRect(rect: Rect, radii: CornerRadii, paint: Paint = Paint()) {
        val outline = RoundedOutline(rect, radii).normalized()
        val corners = outline.radii
        val pointer = resource.get()
        paint.withNative {
            value -> @Unsafe
            {
                graphicsResult(
                    canvasRoundRect(
                        pointer,
                        rect,
                        cornerPoint(corners.topLeft),
                        cornerPoint(corners.topRight),
                        cornerPoint(corners.bottomRight),
                        cornerPoint(corners.bottomLeft),
                        value
                    ),
                    "draw rounded rectangle"
                )
            }
        }
    }
    public fun drawCircle(center: Point, radius: Double, paint: Paint = Paint()) {
        checkPoint(center);
        checkScalar(radius)
        requireGraphics(radius >= 0.0, "negative circle radius")
        drawOval(Rect(center.x - radius, center.y - radius, radius * 2.0, radius * 2.0), paint)
    }
    public fun drawLine(start: Point, end: Point, paint: Paint) {
        checkPoint(start);
        checkPoint(end)
        val pointer = resource.get()
        paint.withNative {
            value -> @Unsafe
            {
                graphicsResult(canvasLine(pointer, start, end, value), "draw line")
            }
        }
    }
    public fun drawPath(path: Path, paint: Paint = Paint()) {
        val pointer = resource.get()
        val shape = path.resource.get()
        paint.withNative {
            value -> @Unsafe
            {
                graphicsResult(canvasPath(pointer, shape, value), "draw path")
            }
        }
    }
    public fun drawImage(
        image: Image,
        destination: Rect,
        sampling: ImageSampling = ImageSampling.Linear,
        opacity: Double = 1.0
    ) {
        checkRect(destination);
        checkOpacity(opacity)
        @Unsafe
        {
            graphicsResult(
                canvasImage(
                    resource.get(),
                    image.resource.get(),
                    destination,
                    if (sampling == ImageSampling.Nearest)
                        0
                    else
                        1,
                    opacity
                ),
                "draw image"
            )
        }
    }
    /** Linear sampling may use neighboring source pixels, including a tile's gutter. */
    public fun drawImageRegion(
        image: Image,
        source: Rect,
        destination: Rect,
        sampling: ImageSampling = ImageSampling.Linear,
        opacity: Double = 1.0
    ) {
        checkRect(source)
        checkRect(destination)
        checkOpacity(opacity)
        requireGraphics(
            source.x >=
                0.0 &&
                source.y >=
                0.0 &&
                source.x +
                source.width <=
                image.width.toDouble() &&
                source.y +
                source.height <=
                image.height.toDouble(),
            "image source rectangle is out of bounds"
        )
        @Unsafe
        {
            graphicsResult(
                canvasImageRegion(
                    resource.get(),
                    image.resource.get(),
                    source,
                    destination,
                    if (sampling == ImageSampling.Nearest)
                        0
                    else
                        1,
                    opacity
                ),
                "draw image region"
            )
        }
    }
    private fun shape(kind: Int, rect: Rect, paint: Paint) {
        checkRect(rect)
        val pointer = resource.get()
        paint.withNative {
            value -> @Unsafe
            {
                graphicsResult(canvasShape(pointer, kind, rect, value), "draw shape")
            }
        }
    }
}

internal fun checkOpacity(value: Double) {
    requireGraphics(value.isFinite() && value >= 0.0 && value <= 1.0, "invalid opacity")
}

@CLayout
private struct NativeClipBounds(val found: Int, val rect: Rect)

@Extern(name = "scoop_graphics_canvas_pixel_transform")
private fun canvasPixelTransform(canvas: Ptr<Unit>): Transform

@Extern(name = "scoop_graphics_canvas_clip_bounds")
private fun canvasClipBounds(canvas: Ptr<Unit>): NativeClipBounds

@Extern(name = "scoop_graphics_canvas_drawing")
private fun canvasDrawing(canvas: Ptr<Unit>, drawing: Ptr<Unit>): Int

@Extern(name = "scoop_graphics_drawing_compatible")
private fun drawingCompatible(canvas: Ptr<Unit>, drawing: Ptr<Unit>): Boolean

@Extern(name = "scoop_graphics_image_compatible")
private fun imageCompatible(canvas: Ptr<Unit>, image: Ptr<Unit>): Boolean

@Extern(name = "scoop_graphics_canvas_image_region")
private fun canvasImageRegion(
    canvas: Ptr<Unit>,
    image: Ptr<Unit>,
    source: Rect,
    destination: Rect,
    sampling: Int,
    opacity: Double
): Int

@Extern(name = "scoop_graphics_canvas_clear")
private fun canvasClear(canvas: Ptr<Unit>, color: Color): Int

@Extern(name = "scoop_graphics_canvas_scope")
private fun canvasScope(canvas: Ptr<Unit>): Ptr<Unit>?

@Extern(name = "scoop_graphics_canvas_save")
private fun canvasSave(
    canvas: Ptr<Unit>,
    opacity: Double,
    layer: Boolean,
    filter: Ptr<Unit>?,
    blend: Int
): Int

@Extern(name = "scoop_graphics_canvas_restore")
private fun canvasRestore(canvas: Ptr<Unit>): Int

@Extern(name = "scoop_graphics_canvas_concat")
private fun canvasConcat(canvas: Ptr<Unit>, transform: Transform): Int

@Extern(name = "scoop_graphics_canvas_clip_rect")
private fun canvasClipRect(canvas: Ptr<Unit>, rect: Rect): Int

@Extern(name = "scoop_graphics_canvas_clip_path")
private fun canvasClipPath(canvas: Ptr<Unit>, path: Ptr<Unit>): Int

@Extern(name = "scoop_graphics_canvas_shape")
private fun canvasShape(canvas: Ptr<Unit>, kind: Int, rect: Rect, paint: Ptr<Unit>): Int

@Extern(name = "scoop_graphics_canvas_round_rect")
private fun canvasRoundRect(
    canvas: Ptr<Unit>,
    rect: Rect,
    topLeft: Point,
    topRight: Point,
    bottomRight: Point,
    bottomLeft: Point,
    paint: Ptr<Unit>
): Int

@Extern(name = "scoop_graphics_canvas_line")
private fun canvasLine(canvas: Ptr<Unit>, start: Point, end: Point, paint: Ptr<Unit>): Int

@Extern(name = "scoop_graphics_canvas_path")
private fun canvasPath(canvas: Ptr<Unit>, path: Ptr<Unit>, paint: Ptr<Unit>): Int

@Extern(name = "scoop_graphics_canvas_image")
private fun canvasImage(
    canvas: Ptr<Unit>,
    image: Ptr<Unit>,
    rect: Rect,
    sampling: Int,
    opacity: Double
): Int
