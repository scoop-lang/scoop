/**
 * The terminal exception used for cooperative job cancellation.
 */
public class CancellationException public constructor(): Exception(Some("task was cancelled"))

/**
 * Tracks a coroutine and its structured children. Completion waits for children; cancellation
 * requests propagate to children and registered handlers.
 */
public open class Job internal constructor(
    parent: Job?,
    private val propagatesFailure: Boolean = true
) {
    private val lock: CoroutineLock = CoroutineLock()
    private var parent: Job? = parent
    private val children: ArrayList<Job> = ArrayList<Job>()
    private val completionListeners: CoroutineListeners = CoroutineListeners(lock)
    private val cancellationListeners: CoroutineListeners = CoroutineListeners(lock)
    private var bodyEnded: Boolean = false
    private var completed: Boolean = false
    private var cancelling: Int = 0
    private var cancellation: CancellationException? = None
    private var failure: Throwable? = None

    /**
     * Whether the job and its children have reached a terminal state.
     */
    public val isCompleted: Boolean get() = lock.withLock { completed }
    /**
     * Whether cancellation has been requested for this job.
     */
    public val isCancelled: Boolean get() = lock.withLock { !coroutineAbsent(cancellation) }

    /**
     * Throws the job's cancellation exception when cancellation has been requested.
     */
    public fun ensureActive() {
        val reason = lock.withLock { cancellation }
        when (reason) {
            case Some(val error) -> throw error
            case None -> {}
        }
    }

    /**
     * Requests cancellation of this job and its children. Repeated requests preserve the existing
     * cancellation outcome.
     */
    public fun cancel() {
        requestCancellation(None)
    }

    /**
     * Registers a cancellation handler and returns a disposable registration; an already-cancelled
     * job invokes it immediately.
     */
    public fun invokeOnCancellation(handler: (CancellationException) -> Unit): Disposable {
        val(listener, callNow, tracked) =
            lock.withLock {
                if (!coroutineAbsent(cancellation)) {
                    if (!completed)
                        cancelling += 1
                    return@withLock (
                        CoroutineRegistration(
                            cancellationListeners,
                            { handler(cancellationReason()) }
                        ),
                        true,
                        !completed
                    )
                }
                if (completed) {
                    val entry =
                        CoroutineRegistration(
                            cancellationListeners,
                            { handler(cancellationReason()) }
                        )
                    entry.takeActionLocked()
                    return@withLock (entry, false, false)
                }
                val entry = cancellationListeners.addLocked { handler(cancellationReason()) }
                (entry, false, false)
            }
        if (callNow) {
            try {
                listener.fire()
            }
            catch (error: Throwable) {
                if (!tracked)
                    throw error
                requestCancellation(Some(error))
            } finally {
                if (tracked) {
                    lock.withLock { cancelling -= 1 }
                    tryComplete()
                }
            }
        }
        return listener
    }

    private fun cancellationReason(): CancellationException = lock.withLock { cancellation!! }

    internal fun attach(child: Job) {
        val cancelChild =
            lock.withLock {
                if (bodyEnded)
                    throw IllegalStateException(Some("coroutine scope is closed"))
                children.add(child)
                !coroutineAbsent(cancellation)
            }
        if (cancelChild)
            child.cancel()
    }

    private fun removeChild(child: Job) {
        val done =
            lock.withLock {
                var index = 0L
                while (index < children.size) {
                    if (children[index] === child) {
                        children.removeAt(index)
                        break
                    }
                    index += 1L
                }
                completeLocked()
            }
        publishCompletion(done)
    }

    internal fun finishBody(error: Throwable?) {
        if (coroutineAbsent(error)) {
            val done =
                lock.withLock {
                    bodyEnded = true
                    completeLocked()
                }
            publishCompletion(done)
            return
        }
        lock.withLock {
            bodyEnded = true;
            cancelling += 1
        }
        try {
            when (error) {
                case Some(val reason) -> requestCancellation(Some(reason))
                case None -> {}
            }
        } finally {
            lock.withLock { cancelling -= 1 }
            tryComplete()
        }
    }

    private fun requestCancellation(error: Throwable?) {
        val dispatch: CoroutineCancellation? =
            lock.withLock {
                if (completed)
                    return@withLock None
                var propagate: Throwable? = None
                when (error) {
                    case Some(val reason) -> {
                        if (!(reason is CancellationException) && coroutineAbsent(failure)) {
                            failure = Some(reason)
                            propagate = Some(reason)
                        }
                    }
                    case None -> {}
                }
                if (coroutineAbsent(cancellation))
                    cancellation = Some(CancellationException())
                cancelling += 1
                Some(
                    CoroutineCancellation(
                        parent,
                        propagate,
                        children.toArray(),
                        cancellationListeners.takeLocked()
                    )
                )
            }
        when (dispatch) {
            case None -> return
            case Some(val batch) -> {
                try {
                    when (batch.failure) {
                        case Some(val reason) -> {
                            when (batch.parent) {
                                case Some(val owner) -> if (propagatesFailure)
                                    owner.requestCancellation(Some(reason))
                                case None -> {}
                            }
                        }
                        case None -> {}
                    }
                    for (child in batch.children)
                        child.cancel()
                    if (!coroutineAbsent(batch.listeners))
                        for (listener in batch.listeners!!) {
                            try {
                                listener.fire()
                            }
                            catch (reason: Throwable) {
                                requestCancellation(Some(reason))
                            }
                        }
                } finally {
                    lock.withLock { cancelling -= 1 }
                    tryComplete()
                }
            }
        }
    }

    private fun tryComplete() {
        publishCompletion(lock.withLock { completeLocked() })
    }

    private fun completeLocked(): CoroutineCompletion? {
        if (completed || !bodyEnded || children.size != 0L || cancelling != 0)
            return None
        completed = true
        val owner = parent
        parent = None
        cancellationListeners.clearLocked()
        return Some(CoroutineCompletion(owner, completionListeners.takeLocked()))
    }

    private fun publishCompletion(batch: CoroutineCompletion?) {
        when (batch) {
            case None -> {}
            case Some(val done) -> {
                try {
                    when (done.parent) {
                        case Some(val owner) -> owner.removeChild(this)
                        case None -> {}
                    }
                } finally {
                    notifyCoroutineListeners(done.listeners)
                }
            }
        }
    }

    internal fun onCompletion(action: () -> Unit): Disposable {
        val(listener, ready) =
            lock.withLock {
                if (completed)
                    (CoroutineRegistration(completionListeners, action), true)
                else
                    (completionListeners.addLocked(action), false)
            }
        if (ready)
            listener.fire()
        return listener
    }

    internal fun finalFailure(): Throwable? =
        lock.withLock {
            if (!completed)
                throw IllegalStateException(Some("task has not completed"))
            if (!coroutineAbsent(failure))
                return@withLock failure
            when (cancellation) {
                case Some(val reason) -> Some(reason)
                case None -> None
            }
        }

    internal suspend fun joinUncancelled() {
        if (isCompleted)
            return
        suspendCoroutine<Unit> { continuation -> onCompletion { continuation.resume(Unit) } }
    }

    /**
     * Suspends until this job completes, including its children. Joining does not retrieve a
     * deferred result.
     */
    public suspend fun join() {
        suspendCancellableCoroutine<Unit> {
            continuation ->
            val listener = onCompletion { continuation.tryResume(Unit) }
            continuation.invokeOnCancellation { _ -> listener.dispose() }
        }
    }
}

private class CoroutineCancellation(
    val parent: Job?,
    val failure: Throwable?,
    val children: Array<Job>,
    val listeners: ArrayList<CoroutineRegistration>?
)

private class CoroutineCompletion(
    val parent: Job?,
    val listeners: ArrayList<CoroutineRegistration>?
)
