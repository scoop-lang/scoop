/** One managed coroutine drive, invoked exactly once after submission. */
public interface CoroutineWork {
    public fun run()
}

/** One ordinary managed computation that may block its worker thread. */
public interface BlockingWork {
    public fun run()
}

/** Owns task admission and the queues used by registered computations. */
public interface CoroutineExecutor {
    /** Registers a root task, or a child of an active task on this executor. */
    public fun registerTask(parent: ExecutorTask?): ExecutorTask
}

/** Keeps an executor available until the task and its completion callback have exited. */
public interface ExecutorTask {
    public val executor: CoroutineExecutor

    /** Enqueues one drive; it must never invoke work inline or reject an active task. */
    public fun dispatch(work: CoroutineWork)

    /** Resumes a released drive; an executor may run it during a bounded event turn. */
    public fun dispatchResume(work: CoroutineWork) {
        dispatch(work)
    }

    /** Enqueues one blocking computation with the same lifetime guarantee. */
    public fun dispatchBlocking(work: BlockingWork)

    /** Releases this registration exactly once, after all of its work has exited. */
    public fun complete()
}

/** Raised when an executor can no longer admit the requested task. */
public class ExecutorClosedException public constructor(): Exception(Some("executor is closed"))

// Compiler-generated work uses this ordinary dispatch boundary. The implementation
// owns the drive state; continuations retain only its managed interface reference.
internal interface CoroutineExecutionDriver {
    public fun start(work: CoroutineWork, dispatched: Boolean)
    public fun resume(work: CoroutineWork, external: Boolean)
    public fun task(): ExecutorTask?
}

@Intrinsic("coroutine_current_execution")
internal fun currentCoroutineExecution(): CoroutineExecutionDriver?

@Intrinsic("coroutine_yield")
private suspend fun yieldCoroutineDrive()

/** Checks cancellation and, when an executor is present, yields to its runnable queue. */
public suspend fun yieldCoroutine() {
    ensureActive()
    when (currentExecutorTask()) {
        case Some(_) -> yieldCoroutineDrive()
        case None -> {}
    }
    ensureActive()
}

internal fun currentExecutorTask(): ExecutorTask? =
    when (currentCoroutineExecution()) {
        case Some(val execution) -> execution.task()
        case None -> None
    }

internal fun executorParent(executor: CoroutineExecutor, parent: ExecutorTask?): ExecutorTask? =
    when (parent) {
        case Some(val parent) -> if (parent.executor === executor)
            Some(parent)
        else
            None
        case None -> None
    }

internal fun prepareCoroutineExecution(
    executor: CoroutineExecutor?,
    preferredParent: ExecutorTask?
): CoroutineExecution {
    val registration =
        when (executor) {
            case Some(val executor) -> {
                val parent =
                    when (executorParent(executor, preferredParent)) {
                        case Some(val parent) -> Some(parent)
                        case None -> executorParent(executor, currentExecutorTask())
                    }
                Some(executor.registerTask(parent))
            }
            case None -> None
        }
    return CoroutineExecution(registration)
}

/** Returns the executor selected for the current coroutine, or None for an independent entry. */
public fun currentCoroutineExecutorOrNone(): CoroutineExecutor? =
    when (currentExecutorTask()) {
        case Some(val task) -> Some(task.executor)
        case None -> None
    }
