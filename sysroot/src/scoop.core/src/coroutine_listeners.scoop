// Short state transitions only; callbacks and continuation resumes run unlocked.
internal class CoroutineLock {
    private val held: AtomicBoolean = AtomicBoolean(false)

    private fun acquire() {
        while (!held.compareAndSet(false, true, MemoryOrder.Acquire, MemoryOrder.Relaxed)) {}
    }

    private fun unlock() {
        held.store(false, MemoryOrder.Release)
    }

    internal fun <T> withLock(block: () -> T): T {
        acquire()
        try {
            return block()
        }
        finally {
            unlock()
        }
    }
}

internal class CoroutineListeners(private val lock: CoroutineLock = CoroutineLock()) {
    private var entries: ArrayList<CoroutineRegistration>? = None

    internal fun add(action: () -> Unit): CoroutineRegistration =
        lock.withLock { addLocked(action) }

    // The owning Job can update its state and listeners in one critical section.
    internal fun addLocked(action: () -> Unit): CoroutineRegistration {
        val entry = CoroutineRegistration(this, action)
        if (coroutineAbsent(entries))
            entries = Some(ArrayList<CoroutineRegistration>())
        entries!!.add(entry)
        return entry
    }

    internal fun select(entry: CoroutineRegistration): (() -> Unit)? =
        lock.withLock { selectLocked(entry) }

    private fun selectLocked(entry: CoroutineRegistration): (() -> Unit)? {
        val callback = entry.takeActionLocked()
        when (entries) {
            case None -> {}
            case Some(val values) -> if (!coroutineAbsent(callback)) {
                var index = 0L
                while (index < values.size) {
                    if (values[index] === entry) {
                        values.removeAt(index)
                        break
                    }
                    index += 1L
                }
            }
        }
        return callback
    }

    internal fun take(): ArrayList<CoroutineRegistration>? = lock.withLock { takeLocked() }

    internal fun takeLocked(): ArrayList<CoroutineRegistration>? {
        val result = entries
        entries = None
        return result
    }

    internal fun clear() {
        lock.withLock { clearLocked() }
    }

    internal fun clearLocked() {
        when (takeLocked()) {
            case Some(val values) -> for (entry in values)
                entry.takeActionLocked()
            case None -> {}
        }
    }
}

internal class CoroutineRegistration(
    private val owner: CoroutineListeners,
    action: () -> Unit
): Disposable {
    private var action: (() -> Unit)? = Some(action)

    internal fun takeActionLocked(): (() -> Unit)? {
        val result = action
        action = None
        return result
    }

    internal fun fire() {
        when (owner.select(this)) {
            case Some(val invoke) -> invoke()
            case None -> {}
        }
    }

    public override fun dispose() {
        owner.select(this)
    }
}

internal fun notifyCoroutineListeners(entries: ArrayList<CoroutineRegistration>?) {
    if (coroutineAbsent(entries))
        return
    var failure: Throwable? = None
    for (entry in entries!!) {
        try {
            entry.fire()
        }
        catch (error: Throwable) {
            if (coroutineAbsent(failure))
                failure = Some(error)
        }
    }
    when (failure) {
        case Some(val error) -> throw error
        case None -> {}
    }
}

internal fun <T> coroutineAbsent(value: T?): Boolean =
    when (value) {
        case None -> true
        case Some(_) -> false
    }
