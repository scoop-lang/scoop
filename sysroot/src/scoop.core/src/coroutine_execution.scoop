private const val DRIVE_NEW: Int = 0

private const val DRIVE_RUNNING: Int = 1

private const val DRIVE_IDLE: Int = 2

private const val DRIVE_QUEUED: Int = 3

private const val DRIVE_TAKING: Int = 4

private const val DRIVE_PUBLISHING: Int = 5

private const val DRIVE_DETACHED: Int = 6

private const val DRIVE_READY_INTERNAL: Int = 7

private const val DRIVE_READY_EXTERNAL: Int = 8

private const val DRIVE_FINISHING: Int = 9

private const val DRIVE_FINISHED: Int = 10

private enum CoroutineDriveAction {
    Continue(CoroutineWork)
    Dispatch
    Stop
    Complete(ExecutorTask?)
}

// A drive owns all frame accesses, TaskContext changes and native catch cleanup.
// Results may arrive concurrently, but another drive starts only after run exits.
internal class CoroutineExecution(task: ExecutorTask?): CoroutineExecutionDriver, CoroutineWork {
    private val state = AtomicInt(DRIVE_NEW)
    private var registration: ExecutorTask? = task
    private var pending: CoroutineWork? = None

    // Only the current drive queries its registration. Completion clears it
    // after that drive has left the frame and restored the resumer's context.
    public override fun task(): ExecutorTask? = registration

    public override fun start(work: CoroutineWork, dispatched: Boolean) {
        val initial =
            if (dispatched)
                DRIVE_DETACHED
            else
                DRIVE_RUNNING
        if (!state.compareAndSet(DRIVE_NEW, initial, MemoryOrder.AcqRel, MemoryOrder.Acquire))
            throw IllegalStateException(Some("coroutine already started"))
        if (dispatched) {
            pending = Some(work)
            state.store(DRIVE_QUEUED, MemoryOrder.Release)
            schedule()
        } else {
            drive(work)
        }
    }

    public override fun resume(work: CoroutineWork, external: Boolean) {
        var current = state.load(MemoryOrder.Acquire)
        while (true) {
            val claimed =
                when (current) {
                    DRIVE_RUNNING -> DRIVE_PUBLISHING
                    DRIVE_IDLE -> DRIVE_DETACHED
                    else -> throw IllegalStateException(Some("coroutine is not waiting"))
                }
            val observed =
                state.compareAndExchange(current, claimed, MemoryOrder.AcqRel, MemoryOrder.Acquire)
            if (observed == current)
                break
            current = observed
        }
        pending = Some(work)
        if (current == DRIVE_IDLE) {
            state.store(DRIVE_QUEUED, MemoryOrder.Release)
            schedule()
            return
        }
        val ready =
            if (external)
                DRIVE_READY_EXTERNAL
            else
                DRIVE_READY_INTERNAL
        when (
            state.compareAndExchange(
                DRIVE_PUBLISHING,
                ready,
                MemoryOrder.AcqRel,
                MemoryOrder.Acquire
            )
        ) {
            DRIVE_PUBLISHING -> {}
            DRIVE_DETACHED -> {
                state.store(DRIVE_QUEUED, MemoryOrder.Release)
                schedule()
            }
            DRIVE_FINISHED -> {
                // The failed drive retired its registration while publication
                // was in flight. Only this publisher may clear the slot now.
                pending = None
            }
            else -> throw IllegalStateException(Some("coroutine lost its pending publication"))
        }
    }

    internal fun finish() {
        if (
            !state.compareAndSet(
                DRIVE_RUNNING,
                DRIVE_FINISHING,
                MemoryOrder.AcqRel,
                MemoryOrder.Acquire
            )
        )
            throw IllegalStateException(Some("coroutine has no unfinished drive"))
    }

    public override fun run() {
        if (
            !state.compareAndSet(
                DRIVE_QUEUED,
                DRIVE_TAKING,
                MemoryOrder.AcqRel,
                MemoryOrder.Acquire
            )
        )
            throw IllegalStateException(Some("coroutine work is not queued"))
        val work = pending!!
        pending = None
        state.store(DRIVE_RUNNING, MemoryOrder.Release)
        drive(work)
    }

    private fun schedule() {
        // Acquire the registration before dispatch can run and finish elsewhere.
        when (registration) {
            case Some(val task) -> task.dispatch(this)
            case None -> run()
        }
    }

    private fun drive(initial: CoroutineWork) {
        var work = initial
        while (true) {
            val next =
                try {
                    work.run()
                    afterDrive()
                } catch (error: Throwable) {
                    completeRegistration(abortDrive())
                    throw error
                }
            when (next) {
                case CoroutineDriveAction.Continue(val nextWork) -> work = nextWork
                case CoroutineDriveAction.Dispatch -> {
                    schedule();
                    return
                }
                case CoroutineDriveAction.Stop -> return
                case CoroutineDriveAction.Complete(val task) -> {
                    completeRegistration(task);
                    return
                }
            }
        }
    }

    private fun afterDrive(): CoroutineDriveAction {
        var current = state.load(MemoryOrder.Acquire)
        while (true) {
            when (current) {
                DRIVE_RUNNING, DRIVE_PUBLISHING -> {
                    val released =
                        if (current == DRIVE_RUNNING)
                            DRIVE_IDLE
                        else
                            DRIVE_DETACHED
                    val observed =
                        state.compareAndExchange(
                            current,
                            released,
                            MemoryOrder.AcqRel,
                            MemoryOrder.Acquire
                        )
                    if (observed == current)
                        return CoroutineDriveAction.Stop
                    current = observed
                }
                DRIVE_READY_INTERNAL, DRIVE_READY_EXTERNAL -> {
                    if (current == DRIVE_READY_EXTERNAL && !coroutineAbsent(registration)) {
                        state.store(DRIVE_QUEUED, MemoryOrder.Release)
                        return CoroutineDriveAction.Dispatch
                    }
                    val work = pending!!
                    pending = None
                    state.store(DRIVE_RUNNING, MemoryOrder.Release)
                    return CoroutineDriveAction.Continue(work)
                }
                DRIVE_FINISHING -> {
                    val task = registration
                    registration = None
                    state.store(DRIVE_FINISHED, MemoryOrder.Release)
                    return CoroutineDriveAction.Complete(task)
                }
                else -> throw IllegalStateException(Some("coroutine lost its active drive"))
            }
        }
    }

    private fun abortDrive(): ExecutorTask? {
        val previous = state.exchange(DRIVE_FINISHED, MemoryOrder.AcqRel)
        if (previous != DRIVE_PUBLISHING && previous != DRIVE_DETACHED)
            pending = None
        val task = registration
        registration = None
        return task
    }

    private fun completeRegistration(task: ExecutorTask?) {
        when (task) {
            case Some(val task) -> task.complete()
            case None -> {}
        }
    }
}

internal class ExecutionCompletion<T>(
    private val execution: CoroutineExecution,
    private val completion: Continuation<T>
): Continuation<T> {
    public override fun resume(value: T) {
        try {
            completion.resume(value)
        }
        finally {
            execution.finish()
        }
    }

    public override fun resumeWithException(exception: Throwable) {
        try {
            completion.resumeWithException(exception)
        }
        finally {
            execution.finish()
        }
    }
}
