package test.core.tests.executors

import scoop.test.*

private suspend fun callChain(gate: DriveGate, depth: Int): Int =
    if (depth == 0)
        gate.await()
    else
        callChain(gate, depth - 1) + 1

private suspend fun failingCallChain(gate: DriveGate, depth: Int, cleaned: ArrayList<Int>): Int {
    try {
        return if (depth == 0)
            gate.await()
        else
            failingCallChain(gate, depth - 1, cleaned) + 1
    } finally {
        gcCollect()
        cleaned.add(depth)
    }
}

@Test
private class CoroutineExecutorDriveTest {
    @Test
    fun `external resumes queue once and internal completions share the drive`() {
        val executor = QueueExecutor()
        val gate = DriveGate()
        val done =
            DriveCompletion<Int> {
                value ->
                assertEquals(42, value)
                assertEquals(7, markerNumber())
                assertSame(executor, currentCoroutineExecutorOrNone()!!)
                assertEquals(1, executor.active)
            }
        context(DriveMarker(7)) {
            startDispatchedCoroutine(
                executor,
                {
                    assertEquals(7, markerNumber())
                    assertSame(executor, currentCoroutineExecutorOrNone()!!)
                    callChain(gate, 32)
                },
                done
            )
        }
        assertEquals(0, done.calls)
        assertEquals(1L, executor.queued)
        gcCollect()
        context(DriveMarker(9)) {
            executor.runOne()
            assertEquals(9, markerNumber())
            assertEquals(0L, executor.queued)
            gcCollect()
            gate.waiter!!.resume(10)
            assertEquals(0, done.calls)
            assertEquals(1L, executor.queued)
            var duplicate = false
            try {
                gate.waiter!!.resume(99)
            }
            catch (error: IllegalStateException) {
                duplicate = true
            }
            assertTrue(duplicate)
            executor.runOne()
            assertEquals(9, markerNumber())
        }
        assertEquals(1, done.calls)
        assertEquals(42, done.value!!)
        assertEquals(2, executor.submitted)
        assertEquals(0, executor.active)
        assertEquals(1, executor.completed)
        assertTrue(
            when (currentCoroutineExecutorOrNone()) {
                case None -> true;
                else -> false
            }
        )
    }

    @Test
    fun `synchronous completion is consumed without a second dispatch`() {
        val executor = QueueExecutor()
        val done = DriveCompletion<Int>()
        startDispatchedCoroutine(
            executor,
            { suspendCoroutine<Int> { next -> next.resume(42) } },
            done
        )
        executor.runOne()
        assertEquals(42, done.value!!)
        assertEquals(1, done.calls)
        assertEquals(1, executor.submitted)
        assertEquals(0, executor.active)
    }

    @Test
    fun `another execution on the same executor still queues its result`() {
        val executor = QueueExecutor()
        val gate = DriveGate()
        val first = DriveCompletion<Int>()
        val second = DriveCompletion<Int>()
        context(DriveMarker(7)) {
            startDispatchedCoroutine(
                executor,
                {
                    val value = callChain(gate, 2)
                    assertEquals(7, markerNumber())
                    value
                },
                first
            )
        }
        context(DriveMarker(9)) {
            executor.runOne()
            assertEquals(0, first.calls)
            context(DriveMarker(8)) {
                startDispatchedCoroutine(
                    executor,
                    {
                        gate.waiter!!.resume(40)
                        assertEquals(0, first.calls)
                        assertEquals(1L, executor.queued)
                        assertEquals(2, executor.active)
                        assertEquals(8, markerNumber())
                        20
                    },
                    second
                )
            }
            executor.runOne()
            assertEquals(9, markerNumber())
            assertEquals(20, second.value!!)
            assertEquals(0, first.calls)
            gcCollect()
            executor.runOne()
            assertEquals(9, markerNumber())
        }
        assertEquals(42, first.value!!)
        assertEquals(1, first.calls)
        assertEquals(1, second.calls)
        assertEquals(3, executor.submitted)
        assertEquals(2, executor.completed)
        assertEquals(0, executor.active)
    }

    @Test
    fun `failed completion chains retain the exception and finish every cleanup`() {
        val executor = QueueExecutor()
        val gate = DriveGate()
        val failure = Throwable()
        val cleaned = ArrayList<Int>()
        val done = DriveCompletion<Int>()
        startDispatchedCoroutine(executor, { failingCallChain(gate, 32, cleaned) }, done)
        executor.runOne()
        gcCollect()
        gate.waiter!!.resumeWithException(failure)
        assertEquals(0L, cleaned.size)
        assertEquals(0, done.calls)
        executor.runOne()
        assertEquals(33L, cleaned.size)
        var index = 0L
        while (index < cleaned.size) {
            assertEquals(index.toInt(), cleaned[index])
            index += 1L
        }
        assertSame(failure, done.failure!!)
        assertEquals(1, done.calls)
        assertEquals(2, executor.submitted)
        assertEquals(1, executor.completed)
        assertEquals(0, executor.active)
    }

    @Test
    fun `failed resume runs cleanup before releasing its registration`() {
        val executor = QueueExecutor()
        val gate = DriveGate()
        val failure = Throwable()
        val done = DriveCompletion<Int>()
        val cleaned = AtomicBoolean(false)
        startDispatchedCoroutine(
            executor,
            {
                try {
                    gate.await()
                }
                finally {
                    assertSame(executor, currentCoroutineExecutorOrNone()!!)
                    assertEquals(1, executor.active)
                    cleaned.store(true)
                }
            },
            done
        )
        executor.runOne()
        gate.waiter!!.resumeWithException(failure)
        assertFalse(cleaned.load())
        assertEquals(1, executor.active)
        executor.runOne()
        assertTrue(cleaned.load())
        assertSame(failure, done.failure!!)
        assertEquals(1, done.calls)
        assertEquals(0, executor.active)
    }

    @Test
    fun `completion exceptions retire once and restore the caller context`() {
        completionThrows(false)
        completionThrows(true)
    }

    private fun completionThrows(delayed: Boolean) {
        val executor = QueueExecutor()
        val gate = DriveGate()
        val failure = Throwable()
        val done =
            DriveCompletion<Int> {
                _ ->
                assertEquals(3, markerNumber())
                assertEquals(1, executor.active)
                throw failure
            }
        context(DriveMarker(3)) {
            startDispatchedCoroutine(
                executor,
                {
                    if (delayed)
                        gate.await()
                    else
                        42
                },
                done
            )
        }
        var caught = false
        context(DriveMarker(9)) {
            try {
                executor.runOne()
                if (delayed) {
                    assertEquals(0, done.calls)
                    gate.waiter!!.resume(42)
                    executor.runOne()
                }
            }
            catch (error: Throwable) {
                assertSame(failure, error);
                caught = true
            }
            assertEquals(9, markerNumber())
        }
        assertTrue(caught)
        assertEquals(1, done.calls)
        assertEquals(0, executor.active)
        assertEquals(1, executor.completed)
        assertTrue(
            when (done.failure) {
                case None -> true;
                else -> false
            }
        )
    }

    @Test
    fun `nested starts inherit the executor and register a child`() {
        val executor = QueueExecutor()
        val child = DriveCompletion<Int>()
        val done = DriveCompletion<Int>()
        startDispatchedCoroutine(
            executor,
            {
                startCoroutine(
                    {
                        assertSame(executor, currentCoroutineExecutorOrNone()!!)
                        assertEquals(2, executor.active)
                        40
                    },
                    child
                )
                assertEquals(1, executor.active)
                child.value!! + 2
            },
            done
        )
        executor.runOne()
        assertEquals(42, done.value!!)
        assertEquals(2L, executor.parents.size)
        assertTrue(
            when (executor.parents[0L]) {
                case None -> true;
                else -> false
            }
        )
        assertTrue(
            when (executor.parents[1L]) {
                case Some(_) -> true;
                else -> false
            }
        )
        assertEquals(1, executor.submitted)
        assertEquals(2, executor.completed)
        assertEquals(0, executor.active)
    }
}
