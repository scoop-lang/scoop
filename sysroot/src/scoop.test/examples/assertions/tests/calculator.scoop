package examples.testing

import scoop.test.*

@Test
private class CalculatorTests {
    @Test
    fun `division returns a value`() {
        assertEquals(6, divide(42, 7))
        assertTrue(divide(42, 7) > 0)
    }

    @Test
    fun `zero count reports the reason`() {
        val error = assertFailsWith<IllegalArgumentException> { divide(42, 0) }
        assertEquals(Some("count must not be zero"), error.message)
    }

    @Test
    fun `empty ordinary and maximum totals preserve their values`() {
        assertEquals(0L, sumNonnegativeMillis([]))
        assertEquals(12L, sumNonnegativeMillis([5L, 7L]))
        assertEquals(Long.MAX_VALUE, sumNonnegativeMillis([Long.MAX_VALUE, 0L]))
    }

    @Test
    fun `negative milliseconds are rejected`() {
        val error =
            assertFailsWith<IllegalArgumentException> {
                sumNonnegativeMillis([Long.MAX_VALUE, -1L])
            }
        assertEquals(Some("milliseconds must be nonnegative"), error.message)
    }

    @Test
    fun `individually valid values can overflow the total`() {
        val error =
            assertFailsWith<IllegalArgumentException> { sumNonnegativeMillis([Long.MAX_VALUE, 1L]) }
        assertEquals(Some("total milliseconds exceed Long range"), error.message)
    }
}
