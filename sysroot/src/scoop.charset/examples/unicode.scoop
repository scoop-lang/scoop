//! dep: scoop:scoop.charset:0.1.0

import scoop.charset.*

fun main() {
    val decomposed = "Jose\u{0301}"
    val normalized = normalizeNfc(decomposed)
    println(normalized)
    println(f"before=${decomposed.charLength}, after=${normalized.charLength}")

    println(f"terminal Unicode ${unicodeTerminalDataVersion()}")
    println(
        f"ambiguous width: ${unicodeTextWidth("·")} / ${
            unicodeTextWidth("·", ambiguousAsWide = true)
        }"
    )

    for (cluster in graphemes("A👩‍💻e\u{0301}")) {
        println(f"${cluster}: ${unicodeTextWidth(cluster)} columns")
    }
}
