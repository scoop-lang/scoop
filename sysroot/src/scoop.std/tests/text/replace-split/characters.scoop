package scoop.std.tests.text.replace_split

import scoop.collections.joinToString
import scoop.test.*
import scoop.text.*

@Test
private class CharacterSplitTests {
    @Test
    fun `character splitting retains empty fields and the limited suffix`() {
        assertEquals("|a||", ",a,,".split(',').joinToString("|"))
        assertEquals("|雪|", "😀雪😀".split('😀').joinToString("|"))
        assertEquals("|a,,", ",a,,".split(',', 2L).joinToString("|"))
        assertEquals("a,", "a,".split(',', 1L)[0L])
        assertEquals("", "".split(',')[0L])
        assertEquals("unchanged", "unchanged".split(',')[0L])
        assertEquals(1025L, "雪😀".repeat(1024L).split('😀').size)
    }

    @Test
    fun `character and literal splitting agree on scalar values and limits`() {
        for (input in ["", ",a,,", "plain", "😀雪😀", "a\u0000b\u0000", "é,e\u0301,雪"])
            for (delimiter in [',', '😀', '雪', '\u0000', '\u0301', 'é'])
                for (limit in [0L, 1L, 2L, 3L, Long.MAX_VALUE]) {
                    val actual = input.split(delimiter, limit)
                    val expected = input.split(delimiter.toString(), limit)
                    assertEquals(expected.size, actual.size)
                    var index = 0L
                    while (index < expected.size) {
                        assertEquals(expected[index], actual[index])
                        index += 1L
                    }
                    assertFalse(actual is MutableList<String>)
                }
        for (limit in [-1L, Long.MIN_VALUE]) {
            try {
                "".split(',', limit)
                fail(Some("negative split limit accepted"))
            } catch (_: IllegalArgumentException) {}
        }
    }
}
