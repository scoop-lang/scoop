package scoop.text

import scoop.collections.toList

/**
 * Splits on a nonempty literal delimiter, retaining empty fields. Zero limit is unbounded; a
 * positive limit leaves the unsplit remainder in the last field.
 */
public fun String.split(delimiter: String, limit: Long = 0L): List<String> {
    if (limit < 0L || delimiter.byteLength == 0L)
        throw IllegalArgumentException(Some("invalid split delimiter or limit"))
    val chars = toCharArray()
    val pattern = TextPattern(delimiter)
    val result = ArrayList<String>()
    var start = 0L
    var index = 0L
    var matched = 0L
    while (index < chars.size && (limit == 0L || result.size < limit - 1L)) {
        matched = pattern.advance(matched, chars[index])
        index += 1L
        if (matched == pattern.size) {
            result.add(textRange(chars, start, index - pattern.size))
            start = index
            matched = 0L
        }
    }
    result.add(textRange(chars, start, chars.size))
    return result.toList()
}

/**
 * Splits on a nonempty literal delimiter, retaining empty fields. Zero limit is unbounded; a
 * positive limit leaves the unsplit remainder in the last field.
 */
public fun String.split(delimiter: Char, limit: Long = 0L): List<String> {
    if (limit < 0L)
        throw IllegalArgumentException(Some("invalid split delimiter or limit"))
    if (limit == 1L || byteLength == 0L)
        return [this]
    val chars = toCharArray()
    val result = ArrayList<String>()
    var start = 0L
    var index = 0L
    while (index < chars.size && (limit == 0L || result.size < limit - 1L)) {
        if (chars[index] == delimiter) {
            result.add(
                if (start == index)
                    ""
                else
                    textRange(chars, start, index)
            )
            start = index + 1L
        }
        index += 1L
    }
    if (start == 0L)
        return [this]
    result.add(
        if (start == chars.size)
            ""
        else
            textRange(chars, start, chars.size)
    )
    return result.toList()
}
