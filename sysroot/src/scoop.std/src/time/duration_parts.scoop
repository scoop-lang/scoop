package scoop.time

internal struct DurationParts(val negative: Boolean, val seconds: ULong, val nanos: Int) {
    internal fun negated(): DurationParts = DurationParts(!negative, seconds, nanos)
}

internal fun normalizeDuration(seconds: Long, adjustment: Long): (Long, Int) {
    var extra = adjustment / 1000000000L
    var nanos = adjustment % 1000000000L
    if (nanos < 0L) {
        extra -= 1L;
        nanos += 1000000000L
    }
    val result = seconds + extra
    if (((seconds xor result) and (extra xor result)) < 0L)
        throw ArithmeticException()
    return (result, nanos.toInt())
}

internal fun durationParts(value: Duration): DurationParts {
    if (value.floorSeconds >= 0L)
        return DurationParts(false, value.floorSeconds.toULong(), value.nanosecondsOfSecond)
    if (value.nanosecondsOfSecond == 0)
        return DurationParts(true, -value.floorSeconds.toULong(), 0)
    return DurationParts(
        true,
        -(value.floorSeconds + 1L).toULong(),
        1000000000 - value.nanosecondsOfSecond
    )
}

internal fun durationWholeUnits(parts: DurationParts, unitsPerSecond: ULong): Long {
    val limit =
        if (parts.negative)
            0x8000000000000000uL
        else
            0x7fffffffffffffffuL
    val fraction = parts.nanos.toULong() / (1000000000uL / unitsPerSecond)
    if (parts.seconds > (limit - fraction) / unitsPerSecond)
        throw ArithmeticException()
    val value = parts.seconds * unitsPerSecond + fraction
    return (
        if (parts.negative)
            -value
        else
            value
    ).toLong()
}
