package scoop.url

import scoop.text.*

/** Configures an empty URI reference and returns an independent immutable URL. */
public fun url(configure: UrlBuilder.() -> Unit = {}): Url {
    val builder = UrlBuilder()
    builder.configure()
    return builder.snapshot()
}

/**
 * Mutable URI components used by url and Url.copy. Encoded properties preserve escaped data;
 * raw-text operations encode their input. Each entry point validates the assembled reference.
 */
public class UrlBuilder internal constructor() {
    private var configuredScheme: String? = None
    private var configuredHost: String? = None
    private var configuredUserInfo: String? = None
    private var configuredPort: Int? = None
    private var configuredPath: String = ""
    private var configuredQuery: String? = None
    private var configuredFragment: String? = None
    private val reusable: ArrayList<UrlAuthority> = ArrayList<UrlAuthority>()

    /** The scheme, normalized to ASCII lowercase; None produces a relative reference. */
    public var scheme: String?
    get() = configuredScheme
    set(value) {
        configuredScheme =
            if (value == None)
                None
            else
                Some(canonicalEncoded(value!!, UrlComponent.Scheme).lowercaseAscii())
    }

    /** The encoded host, including brackets for IP literals; None removes the host. */
    public var encodedHost: String?
    get() = configuredHost
    set(value) {
        configuredHost = encodedOptional(value, UrlComponent.Host)
    }

    /** Encoded user information, or None to clear it. */
    public var encodedUserInfo: String?
    get() = configuredUserInfo
    set(value) {
        configuredUserInfo = encodedOptional(value, UrlComponent.UserInfo)
    }

    /** An explicit port in 0..65535, or None to omit it. */
    public var port: Int?
    get() = configuredPort
    set(value) {
        if (value != None && (value!! < 0 || value!! > 65535))
            urlError(UrlComponent.Port, "port must be in 0..65535")
        configuredPort = value
    }

    /** The complete encoded path, retaining escaped reserved characters as data. */
    public var encodedPath: String
    get() = configuredPath
    set(value) {
        configuredPath = canonicalEncoded(value, UrlComponent.Path)
    }

    /** The encoded query without a leading question mark; None differs from an empty query. */
    public var encodedQuery: String?
    get() = configuredQuery
    set(value) {
        configuredQuery = encodedOptional(value, UrlComponent.Query)
    }

    /** The encoded fragment without a leading hash; None differs from an empty fragment. */
    public var encodedFragment: String?
    get() = configuredFragment
    set(value) {
        configuredFragment = encodedOptional(value, UrlComponent.Fragment)
    }

    /** Encodes a raw Unicode host, adding brackets around a bare IPv6 address. */
    public fun host(value: String) {
        val encoded = encodeUrlBytes(value.toByteArray(), false, "[]:")
        configuredHost =
            Some(
                if (encoded.contains(':') && !encoded.startsWith('['))
                    "[" + encoded + "]"
                else
                    encoded
            )
    }

    /** Replaces all authority components, or clears host, user information and port together. */
    public fun encodedAuthority(value: String?) {
        if (value == None) {
            configuredHost = None
            configuredUserInfo = None
            configuredPort = None
            return
        }
        val parsed = Url.parse("//" + value!!)
        if (
            parsed.encodedPath.charLength !=
                0L ||
                parsed.encodedQuery !=
                None ||
                parsed.encodedFragment !=
                None
        )
            urlError(UrlComponent.Authority, "authority must not contain a path, query or fragment")
        copyAuthority(parsed.authority!!)
    }

    /** Encodes raw user information, or clears it when value is None. */
    public fun userInfo(value: String?) {
        encodedUserInfo =
            if (value == None)
                None
            else
                Some(PercentEncoding.encode(value!!))
    }

    /** Encodes a complete raw path, preserving slashes as path separators. */
    public fun path(value: String) {
        encodedPath = encodeUrlBytes(value.toByteArray(), false, "/!$&'()*+,;=:@")
    }

    /** Appends one raw segment, encoding separators and dot or dot-dot segments as data. */
    public fun appendPathSegment(value: String) {
        val encoded =
            if (value == ".")
                "%2E"
            else
                if (value == "..")
                    "%2E%2E"
                else
                    PercentEncoding.encode(value)
        appendEncodedPathSegment(encoded)
    }

    /** Appends an encoded segment without accepting literal structural separators. */
    public fun appendEncodedPathSegment(value: String) {
        val segment = canonicalEncoded(value, UrlComponent.Path)
        if (segment.contains('/') || segment.contains('?') || segment.contains('#'))
            urlError(
                UrlComponent.Path,
                "an encoded path segment cannot contain structural separators"
            )
        if (
            (configuredPath.charLength == 0L && configuredHost != None) ||
                (configuredPath.charLength > 0L && !configuredPath.endsWith('/'))
        )
            configuredPath += "/"
        configuredPath += segment
    }

    /** Encodes whole raw query text without interpreting name/value pairs; None clears it. */
    public fun query(value: String?) {
        encodedQuery =
            if (value == None)
                None
            else
                Some(PercentEncoding.encode(value!!))
    }

    /** Replaces the query using ordinary URI parameter serialization. */
    public fun queryParameters(value: UrlQuery) {
        encodedQuery = Some(value.toString())
    }

    /** Encodes a raw fragment, or clears it when value is None. */
    public fun fragment(value: String?) {
        encodedFragment =
            if (value == None)
                None
            else
                Some(PercentEncoding.encode(value!!))
    }

    internal fun snapshot(): Url {
        @Unsafe
        {
            val result = urlEmpty()
            checkUriCode(result.code, UrlComponent.Reference)
            val handle = result.value!!
            try {
                if (configuredScheme != None)
                    setNativeUrlPart(handle, 0, configuredScheme, UrlComponent.Scheme)
                if (configuredHost != None)
                    setNativeUrlPart(handle, 2, configuredHost, UrlComponent.Host)
                if (configuredUserInfo != None)
                    setNativeUrlPart(handle, 1, configuredUserInfo, UrlComponent.UserInfo)
                if (configuredPort != None)
                    setNativeUrlPart(
                        handle,
                        3,
                        Some(configuredPort!!.toString()),
                        UrlComponent.Port
                    )
                setNativeUrlPart(handle, 4, Some(configuredPath), UrlComponent.Path)
                if (configuredQuery != None)
                    setNativeUrlPart(handle, 5, configuredQuery, UrlComponent.Query)
                if (configuredFragment != None)
                    setNativeUrlPart(handle, 6, configuredFragment, UrlComponent.Fragment)
                return snapshotUrl(handle, reusable)
            } finally {
                urlFree(handle)
            }
        }
    }

    private fun copyAuthority(value: UrlAuthority) {
        configuredHost =
            Some(
                if (value.hostKind == 2 || value.hostKind == 3)
                    "[" + value.encodedHost + "]"
                else
                    value.encodedHost
            )
        configuredUserInfo = value.encodedUserInfo
        configuredPort = value.port
        reusable.add(value)
    }

    internal companion object {
        internal fun from(value: Url): UrlBuilder {
            val builder = UrlBuilder()
            builder.configuredScheme = value.scheme
            builder.configuredPath = value.encodedPath
            builder.configuredQuery = value.encodedQuery
            builder.configuredFragment = value.encodedFragment
            if (value.authority != None)
                builder.copyAuthority(value.authority!!)
            return builder
        }
    }
}

private fun encodedOptional(value: String?, component: UrlComponent): String? =
    if (value == None)
        None
    else
        Some(canonicalEncoded(value!!, component))
