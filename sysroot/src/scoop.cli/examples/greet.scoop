//! dep: scoop:scoop.cli:0.1.0
//! dep: scoop:scoop.platform:0.1.0

import scoop.cli.*
import scoop.platform.io.standardError
import scoop.platform.io.writeLine

struct Options(
    @CliArgument(position = 0L, help = "Name to greet") val name: String,
    @CliOption(names = ["--count", "-n"], defaultText = "1") val count: Int = 1,
    @CliFlag(names = ["--excited", "-e"]) val excited: Boolean = false
) {
    @GenerateWith("scoop.cli", ["CliArguments<Options>"])
    companion object: CliArguments<Options>
}

fun main(args: Array<String>): Int {
    val parser = CliParser(CliConfig("greet", "Print a greeting"), Options.Companion)
    try {
        when (parser.parseCommandLine(args)) {
            case CliResult.HelpRequested -> print(parser.help())
            case CliResult.Parsed(val options) -> {
                if (options.count < 1) {
                    standardError.writeLine("count must be positive")
                    return 2
                }
                val ending =
                    if (options.excited)
                        "!"
                    else
                        "."
                for (index in 1 .. options.count) {
                    println(f"Hello, ${options.name}${ending}")
                }
            }
        }
    } catch (error: CliParseException) {
        standardError.writeLine(error.message ?: "invalid arguments")
        return 2
    }
    return 0
}
