package scoop.cli.tests.consumer.cli_artifacts.p2

import scoop.test.*
import scoop.cli.*
import scoop.cli.CliOption as NamedOption

@Target([AnnotationTarget.Type])
private annotation class Marker(val text: String)

public struct Arguments(
    @CliArgument(position = 0L, valueName = "FILE") @Serialize(rename = "wire-source") val source: String,
    @CliIgnore @Serialize(ignore = true) val cache: Int = 42,
    @Serialize(required = true) @NamedOption(required = true, names = ["--output", "-o"], defaultText = "not optional") val output: String? = None,
    @Serialize(emitNull = true) val extra: @Marker("type only") String?,
    @DebugRedact val secret: String = "private"
) {
    @GenerateWith("scoop.codec", ["ValueEncoder<Arguments>", "ValueDecoder<Arguments>"])
    @GenerateWith("scoop.cli", ["CliArguments<Arguments>"])
    public companion object : ValueEncoder<Arguments>, ValueDecoder<Arguments>, ValueInspector<Arguments>, CliArguments<Arguments>
}

public class ClassArguments public constructor(public val code: Int = 3) {
    @GenerateWith("scoop.cli", ["CliArguments<ClassArguments>"])
    public companion object : CliArguments<ClassArguments>
}

public struct GenericArguments<T>(@NamedOption(names = ["--item", "-i"]) val value: T)
@GenerateWith("scoop.cli", ["CliArguments<GenericArguments<T>>"])
public class GenericArgumentsParser<T> public constructor(private val element: CliValueParser<T>) : CliArguments<GenericArguments<T>>
public fun <T> genericParser(element: CliValueParser<T>): CliParser<GenericArguments<T>> = CliParser(CliConfig("generic"), GenericArgumentsParser<T>(element))

public struct MaybeArguments<T>(val value: T?)
@GenerateWith("scoop.cli", ["CliArguments<MaybeArguments<T>>"])
public class MaybeArgumentsParser<T> public constructor(private val element: CliValueParser<T>) : CliArguments<MaybeArguments<T>>
