package scoop.cli.tests.consumer.cli_artifacts.p0

import scoop.test.*
import scoop.cli.tests.consumer.cli_artifacts.p2.*
import scoop.cli.CliFlag as Toggle
import scoop.cli.tests.consumer.cli_artifacts.p1.*
import scoop.cli.*
import scoop.json.Json

@GenerateWith("scoop.cli", ["CliArguments<GenericArguments<Option<String>>>"])
object Concrete : CliArguments<GenericArguments<Option<String>>>
struct Flags(@Toggle(names = ["-v"]) val enabled: Boolean = false) {
    @GenerateWith("scoop.cli", ["CliArguments<Flags>"])
    companion object : CliArguments<Flags>
}

fun scenario() {
    val parser = CliParser(CliConfig("artifact", "CLI from libraries"), Arguments.Companion)
    check(parser.entries.size == 4L)
    equal(parser.entries[0L].sourceName, "source")
    check(parser.entries[1L].required && parser.entries[1L].hasDefault)
    check(!parser.entries[2L].required && !parser.entries[2L].hasDefault)
    check(!contains(parser.help(), "not optional") && !contains(parser.help(), "cache"))
    fails("/output", { parser.parse(["input"]) })
    val value = parsed(parser.parse(["input", "-o="]))
    check(value.cache == 42 && value.output == Some("") && value.extra == None)
    equal(Json.encodeToString(value, Arguments.Companion), "{\"wire-source\":\"input\",\"output\":\"\",\"extra\":null,\"secret\":\"private\"}")
    equal(DebugPrinter.format(Arguments.inspect(value)), "Arguments(source=\"input\", cache=42, output=Option<String>.Some(\"\"), extra=Option<String>.None, secret=\"<redacted>\")")
    val classes = CliParser(CliConfig("class"), ClassArguments.Companion)
    check(parsed(classes.parse([])).code == 3)
    check(parsed(classes.parse(["--code=9"])).code == 9)
    val callback = forwarded<Option<String>>(CliParsers.optional(CliParsers.stringValue))
    gcCollect()
    val generic = callback()
    fails("/value", { generic.parse([]) })
    check(parsed(generic.parse(["-iabc"])).value == Some("abc"))
    val genericInfo = CliParser(CliConfig("generic"), Concrete)
    check(genericInfo.entries[0L].required && !genericInfo.entries[0L].hasDefault)
    fails("/value", { genericInfo.parse([]) })
    val maybe = CliParser(CliConfig("maybe"), MaybeArgumentsParser<Option<String>>(CliParsers.optional(CliParsers.stringValue)))
    check(!maybe.entries[0L].required && !maybe.entries[0L].hasDefault)
    check(parsed(maybe.parse([])).value == None)
    check(parsed(maybe.parse(["--value=null"])).value == Some(Some("null")))
    val flags = CliParser(CliConfig("flags"), Flags.Companion)
    check(parsed(flags.parse(["-v"])).enabled)

}

private fun exerciseConsumer() {
    try { scenario() }
    catch (error: Exception) { println(error.message ?: "no message"); throw error }
}

@Test
private class ConsumerTests {
    @Test
    fun behavior() { exerciseConsumer() }
}
