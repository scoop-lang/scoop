package scoop.cli.tests.cli.configuration

import scoop.test.*
import scoop.cli.*
import scoop.cli.tests.cli.configuration.shadow.Serialize as OtherSerialize

struct FakeSerialize(@OtherSerialize val value: Int) {
    @GenerateWith("scoop.cli", ["CliArguments<FakeSerialize>"])
    companion object : CliArguments<FakeSerialize>
}
struct Forced(@CliOption(required = true, defaultText = "hidden-default") val value: String? = None) {
    @GenerateWith("scoop.cli", ["CliArguments<Forced>"])
    companion object : CliArguments<Forced>
}
struct Optional(@Serialize(emitNull = true) val value: String?) { @GenerateWith("scoop.cli", ["CliArguments<Optional>"]) companion object : CliArguments<Optional> }
struct Ignored(@CliIgnore val value: String?) { @GenerateWith("scoop.cli", ["CliArguments<Ignored>"]) companion object : CliArguments<Ignored> }
struct Template<T>(val value: T)
@GenerateWith("scoop.cli", ["CliArguments<Template<Option<String>>>"])
object Concrete : CliArguments<Template<Option<String>>>
@GenerateWith("scoop.cli", ["CliArguments<Template<T>>"])
class Generic<T>(private val value: CliValueParser<T>) : CliArguments<Template<T>>
struct MaybeTemplate<T>(val value: T?)
@GenerateWith("scoop.cli", ["CliArguments<MaybeTemplate<T>>"])
class MaybeGeneric<T>(private val value: CliValueParser<T>) : CliArguments<MaybeTemplate<T>>

fun bad(action: () -> Unit) {
    try { action(); throw IllegalStateException() }
    catch (error: IllegalArgumentException) { check(error.message != None) }
}
class Explicit(private val layout: Array<CliEntry>) : CliArguments<Unit> {
    public override fun entries(): Array<CliEntry> = layout
    public override fun bind(values: CliValues) {}
}
fun explicit(entries: Array<CliEntry>): CliParser<Unit> = CliParser(CliConfig("explicit"), Explicit(entries))
fun option(name: String, field: String = "value"): CliEntry = CliEntry(field, CliRole.Option, CliValueShape.Text, [name])

private fun exercise() {
    check(CliParser(CliConfig("fake"), FakeSerialize.Companion).entries.size == 1L)
    for (name in ["", "port", "-", "--", "-1", "-xy", "--a=b", "--a b", "--a\n", "--a\u{a0}", "--help", "-h"]) {
        bad({ explicit([option(name)]) })
    }
    bad({ explicit([option("-x"), option("--x")]) })
    bad({ explicit([option("-x", "first"), option("-x", "second")]) })
    bad({ explicit([CliEntry("x", CliRole.Option, CliValueShape.Text)]) })
    bad({ explicit([CliEntry("x", CliRole.Flag, CliValueShape.Text, ["-x"])]) })
    bad({ explicit([CliEntry("x", CliRole.Option, CliValueShape.Flag, ["-x"])]) })
    bad({ explicit([CliEntry("x", CliRole.Option, CliValueShape.Text, ["-x"], ["--no-x"])]) })
    bad({ explicit([CliEntry("x", CliRole.Flag, CliValueShape.Flag, ["-x"], ["-x"])]) })
    bad({ explicit([CliEntry("x", CliRole.Argument(0L), CliValueShape.Text, ["-x"])]) })
    bad({ explicit([CliEntry("x", CliRole.Argument(-1L), CliValueShape.Text)]) })
    bad({ explicit([CliEntry("x", CliRole.Argument(1L), CliValueShape.Text)]) })
    bad({ explicit([
        CliEntry("x", CliRole.Argument(0L), CliValueShape.Text),
        CliEntry("y", CliRole.Argument(0L), CliValueShape.Text)
    ]) })
    bad({ explicit([
        CliEntry("x", CliRole.Argument(0L), CliValueShape.Text, required = false),
        CliEntry("y", CliRole.Argument(1L), CliValueShape.Text)
    ]) })
    bad({ explicit([
        CliEntry("x", CliRole.Argument(0L), CliValueShape.Repeated(CliElementShape.Text)),
        CliEntry("y", CliRole.Argument(1L), CliValueShape.Text)
    ]) })
    bad({ explicit([CliEntry("x", CliRole.Option, CliValueShape.Choice([]), ["-x"])]) })
    bad({ explicit([CliEntry("x", CliRole.Option, CliValueShape.Choice(["a", "a"]), ["-x"])]) })
    val forced = CliParser(CliConfig("forced"), Forced.Companion)
    check(forced.entries[0L].required && forced.entries[0L].hasDefault)
    check(!contains(forced.help(), "hidden-default"))
    fails("/value", { forced.parse([]) })
    check(parsed(forced.parse(["--value="])).value == Some(""))
    val optional = CliParser(CliConfig("optional"), Optional.Companion)
    check(!optional.entries[0L].required && !optional.entries[0L].hasDefault)
    check(!contains(optional.help(), "默认") && parsed(optional.parse([])).value == None)
    val ignored = CliParser(CliConfig("ignored"), Ignored.Companion)
    check(ignored.entries.size == 0L && parsed(ignored.parse([])).value == None)
    val template = CliParser(CliConfig("template"), Concrete)
    check(template.entries[0L].required)
    fails("/value", { template.parse([]) })
    fails("/value", { CliParser(CliConfig("generic"), Generic<Option<String>>(CliParsers.optional(CliParsers.stringValue))).parse([]) })
    check(parsed(template.parse(["--value=x"])).value == Some("x"))
    val maybe = CliParser(CliConfig("maybe"), MaybeGeneric<Option<String>>(CliParsers.optional(CliParsers.stringValue)))
    check(!maybe.entries[0L].required && !maybe.entries[0L].hasDefault)
    check(parsed(maybe.parse([])).value == None)
    check(parsed(maybe.parse(["--value=x"])).value == Some(Some("x")))

}

@Test
private class ApiTests {
    @Test
    fun behavior() { exercise() }
}
