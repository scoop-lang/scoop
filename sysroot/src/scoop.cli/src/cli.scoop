package scoop.cli

/** Program name and summary displayed in help. */
public struct CliConfig(val programName: String, val summary: String = "")

/** How tokens identify a field. Positional indices start at zero. */
public enum CliRole { Option, Flag, Argument(Long) }

/** Acceptable text for each occurrence of a repeated field. */
public enum CliElementShape { Text, Choice(Array<String>) }

/** How the token reader collects one field. */
public enum CliValueShape { Text, Flag, Choice(Array<String>), Repeated(CliElementShape) }

/** Layout and help text for one field. defaultText is for display only. */
public struct CliEntry(
    val sourceName: String, val role: CliRole, val valueShape: CliValueShape,
    val names: Array<String> = [], val negativeNames: Array<String> = [],
    val help: String = "", val valueName: String = "", val defaultText: String = "",
    val required: Boolean = true, val hasDefault: Boolean = false
)

/** Declares the argument layout and binds collected fields to an application value. */
public interface CliArguments<T> {
    public fun entries(): Array<CliEntry>
    public fun bind(values: CliValues): T
}

/** Declares how to collect and convert one field, including user-defined field types. */
public interface CliValueParser<T> {
    public fun shape(): CliValueShape
    public fun parseValue(values: CliFieldValues): T
}

/** The argv scan either produces an application value or requests help. */
public enum CliResult<T> { Parsed(T), HelpRequested }

/** Validates the layout once and reuses it for subsequent parsing and help. */
public class CliParser<T> public constructor(
    private val config: CliConfig, private val arguments: CliArguments<T>
) {
    private val layout: CliLayout = checkedEntries(arguments.entries())
    public val entries: Array<CliEntry> get() = layout.entries

    /** Parse arguments starting at the first option or positional value. */
    public fun parse(argv: Array<String>): CliResult<T> = parseFrom(argv, 0L)

    /** Parse complete argv including the program name at index zero. */
    public fun parseCommandLine(argv: Array<String>): CliResult<T> {
        if (argv.size == 0L) { inputError("", None, "complete argv requires a program item") }
        return parseFrom(argv, 1L)
    }

    private fun parseFrom(argv: Array<String>, start: Long): CliResult<T> =
        when (CliTokens(entries, layout.positions, argv, start).parse()) {
            case CliInputResult.Help -> CliResult.HelpRequested
            case CliInputResult.Value(val values) -> CliResult.Parsed(arguments.bind(values))
        }

    public fun writeHelp(writer: TextWriter): Unit = writeCliHelp(config, entries, layout.positions, writer)
    public fun help(): String {
        val writer = StringWriter()
        writeHelp(writer)
        return writer.toString()
    }
}
