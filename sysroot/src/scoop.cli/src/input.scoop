package scoop.cli

/** Original argv item and its zero-based index in the supplied array. */
public struct CliSource(val index: Long, val spelling: String)
public enum CliToken { Text(String), Flag(Boolean) }
public struct CliOccurrence(val token: CliToken, val source: CliSource)

/** A command-line error with its source field path and original token, when present. */
public class CliParseException public constructor(
    public val path: String, public val reason: String, public val source: Option<CliSource> = None
) : Exception(Some(when (source) {
    case Some(val item) -> reason + " at token " + item.index.toString() + " (" + item.spelling + ")"
    case None -> reason
}))

internal struct CliNamedField(val name: String, val values: CliFieldValues)
internal enum CliInputResult { Help, Value(CliValues) }

/** Immutable collected fields, looked up by their source names. */
public class CliValues internal constructor(private val fields: Array<CliNamedField>) {
    public fun optional(name: String): Option<CliFieldValues> {
        for (field in fields) { if (field.name == name) { return Some(field.values) } }
        return None
    }
    public fun required(name: String): CliFieldValues = when (optional(name)) {
        case Some(val field) -> field
        case None -> inputError(childPath("", name), None, "missing required field")
    }
}

internal struct CliAlias(val index: Long, val negative: Boolean)

internal fun childPath(path: String, name: String): String {
    val result = StringBuilder().append(path).append("/")
    for (character in name) {
        when (character) {
            case '~' -> { result.append("~0") }
            case '/' -> { result.append("~1") }
            else -> { result.append(character) }
        }
    }
    return result.toString()
}

internal fun inputError(path: String, source: Option<CliSource>, message: String): Nothing {
    throw CliParseException(path, message, source)
}

internal fun optionToken(text: String): Boolean = text.charLength >= 2L && text.getCharAt(0L) == '-' &&
    (text.getCharAt(1L) == '-' || asciiLetter(text.getCharAt(1L)))

internal fun findAlias(entries: Array<CliEntry>, name: String): Option<CliAlias> {
    for (index in 0L until entries.size) {
        for (alias in entries[index].names) { if (alias == name) { return Some(CliAlias(index, false)) } }
        for (alias in entries[index].negativeNames) { if (alias == name) { return Some(CliAlias(index, true)) } }
    }
    return None
}

internal fun textInput(entry: CliEntry, text: String, source: CliSource): CliOccurrence {
    val choices = when (entry.valueShape) {
        case CliValueShape.Choice(val names) -> Some(names)
        case CliValueShape.Repeated(CliElementShape.Choice(val names)) -> Some(names)
        case CliValueShape.Flag -> inputError(childPath("", entry.sourceName), Some(source), "flag does not accept a value")
        else -> None
    }
    when (choices) {
        case Some(val names) -> {
            for (name in names) { if (name == text) { return CliOccurrence(CliToken.Text(text), source) } }
            inputError(childPath("", entry.sourceName), Some(source), "unknown choice " + text)
        }
        case None -> {}
    }
    return CliOccurrence(CliToken.Text(text), source)
}
