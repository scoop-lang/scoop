package scoop.platform.io

import scoop.platform.fs.*
import scoop.platform.concurrent.Thread
import scoop.platform.memory.NativeByteBuffer
import scoop.platform.net.IpAddress
import scoop.platform.system.OsString
import scoop.test.*

private class FailingByteInput(private val failure: Throwable): List<Byte> {
    public override val size: Long get() = 2L
    public override operator fun get(index: Long): Byte {
        throw failure
    }
    public override operator fun iterator(): Iterator<Byte> {
        throw failure
    }
}

private class BufferByteInput(private val buffer: NativeByteBuffer): List<Byte> {
    public override val size: Long get() = buffer.readableBytes
    public override operator fun get(index: Long): Byte =
        buffer.getByte(buffer.readPosition + index)
    public override operator fun iterator(): Iterator<Byte> =
        Array<Byte>(size) { get(it) }.iterator()
}

private class CollectingBufferInput(
    private val buffer: NativeByteBuffer,
    private val failure: Throwable? = None
): List<Byte> {
    var reads: Long = 0L
    public override val size: Long get() = 3L
    public override operator fun get(index: Long): Byte {
        if (index < 0L || index >= size)
            throw IndexOutOfBoundsException()
        reads += 1L
        assertEquals(1L, buffer.writePosition)
        assertEquals(65.toByte(), buffer.getByte(0L))
        assertFailsWith<IllegalStateException> { buffer.clear() }
        assertFailsWith<IllegalStateException> { buffer.writeBytes(Array<Byte>(0L) { 0.toByte() }) }
        if (index == 0L)
            Thread.start {
                assertEquals(1L, buffer.writePosition)
                assertFailsWith<IllegalStateException> { buffer.close() }
                gcCollect()
            }.use { it.join() }
        gcCollect()
        if (index == 1L)
            when (failure) {
                case Some(val error) -> throw error
                case None -> {}
            }
        return (120L + index).toByte()
    }
    public override operator fun iterator(): Iterator<Byte> =
        Array<Byte>(size) { get(it) }.iterator()
}

@Test
private class ByteInputListTest {
    @Test
    fun `list copying retains its borrow through reentry and collection`() {
        NativeByteBuffer.allocate(4L).use {
            buffer ->
            buffer.writeByte(65.toByte())
            val input = CollectingBufferInput(buffer)
            buffer.writeBytes(input)
            assertEquals(3L, input.reads)
            assertEquals("Axyz", String.fromUtf8(buffer.readBytes(4L)))
        }
    }

    @Test
    fun `a later getter failure releases copying without committing partial progress`() {
        NativeByteBuffer.allocate(4L).use {
            buffer ->
            buffer.writeByte(65.toByte())
            val failure = IllegalStateException(Some("second input getter"))
            val input = CollectingBufferInput(buffer, Some(failure))
            assertSame(failure, assertFailsWith<IllegalStateException> { buffer.writeBytes(input) })
            assertEquals(2L, input.reads)
            assertEquals(1L, buffer.writePosition)
            buffer.writeBytes("bc".toByteArray())
            assertEquals("Abc", String.fromUtf8(buffer.readBytes(3L)))
        }
    }

    @Test
    fun `immutable arrays through a list preserve selected ranges and buffer positions`() {
        val bytes: List<Byte> = "abcdef".toByteArray()
        NativeByteBuffer.allocate(5L).use {
            buffer ->
            buffer.writeBytes("AB".toByteArray())
            buffer.writeBytes(bytes, 2L, 3L)
            buffer.writeBytes(bytes, bytes.size, 0L)
            assertEquals(5L, buffer.writePosition)
            assertFailsWith<IndexOutOfBoundsException> { buffer.writeBytes(bytes, 0L, 1L) }
            assertFailsWith<IndexOutOfBoundsException> { buffer.writeBytes(bytes, 5L, 2L) }
            assertEquals(5L, buffer.writePosition)
            assertEquals("ABcde", String.fromUtf8(buffer.readBytes(5L)))
            assertEquals("abcdef", String.fromUtf8(bytes))
        }
    }

    @Test
    fun `list inputs compose with strings files native buffers and addresses`() {
        val bytes = ArrayList<Byte>()
        for (byte in "list 中".toByteArray())
            bytes.add(byte)
        assertEquals("list 中", OsString.fromByteArray(bytes).decodeUtf8())
        NativeByteBuffer.allocate(bytes.size).use {
            buffer ->
            buffer.writeBytes(bytes)
            assertEquals("list 中", String.fromUtf8(buffer.readBytes(bytes.size)))
        }
        TestDirectory().use {
            tree -> File.open(
                tree.child("bytes"),
                OpenOptions(write = true, createNew = true)
            ).use {
                file ->
                assertEquals(bytes.size, file.writeFrom(bytes))
                file.seek(0L)
                assertEquals("list 中", file.readText())
            }
        }
        val address = ArrayList<Byte>()
        for (byte in [127.toByte(), 0.toByte(), 0.toByte(), 1.toByte()])
            address.add(byte)
        assertEquals(IpAddress.IPV4_LOOPBACK, IpAddress.fromByteArray(address))
    }

    @Test
    fun `list getters can query the destination buffer while its write is borrowed`() {
        NativeByteBuffer.allocate(4L).use {
            buffer ->
            buffer.writeBytes("AB".toByteArray())
            buffer.writeBytes(BufferByteInput(buffer))
            assertEquals("ABAB", String.fromUtf8(buffer.readBytes(4L)))
        }
    }

    @Test
    fun `input getter failure does not commit buffer or file progress`() {
        val failure = IllegalStateException(Some("input getter"))
        val bytes = FailingByteInput(failure)
        NativeByteBuffer.allocate(4L).use {
            buffer ->
            buffer.writeByte(65.toByte())
            assertSame(failure, assertFailsWith<IllegalStateException> { buffer.writeBytes(bytes) })
            assertEquals(1L, buffer.writePosition)
            assertEquals(65.toByte(), buffer.readByte())
        }
        TestDirectory().use {
            tree -> File.open(
                tree.child("bytes"),
                OpenOptions(write = true, createNew = true)
            ).use {
                file ->
                file.writeText("A")
                assertSame(
                    failure,
                    assertFailsWith<IllegalStateException> { file.writeFrom(bytes) }
                )
                assertEquals(1L, file.position())
                assertEquals(1L, file.size())
            }
        }
    }
}
