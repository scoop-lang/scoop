package scoop.tray

import scoop.test.*
import scoop.tests.tray.native.*
import scoop.window.*
import scoop.platform.time.MonotonicTimeSource
import scoop.time.Duration

@Test
private class StatusNotifierTests {
    @Test
    fun `SNI and DBusMenu preserve actions and recover after the watcher returns`() {
        val handler = StatusNotifierHandler()
        try {
            Application().run(handler)
            assertEquals(1, handler.actions)
            assertEquals(1, handler.activations)
            assertEquals(TrayState.Closed, handler.tray!!.state)
            assertEquals(TrayState.Closed, handler.pending!!.state)
            assertEquals(MenuState.Closed, handler.menu!!.state)
        } finally {
            @Unsafe
            {
                when (handler.host) {
                    case Some(val value) -> destroyLinuxTrayHost(value)
                    case None -> {}
                }
            }
        }
    }
}

private class StatusNotifierHandler: ApplicationHandler {
    var host: Ptr<Unit>? = None
    var tray: TrayIcon? = None
    var pending: TrayIcon? = None
    var menu: Menu? = None
    var actions = 0
    var activations = 0
    private var target: Window? = None
    private var command = MenuItemId(0L)
    private var retired = MenuItemId(0L)
    private var checked = MenuItemId(0L)
    private var phase = 0
    private var ticks = 0

    public override fun onEvent(application: ActiveApplication, event: ApplicationEvent) {
        when (event) {
            case Resumed -> start(application)
            case Menu(val activation) -> {
                assertEquals(command, activation.item)
                when (activation.source) {
                    case Native(val id) -> assertEquals(tray!!.menuUseId, Some(id))
                    else -> fail(Some("incorrect DBusMenu activation source"))
                }
                actions += 1
            }
            case NewEvents(StartCause.Deadline) -> advance(application)
            else -> {}
        }
    }

    private fun start(application: ActiveApplication) {
        @Unsafe
        {
            host = createLinuxTrayHost()
        }
        assertTrue(host != None)
        target =
            Some(
                application.createWindow(
                    windowAttributes {
                        title = "Tray placement test"
                        size = LogicalSize(240.0, 160.0)
                    }
                )
            )
        val created = application.createMenu()
        menu = Some(created)
        command =
            created.insert(
                MenuItemDescription(
                    "Execute",
                    image = Some(trayTestImage()),
                    shortcut =
                        Some(
                            ShortcutChord(
                                ShortcutKey.Logical(LogicalKey.Character("o")),
                                ShortcutModifiers(primary = true)
                            )
                        )
                )
            )
        retired = created.insert(MenuItemDescription("Retire"))
        checked =
            created.insert(MenuItemDescription("Checked", kind = MenuItemKind.Checkbox(false)))
        created.insert(MenuItemDescription("Radio", kind = MenuItemKind.Radio(true)))
        created.insert(MenuItemDescription("", kind = MenuItemKind.Separator))
        val submenu = created.insert(MenuItemDescription("Group", kind = MenuItemKind.Submenu))
        created.insert(MenuItemDescription("Nested"), Some(submenu))
        val icon =
            TrayIcon.create(
                application,
                TrayOptions(trayTestImage(), Some("Before"), Some(created))
            )
        tray = Some(icon)
        assertFalse(icon.capabilities().iconBounds)
        assertFalse(icon.capabilities().programmaticMenu)
        assertTrue(icon.capabilities().hostMenu)
        assertEquals(
            WindowErrorKind.Unsupported,
            assertFailsWith<WindowException> { icon.geometry() }.kind
        )
        assertEquals(
            WindowErrorKind.Unsupported,
            assertFailsWith<WindowException> { icon.showMenu() }.kind
        )
        icon.subscribe {
            value -> when (value) {
                case AvailabilityChanged(TrayAvailability.Available) -> @Unsafe
                {
                    if (phase == 0) {
                        phase = 1
                        inspectLinuxTrayHost(host!!, 1)
                    } else
                        if (phase == 4) {
                            phase = 5
                            inspectLinuxTrayHost(host!!, 3)
                        }
                }
                case AvailabilityChanged(TrayAvailability.Unavailable) -> if (phase == 3) {
                    phase = 4
                    @Unsafe
                    {
                        assertEquals(1, cycleLinuxTrayHost(host!!, 1))
                    }
                }
                case Activated(val activation) -> {
                    assertEquals(TrayActivationKind.Primary, activation.kind)
                    assertEquals(TrayActivationSource.Unknown, activation.source)
                    when (activation.anchor) {
                        case Some(TrayAnchor.PointHint(val point)) -> {
                            assertEquals(-75.0, point.x)
                            assertEquals(22.0, point.y)
                        }
                        else -> fail(Some("SNI fabricated an icon rectangle"))
                    }
                    when (activation.button) {
                        case None -> {};
                        case Some(_) -> fail(Some("SNI fabricated a button"))
                    }
                    when (activation.clickCount) {
                        case None -> {};
                        case Some(_) -> fail(Some("SNI fabricated a click count"))
                    }
                    activations += 1
                }
                else -> {}
            }
        }
        schedule(application)
    }

    private fun schedule(application: ActiveApplication) {
        application.setControlFlow(
            ControlFlow.WaitUntil(MonotonicTimeSource.markNow() + Duration.milliseconds(50L))
        )
    }

    private fun advance(application: ActiveApplication) {
        ticks += 1
        if (ticks > 200)
            fail(Some(f"SNI test timeout in phase ${phase}"))
        @Unsafe
        {
            val status = linuxTrayHostStatus(host!!)
            assertTrue(status >= 0, Some(f"SNI protocol failure ${status}"))
            if (phase == 1 && status == 1) {
                phase = 2
                menu!!.remove(retired)
                menu!!.update(
                    command,
                    MenuItemDescription("Renamed", image = Some(trayTestImage()))
                )
                menu!!.update(
                    checked,
                    MenuItemDescription("Checked", kind = MenuItemKind.Checkbox(true))
                )
                tray!!.setImage(trayTestImage(96.toUByte()))
                tray!!.setTooltip(Some("After"))
                tray!!.setMenu(menu)
                inspectLinuxTrayHost(host!!, 2)
            } else
                if (phase == 2 && status == 2 && actions == 1) {
                    phase = 3
                    assertEquals(1, cycleLinuxTrayHost(host!!, 0))
                } else
                    if (phase == 5 && status == 3 && activations == 1) {
                        val positioning = application.desktopCapabilities().positioning
                        if (positioning.globalWindowPosition) {
                            val monitors = application.monitors()
                            assertTrue(monitors.size > 0L)
                            val work =
                                monitors[0L].workArea ?:
                                    fail(Some("X11 test WM did not publish a work area"))
                            assertEquals(
                                RequestStatus.Requested,
                                tray!!.placeWindow(
                                    target!!,
                                    TrayWindowPlacement(
                                        anchor =
                                            Some(
                                                TrayAnchor.PointHint(
                                                    DesktopPosition(
                                                        work.origin.x + 20.0,
                                                        work.origin.y
                                                    )
                                                )
                                            ),
                                        allowPointHint = true
                                    )
                                )
                            )
                        } else {
                            assertEquals(
                                WindowErrorKind.Unsupported,
                                assertFailsWith<WindowException> {
                                    tray!!.placeWindow(target!!)
                                }.kind
                            )
                        }
                        // The second icon still has its asynchronous bus request in flight.
                        pending = Some(TrayIcon.create(application, TrayOptions(trayTestImage())))
                        application.requestExit()
                        return
                    }
        }
        schedule(application)
    }
}
