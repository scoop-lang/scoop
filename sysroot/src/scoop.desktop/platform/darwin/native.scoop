package scoop.desktop

import scoop.window.RequestStatus
import scoop.window.native.*

@Unsafe
internal fun platformWindow(lease: NativeWindowLease): Ptr<Unit> =
    when (lease.handle) {
        case AppKit(val window, _) -> window
    }

@Unsafe
internal fun platformDockMenu(pointer: Ptr<Unit>, lease: NativeMenuLease?): RequestStatus {
    val menu =
        when (lease) {
            case Some(val value) -> when (value.handle) {
                case AppKit(val handle) -> Some(handle)
            }
            case None -> None
        }
    return desktopStatus(nativeApplicationMenu(pointer, menu), "Dock menu")
}
