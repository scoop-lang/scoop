package scoop.desktop

import scoop.window.*

@CLayout
internal struct DesktopNativeResult(val pointer: Ptr<Unit>?, val error: Long)

internal fun desktopStatus(code: Long, operation: String): RequestStatus {
    if (code == 0L)
        return RequestStatus.Applied
    if (code == -6L)
        return RequestStatus.Requested
    if (code == -1L)
        return RequestStatus.Unsupported
    val kind =
        when (code) {
            -2L -> WindowErrorKind.Unavailable
            -3L -> WindowErrorKind.Disconnected
            -4L -> WindowErrorKind.InvalidState
            -5L -> WindowErrorKind.ResourceBusy
            else -> WindowErrorKind.NativeFailure
        }
    throw WindowException(operation, kind, Some(code))
}

internal fun desktopCreated(value: DesktopNativeResult, operation: String): Ptr<Unit> {
    if (value.error == -1L)
        throw WindowException(operation, WindowErrorKind.Unsupported)
    desktopStatus(value.error, operation)
    return value.pointer ?: throw WindowException(operation, WindowErrorKind.NativeFailure)
}

