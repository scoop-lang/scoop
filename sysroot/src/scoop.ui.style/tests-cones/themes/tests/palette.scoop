package scoop.tests.ui.themes

import scoop.graphics.*
import scoop.test.*
import scoop.ui.style.*
import scoop.ui.style.macos.macosTheme
import scoop.ui.style.material.materialTheme
import scoop.ui.style.fluent.fluentTheme
import scoop.ui.style.shadcn.shadcnTheme

@Test
private class ThemePaletteOverrideTest {
    @Test
    fun `all presets apply an independent palette to real parts while retaining their geometry`() {
        for (mode in [ThemeMode.Light, ThemeMode.Dark]) {
            val palette = macosTheme(mode)
                .tokens
                .palette
                .copy {
                    primary = ColorPair(Color(0.64, 0.12, 0.42), Color(1.0, 0.96, 0.82))
                    ring = Color(0.12, 0.66, 0.35)
                    disabledText = Color(0.45, 0.43, 0.49)
                }
            val ordinary = [
                macosTheme(mode),
                materialTheme(mode),
                fluentTheme(mode),
                shadcnTheme(mode)
            ]
            val supplied = [
                macosTheme(mode, Some(palette)),
                materialTheme(mode, Some(palette)),
                fluentTheme(mode, Some(palette)),
                shadcnTheme(mode, Some(palette))
            ]
            val bounds = Rect(20.0, 20.0, 96.0, 40.0)
            val marker = Rect(20.0, 20.0, 20.0, 20.0)
            for (index in 0L until supplied.size) {
                val base = ordinary[index]
                val theme = supplied[index]
                assertTrue(theme.tokens.palette === palette)
                assertEquals(base.tokens.spacing, theme.tokens.spacing)
                assertEquals(base.tokens.corners, theme.tokens.corners)
                assertEquals(
                    base.tokens.typography.body.families[0L],
                    theme.tokens.typography.body.families[0L]
                )
                assertEquals(
                    base.tokens.typography.body.fontSize,
                    theme.tokens.typography.body.fontSize
                )
                for (kind in [SurfaceKind.Plain, SurfaceKind.Action, SurfaceKind.Elevated]) {
                    val visual = SurfaceVisual(kind)
                    assertEquals(base.surfaceMetrics(visual), theme.surfaceMetrics(visual))
                }
                assertEquals(base.checkboxMetrics(), theme.checkboxMetrics())
                assertEquals(base.radioMetrics(), theme.radioMetrics())
                assertEquals(base.scrollbarMetrics(), theme.scrollbarMetrics())
                val action = SurfaceVisual(SurfaceKind.Action)
                assertEquals(
                    palette.primary.background,
                    theme.surfaceGeometry(bounds, action).style.background!!.color
                )
                assertEquals(palette.primary.foreground, theme.surfaceTextColor(action))
                for (
                    interaction in [
                        InteractionVisual(hovered = true),
                        InteractionVisual(pressed = true)
                    ]
                ) {
                    val visual = SurfaceVisual(SurfaceKind.Action, interaction)
                    assertTrue(
                        base.surfaceGeometry(bounds, visual).style.background!!.color !=
                            theme.surfaceGeometry(bounds, visual).style.background!!.color
                    )
                }
                val checked = theme.checkboxGeometry(marker, CheckboxVisual(CheckMark.On))
                assertEquals(palette.primary.background, checked.style.background!!.color)
                assertEquals(palette.primary.foreground, checked.markColor)
                val mixed = CheckboxVisual(CheckMark.Mixed)
                assertEquals(
                    base.checkboxGeometry(marker, mixed).mixed,
                    theme.checkboxGeometry(marker, mixed).mixed
                )
                if (index == 2L) {
                    assertEquals(
                        Color.Transparent,
                        theme.checkboxGeometry(marker, mixed).style.background!!.color
                    )
                    assertEquals(
                        palette.primary.background,
                        theme.checkboxGeometry(marker, mixed).markColor
                    )
                }
                assertEquals(
                    if (index == 1L || index == 2L)
                        palette.primary.background
                    else
                        palette.primary.foreground,
                    theme.radioGeometry(marker, RadioVisual(true)).dotColor
                )
                val focused = SurfaceVisual(
                    SurfaceKind.Action,
                    InteractionVisual(focusVisible = true)
                )
                val focus = theme.surfaceGeometry(bounds, focused).ring!!.border.color
                assertEquals(palette.ring.red, focus.red)
                assertEquals(palette.ring.green, focus.green)
                assertEquals(palette.ring.blue, focus.blue)
            }
        }
    }
}
