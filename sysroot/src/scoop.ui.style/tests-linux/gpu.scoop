package scoop.ui.style

import scoop.graphics.native.linux.GLESContext
import scoop.test.*

@Test
private class GLESGpuTest {
    @Test
    fun `GLES preserves GPU pixels and resources at two times DPI`() {
        GLESContext.createOffscreen().use {
            context ->
            context.offscreen(128, 96, 2.0).use { target -> verifyStyleGpu(target) }
            context.drain()
        }
    }
}
