package scoop.ui.style

import scoop.graphics.*
import scoop.graphics.native.RenderTarget
import scoop.test.*

internal fun verifyStyleGpu(target: RenderTarget) {
    StylePainter().use {
        painter ->
        target.draw {
            canvas ->
            canvas.clear(Color.Transparent)
            canvas.translate(2.0, 1.0)
            painter.paint(
                canvas,
                Rect(8.0, 8.0, 24.0, 24.0),
                style {
                    this.border = Some(Border(1.0, Color(0.0, 1.0, 0.0)))
                    this.cornerRadius = 4.0
                    this.boxShadows = [BoxShadow(Point(12.0, 0.0), 0.0, 0.0, Color.Black)]
                    this.contentEffects = [ContentEffect.Glow(2.0, 2.0, Color(0.0, 0.0, 1.0))]
                }
            ) { child -> child.drawRect(Rect(12.0, 12.0, 6.0, 6.0), Paint(Color(1.0, 0.0, 0.0))) }
        }
        target.submit()
        val pixels = target.readPixels()
        assertEquals(255, channel(pixels, 128, 20, 40, 1))
        assertEquals(255, channel(pixels, 128, 32, 32, 0))
        assertTrue(channel(pixels, 128, 24, 32, 2) > 240)
        assertTrue(channel(pixels, 128, 24, 32, 3) > 5)
        assertEquals(255, channel(pixels, 128, 84, 40, 3))
        assertEquals(0, channel(pixels, 128, 100, 40, 3))
    }
}
