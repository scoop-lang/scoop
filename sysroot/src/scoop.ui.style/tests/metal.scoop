package scoop.ui.style

import scoop.graphics.native.macos.MetalContext
import scoop.test.*
import scoop.tests.graphics.TestMetalSurface

@Test
private class MetalStyleTest {
    @Test
    fun `Metal preserves GPU pixels and resources at two times DPI`() {
        TestMetalSurface.create(128, 96).use {
            objects -> @Unsafe
            {
                MetalContext.create(objects.device(), objects.queue()).use {
                    context ->
                    @Unsafe
                    {
                        context.target(objects.texture(), 128, 96, 2.0).use {
                            target -> verifyStyleGpu(target)
                        }
                    }
                    context.drain()
                }
            }
        }
    }
}
