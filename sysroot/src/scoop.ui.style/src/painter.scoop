package scoop.ui.style

import scoop.graphics.*
import scoop.platform.concurrent.currentThreadId
import scoop.ui.SceneContext
import scoop.ui.LayoutDirection

private struct DecorationDrawing(
    val paths: DecorationPaths?,
    val edges: BorderEdges,
    val shadows: Array<ImageFilter>,
    val filter: ImageFilter?
)

/** Owns just the current filters and outlines; register once in the using element's scope. */
public class StylePainter public constructor(): Closeable {
    private val owner = currentThreadId()
    private var closed = false
    private var painting = false
    private val contentFilters = ContentFilterCache()
    private val boxFilters = BoxFilterCache()
    private val geometry = DecorationGeometry()
    public val isClosed: Boolean get() = closed

    private fun checkOpen() {
        checkThread()
        if (closed)
            throw IllegalStateException(Some("style painter is closed"))
        if (painting)
            throw IllegalStateException(Some("style painter has an active draw"))
    }
    private fun checkThread() {
        if (owner != currentThreadId())
            throw IllegalStateException(Some("style painter requires its owner thread"))
    }

    public fun scene(context: SceneContext, style: Style, content: (SceneContext) -> Unit) {
        val size = context.size
        scene(context, Rect(0.0, 0.0, size.width, size.height), style, content)
    }
    public fun scene(
        context: SceneContext,
        bounds: Rect,
        style: Style,
        content: (SceneContext) -> Unit
    ) {
        checkOpen()
        painting = true
        try {
            val drawing = prepare(bounds, style, context.layoutDirection)
            context.draw { paint -> background(paint.canvas, bounds, style, drawing) }
            context.withState {
                local ->
                if (style.clipContent)
                    local.clipPath(drawing.paths!!.outline)
                when (drawing.filter) {
                    case Some(value) -> local.saveLayer(filter = Some(value))
                    case None -> {}
                }
                local.withState(content)
                when (drawing.filter) {
                    case Some(_) -> local.restore()
                    case None -> {}
                }
            }
            context.draw { paint -> border(paint.canvas, bounds, drawing) }
        } finally {
            painting = false
        }
    }
    public fun paint(
        canvas: Canvas,
        bounds: Rect,
        style: Style,
        direction: LayoutDirection = LayoutDirection.Ltr,
        content: (Canvas) -> Unit
    ) {
        checkOpen()
        painting = true
        try {
            val drawing = prepare(bounds, style, direction)
            canvas.withState {
                local ->
                background(local, bounds, style, drawing)
                local.save()
                if (style.clipContent)
                    local.clipPath(drawing.paths!!.outline)
                when (drawing.filter) {
                    case Some(value) -> local.saveLayer(filter = Some(value))
                    case None -> {}
                }
                local.withState(content)
                when (drawing.filter) {
                    case Some(_) -> local.restore()
                    case None -> {}
                }
                local.restore()
                border(local, bounds, drawing)
            }
        } finally {
            painting = false
        }
    }

    private fun prepare(bounds: Rect, style: Style, direction: LayoutDirection): DecorationDrawing {
        when (style.background) {
            case Some(value) -> requireStyle(
                value.style == PaintingStyle.Fill,
                "style background must be a fill"
            )
            case None -> {}
        }
        return DecorationDrawing(
            geometry.update(bounds, style, direction),
            physicalEdges(style, direction),
            boxFilters.update(style.boxShadows),
            contentFilters.update(style.contentEffects)
        )
    }
    private fun background(canvas: Canvas, bounds: Rect, style: Style, drawing: DecorationDrawing) {
        if (bounds.width == 0.0 || bounds.height == 0.0)
            return
        for (shadow in drawing.shadows)
            canvas.withState {
                mask ->
                mask.saveLayer(filter = Some(shadow))
                mask.drawPath(drawing.paths!!.outline, Paint(Color.White))
                mask.restore()
            }
        when (style.background) {
            case Some(paint) -> canvas.drawPath(drawing.paths!!.outline, paint)
            case None -> {}
        }
    }
    private fun border(canvas: Canvas, bounds: Rect, drawing: DecorationDrawing) {
        val paths = drawing.paths ?: return
        val ring = paths.border ?: return
        when (drawing.edges.uniformColor()) {
            case Some(color) -> canvas.drawPath(ring, Paint(color))
            case None -> canvas.withState {
                local ->
                local.clipRect(bounds)
                local.saveLayer()
                val colors = drawing.edges.values()
                for (index in 0L ..< paths.regions.size) {
                    if (colors[index].width == 0.0)
                        continue
                    // Sum disjoint antialias coverage without darkening their shared joins.
                    local.saveLayer(blendMode = BlendMode.Plus)
                    local.drawPath(paths.regions[index], Paint(colors[index].color))
                    local.restore()
                }
                // Apply one common rounded ring to the assembled colors.
                local.saveLayer(blendMode = BlendMode.DstIn)
                local.drawPath(ring, Paint(Color.White))
                local.restore()
                local.restore()
            }
        }
    }

    public override fun close() {
        checkThread()
        if (painting)
            throw IllegalStateException(Some("style painter has an active draw"))
        if (closed)
            return
        closed = true
        var failure = cleanupStyle(None) { contentFilters.close() }
        failure = cleanupStyle(failure) { boxFilters.close() }
        failure = cleanupStyle(failure) { geometry.close() }
        throwStyle(failure)
    }
}
