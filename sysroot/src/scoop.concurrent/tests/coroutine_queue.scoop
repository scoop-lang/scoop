package scoop.concurrent.tests

import scoop.concurrent.*
import scoop.platform.concurrent.*
import scoop.test.*

@Test
private class CoroutineQueueTest {
    @Test
    fun `FIFO payloads survive moving collection while retained only by queue nodes`() {
        val queue = CoroutineQueue.create()
        val affinity = AtomicInt(0)
        val observed = ArrayList<Int>()
        for (index in 0 ..< 1024) {
            assertTrue(
                queue.tryPut(
                    CoroutineSubmission(affinity, FunctionCoroutineWork { observed.add(index) })
                )
            )
        }
        gcCollect()
        for (index in 0 ..< 1024) {
            queue.take()!!.work.run()
            assertEquals(index, observed[index.toLong()])
        }
        assertTrue(absent(queue.take()))
        gcCollect()
        assertTrue(
            queue.tryPut(
                CoroutineSubmission(affinity, FunctionCoroutineWork { observed.add(1024) })
            )
        )
        queue.take()!!.work.run()
        assertEquals(1025L, observed.size)
        assertTrue(absent(queue.take()))
    }

    @Test
    fun `concurrent producers and consumers transfer each managed payload exactly once`() {
        exerciseConcurrentQueue(2048)
    }

    @Test
    fun `concurrent queue references survive moving collection`() {
        exerciseConcurrentQueue(64)
    }

    @Test
    fun `closing the queue preserves accepted FIFO work and rejects later publications`() {
        val queue = CoroutineQueue.create()
        val affinity = AtomicInt(0)
        val observed = ArrayList<Int>()
        for (index in 0 ..< 128)
            assertTrue(
                queue.tryPut(
                    CoroutineSubmission(affinity, FunctionCoroutineWork { observed.add(index) })
                )
            )
        queue.close()
        queue.close()
        assertFalse(
            queue.tryPut(
                CoroutineSubmission(
                    affinity,
                    FunctionCoroutineWork { fail(Some("closed queue accepted work")) }
                )
            )
        )
        gcCollect()
        for (index in 0 ..< 128) {
            queue.take()!!.work.run()
            assertEquals(index, observed[index.toLong()])
        }
        assertTrue(absent(queue.take()))
        assertFalse(queue.tryPut(CoroutineSubmission(affinity, FunctionCoroutineWork {})))
        val empty = CoroutineQueue.create()
        empty.close()
        assertTrue(absent(empty.take()))
        assertFalse(empty.tryPut(CoroutineSubmission(affinity, FunctionCoroutineWork {})))
    }

    @Test
    fun `closure racing producers and consumers loses no accepted work`() {
        val queue = CoroutineQueue.create()
        val affinity = AtomicInt(0)
        val accepted = AtomicInt(0)
        val received = AtomicInt(0)
        val done = AtomicBoolean(false)
        val seen = Array<AtomicInt>(8192L) { _ -> AtomicInt(0) }
        val gate = WorkerGate()
        val consumers =
            Array<Thread>(4L) {
                _ -> Thread.start {
                    while (!done.load() || received.load() < accepted.load()) {
                        when (queue.take()) {
                            case Some(val work) -> {
                                work.work.run()
                                received.fetchAdd(1)
                            }
                            case None -> yield()
                        }
                    }
                }
            }
        val producers =
            Array<Thread>(4L) {
                producer -> Thread.start {
                    gate.await()
                    for (offset in 0 ..< 2048) {
                        val index = producer * 2048L + offset.toLong()
                        if (
                            queue.tryPut(
                                CoroutineSubmission(
                                    affinity,
                                    FunctionCoroutineWork {
                                        assertEquals(0, seen[index].fetchAdd(1))
                                    }
                                )
                            )
                        )
                            accepted.fetchAdd(1)
                    }
                }
            }
        gate.awaitEntered(4)
        gate.open()
        while (accepted.load() < 256)
            yield()
        queue.close()
        for (producer in producers)
            producer.join()
        done.store(true)
        for (consumer in consumers)
            consumer.join()
        assertEquals(accepted.load(), received.load())
        assertTrue(absent(queue.take()))
    }
}

private fun exerciseConcurrentQueue(perProducer: Int) {
    val expected = perProducer * 4
    val queue = CoroutineQueue.create()
    val affinity = AtomicInt(0)
    val seen = Array<AtomicInt>(expected.toLong()) { _ -> AtomicInt(0) }
    val received = AtomicInt(0)
    val consumers =
        Array<Thread>(4L) {
            _ -> Thread.start {
                while (received.load() < expected) {
                    when (queue.take()) {
                        case Some(val work) -> {
                            work.work.run()
                            received.fetchAdd(1)
                        }
                        case None -> yield()
                    }
                }
            }
        }
    val producers =
        Array<Thread>(4L) {
            producer -> Thread.start {
                for (offset in 0 ..< perProducer) {
                    val index = producer * perProducer.toLong() + offset.toLong()
                    assertTrue(
                        queue.tryPut(
                            CoroutineSubmission(
                                affinity,
                                FunctionCoroutineWork { assertEquals(0, seen[index].fetchAdd(1)) }
                            )
                        )
                    )
                }
            }
        }
    for (producer in producers)
        producer.join()
    for (consumer in consumers)
        consumer.join()
    assertEquals(expected, received.load())
    for (value in seen)
        assertEquals(1, value.load())
    assertTrue(absent(queue.take()))
}
