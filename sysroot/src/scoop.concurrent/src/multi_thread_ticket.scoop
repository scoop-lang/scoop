package scoop.concurrent

internal class MultiThreadTicket(
    internal val owner: MultiThreadExecutor,
    worker: Int
): ExecutorTask {
    internal val affinity = AtomicInt(worker)
    // Low bit is admission; the remaining bits count publishers that have entered.
    private val publication = AtomicLong(1L)
    internal val active: Boolean get() = publication.load() % 2L == 1L

    internal fun beginPublication() {
        var current = publication.load()
        while (true) {
            if (current % 2L == 0L)
                throw IllegalStateException(Some("executor task is already complete"))
            if (publication.compareAndSet(current, current + 2L))
                return
            current = publication.load()
        }
    }

    internal fun endPublication() {
        if (publication.fetchSub(2L) == 2L)
            owner.retireTask()
    }

    public override val executor: CoroutineExecutor get() = owner

    public override fun dispatch(work: CoroutineWork) {
        owner.dispatch(this, work)
    }

    public override fun dispatchBlocking(work: BlockingWork) {
        owner.dispatchBlocking(this, work)
    }

    public override fun complete() {
        var current = publication.load()
        while (true) {
            if (current % 2L == 0L)
                throw IllegalStateException(Some("executor task is already complete"))
            if (publication.compareAndSet(current, current - 1L)) {
                if (current == 1L)
                    owner.retireTask()
                return
            }
            current = publication.load()
        }
    }
}
