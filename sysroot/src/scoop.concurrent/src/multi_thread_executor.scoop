package scoop.concurrent

import scoop.platform.concurrent.ConditionVariable
import scoop.platform.concurrent.Mutex
import scoop.platform.concurrent.ThreadId
import scoop.platform.concurrent.currentThreadId

/** Runs coroutine work on fixed managed workers and blocking work on a separate pool. */
public class MultiThreadExecutor internal constructor(
    workerCount: Int,
    private val blockingPool: BlockingTaskPool,
    private val ownsBlockingPool: Boolean
): CoroutineExecutor, Closeable {
    private val lock = Mutex()
    private val changed = ConditionVariable(lock)
    private val terminated = Channel<Unit>(0L)
    private val terminationListeners = TerminationListeners(lock)
    private val blockingThreads = ArrayList<ThreadId>()
    private var phase = ExecutorPhase.Open
    private var tasks = 0L
    private var blockingWork = 0L
    private var workersStopping = false
    private val workers = CoroutineWorkers.create(workerCount)

    init {
        workers.onTermination { checkTermination() }
        if (ownsBlockingPool)
            blockingPool.invokeOnTermination { checkTermination() }
    }

    /** Whether shutdown has been requested and new root tasks are rejected. */
    public val isShutdown: Boolean get() = lock.withLock { phase != ExecutorPhase.Open }
    /** Whether tasks and owned workers have left their execution loops. */
    public val isTerminated: Boolean get() = lock.withLock { phase == ExecutorPhase.Terminated }

    /** Registers an ordinary termination notification without creating another coroutine. */
    public fun invokeOnTermination(handler: () -> Unit): Disposable =
        terminationListeners.subscribe(handler)

    /** Registers a root while open, or a child of this executor's active parent while draining. */
    public override fun registerTask(parent: ExecutorTask?): ExecutorTask =
        lock.withLock {
            if (phase == ExecutorPhase.Terminated)
                throw ExecutorClosedException()
            if (phase == ExecutorPhase.Draining) {
                val admitted =
                    when (parent) {
                        case Some(val parent) -> parent is
                            MultiThreadTicket &&
                            parent.owner ===
                            this &&
                            parent.active
                        case None -> false
                    }
                if (!admitted)
                    throw ExecutorClosedException()
            }
            val preferred =
                when (parent) {
                    case Some(val parent) -> if (
                        parent is MultiThreadTicket && parent.owner === this
                    )
                        parent.affinity.load(MemoryOrder.Relaxed)
                    else
                        workers.chooseWorker()
                    case None -> workers.chooseWorker()
                }
            tasks += 1L
            MultiThreadTicket(this, preferred)
        }

    /** Stops admission of new roots, preserving active tasks and their children. */
    public fun requestShutdown() {
        val stop =
            lock.withLock {
                if (phase == ExecutorPhase.Open)
                    phase = ExecutorPhase.Draining
                shouldStopWorkers()
            }
        if (stop)
            stopWorkers()
    }

    /** Waits for accepted work and owned workers; cancellation only ends this wait. */
    public suspend fun awaitTermination() {
        checkNotSelf()
        terminated.receiveOrNone()
    }

    /** Waits for termination and joins owned threads after shutdown has been requested. */
    public fun join() {
        checkNotSelf()
        lock.withLock {
            if (phase == ExecutorPhase.Open)
                throw IllegalStateException(Some("request executor shutdown before join"))
            while (phase != ExecutorPhase.Terminated)
                changed.await()
        }
        workers.join()
        if (ownsBlockingPool)
            blockingPool.join()
    }

    /** Requests shutdown and joins; cannot be called by work that must itself finish. */
    public override fun close() {
        checkNotSelf()
        requestShutdown()
        join()
    }

    internal fun dispatch(ticket: MultiThreadTicket, work: CoroutineWork) {
        requireActive(ticket)
        if (!workers.submit(ticket.affinity, work))
            throw IllegalStateException(Some("executor task is already complete"))
    }

    internal fun dispatchBlocking(ticket: MultiThreadTicket, work: BlockingWork) {
        lock.withLock {
            requireActive(ticket)
            blockingWork += 1L
            try {
                blockingPool.submit(ExecutorBlockingWork(this, work))
            }
            catch (error: Throwable) {
                blockingWork -= 1L
                throw error
            }
        }
    }

    internal fun complete(ticket: MultiThreadTicket) {
        val stop =
            lock.withLock {
                requireActive(ticket)
                ticket.retire()
                tasks -= 1L
                shouldStopWorkers()
            }
        if (stop)
            stopWorkers()
    }

    private fun requireActive(ticket: MultiThreadTicket) {
        if (!ticket.active)
            throw IllegalStateException(Some("executor task is already complete"))
    }

    internal fun runBlocking(work: BlockingWork) {
        val id = currentThreadId()
        lock.withLock { blockingThreads.add(id) }
        try {
            work.run()
        }
        finally {
            lock.withLock {
                var index = 0L
                while (index < blockingThreads.size && blockingThreads[index] != id)
                    index += 1L
                if (index == blockingThreads.size)
                    throw IllegalStateException(Some("blocking worker is not registered"))
                blockingThreads.removeAt(index)
                blockingWork -= 1L
            }
            checkTermination()
        }
    }

    private fun shouldStopWorkers(): Boolean {
        if (phase != ExecutorPhase.Draining || tasks != 0L || workersStopping)
            return false
        workersStopping = true
        return true
    }

    private fun stopWorkers() {
        workers.requestShutdown()
        if (ownsBlockingPool)
            blockingPool.requestShutdown()
        checkTermination()
    }

    private fun checkTermination() {
        if (!workers.isTerminated || (ownsBlockingPool && !blockingPool.isTerminated))
            return
        val notifications = WaitNotifications()
        val publish =
            lock.withLock {
                if (phase != ExecutorPhase.Draining || tasks != 0L || blockingWork != 0L)
                    return@withLock false
                phase = ExecutorPhase.Terminated
                terminationListeners.finishLocked(notifications)
                changed.broadcast()
                true
            }
        if (publish) {
            notifications.add { terminated.close() }
            notifications.deliver()
        }
    }

    private fun checkNotSelf() {
        val current = currentCoroutineExecutorOrNone()
        when (current) {
            case Some(val executor) -> if (executor === this)
                throw IllegalStateException(Some("executor task cannot wait for its own executor"))
            case None -> {}
        }
        if (workers.isCurrentWorker || (ownsBlockingPool && blockingPool.isCurrentWorker))
            throw IllegalStateException(Some("worker cannot wait for its own executor"))
        val id = currentThreadId()
        val blocking =
            lock.withLock {
                for (worker in blockingThreads)
                    if (worker == id)
                        return@withLock true
                false
            }
        if (blocking)
            throw IllegalStateException(Some("blocking work cannot wait for its own executor"))
    }
}

private enum ExecutorPhase {
    Open, Draining, Terminated
}

private class ExecutorBlockingWork(
    private val owner: MultiThreadExecutor,
    private val work: BlockingWork
): BlockingWork {
    public override fun run() {
        owner.runBlocking(work)
    }
}
