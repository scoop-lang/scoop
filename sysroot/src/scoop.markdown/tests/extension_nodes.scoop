package scoop.markdown

import scoop.test.*

@Test
private class MarkdownNodeExtensionTests {
    @Test
    fun standardNodesKeepTheirSemanticDataAndCompleteSource() {
        val imageSource = "![**雪**](picture.png \"title\")"
        val source = imageSource + "\n\n```mermaid config\r\nA --> B\r\n```\r\n\r\n    plain\n"
        val document = MarkdownDocument.fromText(source)
        val parsed = document.parse(MarkdownProfile.Editor)
        val index = parsed.extensionIndex()
        assertEquals(3L, index.spans.size)
        val image = index.spans[0L]
        assertSame(parsed.snapshot, image.snapshot)
        assertSame(parsed.node(image.node.id), image.node)
        assertEquals("image", image.name)
        assertEquals(MarkdownExtensionForm.Inline, image.form)
        assertEquals(imageSource, image.snapshot.read(image.sourceRange))
        when (image.node.content) {
            case MarkdownContent.Image(val target) -> {
                assertEquals("picture.png", target.destination.text)
                assertEquals("title", target.title.text)
                assertEquals(MarkdownLinkStyle.Inline, target.style)
            }
            else -> fail(Some("Image routing must preserve the Image node"))
        }
        assertEquals("mermaid", index.spans[1L].name)
        when (index.spans[1L].node.content) {
            case MarkdownContent.CodeBlock(val fence, val info, val body) -> {
                assertTrue(fence!!.closed)
                assertEquals("mermaid config", info.text)
                assertEquals("A --> B\n", body.text)
            }
            else -> fail(Some("Code routing must preserve the CodeBlock node"))
        }
        assertEquals("code", index.spans[2L].name)
        assertTrue(index.spans[2L].closed)
        assertEquals(source, document.toMarkdown())
    }

    @Test
    fun referenceTargetsStayOutsideTheOccurrenceAndFollowDefinitionEdits() {
        val definition = "[asset]: images/a.svg \"你好\"\n\n"
        val use = "![**雪**][asset]"
        val document = MarkdownDocument.fromText(definition + use)
        val parsed = document.parse()
        val image = parsed.extensionIndex().spans[0L]
        assertEquals(
            MarkdownRange(definition.byteLength, definition.byteLength + use.byteLength),
            image.sourceRange
        )
        when (image.node.content) {
            case MarkdownContent.Image(val target) -> {
                assertEquals("asset", target.label)
                assertEquals("你好", target.title.text)
                assertEquals(MarkdownLinkStyle.FullReference, target.style)
                assertTrue(target.destinationRange!!.end < image.sourceRange.start)
                assertEquals("images/a.svg", parsed.snapshot.read(target.destinationRange!!))
                document.replace(target.destinationRange!!, "images/b.svg")
                val current = document.parse().extensionIndex()
                assertTrue(
                    when (current.forNode(image.node.id)) {
                        case None -> true;
                        case Some(_) -> false
                    }
                )
                assertEquals(use, current.snapshot.read(current.spans[0L].sourceRange))
                when (current.spans[0L].node.content) {
                    case MarkdownContent.Image(val updated) -> assertEquals(
                        "images/b.svg",
                        updated.destination.text
                    )
                    else -> fail(Some("Expected updated image"))
                }
                assertEquals("images/a.svg", target.destination.text)
            }
            else -> fail(Some("Expected reference image"))
        }
    }

    @Test
    fun imagePlacementUsesActualParagraphContext() {
        val source =
            "![one](a)\n\ntext ![two](b)\n\n# ![three](c)\n\n[![four](d)](link)\n\n![five](e) ![six](f)\n\n  ![seven](g)   "
        val profile =
            MarkdownProfile(nodeExtensions = [markdownImageExtension(standaloneBlock = true)])
        val index = MarkdownDocument.fromText(source).parse(profile).extensionIndex()
        assertEquals(7L, index.spans.size)
        for (position in 0L ..< index.spans.size)
            assertEquals(
                if (position == 0L || position == 6L)
                    MarkdownExtensionForm.Block
                else
                    MarkdownExtensionForm.Inline,
                index.spans[position].form
            )
    }

    @Test
    fun firstMatchingRuleWinsAndUnknownOrIndentedCodeFallsBack() {
        val profile =
            MarkdownProfile(
                nodeExtensions =
                    [
                        markdownCodeExtension("demo", "chosen"),
                        markdownCodeExtension("demo", "ignored")
                    ]
            )
        val source = "~~~demo mode\nA\n~~~\n\n```unknown\nB\n```\n\n    demo\n\n```demo\nC"
        val index = MarkdownDocument.fromText(source).parse(profile).extensionIndex()
        assertEquals(4L, index.spans.size)
        assertEquals("chosen", index.spans[0L].name)
        assertEquals("code", index.spans[1L].name)
        assertEquals("code", index.spans[2L].name)
        assertEquals("chosen", index.spans[3L].name)
        assertFalse(index.spans[3L].closed)
        assertEquals(source, index.snapshot.toMarkdown())
    }

    @Test
    fun escapedAndCodeTextDoNotBecomeImageOccurrences() {
        val source = "\\![escaped](a) `![inline code](b)`\n\n```text\n![block code](c)\n```\n"
        val index = MarkdownDocument.fromText(source).parse().extensionIndex()
        assertEquals(1L, index.spans.size)
        assertEquals("code", index.spans[0L].name)
    }

    @Test
    fun invalidRuleConfigurationAndLayoutConflictsAreReported() {
        assertFailsWith<IllegalArgumentException> { markdownCodeExtension("") }
        assertFailsWith<IllegalArgumentException> { markdownCodeExtension("two words") }
        assertFailsWith<IllegalArgumentException> { markdownImageExtension(name = "") }
        assertFailsWith<IllegalArgumentException> {
            MarkdownProfile(nodeExtensions = [WrongNodeRule("")])
        }
        val invalid = MarkdownProfile(nodeExtensions = [WrongNodeRule("wrong")])
        assertFailsWith<IllegalArgumentException> {
            MarkdownDocument.fromText("text ![image](a)").parse(invalid).extensionIndex()
        }
        val shared = markdownCodeExtension("demo")
        assertTrue(
            MarkdownProfile(nodeExtensions = [shared]) == MarkdownProfile(nodeExtensions = [shared])
        )
        assertFalse(
            MarkdownProfile(nodeExtensions = [shared]) ==
                MarkdownProfile(nodeExtensions = [markdownCodeExtension("demo")])
        )
        val sameName =
            MarkdownProfile(nodeExtensions = [shared, markdownImageExtension(name = "demo")])
        assertEquals(2L, sameName.nodeExtensions.size)
    }
}

private class WrongNodeRule(public override val name: String): MarkdownNodeExtension {
    public override fun match(input: MarkdownNodeExtensionInput): MarkdownExtensionForm? =
        when (input.node.content) {
            case MarkdownContent.Image(_) -> Some(MarkdownExtensionForm.Block)
            else -> None
        }
}
