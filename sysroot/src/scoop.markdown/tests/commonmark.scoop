package scoop.markdown

import scoop.compiler.includeStr
import scoop.json.Json
import scoop.test.*

@Test
private class MarkdownCommonMarkTests {
    @Test
    fun `all 652 CommonMark 0_31_2 examples`() {
        val examples = Json.parse(includeStr("data/commonmark-0.31.2.json"))
        assertEquals(652L, examples.size)
        var failed = 0L
        val details = StringBuilder()
        for (example in examples.elements()) {
            val source = example["markdown"]!!.asString()
            val expected = example["html"]!!.asString()
            val document = MarkdownDocument.fromText(source)
            val result = document.parse(MarkdownProfile.CommonMark)
            val actual = mdTestHtml(result)
            if (actual != expected) {
                failed += 1L
                details.append("Example ").append(example["example"]!!.asLong()).append(
                    ": "
                ).append(example["section"]!!.asString()).append('\n')
                details.append("Source: ").append(Json.stringify(example["markdown"]!!)).append(
                    '\n'
                )
                details.append("Expected: ").append(expected).append("Actual: ").append(
                    actual
                ).append('\n')
            }
            assertEquals(source, document.toMarkdown())
        }
        assertEquals(0L, failed, Some(details.toString()))
    }
}
