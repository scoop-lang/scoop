package scoop.examples.markdown

import scoop.markdown.*
import scoop.test.*

@Test
private class MarkdownExtensionExampleTests {
    @Test
    fun aConsumerSharesNodeAndSyntaxExtensionsWithoutAnyRenderer() {
        val profile =
            MarkdownProfile(
                extensions = [ConsumerTag()],
                nodeExtensions =
                    [ConsumerCodeRule(), markdownImageExtension(standaloneBlock = true)]
            )
        val source = "@tag(雪)\n\n![alt](asset.png)\n\n```diagram\nA --> B\n```\n"
        val document = MarkdownDocument.fromText(source)
        val parsed = document.parse(profile)
        val index = parsed.extensionIndex()
        assertEquals(3L, index.spans.size)
        assertEquals("consumer-tag", index.spans[0L].name)
        assertEquals(MarkdownExtensionForm.Block, index.spans[1L].form)
        val diagram = index.spans[2L]
        assertEquals("consumer-diagram", diagram.name)
        assertSame(diagram, index.at(MarkdownPosition(diagram.sourceRange.start + 1L))!!)
        assertSame(diagram, index.forNode(diagram.node.id)!!)
        assertEquals(source, document.toMarkdown())
    }

    @Test
    fun `a headless consumer supplies custom syntax beside formulas and directives`() {
        val profile =
            MarkdownProfile(
                math = true,
                footnotes = true,
                extensions = [ConsumerTag(), mdBookDirectives()]
            )
        val source = "Use @tag(雪), $x^2$ and {{#include sample.rs:part}}.[^a]\n\n[^a]: Note.\n"
        val document = MarkdownDocument.fromText(source)
        val parsed = document.parse(profile)
        val names = ArrayList<String>()
        for (node in parsed.nodes())
            when (node.content) {
                case MarkdownContent.Extension(val value) -> {
                    names.add(value.name)
                    if (value.name == "consumer-tag")
                        assertEquals("雪", value.body.text)
                }
                else -> Unit
            }
        assertEquals(3L, names.size)
        assertEquals("consumer-tag", names[0L])
        assertEquals("math", names[1L])
        assertEquals("mdbook", names[2L])
        assertEquals(1L, parsed.footnotes.size)
        assertEquals(source, document.toMarkdown())
    }
}

private class ConsumerCodeRule: MarkdownNodeExtension {
    public override val name: String = "consumer-diagram"
    public override fun match(input: MarkdownNodeExtensionInput): MarkdownExtensionForm? =
        when (input.node.content) {
            case MarkdownContent.CodeBlock(_, val info, _) ->
            if (info.text == "diagram")
                Some(MarkdownExtensionForm.Block)
            else
                None
            else -> None
        }
}

private class ConsumerTag: MarkdownExtension {
    public override val name: String = "consumer-tag"
    public override val trigger: String = "@tag("
    public override val locations: MarkdownExtensionLocations = MarkdownExtensionLocations()
    public override fun parse(
        input: MarkdownExtensionInput,
        offset: Long
    ): MarkdownExtensionMatch? {
        val end = input.find(")", offset + 5L) ?: return None
        return Some(MarkdownExtensionMatch(end + 1L, MarkdownRange(offset + 5L, end)))
    }
}
