package scoop.markdown

/** A prepared source transaction and its selection in the resulting source coordinates. */
public class MarkdownInlineEdit internal constructor(
    public val change: MarkdownChange,
    public val selection: MarkdownRange,
    public val after: MarkdownInlineContent
) {
    public val documentId: MarkdownDocumentId get() = change.before.documentId
    public val edit: MarkdownEdit = MarkdownEdit(change.beforeRevision, change.replacements)
    public fun applyTo(document: MarkdownDocument): MarkdownChange {
        return document.applyPrepared(change)
    }
}

/** Editable semantic text of one paragraph, heading or table cell, without UI resources. */
public class MarkdownInlineContent internal constructor(
    public val snapshot: MarkdownSnapshot,
    public val profile: MarkdownProfile,
    internal val node: MarkdownNode,
    internal val placement: MdInlinePlacement,
    internal val model: MdInlineModel
) {
    public val text: MarkdownText get() = model.text
    public val sourceRange: MarkdownRange get() = placement.scope
    public val nodes: Array<MarkdownNode> get() = node.children

    public fun edit(configure: MarkdownInlineEditBuilder.() -> Unit): MarkdownInlineEdit {
        val builder = MarkdownInlineEditBuilder(this)
        builder.configure()
        return builder.finish()
    }

    public fun replaceText(
        range: MarkdownRange,
        text: String,
        bias: MarkdownBias = MarkdownBias.After,
        code: Boolean? = None
    ): MarkdownInlineEdit = mdInlineReplace(this, range, text, bias, code)

    public fun setStyle(
        range: MarkdownRange,
        style: MarkdownInlineStyle,
        enabled: Boolean
    ): MarkdownInlineEdit = mdInlineSetStyle(this, range, style, enabled)

    public fun styleState(
        range: MarkdownRange,
        style: MarkdownInlineStyle,
        bias: MarkdownBias = MarkdownBias.After
    ): MarkdownStyleState {
        mdInlineCheckRange(this, range)
        return mdInlineStyleCount(this, range, style, bias).state
    }
}

public fun MarkdownSyntax.inlineContent(id: MarkdownNodeId): MarkdownInlineContent {
    val node = node(id)
    if (node === root && snapshot.byteLength == 0L) {
        val source = MarkdownText("", [], 0L)
        val range = MarkdownRange(0L, 0L)
        val fragment =
            MarkdownNode(MarkdownNodeId(0L), MarkdownContent.Paragraph(source), range, [], [])
        return MarkdownInlineContent(
            snapshot,
            profile,
            fragment,
            MdInlinePlacement(root.id, range, "\n", "", false),
            MdInlineModel(source, [])
        )
    }
    when (node.content) {
        case MarkdownContent.ListItem(_) -> {
            requireMarkdown(
                mdEmptyListItem(node),
                "Only an empty list item is an inline insertion region"
            )
            if (node.children.size == 1L)
                return inlineContent(node.children[0L].id)
            val at = snapshot.lineRange(mdNodeLine(snapshot, node)).end
            val marker = snapshot.read(node.markers[0L])
            val bytes = marker.toByteArray()
            val leading =
                if (bytes.size > 0L && !mdSpace(bytes[bytes.size - 1L].toInt()))
                    " "
                else
                    ""
            return mdEmptyInlineContent(
                this,
                node.id,
                at,
                node.range,
                mdListPrefix(this, node, true),
                leading
            )
        }
        else -> Unit
    }
    val source = mdInlineSource(node)
    if (source.byteLength == 0L) {
        val item = parent(node.id)
        when (item?.content) {
            case Some(MarkdownContent.ListItem(Some(_))) -> {
                val owner = item!!
                if (owner.children[0L].id === node.id) {
                    val at = snapshot.lineRange(mdNodeLine(snapshot, node)).end
                    return mdEmptyInlineContent(
                        this,
                        node.id,
                        at,
                        node.range,
                        mdListPrefix(this, owner, true),
                        if (at == owner.markers[1L].end)
                            " "
                        else
                            ""
                    )
                }
            }
            else -> Unit
        }
    }
    return MarkdownInlineContent(
        snapshot,
        profile,
        node,
        mdInlinePlacement(this, node),
        mdInlineModel(snapshot, node, source.emptyPosition)
    )
}

internal enum MdInlineUnitKind {
    Text, Code, SoftBreak, HardBreak, Object
}

internal class MdInlineLink(val id: MarkdownNodeId, val target: MarkdownLinkTarget)

internal class MdInlineUnit(
    val kind: MdInlineUnitKind,
    val text: String,
    val flags: Int,
    val link: MdInlineLink?,
    val node: MarkdownNode? = None,
    val raw: String = ""
)

internal class MdInlineModel(val text: MarkdownText, val units: Array<MdInlineUnit>)

private class MdInlineUnitFrame(val node: MarkdownNode, val flags: Int, val link: MdInlineLink?)

private fun mdUnitChildren(
    pending: ArrayList<MdInlineUnitFrame>,
    node: MarkdownNode,
    flags: Int,
    link: MdInlineLink?
) {
    var index = node.children.size
    while (index > 0L) {
        index -= 1L
        pending.add(MdInlineUnitFrame(node.children[index], flags, link))
    }
}

internal fun mdInlineModel(
    snapshot: MarkdownSnapshot,
    root: MarkdownNode,
    empty: Long
): MdInlineModel {
    val text = MdTextBuilder()
    val units = ArrayList<MdInlineUnit>()
    val pending = ArrayList<MdInlineUnitFrame>()
    mdUnitChildren(pending, root, 0, None)
    while (pending.size > 0L) {
        val frame = pending.removeAt(pending.size - 1L)
        val node = frame.node
        var kind = MdInlineUnitKind.Object
        var value = "\u{fffc}"
        var mapped: MarkdownText? = None
        when (node.content) {
            case MarkdownContent.Text(val body) -> {
                kind = MdInlineUnitKind.Text
                value = body.text
                mapped = Some(body)
            }
            case MarkdownContent.CodeSpan(val body) -> {
                kind = MdInlineUnitKind.Code
                value = body.text
                mapped = Some(body)
            }
            case MarkdownContent.SoftBreak -> {
                kind = MdInlineUnitKind.SoftBreak;
                value = " "
            }
            case MarkdownContent.HardBreak -> {
                kind = MdInlineUnitKind.HardBreak;
                value = "\n"
            }
            case MarkdownContent.Emphasis -> {
                mdUnitChildren(pending, node, frame.flags.or(1), frame.link);
                continue
            }
            case MarkdownContent.Strong -> {
                mdUnitChildren(pending, node, frame.flags.or(2), frame.link);
                continue
            }
            case MarkdownContent.Strikethrough -> {
                mdUnitChildren(pending, node, frame.flags.or(4), frame.link);
                continue
            }
            case MarkdownContent.Link(val target) -> {
                mdUnitChildren(pending, node, frame.flags, Some(MdInlineLink(node.id, target)))
                continue
            }
            else -> Unit
        }
        when (mapped) {
            case Some(val body) -> text.append(body)
            case None -> text.add(value, node.range, MarkdownTextMapping.Normalized)
        }
        units.add(
            MdInlineUnit(
                kind,
                value,
                frame.flags,
                frame.link,
                Some(node),
                snapshot.read(node.range)
            )
        )
    }
    return MdInlineModel(text.build(empty), units.toArray())
}

internal fun mdInlineCheckRange(content: MarkdownInlineContent, range: MarkdownRange) {
    requireMarkdown(
        range.start >= 0L && range.end >= range.start && range.end <= content.text.byteLength,
        "Inline text range is outside its content"
    )
    content.text.sourceAt(MarkdownPosition(range.start))
    content.text.sourceAt(MarkdownPosition(range.end))
}

internal fun mdInlineStyleFlag(style: MarkdownInlineStyle): Int =
    when (style) {
        case MarkdownInlineStyle.Emphasis -> 1
        case MarkdownInlineStyle.Strong -> 2
        case MarkdownInlineStyle.Strikethrough -> 4
    }
