package scoop.markdown

internal fun mdTextSetStyle(
    content: MarkdownTextContent,
    range: MarkdownRange,
    style: MarkdownInlineStyle,
    enabled: Boolean
): MarkdownTextEdit {
    requireMarkdown(
        style != MarkdownInlineStyle.Strikethrough || content.profile.strikethrough,
        "Strikethrough requires a profile with strikethrough enabled"
    )
    return mdTextFormat(content, range) {
        inline,
        selected -> inline.setStyle(selected, style, enabled)
    }
}

internal fun mdTextFormat(
    content: MarkdownTextContent,
    range: MarkdownRange,
    format: (MarkdownInlineContent, MarkdownRange) -> MarkdownInlineEdit
): MarkdownTextEdit {
    mdTextCheckRange(content, range)
    requireMarkdown(!range.isEmpty, "Text formatting needs a nonempty text range")
    return when (content.context) {
        case Inline(val value) -> {
            val edit = format(value, range)
            MarkdownTextEdit(
                edit.change,
                edit.selection,
                MarkdownRange(range.end, range.end),
                MarkdownTextContent(MdTextContext.Inline(edit.after), content.origin)
            )
        }
        case Blocks(val value) -> {
            val replacements = ArrayList<MarkdownReplacement>()
            for (block in value.blocks) {
                if (block.start >= range.end)
                    break
                if (block.end <= range.start)
                    continue
                val inline = block.inline ?: continue
                val selected =
                    MarkdownRange(
                        mdTextBlockOffset(block, range.start),
                        mdTextBlockOffset(block, range.end)
                    )
                val edit = format(inline, selected)
                for (replacement in edit.change.replacements)
                    replacements.add(replacement)
            }
            val change =
                content.snapshot.prepare(
                    MarkdownEdit(content.snapshot.revision, replacements.toArray())
                )
            val after =
                if (replacements.size == 0L)
                    content
                else
                    MarkdownTextContent(
                        MdTextContext.Blocks(
                            MdBlockText(value.syntax.region.after(change).parse())
                        ),
                        content.origin
                    )
            MarkdownTextEdit(
                change,
                mdInlineSelection(after.text, range),
                MarkdownRange(range.end, range.end),
                after
            )
        }
    }
}
