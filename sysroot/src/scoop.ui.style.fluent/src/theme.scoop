package scoop.ui.style.fluent

import scoop.graphics.*
import scoop.graphics.text.*
import scoop.surface.AnimationSpec
import scoop.time.Duration
import scoop.ui.style.*

/** Fluent-like self-drawn shapes, layered surfaces and explicit scrollbar end buttons. */
public fun fluentTheme(
    mode: ThemeMode = ThemeMode.Light,
    configure: ShapeThemeBuilder.() -> Unit = {}
): ShapeTheme {
    val dark = mode == ThemeMode.Dark
    val palette =
        if (dark)
            ThemePalette(
                canvas = Color(0.125, 0.125, 0.125),
                surface = Color(0.18, 0.18, 0.18),
                elevated = Color(0.22, 0.22, 0.22),
                text = Color(0.96, 0.96, 0.96),
                secondaryText = Color(0.75, 0.75, 0.75),
                disabledText = Color(0.47, 0.47, 0.47),
                border = Color(0.38, 0.38, 0.38),
                accent = Color(0.38, 0.80, 1.0),
                onAccent = Color(0.0, 0.18, 0.26),
                focus = Color.White,
                shadow = Color.Black.withAlpha(0.5),
                error = Color(1.0, 0.60, 0.60)
            )
        else
            ThemePalette(
                canvas = Color(0.953, 0.953, 0.953),
                surface = Color(0.985, 0.985, 0.985),
                elevated = Color.White,
                text = Color(0.11, 0.11, 0.11),
                secondaryText = Color(0.37, 0.37, 0.37),
                disabledText = Color(0.63, 0.63, 0.63),
                border = Color(0.68, 0.68, 0.68),
                accent = Color(0.0, 0.40, 0.62),
                onAccent = Color.White,
                focus = Color(0.05, 0.05, 0.05),
                shadow = Color.Black.withAlpha(0.16),
                error = Color(0.77, 0.12, 0.18)
            )
    val families = ["Segoe UI Variable Text", "Segoe UI", "Arial", "sans-serif"]
    val fonts =
        themeTypography(
            body =
                textStyle {
                    this.families = families
                    this.fontSize = 14.0
                    this.color = palette.text
                },
            caption =
                textStyle {
                    this.families = families
                    this.fontSize = 12.0
                    this.color = palette.secondaryText
                },
            action =
                textStyle {
                    this.families = families
                    this.fontSize = 14.0
                    this.color = palette.text
                    this.weight = 600
                }
        )
    val effects =
        themeEffects {
            this.raised = [BoxShadow(Point(0.0, 1.0), 1.0, 1.0, palette.shadow)]
            this.floating = [BoxShadow(Point(0.0, 6.0), 10.0, 10.0, palette.shadow)]
            this.emphasis = [ContentEffect.Glow(4.0, 4.0, palette.accent.withAlpha(0.42))]
        }
    val tokens =
        themeTokens(
            palette = palette,
            typography = fonts,
            spacing = ThemeSpacing(4.0, 8.0, 16.0),
            corners = ThemeCorners(2.0, 4.0, 8.0)
        ) {
            this.mode = mode
            motion {
                this.hover = tween(100L)
                this.press = tween(60L)
                this.selection = tween(140L)
            }
            this.effects = effects
        }
    val normal =
        StateColors(
            palette.surface,
            mixThemeColor(palette.surface, palette.text, 0.035),
            mixThemeColor(palette.surface, palette.text, 0.07),
            mixThemeColor(palette.surface, palette.canvas, 0.60)
        )
    val accent =
        StateColors(
            palette.accent,
            mixThemeColor(palette.accent, palette.canvas, 0.10),
            mixThemeColor(palette.accent, palette.canvas, 0.20),
            mixThemeColor(palette.canvas, palette.text, 0.15)
        )
    val edges =
        StateColors(
            palette.border,
            palette.secondaryText,
            palette.border,
            mixThemeColor(palette.border, palette.canvas, 0.60)
        )
    val text = StateColors(palette.text, palette.text, palette.secondaryText, palette.disabledText)
    val onAccent =
        StateColors(palette.onAccent, palette.onAccent, palette.onAccent, palette.disabledText)
    val focus = FocusStyle(palette.focus, 1.5, 3.0)
    val plain =
        surfacePart(
            metrics =
                SurfaceMetrics(
                    Size(80.0, 32.0),
                    Size(32.0, 32.0),
                    Insets(12.0, 5.0, 12.0, 5.0),
                    Insets.all(1.0),
                    CornerRadii.all(4.0),
                    focus.outset
                ),
            fill = normal,
            border = edges,
            foreground = text,
            focus = focus
        ) { this.shadows = effects.raised }
    val action =
        surfacePart(
            metrics =
                SurfaceMetrics(
                    Size(80.0, 32.0),
                    Size(32.0, 32.0),
                    Insets(12.0, 5.0, 12.0, 5.0),
                    Insets.all(1.0),
                    CornerRadii.all(4.0),
                    focus.outset
                ),
            fill = accent,
            border = accent,
            foreground = onAccent,
            focus = focus
        ) { this.shadows = effects.raised }
    val elevated =
        surfacePart(
            metrics =
                SurfaceMetrics(
                    Size(112.0, 64.0),
                    Size(0.0, 0.0),
                    Insets.all(12.0),
                    Insets.all(1.0),
                    CornerRadii.all(8.0),
                    focus.outset
                ),
            fill = StateColors.solid(palette.elevated),
            border = edges,
            foreground = text,
            focus = focus
        ) { this.shadows = effects.floating }
    val marker =
        markerAppearance(
            empty = normal,
            selected = accent,
            border = edges,
            selectedBorder = accent,
            mark = onAccent,
            focus = FocusStyle(palette.focus, 1.5, 3.0)
        )
    val track =
        StateColors(
            palette.secondaryText.withAlpha(0.05),
            palette.secondaryText.withAlpha(0.10),
            palette.secondaryText.withAlpha(0.15),
            Color.Transparent
        )
    val thumb =
        StateColors(
            palette.secondaryText.withAlpha(0.65),
            palette.secondaryText,
            palette.accent,
            palette.disabledText.withAlpha(0.35)
        )
    return shapeTheme(
        tokens = tokens,
        surfaces = surfaceParts(plain = plain, action = action, elevated = elevated),
        checkbox =
            checkboxPart(
                metrics =
                    CheckboxMetrics(
                        Size(18.0, 18.0),
                        Size(14.0, 14.0),
                        Insets.all(1.0),
                        CornerRadii.all(2.0),
                        4.0,
                        1.8,
                        marker.focus.outset
                    ),
                appearance = marker
            ),
        radio =
            radioPart(
                metrics =
                    RadioMetrics(Size(18.0, 18.0), Size(14.0, 14.0), 1.0, 5.0, marker.focus.outset),
                appearance = marker
            ),
        scrollbar =
            scrollbarPart(
                metrics = ScrollbarMetrics(16.0, 28.0, 1.0, 2.0, 4.0, Some(16.0)),
                track = track,
                thumb = thumb,
                button = normal,
                arrow = text
            ),
        configure = configure
    )
}

private fun tween(milliseconds: Long): AnimationSpec? =
    Some(AnimationSpec.Tween(Duration.milliseconds(milliseconds)))
