package scoop.graphics.text

import scoop.graphics.*
import scoop.math.abs
import scoop.test.*

@Test
private class StyledTextTest {
    @Test
    fun `public span resolution preserves local choices while following a changed parent`() {
        val local =
            spanStyle {
                this.color = Some(Color.White)
                this.lineHeight = Some(None)
                this.features = Some([])
            }
        val small =
            local.resolve(
                textStyle {
                    this.families = ["Test Sans"]
                    this.fontSize = 13.0
                    this.lineHeight = Some(2.0)
                    this.features = [FontFeature("kern", 0)]
                }
            )
        val large =
            local.resolve(
                textStyle {
                    this.families = ["Test CJK"]
                    this.fontSize = 22.0
                    this.weight = 700
                    this.letterSpacing = 1.5
                }
            )
        assertEquals(13.0, small.fontSize)
        assertEquals(22.0, large.fontSize)
        assertEquals("Test CJK", large.families[0L])
        assertEquals(700, large.weight)
        assertEquals(1.5, large.letterSpacing)
        assertEquals(Color.White, small.color)
        assertEquals(Color.White, large.color)
        assertEquals(None, small.lineHeight)
        assertEquals(None, large.lineHeight)
        assertEquals(0L, small.features.size)
        assertEquals(0L, large.features.size)
    }

    @Test
    fun `nested spans inherit fonts and restore the parent color for following siblings`() {
        testFonts().use {
            fonts ->
            val content =
                styledText {
                    this.text("HH")
                    this.span {
                        style {
                            this.fontSize = Some(32.0)
                            this.color = Some(Color(0.0, 1.0, 0.0))
                        }
                        this.span {
                            style { this.color = Some(Color(0.0, 0.0, 1.0)) }
                            this.text("H")
                        }
                        this.text("H")
                    }
                    style {
                        this.families = ["Test Sans"]
                        this.fontSize = 20.0
                        this.color = Color(1.0, 0.0, 0.0)
                    }
                }
            assertEquals("HHHH", content.text)
            Paragraph(fonts, content).use {
                paragraph -> paragraph.layoutUnwrapped().use {
                    layout ->
                    assertSame(content, paragraph.content)
                    assertSame(content, layout.content)
                    assertEquals(0, layout.unresolvedGlyphCount)
                    assertTrue(abs(layout.maxIntrinsicWidth - 74.140625) < 0.01)
                }
            }
            val pixels = paintContent(fonts, content)
            for (channel in 0 ..< 3)
                assertTrue(coloredPixels(pixels, channel) > 20)
        }
    }

    @Test
    fun `font family overrides replace rather than append to the inherited fallback list`() {
        testFonts().use {
            fonts ->
            val base =
                textStyle {
                    this.families = ["Test CJK"]
                    this.fontSize = 24.0
                }
            val inherited =
                styledText {
                    this.span {
                        this.style = spanStyle()
                        this.text("是")
                    }
                    this.style = base
                }
            val replaced =
                styledText {
                    this.span {
                        style { this.families = Some(["Test Sans"]) }
                        this.text("是")
                    }
                    this.style = base
                }
            Paragraph(fonts, inherited).use {
                paragraph -> paragraph.layoutUnwrapped().use {
                    layout -> assertEquals(0, layout.unresolvedGlyphCount)
                }
            }
            Paragraph(fonts, replaced).use {
                paragraph -> paragraph.layoutUnwrapped().use {
                    layout -> assertTrue(layout.unresolvedGlyphCount > 0)
                }
            }
        }
    }

    @Test
    fun `explicitly clearing line height restores natural metrics while omission inherits`() {
        testFonts().use {
            fonts ->
            val base =
                textStyle {
                    this.families = ["Test Sans"]
                    this.fontSize = 20.0
                    this.lineHeight = Some(2.0)
                }
            val inherited =
                styledText {
                    this.span {
                        this.style = spanStyle()
                        this.text("HH")
                    }
                    this.style = base
                }
            val reset =
                styledText {
                    this.span {
                        style { this.lineHeight = Some(None) }
                        this.text("HH")
                    }
                    this.style = base
                }
            val natural =
                styledText {
                    this.text("HH")
                    style {
                        this.families = ["Test Sans"]
                        this.fontSize = 20.0
                    }
                }
            val reference = contentHeight(fonts, natural)
            assertTrue(contentHeight(fonts, inherited) > reference + 10.0)
            assertTrue(abs(contentHeight(fonts, reset) - reference) < 0.01)
        }
    }

    @Test
    fun `empty feature arrays restore default kerning instead of retaining the parent feature`() {
        testFonts().use {
            fonts ->
            val base =
                textStyle {
                    this.families = ["Test Sans"]
                    this.fontSize = 40.0
                    this.features = [FontFeature("kern", 0)]
                }
            val inherited =
                styledText {
                    this.span {
                        this.style = spanStyle()
                        this.text("AVAV")
                    }
                    this.style = base
                }
            val reset =
                styledText {
                    this.span {
                        style { this.features = Some([]) }
                        this.text("AVAV")
                    }
                    this.style = base
                }
            val natural =
                styledText {
                    this.text("AVAV")
                    style {
                        this.families = ["Test Sans"]
                        this.fontSize = 40.0
                    }
                }
            val reference = contentWidth(fonts, natural)
            assertTrue(abs(contentWidth(fonts, inherited) - reference) > 0.1)
            assertTrue(abs(contentWidth(fonts, reset) - reference) < 0.01)
        }
    }

    @Test
    fun `empty variation arrays clear inherited axes for actual glyph painting`() {
        testFonts().use {
            fonts ->
            val base =
                textStyle {
                    this.families = ["Test CJK"]
                    this.fontSize = 48.0
                    this.variations = [FontVariation("wght", 900.0)]
                }
            val inherited =
                styledText {
                    this.span {
                        this.style = spanStyle()
                        this.text("是")
                    }
                    this.style = base
                }
            val reset =
                styledText {
                    this.span {
                        style { this.variations = Some([]) }
                        this.text("是")
                    }
                    this.style = base
                }
            val natural =
                styledText {
                    this.text("是")
                    style {
                        this.families = ["Test CJK"]
                        this.fontSize = 48.0
                    }
                }
            val reference = paintContent(fonts, natural)
            assertFalse(samePixels(reference, paintContent(fonts, inherited)))
            assertTrue(samePixels(reference, paintContent(fonts, reset)))
        }
    }

    @Test
    fun `empty fragments preserve base metrics and fragment boundaries do not split shaping`() {
        testFonts().use {
            fonts ->
            val base =
                textStyle {
                    this.families = ["Test Sans"]
                    this.fontSize = 40.0
                    this.lineHeight = Some(2.0)
                }
            val content =
                styledText {
                    this.text("")
                    this.span {
                        style { this.fontSize = Some(100.0) }
                        this.text("")
                    }
                    this.style = base
                }
            assertEquals("", content.text)
            Paragraph(fonts, content).use {
                paragraph -> paragraph.layout(100.0).use {
                    layout ->
                    assertEquals(1L, layout.lines.size)
                    assertTrue(layout.size.height > 60.0 && layout.size.height < 100.0)
                    assertTrue(layout.caret(TextPosition(0L)) != None)
                }
            }
            val fragments =
                styledText {
                    this.text("f")
                    this.text("")
                    this.text("i")
                    this.style = base
                }
            val whole =
                styledText {
                    this.text("fi")
                    this.style = base
                }
            assertTrue(samePixels(paintContent(fonts, whole), paintContent(fonts, fragments)))
        }
    }

    @Test
    fun `plain text ranges use UTF8 scalar offsets even when fragments split a grapheme`() {
        val content =
            styledText {
                this.text("A是e")
                this.span {
                    style { this.color = Some(Color.White) }
                    this.text("́😀")
                }
            }
        assertEquals("A是é😀", content.text)
        assertEquals(content.text, content.toPlainText())
        assertEquals("是é", content.toPlainText(TextRange(1L, 7L)))
        assertEquals("😀", content.toPlainText(TextRange(7L, 11L)))
        assertEquals("", content.toPlainText(TextRange(11L, 11L)))
        assertFailsWith<IllegalArgumentException> { content.toPlainText(TextRange(2L, 2L)) }
        assertFailsWith<IllegalArgumentException> { content.toPlainText(TextRange(1L, 3L)) }
        assertFailsWith<IllegalArgumentException> { content.toPlainText(TextRange(1L, 12L)) }
        assertFailsWith<IllegalArgumentException> { content.toPlainText(TextRange(-1L, 0L)) }
    }
}

private fun contentHeight(fonts: FontCollection, content: StyledText): Double =
    Paragraph(fonts, content).use {
        paragraph -> paragraph.layoutUnwrapped().use { layout -> layout.size.height }
    }

private fun contentWidth(fonts: FontCollection, content: StyledText): Double =
    Paragraph(fonts, content).use {
        paragraph -> paragraph.layoutUnwrapped().use { layout -> layout.maxIntrinsicWidth }
    }

private fun paintContent(fonts: FontCollection, content: StyledText): Array<Byte> =
    Paragraph(fonts, content).use {
        paragraph -> paragraph.layoutUnwrapped().use {
            layout -> RasterSurface(200, 100).use {
                surface ->
                surface.draw {
                    canvas ->
                    canvas.clear(Color.Transparent)
                    canvas.drawText(layout, Point(4.0, 4.0))
                }
                surface.readPixels()
            }
        }
    }

private fun coloredPixels(pixels: Array<Byte>, channel: Int): Int {
    var result = 0
    for (index in 0L ..< pixels.size / 4L)
        if (
            pixels[index * 4L + 3L].toUByte().toInt() >
                128 &&
                pixels[index * 4L + channel.toLong()].toUByte().toInt() >
                200
        )
            result += 1
    return result
}

private fun samePixels(left: Array<Byte>, right: Array<Byte>): Boolean {
    if (left.size != right.size)
        return false
    for (index in 0L ..< left.size)
        if (left[index] != right[index])
            return false
    return true
}
