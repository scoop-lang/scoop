package scoop.graphics.svg

import scoop.graphics.*
import scoop.test.*

@Test
private class SvgDrawingTest {
    @Test
    fun `absolute dimensions scale once and the caller transform clip and save depth survive`() {
        SvgDocument.parse(
            """<svg width="10" height="10"><rect x="2" y="2" width="6" height="6" fill="red"/></svg>"""
        ).use {
            document -> RasterSurface(40, 40).use {
                surface ->
                surface.draw {
                    canvas ->
                    canvas.clear(Color.Transparent)
                    canvas.translate(2.0, 3.0)
                    canvas.clipRect(Rect(0.0, 0.0, 20.0, 20.0))
                    canvas.drawSvg(document, Rect(1.0, 1.0, 20.0, 20.0))
                    assertEquals(Transform.translation(2.0, 3.0), canvas.pixelTransform)
                    canvas.drawRect(Rect(0.0, 0.0, 2.0, 2.0), Paint(Color(0.0, 0.0, 1.0)))
                    canvas.drawRect(Rect(19.0, 19.0, 6.0, 6.0), Paint(Color.White))
                    assertFailsWith<IllegalArgumentException> { canvas.restore() }
                }
                val pixels = surface.readPixels()
                assertEquals(255, svgChannel(pixels, 40, 8, 9, 0))
                assertEquals(0, svgChannel(pixels, 40, 6, 9, 3))
                assertEquals(255, svgChannel(pixels, 40, 2, 3, 2))
                assertEquals(255, svgChannel(pixels, 40, 21, 22, 3))
                assertEquals(0, svgChannel(pixels, 40, 22, 22, 3))
            }
        }
    }

    @Test
    fun `nonzero view box preserves aspect while relative width resolves from the container`() {
        val pixels =
            svgPixels(
                """<svg viewBox="10 20 10 10"><rect x="10" y="20" width="10" height="10" fill="blue"/></svg>""",
                40,
                20
            )
        assertEquals(0, svgChannel(pixels, 40, 5, 10, 3))
        assertEquals(255, svgChannel(pixels, 40, 15, 10, 2))
        assertEquals(0, svgChannel(pixels, 40, 35, 10, 3))
        val relative =
            svgPixels(
                """<svg width="50%" height="100%" viewBox="0 0 10 10" preserveAspectRatio="none"><rect width="10" height="10"/></svg>""",
                40,
                20
            )
        assertEquals(255, svgChannel(relative, 40, 19, 19, 3))
        assertEquals(0, svgChannel(relative, 40, 20, 19, 3))
    }

    @Test
    fun `all basic shapes and path commands draw through nested transforms`() {
        val shapes =
            [
                """<path d="M3 4 L8 4 H12 V8 C12 12 8 15 6 12 S2 8 3 4 Z"/>""",
                """<path d="M3 8 Q8 1 13 8 T18 8 A4 4 0 0 1 14 12 Z"/>""",
                """<circle cx="10" cy="10" r="6"/>""",
                """<ellipse cx="10" cy="10" rx="8" ry="4"/>""",
                """<rect x="3" y="3" width="14" height="14" rx="2"/>""",
                """<line x1="3" y1="3" x2="17" y2="17" stroke="black" stroke-width="2"/>""",
                """<polyline points="3,3 10,17 17,3" fill="none" stroke="black" stroke-width="2"/>""",
                """<polygon points="3,3 10,17 17,3"/>"""
            ]
        for (shape in shapes) {
            val pixels =
                svgPixels(
                    "<svg viewBox=\"0 0 40 40\"><g transform=\"translate(10 10)\"><g transform=\"scale(1)\">" +
                        shape +
                        "</g></g></svg>"
                )
            var ink = 0
            for (y in 0 ..< 40)
                for (x in 0 ..< 40) {
                    if (svgChannel(pixels, 40, x, y, 3) > 0) {
                        ink += 1
                        // The polyline's default miter extends past its final vertex.
                        assertTrue(
                            x >= 11 && x <= 32 && y >= 9 && y <= 30,
                            Some(shape + f" at ${x},${y}")
                        )
                    }
                }
            assertTrue(ink > 20)
        }
    }

    @Test
    fun `root color overrides are transient and explicit descendant colors win`() {
        SvgDocument.parse(
            """<svg width="20" height="20" color="red"><rect width="10" height="20" fill="currentColor"/><g color="blue"><rect x="10" width="10" height="20" fill="currentColor"/></g></svg>"""
        ).use {
            document -> RasterSurface(60, 20).use {
                surface ->
                surface.draw {
                    canvas ->
                    canvas.clear(Color.Transparent)
                    canvas.drawSvg(
                        document,
                        Rect(0.0, 0.0, 20.0, 20.0),
                        SvgDrawOptions(currentColor = Some(Color(0.0, 1.0, 0.0)))
                    )
                    canvas.drawSvg(document, Rect(20.0, 0.0, 20.0, 20.0))
                    canvas.drawSvg(
                        document,
                        Rect(40.0, 0.0, 20.0, 20.0),
                        SvgDrawOptions(currentColor = Some(Color(1.0, 1.0, 1.0, 0.5)))
                    )
                }
                val pixels = surface.readPixels()
                assertEquals(255, svgChannel(pixels, 60, 5, 10, 1))
                assertEquals(255, svgChannel(pixels, 60, 25, 10, 0))
                assertEquals(128, svgChannel(pixels, 60, 45, 10, 3))
                for (x in [15, 35, 55])
                    assertEquals(255, svgChannel(pixels, 60, x, 10, 2))
            }
        }
    }

    @Test
    fun `root stroke width restores and does not replace a child width`() {
        SvgDocument.parse(
            """<svg width="20" height="20" stroke="black" stroke-width="2"><line x1="2" y1="6" x2="18" y2="6"/><line x1="2" y1="14" x2="18" y2="14" stroke-width="2"/></svg>"""
        ).use {
            document -> RasterSurface(40, 20).use {
                surface ->
                surface.draw {
                    canvas ->
                    canvas.clear(Color.Transparent)
                    canvas.drawSvg(
                        document,
                        Rect(0.0, 0.0, 20.0, 20.0),
                        SvgDrawOptions(rootStrokeWidth = Some(6.0))
                    )
                    canvas.drawSvg(document, Rect(20.0, 0.0, 20.0, 20.0))
                }
                val pixels = surface.readPixels()
                assertEquals(255, svgChannel(pixels, 40, 10, 3, 3))
                assertEquals(0, svgChannel(pixels, 40, 30, 3, 3))
                assertEquals(255, svgChannel(pixels, 40, 30, 5, 3))
                assertEquals(0, svgChannel(pixels, 40, 10, 11, 3))
                assertEquals(255, svgChannel(pixels, 40, 10, 13, 3))
            }
        }
    }

    @Test
    fun `whole image opacity composites overlapping shapes once`() {
        val pixels =
            svgPixels(
                """<svg viewBox="0 0 40 40"><rect x="4" y="4" width="24" height="24"/><rect x="12" y="12" width="24" height="24"/></svg>""",
                options = SvgDrawOptions(opacity = 0.5)
            )
        assertEquals(128, svgChannel(pixels, 40, 6, 6, 3))
        assertEquals(128, svgChannel(pixels, 40, 20, 20, 3))
        assertEquals(128, svgChannel(pixels, 40, 32, 32, 3))
    }

    @Test
    fun `gradient clip and blur reach the fixed Skia effect implementations`() {
        val gradient =
            svgPixels(
                """<svg viewBox="0 0 40 40"><defs><linearGradient id="g"><stop stop-color="red"/><stop offset="1" stop-color="blue"/></linearGradient><clipPath id="c"><rect x="5" y="5" width="30" height="30"/></clipPath></defs><rect width="40" height="40" fill="url(#g)" clip-path="url(#c)"/></svg>"""
            )
        assertEquals(0, svgChannel(gradient, 40, 2, 20, 3))
        assertTrue(svgChannel(gradient, 40, 10, 20, 0) > svgChannel(gradient, 40, 10, 20, 2))
        assertTrue(svgChannel(gradient, 40, 30, 20, 2) > svgChannel(gradient, 40, 30, 20, 0))
        val blurred =
            svgPixels(
                """<svg viewBox="0 0 40 40"><defs><filter id="b" x="-100%" y="-100%" width="300%" height="300%"><feGaussianBlur stdDeviation="2"/></filter></defs><rect x="12" y="12" width="16" height="16" filter="url(#b)"/></svg>"""
            )
        assertTrue(svgChannel(blurred, 40, 10, 20, 3) > 0)
        assertTrue(svgChannel(blurred, 40, 20, 20, 3) > 240)
    }
}
