package scoop.ui.style.macos

import scoop.graphics.*
import scoop.graphics.text.*
import scoop.surface.AnimationSpec
import scoop.surface.Easing
import scoop.time.Duration
import scoop.ui.style.*

/** Sequoia Aqua controls; palette changes never opt into Liquid Glass or native chrome. */
public fun macosTheme(
    mode: ThemeMode = ThemeMode.Light,
    palette: ThemePalette? = None,
    configure: ShapeThemeBuilder.() -> Unit = {}
): ShapeTheme {
    val colors = palette ?: macosPalette(mode)
    val families = [".AppleSystemUIFont", "Helvetica Neue", "sans-serif"]
    val fonts = themeTypography(
        body = textStyle {
            this.families = families
            this.fontSize = 13.0
            this.lineHeight = Some(16.0 / 13.0)
            this.color = colors.background.foreground
        },
        caption = textStyle {
            this.families = families
            this.fontSize = 11.0
            this.lineHeight = Some(14.0 / 11.0)
            this.color = colors.muted.foreground
        },
        action = textStyle {
            this.families = families
            this.fontSize = 13.0
            this.lineHeight = Some(16.0 / 13.0)
            this.color = colors.background.foreground
            this.weight = 400
        }
    )
    val effects = themeEffects {
        this.raised = [
            BoxShadow(
                Point(0.0, 1.0), 0.5, 0.5,
                colors.shadow.withAlpha(colors.shadow.alpha * 0.5)
            )
        ]
        this.floating = [
            BoxShadow(Point(0.0, 6.0), 10.0, 10.0, colors.shadow),
            BoxShadow(
                Point(0.0, 0.0), 1.0, 1.0,
                colors.shadow.withAlpha(colors.shadow.alpha * 0.5)
            )
        ]
    }
    val tokens = themeTokens(
        palette = colors,
        typography = fonts,
        spacing = ThemeSpacing(4.0, 8.0, 12.0),
        corners = ThemeCorners(3.0, 5.0, 8.0),
        validation = OutlineStyle(
            colors.destructive.background.withAlpha(0.72),
            2.0, 2.0, Some(colors.destructive.background)
        )
    ) {
        this.mode = mode
        motion {
            this.selection = Some(
                AnimationSpec
                    .Tween(
                        Duration.milliseconds(100L),
                        Easing.cubicBezier(0.42, 0.0, 0.58, 1.0)
                    )
            )
        }
        this.effects = effects
    }
    // Window, content and control backgrounds are separate Aqua semantic roles.
    val control = colors.secondary.background
    val disabledFill = control.withAlpha(control.alpha * 0.5)
    val normal = StateColors(
        control,
        control,
        mixThemeColor(control, colors.background.foreground, 0.12),
        disabledFill
    )
    val accent = StateColors(
        colors.primary.background,
        colors.primary.background,
        mixThemeColor(colors.primary.background, Color.Black, 0.16),
        disabledFill
    )
    val edges = StateColors(
        colors.input,
        colors.input,
        mixThemeColor(colors.input, colors.background.foreground, 0.12),
        colors.input.withAlpha(colors.input.alpha * 0.5)
    )
    val text = StateColors(
        colors.background.foreground, colors.background.foreground,
        colors.background.foreground, colors.disabledText
    )
    val onAccent = StateColors(
        colors.primary.foreground, colors.primary.foreground,
        colors.primary.foreground, colors.disabledText
    )
    // Equal width/outset keeps the focus ring against the control, without an empty moat.
    val focus = OutlineStyle(colors.ring, 3.0, 3.0)
    val metrics = SurfaceMetrics(
        Size(68.0, 22.0), Size(22.0, 22.0), Insets(10.0, 2.0, 10.0, 2.0),
        Insets.all(0.5), CornerRadii.all(5.0), focus.outset
    )
    val plain = surfacePart(
        metrics = metrics, fill = normal, border = edges, foreground = text, focus = focus
    ) { this.shadows = effects.raised }
    val action = surfacePart(
        metrics = metrics,
        fill = accent,
        border = StateColors(
            accent.normal, accent.hovered, accent.pressed, edges.disabled
        ),
        foreground = onAccent,
        focus = focus
    ) { this.shadows = effects.raised }
    val elevated = surfacePart(
        metrics = SurfaceMetrics(
            Size(96.0, 64.0), Size(0.0, 0.0), Insets.all(12.0),
            Insets.all(0.5), CornerRadii.all(8.0), focus.outset
        ),
        fill = StateColors.solid(colors.popover.background),
        border = StateColors.solid(colors.border),
        foreground = text,
        focus = focus
    ) { this.shadows = effects.floating }
    val marker = markerAppearance(
        empty = normal,
        selected = accent,
        border = edges,
        selectedBorder = StateColors(
            accent.normal, accent.hovered, accent.pressed, edges.disabled
        ),
        mark = onAccent,
        focus = focus
    )
    val track = StateColors.solid(colors.muted.background)
    val thumb = StateColors(
        colors.background.foreground.withAlpha(colors.background.foreground.alpha * 0.55),
        colors.background.foreground.withAlpha(colors.background.foreground.alpha * 0.70),
        colors.background.foreground.withAlpha(colors.background.foreground.alpha * 0.85),
        colors.disabledText
    )
    return shapeTheme(
        tokens = tokens,
        surfaces = surfaceParts(plain = plain, action = action, elevated = elevated),
        checkbox = checkboxPart(
            metrics = CheckboxMetrics(
                Size(14.0, 14.0), Size(14.0, 14.0), Insets.all(0.5),
                CornerRadii.all(3.0), 3.0, 1.5, focus.outset
            ),
            appearance = marker
        ),
        radio = radioPart(
            metrics = RadioMetrics(
                Size(14.0, 14.0), Size(14.0, 14.0), 0.5, 4.5, focus.outset
            ),
            appearance = marker
        ),
        scrollbar = scrollbarPart(
            metrics = ScrollbarMetrics(15.0, 24.0, 0.0, 3.0, 6.0, None),
            track = track,
            thumb = thumb,
            button = StateColors.solid(Color.Transparent),
            arrow = text
        ),
        configure = configure
    )
}
