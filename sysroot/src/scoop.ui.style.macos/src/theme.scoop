package scoop.ui.style.macos

import scoop.graphics.*
import scoop.graphics.text.*
import scoop.surface.AnimationSpec
import scoop.time.Duration
import scoop.ui.style.*

/** A self-drawn compact macOS preset; native window decorations remain a window option. */
public fun macosTheme(
    mode: ThemeMode = ThemeMode.Light,
    configure: ShapeThemeBuilder.() -> Unit = {}
): ShapeTheme {
    val dark = mode == ThemeMode.Dark
    val palette =
        if (dark)
            ThemePalette(
                canvas = Color(0.12, 0.12, 0.13),
                surface = Color(0.23, 0.23, 0.25),
                elevated = Color(0.28, 0.28, 0.30),
                text = Color(0.94, 0.94, 0.96),
                secondaryText = Color(0.70, 0.70, 0.73),
                disabledText = Color(0.48, 0.48, 0.51),
                border = Color(0.40, 0.40, 0.43),
                accent = Color(0.04, 0.52, 1.0),
                onAccent = Color.White,
                focus = Color(0.20, 0.60, 1.0),
                shadow = Color.Black.withAlpha(0.42),
                error = Color(1.0, 0.42, 0.38)
            )
        else
            ThemePalette(
                canvas = Color(0.94, 0.94, 0.96),
                surface = Color.White,
                elevated = Color.White,
                text = Color(0.12, 0.12, 0.14),
                secondaryText = Color(0.40, 0.40, 0.43),
                disabledText = Color(0.62, 0.62, 0.65),
                border = Color(0.70, 0.70, 0.73),
                accent = Color(0.0, 0.48, 1.0),
                onAccent = Color.White,
                focus = Color(0.0, 0.48, 1.0),
                shadow = Color.Black.withAlpha(0.18),
                error = Color(0.82, 0.14, 0.12)
            )
    val families = [".AppleSystemUIFont", "Helvetica Neue", "sans-serif"]
    val fonts =
        themeTypography(
            body =
                textStyle {
                    this.families = families
                    this.fontSize = 13.0
                    this.color = palette.text
                },
            caption =
                textStyle {
                    this.families = families
                    this.fontSize = 11.0
                    this.color = palette.secondaryText
                },
            action =
                textStyle {
                    this.families = families
                    this.fontSize = 13.0
                    this.color = palette.text
                    this.weight = 500
                }
        )
    val effects =
        themeEffects {
            this.raised = [BoxShadow(Point(0.0, 1.0), 0.8, 0.8, palette.shadow)]
            this.floating = [BoxShadow(Point(0.0, 4.0), 8.0, 8.0, palette.shadow)]
            this.emphasis = [ContentEffect.Glow(3.0, 3.0, palette.accent.withAlpha(0.45))]
        }
    val tokens =
        themeTokens(
            palette = palette,
            typography = fonts,
            spacing = ThemeSpacing(4.0, 8.0, 12.0),
            corners = ThemeCorners(3.0, 6.0, 10.0)
        ) {
            this.mode = mode
            motion {
                this.hover = tween(80L)
                this.press = tween(55L)
                this.selection = tween(100L)
            }
            this.effects = effects
        }
    val normal =
        StateColors(
            palette.surface,
            mixThemeColor(palette.surface, palette.accent, 0.08),
            mixThemeColor(palette.surface, palette.text, 0.12),
            mixThemeColor(palette.surface, palette.canvas, 0.55)
        )
    val accent =
        StateColors(
            palette.accent,
            mixThemeColor(palette.accent, Color.White, 0.12),
            mixThemeColor(palette.accent, Color.Black, 0.18),
            mixThemeColor(palette.canvas, palette.accent, 0.28)
        )
    val edges =
        StateColors(
            palette.border,
            palette.border,
            palette.secondaryText,
            mixThemeColor(palette.border, palette.canvas, 0.60)
        )
    val text = StateColors(palette.text, palette.text, palette.text, palette.disabledText)
    val onAccent =
        StateColors(palette.onAccent, palette.onAccent, palette.onAccent, palette.disabledText)
    val focus = FocusStyle(palette.focus.withAlpha(0.72), 3.0, 4.0)
    val plain =
        surfacePart(
            metrics =
                SurfaceMetrics(
                    Size(72.0, 28.0),
                    Size(24.0, 24.0),
                    Insets(10.0, 4.0, 10.0, 4.0),
                    0.75,
                    6.0,
                    focus.outset
                ),
            fill = normal,
            border = edges,
            foreground = text,
            focus = focus
        ) { this.shadows = effects.raised }
    val action =
        surfacePart(
            metrics =
                SurfaceMetrics(
                    Size(72.0, 28.0),
                    Size(32.0, 28.0),
                    Insets(10.0, 4.0, 10.0, 4.0),
                    0.75,
                    6.0,
                    focus.outset
                ),
            fill = accent,
            border = accent,
            foreground = onAccent,
            focus = focus
        ) { this.shadows = effects.raised }
    val elevated =
        surfacePart(
            metrics =
                SurfaceMetrics(
                    Size(96.0, 64.0),
                    Size(0.0, 0.0),
                    Insets.all(12.0),
                    0.75,
                    10.0,
                    focus.outset
                ),
            fill = StateColors.solid(palette.elevated),
            border = edges,
            foreground = text,
            focus = focus
        ) { this.shadows = effects.floating }
    val marker =
        markerAppearance(
            empty = normal,
            selected = accent,
            border = edges,
            selectedBorder = accent,
            mark = onAccent,
            focus = FocusStyle(palette.focus.withAlpha(0.72), 2.5, 3.5)
        )
    val track =
        StateColors(
            Color.Transparent,
            palette.secondaryText.withAlpha(0.12),
            palette.secondaryText.withAlpha(0.18),
            Color.Transparent
        )
    val thumb =
        StateColors(
            palette.secondaryText.withAlpha(0.58),
            palette.secondaryText.withAlpha(0.85),
            palette.text,
            palette.disabledText.withAlpha(0.3)
        )
    return shapeTheme(
        tokens = tokens,
        surfaces = surfaceParts(plain = plain, action = action, elevated = elevated),
        checkbox =
            checkboxPart(
                metrics =
                    CheckboxMetrics(
                        Size(16.0, 16.0),
                        Size(12.0, 12.0),
                        1.0,
                        3.0,
                        4.0,
                        1.7,
                        marker.focus.outset
                    ),
                appearance = marker
            ),
        radio =
            radioPart(
                metrics =
                    RadioMetrics(Size(16.0, 16.0), Size(12.0, 12.0), 1.0, 5.0, marker.focus.outset),
                appearance = marker
            ),
        scrollbar =
            scrollbarPart(
                metrics = ScrollbarMetrics(10.0, 24.0, 0.0, 2.0, 6.0, None),
                track = track,
                thumb = thumb,
                button = StateColors.solid(Color.Transparent),
                arrow = text
            ),
        configure = configure
    )
}

private fun tween(milliseconds: Long): AnimationSpec? =
    Some(AnimationSpec.Tween(Duration.milliseconds(milliseconds)))
