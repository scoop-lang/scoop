package scoop.window.asyncio

import scoop.asyncio.*
import scoop.window.*
import scoop.window.native.*

/** Runs window business callbacks in the attached asyncio root scope until both owners close. */
public fun Application.runWithAsyncio(handler: ApplicationHandler) {
    @Unsafe
    {
        runAttached(handler) {
            host ->
            val attachment = WindowAttachment(host)
            attachment.install()
            attachment
        }
    }
}

/** Returns the active business scope; cleanup notifications have no application scope. */
public fun currentApplicationScope(): CoroutineScope = applicationScope()

private class ScopeBinding(val scope: CoroutineScope)

context(binding: ScopeBinding)
private fun applicationScope(): CoroutineScope = binding.scope

private class WindowAttachment(private val host: ApplicationHost): ApplicationAttachment {
    private var session: EventLoopSession? = None
    private var cancellation: Disposable? = None

    fun install() {
        val value = eventLoop().attach(WindowLoopHost(host)) { error -> closed(error) }
        session = Some(value)
        value.post {
            val scope = this;
            val attachment = this @WindowAttachment
            attachment.cancellation =
                Some(
                    scope.job.invokeOnCancellation {
                        attachment.host.postControl { attachment.host.requestExit() }
                    }
                )
        }
    }

    public override fun post(block: () -> Unit): Boolean =
        session!!.post {
            val scope = this;
            context(ScopeBinding(scope)) {
                block()
            }
        }

    public override fun requestClose() {
        session!!.requestClose()
    }

    private fun closed(error: Throwable?) {
        var result = error
        try {
            when (cancellation) {
                case Some(value) -> value.dispose();
                case None -> {}
            }
        } catch (cleanup: Throwable) {
            result =
                Some(
                    when (error) {
                        case Some(primary) -> ResourceUseException(primary, cleanup);
                        case None -> cleanup
                    }
                )
        } finally {
            cancellation = None
        }
        host.complete(result)
    }
}
