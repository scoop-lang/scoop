package scoop.ui.style.material

import scoop.graphics.*
import scoop.graphics.text.*
import scoop.surface.AnimationSpec
import scoop.surface.Easing
import scoop.time.Duration
import scoop.ui.style.*

/** Material Design 3 colors, pill buttons and independent circular marker state layers. */
public fun materialTheme(
    mode: ThemeMode = ThemeMode.Light,
    palette: ThemePalette? = None,
    configure: ShapeThemeBuilder.() -> Unit = {}
): ShapeTheme {
    val colors = palette ?: materialPalette(mode)
    val families = ["Roboto", "Arial", "sans-serif"]
    val fonts = themeTypography(
        body = textStyle {
            this.families = families
            this.fontSize = 14.0
            this.lineHeight = Some(20.0 / 14.0)
            this.letterSpacing = 0.25
            this.color = colors.background.foreground
        },
        caption = textStyle {
            this.families = families
            this.fontSize = 12.0
            this.lineHeight = Some(16.0 / 12.0)
            this.letterSpacing = 0.4
            this.color = colors.muted.foreground
        },
        action = textStyle {
            this.families = families
            this.fontSize = 14.0
            this.lineHeight = Some(20.0 / 14.0)
            this.color = colors.background.foreground
            this.weight = 500
            this.letterSpacing = 0.1
        }
    ) {
        input {
            this.fontSize = 16.0
            this.lineHeight = Some(24.0 / 16.0)
            this.letterSpacing = 0.5
        }
    }
    val keyShadow = colors.shadow.withAlpha(colors.shadow.alpha * 0.3)
    val ambientShadow = colors.shadow.withAlpha(colors.shadow.alpha * 0.15)
    val effects = themeEffects {
        // CSS blur radii become Gaussian sigmas in the shared painter.
        this.raised = [
            BoxShadow(Point(0.0, 1.0), 1.0, 1.0, keyShadow),
            BoxShadow(Point(0.0, 1.0), 1.5, 1.5, ambientShadow)
        ]
        this.floating = [
            BoxShadow(Point(0.0, 1.0), 1.0, 1.0, keyShadow),
            BoxShadow(Point(0.0, 2.0), 3.0, 3.0, ambientShadow)
        ]
    }
    val tokens = themeTokens(
        palette = colors,
        typography = fonts,
        spacing = ThemeSpacing(4.0, 12.0, 24.0),
        corners = ThemeCorners(4.0, 12.0, 28.0),
        validation = OutlineStyle(
            colors.destructive.background.withAlpha(0.72),
            2.0, 0.0, Some(colors.destructive.background)
        )
    ) {
        this.mode = mode
        this.textField = TextFieldTreatment.Outlined
        motion {
            this.hover = materialTween(100L)
            this.press = materialTween(100L)
            this.selection = materialTween(200L)
        }
        this.effects = effects
    }
    val primary = colors.primary.background
    val onPrimary = colors.primary.foreground
    val onSurface = colors.background.foreground
    val disabledContainer = onSurface.withAlpha(onSurface.alpha * 0.12)
    val disabled = colors.disabledText
    val transparent = StateColors.solid(Color.Transparent)
    val onAccent = StateColors(onPrimary, onPrimary, onPrimary, disabled)
    val text = StateColors(onSurface, onSurface, onSurface, disabled)
    val accent = StateColors(
        primary,
        mixThemeColor(primary, onPrimary, 0.08),
        mixThemeColor(primary, onPrimary, 0.12), disabledContainer
    )
    val focus = OutlineStyle(colors.ring, 3.0, 5.0)
    val outlinedAction = surfacePart(
        metrics = SurfaceMetrics(
            Size(64.0, 40.0), Size(64.0, 40.0),
            Insets(23.0, 9.0, 23.0, 9.0), Insets.all(1.0), CornerRadii.all(9999.0), focus.outset
        ),
        fill = StateColors(
            Color.Transparent, primary.withAlpha(primary.alpha * 0.08),
            primary.withAlpha(primary.alpha * 0.12), Color.Transparent
        ),
        border = StateColors(colors.input, colors.input, colors.input, disabledContainer),
        foreground = StateColors(primary, primary, primary, disabled),
        focus = focus
    )
    val plain = surfacePart(
        metrics = SurfaceMetrics(
            Size(160.0, 56.0), Size(64.0, 56.0),
            Insets.all(15.0), Insets.all(1.0), CornerRadii.all(4.0), 0.0
        ),
        fill = transparent,
        border = StateColors(colors.input, onSurface, onSurface, disabledContainer),
        foreground = text,
        focus = OutlineStyle(primary, 2.0, 0.0, Some(primary))
    )
    val action = surfacePart(
        metrics = SurfaceMetrics(
            Size(64.0, 40.0), Size(64.0, 40.0),
            Insets(24.0, 10.0, 24.0, 10.0), Insets.all(0.0), CornerRadii.all(9999.0), focus.outset
        ),
        fill = accent, border = transparent, foreground = onAccent, focus = focus
    ) { this.hoverShadows = Some(effects.raised) }
    val elevated = surfacePart(
        metrics = SurfaceMetrics(
            Size(120.0, 72.0), Size(0.0, 0.0),
            Insets.all(16.0), Insets.all(0.0), CornerRadii.all(12.0), focus.outset
        ),
        fill = StateColors.solid(colors.popover.background),
        border = transparent, foreground = text, focus = focus
    ) { this.shadows = effects.floating }
    val markerEdges = StateColors(colors.muted.foreground, onSurface, onSurface, disabled)
    val selected = StateColors(primary, primary, primary, disabled)
    val layer = MarkerStateLayer(
        40.0,
        StateColors(
            Color.Transparent, onSurface.withAlpha(onSurface.alpha * 0.08),
            primary.withAlpha(primary.alpha * 0.12), Color.Transparent
        ),
        StateColors(
            Color.Transparent, primary.withAlpha(primary.alpha * 0.08),
            onSurface.withAlpha(onSurface.alpha * 0.12), Color.Transparent
        )
    )
    val checkAppearance = markerAppearance(
        empty = transparent, selected = selected, border = markerEdges,
        // A translucent selected fill must not be darkened again by an overlapping border.
        selectedBorder = transparent,
        mark = StateColors(onPrimary, onPrimary, onPrimary, colors.background.background),
        focus = focus
    ) { this.stateLayer = Some(layer) }
    val radioAppearance = markerAppearance(
        empty = transparent, selected = transparent, border = markerEdges,
        selectedBorder = selected, mark = selected, focus = focus
    ) { this.stateLayer = Some(layer) }
    val neutral = colors.muted.foreground
    return shapeTheme(
        tokens = tokens,
        surfaces = surfaceParts(
            plain = plain, action = action, outlinedAction = outlinedAction, elevated = elevated
        ),
        checkbox = checkboxPart(
            metrics = CheckboxMetrics(
                Size(18.0, 18.0), Size(18.0, 18.0),
                Insets.all(2.0), CornerRadii.all(2.0), 4.0, 2.0, 16.0
            ),
            appearance = checkAppearance
        ),
        radio = radioPart(
            metrics = RadioMetrics(Size(20.0, 20.0), Size(20.0, 20.0), 2.0, 5.0, 15.0),
            appearance = radioAppearance
        ),
        scrollbar = scrollbarPart(
            metrics = ScrollbarMetrics(14.0, 32.0, 1.0, 3.0, 8.0, None),
            track = StateColors(
                onSurface.withAlpha(onSurface.alpha * 0.04),
                onSurface.withAlpha(onSurface.alpha * 0.06),
                onSurface.withAlpha(onSurface.alpha * 0.08), Color.Transparent
            ),
            thumb = StateColors(
                neutral.withAlpha(neutral.alpha * 0.38),
                neutral.withAlpha(neutral.alpha * 0.5),
                neutral.withAlpha(neutral.alpha * 0.5), disabled
            ),
            button = transparent, arrow = text
        ) { this.arrowWidth = 2.0 },
        configure = configure
    )
}

private fun materialTween(milliseconds: Long): AnimationSpec? = Some(
    AnimationSpec.Tween(Duration.milliseconds(milliseconds), Easing.cubicBezier(0.2, 0.0, 0.0, 1.0))
)
