package scoop.ui.style.material

import scoop.graphics.*
import scoop.graphics.text.*
import scoop.surface.AnimationSpec
import scoop.time.Duration
import scoop.ui.style.*

/** Rounded Material surfaces, larger metrics, and selection colors in either brightness mode. */
public fun materialTheme(
    mode: ThemeMode = ThemeMode.Light,
    palette: ThemePalette? = None,
    configure: ShapeThemeBuilder.() -> Unit = {}
): ShapeTheme {
    val dark = mode == ThemeMode.Dark
    val colors = palette ?:
        if (dark)
            ThemePalette(
                background = ColorPair(Color(0.08, 0.07, 0.09), Color(0.91, 0.88, 0.94)),
                card = ColorPair(Color(0.14, 0.13, 0.16), Color(0.91, 0.88, 0.94)),
                popover = ColorPair(Color(0.20, 0.18, 0.23), Color(0.91, 0.88, 0.94)),
                primary = ColorPair(Color(0.82, 0.74, 0.99), Color(0.22, 0.15, 0.35)),
                secondary = ColorPair(Color(0.14, 0.13, 0.16), Color(0.91, 0.88, 0.94)),
                muted = ColorPair(Color(0.08, 0.07, 0.09), Color(0.79, 0.76, 0.82)),
                accent = ColorPair(Color(0.20, 0.18, 0.23), Color(0.91, 0.88, 0.94)),
                destructive = ColorPair(Color(0.976, 0.71, 0.678), Color(0.22, 0.15, 0.35)),
                border = Color(0.57, 0.54, 0.60),
                input = Color(0.57, 0.54, 0.60),
                ring = Color(0.82, 0.74, 0.99),
                chart = ChartPalette(
                    Color(0.82, 0.74, 0.99),
                    Color(0.976, 0.71, 0.678),
                    Color(0.79, 0.76, 0.82),
                    Color(0.82, 0.74, 0.99),
                    Color(0.91, 0.88, 0.94)
                ),
                sidebar = SidebarPalette(
                    ColorPair(Color(0.08, 0.07, 0.09), Color(0.91, 0.88, 0.94)),
                    ColorPair(Color(0.82, 0.74, 0.99), Color(0.22, 0.15, 0.35)),
                    ColorPair(Color(0.20, 0.18, 0.23), Color(0.91, 0.88, 0.94)),
                    Color(0.57, 0.54, 0.60),
                    Color(0.82, 0.74, 0.99)
                ),
                disabledText = Color(0.49, 0.47, 0.52),
                shadow = Color.Black.withAlpha(0.5)
            )
        else
            ThemePalette(
                background = ColorPair(Color(0.985, 0.976, 1.0), Color(0.12, 0.11, 0.14)),
                card = ColorPair(Color(0.96, 0.94, 0.98), Color(0.12, 0.11, 0.14)),
                popover = ColorPair(Color(0.93, 0.91, 0.96), Color(0.12, 0.11, 0.14)),
                primary = ColorPair(Color(0.40, 0.31, 0.68), Color.White),
                secondary = ColorPair(Color(0.96, 0.94, 0.98), Color(0.12, 0.11, 0.14)),
                muted = ColorPair(Color(0.985, 0.976, 1.0), Color(0.29, 0.27, 0.31)),
                accent = ColorPair(Color(0.93, 0.91, 0.96), Color(0.12, 0.11, 0.14)),
                destructive = ColorPair(Color(0.70, 0.15, 0.12), Color.White),
                border = Color(0.48, 0.46, 0.50),
                input = Color(0.48, 0.46, 0.50),
                ring = Color(0.40, 0.31, 0.68),
                chart = ChartPalette(
                    Color(0.40, 0.31, 0.68),
                    Color(0.70, 0.15, 0.12),
                    Color(0.29, 0.27, 0.31),
                    Color(0.40, 0.31, 0.68),
                    Color(0.12, 0.11, 0.14)
                ),
                sidebar = SidebarPalette(
                    ColorPair(Color(0.985, 0.976, 1.0), Color(0.12, 0.11, 0.14)),
                    ColorPair(Color(0.40, 0.31, 0.68), Color.White),
                    ColorPair(Color(0.93, 0.91, 0.96), Color(0.12, 0.11, 0.14)),
                    Color(0.48, 0.46, 0.50),
                    Color(0.40, 0.31, 0.68)
                ),
                disabledText = Color(0.61, 0.59, 0.63),
                shadow = Color.Black.withAlpha(0.24)
            )
    val families = ["Roboto", "Arial", "sans-serif"]
    val fonts = themeTypography(
        body = textStyle {
            this.families = families
            this.fontSize = 14.0
            this.color = colors.background.foreground
        },
        caption = textStyle {
            this.families = families
            this.fontSize = 12.0
            this.color = colors.muted.foreground
        },
        action = textStyle {
            this.families = families
            this.fontSize = 14.0
            this.color = colors.background.foreground
            this.weight = 500
            this.letterSpacing = 0.1
        }
    )
    val effects = themeEffects {
        this.raised = [BoxShadow(Point(0.0, 2.0), 2.0, 2.0, colors.shadow)]
        this.floating = [BoxShadow(Point(0.0, 5.0), 7.0, 7.0, colors.shadow)]
        this.emphasis = [ContentEffect.Glow(5.0, 5.0, colors.primary.background.withAlpha(0.38))]
    }
    val tokens = themeTokens(
        palette = colors,
        typography = fonts,
        spacing = ThemeSpacing(4.0, 12.0, 24.0),
        corners = ThemeCorners(4.0, 12.0, 20.0),
        validation = OutlineStyle(
            colors.destructive.background.withAlpha(0.72),
            2.0,
            2.0,
            Some(colors.destructive.background)
        )
    ) {
        this.mode = mode
        motion {
            this.hover = tween(120L)
            this.press = tween(70L)
            this.selection = tween(180L)
        }
        this.effects = effects
    }
    val normal = StateColors(
        colors.card.background,
        mixThemeColor(colors.card.background, colors.primary.background, 0.08),
        mixThemeColor(colors.card.background, colors.primary.background, 0.16),
        mixThemeColor(colors.card.background, colors.background.background, 0.50)
    )
    val accent = StateColors(
        colors.primary.background,
        mixThemeColor(colors.primary.background, colors.primary.foreground, 0.08),
        mixThemeColor(colors.primary.background, colors.primary.foreground, 0.18),
        mixThemeColor(colors.background.background, colors.background.foreground, 0.12)
    )
    val edges = StateColors(
        colors.border,
        colors.primary.background,
        colors.primary.background,
        colors.disabledText
    )
    val text = StateColors(
        colors.background.foreground,
        colors.background.foreground,
        colors.background.foreground,
        colors.disabledText
    )
    val onAccent = StateColors(
        colors.primary.foreground,
        colors.primary.foreground,
        colors.primary.foreground,
        colors.disabledText
    )
    val focus = OutlineStyle(colors.ring, 2.0, 4.0)
    val plain = surfacePart(
        metrics = SurfaceMetrics(
            Size(88.0, 40.0),
            Size(48.0, 40.0),
            Insets(16.0, 9.0, 16.0, 9.0),
            Insets.all(1.0),
            CornerRadii.all(20.0),
            focus.outset
        ),
        fill = normal,
        border = edges,
        foreground = text,
        focus = focus
    )
    val action = surfacePart(
        metrics = SurfaceMetrics(
            Size(88.0, 40.0),
            Size(48.0, 40.0),
            Insets(16.0, 9.0, 16.0, 9.0),
            Insets.all(0.0),
            CornerRadii.all(20.0),
            focus.outset
        ),
        fill = accent,
        border = accent,
        foreground = onAccent,
        focus = focus
    ) { this.shadows = effects.raised }
    val elevated = surfacePart(
        metrics = SurfaceMetrics(
            Size(120.0, 72.0),
            Size(0.0, 0.0),
            Insets.all(16.0),
            Insets.all(0.0),
            CornerRadii.all(12.0),
            focus.outset
        ),
        fill = StateColors.solid(colors.popover.background),
        border = edges,
        foreground = text,
        focus = focus
    ) { this.shadows = effects.floating }
    val checkAppearance = markerAppearance(
        empty = normal,
        selected = accent,
        border = edges,
        selectedBorder = accent,
        mark = onAccent,
        focus = OutlineStyle(colors.ring.withAlpha(0.5), 3.0, 6.0)
    )
    val radioAppearance = markerAppearance(
        empty = normal,
        selected = normal,
        border = edges,
        selectedBorder = accent,
        mark = accent,
        focus = checkAppearance.focus
    )
    val track = StateColors(
        colors.primary.background.withAlpha(0.05),
        colors.primary.background.withAlpha(0.10),
        colors.primary.background.withAlpha(0.16),
        Color.Transparent
    )
    val thumb = StateColors(
        colors.primary.background.withAlpha(0.6),
        colors.primary.background,
        mixThemeColor(colors.primary.background, colors.background.foreground, 0.18),
        colors.disabledText.withAlpha(0.35)
    )
    return shapeTheme(
        tokens = tokens,
        surfaces = surfaceParts(plain = plain, action = action, elevated = elevated),
        checkbox = checkboxPart(
            metrics = CheckboxMetrics(
                Size(20.0, 20.0),
                Size(16.0, 16.0),
                Insets.all(2.0),
                CornerRadii.all(2.0),
                4.0,
                2.0,
                checkAppearance.focus.outset
            ),
            appearance = checkAppearance
        ),
        radio = radioPart(
            metrics = RadioMetrics(
                Size(20.0, 20.0),
                Size(16.0, 16.0),
                2.0,
                5.0,
                radioAppearance.focus.outset
            ),
            appearance = radioAppearance
        ),
        scrollbar = scrollbarPart(
            metrics = ScrollbarMetrics(14.0, 32.0, 1.0, 3.0, 8.0, None),
            track = track,
            thumb = thumb,
            button = StateColors.solid(Color.Transparent),
            arrow = text
        ) { this.arrowWidth = 2.0 },
        configure = configure
    )
}

private fun tween(milliseconds: Long): AnimationSpec? = Some(
    AnimationSpec.Tween(Duration.milliseconds(milliseconds))
)
