package scoop.ui.style.material

import scoop.graphics.*
import scoop.graphics.text.*
import scoop.surface.AnimationSpec
import scoop.time.Duration
import scoop.ui.style.*

/** Rounded Material surfaces, larger metrics, and selection colors in either brightness mode. */
public fun materialTheme(
    mode: ThemeMode = ThemeMode.Light,
    configure: ShapeThemeBuilder.() -> Unit = {}
): ShapeTheme {
    val dark = mode == ThemeMode.Dark
    val palette =
        if (dark)
            ThemePalette(
                canvas = Color(0.08, 0.07, 0.09),
                surface = Color(0.14, 0.13, 0.16),
                elevated = Color(0.20, 0.18, 0.23),
                text = Color(0.91, 0.88, 0.94),
                secondaryText = Color(0.79, 0.76, 0.82),
                disabledText = Color(0.49, 0.47, 0.52),
                border = Color(0.57, 0.54, 0.60),
                accent = Color(0.82, 0.74, 0.99),
                onAccent = Color(0.22, 0.15, 0.35),
                focus = Color(0.82, 0.74, 0.99),
                shadow = Color.Black.withAlpha(0.5),
                error = Color(0.976, 0.71, 0.678)
            )
        else
            ThemePalette(
                canvas = Color(0.985, 0.976, 1.0),
                surface = Color(0.96, 0.94, 0.98),
                elevated = Color(0.93, 0.91, 0.96),
                text = Color(0.12, 0.11, 0.14),
                secondaryText = Color(0.29, 0.27, 0.31),
                disabledText = Color(0.61, 0.59, 0.63),
                border = Color(0.48, 0.46, 0.50),
                accent = Color(0.40, 0.31, 0.68),
                onAccent = Color.White,
                focus = Color(0.40, 0.31, 0.68),
                shadow = Color.Black.withAlpha(0.24),
                error = Color(0.70, 0.15, 0.12)
            )
    val families = ["Roboto", "Arial", "sans-serif"]
    val fonts =
        themeTypography(
            body =
                textStyle {
                    this.families = families
                    this.fontSize = 14.0
                    this.color = palette.text
                },
            caption =
                textStyle {
                    this.families = families
                    this.fontSize = 12.0
                    this.color = palette.secondaryText
                },
            action =
                textStyle {
                    this.families = families
                    this.fontSize = 14.0
                    this.color = palette.text
                    this.weight = 500
                    this.letterSpacing = 0.1
                }
        )
    val effects =
        themeEffects {
            this.raised = [BoxShadow(Point(0.0, 2.0), 2.0, 2.0, palette.shadow)]
            this.floating = [BoxShadow(Point(0.0, 5.0), 7.0, 7.0, palette.shadow)]
            this.emphasis = [ContentEffect.Glow(5.0, 5.0, palette.accent.withAlpha(0.38))]
        }
    val tokens =
        themeTokens(
            palette = palette,
            typography = fonts,
            spacing = ThemeSpacing(4.0, 12.0, 24.0),
            corners = ThemeCorners(4.0, 12.0, 20.0)
        ) {
            this.mode = mode
            motion {
                this.hover = tween(120L)
                this.press = tween(70L)
                this.selection = tween(180L)
            }
            this.effects = effects
        }
    val normal =
        StateColors(
            palette.surface,
            mixThemeColor(palette.surface, palette.accent, 0.08),
            mixThemeColor(palette.surface, palette.accent, 0.16),
            mixThemeColor(palette.surface, palette.canvas, 0.50)
        )
    val accent =
        StateColors(
            palette.accent,
            mixThemeColor(palette.accent, palette.onAccent, 0.08),
            mixThemeColor(palette.accent, palette.onAccent, 0.18),
            mixThemeColor(palette.canvas, palette.text, 0.12)
        )
    val edges = StateColors(palette.border, palette.accent, palette.accent, palette.disabledText)
    val text = StateColors(palette.text, palette.text, palette.text, palette.disabledText)
    val onAccent =
        StateColors(palette.onAccent, palette.onAccent, palette.onAccent, palette.disabledText)
    val focus = FocusStyle(palette.focus, 2.0, 4.0)
    val plain =
        surfacePart(
            metrics =
                SurfaceMetrics(
                    Size(88.0, 40.0),
                    Size(48.0, 40.0),
                    Insets(16.0, 9.0, 16.0, 9.0),
                    1.0,
                    20.0,
                    focus.outset
                ),
            fill = normal,
            border = edges,
            foreground = text,
            focus = focus
        )
    val action =
        surfacePart(
            metrics =
                SurfaceMetrics(
                    Size(88.0, 40.0),
                    Size(48.0, 40.0),
                    Insets(16.0, 9.0, 16.0, 9.0),
                    0.0,
                    20.0,
                    focus.outset
                ),
            fill = accent,
            border = accent,
            foreground = onAccent,
            focus = focus
        ) { this.shadows = effects.raised }
    val elevated =
        surfacePart(
            metrics =
                SurfaceMetrics(
                    Size(120.0, 72.0),
                    Size(0.0, 0.0),
                    Insets.all(16.0),
                    0.0,
                    12.0,
                    focus.outset
                ),
            fill = StateColors.solid(palette.elevated),
            border = edges,
            foreground = text,
            focus = focus
        ) { this.shadows = effects.floating }
    val checkAppearance =
        markerAppearance(
            empty = normal,
            selected = accent,
            border = edges,
            selectedBorder = accent,
            mark = onAccent,
            focus = FocusStyle(palette.focus.withAlpha(0.5), 3.0, 6.0)
        )
    val radioAppearance =
        markerAppearance(
            empty = normal,
            selected = normal,
            border = edges,
            selectedBorder = accent,
            mark = accent,
            focus = checkAppearance.focus
        )
    val track =
        StateColors(
            palette.accent.withAlpha(0.05),
            palette.accent.withAlpha(0.10),
            palette.accent.withAlpha(0.16),
            Color.Transparent
        )
    val thumb =
        StateColors(
            palette.accent.withAlpha(0.6),
            palette.accent,
            mixThemeColor(palette.accent, palette.text, 0.18),
            palette.disabledText.withAlpha(0.35)
        )
    return shapeTheme(
        tokens = tokens,
        surfaces = surfaceParts(plain = plain, action = action, elevated = elevated),
        checkbox =
            checkboxPart(
                metrics =
                    CheckboxMetrics(
                        Size(20.0, 20.0),
                        Size(16.0, 16.0),
                        2.0,
                        2.0,
                        4.0,
                        2.0,
                        checkAppearance.focus.outset
                    ),
                appearance = checkAppearance
            ),
        radio =
            radioPart(
                metrics =
                    RadioMetrics(
                        Size(20.0, 20.0),
                        Size(16.0, 16.0),
                        2.0,
                        5.0,
                        radioAppearance.focus.outset
                    ),
                appearance = radioAppearance
            ),
        scrollbar =
            scrollbarPart(
                metrics = ScrollbarMetrics(14.0, 32.0, 1.0, 3.0, 8.0, None),
                track = track,
                thumb = thumb,
                button = StateColors.solid(Color.Transparent),
                arrow = text
            ) { this.arrowWidth = 2.0 },
        configure = configure
    )
}

private fun tween(milliseconds: Long): AnimationSpec? =
    Some(AnimationSpec.Tween(Duration.milliseconds(milliseconds)))
