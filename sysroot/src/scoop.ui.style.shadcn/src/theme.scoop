package scoop.ui.style.shadcn

import scoop.graphics.*
import scoop.graphics.text.*
import scoop.surface.AnimationSpec
import scoop.time.Duration
import scoop.ui.style.*

/** Base Nova / Neutral, using the shared geometry and painter. */
public fun shadcnTheme(
    mode: ThemeMode = ThemeMode.Light,
    palette: ThemePalette? = None,
    configure: ShapeThemeBuilder.() -> Unit = {}
): ShapeTheme {
    val dark = mode == ThemeMode.Dark
    val colors =
        palette ?:
            if (dark)
                darkPalette()
            else
                lightPalette()
    val body =
        textStyle {
            this.families = ["Inter", "Helvetica Neue", "Arial", "sans-serif"]
            this.fontSize = 14.0
            this.lineHeight = Some(20.0 / 14.0)
            this.color = colors.background.foreground
        }
    val fonts =
        themeTypography(
            body,
            body.copy {
                this.fontSize = 12.0
                this.lineHeight = Some(16.0 / 12.0)
                this.color = colors.muted.foreground
            },
            body.copy { this.weight = 500 }
        )
    val tokens =
        themeTokens(
            colors,
            fonts,
            ThemeSpacing(4.0, 8.0, 16.0),
            ThemeCorners(6.0, 8.0, 10.0),
            OutlineStyle(
                colors.destructive.background.withAlpha(
                    if (dark)
                        0.4
                    else
                        0.2
                ),
                3.0,
                3.0,
                Some(
                    colors.destructive.background.withAlpha(
                        if (dark)
                            0.5
                        else
                            1.0
                    )
                )
            )
        ) {
            this.mode = mode
            this.disabledOpacity = 0.5
            motion {
                this.hover = Some(AnimationSpec.Tween(Duration.milliseconds(150L)))
                this.press = Some(AnimationSpec.Tween(Duration.milliseconds(75L)))
                this.selection = Some(AnimationSpec.Tween(Duration.milliseconds(150L)))
            }
            effects {
                this.raised = [BoxShadow(Point(0.0, 1.0), 1.0, 1.0, colors.shadow)]
                this.floating = [BoxShadow(Point(0.0, 4.0), 6.0, 6.0, colors.shadow)]
            }
        }
    val focus = OutlineStyle(colors.ring.withAlpha(0.5), 3.0, 3.0, Some(colors.ring))
    val foreground = states(colors.background.foreground)
    val inputFill =
        if (dark)
            colors.input.withAlpha(colors.input.alpha * 0.3)
        else
            Color.Transparent
    val plain =
        surfacePart(
            SurfaceMetrics(
                Size(0.0, 32.0),
                Size(0.0, 0.0),
                Insets(10.0, 4.0, 10.0, 4.0),
                Insets.all(1.0),
                CornerRadii.all(10.0),
                focus.outset
            ),
            StateColors(
                inputFill,
                inputFill,
                inputFill,
                colors.input.withAlpha(
                    colors.input.alpha *
                        if (dark)
                            0.8
                        else
                            0.5
                )
            ),
            states(colors.input),
            foreground,
            focus
        )
    val action =
        surfacePart(
            SurfaceMetrics(
                Size(0.0, 32.0),
                Size(0.0, 0.0),
                Insets(10.0, 4.0, 10.0, 4.0),
                Insets.all(1.0),
                CornerRadii.all(10.0),
                focus.outset
            ),
            StateColors(
                colors.primary.background,
                colors.primary.background.withAlpha(colors.primary.background.alpha * 0.8),
                colors.primary.background.withAlpha(colors.primary.background.alpha * 0.65),
                colors.primary.background
            ),
            StateColors.solid(Color.Transparent),
            states(colors.primary.foreground),
            focus
        )
    val elevated =
        surfacePart(
            SurfaceMetrics(
                Size(0.0, 0.0),
                Size(0.0, 0.0),
                Insets.all(16.0),
                Insets.all(1.0),
                CornerRadii.all(10.0),
                focus.outset
            ),
            states(colors.popover.background),
            states(colors.border),
            states(colors.popover.foreground),
            focus
        ) { this.shadows = tokens.effects.floating }
    val marker =
        markerAppearance(
            states(inputFill),
            states(colors.primary.background),
            states(colors.input),
            states(colors.primary.background),
            states(colors.primary.foreground),
            focus
        )
    return shapeTheme(
        tokens,
        surfaceParts(plain, action, elevated),
        checkboxPart(
            CheckboxMetrics(
                Size(16.0, 16.0),
                Size(16.0, 16.0),
                Insets.all(1.0),
                CornerRadii.all(4.0),
                3.0,
                2.0,
                focus.outset
            ),
            marker
        ),
        radioPart(RadioMetrics(Size(16.0, 16.0), Size(16.0, 16.0), 1.0, 4.0, focus.outset), marker),
        scrollbarPart(
            ScrollbarMetrics(10.0, 24.0, 0.0, 2.0, 5.0, None),
            StateColors.solid(Color.Transparent),
            states(colors.border),
            StateColors.solid(Color.Transparent),
            foreground
        ),
        configure
    )
}

private fun states(color: Color): StateColors = StateColors.solid(color)
