package scoop.tls.asyncio

import scoop.asyncio.*
import scoop.crypto.x509.TrustStore
import scoop.platform.fs.Path
import scoop.tls.*

/**
 * Creates a TLS client context for the current event loop and job. System trust loading runs as
 * managed blocking work; the CA-file overload reads the file asynchronously. The returned context must be
 * closed after use.
 */
public suspend fun openTlsClientContext(
    trust: TlsTrustSource = TlsTrustSource.System,
    options: TlsOptions = TlsOptions(),
    identity: TlsIdentity? = None
): TlsClientContext {
    val loop = currentEventLoop()
    val job = requireJob(loop, true)
    when (trust) {
        case Store(val store) -> return TlsClientContext(store, options, identity)
        case System -> {
            return SystemTrustWork(options, identity).use {
                work ->
                val result = loop.executor.blocking { work.load() }
                try {
                    job.ensureActive()
                    result
                } catch (error: Throwable) {
                    result.use { _ -> throw error }
                }
            }
        }
    }
}

/**
 * Creates a TLS client context for the current event loop and job. System trust loading runs as
 * managed blocking work; the CA-file overload reads the file asynchronously. The returned context must be
 * closed after use.
 */
public suspend fun openTlsClientContext(
    caFile: Path,
    options: TlsOptions = TlsOptions(),
    identity: TlsIdentity? = None
): TlsClientContext {
    val bytes = currentEventLoop().openFile(caFile).useAsync suspend { file -> file.readAllBytes() }
    return TrustStore.fromPem(String.fromUtf8(bytes)).use {
        store -> TlsClientContext(store, options, identity)
    }
}
