package scoop.tls.asyncio

import scoop.asyncio.*
import scoop.platform.concurrent.*
import scoop.time.Duration

internal class HeldBlockingPool: Closeable {
    private val mutex = Mutex()
    private val changed = ConditionVariable(mutex)
    private var started = 0
    private var released = false

    suspend fun start(scope: CoroutineScope, loop: EventLoop) {
        val held = this
        // The surrounding tests configure the default four-thread pool.
        var index = 0
        while (index < 4) {
            scope.launch {
                loop.executor.blocking {
                    held.mutex.withLock {
                        held.started += 1
                        while (!held.released)
                            held.changed.await()
                    }
                }
            }
            index += 1
        }
        while (mutex.withLock { started < 4 })
            loop.sleep(Duration.nanoseconds(1L))
    }

    public override fun close() {
        mutex.withLock {
            released = true
            changed.broadcast()
        }
    }
}
