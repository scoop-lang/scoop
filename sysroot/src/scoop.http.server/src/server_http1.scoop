package scoop.http.server

import scoop.asyncio.*
import scoop.http.*
import scoop.http.asyncio.*
import scoop.time.TimeMark

internal suspend fun <T> serveHttp1(
    state: ServerState,
    entry: ServerConnection,
    transport: T,
    scope: CoroutineScope,
    started: TimeMark
)
where T: AsyncByteStream, T: AsyncCloseable {
    val options = state.options
    val connection =
        AsyncHttp1Connection.takeOwnershipAsServer(
            transport,
            scope,
            options.http1Receive,
            options.http1Limits,
            HttpIoTimeoutOptions(options.bodyReadIdle, options.responseWriteIdle)
        )
    var failure: Throwable? = None
    val headDeadline = Http1HeadDeadline(scope.job)
    try {
        try {
            var first = true
            while (state.running() && !connection.isClosed) {
                val timeout =
                    if (first)
                        remainingServerTime(options.firstRequestHeadTimeout, started)
                    else
                        options.keepAliveIdleTimeout
                headDeadline.begin(timeout)
                val incoming =
                    try {
                        connection.receiveRequest()
                    } catch (error: Throwable) {
                        val expired = headDeadline.finish()
                        if (error is CancellationException && present(expired))
                            throw expired!!
                        throw error
                    }
                val expired = headDeadline.finish()
                if (present(expired))
                    throw expired!!
                scope.job.ensureActive()
                first = false
                if (!present(incoming))
                    break
                val requestId = state.beginRequest(entry)
                if (!present(requestId))
                    break
                try {
                    executeHttp1Request(state, entry, connection, incoming!!, requestId!!)
                }
                finally {
                    state.endRequest(entry)
                }
                if (!connection.isReusable)
                    break
                // Ready I/O may complete during registration; keep-alive must still yield fairly.
                yieldCoroutine()
            }
        } catch (error: Throwable) {
            failure = Some(error);
            throw error
        }
        finally {
            headDeadline.close()
            closeServerResource(state, connection, failure)
        }
        val upgraded = state.lock.withLock { entry.webSocket }
        if (present(upgraded))
            runServerWebSocket(state, upgraded!!)
    } catch (error: Throwable) {
        failure = Some(error)
        throw error
    } finally {
        finishServerWebSocket(state, entry, failure)
    }
}
