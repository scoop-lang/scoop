package scoop.http.server

import scoop.http.*
import scoop.time.Duration
import scoop.tls.TlsServerContext
import scoop.http.asyncio.*

/** Configures one complete value; execution remains explicit. */
public fun httpServerOptions(
    configure: HttpServerOptionsBuilder.() -> Unit = {}
): HttpServerOptions {
    val builder = HttpServerOptionsBuilder()
    builder.configure()
    return builder.snapshot()
}

public fun HttpServerOptions.copy(
    configure: HttpServerOptionsBuilder.() -> Unit = {}
): HttpServerOptions {
    val builder = HttpServerOptionsBuilder()
    builder.tls = this.tls
    builder.allowHttp1Fallback = this.allowHttp1Fallback
    builder.allowCleartextHttp2 = this.allowCleartextHttp2
    builder.allowTlsHttp2 = this.allowTlsHttp2
    builder.maxConnections = this.maxConnections
    builder.maxActiveRequests = this.maxActiveRequests
    builder.maxWebSocketSessions = this.maxWebSocketSessions
    builder.request = this.request
    builder.tlsHandshakeTimeout = this.tlsHandshakeTimeout
    builder.firstRequestHeadTimeout = this.firstRequestHeadTimeout
    builder.http2HeadTimeout = this.http2HeadTimeout
    builder.keepAliveIdleTimeout = this.keepAliveIdleTimeout
    builder.bodyReadIdle = this.bodyReadIdle
    builder.responseWriteIdle = this.responseWriteIdle
    builder.gracefulShutdownTimeout = this.gracefulShutdownTimeout
    builder.http1Receive = this.http1Receive
    builder.http1Limits = this.http1Limits
    builder.http2Receive = this.http2Receive
    builder.http2Limits = this.http2Limits
    builder.http2Settings = this.http2Settings
    builder.onWebSocketCompleted = this.onWebSocketCompleted
    builder.onConnectionError = this.onConnectionError
    builder.configure()
    return builder.snapshot()
}

public class HttpServerOptionsBuilder internal constructor() {
    public var tls: TlsServerContext? = None
    public var allowHttp1Fallback: Boolean = true
    public var allowCleartextHttp2: Boolean = false
    public var allowTlsHttp2: Boolean = true
    public var maxConnections: Long = 1024L
    public var maxActiveRequests: Long = 256L
    private var configuredMaxWebSocketSessions: Long? = None
    public var maxWebSocketSessions: Long
    get() = configuredMaxWebSocketSessions ?: maxConnections
    set(value) {
        configuredMaxWebSocketSessions = Some(value)
    }
    public var request: HttpRequestOptions = httpRequestOptions()
    public var tlsHandshakeTimeout: Duration? = Some(Duration.seconds(10))
    public var firstRequestHeadTimeout: Duration? = Some(Duration.seconds(10))
    public var http2HeadTimeout: Duration? = Some(Duration.seconds(10))
    public var keepAliveIdleTimeout: Duration? = Some(Duration.seconds(60))
    public var bodyReadIdle: Duration? = Some(Duration.seconds(30))
    public var responseWriteIdle: Duration? = Some(Duration.seconds(30))
    public var gracefulShutdownTimeout: Duration = Duration.seconds(30)
    public var http1Receive: Http1ReceiveOptions = Http1ReceiveOptions()
    public var http1Limits: Http1Limits = Http1Limits()
    public var http2Receive: Http2ReceiveOptions =
        Http2ReceiveOptions(invalidRegularField = Http2InvalidRegularField.RejectStream)
    public var http2Limits: Http2Limits = Http2Limits()
    public var http2Settings: Http2Settings = Http2Settings()
    public var onWebSocketCompleted: ((HttpWebSocketCompletion) -> Unit)? = None
    public var onConnectionError: ((HttpConnectionInfo, Throwable) -> Unit)? = None

    public fun request(configure: HttpRequestOptionsBuilder.() -> Unit): Unit {
        request = request.copy(configure)
    }

    public fun http1Receive(configure: Http1ReceiveOptionsBuilder.() -> Unit): Unit {
        http1Receive = http1Receive.copy(configure)
    }

    public fun http1Limits(configure: Http1LimitsBuilder.() -> Unit): Unit {
        http1Limits = http1Limits.copy(configure)
    }

    public fun http2Receive(configure: Http2ReceiveOptionsBuilder.() -> Unit): Unit {
        http2Receive = http2Receive.copy(configure)
    }

    public fun http2Limits(configure: Http2LimitsBuilder.() -> Unit): Unit {
        http2Limits = http2Limits.copy(configure)
    }

    public fun http2Settings(configure: Http2SettingsBuilder.() -> Unit): Unit {
        http2Settings = http2Settings.copy(configure)
    }
    internal fun snapshot(): HttpServerOptions =
        HttpServerOptions(
            tls,
            allowHttp1Fallback,
            allowCleartextHttp2,
            allowTlsHttp2,
            maxConnections,
            maxActiveRequests,
            maxWebSocketSessions,
            request,
            tlsHandshakeTimeout,
            firstRequestHeadTimeout,
            http2HeadTimeout,
            keepAliveIdleTimeout,
            bodyReadIdle,
            responseWriteIdle,
            gracefulShutdownTimeout,
            http1Receive,
            http1Limits,
            http2Receive,
            http2Limits,
            http2Settings,
            onWebSocketCompleted,
            onConnectionError
        )
}
