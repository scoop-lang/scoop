package scoop.http.server

import scoop.asyncio.*
import scoop.platform.time.MonotonicTimeSource
import scoop.time.*

internal class RequestDeadline(initial: Duration?, private val operation: String = "request") {
    private val started: TimeMark = MonotonicTimeSource.markNow()
    private val loop: EventLoop = currentEventLoop()
    private val lock = ServerLock()
    private var duration: Duration? = initial
    private var owner: Job? = None
    private var alarm: RequestAlarm? = None
    private var timer: Disposable? = None
    private var failure: Throwable? = None
    private var stopped = false

    val selectedFailure: Throwable? get() = lock.withLock { failure }

    fun start(job: Job) {
        requireServerDuration(duration)
        val previous =
            lock.withLock {
                owner = Some(job)
                replace(duration)
            }
        previous?.dispose()
    }

    fun set(value: Duration?) {
        requireServerDuration(value)
        val previous = lock.withLock { replace(value) }
        previous?.dispose()
    }

    // Called with lock held; timer disposal remains outside the state transition.
    private fun replace(value: Duration?): Disposable? {
        if (stopped || present(failure))
            throw IllegalStateException(Some("request deadline is no longer active"))
        val job = owner!!
        val next =
            if (present(value))
                Some(RequestAlarm(value!!))
            else
                None
        val registration =
            when (next) {
                case Some(val target) -> context(job) {
                    context(loop) {
                        Some(
                            loop.schedule(
                                remainingServerTime(value, started)!!,
                                { error -> expire(target, error) }
                            )
                        )
                    }
                }
                case None -> None
            }
        val saved = timer
        duration = value
        alarm = next
        timer = registration
        return saved
    }

    private fun expire(target: RequestAlarm, error: Throwable?) {
        val job =
            lock.withLock {
                if (stopped || !present(alarm) || alarm!! !== target)
                    None
                else {
                    failure = Some(error ?: HttpServerTimeoutException(operation, target.limit))
                    alarm = None
                    timer = None
                    owner
                }
            }
        job?.cancel()
    }

    fun stop() {
        val previous =
            lock.withLock {
                stopped = true
                alarm = None
                owner = None
                val saved = timer
                timer = None
                saved
            }
        previous?.dispose()
    }
}

private class RequestAlarm(val limit: Duration)

internal suspend fun executeRequestPipeline(
    application: HttpApplication,
    request: HttpRequest,
    output: ResponseOutput,
    requestId: String,
    info: HttpConnectionInfo,
    duration: Duration?,
    result: RequestExecution
) {
    val deadline = RequestDeadline(duration)
    try {
        coroutineScope<Unit> {
            deadline.start(job)
            val ctx = HttpContext(request, output, requestId, job, info, deadline)
            result.context = Some(ctx)
            application.execute(ctx)
        }
    } catch (error: CancellationException) {
        throw deadline.selectedFailure ?: error
    } finally {
        // The request's entire structured subtree has finished before disarming the timer.
        deadline.stop()
    }
}
