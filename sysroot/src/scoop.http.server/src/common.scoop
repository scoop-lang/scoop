package scoop.http.server

import scoop.http.HttpField

// Copies share the atomic state without another heap wrapper.
internal struct ServerLock(val held: AtomicBoolean = AtomicBoolean(false)) {
    private fun acquire() {
        while (!held.compareAndSet(false, true, MemoryOrder.Acquire, MemoryOrder.Relaxed)) {}
    }

    private fun unlock() {
        held.store(false, MemoryOrder.Release)
    }

    fun <T> withLock(block: () -> T): T {
        acquire()
        try {
            return block()
        }
        finally {
            unlock()
        }
    }
}

internal fun field(name: String, value: String): HttpField =
    HttpField(name.toByteArray(), value.toByteArray())

internal fun <T> present(value: T?): Boolean =
    when (value) {
        case Some(_) -> true
        case None -> false
    }

internal fun sameBytes(a: List<Byte>, b: List<Byte>): Boolean {
    if (a.size != b.size)
        return false
    var index = 0L
    while (index < a.size) {
        if (a[index] != b[index])
            return false
        index += 1L
    }
    return true
}

internal fun inputText(bytes: List<Byte>, location: String): String =
    String.fromUtf8OrNone(bytes) ?: reject(400U, location + " must be UTF-8")

internal fun reject(status: UInt, detail: String): Nothing =
    throw HttpRejection(text(detail, status))

/** An expected request rejection carrying the response selected by the application or extractor. */
public class HttpRejection public constructor(
    /** The response to execute in the current request pipeline. */
    public val result: HttpResult,
    /** The original input failure, when this rejection was produced by a decoder. */
    public val cause: Throwable? = None
): Exception(Some("HTTP request rejected"))

/** A suspending endpoint returning a response description. */
public typealias HttpHandler = suspend (HttpContext) -> HttpResult

/** A single-use continuation that waits for the entire downstream response. */
public typealias HttpNext = suspend () -> Unit

/** A request middleware that either delegates once, responds, or throws. */
public typealias HttpMiddleware = suspend (HttpContext, HttpNext) -> Unit
