package scoop.http.server

import scoop.asyncio.*
import scoop.platform.net.*
import scoop.test.*
import scoop.text.contains

@Test
private class ServerOwnershipTests {
    @Test
    fun `concurrent worker initialization publishes usable server ownership`() {
        asyncRuntime {
            workers = 4
            blocking { threads = 1 }
        }.run {
            val scope = this
            val executor = currentCoroutineExecutorOrNone()!!
            val routes =
                routing {
                    get(
                        "/",
                        {
                            _ ->
                            assertSame(executor, currentCoroutineExecutorOrNone()!!)
                            text("initialized")
                        }
                    )
                }
            for (index in 0L ..< 16L) {
                scope.launch {
                    val connections = this
                    HttpServer.listen(routes, connections, port = 0).useAsync {
                        server -> networkClient(server.localAddress, connections).useAsync {
                            client -> for (request in 0L ..< 4L)
                                assertEquals("initialized", requestText(client))
                        }
                    }
                }
            }
        }
    }

    @Test
    fun `cancellation before the queued server owner starts leaves the listener reusable`() {
        val routes = routing { get("/", { _ -> text("reused") }) }
        val loop = eventLoop()
        loop.run {
            val scope = this
            val listener = loop.listenTcp(SocketAddress(IpAddress.IPV4_LOOPBACK, 0))
            val entered = AtomicBoolean(false)
            val rejected = AtomicBoolean(false)
            val opening =
                scope.launch {
                    entered.store(true)
                    try {
                        HttpServer.takeOwnership(listener, routes, scope)
                        fail(Some("cancelled adoption succeeded"))
                    } catch (_: CancellationException) {
                        rejected.store(true)
                    }
                }
            yieldCoroutine()
            assertTrue(entered.load())
            opening.cancel()
            opening.join()
            assertTrue(rejected.load())
            HttpServer.takeOwnership(listener, routes, scope).useAsync {
                server -> networkClient(server.localAddress, scope).useAsync {
                    client -> assertEquals("reused", requestText(client))
                }
            }
        }
    }

    @Test
    fun `registration failure leaves the listener available to its caller`() {
        val routes = routing { this.get("/", suspend { _ -> text("owned") }) }
        val app = routes
        val loop = eventLoop()
        loop.run {
            val scope = this;
            val ended =
                coroutineScope<CoroutineScope> {
                    val child = this
                    child
                }
            val listener = loop.listenTcp(SocketAddress(IpAddress.IPV4_LOOPBACK, 0))
            val address = listener.localAddress
            var rejected = false
            try {
                HttpServer.takeOwnership(listener, app, ended)
            }
            catch (_: IllegalStateException) {
                rejected = true
            }
            assertTrue(rejected)
            val server = HttpServer.takeOwnership(listener, app, scope)
            try {
                networkClient(address, scope).useAsync suspend {
                    client -> assertEquals("owned", requestText(client))
                }
            } finally {
                server.close()
            }
        }
    }

    @Test
    fun `a peer half close still permits its final HTTP response`() {
        val routes = routing { this.get("/", suspend { _ -> text("half-closed") }) }
        withServer(
            routes,
            block =
                suspend {
                    _,
                    _,
                    address -> currentEventLoop().connectTcp(address).useAsync suspend {
                        peer ->
                        networkWrite(peer, "GET / HTTP/1.1\r\nHost: localhost\r\n\r\n")
                        peer.shutdownOutput()
                        val wire = networkText(peer)
                        assertTrue(wire.contains("HTTP/1.1 200"))
                        assertTrue(wire.contains("half-closed"))
                    }
                }
        )
    }
}
