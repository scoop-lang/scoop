package scoop.http.server

import scoop.http.*
import scoop.platform.fs.Path

internal fun fileExchange(
    path: Path,
    fields: List<HttpField> = ArrayList<HttpField>(),
    method: String = "GET",
    options: FileResponseOptions = fileResponseOptions(),
    configure: (HttpContext) -> Unit = { _ -> Unit },
    output: TestOutput = TestOutput()
): Exchange {
    val routes =
        routing {
            this.get(
                "/",
                suspend {
                    ctx ->
                    configure(ctx);
                    file(path, options)
                }
            )
        }
    return exercise(routes, method = method, fields = fields, output = output)
}
