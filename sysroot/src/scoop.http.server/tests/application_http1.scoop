package scoop.http.server

import scoop.asyncio.*
import scoop.http.*
import scoop.http.asyncio.*
import scoop.test.*
import scoop.time.Duration

private class ApplicationExecutionMarker(val value: String)

context(marker: ApplicationExecutionMarker)
private fun executionMarker(): String = marker.value

@Test
private class ApplicationHttp1Tests {
    @Test
    fun `borrowed execution reuses the connection and preserves middleware HEAD and mapped errors`() {
        val contexts = ArrayList<HttpContext>()
        val produced = TestCounter()
        val completed = ServerTestCompletions(3L)
        val failure = IllegalArgumentException(Some("endpoint failure"))
        val application =
            routing {
                this.application =
                    httpApplicationOptions {
                        errorMapper =
                            suspend {
                                ctx, error ->
                                assertSame(failure, error)
                                text(executionMarker() + ":" + ctx.requestId, 500U)
                            }
                    }
                use(
                    suspend {
                        ctx, next ->
                        contexts.add(ctx)
                        context(ApplicationExecutionMarker("middleware")) {
                            next()
                            assertEquals("middleware", executionMarker())
                        }
                    }
                )
                get("/ok", suspend { _ -> text(executionMarker()) })
                get(
                    "/head",
                    suspend {
                        _ -> stream(
                            "text/plain",
                            suspend {
                                writer ->
                                produced.value += 1
                                writer.writeText("abc")
                            },
                            length = Some(3L)
                        )
                    }
                )
                get("/fail", suspend { _ -> throw failure })
            }
        val options =
            httpRequestOptions {
                onCompleted =
                    Some(
                        {
                            value ->
                            completed.receive(value)
                            throw IllegalStateException(Some("ignored observer failure"))
                        }
                    )
            }
        withApplicationHttp1(
            suspend {
                scope, server, client, info ->
                context(ApplicationExecutionMarker("caller")) {
                    val serving =
                        scope.async<Unit> suspend {
                            for (index in 0L ..< 3L) {
                                application.executeHttp1(
                                    server,
                                    server.receiveRequest()!!,
                                    info,
                                    "r" + index.toString(),
                                    options
                                )
                                assertTrue(server.isReusable)
                            }
                        }
                    assertEquals("middleware", requestText(client, "/ok"))
                    client.sendRequest(networkRequest("/head", "HEAD")).finish()
                    val head = client.receiveResponse()
                    assertEquals(200U, head.head.status)
                    assertEquals("", networkText(head.body))
                    assertEquals(
                        "3",
                        String.fromUtf8(
                            head.head.fields.findAll("Content-Length".toByteArray())[0L].value
                        )
                    )
                    client.sendRequest(networkRequest("/fail")).finish()
                    val mapped = client.receiveResponse()
                    assertEquals(500U, mapped.head.status)
                    assertEquals("middleware:r2", networkText(mapped.body))
                    serving.await()
                    assertEquals("caller", executionMarker())
                }
                assertFalse(server.isClosed)
                assertEquals(3L, contexts.size)
                assertTrue(contexts[0L].requestJob !== contexts[1L].requestJob)
                assertTrue(contexts[1L].requestJob !== contexts[2L].requestJob)
                for (ctx in contexts) {
                    assertSame(info, ctx.connection)
                    assertTrue(ctx.requestJob.isCompleted)
                    assertTrue(ctx.requestJob !== scope.job)
                }
            }
        )
        assertEquals(0, produced.value)
        assertEquals(3L, completed.snapshot().size)
        for (value in completed.snapshot()) {
            assertEquals(HttpRequestOutcome.Completed, value.outcome)
            assertFalse(present(value.failure))
        }
    }

    @Test
    fun `borrowed execution sends Continue on actual body consumption and observes byte counts`() {
        val completed = ServerTestCompletions()
        val application =
            routing { post("/echo", suspend { ctx -> text(ctx.request.body.text()) }) }
        val options =
            httpRequestOptions {
                bodyLimit = Some(4L)
                bufferedBodyLimit = 4L
                onCompleted = Some(completed::receive)
            }
        withApplicationHttp1(
            suspend {
                scope, server, client, info ->
                val serving =
                    scope.async<Unit> suspend {
                        application.executeHttp1(
                            server,
                            server.receiveRequest()!!,
                            info,
                            "upload",
                            options
                        )
                    }
                val upload =
                    client.sendRequest(
                        networkRequest("/echo", "POST", [field("Expect", "100-continue")]),
                        Http1BodyFraming.Length(4L)
                    )
                val interim = client.receiveResponse()
                assertEquals(100U, interim.head.status)
                assertEquals("", networkText(interim.body))
                networkWrite(upload, "body")
                upload.finish()
                assertEquals("body", networkText(client.receiveResponse().body))
                serving.await()
                assertTrue(server.isReusable)
            }
        )
        val value = completed.snapshot()[0L]
        assertEquals(4L, value.receivedBytes)
        assertEquals(4L, value.deliveredBytes)
        assertEquals(4L, value.responseBytes)
        assertEquals(HttpRequestOutcome.Completed, value.outcome)
    }

    @Test
    fun `request options compose independently and nested server changes preserve their snapshot`() {
        val original =
            httpRequestOptions {
                bodyLimit = Some(5L)
                deadline = Some(Duration.seconds(1))
            }
        val server =
            httpServerOptions {
                request = original
                request { bufferedBodyLimit = 2L }
                request { bodyLimit = None }
                request {}
            }
        assertEquals(Some(5L), original.bodyLimit)
        assertEquals(2097152L, original.bufferedBodyLimit)
        assertEquals(None, server.request.bodyLimit)
        assertEquals(2L, server.request.bufferedBodyLimit)
        assertEquals(original.deadline, server.request.deadline)
        expectArgument { httpRequestOptions { bodyLimit = Some(-1L) } }
        expectArgument { httpRequestOptions { bufferedBodyLimit = -1L } }
        expectArgument { httpRequestOptions { deadline = Some(Duration.milliseconds(-1)) } }
    }
}
