package scoop.http.server

import scoop.compression.*
import scoop.http.*
import scoop.test.*

@Test
private class ServerCompressionFieldTests {
    @Test
    fun `representation selection follows beforeCommit and transforms validators digests and trailers`() {
        val routes =
            routing {
                this.use(responseCompression(responseCompressionOptions { this.minimumBytes = 0L }))
                this.get(
                    "/",
                    suspend {
                        ctx ->
                        ctx.response.beforeCommit {
                            draft ->
                            draft.set(field("Content-Type", "text/plain"))
                            draft.set(field("Content-Length", "5"))
                            draft.add(field("Vary", "Accept, Accept-Encoding"))
                        }
                        httpResult {
                            this.status = 200U
                            this.fields =
                                [
                                    field("Vary", "accept, X-Test"),
                                    field("ETag", "\"plain\""),
                                    field("Content-MD5", "old"),
                                    field("Digest", "old"),
                                    field("Content-Digest", "old"),
                                    field("Repr-Digest", "old"),
                                    field("Trailer", "Content-Digest, ETag, X-Done")
                                ]
                            this.body =
                                HttpBody.Stream(
                                    HttpStreamBody(
                                        suspend { writer -> writer.writeText("hello") },
                                        length = Some(5L),
                                        trailers =
                                            Some(
                                                {
                                                    [
                                                        field("ETag", "\"plain\""),
                                                        field("Content-Digest", "old"),
                                                        field("X-Done", "yes")
                                                    ]
                                                }
                                            )
                                    )
                                )
                        }
                    }
                )
            }
        val result = exercise(routes, fields = [field("Accept-Encoding", "gzip")])
        assertEquals("hello", decodedResponse(result))
        assertEquals("W/\"plain\"", result.output.header("ETag"))
        assertEquals("accept, x-test, accept-encoding", result.output.header("Vary"))
        assertEquals(None, parseHttpContentLength(result.output.head!!.fields))
        assertEquals("etag, x-done", result.output.header("Trailer"))
        val headers = RequestHeaders(result.output.head!!.fields)
        for (name in ["Content-MD5", "Digest", "Content-Digest", "Repr-Digest"])
            assertEquals(None, headers.getSingle(name))
        val trailers = RequestHeaders(result.output.trailers)
        assertEquals(Some("W/\"plain\""), trailers.getSingle("ETag"))
        assertEquals(None, trailers.getSingle("Content-Digest"))
        assertEquals(Some("yes"), trailers.getSingle("X-Done"))
        val weak =
            compressionExercise(
                httpResult {
                    this.status = 200U
                    this.fields =
                        [
                            field("Content-Type", "text/plain"),
                            field("ETag", "W/\"weak\""),
                            field("Vary", "*")
                        ]
                    this.body = HttpBody.Bytes("hello".toByteArray())
                }
            )
        assertEquals("W/\"weak\"", weak.output.header("ETag"))
        assertEquals("*", weak.output.header("Vary"))
    }

    @Test
    fun `HEAD selects representation metadata while bodyless statuses skip negotiation`() {
        val produced = TestCounter()
        val result =
            stream(
                "text/plain",
                suspend {
                    writer ->
                    produced.value += 1;
                    writer.writeText("hello")
                },
                length = Some(5L)
            )
        val head = compressionExercise(result, method = "HEAD")
        assertEquals(Some("gzip"), responseEncoding(head))
        assertEquals(None, parseHttpContentLength(head.output.head!!.fields))
        assertEquals(0, produced.value)
        assertEquals(0L, head.context.encodedResponseBytes)
        assertEquals("", head.text())
        assertEquals(
            Some(5L),
            parseHttpContentLength(
                compressionExercise(result, Some(""), method = "HEAD").output.head!!.fields
            )
        )
        for (status in [204U, 205U, 304U]) {
            val noBody =
                compressionExercise(
                    httpResult {
                        this.status = status
                        this.fields =
                            [field("Content-Encoding", "br"), field("ETag", "\"selected\"")]
                    },
                    Some("gzip;q=bad")
                )
            assertEquals(status, noBody.status)
            assertEquals(Some("br"), responseEncoding(noBody))
            assertEquals("\"selected\"", noBody.output.header("ETag"))
            assertEquals("", noBody.text())
        }
    }

    @Test
    fun `disabled range media and already encoded representations still respect acceptance`() {
        val plain = "hello".toByteArray()
        val encoded = compress(plain, CompressionOptions.Gzip(GzipOptions()))
        val fixed =
            httpResult {
                this.status = 200U
                this.fields =
                    [
                        field("Content-Type", "text/plain"),
                        field("Content-Encoding", "gzip"),
                        field("ETag", "\"encoded\"")
                    ]
                this.body = HttpBody.Bytes(encoded)
            }
        val accepted = compressionExercise(fixed)
        assertEquals("hello", decodedResponse(accepted))
        assertEquals(encoded.size, accepted.context.responseBytes)
        assertEquals(encoded.size, accepted.context.encodedResponseBytes)
        assertEquals(Some(encoded.size), parseHttpContentLength(accepted.output.head!!.fields))
        assertEquals("\"encoded\"", accepted.output.header("ETag"))
        assertEquals(406U, compressionExercise(fixed, Some("identity")).status)
        for (
            result in [
                httpResult {
                    this.status = 200U
                    this.fields = [field("Content-Type", "text/plain")]
                    this.body = HttpBody.Bytes(plain)
                    this.allowCompression = false
                },
                httpResult {
                    this.status = 200U
                    this.fields =
                        [
                            field("Content-Type", "text/plain"),
                            field("Cache-Control", "no-transform")
                        ]
                    this.body = HttpBody.Bytes(plain)
                },
                httpResult {
                    this.status = 206U
                    this.fields =
                        [
                            field("Content-Type", "text/plain"),
                            field("Content-Range", "bytes 0-4/10")
                        ]
                    this.body = HttpBody.Bytes(plain)
                },
                bytes(plain, "image/png")
            ]
        ) {
            assertEquals(None, responseEncoding(compressionExercise(result)))
            val rejected = compressionExercise(result, Some("gzip, identity;q=0"))
            assertEquals(406U, rejected.status)
            assertEquals("", rejected.text())
            for (name in ["Content-Type", "Content-Encoding", "Content-Range", "ETag"])
                assertEquals(None, RequestHeaders(rejected.output.head!!.fields).getSingle(name))
        }
    }
}
