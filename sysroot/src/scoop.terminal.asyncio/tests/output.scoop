package scoop.terminal.asyncio

import scoop.asyncio.*
import scoop.bytes.ByteArrayBuilder
import scoop.platform.io.WriteZeroException
import scoop.platform.memory.NativeByteBuffer
import scoop.terminal.*
import scoop.terminal.cursor.MoveTo
import scoop.test.*
import scoop.time.Duration

private class ShortSink: AsyncByteSink, AsyncCloseable {
    val bytes: ByteArrayBuilder = ByteArrayBuilder()
    var flushes: Int = 0
    var closed: Boolean = false
    var zero: Boolean = false
    var failFlush: Boolean = false
    public override suspend fun writeFrom(buffer: NativeByteBuffer, count: Long): Long {
        currentEventLoop().sleep(Duration.nanoseconds(1L))
        if (zero)
            return 0L
        val size =
            if (count < 2L)
                count
            else
                2L
        bytes.append(buffer.readBytes(size))
        return size
    }
    public override suspend fun flush() {
        flushes += 1
        if (failFlush)
            throw IllegalStateException()
    }
    public override suspend fun close() {
        closed = true
    }
}

private object Broken: Command {
    public override fun writeAnsi(writer: TextWriter) {
        writer.write("uncommitted")
        throw IllegalArgumentException()
    }
}

@Test
private class AsyncTerminalOutputTest {
    @Test
    fun `short suspended writes preserve UTF8 and flush once without closing the sink`() {
        val sink = ShortSink()
        val loop = eventLoop()
        loop.run {
            sink.queue(Print("é"))
            assertEquals(0, sink.flushes)
            sink.execute(MoveTo(2L, 1L), Print("界"))
            sink.execute()
        }
        assertEquals("é\u001b[2;3H界", String.fromUtf8(sink.bytes.toByteArray()))
        assertEquals(2, sink.flushes)
        assertFalse(sink.closed)
    }

    @Test
    fun `encoding failure retains earlier commands and does not flush`() {
        val sink = ShortSink()
        val loop = eventLoop()
        assertFailsWith<IllegalArgumentException> {
            loop.run { sink.execute(Print("ok"), Broken, Print("later")) }
        }
        assertEquals("ok", String.fromUtf8(sink.bytes.toByteArray()))
        assertEquals(0, sink.flushes)
        assertFalse(sink.closed)
    }

    @Test
    fun `zero progress and flush failure keep ordinary stream errors`() {
        val sink = ShortSink()
        sink.zero = true
        val first = eventLoop()
        assertFailsWith<WriteZeroException> { first.run { sink.execute(Print("x")) } }
        assertEquals(0, sink.flushes)
        sink.zero = false
        sink.failFlush = true
        val second = eventLoop()
        assertFailsWith<IllegalStateException> { second.run { sink.execute(Print("y")) } }
        assertEquals("y", String.fromUtf8(sink.bytes.toByteArray()))
        assertEquals(1, sink.flushes)
    }
}
