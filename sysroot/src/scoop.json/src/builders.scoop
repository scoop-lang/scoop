package scoop.json

import scoop.collections.HashSet

/** Runs configure once and publishes an array snapshot sharing immutable child values. */
public fun jsonArray(configure: JsonArrayBuilder.() -> Unit = {}): JsonValue {
    val builder = JsonArrayBuilder()
    builder.configure()
    return builder.snapshot()
}

/** Runs configure once and publishes an object snapshot in insertion order. */
public fun jsonObject(configure: JsonObjectBuilder.() -> Unit = {}): JsonValue {
    val builder = JsonObjectBuilder()
    builder.configure()
    return builder.snapshot()
}

/** Collects array elements for jsonArray without exposing mutable JSON nodes. */
public class JsonArrayBuilder internal constructor() {
    private val elements: ArrayList<JsonNode> = ArrayList<JsonNode>()

    /** Appends one immutable child value in insertion order. */
    public fun add(value: JsonValue): Unit {
        elements.add(value.node)
    }

    /** Copies the sequence structure in linear time, sharing immutable child nodes. */
    internal fun snapshot(): JsonValue {
        val snapshot = ArrayList<JsonNode>()
        for (element in elements) {
            snapshot.add(element)
        }
        return JsonValue(JsonNode.Sequence(snapshot))
    }
}

/** Collects object members for jsonObject, rejecting duplicates without replacing values. */
public class JsonObjectBuilder internal constructor() {
    private val members: ArrayList<JsonMember> = ArrayList<JsonMember>()
    private val names: HashSet<String> = HashSet<String>()

    /** Adds one member; duplicate names throw EncodingException and preserve existing members. */
    public fun add(name: String, value: JsonValue): Unit {
        if (!names.add(name)) {
            throw EncodingException(childPath("", name), "duplicate object key")
        }
        members.add(JsonMember(name, value.node))
    }

    /** Copies the member structure in linear time, sharing immutable child nodes. */
    internal fun snapshot(): JsonValue {
        val snapshot = ArrayList<JsonMember>()
        for (member in members) {
            snapshot.add(member)
        }
        return JsonValue(JsonNode.Record(snapshot))
    }
}
