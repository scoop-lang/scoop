package scoop.json

import scoop.collections.HashSet

internal class JsonKeyedEncoder(private val owner: JsonEncoder) : KeyedEncodingContainer {
    private val names: HashSet<String> = HashSet<String>()
    private val members: ArrayList<JsonMember> = ArrayList<JsonMember>()
    private var pending: Option<(String, JsonEncoder)> = None

    private fun flush() {
        when (pending) {
            case Some((val name, val child)) -> {
                members.add(JsonMember(name, child.result()))
                pending = None
            }

            case None -> {
                return
            }
        }
    }

    public override fun field(name: String): Encoder {
        owner.begin()
        flush()
        val path = childPath(owner.path, name)
        if (!names.add(name)) {
            throw EncodingException(path, "duplicate object key")
        }
        val child = JsonEncoder(path)
        pending = Some((name, child))
        return child
    }

    public override fun end() {
        owner.checkWritable()
        flush()
        owner.finish(JsonNode.Record(members))
    }
}

internal class JsonUnkeyedEncoder(private val owner: JsonEncoder) : UnkeyedEncodingContainer {
    private val elements: ArrayList<JsonNode> = ArrayList<JsonNode>()
    private var pending: Option<JsonEncoder> = None

    private fun flush() {
        when (pending) {
            case Some(val child) -> {
                elements.add(child.result())
                pending = None
            }

            case None -> {
                return
            }
        }
    }

    public override fun element(): Encoder {
        owner.begin()
        flush()
        val child = JsonEncoder(childPath(owner.path, elements.size.toString()))
        pending = Some(child)
        return child
    }

    public override fun end() {
        owner.checkWritable()
        flush()
        owner.finish(JsonNode.Sequence(elements))
    }
}
