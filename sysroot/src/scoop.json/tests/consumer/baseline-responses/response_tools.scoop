package scoop.json.tests.consumer.baseline_responses

import scoop.test.*
import scoop.json.*

struct FunctionSpec(
    val name: String,
    val parameters: JsonValue,
    val strict: Boolean? = None,
    val description: String? = None
) {
    @GenerateWith("scoop.codec", ["ValueEncoder<FunctionSpec>", "ValueDecoder<FunctionSpec>"])
    companion object : ValueEncoder<FunctionSpec>, ValueDecoder<FunctionSpec> {}
}
struct FileSearchTool(val vector_store_ids: Array<String>, val max_num_results: Long? = None) {
    @GenerateWith("scoop.codec", ["ValueEncoder<FileSearchTool>", "ValueDecoder<FileSearchTool>"])
    companion object : ValueEncoder<FileSearchTool>, ValueDecoder<FileSearchTool> {}
}
struct WebSearchTool(val search_context_size: String? = None, val user_location: UserLocation? = None) {
    @GenerateWith("scoop.codec", ["ValueEncoder<WebSearchTool>", "ValueDecoder<WebSearchTool>"])
    companion object : ValueEncoder<WebSearchTool>, ValueDecoder<WebSearchTool> {}
}
struct UserLocation(
    val type: String,
    val city: String? = None,
    val country: String? = None,
    val timezone: String? = None
) {
    @GenerateWith("scoop.codec", ["ValueEncoder<UserLocation>", "ValueDecoder<UserLocation>"])
    companion object : ValueEncoder<UserLocation>, ValueDecoder<UserLocation> {}
}
struct ComputerTool(val display_width: Long, val display_height: Long, val environment: String) {
    @GenerateWith("scoop.codec", ["ValueEncoder<ComputerTool>", "ValueDecoder<ComputerTool>"])
    companion object : ValueEncoder<ComputerTool>, ValueDecoder<ComputerTool> {}
}
struct CodeTool(val container: ContainerChoice) {
    @GenerateWith("scoop.codec", ["ValueEncoder<CodeTool>", "ValueDecoder<CodeTool>"])
    companion object : ValueEncoder<CodeTool>, ValueDecoder<CodeTool> {}
}
struct MCPConfig(val server_label: String, val server_url: String, val allowed_tools: Array<String>? = None) {
    @GenerateWith("scoop.codec", ["ValueEncoder<MCPConfig>", "ValueDecoder<MCPConfig>"])
    companion object : ValueEncoder<MCPConfig>, ValueDecoder<MCPConfig> {}
}
struct ContainerObject(val type: String, val file_ids: Array<String> = []) {
    @GenerateWith("scoop.codec", ["ValueEncoder<ContainerObject>", "ValueDecoder<ContainerObject>"])
    companion object : ValueEncoder<ContainerObject>, ValueDecoder<ContainerObject> {}
}
struct ImageTool(val size: String? = None, val quality: String? = None) {
    @GenerateWith("scoop.codec", ["ValueEncoder<ImageTool>", "ValueDecoder<ImageTool>"])
    companion object : ValueEncoder<ImageTool>, ValueDecoder<ImageTool> {}
}
struct NamedFunction(val name: String) {
    @GenerateWith("scoop.codec", ["ValueEncoder<NamedFunction>", "ValueDecoder<NamedFunction>"])
    companion object : ValueEncoder<NamedFunction>, ValueDecoder<NamedFunction> {}
}
enum ContainerChoice {
    Text(String), Config(ContainerObject)
    companion object : ValueEncoder<ContainerChoice>, ValueDecoder<ContainerChoice> {
        public override fun encode(value: ContainerChoice, encoder: Encoder) {
            when (value) {
                case ContainerChoice.Text(val text) -> String.encode(text, encoder)
                case ContainerChoice.Config(val payload) -> ContainerObject.Companion.encode(payload, encoder)
            }
        }
        public override fun decode(decoder: Decoder): ContainerChoice {
            val text: String? = try { Some(String.decode(decoder)) } catch (_: DecodingException) { None }
            if (text != None) { return ContainerChoice.Text(text!!) }
            return ContainerChoice.Config(ContainerObject.Companion.decode(decoder))
        }
    }
}
