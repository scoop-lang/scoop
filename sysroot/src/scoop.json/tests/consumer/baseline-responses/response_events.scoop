package scoop.json.tests.consumer.baseline_responses

import scoop.test.*
import scoop.json.*

enum ResponseEvent {
    Created(StateEvent), Progress(StateEvent), Completed(StateEvent), Failed(StateEvent), Incomplete(StateEvent), ItemAdded(ItemEvent), ItemDone(ItemEvent), PartAdded(PartEvent), PartDone(PartEvent), TextDelta(TextDeltaEvent), TextDone(TextDoneEvent), ArgumentsDelta(ArgumentsDeltaEvent), ArgumentsDone(ArgumentsDoneEvent), Error(ResponseErrorEvent), Unknown(JsonValue)
    companion object : ValueEncoder<ResponseEvent>, ValueDecoder<ResponseEvent> {
        public override fun encode(value: ResponseEvent, encoder: Encoder) {
            val fields = encoder.keyed()
            when (value) {
                case ResponseEvent.Created(val payload) -> {
                    String.encode("response.created", fields.field("type"))
                    StateEvent.Companion.encode(payload, encoder)
                }
                case ResponseEvent.Progress(val payload) -> {
                    String.encode("response.in_progress", fields.field("type"))
                    StateEvent.Companion.encode(payload, encoder)
                }
                case ResponseEvent.Completed(val payload) -> {
                    String.encode("response.completed", fields.field("type"))
                    StateEvent.Companion.encode(payload, encoder)
                }
                case ResponseEvent.Failed(val payload) -> {
                    String.encode("response.failed", fields.field("type"))
                    StateEvent.Companion.encode(payload, encoder)
                }
                case ResponseEvent.Incomplete(val payload) -> {
                    String.encode("response.incomplete", fields.field("type"))
                    StateEvent.Companion.encode(payload, encoder)
                }
                case ResponseEvent.ItemAdded(val payload) -> {
                    String.encode("response.output_item.added", fields.field("type"))
                    ItemEvent.Companion.encode(payload, encoder)
                }
                case ResponseEvent.ItemDone(val payload) -> {
                    String.encode("response.output_item.done", fields.field("type"))
                    ItemEvent.Companion.encode(payload, encoder)
                }
                case ResponseEvent.PartAdded(val payload) -> {
                    String.encode("response.content_part.added", fields.field("type"))
                    PartEvent.Companion.encode(payload, encoder)
                }
                case ResponseEvent.PartDone(val payload) -> {
                    String.encode("response.content_part.done", fields.field("type"))
                    PartEvent.Companion.encode(payload, encoder)
                }
                case ResponseEvent.TextDelta(val payload) -> {
                    String.encode("response.output_text.delta", fields.field("type"))
                    TextDeltaEvent.Companion.encode(payload, encoder)
                }
                case ResponseEvent.TextDone(val payload) -> {
                    String.encode("response.output_text.done", fields.field("type"))
                    TextDoneEvent.Companion.encode(payload, encoder)
                }
                case ResponseEvent.ArgumentsDelta(val payload) -> {
                    String.encode("response.function_call_arguments.delta", fields.field("type"))
                    ArgumentsDeltaEvent.Companion.encode(payload, encoder)
                }
                case ResponseEvent.ArgumentsDone(val payload) -> {
                    String.encode("response.function_call_arguments.done", fields.field("type"))
                    ArgumentsDoneEvent.Companion.encode(payload, encoder)
                }
                case ResponseEvent.Error(val payload) -> {
                    String.encode("error", fields.field("type"))
                    ResponseErrorEvent.Companion.encode(payload, encoder)
                }
                case ResponseEvent.Unknown(val raw) -> JsonValue.Companion.encode(raw, encoder)
            }
            fields.end()
        }
        public override fun decode(decoder: Decoder): ResponseEvent {
            val fields = decoder.keyed()
            return when (String.decode(fields.required("type"))) {
                case "response.created" -> ResponseEvent.Created(StateEvent.Companion.decode(decoder))
                case "response.in_progress" -> ResponseEvent.Progress(StateEvent.Companion.decode(decoder))
                case "response.completed" -> ResponseEvent.Completed(StateEvent.Companion.decode(decoder))
                case "response.failed" -> ResponseEvent.Failed(StateEvent.Companion.decode(decoder))
                case "response.incomplete" -> ResponseEvent.Incomplete(StateEvent.Companion.decode(decoder))
                case "response.output_item.added" -> ResponseEvent.ItemAdded(ItemEvent.Companion.decode(decoder))
                case "response.output_item.done" -> ResponseEvent.ItemDone(ItemEvent.Companion.decode(decoder))
                case "response.content_part.added" -> ResponseEvent.PartAdded(PartEvent.Companion.decode(decoder))
                case "response.content_part.done" -> ResponseEvent.PartDone(PartEvent.Companion.decode(decoder))
                case "response.output_text.delta" -> ResponseEvent.TextDelta(TextDeltaEvent.Companion.decode(decoder))
                case "response.output_text.done" -> ResponseEvent.TextDone(TextDoneEvent.Companion.decode(decoder))
                case "response.function_call_arguments.delta" -> ResponseEvent.ArgumentsDelta(ArgumentsDeltaEvent.Companion.decode(decoder))
                case "response.function_call_arguments.done" -> ResponseEvent.ArgumentsDone(ArgumentsDoneEvent.Companion.decode(decoder))
                case "error" -> ResponseEvent.Error(ResponseErrorEvent.Companion.decode(decoder))
                else -> ResponseEvent.Unknown(JsonValue.Companion.decode(decoder))
            }
        }
    }
}
