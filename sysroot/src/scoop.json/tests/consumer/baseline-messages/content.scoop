package scoop.json.tests.consumer.baseline_messages

import scoop.test.*
import scoop.json.*

enum Block {
    Text(TextBlock), Image(ImageBlock), Document(DocumentBlock), Thinking(ThinkingBlock), Redacted(RedactedBlock), Use(ToolUse), Result(ToolResult), Server(ServerUse), SearchResult(SearchResultBlock), FetchResult(FetchResultBlock), CodeResult(CodeResultBlock), Search(SearchBlock), Upload(UploadBlock), Unknown(JsonValue)
    companion object : ValueEncoder<Block>, ValueDecoder<Block> {
        public override fun encode(value: Block, encoder: Encoder) {
            val fields = encoder.keyed()
            when (value) {
                case Block.Text(val payload) -> {
                    String.encode("text", fields.field("type"))
                    TextBlock.Companion.encode(payload, encoder)
                }
                case Block.Image(val payload) -> {
                    String.encode("image", fields.field("type"))
                    ImageBlock.Companion.encode(payload, encoder)
                }
                case Block.Document(val payload) -> {
                    String.encode("document", fields.field("type"))
                    DocumentBlock.Companion.encode(payload, encoder)
                }
                case Block.Thinking(val payload) -> {
                    String.encode("thinking", fields.field("type"))
                    ThinkingBlock.Companion.encode(payload, encoder)
                }
                case Block.Redacted(val payload) -> {
                    String.encode("redacted_thinking", fields.field("type"))
                    RedactedBlock.Companion.encode(payload, encoder)
                }
                case Block.Use(val payload) -> {
                    String.encode("tool_use", fields.field("type"))
                    ToolUse.Companion.encode(payload, encoder)
                }
                case Block.Result(val payload) -> {
                    String.encode("tool_result", fields.field("type"))
                    ToolResult.Companion.encode(payload, encoder)
                }
                case Block.Server(val payload) -> {
                    String.encode("server_tool_use", fields.field("type"))
                    ServerUse.Companion.encode(payload, encoder)
                }
                case Block.SearchResult(val payload) -> {
                    String.encode("web_search_tool_result", fields.field("type"))
                    SearchResultBlock.Companion.encode(payload, encoder)
                }
                case Block.FetchResult(val payload) -> {
                    String.encode("web_fetch_tool_result", fields.field("type"))
                    FetchResultBlock.Companion.encode(payload, encoder)
                }
                case Block.CodeResult(val payload) -> {
                    String.encode("code_execution_tool_result", fields.field("type"))
                    CodeResultBlock.Companion.encode(payload, encoder)
                }
                case Block.Search(val payload) -> {
                    String.encode("search_result", fields.field("type"))
                    SearchBlock.Companion.encode(payload, encoder)
                }
                case Block.Upload(val payload) -> {
                    String.encode("container_upload", fields.field("type"))
                    UploadBlock.Companion.encode(payload, encoder)
                }
                case Block.Unknown(val raw) -> JsonValue.Companion.encode(raw, encoder)
            }
            fields.end()
        }
        public override fun decode(decoder: Decoder): Block {
            val fields = decoder.keyed()
            return when (String.decode(fields.required("type"))) {
                case "text" -> Block.Text(TextBlock.Companion.decode(decoder))
                case "image" -> Block.Image(ImageBlock.Companion.decode(decoder))
                case "document" -> Block.Document(DocumentBlock.Companion.decode(decoder))
                case "thinking" -> Block.Thinking(ThinkingBlock.Companion.decode(decoder))
                case "redacted_thinking" -> Block.Redacted(RedactedBlock.Companion.decode(decoder))
                case "tool_use" -> Block.Use(ToolUse.Companion.decode(decoder))
                case "tool_result" -> Block.Result(ToolResult.Companion.decode(decoder))
                case "server_tool_use" -> Block.Server(ServerUse.Companion.decode(decoder))
                case "web_search_tool_result" -> Block.SearchResult(SearchResultBlock.Companion.decode(decoder))
                case "web_fetch_tool_result" -> Block.FetchResult(FetchResultBlock.Companion.decode(decoder))
                case "code_execution_tool_result" -> Block.CodeResult(CodeResultBlock.Companion.decode(decoder))
                case "search_result" -> Block.Search(SearchBlock.Companion.decode(decoder))
                case "container_upload" -> Block.Upload(UploadBlock.Companion.decode(decoder))
                else -> Block.Unknown(JsonValue.Companion.decode(decoder))
            }
        }
    }
}
enum Content {
    Text(String), Blocks(Array<Block>)
    companion object : ValueEncoder<Content>, ValueDecoder<Content> {
        public override fun encode(value: Content, encoder: Encoder) {
            when (value) {
                case Content.Text(val text) -> String.encode(text, encoder)
                case Content.Blocks(val payload) -> Array<Block>.encoder(Block.Companion).encode(payload, encoder)
            }
        }
        public override fun decode(decoder: Decoder): Content {
            var text: String? = None
            try { text = Some(String.decode(decoder)) }
            catch (error: DecodingException) { text = None }
            if (text != None) { return Content.Text(text!!) }
            return Content.Blocks(Array<Block>.decoder(Block.Companion).decode(decoder))
        }
    }
}
