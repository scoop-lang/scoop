//! dep: scoop:scoop.asyncio:0.1.0
//! dep: scoop:scoop.http.client:0.1.0
//! dep: scoop:scoop.url:0.1.0

import scoop.asyncio.*
import scoop.http.client.*
import scoop.url.Url

fun main(args: Array<String>): Int =
    try {
        val url =
            Url.parse(
                if (args.size > 1L)
                    args[1L]
                else
                    "http://127.0.0.1:8080/"
            )
        val loop = eventLoop()
        loop.run {
            withHttpClient suspend {
                client -> client.withResponse(httpRequest(url)) suspend {
                    response ->
                    response.requireSuccess()
                    val body = response.body.text(1_048_576L)
                    println(response.status)
                    println(body)
                }
            }
        }
        0
    } catch (error: Exception) {
        eprintln(error.message ?: "HTTP request failed")
        1
    }
