package scoop.http.client

import scoop.asyncio.*
import scoop.http.*
import scoop.http.asyncio.AsyncHttp1Connection
import scoop.time.Duration

internal fun immediateClientRetryOptions(maxRetries: Long = 2L): HttpRetryOptions =
    httpRetryOptions {
        this.maxRetries = maxRetries
        this.initialDelay = Duration.ZERO
        this.jitter = false
    }

internal fun withClientRetryTest(
    retries: HttpRetryOptions = immediateClientRetryOptions(),
    version: HttpVersion = HttpVersion.Http11,
    block: suspend (EventLoop, CoroutineScope, AsyncTcpListener, HttpClientConfig) -> Unit
) {
    clientTestTrust().use {
        trust ->
        val base = clientTestConfig(trust, version)
        val config =
            httpClientConfig {
                this.cleartext = base.cleartext
                this.tls = base.tls
                this.retries = retries
                this.pool =
                    httpConnectionPoolOptions {
                        this.maxConnectionsPerOrigin = 1L
                        this.maxStreamsPerHttp2 = 2L
                    }
            }
        val loop = eventLoop()
        loop.run {
            val scope = this;
            clientTestListen(loop).useAsync suspend {
                listener -> block(loop, scope, listener, config)
            }
        }
    }
}

internal suspend fun sendRetryTestStatus(
    connection: AsyncHttp1Connection,
    status: UInt = 503U,
    fields: List<HttpField> = ArrayList<HttpField>()
) {
    connection.sendResponse(
        HttpResponseHead(HttpVersion.Http11, status, Some("retry reason".toByteArray()), fields),
        Http1BodyFraming.Empty
    ).useAsync suspend { output -> output.finish() }
}
