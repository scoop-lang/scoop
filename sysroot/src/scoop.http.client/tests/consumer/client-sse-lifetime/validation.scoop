package scoop.http.client.tests.consumer.client_sse_lifetime

import scoop.test.*
import scoop.asyncio.*
import scoop.crypto.x509.TrustStore
import scoop.http.client.*
import scoop.test.*
import scoop.time.Duration
import scoop.url.Url

internal fun sseValidation(trust: TrustStore) {
    assertFailsWith<IllegalArgumentException> {
        val ignored = httpSseOptions { this.bufferSize = 0L };
        Unit
    }
    assertFailsWith<IllegalArgumentException> {
        val ignored = httpSseReconnectOptions { this.initialDelay = Duration.milliseconds(-1L) };
        Unit
    }
    assertFailsWith<IllegalArgumentException> {
        val ignored = httpSseReconnectOptions { this.maxDelay = Duration.ZERO };
        Unit
    }
    assertFailsWith<IllegalArgumentException> {
        val ignored = httpSseReconnectOptions { this.maxReconnects = Some(-1L) };
        Unit
    }
    val loop = eventLoop()
    loop.run {
        withHttpClient(sseConfig(trust)) suspend {
            client ->
            val url = Url.parse("http://127.0.0.1:1/")
            val request = httpRequest(url)
            assertTrue(
                sseFailure suspend {
                    client.openSse(
                        request,
                        httpSseOptions { this.initialLastEventId = Some("x\r\ny") }
                    );
                    Unit
                } is
                    IllegalArgumentException
            )
            assertTrue(
                sseFailure suspend {
                    client.openSse(
                        httpRequest(url) {
                            this.fields =
                                [sseField("Last-Event-ID", "a"), sseField("Last-Event-ID", "b")]
                        }
                    );
                    Unit
                } is
                    IllegalArgumentException
            )
            assertTrue(
                sseFailure suspend {
                    client.openSse(
                        httpRequest(url) { this.fields = [sseField("Last-Event-ID", "a")] },
                        httpSseOptions { this.initialLastEventId = Some("b") }
                    );
                    Unit
                } is
                    IllegalArgumentException
            )
            assertTrue(
                sseFailure suspend {
                    client.openSse(
                        httpRequest(url) {
                            this.options =
                                httpCallOptions { this.cacheMode = HttpCacheMode.OnlyIfCached }
                        }
                    );
                    Unit
                } is
                    IllegalArgumentException
            )
            assertTrue(
                sseFailure suspend {
                    client.openSse(
                        httpRequest(url) {
                            this.fields = [sseField("Cache-Control", "only-if-cached")]
                        }
                    );
                    Unit
                } is
                    IllegalArgumentException
            )
            val called = AtomicBoolean(false)
            val body = RequestBody.fromProducer(Some(0L)) suspend { _ -> called.store(true) }
            val failure =
                sseFailure suspend {
                    client.openSse(
                        httpRequest(url) {
                            this.method = "POST"
                            this.body = body
                        },
                        httpSseOptions { this.reconnect = Some(httpSseReconnectOptions()) }
                    );
                    Unit
                }
            assertTrue(failure is HttpSseException)
            assertEquals(
                HttpSseFailureReason.BodyNotReplayable,
                (failure as HttpSseException).reason
            )
            assertFalse(called.load())
            Unit
        }
    }
}
