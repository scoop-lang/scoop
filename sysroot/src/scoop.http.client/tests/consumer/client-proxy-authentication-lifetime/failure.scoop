package scoop.http.client.tests.consumer.client_proxy_authentication_lifetime

import scoop.asyncio.*
import scoop.crypto.x509.TrustStore
import scoop.http.HttpCredentials
import scoop.http.asyncio.AsyncHttp1Connection
import scoop.http.client.*
import scoop.platform.system.PlatformErrorKind
import scoop.platform.system.PlatformException

internal fun lifeCallbackFailure(trust: TrustStore, kind: String) {
    withLifeRuntime suspend {
        _, scope, listener ->
        val proxy = lifeUrl(listener)
        val original =
            PlatformException("proxy credentials callback", PlatformErrorKind.ConnectionReset)
        val callbacks = AtomicLong(0L)
        val step: suspend (HttpAuthenticationRequest) -> Unit =
            suspend {
                request ->
                lifeCheck(
                    request.proxyUrl ==
                        Some(proxy) &&
                        request.attempt ==
                        1L &&
                        lifeContext() ==
                        "operation"
                )
                callbacks.fetchAdd(1L)
                coroutineScope<Unit> suspend {
                    child ->
                    child.async<Unit> suspend { throw original };
                    Unit
                }
                throw original
            }
        val provider =
            if (kind == "basic")
                HttpAuthenticator.basic(proxy.httpOrigin()) suspend {
                    request ->
                    step(request);
                    HttpPasswordCredentials("user", "password")
                }
            else
                if (kind == "digest")
                    HttpAuthenticator.digest(proxy.httpOrigin()) suspend {
                        request ->
                        step(request);
                        HttpPasswordCredentials("user", "password")
                    }
                else
                    HttpAuthenticator.bearer(
                        proxy.httpOrigin(),
                        sendWithoutChallenge = false
                    ) suspend {
                        request ->
                        step(request);
                        HttpBearerTokens("unused")
                    }
        val serving =
            scope.launch suspend {
                lifeReject(scope, listener, kind).join()
                AsyncHttp1Connection.takeOwnershipAsServer(
                    listener.accept(),
                    scope
                ).useAsync suspend {
                    connection ->
                    val request = connection.receiveRequest()!!
                    lifeCheck(lifeToken(request.head) == Some("manual"))
                    request.body.readAllBytes(0L);
                    lifeRespond(connection, 200U, "done")
                }
            }
        withHttpClient(
            lifeConfig(
                trust,
                lifeSelector(
                    HttpProxyEndpoint(
                        proxy,
                        authentication = httpAuthenticationOptions { this.providers = [provider] }
                    )
                )
            )
        ) suspend {
            client -> context(LifeContext("operation")) {
                val failed = LifeFailure()
                try {
                    client.execute(httpRequest(lifeTarget())).close()
                }
                catch (error: Throwable) {
                    failed.value = Some(error)
                }
                lifeCheck(failed.value!! === original && callbacks.load() == 1L)
                val manual =
                    lifeSelector(
                        HttpProxyEndpoint(
                            proxy,
                            authorization = Some(HttpCredentials.withToken68("Bearer", "manual"))
                        )
                    )
                lifeDone(
                    client,
                    httpRequest(lifeTarget()) {
                        this.options = httpCallOptions { this.proxy = Some(manual) }
                    }
                )
                lifeCheck(callbacks.load() == 1L)
            }
        }
        serving.join()
    }
}
