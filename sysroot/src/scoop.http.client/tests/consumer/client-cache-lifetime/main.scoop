package scoop.http.client.tests.consumer.client_cache_lifetime

import scoop.asyncio.*
import scoop.tests.scoop.crypto.testdata.rootPem
import scoop.crypto.x509.TrustStore
import scoop.http.*
import scoop.http.asyncio.AsyncHttp1Connection
import scoop.http.client.*
import scoop.platform.io.UnexpectedEofException
import scoop.test.*

private fun cacheCallbackFailure(trust: TrustStore, stage: String) {
    withCacheRuntime suspend {
        _, scope, listener, url ->
        val expected = UnexpectedEofException()
        val storage = FailingCache(stage, expected)
        val serving =
            if (stage != "lookup")
                Some(
                    scope.launch suspend {
                        AsyncHttp1Connection.takeOwnershipAsServer(
                            listener.accept(),
                            scope
                        ).useAsync suspend {
                            connection ->
                            val request = connection.receiveRequest()!!
                            request.body.close()
                            connection.sendResponse(
                                HttpResponseHead(
                                    HttpVersion.Http11,
                                    200U,
                                    fields = [cacheField("Cache-Control", "max-age=60")]
                                ),
                                Http1BodyFraming.Length(4L)
                            ).useAsync suspend {
                                writer ->
                                cacheWrite(writer, "body");
                                writer.finish()
                            }
                        }
                    }
                )
            else
                None
        withHttpClient(
            cacheConfig(
                trust,
                storage,
                CacheClock(),
                retries = httpRetryOptions { this.maxRetries = 1L }
            )
        ) suspend {
            client ->
            var failed = false
            try {
                client.withResponse(httpRequest(url)) suspend {
                    response -> response.body.bytes(16L)
                }
            }
            catch (error: Throwable) {
                assertSame(expected, error);
                failed = true
            }
            assertTrue(failed)
            assertEquals(0L, storage.storage.entryCount)
            assertEquals(1L, storage.lookups)
        }
        serving?.join()
    }
}

@Test
private class CacheLifetimeTests {
    @Test
    fun callbackFailures() {
        for (stage in ["lookup", "begin", "write", "commit"])
            TrustStore.fromPem(rootPem()).use { trust -> cacheCallbackFailure(trust, stage) }
    }
    @Test
    fun cancellation() {
        for (stage in ["lookup", "begin", "write", "commit"])
            for (mode in ["caller", "client"])
                TrustStore.fromPem(rootPem()).use {
                    trust -> cacheCancellation(trust, stage, mode, false)
                }
    }
    @Test
    fun cleanupFailures() {
        for (stage in ["lookup", "begin", "write", "commit"])
            TrustStore.fromPem(rootPem()).use {
                trust -> cacheCancellation(trust, stage, "client", true)
            }
    }
    @Test
    fun deadlines() {
        for (stage in ["lookup", "commit"])
            TrustStore.fromPem(rootPem()).use {
                trust -> cacheCancellation(trust, stage, "total", false)
            }
    }
}
