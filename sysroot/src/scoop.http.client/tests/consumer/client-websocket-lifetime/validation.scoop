package scoop.http.client.tests.consumer.client_websocket_lifetime

import scoop.test.*
import scoop.asyncio.*
import scoop.crypto.x509.TrustStore
import scoop.http.client.*
import scoop.test.*
import scoop.url.Url
import scoop.url.UrlParseException

internal fun clientWsValidation(trust: TrustStore) {
    for (
        text in [
            "http://localhost",
            "https://localhost",
            "ftp://localhost",
            "/relative",
            "ws://localhost#",
            "wss://localhost#part"
        ]
    )
        assertFailsWith<IllegalArgumentException> {
            val ignored = httpWebSocketRequest(Url.parse(text));
            Unit
        }
    assertFailsWith<UrlParseException> {
        val ignored = httpWebSocketRequest(Url.parse("ws://localhost:0"));
        Unit
    }
    val userInfo = httpWebSocketRequest(Url.parse("ws://name:password@localhost/path"))
    assertEquals("/path", userInfo.url.httpRequestTarget())
    assertEquals(0L, userInfo.fields.size)
    val url = Url.parse("ws://127.0.0.1:1/")
    for (
        options in [
            httpCallOptions { this.duplex = true },
            httpCallOptions { this.expectContinue = true },
            httpCallOptions { this.cacheMode = HttpCacheMode.OnlyIfCached }
        ]
    )
        assertFailsWith<IllegalArgumentException> {
            val ignored = httpWebSocketRequest(url) { this.options = options };
            Unit
        }
    for (
        field in [
            clientWsField("Expect", "100-continue"),
            clientWsField("Cache-Control", "only-if-cached")
        ]
    )
        assertFailsWith<IllegalArgumentException> {
            val ignored = httpWebSocketRequest(url) { this.fields = [field] };
            Unit
        }
    val loop = eventLoop()
    loop.run {
        val scope = this;
        val client = HttpClient.open(scope, clientWsConfig(trust))
        try {
            for (
                name in [
                    "Host",
                    "Connection",
                    "Upgrade",
                    "Sec-WebSocket-Key",
                    "Sec-WebSocket-Version",
                    "Sec-WebSocket-Protocol",
                    "Sec-WebSocket-Extensions",
                    "Sec-WebSocket-Accept",
                    "Content-Length",
                    "Transfer-Encoding"
                ]
            ) {
                val error =
                    clientWsFailure suspend {
                        client.openWebSocket(
                            httpWebSocketRequest(url) { this.fields = [clientWsField(name, "x")] }
                        );
                        Unit
                    }
                assertTrue(error is IllegalArgumentException)
            }
            for (protocols in [["chat", "chat"], ["bad protocol"], [""]]) {
                val error =
                    clientWsFailure suspend {
                        client.openWebSocket(
                            httpWebSocketRequest(url),
                            httpWebSocketOptions { this.protocols = protocols }
                        );
                        Unit
                    }
                assertTrue(error is IllegalArgumentException)
            }
        } finally {
            client.close()
        }
    }
}
