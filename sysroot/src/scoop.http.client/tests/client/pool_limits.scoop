package scoop.http.client

import scoop.asyncio.*
import scoop.http.asyncio.AsyncHttp1Connection
import scoop.test.*
import scoop.time.Duration
import scoop.tls.TlsTrustSource

@Test
private class HttpClientPoolLimitsTest {
    @Test
    fun `pool options reject nonpositive capacities and invalid lifetimes`() {
        assertFailsWith<IllegalArgumentException> {
            httpConnectionPoolOptions { this.maxConnectionsPerOrigin = 0L }
        }
        assertFailsWith<IllegalArgumentException> {
            httpConnectionPoolOptions { this.maxConnections = -1L }
        }
        assertFailsWith<IllegalArgumentException> {
            httpConnectionPoolOptions { this.maxStreamsPerHttp2 = 0L }
        }
        assertFailsWith<IllegalArgumentException> {
            httpConnectionPoolOptions { this.idleTimeout = Duration.seconds(-1L) }
        }
        assertFailsWith<IllegalArgumentException> {
            httpConnectionPoolOptions { this.maxLifetime = Some(Duration.ZERO) }
        }
        assertTrue(
            httpConnectionPoolOptions { this.idleTimeout = Duration.ZERO }.idleTimeout ==
                Duration.ZERO
        )
    }

    @Test
    fun `an origin without capacity does not block another origin`() {
        clientTestTrust().use {
            trust ->
            val loop = eventLoop()
            loop.run {
                val scope = this;
                clientTestListen(loop).useAsync suspend {
                    first -> clientTestListen(loop).useAsync suspend {
                        second ->
                        val a =
                            scope.launch suspend {
                                AsyncHttp1Connection.takeOwnershipAsServer(
                                    first.accept(),
                                    scope
                                ).useAsync suspend {
                                    connection ->
                                    var index = 0L
                                    while (index < 2L) {
                                        connection.receiveRequest()!!.body.readAllBytes(0L)
                                        sendClientTestText(connection, 200U, "a")
                                        index += 1L
                                    }
                                }
                            }
                        val b =
                            scope.launch suspend {
                                AsyncHttp1Connection.takeOwnershipAsServer(
                                    second.accept(),
                                    scope
                                ).useAsync suspend {
                                    connection ->
                                    connection.receiveRequest()!!.body.readAllBytes(0L)
                                    sendClientTestText(connection, 200U, "b")
                                }
                            }
                        val config =
                            httpClientConfig {
                                this.tls =
                                    httpClientTlsConfig { this.trust = TlsTrustSource.Store(trust) }
                                this.pool =
                                    httpConnectionPoolOptions {
                                        this.maxConnectionsPerOrigin = 1L
                                        this.maxConnections = 2L
                                    }
                            }
                        withHttpClient(config) suspend {
                            client ->
                            val held = client.execute(httpRequest(clientTestUrl(first)))
                            val queued =
                                scope.launch suspend {
                                    client.withResponse(httpRequest(clientTestUrl(first))) suspend {
                                        response ->
                                        response.body.readAllBytes(1L);
                                        Unit
                                    }
                                }
                            client.withResponse(httpRequest(clientTestUrl(second))) suspend {
                                response -> assertEquals(
                                    "b",
                                    String.fromUtf8(response.body.readAllBytes(1L))
                                )
                            }
                            assertFalse(queued.isCompleted)
                            held.body.readAllBytes(1L);
                            held.close()
                            queued.join()
                        }
                        a.join();
                        b.join()
                    }
                }
            }
        }
    }

    @Test
    fun `the global limit waits for active responses then evicts an idle different origin`() {
        clientTestTrust().use {
            trust ->
            val loop = eventLoop()
            loop.run {
                val scope = this;
                clientTestListen(loop).useAsync suspend {
                    first -> clientTestListen(loop).useAsync suspend {
                        second ->
                        val a =
                            scope.launch suspend {
                                AsyncHttp1Connection.takeOwnershipAsServer(
                                    first.accept(),
                                    scope
                                ).useAsync suspend {
                                    connection ->
                                    connection.receiveRequest()!!.body.readAllBytes(0L)
                                    sendClientTestText(connection, 200U, "a")
                                    assertFalse(clientPresent(connection.receiveRequest()))
                                }
                            }
                        val b =
                            scope.launch suspend {
                                AsyncHttp1Connection.takeOwnershipAsServer(
                                    second.accept(),
                                    scope
                                ).useAsync suspend {
                                    connection ->
                                    connection.receiveRequest()!!.body.readAllBytes(0L)
                                    sendClientTestText(connection, 200U, "b")
                                }
                            }
                        val config =
                            httpClientConfig {
                                this.tls =
                                    httpClientTlsConfig { this.trust = TlsTrustSource.Store(trust) }
                                this.pool = httpConnectionPoolOptions { this.maxConnections = 1L }
                            }
                        withHttpClient(config) suspend {
                            client ->
                            val held = client.execute(httpRequest(clientTestUrl(first)))
                            val queued =
                                scope.launch suspend {
                                    client.withResponse(
                                        httpRequest(clientTestUrl(second))
                                    ) suspend {
                                        response -> assertEquals(
                                            "b",
                                            String.fromUtf8(response.body.readAllBytes(1L))
                                        )
                                    }
                                }
                            assertFalse(queued.isCompleted)
                            held.body.readAllBytes(1L);
                            held.close()
                            queued.join()
                        }
                        a.join();
                        b.join()
                    }
                }
            }
        }
    }

    @Test
    fun `failed connection attempts release the reserved global capacity`() {
        clientTestTrust().use {
            trust ->
            val loop = eventLoop()
            loop.run {
                val scope = this;
                val unavailable = clientTestListen(loop)
                val missing = clientTestUrl(unavailable)
                unavailable.close()
                clientTestListen(loop).useAsync suspend {
                    listener ->
                    val serving =
                        scope.launch suspend {
                            AsyncHttp1Connection.takeOwnershipAsServer(
                                listener.accept(),
                                scope
                            ).useAsync suspend {
                                connection ->
                                connection.receiveRequest()!!.body.readAllBytes(0L)
                                sendClientTestText(connection, 200U, "ok")
                            }
                        }
                    val config =
                        httpClientConfig {
                            this.tls =
                                httpClientTlsConfig { this.trust = TlsTrustSource.Store(trust) }
                            this.pool = httpConnectionPoolOptions { this.maxConnections = 1L }
                        }
                    withHttpClient(config) suspend {
                        client ->
                        val failing =
                            scope.launch suspend {
                                expectBodyFailure<Throwable> suspend {
                                    client.execute(httpRequest(missing));
                                    Unit
                                }
                            }
                        client.withResponse(httpRequest(clientTestUrl(listener))) suspend {
                            response -> assertEquals(
                                "ok",
                                String.fromUtf8(response.body.readAllBytes(2L))
                            )
                        }
                        failing.join()
                    }
                    serving.join()
                    assertFalse(scope.job.isCancelled)
                }
            }
        }
    }
}
