package scoop.http.client

import scoop.http.*
import scoop.test.*
import scoop.url.Url

@Test
private class HttpClientRequestTest {
    @Test
    fun `request snapshots preserve duplicate fields method case and explicit lengths`() {
        val fields = ArrayList<HttpField>()
        fields.add(HttpField("X-Repeat".toByteArray(), "first".toByteArray()))
        fields.add(HttpField("x-repeat".toByteArray(), "second".toByteArray()))
        fields.add(HttpField("Content-Length".toByteArray(), "004, 4".toByteArray()))
        val body = RequestBody.fromText("test")
        val request =
            httpRequest(Url.parse("https://user:pass@EXAMPLE.com/path?q=1#local")) {
                this.method = "m-SEARCH"
                this.fields = fields
                this.body = body
            }
        fields.clear()
        assertEquals("m-SEARCH", request.method)
        assertEquals(2L, request.fields.findAll("X-Repeat".toByteArray()).size)
        assertTrue(request.contentLength == Some(4L))
        assertEquals("example.com", request.origin.host.toString())
        assertEquals(0L, request.fields.findAll("Authorization".toByteArray()).size)
        assertSame(body, request.body)
    }

    @Test
    fun `request construction rejects conflicting framing and invalid network metadata`() {
        val url = Url.parse("https://example.com/")
        for (method in ["", "BAD METHOD", "Méthod"]) {
            assertFailsWith<IllegalArgumentException> { httpRequest(url) { this.method = method } }
        }
        for (name in ["Host", ":authority", "Transfer-Encoding", "Bad Name"]) {
            assertFailsWith<IllegalArgumentException> {
                httpRequest(url) {
                    this.fields = [HttpField(name.toByteArray(), "x".toByteArray())]
                }
            }
        }
        assertFailsWith<IllegalArgumentException> {
            httpRequest(url) {
                this.method = "POST"
                this.body = RequestBody.fromText("four")
                this.fields = [HttpField("Content-Length".toByteArray(), "3".toByteArray())]
            }
        }
        assertFailsWith<IllegalArgumentException> { httpRequest(Url.parse("ws://example.com/")) }
        assertFailsWith<IllegalArgumentException> {
            httpClientConfig {
                this.versionPolicy = HttpVersionPolicy.Http1Only
                this.cleartext = HttpCleartextProtocol.Http2PriorKnowledge
            }
        }
    }
}
