package scoop.http.client

import scoop.asyncio.*
import scoop.http.asyncio.AsyncHttp1Connection
import scoop.test.*
import scoop.time.Duration
import scoop.url.Url

@Test
private class HttpClientNetworkTimeoutTest {
    @Test
    fun `DNS stage failures keep the complete lower error and call overrides permit the next connection`() {
        for (resolution in [true, false]) {
            val options =
                httpTimeoutOptions {
                    this.resolve =
                        if (resolution)
                            Some(Duration.ZERO)
                        else
                            None
                    this.connect = Some(Duration.ZERO)
                    this.tlsHandshake = None
                }
            withClientTimeoutTest(options) suspend {
                _, scope, listener, config ->
                val started = AtomicBoolean(false)
                val serving =
                    scope.launch suspend {
                        AsyncHttp1Connection.takeOwnershipAsServer(
                            listener.accept(),
                            scope
                        ).useAsync suspend {
                            connection ->
                            assertEquals(
                                "send",
                                String.fromUtf8(connection.receiveRequest()!!.body.readAllBytes(4L))
                            )
                            sendClientTestText(connection, 200U, "ok")
                        }
                    }
                withHttpClient(config) suspend {
                    client ->
                    val url =
                        Url.parse("http://localhost:" + listener.localAddress.port.toString() + "/")
                    val body =
                        RequestBody.fromProducer(Some(4L)) suspend {
                            output ->
                            assertFalse(started.exchange(true));
                            writeBodyText(output, "send")
                        }
                    val error =
                        expectBodyFailure<HttpTimeoutException> suspend {
                            client.execute(
                                httpRequest(url) {
                                    this.method = "POST"
                                    this.body = body
                                }
                            );
                            Unit
                        }
                    checkClientTimeout(
                        error,
                        if (resolution)
                            HttpTimeoutPhase.Resolve
                        else
                            HttpTimeoutPhase.Connect,
                        Duration.ZERO
                    )
                    val cause = error.cause!!
                    if (resolution) {
                        assertTrue(cause is TcpConnectException)
                        if (cause is TcpConnectException) {
                            assertEquals(0L, cause.attempts.size)
                            assertEquals(2L, cause.resolutionFailures.size)
                            for (failure in cause.resolutionFailures)
                                assertTrue(failure.cause is TcpResolutionTimeoutException)
                        }
                    } else
                        assertTrue(cause is TcpConnectTimeoutException)
                    assertFalse(started.load())
                    val disabled =
                        httpTimeoutOptions {
                            this.resolve = None
                            this.connect = None
                            this.tlsHandshake = None
                        }
                    client.withResponse(
                        httpRequest(url) {
                            this.method = "POST"
                            this.body = body
                            this.options = httpCallOptions { this.timeouts = Some(disabled) }
                        }
                    ) suspend { response -> assertEquals("ok", response.body.text(2L)) }
                    assertTrue(started.load())
                }
                serving.join()
                assertFalse(scope.job.isCancelled)
            }
        }
    }

    @Test
    fun `IP literals skip DNS and cleartext skips TLS while reused connections skip every network stage`() {
        val zero = Some(Duration.ZERO)
        withClientTimeoutTest(
            httpTimeoutOptions {
                this.resolve = zero
                this.connect = zero
                this.tlsHandshake = zero
            }
        ) suspend {
            _, scope, listener, config ->
            val serving =
                scope.launch suspend {
                    AsyncHttp1Connection.takeOwnershipAsServer(
                        listener.accept(),
                        scope
                    ).useAsync suspend {
                        connection -> for (_ in 0L .. 1L) {
                            connection.receiveRequest()!!.body.readAllBytes(0L)
                            sendClientTestText(connection, 200U, "ok")
                        }
                    }
                }
            withHttpClient(config) suspend {
                client ->
                val request = httpRequest(clientTestUrl(listener))
                val error =
                    expectBodyFailure<HttpTimeoutException> suspend {
                        client.execute(request);
                        Unit
                    }
                checkClientTimeout(error, HttpTimeoutPhase.Connect, Duration.ZERO)
                assertFalse(clientPresent(error.cause))
                client.withResponse(
                    httpRequest(clientTestUrl(listener)) {
                        this.options =
                            httpCallOptions {
                                this.timeouts =
                                    Some(
                                        httpTimeoutOptions {
                                            this.resolve = zero
                                            this.connect = None
                                            this.tlsHandshake = zero
                                        }
                                    )
                            }
                    }
                ) suspend { response -> assertEquals("ok", response.body.text(2L)) }
                client.withResponse(request) suspend {
                    response -> assertEquals("ok", response.body.text(2L))
                }
            }
            serving.join()
        }
    }

    @Test
    fun `unified network settings replace lower TCP timeout fields without changing racing controls`() {
        val lower =
            tcpConnectOptions {
                this.resolutionDelay = Duration.ZERO
                this.attemptDelay = Duration.ZERO
                this.maxConcurrentAttempts = 1L
                this.resolveTimeout = Some(Duration.ZERO)
                this.connectTimeout = Some(Duration.ZERO)
            }
        withClientTimeoutTest(tcpConnect = lower) suspend {
            _, scope, listener, config ->
            val serving =
                scope.launch suspend {
                    AsyncHttp1Connection.takeOwnershipAsServer(
                        listener.accept(),
                        scope
                    ).useAsync suspend {
                        connection ->
                        connection.receiveRequest()!!.body.readAllBytes(0L)
                        sendClientTestText(connection, 200U, "ok")
                    }
                }
            withHttpClient(config) suspend {
                client ->
                val url =
                    Url.parse("http://localhost:" + listener.localAddress.port.toString() + "/")
                client.withResponse(httpRequest(url)) suspend {
                    response -> assertEquals("ok", response.body.text(2L))
                }
            }
            serving.join()
        }
    }
}
