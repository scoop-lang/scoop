package scoop.http.client

import scoop.asyncio.*
import scoop.collections.emptyList
import scoop.http.*
import scoop.platform.memory.NativeByteBuffer
import scoop.url.Url

internal fun redirectTestHead(status: UInt = 302U, location: String = "/after"): HttpResponseHead =
    HttpResponseHead(
        HttpVersion.Http11,
        status,
        Some("redirect reason".toByteArray()),
        [HttpField("Location".toByteArray(), location.toByteArray())]
    )

internal fun redirectTestRequest(
    method: String = "POST",
    body: RequestBody = RequestBody.fromText("body"),
    fields: List<HttpField> = emptyList<HttpField>(),
    options: HttpCallOptions = httpCallOptions()
): HttpRequest =
    httpRequest(Url.parse("http://example.test/before#saved")) {
        this.method = method
        this.fields = fields
        this.body = body
        this.options = options
    }

internal fun redirectTestPlan(
    request: HttpRequest,
    status: UInt = 302U,
    location: String = "/after"
): ClientRedirect =
    planClientRedirect(
        request,
        redirectTestHead(status, location),
        httpRedirectOptions(),
        emptyList<HttpRedirect>()
    )!!

internal fun withClientRedirectTest(
    version: HttpVersion = HttpVersion.Http11,
    redirects: HttpRedirectOptions = httpRedirectOptions(),
    timeouts: HttpTimeoutOptions = httpTimeoutOptions(),
    block: suspend (EventLoop, CoroutineScope, AsyncTcpListener, HttpClientConfig) -> Unit
) {
    clientTestTrust().use {
        trust ->
        val base = clientTestConfig(trust, version)
        val config =
            httpClientConfig {
                this.cleartext = base.cleartext
                this.tls = base.tls
                this.redirects = redirects
                this.timeouts = timeouts
                this.pool =
                    httpConnectionPoolOptions {
                        this.maxConnectionsPerOrigin = 1L
                        this.maxStreamsPerHttp2 = 1L
                    }
            }
        val loop: EventLoop = PlatformEventLoop()
        loop.run suspend {
            scope -> clientTestListen(loop).useAsync suspend {
                listener -> block(loop, scope, listener, config)
            }
        }
    }
}

internal class RedirectTestSource(val source: BodyTestSource): AsyncByteSource, AsyncCloseable {
    val cancelled: BodyTestGate = BodyTestGate()
    public override suspend fun readInto(buffer: NativeByteBuffer, count: Long): Long {
        val listener = currentJobOrNone()!!.invokeOnCancellation { _ -> cancelled.signal() }
        try {
            return source.readInto(buffer, count)
        }
        finally {
            listener.dispose()
        }
    }
    public override suspend fun close() {
        val listener = currentJobOrNone()!!.invokeOnCancellation { _ -> cancelled.signal() }
        try {
            source.close()
        }
        finally {
            listener.dispose()
        }
    }
}
