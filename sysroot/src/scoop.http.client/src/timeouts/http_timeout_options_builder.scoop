package scoop.http.client

import scoop.time.Duration
import scoop.http.*
import scoop.http.asyncio.*
import scoop.asyncio.*

/** Configures one complete value; execution remains explicit. */
public fun httpTimeoutOptions(
    configure: HttpTimeoutOptionsBuilder.() -> Unit = {}
): HttpTimeoutOptions {
    val builder = HttpTimeoutOptionsBuilder()
    builder.configure()
    return builder.snapshot()
}

public fun HttpTimeoutOptions.copy(
    configure: HttpTimeoutOptionsBuilder.() -> Unit = {}
): HttpTimeoutOptions {
    val builder = HttpTimeoutOptionsBuilder()
    builder.total = this.total
    builder.poolAcquire = this.poolAcquire
    builder.responseHeaders = this.responseHeaders
    builder.resolve = this.resolve
    builder.connect = this.connect
    builder.tlsHandshake = this.tlsHandshake
    builder.readIdle = this.readIdle
    builder.writeIdle = this.writeIdle
    builder.proxyHandshake = this.proxyHandshake
    builder.configure()
    return builder.snapshot()
}

public class HttpTimeoutOptionsBuilder internal constructor() {
    public var total: Duration? = None
    public var poolAcquire: Duration? = None
    public var responseHeaders: Duration? = None
    public var resolve: Duration? = Some(Duration.seconds(30L))
    public var connect: Duration? = Some(Duration.seconds(30L))
    public var tlsHandshake: Duration? = Some(Duration.seconds(30L))
    public var readIdle: Duration? = None
    public var writeIdle: Duration? = None
    public var proxyHandshake: Duration? = Some(Duration.seconds(30L))
    internal fun snapshot(): HttpTimeoutOptions =
        HttpTimeoutOptions(
            total,
            poolAcquire,
            responseHeaders,
            resolve,
            connect,
            tlsHandshake,
            readIdle,
            writeIdle,
            proxyHandshake
        )
}
