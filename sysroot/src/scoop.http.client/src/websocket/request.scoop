package scoop.http.client

import scoop.http.asyncio.webSocketSessionOptions

import scoop.collections.emptyList
import scoop.http.*
import scoop.http.asyncio.WebSocketSessionOptions
import scoop.url.Url

/**
 * A ws/wss upgrade request without URL fragment or request body. Handshake-specific fields are
 * managed by the client.
 */
public class HttpWebSocketRequest internal constructor(
    /**
     * The validated ws or wss URL without a fragment.
     */
    public val url: Url,
    fields: List<HttpField> = emptyList<HttpField>(),
    /**
         * HTTP call policy used during the handshake.
         */
    public val options: HttpCallOptions = httpCallOptions()
) {
    /**
     * Copied caller fields for the upgrade request.
     */
    public val fields: Array<HttpField> = fields.toArray()
    internal val httpUrl: Url = clientWebSocketHttpUrl(url)
    init {
        if (url.scheme != Some("ws") && url.scheme != Some("wss"))
            throw IllegalArgumentException(Some("WebSocket request requires ws or wss"))
        if (options.duplex || options.expectContinue)
            throw IllegalArgumentException(Some("WebSocket handshake has an empty request body"))
        if (
            options.cacheMode ==
                HttpCacheMode.OnlyIfCached ||
                HttpCacheControl.parseFields(this.fields).contains("only-if-cached")
        )
            throw IllegalArgumentException(Some("WebSocket handshake cannot use only-if-cached"))
        for (field in this.fields)
            if (field.hasName("Expect".toByteArray()))
                throw IllegalArgumentException(Some("WebSocket handshake cannot wait for Continue"))
    }
}

/**
 * Offered subprotocols, permessage-deflate offers, and the asynchronous session's buffering/close
 * policy.
 */
public class HttpWebSocketOptions internal constructor(
    protocols: List<String> = emptyList<String>(),
    deflateOffers: List<WebSocketDeflateOffer> = emptyList<WebSocketDeflateOffer>(),
    /**
     * Post-upgrade streaming, limits, and close policy.
     */
    public val session: WebSocketSessionOptions = webSocketSessionOptions()
) {
    /**
     * Subprotocol tokens offered in order.
     */
    public val protocols: Array<String> = protocols.toArray()
    /**
     * Explicit permessage-deflate offers.
     */
    public val deflateOffers: Array<WebSocketDeflateOffer> = deflateOffers.toArray()
}

internal fun clientWebSocketHttpUrl(url: Url): Url {
    if (url.encodedFragment != None)
        throw IllegalArgumentException(Some("WebSocket URL cannot contain a fragment"))
    val scheme =
        when (url.scheme) {
            case Some("ws") -> "http"
            case Some("http") -> "http"
            case Some("wss") -> "https"
            case Some("https") -> "https"
            else -> throw IllegalArgumentException(
                Some("WebSocket handshake requires an HTTP or WebSocket URL")
            )
        }
    val result = url.copy { this.scheme = Some(scheme) }
    result.httpOrigin()
    return result
}

internal fun clientWebSocketUrl(url: Url): Url =
    url.copy {
        scheme =
            Some(
                if (url.scheme == Some("http"))
                    "ws"
                else
                    "wss"
            )
    }

internal fun clientWebSocketOptions(options: HttpCallOptions): HttpCallOptions =
    httpCallOptions {
        this.decoding = options.decoding
        this.timeouts = options.timeouts
        this.onInformational = options.onInformational
        this.redirects = options.redirects
        this.retries = options.retries
        this.authentication = options.authentication
        this.proxy = options.proxy
        this.useCookies = options.useCookies
        this.cookieContext = options.cookieContext
        this.cacheMode = HttpCacheMode.Bypass
        this.observer = options.observer
    }
