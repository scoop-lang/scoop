package scoop.http.client

import scoop.http.*

internal fun validateClientSseRequest(request: HttpRequest, options: HttpSseOptions): String {
    if (clientPresent(options.reconnect) && !request.body.isReplayable)
        throw HttpSseException(HttpSseFailureReason.BodyNotReplayable, request.url)
    if (
        request.options.cacheMode ==
            HttpCacheMode.OnlyIfCached ||
            HttpCacheControl.parseFields(request.fields).contains("only-if-cached")
    )
        throw IllegalArgumentException(Some("SSE requires a network response"))
    val ids = request.fields.findAll("Last-Event-ID".toByteArray())
    if (ids.size > 1L || (ids.size != 0L && clientPresent(options.initialLastEventId)))
        throw IllegalArgumentException(Some("SSE needs a single initial Last-Event-ID"))
    val id =
        options.initialLastEventId ?:
            if (ids.size == 0L)
                ""
            else
                String.fromUtf8(ids[0L].value)
    HttpField("Last-Event-ID".toByteArray(), id.toByteArray()).validate()
    return id
}

internal fun clientSseRequest(state: ClientSseState): HttpRequest {
    val original = state.original
    val fields = ArrayList<HttpField>()
    for (field in original.suppliedFields)
        if (!field.hasName("Last-Event-ID".toByteArray()))
            fields.add(field)
    if (!clientCacheHas(original.fields, "Accept"))
        fields.add(HttpField("Accept".toByteArray(), "text/event-stream".toByteArray()))
    if (!clientCacheHas(original.fields, "Cache-Control"))
        fields.add(HttpField("Cache-Control".toByteArray(), "no-cache".toByteArray()))
    if (state.lastEventId != "")
        fields.add(HttpField("Last-Event-ID".toByteArray(), state.lastEventId.toByteArray()))
    val options = original.options
    val decoding = options.decoding ?: state.client.config.decoding
    val prepared =
        httpCallOptions {
            this.duplex = options.duplex
            this.expectContinue = options.expectContinue
            this.continueWait = options.continueWait
            this.decoding =
                Some(
                    httpDecodingOptions {
                        this.mode = HttpContentDecoding.Automatic
                        this.bufferSize = decoding.bufferSize
                        this.maxWindowBytes = decoding.maxWindowBytes
                    }
                )
            this.timeouts = options.timeouts
            this.onInformational = options.onInformational
            this.redirects = options.redirects
            this.retries = options.retries
            this.authentication = options.authentication
            this.proxy = options.proxy
            this.useCookies = options.useCookies
            this.cookieContext = options.cookieContext
            this.cacheMode = HttpCacheMode.Bypass
            this.observer = options.observer
        }
    return httpRequest(original.url) {
        this.method = original.method
        this.fields = fields
        this.body = original.body
        this.options = prepared
    }
}
