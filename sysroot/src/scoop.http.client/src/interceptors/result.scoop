package scoop.http.client

import scoop.asyncio.AsyncCloseable

/**
 * The owned result returned through the interceptor chain: an ordinary response or WebSocket
 * upgrade result.
 */
public enum HttpCallResult : AsyncCloseable {
    /**
     * An owned HTTP response whose body remains consumable.
     */
    Response(HttpResponse),
        /**
         * An owned opened session or rejected WebSocket handshake response.
         */
        WebSocket(HttpWebSocketResult)

    /**
     * Closes the owned response or session represented by this result.
     */
    public override suspend fun close() { clientResultResource(this).close() }
}

internal fun clientResultResource(result: HttpCallResult): AsyncCloseable = when (result) {
    case Response(val response) -> response
    case WebSocket(val value) -> when (value) {
        case Opened(val session) -> session
        case Rejected(val response, _) -> response
    }
}

internal fun clientResultOwner(result: HttpCallResult): ClientState = when (result) {
    case Response(val response) -> response.call.client
    case WebSocket(val value) -> when (value) {
        case Opened(val session) -> session.state.client
        case Rejected(val response, _) -> response.call.client
    }
}

internal fun clientResultIsWebSocket(result: HttpCallResult): Boolean = when (result) {
    case Response(_) -> false
    case WebSocket(_) -> true
}
