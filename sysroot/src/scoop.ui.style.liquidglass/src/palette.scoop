package scoop.ui.style.liquidglass

import scoop.graphics.Color
import scoop.ui.style.*

/** Opaque text roles leave room for a translucent surface while preserving their contrast. */
internal fun liquidPalette(mode: ThemeMode): ThemePalette {
    val dark = mode == ThemeMode.Dark
    val text = liquidColor(if (dark) 0xf1f5fa else 0x19222e)
    val secondaryText = liquidColor(if (dark) 0xc0cad8 else 0x465364)
    val canvas = ColorPair(liquidColor(if (dark) 0x101722 else 0xf3f5f9), text)
    val card = ColorPair(liquidColor(if (dark) 0x192331 else 0xffffff), text)
    val popover = ColorPair(liquidColor(if (dark) 0x1c2c3f else 0xf8fbff), text)
    val primary = ColorPair(
        liquidColor(if (dark) 0x6cb5ff else 0x006bcf),
        liquidColor(if (dark) 0x051f3a else 0xffffff)
    )
    val secondary = ColorPair(liquidColor(if (dark) 0x273746 else 0xe6eef8), text)
    val accent = ColorPair(liquidColor(if (dark) 0x284567 else 0xd9eaff), text)
    val error = ColorPair(
        liquidColor(if (dark) 0xffa6a0 else 0xc22b3a),
        liquidColor(if (dark) 0x480711 else 0xffffff)
    )
    val edge = (if (dark) Color.White else liquidColor(0x365273)).withAlpha(if (dark) 0.22 else 0.2)
    return ThemePalette(
        background = canvas,
        card = card,
        popover = popover,
        primary = primary,
        secondary = secondary,
        muted = ColorPair(liquidColor(if (dark) 0x23303f else 0xe9eef4), secondaryText),
        accent = accent,
        destructive = error,
        border = edge,
        input = edge.withAlpha(if (dark) 0.4 else 0.34),
        ring = primary.background,
        chart = ChartPalette(
            primary.background,
            liquidColor(if (dark) 0x6dd9ad else 0x09825a),
            liquidColor(if (dark) 0xffca7a else 0xa75d0c),
            liquidColor(if (dark) 0xc5a4ff else 0x7b43c7),
            error.background
        ),
        sidebar = SidebarPalette(card, primary, accent, edge, primary.background),
        disabledText = liquidColor(if (dark) 0x8191a6 else 0x6c7a8b),
        shadow = Color.Black.withAlpha(if (dark) 0.38 else 0.14)
    )
}

private fun liquidColor(value: Int): Color = Color(
    (value / 65536 % 256).toDouble() / 255.0,
    (value / 256 % 256).toDouble() / 255.0,
    (value % 256).toDouble() / 255.0
)
