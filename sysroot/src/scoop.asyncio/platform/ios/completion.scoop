package scoop.asyncio

import scoop.platform.system.NativeError
import scoop.platform.system.NativeErrorDomain

internal enum IoResult {
    Done, Failed(NativeError, Long)
}

internal fun decodeEvent(record: NativeRecord): NativeEvent = NativeEvent(
    record.id,
    when (record.kind) {
        case 0 -> IoResult.Done
        case 5 ->
            IoResult.Failed(NativeError(NativeErrorDomain.PosixErrno, record.code), record.count)
        else -> throw IllegalStateException(Some("invalid iOS timer completion"))
    }
)
