package scoop.asyncio

internal enum OperationChoice {
    Pending, Stopped(Throwable?), Completed
}

private enum OperationDelivery {
    Submit, Finish
}

internal abstract class LoopOperation internal constructor(
    val loop: LoopOwner,
    val id: Long,
    val retained: Boolean = false
) {
    // The native owner alone changes completion registration.
    var registered: Boolean = false
    abstract fun run()
    abstract fun begin(pointer: Ptr<Unit>)
    abstract fun complete(event: NativeEvent)
    abstract fun cancelNative(pointer: Ptr<Unit>)
    abstract fun selectFailure(error: Throwable): Boolean
    abstract fun requestFailure(error: Throwable)
}

internal abstract class PendingOperation internal constructor(
    loop: LoopOwner,
    id: Long
): LoopOperation(loop, id) {
    private val lock: IoLock = IoLock()
    private var choice: OperationChoice = OperationChoice.Pending
    private var subscription: Disposable? = None
    // Only the loop owner changes the delivery phase.
    private var delivery = OperationDelivery.Submit

    protected abstract fun start(pointer: Ptr<Unit>): IoStart
    protected abstract fun recordCompletion(event: NativeEvent, failure: Throwable?)
    protected abstract fun finish()

    public final override fun run() {
        when (delivery) {
            case Submit -> loop.beginOperation(this)
            case Finish -> finish()
        }
    }

    fun subscribe(job: Job) {
        val registration = job.invokeOnCancellation { requestFailure(CancellationException()) }
        // Completion cannot run until this operation has been submitted.
        subscription = Some(registration)
    }

    public final override fun selectFailure(error: Throwable): Boolean = selectStop(Some(error))

    private fun selectStop(error: Throwable?): Boolean =
        lock.withLock {
            when (choice) {
                case Pending -> {
                    choice = OperationChoice.Stopped(error);
                    true
                }
                case _ -> false
            }
        }

    public final override fun requestFailure(error: Throwable) {
        if (selectFailure(error))
            loop.post { loop.cancel(id) }
    }

    // Ordinary timer disposal needs native retirement, not an exceptional coroutine result.
    fun requestStop() {
        if (selectStop(None))
            loop.post { loop.cancel(id) }
    }

    public final override fun begin(pointer: Ptr<Unit>) {
        val cancelled =
            lock.withLock {
                when (choice) {
                    case Stopped(_) -> true;
                    case _ -> false
                }
            }
        if (cancelled) {
            loop.complete(NativeEvent(id, IoResult.Done));
            return
        }
        val result =
            try {
                start(pointer)
            }
            catch (error: Throwable) {
                selectFailure(error);
                IoStart.Finished(NativeEvent(id, IoResult.Done))
            }
        when (result) {
            case Pending -> {}
            case Finished(val event) -> loop.complete(event)
        }
    }

    protected fun unsubscribe() {
        when (subscription) {
            case Some(val value) -> value.dispose()
            case None -> {}
        }
        subscription = None
    }

    public final override fun complete(event: NativeEvent) {
        val failure: Throwable? =
            lock.withLock {
                val previous = choice
                choice = OperationChoice.Completed
                when (previous) {
                    case Stopped(val error) -> error
                    case Pending -> None
                    case Completed -> throw IllegalStateException(Some("operation completed twice"))
                }
            }
        unsubscribe()
        recordCompletion(event, failure)
        delivery = OperationDelivery.Finish
        loop.enqueueReady(this)
    }
}

private struct CallbackCompletion(val event: NativeEvent, val failure: Throwable?)

internal class CallbackOperation(
    loop: LoopOwner,
    id: Long,
    private val onStart: (Ptr<Unit>, Long) -> IoStart,
    private val onCancel: (Ptr<Unit>, Long) -> Unit,
    private val onFinish: (NativeEvent, Throwable?) -> Unit
): PendingOperation(loop, id) {
    private var completion: CallbackCompletion? = None

    protected override fun start(pointer: Ptr<Unit>): IoStart = onStart(pointer, id)
    public override fun cancelNative(pointer: Ptr<Unit>) {
        onCancel(pointer, id)
    }
    protected override fun recordCompletion(event: NativeEvent, failure: Throwable?) {
        completion = Some(CallbackCompletion(event, failure))
    }
    protected override fun finish() {
        val result = completion!!
        completion = None
        onFinish(result.event, result.failure)
    }
}
