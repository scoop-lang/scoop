package scoop.asyncio

import scoop.concurrent.*

// The runtime owns both groups. The loop coordinates shutdown while this owner joins them.
internal class RuntimeWorkers(
    val executor: MultiThreadExecutor,
    val pool: BlockingTaskPool
): Closeable {
    public override fun close() {
        pool.use { _ -> executor.close() }
    }
}

internal fun createRuntimeWorkers(config: AsyncRuntimeConfig): RuntimeWorkers {
    val pool = BlockingTaskPool(config.blockingThreads)
    try {
        val executor =
            multiThreadExecutor {
                workers = config.workers
                blocking(pool)
            }
        return RuntimeWorkers(executor, pool)
    } catch (error: Throwable) {
        pool.use { _ -> throw error }
    }
}
