package scoop.asyncio

import scoop.platform.memory.NativeByteBuffer
import scoop.platform.memory.NativeByteBorrow
import scoop.platform.io.WriteZeroException

// One operation owns registration, native retirement and the borrow's cleanup.
internal abstract class ByteTransfer(
    loop: LoopOwner,
    protected val borrowed: NativeByteBorrow,
    private val reservation: Disposable,
    private val job: Job,
    protected val writing: Boolean
): LoopOperation(loop, loop.nextOperation()), SuspendRegistration<Long> {
    private var continuation: Continuation<Long>? = None
    private var transferred: Long = 0L
    private var completionError: Throwable? = None

    protected abstract fun attach()
    protected abstract fun failure(result: IoResult, selected: Throwable?): Throwable?

    public final override fun register(continuation: Continuation<Long>) {
        if (borrowed.length == 0L) {
            releaseBorrow(0L)
            continuation.resume(0L)
            return
        }
        this.continuation = Some(continuation)
        try {
            subscribe(job)
            attach()
            loop.submit(this)
        } catch (error: Throwable) {
            this.continuation = None
            try {
                unsubscribe()
            }
            finally {
                releaseBorrow(0L)
            }
            throw error
        }
    }

    protected final override fun recordCompletion(event: NativeEvent, selected: Throwable?) {
        transferred = resultProgress(event.result)
        completionError =
            try {
                failure(event.result, selected)
            } catch (error: Throwable) {
                Some(error)
            }
    }

    protected final override fun finish() {
        val target = continuation!!
        continuation = None
        val count = transferred
        val error = completionError
        completionError = None
        val result =
            try {
                try {
                    when (error) {
                        case Some(val error) -> throw error
                        case None -> {}
                    }
                    if (writing && count == 0L)
                        throw WriteZeroException()
                    count
                } finally {
                    releaseBorrow(count)
                }
            } catch (error: Throwable) {
                target.resumeWithException(error)
                return
            }
        target.resume(result)
    }

    private fun releaseBorrow(count: Long) {
        try {
            @Unsafe
            {
                borrowed.complete(count)
            }
        } finally {
            reservation.dispose()
        }
    }
}

internal fun borrowTransfer(
    buffer: NativeByteBuffer,
    count: Long,
    writing: Boolean
): NativeByteBorrow {
    @Unsafe
    {
        return if (writing)
            buffer.borrowReadable(count)
        else
            buffer.borrowWritable(count)
    }
}
