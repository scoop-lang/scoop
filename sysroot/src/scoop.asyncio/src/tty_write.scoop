package scoop.asyncio

import scoop.platform.memory.NativeByteBuffer
import scoop.platform.memory.NativeByteBorrow

internal suspend fun writeTty(owner: OwnedEndpoint, buffer: NativeByteBuffer, count: Long): Long =
    suspendCoroutine(prepareTtyWrite(owner, buffer, count))

private fun prepareTtyWrite(owner: OwnedEndpoint, buffer: NativeByteBuffer, count: Long): TtyWrite {
    val job = owner.loop.requireJob()
    val reservation = owner.reserve(true)
    try {
        val borrowed = borrowTransfer(buffer, count, true)
        try {
            return TtyWrite(owner, borrowed, reservation, job)
        } catch (error: Throwable) {
            @Unsafe
            {
                borrowed.complete(0L)
            }
            throw error
        }
    } catch (error: Throwable) {
        reservation.dispose()
        throw error
    }
}

private class TtyWrite(
    private val owner: OwnedEndpoint,
    borrowed: NativeByteBorrow,
    reservation: EndpointReservation,
    job: Job
): ByteTransfer(owner.loop, borrowed, reservation, job, true) {
    protected override fun attach() {
        owner.attach(this, true)
    }

    protected override fun start(pointer: Ptr<Unit>): IoStart {
        @Unsafe
        {
            return nativeStatus(
                id,
                nativeTtyWrite(owner.pointer, id, borrowed.pointer(), borrowed.length)
            )
        }
    }

    public override fun cancelNative(pointer: Ptr<Unit>) {
        @Unsafe
        {
            nativeTtyCancelWrite(owner.pointer, id)
        }
    }

    protected override fun failure(result: IoResult, selected: Throwable?): Throwable? =
        completionFailure("TTY write", result, selected)
}
