package scoop.asyncio

import scoop.asyncio.host.EventLoopHost
import scoop.time.Duration
import scoop.platform.net.*
import scoop.platform.system.OsString
import scoop.platform.fs.*

/**
 * A single-use platform event loop. Run it from outside a Job and outside another event loop; I/O
 * requires an active job in this loop's context.
 */
public class PlatformEventLoop internal constructor(
    private val config: LoopBlockingConfig
): EventLoop {
    private val accepted: AtomicBoolean = AtomicBoolean(false)
    internal val state: LoopOwner = LoopOwner()

    /** The owner executor for this active loop lifetime. */
    public override val executor: CoroutineExecutor get() = state.activeExecutor()

    /**
     * Runs the root structured scope and drives its operations to completion. The loop is
     * single-use and cannot be nested or called from an existing Job.
     */
    public fun <T> run(block: suspend CoroutineScope.() -> T): T {
        requireLoopRootCaller()
        return runPrepared(block)
    }

    private fun <T> runPrepared(block: suspend CoroutineScope.() -> T): T {
        acceptInstance()
        val native = state.open(this, config)
        val result = LoopResult<T>()
        val loop: EventLoop = this
        context(loop) {
            startDispatchedCoroutine<T>(
                state.executor,
                {
                    coroutineScope<T> {
                        this @PlatformEventLoop.state.bindRoot(job)
                        block(this)
                    }
                },
                LoopCompletion(state, result)
            )
        }
        state.drive(native)
        @Unsafe
        {
            return result.value.assumeInit()
        }
    }

    /** Attaches without running application callbacks on the registration stack. */
    public fun attach(host: EventLoopHost, onClosed: (Throwable?) -> Unit): EventLoopSession {
        if (!host.isCurrentThread())
            throw IllegalStateException(Some("attach requires the host owner thread"))
        acceptStart()
        val native = state.open(this, config)
        val mailbox = LoopMailbox(state)
        val loop: EventLoop = this
        context(loop) {
            startDispatchedCoroutine<Unit>(
                state.executor,
                {
                    coroutineScope<Unit> {
                        val scope = this
                        mailbox.run(scope)
                    }
                },
                SessionCompletion(mailbox)
            )
        }
        try {
            LoopAttachment(state, native, mailbox, onClosed).install(host)
        } catch (error: Throwable) {
            mailbox.requestClose()
            try {
                state.drive(native)
            }
            catch (cleanup: Throwable) {
                throw ResourceUseException(error, cleanup)
            }
            throw error
        }
        return EventLoopSession(loop, mailbox)
    }

    private fun acceptStart() {
        requireLoopRootCaller()
        acceptInstance()
    }

    private fun acceptInstance() {
        if (!accepted.compareAndSet(false, true))
            throw IllegalStateException(Some("event loop already used"))
    }

    /**
     * Suspends for a nonnegative duration and follows current-job cancellation.
     */
    public override suspend fun sleep(duration: Duration) {
        sleepOnLoop(state, duration)
    }

    /** Registers a cancellable ordinary timer notification on this loop's owner. */
    public override fun schedule(duration: Duration, completion: (Throwable?) -> Unit): Disposable =
        scheduleOnLoop(state, duration, completion)

    /**
     * Resolves the host and port, optionally restricted to one address family.
     */
    public override suspend fun resolve(host: OsString, port: Int, family: AddressFamily?): Array<
        SocketAddress
    > = resolveOnLoop(state, host, port, family)

    /**
     * Opens an owned asynchronous file using explicit access, creation, and truncation options.
     */
    public override suspend fun openFile(path: Path, options: OpenOptions): AsyncFile =
        openFileOnLoop(state, path, options)
    /**
     * Opens an owned asynchronous terminal handle.
     */
    public override suspend fun openTty(): AsyncTty = openTtyOnLoop(state)

    /**
     * Queries filesystem metadata, optionally following symbolic links.
     */
    public override suspend fun metadata(path: Path, followLinks: Boolean): FileMetadata =
        metadataOnLoop(state, path, followLinks)

    /**
     * Moves a filesystem entry, replacing the destination only when requested.
     */
    public override suspend fun moveFile(
        source: Path,
        destination: Path,
        replaceExisting: Boolean
    ) {
        moveFileOnLoop(state, source, destination, replaceExisting)
    }
    /**
     * Deletes the selected filesystem entry.
     */
    public override suspend fun deleteFile(path: Path) {
        deleteFileOnLoop(state, path)
    }
    /**
     * Creates missing parent directories with the requested mode, subject to the process umask.
     */
    public override suspend fun createDirectories(path: Path, mode: Int) {
        createDirectoriesOnLoop(state, path, mode)
    }
    /**
     * Creates a unique temporary file and returns both its path and open handle.
     */
    public override suspend fun createTempFile(parent: Path?, prefix: String): TemporaryFile =
        createTemporaryFileOnLoop(state, parent, prefix)
    /**
     * Opens an owned directory enumeration cursor.
     */
    public override suspend fun openDirectory(path: Path): AsyncDirectoryEntries =
        openDirectoryOnLoop(state, path)

    /**
     * Connects to an IP endpoint, or resolves and races candidates using the supplied host
     * connection options. The returned stream has independent ownership.
     */
    public override suspend fun connectTcp(address: SocketAddress): AsyncTcpStream =
        connectTcpOnLoop(state, address)
    /**
     * Connects to an IP endpoint, or resolves and races candidates using the supplied host
     * connection options. The returned stream has independent ownership.
     */
    public override suspend fun connectTcp(
        host: OsString,
        port: Int,
        options: TcpConnectOptions
    ): AsyncTcpStream = connectTcpHostOnLoop(state, host, port, options)
    /**
     * Binds and listens for TCP connections with the requested backlog and address-reuse setting.
     */
    public override suspend fun listenTcp(
        address: SocketAddress,
        backlog: Int,
        reuseAddress: Boolean
    ): AsyncTcpListener = listenTcpOnLoop(state, address, backlog, reuseAddress)

    /**
     * Binds an owned UDP socket, optionally enabling address reuse.
     */
    public override suspend fun bindUdp(
        address: SocketAddress,
        reuseAddress: Boolean
    ): AsyncUdpSocket = bindUdpOnLoop(state, address, reuseAddress)
}

private class LoopResult<T> {
    var value: MaybeUninit<T> = MaybeUninit<T>.uninit()
}

private class LoopCompletion<T>(
    val state: LoopOwner,
    private val result: LoopResult<T>
): Continuation<T> {
    public override fun resume(value: T) {
        result.value = MaybeUninit<T>.initialized(value)
        state.finishRoot(None)
    }
    public override fun resumeWithException(exception: Throwable) {
        state.finishRoot(Some(exception))
    }
}
