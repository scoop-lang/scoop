package scoop.asyncio

import scoop.concurrent.BlockingTaskPool
import scoop.concurrent.multiThreadExecutor

/** Runs coroutines and I/O on the same managed workers, sharing one logical event loop. */
public class AsyncRuntime internal constructor(private val config: AsyncRuntimeConfig) {
    private val accepted = AtomicBoolean(false)

    /** Returns the root result after tasks, I/O resources and both worker groups have closed. */
    public fun <T> run(block: suspend CoroutineScope.() -> T): T {
        requireLoopRootCaller()
        if (!accepted.compareAndSet(false, true))
            throw IllegalStateException(Some("async runtime already used"))
        val result = RuntimeResult<T>()
        val configuration = config
        BlockingTaskPool(configuration.blockingThreads).use {
            pool -> RuntimeEventLoop.create(configuration.workers, pool).use {
                runtime -> multiThreadExecutor {
                    workers = configuration.workers
                    blocking(pool)
                    drivers(runtime.drivers)
                }.use {
                    executor ->
                    runtime.bindExecutor(executor)
                    val loop: EventLoop = runtime
                    context(loop) {
                        startDispatchedCoroutine<T>(
                            executor,
                            {
                                coroutineScope<T> {
                                    runtime.bindRoot(job)
                                    block(this)
                                }
                            },
                            result
                        )
                    }
                    result.await()
                    runtime.rootFailure = result.failure
                }
            }
        }
        @Unsafe
        {
            return result.value.assumeInit()
        }
    }
}
