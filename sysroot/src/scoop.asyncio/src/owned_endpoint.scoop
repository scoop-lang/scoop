package scoop.asyncio

internal enum EndpointKind {
    Tcp, Udp, Tty
}

private const val ENDPOINT_CLOSING: Int = 1

private const val ENDPOINT_CLOSED: Int = 2

private const val ENDPOINT_PHASE: Int = 3

private const val ENDPOINT_INPUT: Int = 4

private const val ENDPOINT_OUTPUT: Int = 8

private const val ENDPOINT_ENDED: Int = 16

internal interface LoopResource {
    public fun closeFromLoop()
}

internal class OwnedEndpoint(
    val loop: LoopOwner,
    val pointer: Ptr<Unit>,
    val kind: EndpointKind
): LoopResource {
    // Generic control operations share attachment fields; byte slots are installed once.
    private val lock = IoLock()
    private val state = AtomicInt(0)
    private var input: LoopOperation? = None
    private var output: LoopOperation? = None
    private var inputTransfer: ByteTransfer? = None
    private var outputTransfer: ByteTransfer? = None
    // Closing callbacks and native state belong exclusively to the loop owner.
    private var nativeClosed: Boolean = false
    private var closeFailure: Throwable? = None
    private var waiters = ArrayList<(Throwable?) -> Unit>()

    val isClosed: Boolean get() =
        (state.load(MemoryOrder.Acquire) and ENDPOINT_PHASE) == ENDPOINT_CLOSED
    val isClosing: Boolean get() = (state.load(MemoryOrder.Acquire) and ENDPOINT_PHASE) != 0

    fun installTransfers(input: ByteTransfer?, output: ByteTransfer?) {
        inputTransfer = input
        outputTransfer = output
    }

    fun acquireDirection(writing: Boolean) {
        val bit =
            if (writing)
                ENDPOINT_OUTPUT
            else
                ENDPOINT_INPUT
        var previous = state.load(MemoryOrder.Acquire)
        while (true) {
            if ((previous and ENDPOINT_PHASE) != 0)
                throw IoClosedException()
            if ((previous and bit) != 0)
                throw IllegalStateException(Some("I/O direction is busy"))
            if (writing && (previous and ENDPOINT_ENDED) != 0)
                throw IllegalStateException(Some("TCP output was shut down"))
            val observed =
                state.compareAndExchange(
                    previous,
                    previous or bit,
                    MemoryOrder.AcqRel,
                    MemoryOrder.Acquire
                )
            if (observed == previous)
                return
            previous = observed
        }
    }

    fun reserve(writing: Boolean): EndpointReservation {
        acquireDirection(writing)
        return EndpointReservation(this, writing)
    }

    fun attach(operation: LoopOperation, writing: Boolean) {
        val closing =
            lock.withLock {
                if (writing)
                    output = Some(operation)
                else
                    input = Some(operation)
                isClosing
            }
        if (closing)
            operation.selectFailure(IoClosedException())
    }

    fun releaseDirection(writing: Boolean) {
        lock.withLock {
            if (writing)
                output = None
            else
                input = None
        }
        releaseTransfer(writing)
    }

    fun releaseTransfer(writing: Boolean) {
        val bit =
            if (writing)
                ENDPOINT_OUTPUT
            else
                ENDPOINT_INPUT
        val previous = state.fetchAnd(bit.inv(), MemoryOrder.AcqRel)
        if ((previous and ENDPOINT_PHASE) == ENDPOINT_CLOSING)
            loop.post { finishClose() }
    }

    fun markOutputEnded() {
        state.fetchOr(ENDPOINT_ENDED, MemoryOrder.Release)
    }

    suspend fun close() {
        if (isClosed)
            return
        loop.requireJob(false)
        suspendCoroutine<Unit> {
            continuation -> loop.post {
                closeOnLoop {
                    error -> when (error) {
                        case Some(val value) -> continuation.resumeWithException(value)
                        case None -> continuation.resume(Unit)
                    }
                }
            }
        }
    }

    fun closeOnLoop(waiter: (Throwable?) -> Unit) {
        val previous = state.load(MemoryOrder.Acquire) and ENDPOINT_PHASE
        if (previous == 0)
            state.fetchOr(ENDPOINT_CLOSING, MemoryOrder.AcqRel)
        if (previous == ENDPOINT_CLOSED) {
            loop.enqueueReady { waiter(None) }
            return
        }
        waiters.add(waiter)
        if (previous == ENDPOINT_CLOSING)
            return
        inputTransfer?.selectFailure(IoClosedException())
        outputTransfer?.selectFailure(IoClosedException())
        val active = lock.withLock { (input, output) }
        when (active._1) {
            case Some(val operation) -> operation.selectFailure(IoClosedException());
            case None -> {}
        }
        when (active._2) {
            case Some(val operation) -> operation.selectFailure(IoClosedException());
            case None -> {}
        }
        val closing =
            CallbackOperation(
                loop,
                loop.nextOperation(),
                {
                    _,
                    id -> @Unsafe
                    {
                        return@CallbackOperation nativeStatus(
                            id,
                            when (kind) {
                                case Tcp -> nativeTcpClose(pointer, id)
                                case Udp -> nativeUdpClose(pointer, id)
                                case Tty -> nativeTtyClose(pointer, id)
                            }
                        )
                    }
                },
                { _, _ -> },
                {
                    event, selected ->
                    nativeClosed = true
                    closeFailure = completionFailure("I/O endpoint close", event.result, selected)
                    finishClose()
                }
            )
        loop.submit(closing)
    }

    private fun finishClose() {
        val current = state.load(MemoryOrder.Acquire)
        if (
            (current and ENDPOINT_PHASE) !=
                ENDPOINT_CLOSING ||
                !nativeClosed ||
                (current and (ENDPOINT_INPUT or ENDPOINT_OUTPUT)) !=
                0
        )
            return
        inputTransfer?.closeSlot()
        outputTransfer?.closeSlot()
        state.store(ENDPOINT_CLOSED, MemoryOrder.Release)
        val callbacks = waiters
        waiters = ArrayList<(Throwable?) -> Unit>()
        loop.forget(this)
        for (callback in callbacks)
            loop.enqueueReady { callback(closeFailure) }
    }

    public override fun closeFromLoop() {
        closeOnLoop {
            error -> when (error) {
                case Some(val value) -> loop.cleanupFailed(value);
                case None -> {}
            }
        }
    }
}

internal class EndpointReservation(
    private val owner: OwnedEndpoint,
    private val writing: Boolean
): Disposable {
    private val released: AtomicBoolean = AtomicBoolean(false)
    public override fun dispose() {
        if (released.compareAndSet(false, true))
            owner.releaseDirection(writing)
    }
}
