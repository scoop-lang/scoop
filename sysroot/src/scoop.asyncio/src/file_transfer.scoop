package scoop.asyncio

import scoop.platform.memory.NativeByteBuffer
import scoop.platform.memory.NativeByteBorrow

internal suspend fun transferFile(
    owner: OwnedFile,
    buffer: NativeByteBuffer,
    count: Long,
    writing: Boolean
): Long = suspendCoroutine(prepareFileTransfer(owner, buffer, count, writing))

private fun prepareFileTransfer(
    owner: OwnedFile,
    buffer: NativeByteBuffer,
    count: Long,
    writing: Boolean
): FileTransfer {
    val job = owner.loop.requireJob()
    val reservation = owner.reserve()
    try {
        val borrowed = borrowTransfer(buffer, count, writing)
        try {
            return FileTransfer(owner, borrowed, reservation, job, writing)
        } catch (error: Throwable) {
            @Unsafe
            {
                borrowed.complete(0L)
            }
            throw error
        }
    } catch (error: Throwable) {
        reservation.dispose()
        throw error
    }
}

private class FileTransfer(
    private val owner: OwnedFile,
    borrowed: NativeByteBorrow,
    reservation: FileReservation,
    job: Job,
    writing: Boolean
): ByteTransfer(owner.loop, borrowed, reservation, job, writing) {
    protected override fun attach() {
        owner.attach(this)
    }

    protected override fun start(pointer: Ptr<Unit>): IoStart {
        @Unsafe
        {
            return nativeStatus(
                id,
                nativeFileTransfer(owner.pointer, id, borrowed.pointer(), borrowed.length, writing)
            )
        }
    }

    public override fun cancelNative(pointer: Ptr<Unit>) {
        @Unsafe
        {
            nativeWorkCancel(pointer, id)
        }
    }

    protected override fun failure(result: IoResult, selected: Throwable?): Throwable? =
        completionFailure(
            if (writing)
                "file write"
            else
                "file read",
            result,
            selected,
            Some(owner.context)
        )
}
