package scoop.asyncio

internal class FileTransfer(private val owner: OwnedFile, writing: Boolean): ByteTransfer(
    owner.loop,
    writing
) {
    protected override fun acquire() {
        owner.acquire()
    }
    protected override fun release() {
        owner.releaseTransfer()
    }
    protected override fun closing(): Boolean = owner.isClosing

    protected override fun start(pointer: Ptr<Unit>): IoStart {
        @Unsafe
        {
            return nativeStatus(
                id,
                nativeFileTransfer(owner.pointer, id, borrowed.pointer(), borrowed.length, writing)
            )
        }
    }

    protected override fun cancelRequest(pointer: Ptr<Unit>) {
        @Unsafe
        {
            nativeWorkCancel(pointer, id)
        }
    }

    protected override fun failure(result: IoResult, selected: Throwable?): Throwable? =
        completionFailure(
            if (writing)
                "file write"
            else
                "file read",
            result,
            selected,
            Some(owner.context)
        )
}
