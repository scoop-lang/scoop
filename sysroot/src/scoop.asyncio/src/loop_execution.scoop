package scoop.asyncio

import scoop.concurrent.BlockingTaskPool

internal enum LoopExecutionPlan {
    Owner(LoopBlockingConfig), Runtime(RuntimeWorkers)
}

internal class LoopExecution(
    private val owner: LoopOwner,
    val executor: LoopExecutor,
    val pool: BlockingTaskPool,
    val owned: Boolean,
    private val runtime: RuntimeWorkers?
) {
    private var poolStopping = false
    private val stopsPool =
        owned ||
            when (runtime) {
                case Some(_) -> true
                case None -> false
            }

    val rootExecutor: CoroutineExecutor get() =
        when (runtime) {
            case Some(val workers) -> workers.executor
            case None -> executor
        }

    fun observeTermination() {
        if (stopsPool)
            pool.invokeOnTermination { owner.wakeExecution() }
        when (runtime) {
            case Some(val workers) -> workers.executor.invokeOnTermination {
                owner.post { executor.requestShutdown() }
            }
            case None -> {}
        }
    }

    fun finishRoot() {
        when (runtime) {
            case Some(val workers) -> workers.executor.requestShutdown()
            case None -> executor.requestShutdown()
        }
    }

    // Called only after coroutine registrations, resources and native operations have drained.
    fun stopPoolIfNeeded(): Boolean {
        if (!stopsPool)
            return true
        if (!poolStopping) {
            poolStopping = true
            pool.requestShutdown()
        }
        return pool.isTerminated
    }

    fun joinOwnedPool() {
        if (owned)
            pool.join()
    }
}

internal fun prepareLoopExecution(owner: LoopOwner, plan: LoopExecutionPlan): LoopExecution {
    val selected: (BlockingTaskPool, Boolean, RuntimeWorkers?) =
        when (plan) {
            case Owner(val config) -> when (config) {
                case Owned(val threads) -> (BlockingTaskPool(threads), true, None)
                case Shared(val pool) -> (pool, false, None)
            }
            case Runtime(val workers) -> (workers.pool, false, Some(workers))
        }
    val(pool, owned, runtime) = selected
    try {
        if (pool.isShutdown)
            throw ExecutorClosedException()
        return LoopExecution(owner, LoopExecutor(owner, pool), pool, owned, runtime)
    } catch (error: Throwable) {
        if (owned)
            pool.use { _ -> throw error }
        throw error
    }
}
