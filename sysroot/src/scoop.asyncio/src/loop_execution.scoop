package scoop.asyncio

import scoop.concurrent.BlockingTaskPool

internal class LoopExecution(
    private val owner: LoopOwner,
    val executor: LoopExecutor,
    val pool: BlockingTaskPool,
    val owned: Boolean
) {
    private var poolStopping = false

    fun observeTermination() {
        if (owned)
            pool.invokeOnTermination { owner.wakeExecution() }
    }

    fun finishRoot() {
        executor.requestShutdown()
    }

    fun stopPoolIfNeeded(): Boolean {
        if (!owned)
            return true
        if (!poolStopping) {
            poolStopping = true
            pool.requestShutdown()
        }
        return pool.isTerminated
    }

    fun joinOwnedPool() {
        if (owned)
            pool.join()
    }
}

internal fun prepareLoopExecution(owner: LoopOwner, config: LoopBlockingConfig): LoopExecution {
    val selected: (BlockingTaskPool, Boolean) =
        when (config) {
            case Owned(val threads) -> (BlockingTaskPool(threads), true)
            case Shared(val pool) -> (pool, false)
        }
    val(pool, owned) = selected
    try {
        if (pool.isShutdown)
            throw ExecutorClosedException()
        return LoopExecution(owner, LoopExecutor(owner, pool), pool, owned)
    } catch (error: Throwable) {
        if (owned)
            pool.use { _ -> throw error }
        throw error
    }
}
