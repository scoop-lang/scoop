package scoop.asyncio

// Only the owner thread enters the driver. Nested host notifications schedule another turn.
internal class LoopDriver {
    private var pumping: Boolean = false
    private var pumpAgain: Boolean = false

    fun pump(owner: LoopOwner, native: Ptr<Unit>): Boolean {
        if (pumping) {
            pumpAgain = true;
            return false
        }
        pumping = true
        try {
            val pending = owner.takeCommands()
            owner.poll(native, false)
            @Unsafe
            {
                val completions = nativeLoopTakeBatch(native)
                for (command in pending)
                    command()
                var index = 0L
                while (index < completions.count) {
                    owner.complete(decodeEvent(completions.records.load(index)))
                    index += 1L
                }
            }
            owner.startCleanup()
            val batch = owner.ready
            owner.ready = ArrayList<() -> Unit>()
            for (resume in batch)
                resume()
            owner.startCleanup()
            owner.advanceTimers()
            owner.dispatchBlocking(native)
        } finally {
            pumping = false
            @Unsafe
            {
                nativeLoopRearm(native, pumpAgain || owner.hasQueuedWork())
            }
            pumpAgain = false
        }
        return true
    }

    fun drive(owner: LoopOwner, native: Ptr<Unit>) {
        while (true) {
            pump(owner, native)
            if (owner.stopIfDrained(native))
                break
            if (!owner.hasQueuedWork())
                owner.poll(native, true)
        }
        when (owner.destroy(native)) {
            case Some(val error) -> throw error
            case None -> {}
        }
    }
}
