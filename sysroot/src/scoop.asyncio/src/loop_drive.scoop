package scoop.asyncio

// Only the owner thread enters the driver. Nested host notifications schedule another turn.
internal class LoopDriver {
    private var pumping: Boolean = false
    private var pumpAgain: Boolean = false
    // The owner lends empty storage to each producer and keeps its snapshot for this turn.
    private var commands = ArrayList<LoopWork>()
    private var localCommands = ArrayList<LoopWork>()
    private var ready = ArrayList<LoopWork>()

    fun pump(owner: LoopOwner, native: Ptr<Unit>): Boolean {
        if (pumping) {
            pumpAgain = true;
            return false
        }
        pumping = true
        try {
            commands = owner.takeCommands(commands)
            localCommands = owner.takeLocalCommands(localCommands)
            owner.poll(native, false)
            @Unsafe
            {
                val completions = nativeLoopTakeBatch(native)
                runBatch(commands)
                runBatch(localCommands)
                var index = 0L
                while (index < completions.count) {
                    owner.complete(decodeEvent(completions.records.load(index)))
                    index += 1L
                }
            }
            owner.startCleanup()
            ready = owner.takeReady(ready)
            runBatch(ready)
            owner.startCleanup()
            owner.advanceTimers()
            owner.dispatchBlocking(native)
        } finally {
            owner.flushTransfers()
            commands.clear()
            localCommands.clear()
            ready.clear()
            pumping = false
            @Unsafe
            {
                nativeLoopRearm(native, pumpAgain || owner.hasQueuedWork())
            }
            pumpAgain = false
        }
        return true
    }

    private fun runBatch(batch: ArrayList<LoopWork>) {
        var index = 0L
        while (index < batch.size) {
            batch[index].run()
            index += 1L
        }
    }

    fun drive(owner: LoopOwner, native: Ptr<Unit>) {
        while (true) {
            pump(owner, native)
            if (owner.stopIfDrained(native))
                break
            if (!owner.hasQueuedWork())
                owner.poll(native, true)
        }
        when (owner.destroy(native)) {
            case Some(val error) -> throw error
            case None -> {}
        }
    }
}
