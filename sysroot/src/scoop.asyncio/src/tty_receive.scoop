package scoop.asyncio

import scoop.platform.memory.NativeByteBuffer
import scoop.time.Duration

private class TtyReadProgress {
    var count: Long = 0L
}

internal suspend fun receiveTty(
    tty: TtyEndpoint,
    buffer: NativeByteBuffer,
    count: Long,
    timeout: Duration?
): TtyRead {
    val owner = tty.owner
    val job = owner.loop.requireJob()
    if (timeout != None && timeout!! < Duration.ZERO)
        throw IllegalArgumentException(Some("negative TTY timeout"))
    val reservation = owner.reserve(false)
    try {
        val borrowed = borrowTransfer(buffer, count, false)
        val progress = TtyReadProgress()
        try {
            if (count == 0L)
                return TtyRead.Bytes(0L)
            val pending = tty.pendingResize
            if (pending != None) {
                tty.pendingResize = None
                return pending!!
            }
            return suspendCoroutine<TtyRead> {
                continuation ->
                val operation =
                    CallbackOperation(
                        owner.loop,
                        owner.loop.nextOperation(),
                        {
                            _,
                            id -> @Unsafe
                            {
                                return@CallbackOperation nativeStatus(
                                    id,
                                    nativeTtyReceive(
                                        owner.pointer,
                                        id,
                                        borrowed.pointer(),
                                        count,
                                        if (timeout == None)
                                            -1L
                                        else
                                            timeout!!.floorSeconds,
                                        if (timeout == None)
                                            0
                                        else
                                            timeout!!.nanosecondsOfSecond
                                    )
                                )
                            }
                        },
                        {
                            _,
                            id -> @Unsafe
                            {
                                nativeTtyCancelRead(owner.pointer, id)
                            }
                        },
                        {
                            event, selected ->
                            progress.count = resultProgress(event.result)
                            val failure = completionFailure("TTY receive", event.result, selected)
                            when (failure) {
                                case Some(val error) -> {
                                    when (event.result) {
                                        case IoResult.TtyResize(
                                            val columns,
                                            val rows
                                        ) -> tty.pendingResize = Some(TtyRead.Resize(columns, rows))
                                        case _ -> {}
                                    }
                                    continuation.resumeWithException(error)
                                }
                                case None -> continuation.resume(ttyReadResult(event.result))
                            }
                        }
                    )
                operation.subscribe(job)
                owner.attach(operation, false)
                owner.loop.submit(operation)
            }
        } finally {
            @Unsafe
            {
                borrowed.complete(progress.count)
            }
        }
    } finally {
        reservation.dispose()
    }
}

private fun ttyReadResult(result: IoResult): TtyRead =
    when (result) {
        case Bytes(val count) -> TtyRead.Bytes(count)
        case TtyResize(val columns, val rows) -> TtyRead.Resize(columns, rows)
        case Eof -> TtyRead.End
        case TtyTimeout -> TtyRead.TimedOut
        case _ -> throw IllegalStateException(Some("TTY receive returned no input result"))
    }
