package scoop.asyncio

import scoop.collections.HashMap

internal class LoopOwner(
    private val runtime: RuntimeEventLoop? = None,
    private val worker: Int = -1
) {
    // Root results use this lock; I/O publication has its own parking mutex.
    private val lock: IoLock = IoLock()
    private val inbox = LoopInbox()
    private val localCommands = ArrayList<LoopWork>()
    private val published = AtomicBoolean(false)
    private val running = AtomicBoolean(false)
    // Initialized before publication and retained unchanged through shutdown.
    private var binding: EventLoop? = None
    private val driver: LoopDriver = LoopDriver()
    private var pointer: Ptr<Unit>? = None
    private var execution: LoopExecution? = None
    private val nextId = AtomicLong(1L)
    private var root: Job? = None
    private var backendFailed: Boolean = false
    private val rootEnded = AtomicBoolean(false)
    private var failure: Throwable? = None
    private val operations: HashMap<Long, LoopOperation> = HashMap<Long, LoopOperation>()
    private val resources: ArrayList<LoopResource> = ArrayList<LoopResource>()
    private val timers = LoopTimers(this)
    private var cleaning: Boolean = false
    var ready: ArrayList<LoopWork> = ArrayList<LoopWork>()

    fun open(loop: EventLoop, config: LoopBlockingConfig): Ptr<Unit> {
        val state = prepareLoopExecution(this, config)
        try {
            @Unsafe
            {
                val created = nativeLoopCreate()
                if (created.status.code != 0)
                    throw backendFailure("create event loop", created.status)
                binding = Some(loop)
                pointer = created.pointer
                execution = Some(state)
                inbox.open(created.pointer!!)
                published.store(true, MemoryOrder.Release)
                running.store(true, MemoryOrder.Release)
                state.observeTermination()
                return created.pointer!!
            }
        } catch (error: Throwable) {
            if (state.owned)
                state.pool.use { _ -> throw error }
            throw error
        }
    }

    private fun currentExecution(): LoopExecution {
        if (!published.load(MemoryOrder.Acquire))
            throw IllegalStateException(Some("event loop is not running"))
        return execution!!
    }

    val executor: LoopExecutor get() = currentExecution().executor
    fun connectionOwner(): LoopOwner =
        when (runtime) {
            case Some(val runtime) -> runtime.nextOwner()
            case None -> this
        }

    fun nativePointer(): Ptr<Unit> {
        if (!running.load(MemoryOrder.Acquire))
            throw IllegalStateException(Some("event loop is not running"))
        return pointer!!
    }

    fun dispatchBlocking(native: Ptr<Unit>) {
        dispatchNativeWork(native, currentExecution().pool)
    }

    fun activeExecutor(): CoroutineExecutor {
        if (!running.load(MemoryOrder.Acquire))
            throw IllegalStateException(Some("event loop is not running"))
        val state = currentExecution()
        if (state.executor.isTerminated)
            throw IllegalStateException(Some("event loop executor has terminated"))
        return state.executor
    }

    fun wakeExecution() {
        inbox.wake()
    }

    fun enqueueExecution(command: () -> Unit) {
        inbox.post(LoopWork.Callback(command), true)
    }

    fun requireJob(cancellable: Boolean = true): Job {
        if (!running.load(MemoryOrder.Acquire))
            throw IllegalStateException(Some("event loop is not running"))
        val expected = binding!!
        if (!hasEventLoop() || currentEventLoop() !== expected)
            throw IllegalStateException(Some("wrong event loop"))
        val job = currentJobOrNone() ?: throw IllegalStateException(Some("I/O requires a Job"))
        if (job.isCompleted)
            throw IllegalStateException(Some("I/O requires an active Job"))
        if (cancellable)
            job.ensureActive()
        return job
    }

    fun post(command: () -> Unit) {
        postWork(LoopWork.Callback(command))
    }

    private fun postWork(command: LoopWork) {
        when (runtime) {
            case Some(val runtime) -> if (
                runtime.isCurrentWorker(worker) && running.load(MemoryOrder.Acquire)
            ) {
                localCommands.add(command)
                return
            }
            case None -> {}
        }
        inbox.post(command)
    }

    fun nextOperation(): Long {
        if (!running.load(MemoryOrder.Acquire))
            throw IllegalStateException(Some("event loop is not running"))
        var id = nextId.load(MemoryOrder.Relaxed)
        while (true) {
            if (id == Long.MAX_VALUE)
                throw ArithmeticException()
            if (nextId.compareAndSet(id, id + 1L, MemoryOrder.Relaxed, MemoryOrder.Relaxed))
                return id
            id = nextId.load(MemoryOrder.Relaxed)
        }
    }

    fun submit(operation: LoopOperation) {
        postWork(LoopWork.Operation(operation))
    }

    fun beginOperation(operation: LoopOperation) {
        operations.put(operation.id, operation)
        operation.begin(pointer!!)
        dispatchBlocking(pointer!!)
    }

    fun enqueueReady(action: () -> Unit) {
        ready.add(LoopWork.Callback(action))
    }

    fun scheduleTimer(timer: LoopTimer) {
        post { timers.add(timer) }
    }

    fun cancelTimer(timer: LoopTimer) {
        post { timers.cancel(timer) }
    }

    fun advanceTimers() {
        timers.advance()
    }

    fun cancel(id: Long) {
        when (operations[id]) {
            case Some(val operation) -> operation.cancelNative(pointer!!)
            case None -> {}
        }
    }

    fun complete(event: NativeEvent) {
        val operation = operations.remove(event.id)!!
        operation.complete(event)
    }

    fun retain(resource: LoopResource) {
        resources.add(resource)
        if (cleaning)
            resource.closeFromLoop()
    }

    fun forget(resource: LoopResource) {
        var index = 0L
        while (index < resources.size) {
            if (resources[index] === resource) {
                resources.removeAt(index);
                return
            }
            index += 1L
        }
    }

    fun cleanupFailed(error: Throwable) {
        lock.withLock {
            failure =
                Some(
                    when (failure) {
                        case Some(val primary) -> ResourceUseException(primary, error)
                        case None -> error
                    }
                )
        }
    }

    fun startCleanup() {
        if (cleaning || !rootEnded.load(MemoryOrder.Acquire) || !executor.isTerminated)
            return
        cleaning = true
        timers.close()
        val owned = Array<LoopResource>(resources.size) { index -> resources[index] }
        for (resource in owned)
            resource.closeFromLoop()
    }

    fun bindRoot(job: Job) {
        val failed =
            lock.withLock {
                root = Some(job)
                backendFailed
            }
        if (failed)
            job.cancel()
    }

    fun poll(native: Ptr<Unit>, wait: Boolean) {
        @Unsafe
        {
            val status = nativeLoopPoll(native, wait)
            if (status.code != 0) {
                val failed =
                    lock.withLock {
                        if (backendFailed)
                            false
                        else {
                            backendFailed = true;
                            true
                        }
                    }
                if (failed) {
                    cleanupFailed(backendFailure("drive event loop", status))
                    val job = lock.withLock { root }
                    job?.cancel()
                }
            }
        }
    }

    fun finishRoot(error: Throwable?) {
        lock.withLock {
            when (failure) {
                case None -> failure = error
                case Some(val primary) -> when (error) {
                    case Some(val next) -> if (!(next is CancellationException))
                        failure = Some(ResourceUseException(primary, next))
                    case None -> {}
                }
            }
            root = None
            rootEnded.store(true, MemoryOrder.Release)
        }
        currentExecution().finishRoot()
        inbox.wake()
    }

    fun takeCommands(): ArrayList<LoopWork> {
        val batch = inbox.take()
        for (command in localCommands)
            batch.add(command)
        localCommands.clear()
        return batch
    }

    fun cancelRoot() {
        val job = lock.withLock { root }
        job?.cancel()
    }

    fun hasQueuedWork(): Boolean =
        localCommands.size != 0L || inbox.hasCommands() || ready.size != 0L

    private fun managedIdle(): Boolean =
        rootEnded.load(MemoryOrder.Acquire) &&
            executor.isTerminated &&
            localCommands.size ==
            0L &&
            !inbox.hasCommands() &&
            ready.size ==
            0L &&
            operations.size ==
            0L &&
            timers.isEmpty &&
            resources.size ==
            0L

    fun stopIfDrained(native: Ptr<Unit>): Boolean {
        if (!managedIdle())
            return false
        @Unsafe
        {
            if (!nativeLoopIdle(native))
                return false
        }
        val state = currentExecution()
        if (!state.stopPoolIfNeeded())
            return false
        if (!managedIdle() || !inbox.closeIfEmpty())
            return false
        running.store(false, MemoryOrder.Release)
        pointer = None
        return true
    }

    fun destroy(native: Ptr<Unit>): Throwable? {
        @Unsafe
        {
            val status = nativeLoopDestroy(native)
            if (status.code != 0)
                cleanupFailed(backendFailure("close event loop", status))
        }
        val state = currentExecution()
        try {
            state.joinOwnedPool()
        }
        catch (error: Throwable) {
            cleanupFailed(error)
        }
        return lock.withLock { failure }
    }

    fun pump(native: Ptr<Unit>): Boolean = driver.pump(this, native)
    fun drive(native: Ptr<Unit>) {
        driver.drive(this, native)
    }
}
