package scoop.asyncio

import scoop.platform.system.OsString

private const val FILE_CLOSING: Int = 1

private const val FILE_CLOSED: Int = 2

private const val FILE_PHASE: Int = 3

private const val FILE_BUSY: Int = 4

internal class OwnedFile(
    val loop: LoopOwner,
    val pointer: Ptr<Unit>,
    val context: OsString
): LoopResource {
    private val lock = IoLock()
    private val state = AtomicInt(0)
    private var active: LoopOperation? = None
    private var inputTransfer: ByteTransfer? = None
    private var outputTransfer: ByteTransfer? = None
    private var closing: Boolean = false
    private var waiters = ArrayList<(Throwable?) -> Unit>()

    val isClosed: Boolean get() = (state.load(MemoryOrder.Acquire) and FILE_PHASE) == FILE_CLOSED
    val isClosing: Boolean get() = (state.load(MemoryOrder.Acquire) and FILE_PHASE) != 0

    fun installTransfers(input: ByteTransfer, output: ByteTransfer) {
        inputTransfer = Some(input)
        outputTransfer = Some(output)
    }

    fun acquire() {
        val previous =
            state.compareAndExchange(0, FILE_BUSY, MemoryOrder.AcqRel, MemoryOrder.Acquire)
        if ((previous and FILE_PHASE) != 0)
            throw IoClosedException()
        if ((previous and FILE_BUSY) != 0)
            throw IllegalStateException(Some("file operation is active"))
    }

    fun reserve(): FileReservation {
        acquire()
        return FileReservation(this)
    }

    fun attach(operation: LoopOperation) {
        val stopped =
            lock.withLock {
                active = Some(operation);
                isClosing
            }
        if (stopped)
            operation.selectFailure(IoClosedException())
    }

    fun releaseOperation() {
        lock.withLock { active = None }
        releaseTransfer()
    }

    fun releaseTransfer() {
        val previous = state.fetchAnd(FILE_BUSY.inv(), MemoryOrder.AcqRel)
        if ((previous and FILE_PHASE) == FILE_CLOSING)
            loop.post { closeWhenIdle() }
    }

    suspend fun close() {
        if (isClosed)
            return
        loop.requireJob(false)
        suspendCoroutine<Unit> {
            continuation -> loop.post { closeOnLoop { error -> finishUnit(continuation, error) } }
        }
    }

    fun closeOnLoop(waiter: (Throwable?) -> Unit) {
        val previous = state.load(MemoryOrder.Acquire) and FILE_PHASE
        if (previous == FILE_CLOSED) {
            loop.enqueueReady { waiter(None) }
            return
        }
        waiters.add(waiter)
        if (previous == FILE_CLOSING)
            return
        state.fetchOr(FILE_CLOSING, MemoryOrder.AcqRel)
        inputTransfer?.requestFailure(IoClosedException())
        outputTransfer?.requestFailure(IoClosedException())
        val operation = lock.withLock { active }
        when (operation) {
            case Some(val value) -> value.requestFailure(IoClosedException());
            case None -> {}
        }
        closeWhenIdle()
    }

    private fun closeWhenIdle() {
        if (state.load(MemoryOrder.Acquire) != FILE_CLOSING || closing)
            return
        closing = true
        val operation =
            CallbackOperation(
                loop,
                loop.nextOperation(),
                {
                    _,
                    id -> @Unsafe
                    {
                        return@CallbackOperation nativeStatus(id, nativeFileClose(pointer, id))
                    }
                },
                { _, _ -> },
                {
                    event, selected ->
                    val error =
                        completionFailure("file close", event.result, selected, Some(context))
                    inputTransfer?.closeSlot()
                    outputTransfer?.closeSlot()
                    state.store(FILE_CLOSED, MemoryOrder.Release)
                    val callbacks = waiters
                    waiters = ArrayList<(Throwable?) -> Unit>()
                    loop.forget(this)
                    for (callback in callbacks)
                        loop.enqueueReady { callback(error) }
                }
            )
        loop.submit(operation)
    }

    public override fun closeFromLoop() {
        closeOnLoop {
            error -> when (error) {
                case Some(val value) -> loop.cleanupFailed(value);
                case None -> {}
            }
        }
    }
}

internal class FileReservation(private val owner: OwnedFile): Disposable {
    private val released: AtomicBoolean = AtomicBoolean(false)
    public override fun dispose() {
        if (released.compareAndSet(false, true))
            owner.releaseOperation()
    }
}
