package scoop.asyncio

import scoop.platform.memory.NativeByteBuffer
import scoop.platform.memory.NativeByteBorrow

internal suspend fun transferTcp(
    owner: OwnedEndpoint,
    buffer: NativeByteBuffer,
    count: Long,
    writing: Boolean
): Long = suspendCoroutine(prepareTcpTransfer(owner, buffer, count, writing))

private fun prepareTcpTransfer(
    owner: OwnedEndpoint,
    buffer: NativeByteBuffer,
    count: Long,
    writing: Boolean
): TcpTransfer {
    val job = owner.loop.requireJob()
    val reservation = owner.reserve(writing)
    try {
        val borrowed = borrowTransfer(buffer, count, writing)
        try {
            return TcpTransfer(owner, borrowed, reservation, job, writing)
        } catch (error: Throwable) {
            @Unsafe
            {
                borrowed.complete(0L)
            }
            throw error
        }
    } catch (error: Throwable) {
        reservation.dispose()
        throw error
    }
}

private class TcpTransfer(
    private val owner: OwnedEndpoint,
    borrowed: NativeByteBorrow,
    reservation: EndpointReservation,
    job: Job,
    writing: Boolean
): ByteTransfer(owner.loop, borrowed, reservation, job, writing) {
    protected override fun attach() {
        owner.attach(this, writing)
    }

    protected override fun start(pointer: Ptr<Unit>): IoStart {
        @Unsafe
        {
            val status =
                if (writing)
                    nativeTcpWrite(owner.pointer, id, borrowed.pointer(), borrowed.length)
                else
                    nativeTcpRead(owner.pointer, id, borrowed.pointer(), borrowed.length)
            return nativeStatus(id, status)
        }
    }

    public override fun cancelNative(pointer: Ptr<Unit>) {
        @Unsafe
        {
            if (writing)
                nativeTcpWriteCancel(owner.pointer, id)
            else
                nativeTcpReadCancel(owner.pointer, id)
        }
    }

    protected override fun failure(result: IoResult, selected: Throwable?): Throwable? =
        completionFailure(
            if (writing)
                "TCP write"
            else
                "TCP read",
            result,
            selected
        )
}
