package scoop.asyncio

internal class TcpTransfer(private val owner: OwnedEndpoint, writing: Boolean): ByteTransfer(
    owner.loop,
    writing
) {
    protected override fun acquire() {
        owner.acquireDirection(writing)
    }
    protected override fun release() {
        owner.releaseTransfer(writing)
    }
    protected override fun closing(): Boolean = owner.isClosing

    protected override fun start(pointer: Ptr<Unit>): IoStart {
        @Unsafe
        {
            val status =
                if (writing)
                    nativeTcpWrite(owner.pointer, id, borrowed.pointer(), borrowed.length)
                else
                    nativeTcpRead(owner.pointer, id, borrowed.pointer(), borrowed.length)
            return nativeStatus(id, status)
        }
    }

    protected override fun cancelRequest(pointer: Ptr<Unit>) {
        @Unsafe
        {
            if (writing)
                nativeTcpWriteCancel(owner.pointer, id)
            else
                nativeTcpReadCancel(owner.pointer, id)
        }
    }

    protected override fun failure(result: IoResult, selected: Throwable?): Throwable? =
        completionFailure(
            if (writing)
                "TCP write"
            else
                "TCP read",
            result,
            selected
        )
}
