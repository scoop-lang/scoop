package scoop.asyncio

internal class TcpTransfer(private val owner: OwnedEndpoint, writing: Boolean) :
    ByteTransfer(
        owner.loop,
        writing
    ) {
    protected override fun acquire() {
        owner.acquireDirection(writing)
    }
    protected override fun release() {
        owner.releaseTransfer(writing)
    }
    protected override fun closing(): Boolean = owner.isClosing

    protected override fun start(pointer: Ptr<Unit>): IoStart {
        @Unsafe
        {
            loop.submitTcp(owner.pointer, id, borrowed.pointer(), borrowed.length, writing)
            return IoStart.Pending
        }
    }

    protected override fun cancelRequest(pointer: Ptr<Unit>) {
        @Unsafe
        {
            if (writing)
                nativeTcpWriteCancel(owner.pointer, id)
            else
                nativeTcpReadCancel(owner.pointer, id)
        }
    }

    protected override fun failure(result: IoResult, selected: Throwable?): Throwable? =
        completionFailure(
            if (writing) "TCP write" else "TCP read",
            result,
            selected
        )
}

internal fun LoopOwner.submitTcp(
    endpoint: Ptr<Unit>,
    id: Long,
    bytes: Ptr<Byte>?,
    count: Long,
    writing: Boolean
) {
    @Unsafe
    {
        while (!nativeTcpEnqueue(nativePointer(), endpoint, id, bytes, count, writing))
            flushTransfers()
    }
    pendingTransfers = Some(flushTcpBatch)
}

private val flushTcpBatch: (LoopOwner) -> Unit = { loop ->
    @Unsafe
    {
        val completed = nativeTcpFlush(loop.nativePointer())
        var index = 0L
        while (index < completed.count) {
            loop.complete(decodeEvent(completed.records.load(index)))
            index += 1L
        }
    }
}
