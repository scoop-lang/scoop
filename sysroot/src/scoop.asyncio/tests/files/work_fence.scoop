package scoop.asyncio

// These gates exist only in the test dependency. The real work queue and file
// syscalls still run; the gates make queued/running cancellation deterministic.
internal class WorkFence(private val loop: PlatformEventLoop) {
    private var pointer: Ptr<Unit>? = None
    private var completed: Boolean = false
    private var waiter: Continuation<Unit>? = None

    suspend fun start(spare: UInt = 0u, cancelAfterPriorWork: Job? = None) {
        when (cancelAfterPriorWork) {
            // Let the earlier dispatched task submit its work before this fence.
            case Some(_) -> yieldCoroutine()
            case None -> {}
        }
        suspendCoroutine<Unit> {
            continuation ->
            val operation =
                CallbackOperation(
                    loop.state,
                    loop.state.nextOperation(),
                    {
                        native,
                        id -> @Unsafe
                        {
                            val result = createFence(native, id, testPoolSize(), spare)
                            if (result.status.code != 0)
                                return@CallbackOperation nativeStatus(id, result.status)
                            pointer = result.pointer
                            loop.state.post {
                                when (cancelAfterPriorWork) {
                                    case Some(val job) -> {
                                        // The prior turn submitted all gates to the managed pool.
                                        @Unsafe
                                        {
                                            waitFence(pointer!!)
                                        }
                                        job.cancel()
                                    }
                                    case None -> {}
                                }
                                loop.state.enqueueReady { continuation.resume(Unit) }
                            }
                            return@CallbackOperation IoStart.Pending
                        }
                    },
                    { _, _ -> },
                    {
                        event,
                        _ -> when (resultFailure("test worker fence", event.result)) {
                            case Some(val error) -> continuation.resumeWithException(error)
                            case None -> {
                                pointer = None
                                completed = true
                                when (waiter) {
                                    case Some(val value) -> value.resume(Unit);
                                    case None -> {}
                                }
                                waiter = None
                            }
                        }
                    }
                )
            loop.state.submit(operation)
        }
    }

    fun waitStarted() {
        @Unsafe
        {
            waitFence(pointer!!)
        }
    }

    suspend fun close() {
        if (completed)
            return
        @Unsafe
        {
            releaseFence(pointer!!)
        }
        suspendCoroutine<Unit> {
            continuation -> if (completed)
                continuation.resume(Unit)
            else
                waiter = Some(continuation)
        }
    }
}

@Extern(name = "scoop_test_fence_create")
private fun createFence(loop: Ptr<Unit>, id: Long, pool: UInt, spare: UInt): NativeCreated

@Extern(name = "scoop_test_fence_wait")
private fun waitFence(fence: Ptr<Unit>)

@Extern(name = "scoop_test_fence_release")
private fun releaseFence(fence: Ptr<Unit>)

// These tests use the default four-thread managed pool.
internal fun testPoolSize(): UInt = 4u
