package scoop.asyncio

import scoop.concurrent.*
import scoop.platform.concurrent.*
import scoop.test.*
import scoop.time.Duration

private class RuntimeBuilderSnapshot {
    var builder: AsyncRuntimeBuilder? = None
}

private class RuntimeThread {
    var value: Thread? = None
}

@Test
private class AsyncRuntimeLifecycleTest {
    @Test
    fun `builder captures one snapshot and rejected nested startup does not consume it`() {
        assertFailsWith<IllegalArgumentException> { asyncRuntime { workers = 0 } }
        assertFailsWith<IllegalArgumentException> { asyncRuntime { blocking { threads = 0 } } }
        val saved = RuntimeBuilderSnapshot()
        val configurations = AtomicInt(0)
        val runtime =
            asyncRuntime {
                configurations.fetchAdd(1)
                workers = 1
                blocking { threads = 1 }
                saved.builder = Some(this)
            }
        saved.builder!!.workers = 0
        saved.builder!!.blocking { threads = 0 }
        eventLoop { blocking { threads = 1 } }.run {
            assertFailsWith<IllegalStateException> { runtime.run {} }
        }
        assertEquals(42, runtime.run { 42 })
        assertEquals(1, configurations.load())
        assertFailsWith<IllegalStateException> { runtime.run {} }
    }

    @Test
    fun `independent runtime registrations drain before reactors and the shared pool close`() {
        val owner = currentThreadId()
        val resumed = RuntimeThread()
        val workerResult = LoopThreadResult<Unit>()
        val ownerResult = LoopThreadResult<Unit>()
        val finished = LoopThreadResult<Unit>()
        val seen = AtomicInt(0)
        val workers =
            asyncRuntime {
                workers = 1
                blocking { threads = 1 }
            }.run {
                val loop = currentEventLoop()
                val executor = currentCoroutineExecutorOrNone()!! as MultiThreadExecutor
                val workerReady = Channel<Continuation<Unit>>(1L)
                val ownerReady = Channel<Continuation<Unit>>(1L)
                startDispatchedCoroutine(
                    executor,
                    {
                        suspendCoroutine<Unit> {
                            assertEquals(TrySendResult.Sent, workerReady.trySend(it))
                        }
                        nonCancellableScope {
                            withExecutor(loop.executor) {
                                assertNotEquals(owner, currentThreadId())
                                loop.sleep(Duration.nanoseconds(1L))
                                assertEquals(42, blocking { 42 })
                                seen.fetchAdd(1)
                            }
                        }
                    },
                    workerResult
                )
                startDispatchedCoroutine(
                    loop.executor,
                    {
                        suspendCoroutine<Unit> {
                            assertEquals(TrySendResult.Sent, ownerReady.trySend(it))
                        }
                        nonCancellableScope {
                            assertNotEquals(owner, currentThreadId())
                            assertEquals(
                                7,
                                blocking {
                                    gcCollect();
                                    7
                                }
                            )
                            seen.fetchAdd(1)
                        }
                    },
                    ownerResult
                )
                val workerContinuation = workerReady.receive()
                val ownerContinuation = ownerReady.receive()
                executor.invokeOnTermination { finished.resume(Unit) }
                resumed.value =
                    Some(
                        Thread.start {
                            while (!executor.isShutdown)
                                yield()
                            workerContinuation.resume(Unit)
                            ownerContinuation.resume(Unit)
                            finished.await()
                        }
                    )
                executor
            }
        resumed.value!!.join()
        workerResult.await()
        ownerResult.await()
        assertEquals(2, seen.load())
        assertTrue(workers.isTerminated)
        assertFailsWith<ExecutorClosedException> { workers.registerTask(None) }
    }
}
