package scoop.tests.window.frame

import scoop.window.*
import scoop.window.native.*

internal fun frameBackend(): WindowBackend {
    @Unsafe
    {
        return WindowBackend.Win32
    }
}

internal fun nativeFrameQuery(
    target: Window,
    field: Int,
    x: Double = 0.0,
    y: Double = 0.0
): Double {
    @Unsafe
    {
        return target.acquireNativeWindow().use {
            lease -> @Unsafe
            {
                when (lease.handle) {
                    case Win32(window, _) -> return@use frameQuery(window, window, field, x, y)
                }
            }
        }
    }
}

@Extern(name = "scoop_test_frame_query")
private fun frameQuery(window: Ptr<Unit>, view: Ptr<Unit>, field: Int, x: Double, y: Double): Double
