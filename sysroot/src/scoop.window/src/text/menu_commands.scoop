package scoop.window

/** Availability of standard menu edits, independent of an IME connection. */
public struct TextCommandAvailability(
    val cut: Boolean = false,
    val copy: Boolean = false,
    val paste: Boolean = false,
    val selectAll: Boolean = false,
    val undo: Boolean = false,
    val redo: Boolean = false,
    val deleteSelection: Boolean = false
)

public var Window.textCommandAvailability: TextCommandAvailability?
    get() {
        owner.requireOpen()
        return owner.textCommands
    }
    set(value) {
        owner.requireOpen()
        if (owner.textCommands == value) return
        val flags = when (value) {
            case None -> 0
            case Some(val commands) ->
                128 +
                    flag(commands.cut) +
                    flag(commands.copy) *
                    2 +
                    flag(commands.paste) *
                    4 +
                    flag(commands.selectAll) *
                    8 +
                    flag(commands.undo) *
                    16 +
                    flag(commands.redo) *
                    32 +
                    flag(commands.deleteSelection) *
                    64
        }
        @Unsafe
        {
            nativeTextCommands(owner.pointer!!, flags)
        }
        owner.textCommands = value
    }

@Extern(name = "scoop_window_text_commands")
@Unsafe
internal fun nativeTextCommands(window: Ptr<Unit>, flags: Int)

internal fun menuTextCommand(code: Int): TextEditCommand = when (code) {
    4 -> TextEditCommand.Cut
    5 -> TextEditCommand.Copy
    6 -> TextEditCommand.Paste
    7 -> TextEditCommand.SelectAll
    8 -> TextEditCommand.Undo
    9 -> TextEditCommand.Redo
    10 -> TextEditCommand.DeleteSelection
    else -> throw WindowException("native menu editing command", WindowErrorKind.NativeFailure)
}
