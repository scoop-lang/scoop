package scoop.window

/** A half-open UTF-8 byte range. Operations validate bounds and character boundaries. */
public struct Utf8Range(val start: Long, val end: Long)

/** Selection endpoints preserve the anchor and active cursor direction. */
public struct Utf8Selection(val anchor: Long, val cursor: Long) {
    public val range: Utf8Range get() =
        if (anchor <= cursor)
            Utf8Range(anchor, cursor)
        else
            Utf8Range(cursor, anchor)
}

/** Replacement coordinates refer to the temporary text after preceding batch operations. */
public enum TextReplacement {
    CurrentSelection, Range(Utf8Range)
}

/** One ordered edit within a native input transaction. */
public enum TextInputOperation {
    ClearPreedit,
    Preedit(val text: String, val selection: Utf8Selection?, val replacement: TextReplacement),
    Commit(val text: String, val replacement: TextReplacement),
    DeleteSurrounding(val beforeBytes: Long, val afterBytes: Long)
}

/** One native document connection, replaced whenever native text input reopens. */
public struct TextInputConnection(val window: WindowId, val generation: Long)

/** Ordered native batch identity; it is independent of the application's text revision. */
public struct TextInputOrigin(val connection: TextInputConnection, val sequence: Long)

/** An owned, ordered edit transaction against an optional editor revision. */
public class TextInputBatch public constructor(
    public val baseRevision: Long?,
    operations: List<TextInputOperation>,
    public val origin: TextInputOrigin? = None
) {
    public val operations: Array<TextInputOperation> = operations.toArray()
}

/** Text has exactly one insertion channel, including ordinary printable keys. */
public enum TextInputEvent {
    Enabled(val connection: TextInputConnection?), Disabled(
        val connection: TextInputConnection?
    ), Edit(TextInputBatch)
}

/** An immutable UTF-8 snapshot, published to native text input only by an explicit request. */
public struct TextInputState(
    val surroundingText: String,
    val selection: Utf8Selection,
    val markedRange: Utf8Range? = None,
    val caretRect: LogicalRect = LogicalRect(LogicalPosition(0.0, 0.0), LogicalSize(0.0, 0.0)),
    val revision: Long = 0L
) {
    /** Validates the complete snapshot, including both directional selection endpoints. */
    public fun validate() {
        requireWindow(revision >= 0L, "negative text revision")
        val bytes = surroundingText.toByteArray()
        checkTextRange(bytes, selection.range)
        when (markedRange) {
            case Some(val range) -> checkTextRange(bytes, range);
            case None -> {}
        }
        checkRect(caretRect)
    }
    /** Applies one transaction atomically to a new value; this snapshot remains unchanged. */
    public fun apply(batch: TextInputBatch): TextInputState = applyTextBatch(this, batch)
}

internal fun checkTextRange(bytes: Array<Byte>, range: Utf8Range) {
    requireWindow(
        range.start >= 0L && range.start <= range.end && range.end <= bytes.size,
        "invalid UTF-8 range"
    )
    requireWindow(
        textBoundary(bytes, range.start) && textBoundary(bytes, range.end),
        "range splits a UTF-8 character"
    )
}

private fun textBoundary(bytes: Array<Byte>, offset: Long): Boolean =
    offset == bytes.size || bytes[offset].toInt().and(192) != 128

internal fun textSlice(text: String, range: Utf8Range): String {
    val bytes = text.toByteArray()
    checkTextRange(bytes, range)
    return String.fromUtf8(
        Array<Byte>(range.end - range.start) { index -> bytes[range.start + index] }
    )
}

/** Copies a validated UTF-8 byte range without reinterpreting it as character indices. */
public fun String.utf8Slice(range: Utf8Range): String = textSlice(this, range)
