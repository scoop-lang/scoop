package scoop.window.accessibility

import scoop.window.*

/** A small identity owner that does not retain a window or its application. */
internal class SemanticIdentity {
    var next = 1L
}

/** A window-owned identity. Closing a provider never makes it refer to another node. */
public class SemanticNodeId internal constructor(
    private val identity: SemanticIdentity,
    public val window: WindowId,
    internal val number: Long
) : Equals<SemanticNodeId>, Hash {
    public override operator fun equals(other: SemanticNodeId): Boolean = identity ===
        other.identity &&
        number ==
        other.number
    public override fun hash(): Long = number.hash()
}

/** Roles implemented by the initial native content provider. */
public enum SemanticRole {
    Group, Text, Button, Checkbox, TextField, ScrollArea, ScrollBar, Switch, ToggleButton, RadioButton, RadioGroup, Image, List,
    Link, Heading, Slider, ProgressBar, Menu, MenuItem, TabGroup, Tab, Dialog, Table, Cell, RowHeader, ColumnHeader, Disclosure, Separator, Row, Tree, TreeItem
}

public enum SemanticSelectionMode {
    Single, Multiple
}

public enum SemanticChecked {
    Off, On, Mixed
}

/** The active text endpoint's side of a shared visual-line boundary. */
public enum SemanticTextAffinity {
    Upstream, Downstream
}

/** Unknown strings differ from known empty strings. Protected text has no public value. */
public struct SemanticProperties(
    val name: String? = None,
    val description: String? = None,
    val automationId: String? = None,
    val value: String? = None,
    val enabled: Boolean = true,
    val readOnly: Boolean = false,
    val protectedText: Boolean = false,
    val checked: SemanticChecked? = None,
    val hidden: Boolean = false,
    val error: String? = None,
    val ignored: Boolean = false,
    val selection: Utf8Selection? = None,
    val required: Boolean = false,
    val scroll: SemanticScrollRange? = None,
    val cursorAffinity: SemanticTextAffinity = SemanticTextAffinity.Downstream,
    val selected: Boolean? = None,
    val expanded: Boolean? = None,
    val invalid: Boolean = false,
    val busy: Boolean = false,
    val modal: Boolean = false,
    val headingLevel: Int? = None,
    val range: SemanticValueRange? = None,
    val url: String? = None,
    val live: SemanticLive = SemanticLive.Off,
    val table: SemanticTableSize? = None,
    val cell: SemanticTableCell? = None,
    val orientation: SemanticOrientation? = None,
    val selectionMode: SemanticSelectionMode? = None
) {
    internal fun check() {
        requireWindow(!protectedText || value == None, "protected text cannot publish a value")
        scroll?.check()
        range?.check()
        table?.check()
        cell?.check()
        requireWindow(
            range == None || (value == None && scroll == None),
            "numeric ranges cannot publish text or scroll values"
        )
        when (headingLevel) {
            case Some(val level) -> requireWindow(level >= 1 && level <= 6, "invalid heading level")
            case None -> {}
        }
        requireWindow(scroll == None || value == None, "scroll ranges cannot publish text values")
        when (selection) {
            case Some(val selected) -> {
                requireWindow(
                    !protectedText && value != None,
                    "text selection requires public text"
                )
                checkTextRange(value!!.toByteArray(), selected.range)
            }

            case None -> {}
        }
    }
}

/** Ordered references in one active provider; they do not change parenthood or focus. */
public enum SemanticDescendant : Equals<SemanticDescendant> {
    Node(SemanticNodeId), Item(SemanticNodeId, SemanticItemKey)
    public override operator fun equals(other: SemanticDescendant): Boolean = when ((this, other)) {
        case(Node(val left), Node(val right)) -> left == right
        case(Item(val left, val key), Item(val right, val otherKey)) ->
            left == right && key == otherKey
        else -> false
    }
    internal val node: SemanticNodeId
        get() = when (this) {
            case Node(val id) -> id
            case Item(val id, _) -> id
        }
}

public struct SemanticRelations(
    val labelledBy: Array<SemanticNodeId> = [],
    val describedBy: Array<SemanticNodeId> = [],
    val errorMessages: Array<SemanticNodeId> = [],
    val controls: Array<SemanticNodeId> = [],
    val activeDescendant: SemanticDescendant? = None,
    val rowHeaders: Array<SemanticNodeId> = [],
    val columnHeaders: Array<SemanticNodeId> = []
) : Equals<SemanticRelations> {
    public override operator fun equals(other: SemanticRelations): Boolean = sameSemanticIds(
        labelledBy,
        other.labelledBy
    ) &&
        sameSemanticIds(describedBy, other.describedBy) &&
        sameSemanticIds(errorMessages, other.errorMessages) &&
        sameSemanticIds(controls, other.controls) &&
        activeDescendant ==
        other.activeDescendant &&
        sameSemanticIds(rowHeaders, other.rowHeaders) &&
        sameSemanticIds(columnHeaders, other.columnHeaders)

    internal val references: Array<Array<SemanticNodeId>>
        get() = [
            labelledBy,
            describedBy,
            errorMessages,
            controls,
            rowHeaders,
            columnHeaders,
            when (activeDescendant) {
                case Some(val value) -> [value.node];
                case None -> []
            }
        ]
}

internal fun sameSemanticIds(left: Array<SemanticNodeId>, right: Array<SemanticNodeId>): Boolean {
    if (left === right) return true
    if (left.size != right.size) return false
    for (index in 0L..<left.size)
        if (left[index] != right[index]) return false
    return true
}

/** Bounds are not a promise that their center is a valid clickable point. */
public struct SemanticGeometry(
    val bounds: LogicalRect,
    val visibleBounds: LogicalRect? = Some(bounds)
) {
    internal fun check() {
        checkSemanticRect(bounds)
        when (visibleBounds) {
            case Some(val visible) -> {
                checkSemanticRect(visible)
                requireWindow(
                    visible.origin.x >=
                        bounds.origin.x &&
                        visible.origin.y >=
                        bounds.origin.y &&
                        visible.origin.x +
                        visible.size.width <=
                        bounds.origin.x +
                        bounds.size.width &&
                        visible.origin.y +
                        visible.size.height <=
                        bounds.origin.y +
                        bounds.size.height,
                    "visible semantic geometry must be inside its bounds"
                )
            }

            case None -> {}
        }
    }
}

private fun checkSemanticRect(value: LogicalRect) {
    checkRect(value)
    requireWindow(
        (value.origin.x + value.size.width).isFinite() &&
            (value.origin.y + value.size.height).isFinite(),
        "semantic rectangle overflow"
    )
}

/** Completion describes the UI action, not any asynchronous business it starts. */
public enum SemanticActionResult {
    Completed, InvalidArgument, Unsupported, Unavailable, Rejected, Busy
}

/** Native capabilities are derived from these actual implementations. */
public struct SemanticActions(
    val invoke: (() -> SemanticActionResult)? = None,
    val toggle: (() -> SemanticActionResult)? = None,
    val setValue: ((String) -> SemanticActionResult)? = None,
    val focus: ((Boolean) -> SemanticActionResult)? = None,
    val setSelection: ((Utf8Selection) -> SemanticActionResult)? = None,
    val replaceText: ((Utf8Range, String) -> SemanticActionResult)? = None,
    val showContextMenu: (() -> SemanticActionResult)? = None,
    val setScrollPosition: ((Double) -> SemanticActionResult)? = None,
    val scrollBackward: (() -> SemanticActionResult)? = None,
    val scrollForward: (() -> SemanticActionResult)? = None,
    /** Completes only when matching accepted geometry is visible, without changing focus. */
    val reveal: (() -> SemanticActionResult)? = None,
    val setNumber: ((Double) -> SemanticActionResult)? = None,
    val increment: (() -> SemanticActionResult)? = None,
    val decrement: (() -> SemanticActionResult)? = None,
    val setSelected: ((Boolean) -> SemanticActionResult)? = None,
    val setExpanded: ((Boolean) -> SemanticActionResult)? = None,
    val dismiss: (() -> SemanticActionResult)? = None,
    val revealText: ((Utf8Range, SemanticTextScroll) -> SemanticActionResult)? = None
) {
    public val isEmpty: Boolean get() = capabilities == 0
    internal val capabilities: Int
        get() {
            var result = 0
            when (invoke) {
                case Some(_) -> result += 1;
                case None -> {}
            }
            when (toggle) {
                case Some(_) -> result += 2;
                case None -> {}
            }
            when (setValue) {
                case Some(_) -> result += 4;
                case None -> {}
            }
            when (focus) {
                case Some(_) -> result += 8;
                case None -> {}
            }
            when (setSelection) {
                case Some(_) -> result += 16;
                case None -> {}
            }
            when (replaceText) {
                case Some(_) -> result += 32;
                case None -> {}
            }
            when (showContextMenu) {
                case Some(_) -> result += 64;
                case None -> {}
            }
            when (setScrollPosition) {
                case Some(_) -> result += 128;
                case None -> {}
            }
            when (scrollBackward) {
                case Some(_) -> result += 256;
                case None -> {}
            }
            when (scrollForward) {
                case Some(_) -> result += 512;
                case None -> {}
            }
            when (reveal) {
                case Some(_) -> result += 1024;
                case None -> {}
            }
            when (setNumber) {
                case Some(_) -> result += 2048;
                case None -> {}
            }
            when (increment) {
                case Some(_) -> result += 4096;
                case None -> {}
            }
            when (decrement) {
                case Some(_) -> result += 8192;
                case None -> {}
            }
            when (setSelected) {
                case Some(_) -> result += 16384;
                case None -> {}
            }
            when (setExpanded) {
                case Some(_) -> result += 32768;
                case None -> {}
            }
            when (dismiss) {
                case Some(_) -> result += 65536;
                case None -> {}
            }
            when (revealText) {
                case Some(_) -> result += 131072;
                case None -> {}
            }
            return result
        }
}

internal fun actionCode(value: SemanticActionResult): Int = when (value) {
    case Completed -> 1
    case InvalidArgument -> 2
    case Unsupported -> 3
    case Unavailable -> 4
    case Rejected -> 5
    case Busy -> 6
}
