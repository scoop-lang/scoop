package scoop.window.accessibility

import scoop.window.*

/** A native action may enter only between ordinary owner callbacks. */
internal fun ApplicationOwner.performAccessibility(
    action: () -> SemanticActionResult
): SemanticActionResult {
    if (!isCurrentThread())
        return SemanticActionResult.Busy
    if (exiting || native == None)
        return SemanticActionResult.Unavailable
    if (accessibilityBusy)
        return SemanticActionResult.Busy
    dispatchDepth += 1
    try {
        return action()
    } catch (error: Throwable) {
        failAccessibility(error)
        return SemanticActionResult.Unavailable
    } finally {
        dispatchDepth -= 1
        if (exiting)
            mailbox.wake()
    }
}
