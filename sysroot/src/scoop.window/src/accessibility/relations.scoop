package scoop.window.accessibility

import scoop.collections.HashSet
import scoop.collections.contains
import scoop.collections.toList
import scoop.window.*

internal fun checkSemanticRelations(source: AccessibilityNode, next: SemanticRelations) {
    for (ids in [next.labelledBy, next.describedBy, next.errorMessages, next.controls]) {
        val seen = HashSet<SemanticNodeId>()
        for (id in ids) {
            val target = source.provider.lookup(id)
            requireWindow(
                (target?.active ?: false) && id != source.id,
                "semantic relation requires another active node in the same provider"
            )
            requireWindow(seen.add(id), "duplicate semantic relation target")
        }
    }
    if (sameSemanticIds(source.relationValues.labelledBy, next.labelledBy))
        return
    val pending = ArrayList<SemanticNodeId>()
    val visited = HashSet<SemanticNodeId>()
    for (id in next.labelledBy)
        pending.add(id)
    while (pending.size > 0L) {
        val id = pending.removeAt(pending.size - 1L)
        requireWindow(id != source.id, "semantic labels would create a name cycle")
        if (!visited.add(id))
            continue
        val target = source.provider.lookup(id) ?: continue
        for (label in target.relationValues.labelledBy)
            pending.add(label)
    }
}

/** Maintains only real references, so retirement and text updates visit their dependents. */
internal fun installSemanticRelations(source: AccessibilityNode, next: SemanticRelations) {
    val previous = source.relationValues
    for (
        ids in [
            previous.labelledBy,
            previous.describedBy,
            previous.errorMessages,
            previous.controls
        ]
    )
        for (id in ids) {
            val target = source.provider.lookup(id) ?: continue
            target.referrers.remove(source.id.number)
            source.provider.changed(target)
        }
    source.relationValues = next
    for (ids in [next.labelledBy, next.describedBy, next.errorMessages, next.controls])
        for (id in ids) {
            val target = source.provider.lookup(id) ?: continue
            target.referrers[source.id.number] = source
            source.provider.changed(target)
        }
}

internal fun retireSemanticRelations(node: AccessibilityNode) {
    for (source in node.referrers.values.toList()) {
        if (!source.active)
            continue
        val old = source.relationValues
        val next =
            SemanticRelations(
                withoutSemanticId(old.labelledBy, node.id),
                withoutSemanticId(old.describedBy, node.id),
                withoutSemanticId(old.errorMessages, node.id),
                withoutSemanticId(old.controls, node.id)
            )
        val nameChanged =
            source.properties.name == None && !sameSemanticIds(old.labelledBy, next.labelledBy)
        installSemanticRelations(source, next)
        if (nameChanged)
            source.invalidateContent()
        semanticTextChanged(source, nameChanged)
        source.provider.changed(source)
    }
    installSemanticRelations(node, SemanticRelations())
    node.referrers.clear()
}

private fun withoutSemanticId(ids: Array<SemanticNodeId>, removed: SemanticNodeId): Array<
    SemanticNodeId
> {
    val result = ArrayList<SemanticNodeId>()
    for (id in ids)
        if (id != removed)
            result.add(id)
    return result.toArray()
}

internal fun semanticTextChanged(node: AccessibilityNode, nameChanged: Boolean) {
    node.textDirty = true
    if (!nameChanged)
        return
    node.nameDirty = true
    val pending = ArrayList<AccessibilityNode>()
    val visited = HashSet<SemanticNodeId>()
    pending.add(node)
    while (pending.size > 0L) {
        val target = pending.removeAt(pending.size - 1L)
        if (!visited.add(target.id))
            continue
        for (source in target.referrers.values) {
            if (!source.active)
                continue
            val name =
                source.properties.name ==
                    None &&
                    source.relationValues.labelledBy.contains(target.id)
            val description =
                source.properties.description ==
                    None &&
                    source.relationValues.describedBy.contains(target.id)
            val error =
                source.properties.error ==
                    None &&
                    source.relationValues.errorMessages.contains(target.id)
            if (name || description || error) {
                source.textDirty = true
                source.provider.changed(source)
            }
            if (name) {
                source.nameDirty = true
                source.invalidateContent()
                pending.add(source)
            }
        }
    }
}

internal fun resolveSemanticText(node: AccessibilityNode) {
    if (!node.textDirty)
        return
    resolveSemanticName(node)
    node.resolvedDescription =
        semanticTextOr(node, node.properties.description, node.relationValues.describedBy)
    node.resolvedError =
        semanticTextOr(node, node.properties.error, node.relationValues.errorMessages)
    node.textDirty = false
}

private fun resolveSemanticName(node: AccessibilityNode): String? {
    if (!node.nameDirty)
        return node.resolvedName
    node.resolvedName = semanticTextOr(node, node.properties.name, node.relationValues.labelledBy)
    node.nameDirty = false
    return node.resolvedName
}

private fun semanticTextOr(
    source: AccessibilityNode,
    explicit: String?,
    ids: Array<SemanticNodeId>
): String? {
    when (explicit) {
        case Some(_) -> return explicit
        case None -> {}
    }
    var known = false
    var text = ""
    for (id in ids) {
        val target = source.provider.lookup(id) ?: continue
        if (!target.active)
            continue
        var value = resolveSemanticName(target)
        if (value == None && target.role == SemanticRole.Text && !target.properties.protectedText)
            value = target.properties.value
        when (value) {
            case Some(val content) -> {
                known = true
                if (content.byteLength > 0L) {
                    if (text.byteLength > 0L)
                        text += " "
                    text += content
                }
            }
            case None -> {}
        }
    }
    return if (known)
        Some(text)
    else
        None
}
