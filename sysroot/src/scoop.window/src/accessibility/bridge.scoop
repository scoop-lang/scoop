package scoop.window.accessibility

import scoop.window.*
import scoop.window.accessibility.native.NativeSemanticHitTest
import scoop.window.accessibility.native.NativeSemanticTextGeometry

/** Attaches the native content subtree. The window closes it before native destruction. */
public fun Window.createAccessibilityProvider(): AccessibilityProvider {
    owner.requireOpen()
    if (owner.phase != WindowState.Open)
        throw IllegalStateException(Some("accessibility requires a configured window"))
    when (owner.accessibility) {
        case Some(_) -> throw IllegalStateException(
            Some("window already has an accessibility provider")
        )
        case None -> {}
    }
    val provider = AccessibilityProvider(owner)
    val application = owner.application
    @Unsafe
    {
        val callback =
            foreignCallback<
                (Ptr<Unit>, Long, Int, Ptr<UInt8>?, Long, Long, Long, ULong, Double) -> Int
            >(
                {
                    number: Long,
                    action: Int,
                    bytes: Ptr<UInt8>?,
                    length: Long,
                    anchor: Long,
                    cursor: Long,
                    revision: ULong,
                    position: Double -> actionCode(
                        application.performAccessibility {
                            val value =
                                if (action == 2 || action == 6)
                                    actionText(bytes, length)
                                else
                                    None
                            provider.perform(
                                number,
                                action,
                                value,
                                Utf8Selection(anchor, cursor),
                                revision,
                                position
                            )
                        }
                    )
                },
                0,
                ForeignCallbackMode.Reusable
            )
        val collections = NativeCollectionQueries(application, provider)
        try {
            val pointer =
                created(
                    nativeAccessibilityCreate(owner.pointer!!, callback.function, callback.context),
                    "create accessibility provider"
                )
            collections.attach(pointer)
            provider.bind(
                NativeAccessibilityProjection(application, pointer, callback, collections)
            )
            owner.accessibility = Some(provider)
            return provider
        } catch (error: Throwable) {
            collections.close()
            releaseForeignCallback(callback)
            throw error
        }
    }
}

private fun actionText(bytes: Ptr<UInt8>?, length: Long): String? {
    when (bytes) {
        case Some(val text) -> {
            @Unsafe
            {
                return Some(String.fromUtf8(text, length))
            }
        }
        case None -> return if (length == 0L)
            Some("")
        else
            None
    }
}

private class NativeAccessibilityProjection(
    private val application: ApplicationOwner,
    private val pointer: Ptr<Unit>,
    private val callback: ForeignCallback<
        (Ptr<Unit>, Long, Int, Ptr<UInt8>?, Long, Long, Long, ULong, Double) -> Int
    >,
    private val collections: NativeCollectionQueries
): AccessibilityProjection {
    public override fun publish(
        changed: Collection<AccessibilityNode>,
        removed: Array<Long>,
        focused: Long
    ) {
        @Unsafe
        {
            checkNativeStatus(nativeAccessibilityBegin(pointer), "begin accessibility publication")
            var committed = false
            try {
                for (number in removed)
                    checkNativeStatus(
                        nativeAccessibilityRemove(pointer, number),
                        "remove accessibility node"
                    )
                for (node in changed) {
                    checkNativeStatus(
                        nativeAccessibilityPut(pointer, describe(node)),
                        "publish accessibility node"
                    )
                    collections.publish(pointer, node)
                    when (val hit = node.hit) {
                        case Some(val value) -> checkNativeStatus(
                            nativeAccessibilityHit(pointer, node.id.number, value.native),
                            "publish accessibility hit geometry"
                        )
                        case None -> {}
                    }
                    when (val geometry = node.textGeometry) {
                        case Some(val value) -> checkNativeStatus(
                            nativeAccessibilityTextGeometry(pointer, node.id.number, value.native),
                            "publish accessibility text geometry"
                        )
                        case None -> {}
                    }
                    text(node.id.number, 0, node.resolvedName)
                    text(node.id.number, 1, node.resolvedDescription)
                    text(node.id.number, 2, node.properties.automationId)
                    text(node.id.number, 3, node.properties.value)
                    text(node.id.number, 4, node.resolvedError)
                    text(node.id.number, 5, node.properties.url)
                    checkNativeStatus(
                        nativeAccessibilityDocument(
                            pointer,
                            node.id.number,
                            when (node.documentValue) {
                                case Some(val value) -> value.pointer;
                                case None -> None
                            },
                            node.documentRevision,
                            node.documentEpoch
                        ),
                        "publish semantic text document"
                    )
                    for (child in node.textChildValues)
                        checkNativeStatus(
                            nativeAccessibilityTextChild(
                                pointer,
                                node.id.number,
                                child.node.number,
                                child.range.start,
                                child.range.end
                            ),
                            "publish semantic text child"
                        )
                    for (id in node.relationValues.labelledBy)
                        relation(node.id.number, 0, id.number)
                    for (id in node.relationValues.controls)
                        relation(node.id.number, 1, id.number)
                    for (id in node.relationValues.describedBy)
                        relation(node.id.number, 3, id.number)
                    for (id in node.relationValues.errorMessages)
                        relation(node.id.number, 4, id.number)
                    for (id in node.relationValues.rowHeaders)
                        relation(node.id.number, 5, id.number)
                    for (id in node.relationValues.columnHeaders)
                        relation(node.id.number, 6, id.number)
                    when (node.relationValues.activeDescendant) {
                        case Some(Node(val id)) -> relation(node.id.number, 7, id.number)
                        else -> {}
                    }
                    for (source in node.referrers.values)
                        if (
                            source.active &&
                                source.properties.name ==
                                None &&
                                source.relationValues.labelledBy.size ==
                                1L &&
                                source.relationValues.labelledBy[0L] ==
                                node.id
                        )
                            relation(node.id.number, 2, source.id.number)
                }
                checkNativeStatus(
                    nativeAccessibilityCommit(pointer, focused),
                    "commit accessibility publication"
                )
                committed = true
            } finally {
                if (!committed)
                    nativeAccessibilityAbort(pointer)
            }
        }
    }

    private fun relation(number: Long, field: Int, target: Long) {
        @Unsafe
        {
            checkNativeStatus(
                nativeAccessibilityRelation(pointer, number, field, target),
                "publish accessibility relation"
            )
        }
    }

    private fun text(number: Long, field: Int, value: String?) {
        @Unsafe
        {
            when (value) {
                case Some(val string) -> string.withUtf8Bytes {
                    bytes,
                    length -> @Unsafe
                    {
                        checkNativeStatus(
                            nativeAccessibilityText(pointer, number, field, Some(bytes), length),
                            "publish accessibility text"
                        )
                    }
                }
                case None -> checkNativeStatus(
                    nativeAccessibilityText(pointer, number, field, None, -1L),
                    "clear accessibility text"
                )
            }
        }
    }

    public override fun retire(number: Long) {
        @Unsafe
        {
            nativeAccessibilityRetire(pointer, number)
        }
    }

    public override fun announce(number: Long, text: String, priority: SemanticLive) {
        @Unsafe
        {
            text.withUtf8Bytes {
                bytes,
                length -> @Unsafe
                {
                    nativeAccessibilityAnnounce(
                        pointer,
                        number,
                        bytes,
                        length,
                        if (priority == SemanticLive.Assertive)
                            2
                        else
                            1
                    )
                }
            }
        }
    }

    public override fun close() {
        @Unsafe
        {
            nativeAccessibilityClose(pointer)
        }
        val owned = callback
        collections.close()
        application.mailbox.postControl {
            @Unsafe
            {
                releaseForeignCallback(owned)
            }
        }
    }
}

private fun describe(node: AccessibilityNode): NativeSemanticNode {
    val value = node.properties
    val orientation =
        when (value.scroll) {
            case Some(val scroll) -> Some(scroll.orientation);
            case None -> value.orientation
        }
    val bounds =
        node.placement?.bounds ?: LogicalRect(LogicalPosition(0.0, 0.0), LogicalSize(0.0, 0.0))
    val visible =
        when (val geometry = node.placement) {
            case Some(val placed) -> placed.visibleBounds
            case None -> None
        }
    val visibleRect = visible ?: LogicalRect(LogicalPosition(0.0, 0.0), LogicalSize(0.0, 0.0))
    return NativeSemanticNode(
        node.id.number,
        node.parentNode?.id?.number ?: 0L,
        node.order,
        node.sceneOrder,
        node.revision,
        node.textRevision,
        value.selection?.anchor ?: -1L,
        value.selection?.cursor ?: -1L,
        when (node.role) {
            case Group -> 0;
            case Text -> 1;
            case Button -> 2;
            case Checkbox -> 3;
            case TextField -> 4;
            case ScrollArea -> 5;
            case ScrollBar -> 6
            case Switch -> 7
            case ToggleButton -> 8
            case RadioButton -> 9
            case RadioGroup -> 10
            case Image -> 11
            case List -> 12
            case Link -> 13
            case Heading -> 14
            case Slider -> 15
            case ProgressBar -> 16
            case Menu -> 17
            case MenuItem -> 18
            case TabGroup -> 19
            case Tab -> 20
            case Dialog -> 21
            case Table -> 22
            case Cell -> 23
            case RowHeader -> 24
            case ColumnHeader -> 25
            case Disclosure -> 26
            case Separator -> 27
            case Row -> 28
        },
        flag(value.enabled) +
            2 *
            flag(value.readOnly) +
            4 *
            flag(value.protectedText) +
            8 *
            flag(value.hidden) +
            16 *
            flag(value.name != None) +
            32 *
            flag(value.ignored) +
            64 *
            flag(value.required) +
            128 *
            flag(value.selection != None && value.cursorAffinity == SemanticTextAffinity.Upstream) +
            256 *
            flag(value.invalid) +
            512 *
            flag(value.busy) +
            1024 *
            flag(value.modal),
        node.actions.capabilities,
        when (value.checked) {
            case None -> -1;
            case Some(Off) -> 0;
            case Some(On) -> 1;
            case Some(Mixed) -> 2
        },
        flag(node.placement != None),
        flag(visibleRect.size.width > 0.0 && visibleRect.size.height > 0.0),
        when (orientation) {
            case Some(Horizontal) -> 1;
            case Some(Vertical) -> 2;
            case None -> 0
        },
        bounds.origin.x,
        bounds.origin.y,
        bounds.size.width,
        bounds.size.height,
        visibleRect.origin.x,
        visibleRect.origin.y,
        visibleRect.size.width,
        visibleRect.size.height,
        value.scroll?.offset ?: 0.0,
        value.scroll?.viewport ?: 0.0,
        value.scroll?.content ?: 0.0,
        optionalFlag(value.selected),
        optionalFlag(value.expanded),
        value.headingLevel ?: 0,
        flag(value.range != None),
        when (value.live) {
            case Off -> 0;
            case Polite -> 1;
            case Assertive -> 2
        },
        value.range?.minimum ?: 0.0,
        value.range?.maximum ?: 0.0,
        value.range?.value ?: 0.0,
        value.range?.step ?: ((value.scroll?.lineStep ?: None) ?: 0.0),
        value.table?.rows ?: -1L,
        value.table?.columns ?: -1L,
        value.cell?.row ?: -1L,
        value.cell?.column ?: -1L,
        value.cell?.rowSpan ?: 0L,
        value.cell?.columnSpan ?: 0L,
        flag(node.activation != None),
        node.activation?.x ?: 0.0,
        node.activation?.y ?: 0.0
    )
}

private fun optionalFlag(value: Boolean?): Int =
    when (value) {
        case Some(val actual) -> if (actual)
            1
        else
            0
        case None -> -1
    }

@CLayout
private struct NativeSemanticNode(
    val number: Long,
    val parent: Long,
    val order: Long,
    val sceneOrder: Long,
    val contentRevision: ULong,
    val textRevision: ULong,
    val anchor: Long,
    val cursor: Long,
    val role: Int,
    val flags: Int,
    val actions: Int,
    val checked: Int,
    val geometry: Int,
    val visible: Int,
    val scrollOrientation: Int,
    val x: Double,
    val y: Double,
    val width: Double,
    val height: Double,
    val visibleX: Double,
    val visibleY: Double,
    val visibleWidth: Double,
    val visibleHeight: Double,
    val scrollOffset: Double,
    val scrollViewport: Double,
    val scrollContent: Double,
    val selected: Int,
    val expanded: Int,
    val headingLevel: Int,
    val hasRange: Int,
    val live: Int,
    val minimum: Double,
    val maximum: Double,
    val numberValue: Double,
    val numberStep: Double,
    val tableRows: Long,
    val tableColumns: Long,
    val cellRow: Long,
    val cellColumn: Long,
    val rowSpan: Long,
    val columnSpan: Long,
    val activation: Int,
    val activationX: Double,
    val activationY: Double
)

@Extern(name = "scoop_window_accessibility_create")
private fun nativeAccessibilityCreate(
    window: Ptr<Unit>,
    callback: FunPtr<(Ptr<Unit>, Long, Int, Ptr<UInt8>?, Long, Long, Long, ULong, Double) -> Int>,
    context: Ptr<Unit>
): NativeCreateResult

@Extern(name = "scoop_window_accessibility_begin")
private fun nativeAccessibilityBegin(provider: Ptr<Unit>): Long

@Extern(name = "scoop_window_accessibility_put")
private fun nativeAccessibilityPut(provider: Ptr<Unit>, value: NativeSemanticNode): Long

@Extern(name = "scoop_window_accessibility_document")
private fun nativeAccessibilityDocument(
    provider: Ptr<Unit>,
    node: Long,
    document: Ptr<Unit>?,
    revision: ULong,
    epoch: ULong
): Long

@Extern(name = "scoop_window_accessibility_text")
private fun nativeAccessibilityText(
    provider: Ptr<Unit>,
    number: Long,
    field: Int,
    text: Ptr<UInt8>?,
    length: Long
): Long

@Extern(name = "scoop_window_accessibility_relation")
private fun nativeAccessibilityRelation(
    provider: Ptr<Unit>,
    number: Long,
    field: Int,
    target: Long
): Long

@Extern(name = "scoop_window_accessibility_hit")
private fun nativeAccessibilityHit(
    provider: Ptr<Unit>,
    number: Long,
    geometry: NativeSemanticHitTest
): Long

@Extern(name = "scoop_window_accessibility_remove")
private fun nativeAccessibilityRemove(provider: Ptr<Unit>, number: Long): Long

@Extern(name = "scoop_window_accessibility_text_geometry")
private fun nativeAccessibilityTextGeometry(
    provider: Ptr<Unit>,
    number: Long,
    geometry: NativeSemanticTextGeometry
): Long

@Extern(name = "scoop_window_accessibility_commit")
private fun nativeAccessibilityCommit(provider: Ptr<Unit>, focused: Long): Long

@Extern(name = "scoop_window_accessibility_abort")
private fun nativeAccessibilityAbort(provider: Ptr<Unit>)

@Extern(name = "scoop_window_accessibility_retire")
private fun nativeAccessibilityRetire(provider: Ptr<Unit>, number: Long)

@Extern(name = "scoop_window_accessibility_close")
private fun nativeAccessibilityClose(provider: Ptr<Unit>)

@Extern(name = "scoop_window_accessibility_announce")
private fun nativeAccessibilityAnnounce(
    provider: Ptr<Unit>,
    number: Long,
    text: Ptr<UInt8>,
    length: Long,
    priority: Int
)

@Extern(name = "scoop_window_accessibility_text_child")
private fun nativeAccessibilityTextChild(
    provider: Ptr<Unit>,
    node: Long,
    child: Long,
    start: Long,
    end: Long
): Long
