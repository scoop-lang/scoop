package scoop.window.accessibility

import scoop.collections.HashMap
import scoop.window.*

/** The platform projection owns no writable application state. */
internal interface AccessibilityProjection : Closeable {
    fun publish(changed: Collection<AccessibilityNode>, removed: Array<Long>, focused: Long)
    fun retire(number: Long)
    fun announce(number: Long, text: String, priority: SemanticLive)
}

/** Stages owner-thread semantic changes and publishes them independently of drawing. */
public class AccessibilityProvider internal constructor(
    internal val owner: WindowOwner
) : Closeable {
    private val nodes = HashMap<Long, AccessibilityNode>()
    private val pending = HashMap<Long, AccessibilityNode>()
    private val removed = ArrayList<Long>()
    private val announcements = HashMap<Long, SemanticAnnouncement>()
    internal val roots = ArrayList<AccessibilityNode>()
    private var focus: AccessibilityNode? = None
    private var focusChanged = false
    private var publishing = false
    private var closed = false
    private var projection: AccessibilityProjection? = None

    internal fun bind(value: AccessibilityProjection) {
        projection = Some(value)
    }

    public val isClosed: Boolean
        get() {
            checkThread()
            return closed
        }

    /** The actual keyboard focus. Setting it does not request focus or run a handler. */
    public var focused: AccessibilityNode?
        get() {
            checkOpen()
            return focus
        }
        set(value) {
            checkOpen()
            checkParent(value)
            when (val previous = focus) {
                case Some(val old) ->
                    when (value) {
                        case Some(val next) -> if (old === next) return
                        case None -> {}
                    }
                case None ->
                    when (value) {
                        case None -> return
                        case Some(_) -> {}
                    }
            }
            focus = value
            focusChanged = true
        }

    public fun createNode(
        role: SemanticRole,
        parent: AccessibilityNode? = None
    ): AccessibilityNode {
        checkOpen()
        checkParent(parent)
        val sequence = owner.semanticIdentity
        if (sequence.next == Long.MAX_VALUE)
            throw IllegalStateException(Some("semantic node identity exhausted"))
        val id = SemanticNodeId(sequence, owner.id, sequence.next)
        sequence.next += 1L
        val node = AccessibilityNode(this, id, role, parent)
        nodes[id.number] = node
        addChild(node)
        changed(node)
        return node
    }

    internal fun checkThread() {
        owner.application.checkThread()
    }

    internal fun checkOpen() {
        checkThread()
        if (closed ||
            (owner.phase != WindowState.Open && owner.phase != WindowState.PendingConfigure)
        )
            throw IllegalStateException(Some("accessibility provider is closed"))
        if (publishing)
            throw IllegalStateException(Some("accessibility publication is in progress"))
    }

    internal fun checkParent(value: AccessibilityNode?) {
        when (value) {
            case Some(val node) ->
                requireWindow(
                    node.provider === this && node.active,
                    "semantic relation requires an active node in the same provider"
                )
            case None -> {}
        }
    }

    internal fun addChild(node: AccessibilityNode) {
        (node.parentNode?.children ?: roots).add(node)
    }

    internal fun removeChild(node: AccessibilityNode) {
        val children = node.parentNode?.children ?: roots
        for (index in 0L..<children.size) {
            if (children[index] === node) {
                children.removeAt(index)
                return
            }
        }
    }

    internal fun changed(node: AccessibilityNode) {
        if (node.active) pending[node.id.number] = node
    }

    internal fun lookup(id: SemanticNodeId): AccessibilityNode? {
        val node = nodes[id.number] ?: return None
        return if (node.id == id) Some(node) else None
    }

    internal fun retire(node: AccessibilityNode) {
        announcements.remove(node.id.number)
        node.active = false
        node.collectionValue = None
        node.publishedCollection = None
        node.documentValue = None
        node.documentRevision = 0UL
        node.itemActions = SemanticCollectionActions()
        retireSemanticRelations(node)
        node.actions = SemanticActions()
        node.invalidateGeometry()
        projection!!.retire(node.id.number)
        for (child in node.children.toArray())
            retire(child)
        removeChild(node)
        node.parentNode = None
        pending.remove(node.id.number)
        nodes.remove(node.id.number)
        removed.add(node.id.number)
        when (val current = focus) {
            case Some(val value) ->
                if (value === node) {
                    focus = None
                    focusChanged = true
                }
            case None -> {}
        }
    }

    /** Publishes only staged changes. A native getter never observes a partial publication. */
    public fun publish() {
        checkOpen()
        if (pending.size == 0L && removed.size == 0L && !focusChanged && announcements.size == 0L)
            return
        publishing = true
        try {
            for (node in pending.values) {
                resolveSemanticText(node)
                val message = node.announcementText
                if (node.hasPublished &&
                    node.properties.live !=
                    SemanticLive.Off &&
                    message !=
                    node.publishedMessage
                ) {
                    when (message) {
                        case Some(val text) ->
                            announcements[node.id.number] = SemanticAnnouncement(
                                text,
                                node.properties.live
                            )
                        case None -> {}
                    }
                }
            }
            projection!!.publish(pending.values, removed.toArray(), focus?.id?.number ?: 0L)
            for (node in pending.values) {
                node.publishedCollection = node.collectionValue
                node.publishedMessage = node.announcementText
                node.hasPublished = true
            }
            pending.clear()
            removed.clear()
            focusChanged = false
            val delivered = ArrayList<Long>()
            for (entry in announcements.entries) {
                val node = nodes[entry.key]
                when (node) {
                    case Some(val target) ->
                        if (!target.canAnnounce() || owner.inputBlocked) {
                            delivered.add(entry.key)
                        } else if (!target.announcementBusy) {
                            projection!!.announce(entry.key, entry.value.text, entry.value.priority)
                            delivered.add(entry.key)
                        }
                    case None -> delivered.add(entry.key)
                }
            }
            for (number in delivered)
                announcements.remove(number)
        } finally {
            publishing = false
        }
    }

    internal fun announce(node: AccessibilityNode, text: String, priority: SemanticLive) {
        if (priority == SemanticLive.Off || !node.canAnnounce() || owner.inputBlocked) return
        announcements[node.id.number] = SemanticAnnouncement(text, priority)
        changed(node)
    }

    internal fun collectionSource(number: Long, candidate: Boolean): SemanticCollectionSnapshot? {
        if (closed ||
            (owner.phase != WindowState.Open && owner.phase != WindowState.PendingConfigure) ||
            owner.application.exiting
        )
            return None
        val node = nodes[number] ?: return None
        if (!node.active) return None
        if (candidate) return if (publishing) node.collectionValue else None
        return if (publishing) None else node.publishedCollection
    }

    internal fun performCollection(
        number: Long,
        key: SemanticItemKey,
        operation: Int,
        column: Long
    ):
    SemanticActionResult {
        if (closed || owner.phase != WindowState.Open || owner.application.exiting)
            return SemanticActionResult.Unavailable
        if (owner.inputBlocked) return SemanticActionResult.Rejected
        if (publishing) return SemanticActionResult.Busy
        val node = nodes[number] ?: return SemanticActionResult.Unavailable
        if (!node.canAct()) return SemanticActionResult.Rejected
        val source = node.collectionValue ?: return SemanticActionResult.Unavailable
        when (node.publishedCollection) {
            case Some(val published) ->
                if (source !== published) return SemanticActionResult.Unavailable
            case None -> return SemanticActionResult.Unavailable
        }
        val item = when (source.itemForKey(key)) {
            case Found(val value) -> value
            else -> return SemanticActionResult.Unavailable
        }
        if (!item.properties.enabled) return SemanticActionResult.Rejected
        if ((operation == 5 || operation == 6) && !item.properties.focusable)
            return SemanticActionResult.Unsupported
        if ((operation == 7 || operation == 8) && !item.properties.selectable)
            return SemanticActionResult.Unsupported
        if ((operation == 17 || operation == 18) && item.properties.expanded == None)
            return SemanticActionResult.Unsupported
        if ((operation == 19 || operation == 20) && item.properties.checked == None)
            return SemanticActionResult.Unsupported
        val actions = node.itemActions
        val result = if (operation >= 12 && operation <= 15)
            performGridCell(source, actions.grid, key, column, operation)
        else
            when (operation) {
                case 3 -> actions.realize?.invoke(key) ?: SemanticActionResult.Unsupported
                case 4 -> actions.reveal?.invoke(key) ?: SemanticActionResult.Unsupported
                case 5 -> actions.focus?.invoke(key, true) ?: SemanticActionResult.Unsupported
                case 6 -> actions.focus?.invoke(key, false) ?: SemanticActionResult.Unsupported
                case 7 ->
                    when (source.selection) {
                        case Some(_) ->
                            actions.setSelected?.invoke(key, true) ?:
                                SemanticActionResult.Unsupported
                        case None -> SemanticActionResult.Unsupported
                    }
                case 8 ->
                    when (source.selection) {
                        case Some(_) ->
                            actions.setSelected?.invoke(key, operation == 7) ?:
                                SemanticActionResult.Unsupported
                        case None -> SemanticActionResult.Unsupported
                    }
                case 17 ->
                    actions.setExpanded?.invoke(key, true) ?: SemanticActionResult.Unsupported
                case 18 ->
                    actions.setExpanded?.invoke(key, false) ?: SemanticActionResult.Unsupported
                case 19 -> actions.setChecked?.invoke(key, true) ?: SemanticActionResult.Unsupported
                case 20 ->
                    actions.setChecked?.invoke(key, false) ?: SemanticActionResult.Unsupported
                else -> SemanticActionResult.Unsupported
            }
        if (!closed && owner.phase == WindowState.Open) publish()
        return if (node.active) result else SemanticActionResult.Unavailable
    }

    internal fun perform(
        number: Long,
        action: Int,
        value: String?,
        selection: Utf8Selection,
        revision: ULong,
        position: Double
    ): SemanticActionResult {
        if (closed || owner.phase != WindowState.Open || owner.application.exiting)
            return SemanticActionResult.Unavailable
        if (owner.inputBlocked) return SemanticActionResult.Rejected
        if (publishing) return SemanticActionResult.Busy
        val node = nodes[number] ?: return SemanticActionResult.Unavailable
        if (!node.canAct()) return SemanticActionResult.Rejected
        if (action >= 8 && action <= 10) {
            if (node.properties.scroll == None) return SemanticActionResult.Unsupported
            if (node.properties.readOnly) return SemanticActionResult.Rejected
            if (action == 8 && (!position.isFinite() || position < 0.0 || position > 1.0))
                return SemanticActionResult.InvalidArgument
        }
        if (action == 5 || action == 6 || action == 21) {
            if (node.contentRevision != revision) return SemanticActionResult.Unavailable
            if (node.properties.protectedText || node.properties.value == None)
                return SemanticActionResult.Unsupported
            try {
                checkTextRange(node.properties.value!!.toByteArray(), selection.range)
            } catch (error: IllegalArgumentException) {
                return SemanticActionResult.InvalidArgument
            }
            if (action == 6 && node.properties.selection?.range != Some(selection.range))
                return SemanticActionResult.Unavailable
        }
        val actions = node.actions
        if (action >= 12 && action <= 18 && node.properties.readOnly)
            return SemanticActionResult.Rejected
        if (action >= 12 && action <= 14) {
            val range = node.properties.range ?: return SemanticActionResult.Unsupported
            if (action ==
                12 &&
                (!position.isFinite() || position < range.minimum || position > range.maximum)
            )
                return SemanticActionResult.InvalidArgument
        }
        if ((action == 15 || action == 16) && node.properties.selected == None)
            return SemanticActionResult.Unsupported
        if ((action == 17 || action == 18) && node.properties.expanded == None)
            return SemanticActionResult.Unsupported
        val result = when (action) {
            case 0 -> actions.invoke?.invoke() ?: SemanticActionResult.Unsupported
            case 1 ->
                if (node.properties.readOnly)
                    SemanticActionResult.Rejected
                else
                    actions.toggle?.invoke() ?: SemanticActionResult.Unsupported
            case 2 ->
                if (node.properties.readOnly)
                    SemanticActionResult.Rejected
                else
                    when (value) {
                        case Some(val text) ->
                            actions.setValue?.invoke(text) ?: SemanticActionResult.Unsupported
                        case None -> SemanticActionResult.InvalidArgument
                    }
            case 3 -> actions.focus?.invoke(true) ?: SemanticActionResult.Unsupported
            case 4 -> actions.focus?.invoke(false) ?: SemanticActionResult.Unsupported
            case 5 -> actions.setSelection?.invoke(selection) ?: SemanticActionResult.Unsupported
            case 6 ->
                if (node.properties.readOnly)
                    SemanticActionResult.Rejected
                else
                    when (value) {
                        case Some(val text) ->
                            actions.replaceText?.invoke(selection.range, text) ?:
                                SemanticActionResult.Unsupported
                        case None -> SemanticActionResult.InvalidArgument
                    }
            case 7 -> actions.showContextMenu?.invoke() ?: SemanticActionResult.Unsupported
            case 8 ->
                actions.setScrollPosition?.invoke(position) ?: SemanticActionResult.Unsupported
            case 9 -> actions.scrollBackward?.invoke() ?: SemanticActionResult.Unsupported
            case 10 -> actions.scrollForward?.invoke() ?: SemanticActionResult.Unsupported
            case 11 -> actions.reveal?.invoke() ?: SemanticActionResult.Unsupported
            case 12 -> actions.setNumber?.invoke(position) ?: SemanticActionResult.Unsupported
            case 13 -> actions.increment?.invoke() ?: SemanticActionResult.Unsupported
            case 14 -> actions.decrement?.invoke() ?: SemanticActionResult.Unsupported
            case 15 -> actions.setSelected?.invoke(true) ?: SemanticActionResult.Unsupported
            case 16 -> actions.setSelected?.invoke(false) ?: SemanticActionResult.Unsupported
            case 17 -> actions.setExpanded?.invoke(true) ?: SemanticActionResult.Unsupported
            case 18 -> actions.setExpanded?.invoke(false) ?: SemanticActionResult.Unsupported
            case 21 ->
                when (val scroll = semanticTextScroll(position)) {
                    case Some(val value) ->
                        actions.revealText?.invoke(selection.range, value) ?:
                            SemanticActionResult.Unsupported
                    case None -> SemanticActionResult.InvalidArgument
                }
            case 19 -> actions.dismiss?.invoke() ?: SemanticActionResult.Unsupported
            else -> SemanticActionResult.Unsupported
        }
        if (!closed && owner.phase == WindowState.Open) publish()
        return result
    }

    public override fun close() {
        checkThread()
        if (closed) return
        closed = true
        for (node in nodes.values) {
            node.active = false
            node.actions = SemanticActions()
            node.itemActions = SemanticCollectionActions()
            node.collectionValue = None
            node.publishedCollection = None
            node.documentValue = None
            node.documentRevision = 0UL
            node.invalidateGeometry()
            node.children.clear()
            node.parentNode = None
            node.relationValues = SemanticRelations()
            node.content = []
            node.referrers.clear()
            node.resolvedName = None
            node.resolvedDescription = None
            node.resolvedError = None
        }
        nodes.clear()
        pending.clear()
        announcements.clear()
        removed.clear()
        roots.clear()
        focus = None
        when (val value = projection) {
            case Some(val current) -> current.close()
            case None -> {}
        }
        projection = None
        owner.accessibility = None
    }
}
