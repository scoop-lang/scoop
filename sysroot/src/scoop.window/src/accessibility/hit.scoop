package scoop.window.accessibility

import scoop.window.accessibility.native.NativeSemanticHitTest

/** One managed owner's native reference, independent of the published projection's reference. */
internal class SemanticHitSnapshot(val native: NativeSemanticHitTest): Closeable {
    private var closed = false
    init {
        @Unsafe
        {
            native.retain(native.context)
        }
    }
    public override fun close() {
        if (closed)
            return
        closed = true
        @Unsafe
        {
            native.release(native.context)
        }
    }
}
