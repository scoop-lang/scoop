private fun nativeCollectionRow(
    provider: Ptr<Unit>,
    node: Long,
    kind: Int,
    number: Long,
    text: Ptr<UInt8>?,
    length: Long
): Long

@Extern(name = "scoop_window_accessibility_collection_item")
private fun nativeCollectionItem(
    reply: Ptr<Unit>,
    index: Long,
    count: Long,
    span: Long,
    enabled: Int,
    selected: Int,
    expanded: Int,
    focusable: Int,
    hierarchyLevel: Long,
    hasCells: Int
)

@Extern(name = "scoop_window_accessibility_collection_item_key")
private fun nativeCollectionItemKey(
    reply: Ptr<Unit>,
    kind: Int,
    number: Long,
    text: Ptr<UInt8>?,
    length: Long
)

@Extern(name = "scoop_window_accessibility_collection_item_text")
private fun nativeCollectionItemText(reply: Ptr<Unit>, field: Int, text: Ptr<UInt8>, length: Long)

@CLayout
private struct NativeCollectionSearch(val bytes: Ptr<UInt8>?, val length: Long)

@Extern(name = "scoop_window_accessibility_collection_search")
private fun nativeCollectionSearch(reply: Ptr<Unit>): NativeCollectionSearch

private fun queryCollectionText(
    source: SemanticCollectionSnapshot,
    operation: Int,
    hasAfter: Long,
    kind: Int,
    number: Long,
    bytes: Ptr<UInt8>?,
    length: Long,
    reply: Ptr<Unit>?
): SemanticItemResult {
    val target = reply ?: return SemanticItemResult.Unavailable
    @Unsafe
    {
        val query = nativeCollectionSearch(target)
        if (query.length < 0L)
            return SemanticItemResult.Unavailable
        val text =
            when (query.bytes) {
                case Some(val value) -> String.fromUtf8(value, query.length)
                case None -> if (query.length == 0L)
                    ""
                else
                    return SemanticItemResult.Unavailable
            }
        val after =
            if (hasAfter == 0L)
                None
            else
                collectionKey(kind, number, bytes, length)
        if (hasAfter != 0L && after == None)
            return SemanticItemResult.Unavailable
        return source.find(
            if (operation == 9)
                SemanticItemQuery.Name(text)
            else
                SemanticItemQuery.AutomationId(text),
            after
        )
    }
}
