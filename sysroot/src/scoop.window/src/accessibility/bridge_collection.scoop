package scoop.window.accessibility

import scoop.window.*

/** Queries remain read-only; explicit operations enter the existing owner action boundary. */
internal class NativeCollectionQueries(
    private val application: ApplicationOwner,
    provider: AccessibilityProvider
): Closeable {
    private val callback = collectionCallback(application, provider)

    fun attach(pointer: Ptr<Unit>) {
        @Unsafe
        {
            nativeCollectionCallback(pointer, callback.function, callback.context)
        }
    }

    fun publish(pointer: Ptr<Unit>, node: AccessibilityNode) {
        @Unsafe
        {
            when (node.relationValues.activeDescendant) {
                case Some(Item(val collection, val key)) -> withCollectionKey(key) {
                    kind,
                    number,
                    bytes,
                    length -> @Unsafe
                    {
                        checkNativeStatus(
                            nativeCollectionActive(
                                pointer,
                                node.id.number,
                                collection.number,
                                kind,
                                number,
                                bytes,
                                length
                            ),
                            "publish active collection item"
                        )
                    }
                }
                else -> {}
            }
            checkNativeStatus(
                nativeCollectionSource(
                    pointer,
                    node.id.number,
                    node.collectionValue?.count ?: -1L,
                    node.collectionRevision,
                    collectionActionBits(node.itemActions) +
                        gridShapeFlags(node.collectionValue?.grid ?: None)
                ),
                "publish semantic collection"
            )
            publishCollectionDetails(pointer, node)
            when (val key = node.itemKey) {
                case Some(val value) -> {
                    withCollectionKey(value) {
                        kind,
                        number,
                        bytes,
                        length -> @Unsafe
                        {
                            checkNativeStatus(
                                nativeCollectionRow(
                                    pointer,
                                    node.id.number,
                                    kind,
                                    number,
                                    bytes,
                                    length
                                ),
                                "publish semantic collection row"
                            )
                        }
                    }
                }
                case None -> {}
            }
            when (node.properties.cell) {
                case Some(val cell) -> when (cell.columnKey) {
                    case Some(val key) -> withCollectionKey(key) {
                        kind,
                        number,
                        bytes,
                        length -> @Unsafe
                        {
                            checkNativeStatus(
                                nativeCollectionCell(
                                    pointer,
                                    node.id.number,
                                    kind,
                                    number,
                                    bytes,
                                    length
                                ),
                                "publish semantic cell column"
                            )
                        }
                    }
                    case None -> {}
                }
                case None -> {}
            }
        }
    }

    public override fun close() {
        val owned = callback
        application.mailbox.postControl {
            @Unsafe
            {
                releaseForeignCallback(owned)
            }
        }
    }
}

@Extern(name = "scoop_window_accessibility_collection_active")
private fun nativeCollectionActive(
    provider: Ptr<Unit>,
    owner: Long,
    collection: Long,
    kind: Int,
    number: Long,
    bytes: Ptr<UInt8>?,
    length: Long
): Long

private class CollectionQueryStatus {
    var value = 4
}

private fun gridShapeFlags(grid: SemanticGrid?): Int =
    (
        when (grid?.span ?: None) {
            case Some(_) -> 128
            case None -> 0
        }
    ) +
        (
            when (grid?.hasCells ?: None) {
                case Some(_) -> 512
                case None -> 0
            }
        )

private fun collectionActionBits(actions: SemanticCollectionActions): Int =
    (
        when (actions.realize) {
            case Some(_) -> 1;
            case None -> 0
        }
    ) +
        (
            when (actions.reveal) {
                case Some(_) -> 2;
                case None -> 0
            }
        ) +
        (
            when (actions.focus) {
                case Some(_) -> 4;
                case None -> 0
            }
        ) +
        (
            when (actions.setSelected) {
                case Some(_) -> 8;
                case None -> 0
            }
        ) +
        gridActionBits(actions.grid) +
        when (actions.setExpanded) {
            case Some(_) -> 256
            case None -> 0
        }

private fun gridActionBits(actions: SemanticGridActions?): Int {
    val grid = actions ?: return 0
    var bits = 0
    when (grid.realize) {
        case Some(_) -> bits += 16
        case None -> {}
    }
    when (grid.reveal) {
        case Some(_) -> bits += 32
        case None -> {}
    }
    when (grid.focus) {
        case Some(_) -> bits += 64
        case None -> {}
    }
    return bits
}

private fun collectionCallback(application: ApplicationOwner, provider: AccessibilityProvider):
ForeignCallback<(Ptr<Unit>, Long, Int, Long, Int, Long, Ptr<UInt8>?, Long, Ptr<Unit>?) -> Int> {
    @Unsafe
    {
        return foreignCallback<
            (Ptr<Unit>, Long, Int, Long, Int, Long, Ptr<UInt8>?, Long, Ptr<Unit>?) -> Int
        >(
            {
                owner: Long,
                operation: Int,
                index: Long,
                kind: Int,
                number: Long,
                bytes: Ptr<UInt8>?,
                length: Long,
                reply: Ptr<Unit>? -> queryCollection(
                    application,
                    provider,
                    owner,
                    operation,
                    index,
                    kind,
                    number,
                    bytes,
                    length,
                    reply
                )
            },
            0,
            ForeignCallbackMode.Reusable
        )
    }
}

private fun queryCollection(
    application: ApplicationOwner,
    provider: AccessibilityProvider,
    owner: Long,
    operation: Int,
    index: Long,
    kind: Int,
    number: Long,
    bytes: Ptr<UInt8>?,
    length: Long,
    reply: Ptr<Unit>?
): Int {
    if (
        (operation >= 3 && operation <= 8) ||
            (operation >= 12 && operation <= 15) ||
            operation ==
            17 ||
            operation ==
            18
    ) {
        val result =
            application.performAccessibility {
                val key =
                    collectionKey(kind, number, bytes, length) ?:
                        return@performAccessibility SemanticActionResult.InvalidArgument
                provider.performCollection(owner, key, operation, index)
            }
        return actionCode(result)
    }
    if (operation == 2 || operation == 16) {
        try {
            val source = provider.collectionSource(owner, true) ?: return 4
            val key = collectionKey(kind, number, bytes, length) ?: return 4
            if (operation == 16) {
                val span = source.cellSpanForIndex(key, index) ?: return 2
                val target = reply ?: return 4
                val grid = source.grid!!
                writeCollectionItem(
                    target,
                    SemanticItem(
                        grid.columns[span.column].key,
                        span.column,
                        grid.columns.size,
                        SemanticItemProperties(),
                        span.columnSpan
                    )
                )
                return 1
            }
            return if (source.contains(key))
                1
            else
                2
        } catch (error: Throwable) {
            application.recordFailure(error)
            application.beginExit()
            return 4
        }
    }
    val status = CollectionQueryStatus()
    val result =
        application.performAccessibility {
            val source = provider.collectionSource(owner, false)
            when (source) {
                case Some(val value) -> {
                    val item =
                        if (operation == 9 || operation == 10) {
                            queryCollectionText(
                                value,
                                operation,
                                index,
                                kind,
                                number,
                                bytes,
                                length,
                                reply
                            )
                        } else
                            if (operation == 11) {
                                val key = collectionKey(kind, number, bytes, length)
                                when ((key, value.grid)) {
                                    case(Some(val row), Some(val grid)) -> if (
                                        index >= 0L && index < grid.columns.size
                                    )
                                        value.cellForKey(row, grid.columns[index].key)
                                    else
                                        SemanticItemResult.NotFound
                                    else -> SemanticItemResult.Unavailable
                                }
                            } else
                                if (operation == 0)
                                    value.itemAt(index)
                                else {
                                    val key = collectionKey(kind, number, bytes, length)
                                    when (key) {
                                        case Some(val actual) -> value.itemForKey(actual)
                                        case None -> SemanticItemResult.Unavailable
                                    }
                                }
                    status.value =
                        when (item) {
                            case Found(val found) -> when (reply) {
                                case Some(val target) -> {
                                    writeCollectionItem(target, found);
                                    1
                                }
                                case None -> 4
                            }
                            case NotFound -> 2
                            case Unavailable -> 3
                            case Unsupported -> 5
                        }
                }
                case None -> {}
            }
            SemanticActionResult.Completed
        }
    return if (result == SemanticActionResult.Completed)
        status.value
    else
        0
}

private fun publishCollectionDetails(pointer: Ptr<Unit>, node: AccessibilityNode) {
    when (node.properties.selectionMode) {
        case Some(val mode) -> @Unsafe
        {
            checkNativeStatus(
                nativeCollectionSelection(
                    pointer,
                    node.id.number,
                    if (mode == SemanticSelectionMode.Multiple)
                        1
                    else
                        0,
                    if (node.properties.required)
                        1
                    else
                        0
                ),
                "publish static selection"
            )
        }
        case None -> {}
    }
    val source = node.collectionValue ?: return
    when (source.selection) {
        case Some(val selected) -> {
            @Unsafe
            {
                checkNativeStatus(
                    nativeCollectionSelection(
                        pointer,
                        node.id.number,
                        if (selected.multiple)
                            1
                        else
                            0,
                        if (selected.required)
                            1
                        else
                            0
                    ),
                    "publish collection selection"
                )
            }
            for (key in selected.keys) {
                when (source.itemForKey(key)) {
                    case Found(val item) -> {
                        if (!item.properties.selectable)
                            continue
                    }
                    else -> continue
                }
                withCollectionKey(key) {
                    kind,
                    number,
                    bytes,
                    length -> @Unsafe
                    {
                        checkNativeStatus(
                            nativeCollectionSelected(
                                pointer,
                                node.id.number,
                                kind,
                                number,
                                bytes,
                                length
                            ),
                            "publish selected collection item"
                        )
                    }
                }
            }
        }
        case None -> {}
    }
    when (source.grid) {
        case Some(val grid) -> for (index in 0L ..< grid.columns.size) {
            val column = grid.columns[index]
            withCollectionKey(column.key) {
                kind,
                number,
                bytes,
                length -> @Unsafe
                {
                    checkNativeStatus(
                        nativeCollectionColumn(
                            pointer,
                            node.id.number,
                            index,
                            kind,
                            number,
                            bytes,
                            length,
                            column.header?.number ?: 0L
                        ),
                        "publish semantic column"
                    )
                }
            }
            when (column.name) {
                case Some(val name) -> @Unsafe
                {
                    name.withUtf8Bytes {
                        bytes,
                        length -> @Unsafe
                        {
                            checkNativeStatus(
                                nativeCollectionColumnName(
                                    pointer,
                                    node.id.number,
                                    index,
                                    bytes,
                                    length
                                ),
                                "publish semantic column name"
                            )
                        }
                    }
                }
                case None -> {}
            }
        }
        case None -> {}
    }
}

