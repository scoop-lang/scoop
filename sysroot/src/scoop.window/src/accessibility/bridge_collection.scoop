private fun nativeCollectionSelection(
    provider: Ptr<Unit>,
    owner: Long,
    kind: Int,
    required: Int
): Long

@Extern(name = "scoop_window_accessibility_collection_selected")
private fun nativeCollectionSelected(
    provider: Ptr<Unit>,
    owner: Long,
    kind: Int,
    number: Long,
    text: Ptr<UInt8>?,
    length: Long
): Long

@Extern(name = "scoop_window_accessibility_collection_column")
private fun nativeCollectionColumn(
    provider: Ptr<Unit>,
    owner: Long,
    index: Long,
    kind: Int,
    number: Long,
    text: Ptr<UInt8>?,
    length: Long,
    header: Long
): Long

@Extern(name = "scoop_window_accessibility_collection_column_name")
private fun nativeCollectionColumnName(
    provider: Ptr<Unit>,
    owner: Long,
    index: Long,
    text: Ptr<UInt8>,
    length: Long
): Long

@Extern(name = "scoop_window_accessibility_collection_cell")
private fun nativeCollectionCell(
    provider: Ptr<Unit>,
    owner: Long,
    kind: Int,
    number: Long,
    text: Ptr<UInt8>?,
    length: Long
): Long

private fun collectionKey(
    kind: Int,
    number: Long,
    bytes: Ptr<UInt8>?,
    length: Long
): SemanticItemKey? {
    if (kind == 0)
        return Some(SemanticItemKey.Number(number))
    if (kind != 1 || length < 0L)
        return None
    when (bytes) {
        case Some(val text) -> {
            @Unsafe
            {
                return Some(SemanticItemKey.Text(String.fromUtf8(text, length)))
            }
        }
        case None -> return if (length == 0L)
            Some(SemanticItemKey.Text(""))
        else
            None
    }
}

private fun withCollectionKey(key: SemanticItemKey, block: (Int, Long, Ptr<UInt8>?, Long) -> Unit) {
    when (key) {
        case Number(val number) -> block(0, number, None, 0L)
        case Text(val text) -> {
            @Unsafe
            {
                text.withUtf8Bytes { bytes, length -> block(1, 0L, Some(bytes), length) }
            }
        }
    }
}

private fun writeCollectionItem(reply: Ptr<Unit>, item: SemanticItem) {
    val props = item.properties
    @Unsafe
    {
        nativeCollectionItem(
            reply,
            item.index,
            item.count,
            item.span,
            if (props.enabled)
                1
            else
                0,
            when (props.selected) {
                case None -> -1;
                case Some(val value) -> if (value)
                    1
                else
                    0
            },
            when (props.expanded) {
                case None -> -1;
                case Some(val value) -> if (value)
                    1
                else
                    0
            },
            if (props.focusable)
                1
            else
                0,
            props.hierarchyLevel ?: -1L,
            if (item.hasCells)
                1
            else
                0
        )
    }
    withCollectionKey(item.key) {
        kind,
        number,
        bytes,
        length -> @Unsafe
        {
            nativeCollectionItemKey(reply, kind, number, bytes, length)
        }
    }
    collectionText(reply, 0, props.name)
    collectionText(reply, 1, props.description)
    collectionText(reply, 2, props.automationId)
    collectionText(reply, 3, props.value)
}

private fun collectionText(reply: Ptr<Unit>, field: Int, value: String?) {
    when (value) {
        case Some(val text) -> {
            @Unsafe
            {
                text.withUtf8Bytes {
                    bytes,
                    length -> @Unsafe
                    {
                        nativeCollectionItemText(reply, field, bytes, length)
                    }
                }
            }
        }
        case None -> {}
    }
}

