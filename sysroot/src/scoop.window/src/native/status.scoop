package scoop.window

@CLayout
internal struct NativeCreateResult(val pointer: Ptr<Unit>?, val error: Long)

internal fun checkNativeStatus(code: Long, operation: String) {
    if (code == -1L)
        throw WindowException(operation, WindowErrorKind.Unsupported)
    if (code == -2L)
        throw WindowException(operation, WindowErrorKind.Unavailable)
    if (code == -3L)
        throw WindowException(operation, WindowErrorKind.Disconnected)
    if (code == -4L)
        throw WindowException(operation, WindowErrorKind.InvalidState)
    if (code == -5L)
        throw WindowException(operation, WindowErrorKind.ResourceBusy)
    if (code != 0L)
        throw WindowException(operation, WindowErrorKind.NativeFailure, nativeCode = Some(code))
}

internal fun nativeRequestStatus(
    code: Long,
    operation: String,
    success: RequestStatus = RequestStatus.Applied
): RequestStatus {
    if (code == -1L)
        return RequestStatus.Unsupported
    checkNativeStatus(code, operation)
    return success
}

internal fun requireCreationStatus(status: RequestStatus, operation: String) {
    if (status == RequestStatus.Unsupported)
        throw WindowException(operation, WindowErrorKind.Unsupported)
}

internal fun created(result: NativeCreateResult, operation: String): Ptr<Unit> {
    when (result.pointer) {
        case Some(val pointer) -> return pointer
        case None -> {
            checkNativeStatus(result.error, operation)
            throw WindowException(operation, WindowErrorKind.NativeFailure)
        }
    }
}

@Unsafe
internal fun nativeApplicationCreate(
    callback: FunPtr<(Ptr<Unit>, Long, Int) -> Int>,
    context: Ptr<Unit>,
    policy: Int,
    applicationId: String?
): Ptr<Unit> =
    (applicationId ?: "").withUtf8Bytes {
        bytes,
        length -> @Unsafe
        {
            return@withUtf8Bytes created(
                nativeApplicationCreateResult(callback, context, policy, bytes, length),
                "create application"
            )
        }
    }

@Unsafe
internal fun nativeWindowCreate(
    application: Ptr<Unit>,
    identity: Long,
    title: Ptr<UInt8>,
    length: Long,
    width: Double,
    height: Double,
    flags: Int,
    owner: Ptr<Unit>?,
    role: Int
): Ptr<Unit> =
    created(
        nativeWindowCreateResult(
            application,
            identity,
            title,
            length,
            width,
            height,
            flags,
            owner,
            role
        ),
        "create window"
    )
