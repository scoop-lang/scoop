package scoop.window

/** Enables platform composition for this window; ordinary text uses the same edit channel. */
public fun Window.setImeAllowed(allowed: Boolean): RequestStatus {
    owner.requireOpen()
    @Unsafe
    {
        if (
            nativeImeAllowed(
                owner.pointer!!,
                if (allowed)
                    1
                else
                    0
            ) !=
                0
        )
            throw WindowException("native text input", WindowErrorKind.Unavailable)
    }
    return RequestStatus.Applied
}

/** Publishes a candidate-window rectangle in logical content coordinates. */
public fun Window.setImeCursorArea(area: LogicalRect) {
    owner.requireOpen()
    checkImeCursorArea(area)
    @Unsafe
    {
        checkNativeStatus(
            nativeImeCaret(
                owner.pointer!!,
                area.origin.x,
                area.origin.y,
                area.size.width,
                area.size.height
            ),
            "ime_caret"
        )
    }
}

internal fun checkImeCursorArea(area: LogicalRect) {
    checkRect(area)
    requireWindow(
        (area.origin.x + area.size.width).isFinite() &&
            (area.origin.y + area.size.height).isFinite(),
        "IME cursor rectangle overflow"
    )
}

@CLayout
internal struct NativeTextEdit(
    val kind: Int,
    val anchor: Long,
    val cursor: Long,
    val text: Ptr<UInt8>?,
    val textLength: Long,
    val hasReplacement: Int,
    val replacementStart: Long,
    val replacementEnd: Long
)

@Extern(name = "scoop_window_ime_allowed")
internal fun nativeImeAllowed(window: Ptr<Unit>, allowed: Int): Int

@Extern(name = "scoop_window_ime_caret")
internal fun nativeImeCaret(
    window: Ptr<Unit>,
    x: Double,
    y: Double,
    width: Double,
    height: Double
): Long

@Extern(name = "scoop_window_text_count")
internal fun nativeTextCount(event: Ptr<Unit>): Long

@Extern(name = "scoop_window_text_edit")
internal fun nativeTextEdit(event: Ptr<Unit>, index: Long): NativeTextEdit

/** Copies native-owned strings before releasing the enclosing event. */
internal fun copyNativeTextBatch(pointer: Ptr<Unit>, event: NativeEvent): TextInputBatch {
    @Unsafe
    {
        val count = nativeTextCount(pointer)
        val operations = ArrayList<TextInputOperation>()
        for (index in 0L ..< count) {
            val edit = nativeTextEdit(pointer, index)
            val text =
                when (edit.text) {
                    case Some(bytes) -> String.fromUtf8(bytes, edit.textLength)
                    case None -> ""
                }
            val replacement =
                if (edit.hasReplacement != 0)
                    TextReplacement.Range(Utf8Range(edit.replacementStart, edit.replacementEnd))
                else
                    TextReplacement.CurrentSelection
            operations.add(
                when (edit.kind) {
                    0 -> TextInputOperation.Preedit(
                        text,
                        if (edit.anchor < 0L)
                            None
                        else
                            Some(Utf8Selection(edit.anchor, edit.cursor)),
                        replacement
                    )
                    1 -> TextInputOperation.Commit(text, replacement)
                    2 -> TextInputOperation.ClearPreedit
                    3 -> TextInputOperation.DeleteSurrounding(edit.anchor, edit.cursor)
                    else -> throw WindowException(
                        "unknown native text operation",
                        WindowErrorKind.NativeFailure
                    )
                }
            )
        }
        return TextInputBatch(
            if (event.flags.and(1) != 0)
                Some(event.b)
            else
                None,
            operations,
            when (platformTextConnection(event)) {
                case Some(connection) -> Some(TextInputOrigin(connection, event.c))
                case None -> None
            }
        )
    }
}
