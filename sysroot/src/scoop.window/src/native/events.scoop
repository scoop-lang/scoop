package scoop.window

/** Copies every borrowed native payload before the queue releases its owner. */
internal fun ApplicationOwner.copyNativeEvent(pointer: Ptr<Unit>): ApplicationEvent? {
    @Unsafe
    {
        val header = nativeEventHeader(pointer)
        if (header.kind == 110)
            return copyMenuActivation(nativeEventData(pointer))
        if (header.kind == 111)
            return copyPopupCompletion(nativeEventData(pointer))
        if (header.kind == 112)
            return None
        if (header.window == 0L)
            return Some(
                when (header.kind) {
                    100 -> ApplicationEvent.MonitorsChanged
                    102 -> ApplicationEvent.InteractionPreferencesChanged(
                        copyInteractionPreferences(native!!)
                    )
                    101 -> ApplicationEvent.ExitRequested(
                        if (nativeEventData(pointer).flags == 1)
                            ExitReason.User
                        else
                            ExitReason.System
                    )
                    else -> throw WindowException(
                        "unknown native application event",
                        WindowErrorKind.NativeFailure
                    )
                }
            )
        val value =
            when (header.kind) {
                10 -> WindowEvent.Keyboard(
                    copyKeyEvent(pointer, header, nativeEventKeyboard(pointer))
                )
                11 -> WindowEvent.ModifiersChanged(platformModifiers(nativeEventModifiers(pointer)))
                12 -> WindowEvent.Pointer(copyPointerEvent(header, nativeEventPointer(pointer)))
                20 -> WindowEvent.Gesture(copyGestureEvent(header, nativeEventGesture(pointer)))
                21 -> WindowEvent.Contact(copyContactEvent(header, nativeEventContact(pointer)))
                else -> copyWindowEvent(pointer, header)
            }
        return Some(ApplicationEvent.Window(WindowId(header.window), value))
    }
}

private fun copyWindowEvent(pointer: Ptr<Unit>, header: NativeEventHeader): WindowEvent {
    @Unsafe
    {
        val event = nativeEventData(pointer)
        return when (header.kind) {
            1 -> WindowEvent.CloseRequested
            2 -> WindowEvent.GeometryChanged(
                WindowMetrics(
                    LogicalSize(event.x, event.y),
                    PhysicalSize(event.z.toInt(), event.w.toInt()),
                    event.scale
                )
            )
            3 -> WindowEvent.Moved(DesktopPosition(event.x, event.y))
            4 -> WindowEvent.Focused(event.flags != 0)
            5 -> WindowEvent.Occluded(event.flags != 0)
            6 -> WindowEvent.ThemeChanged(
                Some(
                    if (event.flags != 0)
                        Theme.Dark
                    else
                        Theme.Light
                )
            )
            13 -> WindowEvent.TextInput(
                TextInputEvent.Edit(copyNativeTextBatch(pointer, header.window, event))
            )
            15 -> WindowEvent.RedrawRequested
            17 -> WindowEvent.FrameChanged
            19 -> WindowEvent.InputBlockedChanged(event.flags != 0)
            22 -> WindowEvent.SoftwareKeyboardChanged(
                copySoftwareKeyboard(event.flags, event.x, event.y, event.z, event.w)
            )
            18 -> WindowEvent.FrameButtonChanged(
                systemButtonValue(event.a.toInt()),
                event.flags.and(1) != 0,
                event.flags.and(2) != 0
            )
            16 -> WindowEvent.TextCommand(menuTextCommand(event.a.toInt()))
            14 -> WindowEvent.TextInput(
                if (event.flags != 0)
                    TextInputEvent.Enabled(platformTextConnection(header.window, event))
                else
                    TextInputEvent.Disabled(platformTextConnection(header.window, event))
            )
            else -> throw WindowException(
                "unknown native window event",
                WindowErrorKind.NativeFailure
            )
        }
    }
}
