package scoop.window

private fun copyNativeText(event: NativeKeyboardData): String {
    @Unsafe
    {
        return when (event.text) {
            case Some(val bytes) -> String.fromUtf8(bytes, event.textLength)
            case None -> ""
        }
    }
}

internal fun copyKeyEvent(
    pointer: Ptr<Unit>,
    header: NativeEventHeader,
    event: NativeKeyboardData
): KeyEvent {
    val text = copyNativeText(event)
    val logical =
        when (platformNamedKey(event.physicalCode, event.logicalCode)) {
            case Some(val value) -> LogicalKey.Named(value)
            case None -> if (event.dead != 0)
                LogicalKey.Dead(
                    if (text.byteLength > 0L)
                        Some(text)
                    else
                        None
                )
            else
                if (text.byteLength > 0L)
                    LogicalKey.Character(text)
                else
                    LogicalKey.Unidentified(
                        platformUnknownLogicalKey(event.physicalCode, event.logicalCode)
                    )
        }
    val state =
        if (event.pressed != 0)
            ElementState.Pressed
        else
            ElementState.Released
    val modifiers = platformModifiers(event.modifiers)
    val synthetic = event.synthetic != 0
    return KeyEvent(
        platformPhysicalKey(event.physicalCode),
        logical,
        platformKeyLocation(event.physicalCode),
        state,
        event.repeat != 0,
        modifiers,
        synthetic,
        copyInputTime(header),
        textCommands = platformTextCommands(pointer, logical, modifiers, state, synthetic)
    )
}

internal fun copyPointerCancelReason(reason: Int): PointerCancelReason =
    when (reason) {
        0 -> PointerCancelReason.FocusLost
        1 -> PointerCancelReason.CaptureLost
        2 -> PointerCancelReason.SystemOperation
        3 -> PointerCancelReason.Modal
        else -> throw WindowException("unknown pointer cancellation", WindowErrorKind.NativeFailure)
    }

internal fun copyPointerEvent(header: NativeEventHeader, event: NativePointerData): PointerEvent {
    val time = copyInputTime(header)
    if (event.kind == 7)
        return PointerEvent.Cancelled(copyPointerCancelReason(event.cancelReason), time)
    val state =
        PointerState(
            LogicalPosition(event.x, event.y),
            PhysicalPosition(event.physicalX, event.physicalY),
            event.scale,
            platformModifiers(event.modifiers),
            time
        )
    return when (event.kind) {
        0 -> PointerEvent.Entered(state)
        1 -> PointerEvent.Left(state)
        2 -> PointerEvent.Moved(state)
        3 -> PointerEvent.Button(
            state,
            mouseButton(event.button),
            ElementState.Pressed,
            event.clickCount
        )
        4 -> PointerEvent.Button(
            state,
            mouseButton(event.button),
            ElementState.Released,
            event.clickCount
        )
        5 -> PointerEvent.Wheel(
            state,
            ScrollDelta.LineDelta(event.deltaX, event.deltaY),
            scrollPhase(event.phase),
            scrollPhase(event.momentumPhase)
        )
        6 -> PointerEvent.Wheel(
            state,
            ScrollDelta.PixelDelta(event.deltaX, event.deltaY),
            scrollPhase(event.phase),
            scrollPhase(event.momentumPhase)
        )
        else -> throw WindowException("unknown native pointer event", WindowErrorKind.NativeFailure)
    }
}

private fun mouseButton(code: Int): MouseButton =
    when (code) {
        0 -> MouseButton.Left
        1 -> MouseButton.Right
        2 -> MouseButton.Middle
        else -> MouseButton.Other(code.toUInt())
    }

private fun scrollPhase(value: Int): ScrollPhase =
    when (value) {
        0 -> ScrollPhase.None
        1 -> ScrollPhase.MayBegin
        2 -> ScrollPhase.Began
        3 -> ScrollPhase.Stationary
        4 -> ScrollPhase.Changed
        5 -> ScrollPhase.Ended
        6 -> ScrollPhase.Cancelled
        else -> throw WindowException("unknown native scroll phase", WindowErrorKind.NativeFailure)
    }
