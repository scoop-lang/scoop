package scoop.window

import scoop.platform.time.MonotonicTimeSource

internal fun ApplicationOwner.pump(stage: Int) {
    if (pumping) {
        mailbox.wake();
        return
    }
    pumping = true
    try {
        for (control in mailbox.takeControls()) {
            try {
                control()
            } catch (error: Throwable) {
                recordFailure(error);
                beginExit()
            }
        }
        syncOwnedVisibility()
        val events = ArrayList<NativeDelivery>()
        @Unsafe
        {
            var count = 0
            while (count < 64) {
                val pointer = nativeNextEvent(native!!) ?: break
                try {
                    when (copyNativeEvent(pointer)) {
                        case Some(event) -> events.add(
                            NativeDelivery(event, copyNativeInput(pointer))
                        )
                        case None -> {}
                    }
                } finally {
                    nativeEventRelease(pointer)
                }
                count += 1
            }
            if (count == 64)
                mailbox.wake()
        }
        val business = mailbox.takeBusiness()
        val redraw = ArrayList<WindowOwner>()
        for (window in windows) {
            if (window.phase == WindowState.Open && window.dirty) {
                val value = window.snapshot()
                if (
                    value.visible !=
                        0 &&
                        value.occluded ==
                        0 &&
                        value.pixelWidth >
                        0.0 &&
                        value.pixelHeight >
                        0.0
                ) {
                    window.dirty = false
                    redraw.add(window)
                }
            }
        }
        val initial = !initialized
        initialized = true
        var flowDeadline = false
        var timed: Array<DeadlineDelivery> = []
        when (armedDeadline) {
            case Some(time) -> {
                val now = MonotonicTimeSource.markNow()
                if (time <= now) {
                    flowDeadline = consumeFlowDeadline(now)
                    timed = takeDeadlines(now)
                }
            }
            case None -> {}
        }
        if (flowDeadline || timed.size > 0L || stage == 1)
            refreshDeadline(stage == 1)
        val hasBatch =
            initial ||
                flowDeadline ||
                timed.size >
                0L ||
                events.size >
                0L ||
                business.size >
                0L ||
                redraw.size >
                0L ||
                flow ==
                ControlFlow.Poll
        if (!exiting && hasBatch) {
            val cause =
                if (initial)
                    StartCause.Init
                else
                    if (flowDeadline)
                        StartCause.Deadline
                    else
                        if (flow == ControlFlow.Poll)
                            StartCause.Poll
                        else
                            StartCause.Wake
            deliver(ApplicationEvent.NewEvents(cause))
            if (initial)
                deliver(ApplicationEvent.Resumed)
            for (event in events)
                dispatchNative(event.event, event.input)
            for (block in business)
                deliverBusiness(block)
            for (delivery in timed)
                deliverBusiness { delivery.deliver() }
            for (window in redraw)
                deliverWindow(window, WindowEvent.RedrawRequested)
            deliver(ApplicationEvent.AboutToWait)
        }
        drainShutdown()
        if (!exiting && flow == ControlFlow.Poll)
            mailbox.wake()
    } finally {
        pumping = false
    }
}

internal fun ApplicationOwner.deliverBusiness(block: () -> Unit) {
    if (exiting)
        return
    val invocation: () -> Unit =
        {
            if (!exiting) {
                dispatchDepth += 1
                try {
                    block()
                }
                catch (error: Throwable) {
                    recordFailure(error);
                    beginExit()
                }
                finally {
                    dispatchDepth -= 1;
                    if (exiting)
                        mailbox.wake()
                }
            }
        }
    when (attachment) {
        case Some(value) -> if (!value.post(invocation))
            beginExit()
        case None -> invocation()
    }
}

internal fun ApplicationOwner.deliver(event: ApplicationEvent) {
    deliverBusiness { handler!!.onEvent(active, event) }
}

internal fun ApplicationOwner.deliverWindow(
    window: WindowOwner,
    event: WindowEvent,
    input: NativeInputDelivery? = None
) {
    deliverBusiness {
        try {
            if (window.phase == WindowState.Open || window.phase == WindowState.PendingConfigure) {
                var ready = !window.inputBlocked || modalInputAllowed(event)
                when (event) {
                    case GeometryChanged(value) -> {
                        window.metrics = Some(value)
                        window.phase = WindowState.Open
                        window.notifyActivity()
                    }
                    case Focused(_) -> window.notifyActivity()
                    case Occluded(_) -> window.notifyActivity()
                    case RedrawRequested -> {
                        val value = window.snapshot()
                        ready =
                            value.visible !=
                                0 &&
                                value.occluded ==
                                0 &&
                                value.pixelWidth >
                                0.0 &&
                                value.pixelHeight >
                                0.0
                        if (!ready)
                            window.dirty = true
                    }
                    else -> {}
                }
                if (ready && window.phase == WindowState.Open) {
                    window.currentInput = input
                    handler!!.onEvent(active, ApplicationEvent.Window(window.id, event))
                    window.currentInput = None
                    when (window.pendingSystemCancellation) {
                        case Some(time) -> {
                            window.pendingSystemCancellation = None
                            if (window.phase == WindowState.Open && !exiting)
                                handler!!.onEvent(
                                    active,
                                    ApplicationEvent.Window(
                                        window.id,
                                        WindowEvent.Pointer(
                                            PointerEvent.Cancelled(
                                                PointerCancelReason.SystemOperation,
                                                time
                                            )
                                        )
                                    )
                                )
                        }
                        case None -> {}
                    }
                }
            }
        } finally {
            window.currentInput = None
            when (input) {
                case Some(value) -> value.close();
                case None -> {}
            }
        }
    }
}

internal fun ApplicationOwner.dispatchNative(event: ApplicationEvent, input: NativeInputDelivery?) {
    when (event) {
        case Menu(activation) -> deliverMenu(activation)
        case Window(identity, notification) -> {
            val window = findWindow(identity.value)
            when (window) {
                case Some(value) -> deliverWindow(value, notification, input)
                case None -> when (input) {
                    case Some(value) -> value.close();
                    case None -> {}
                }
            }
        }
        case MonitorsChanged -> {
            refreshMonitors();
            deliver(event)
        }
        else -> deliver(event)
    }
}
