package scoop.window

import scoop.collections.sortedBy
import scoop.platform.time.MonotonicTimeSource
import scoop.platform.time.MonotonicInstant

internal class DeadlineDelivery(
    val deadline: WindowDeadline,
    val revision: ULong,
    val time: MonotonicInstant
) {
    fun deliver() {
        deadline.deliver(revision)
    }
}

internal fun ApplicationOwner.takeDeadlines(now: MonotonicInstant): Array<DeadlineDelivery> {
    val ready = ArrayList<DeadlineDelivery>()
    for (deadline in deadlines) {
        when (deadline.scheduled) {
            case Some(val time) -> if (time <= now) {
                ready.add(DeadlineDelivery(deadline, deadline.revision, time))
                deadline.scheduled = None
            }
            case None -> {}
        }
    }
    return ready.sortedBy<DeadlineDelivery, MonotonicInstant> { item -> item.time }.toArray()
}

internal fun ApplicationOwner.consumeFlowDeadline(now: MonotonicInstant): Boolean =
    when (flow) {
        case WaitUntil(val time) -> if (time <= now) {
            flow = ControlFlow.Wait
            true
        } else
            false
        else -> false
    }

internal fun ApplicationOwner.refreshDeadline(force: Boolean = false) {
    val pointer = native ?: return
    var next: MonotonicInstant? = None
    if (!exiting) {
        when (flow) {
            case WaitUntil(val time) -> next = Some(time)
            else -> {}
        }
        for (deadline in deadlines) {
            when (deadline.scheduled) {
                case Some(val time) -> if (next == None || time < next!!)
                    next = Some(time)
                case None -> {}
            }
        }
    }
    if (!force && next == armedDeadline)
        return
    val seconds =
        when (next) {
            case None -> -1.0
            case Some(val time) -> {
                val now = MonotonicTimeSource.now()
                if (time <= now)
                    0.0
                else {
                    val remaining = time - now
                    remaining.floorSeconds.toDouble() +
                        remaining.nanosecondsOfSecond.toDouble() /
                        1000000000.0
                }
            }
        }
    armedDeadline = next
    @Unsafe
    {
        nativeApplicationDeadline(pointer, seconds)
    }
}

internal fun ApplicationOwner.retireDeadlines(window: WindowOwner) {
    var index = 0L
    while (index < deadlines.size) {
        val deadline = deadlines[index]
        if (deadline.window === window) {
            deadline.retire()
            deadlines.removeAt(index)
        } else
            index += 1L
    }
    refreshDeadline()
}
