package scoop.window

import scoop.platform.concurrent.ThreadId
import scoop.platform.concurrent.currentThreadId
import scoop.time.TimeMark
import scoop.window.native.ApplicationAttachment
import scoop.window.native.ApplicationHost
import scoop.window.native.ApplicationWatch
import scoop.window.native.NativeApplicationLease
import scoop.window.native.dispatchWatch

internal class ApplicationOwner(
    val lastWindowPolicy: LastWindowPolicy,
    private val activationPolicy: Int
) {
    val mailbox: ApplicationMailbox = ApplicationMailbox()
    val windows: ArrayList<WindowOwner> = ArrayList<WindowOwner>()
    val modals = ArrayList<ModalSession>()
    var nextModal = 1L
    val menus = ArrayList<MenuOwner>()
    val nativeResources = ArrayList<NativeApplicationLease>()
    var nextMenu = 1L
    var nextMenuItem = 1L
    var nextMenuUse = 1L
    var nextPopup = 1L
    val pendingInputs = ArrayList<NativeInputDelivery>()
    val nativeOperations = ArrayList<() -> Unit>()
    var nativeOperationDepth = 0
    val deadlines = ArrayList<WindowDeadline>()
    var armedDeadline: TimeMark? = None
    var monitorRecords: ArrayList<MonitorRecord> = ArrayList<MonitorRecord>()
    var nextMonitor: Long = 1L
    val watches: ArrayList<ApplicationWatch> = ArrayList<ApplicationWatch>()
    var nextWatch: Long = 1L
    val active: ActiveApplication get() = ActiveApplication(this)
    var native: Ptr<Unit>? = None
    var handler: ApplicationHandler? = None
    var attachment: ApplicationAttachment? = None
    var attached: Boolean = false
    var attachmentComplete: Boolean = false
    var attachmentCloseRequested: Boolean = false
    var exiting: Boolean = false
    var exitingDelivered: Boolean = false
    var stopped: Boolean = false
    var initialized: Boolean = false
    var dispatchDepth: Int = 0
    var pumping: Boolean = false
    var flow: ControlFlow = ControlFlow.Wait
    var failure: Throwable? = None
    private var thread: ThreadId? = None
    private var started: Boolean = false
    private var nextWindow: Long = 1L
    private var createdWindow: Boolean = false

    fun isCurrentThread(): Boolean = thread == Some(currentThreadId())
    fun checkThread() {
        if (!isCurrentThread())
            throw IllegalStateException(
                Some("window operation requires the application owner thread")
            )
    }

    fun run(handler: ApplicationHandler, attach: ((ApplicationHost) -> ApplicationAttachment)?) {
        @Unsafe
        {
            if (nativeIsMainThread() == 0)
                throw IllegalStateException(
                    Some("Application.run requires the process main thread")
                )
        }
        when (currentJobOrNone()) {
            case Some(_) -> throw IllegalStateException(
                Some("Application.run requires a caller outside a Job")
            )
            case None -> {}
        }
        if (started)
            throw IllegalStateException(Some("Application.run is single-use"))
        started = true
        thread = Some(currentThreadId())
        this.handler = Some(handler)
        @Unsafe
        {
            val callback =
                foreignCallback<(Ptr<Unit>, Long, Int) -> Int>(
                    {
                        identity: Long, stage: Int ->
                        nativeCallback(identity, stage);
                        0
                    },
                    0,
                    ForeignCallbackMode.Reusable
                )
            try {
                val pointer =
                    nativeApplicationCreate(callback.function, callback.context, activationPolicy)
                native = Some(pointer)
                mailbox.bind(pointer)
                try {
                    when (attach) {
                        case Some(install) -> {
                            attached = true;
                            attachment = Some(install(ApplicationHost(this)))
                        }
                        case None -> {}
                    }
                } catch (error: Throwable) {
                    attached = false
                    recordFailure(error)
                    beginExit()
                }
                mailbox.wake()
                while (!stopped) {
                    val status = nativeApplicationRun(pointer)
                    if (!stopped) {
                        recordFailure(
                            WindowException(
                                "native application loop",
                                WindowErrorKind.NativeFailure,
                                nativeCode = Some(status.toLong())
                            )
                        )
                        beginExit()
                        pump(0)
                    }
                }
            } finally {
                mailbox.unbind()
                when (native) {
                    case Some(pointer) -> {
                        nativeApplicationDestroy(pointer);
                        native = None
                    };
                    case None -> {}
                }
                releaseForeignCallback(callback)
            }
        }
        when (failure) {
            case Some(error) -> throw error;
            case None -> {}
        }
    }

    fun nativeCallback(identity: Long, stage: Int) {
        try {
            if (identity == 0L) {
                pump(stage)
                drainNativeOperations()
            } else
                dispatchWatch(identity, stage)
        }
        catch (error: Throwable) {
            recordFailure(error);
            beginExit();
            drainShutdown()
        }
    }

    fun createWindow(attributes: WindowAttributes): Window {
        checkThread()
        if (exiting || native == None)
            throw WindowException("create window", WindowErrorKind.InvalidState)
        validateAttributes(attributes)
        val parent = relationOwner(attributes.relation)
        if (attributes.role == WindowRole.Tool && !managementCapabilities().toolWindow)
            throw WindowException("tool window role", WindowErrorKind.Unsupported)
        attributes.size.toPhysical(1.0)
        if (nextWindow == 9223372036854775807L)
            throw WindowException("window identity", WindowErrorKind.NativeFailure)
        val identity = WindowId(nextWindow)
        nextWindow += 1L
        val flags =
            flag(frameCode(attributes.frame) != 2) +
                flag(attributes.resizable) *
                2 +
                flag(attributes.transparent) *
                4
        val size = attributes.size
        @Unsafe
        {
            val pointer =
                attributes.title.withUtf8Bytes(
                    fun(title: Ptr<UInt8>, count: Long): Ptr<Unit> {
                        @Unsafe
                        {
                            return nativeWindowCreate(
                                native!!,
                                identity.value,
                                title,
                                count,
                                size.width,
                                size.height,
                                flags,
                                when (parent) {
                                    case Some(value) -> value.pointer;
                                    case None -> None
                                },
                                if (attributes.role == WindowRole.Tool)
                                    1
                                else
                                    0
                            )
                        }
                    }
                )
            val owner = WindowOwner(this, identity, pointer)
            owner.owningWindow = parent
            owner.role = attributes.role
            try {
                applyCreationProperties(owner, attributes)
                owner.metrics = platformWindowMetrics(pointer)
                if (owner.metrics == None)
                    owner.phase = WindowState.PendingConfigure
            } catch (error: Throwable) {
                nativeWindowDestroy(pointer)
                throw error
            }
            windows.add(owner)
            updateModalInput()
            createdWindow = true
            owner.requestedVisible = attributes.visible
            when (parent) {
                case Some(value) -> {
                    val snapshot = value.snapshot()
                    owner.visibilitySuppressed =
                        !value.requestedVisible ||
                            value.visibilitySuppressed ||
                            snapshot.visible ==
                            0 ||
                            snapshot.minimized !=
                            0
                }
                case None -> {}
            }
            if (attributes.visible && !owner.visibilitySuppressed) {
                checkNativeStatus(nativeWindowVisible(pointer, 1), "visible")
                if (attributes.requestActivation && !owner.inputBlocked)
                    nativeRequestStatus(
                        nativeWindowFocus(pointer),
                        "focus",
                        RequestStatus.Requested
                    )
            }
            return Window(owner)
        }
    }

    fun findWindow(identity: Long): WindowOwner? {
        for (window in windows)
            if (window.id.value == identity)
                return Some(window)
        return None
    }

    fun setControlFlow(flow: ControlFlow) {
        checkThread()
        if (exiting)
            throw WindowException("set control flow", WindowErrorKind.InvalidState)
        when (flow) {
            case WaitUntil(mark) -> checkDeadlineTime(mark)
            else -> {}
        }
        this.flow = flow
        refreshDeadline()
        if (flow == ControlFlow.Poll)
            mailbox.wake()
    }

    fun beginExit() {
        if (exiting)
            return
        exiting = true
        for (input in pendingInputs.toArray())
            input.close()
        mailbox.closeBusiness()
        refreshDeadline()
        for (menu in menus.toArray())
            menu.close(PopupCancelReason.ApplicationExit)
        for (resource in nativeResources.toArray())
            resource.requestClose()
        for (window in windows)
            window.close()
        mailbox.wake()
    }

    fun complete(error: Throwable?) {
        checkThread()
        if (!attached || attachmentComplete)
            throw IllegalStateException(Some("unexpected application attachment completion"))
        attachmentComplete = true
        when (error) {
            case Some(value) -> recordFailure(value);
            case None -> {}
        }
        beginExit()
        mailbox.wake()
    }

    fun recordFailure(error: Throwable) {
        failure =
            Some(
                when (failure) {
                    case Some(previous) -> ResourceUseException(previous, error);
                    case None -> error
                }
            )
    }

    fun didDestroyWindow() {
        if (
            !exiting &&
                createdWindow &&
                windows.size ==
                0L &&
                lastWindowPolicy ==
                LastWindowPolicy.Exit
        )
            beginExit()
    }
}
