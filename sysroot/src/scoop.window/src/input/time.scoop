package scoop.window

import scoop.platform.time.MonotonicInstant

/** Native occurrence time, or receipt time when the original clock is unavailable. */
public enum InputTime {
    Event(MonotonicInstant), Observed(MonotonicInstant)
}

/** Returns the captured time in the same clock domain used for frames and deadlines. */
public fun InputTime.mark(): MonotonicInstant =
    when (this) {
        case Event(val value) -> value
        case Observed(val value) -> value
    }

internal fun copyInputTime(event: NativeEventHeader): InputTime {
    if (event.timeNanoseconds < 0L || event.timeNanoseconds >= 1000000000L)
        throw WindowException("native input clock failed", WindowErrorKind.NativeFailure)
    return InputTime.Observed(MonotonicInstant(event.timeSeconds, event.timeNanoseconds.toInt()))
}
