package scoop.window

/** Optional content-size limits; each present size is finite and nonnegative. */
public struct WindowSizeConstraints(val min: LogicalSize? = None, val max: LogicalSize? = None) {
    internal fun validate() {
        when (min) {
            case Some(value) -> checkSize(value);
            case None -> {}
        }
        when (max) {
            case Some(value) -> checkSize(value);
            case None -> {}
        }
        when ((min, max)) {
            case(Some(low), Some(high)) -> requireWindow(
                low.width <= high.width && low.height <= high.height,
                "inconsistent size constraints"
            )
            else -> {}
        }
    }
    internal fun check(size: LogicalSize) {
        when (min) {
            case Some(value) -> requireWindow(
                size.width >= value.width && size.height >= value.height,
                "size is below its minimum"
            );
            case None -> {}
        }
        when (max) {
            case Some(value) -> requireWindow(
                size.width <= value.width && size.height <= value.height,
                "size exceeds its maximum"
            );
            case None -> {}
        }
    }
}

/** Requests desktop placement in global display-system coordinates. */
public fun Window.requestPosition(position: DesktopPosition): RequestStatus {
    owner.requireOpen()
    requireWindow(position.x.isFinite() && position.y.isFinite(), "non-finite desktop position")
    @Unsafe
    {
        return nativeRequestStatus(
            nativeWindowPosition(owner.pointer!!, position.x, position.y),
            "position",
            RequestStatus.Requested
        )
    }
}

/** Updates native limits and requests a clamped content size when necessary. */
public fun Window.setSizeConstraints(constraints: WindowSizeConstraints): RequestStatus {
    owner.requireOpen();
    constraints.validate()
    val minimum = constraints.min ?: LogicalSize(0.0, 0.0)
    val maximum = constraints.max ?: LogicalSize(-1.0, -1.0)
    @Unsafe
    {
        val status =
            nativeRequestStatus(
                nativeWindowConstraints(
                    owner.pointer!!,
                    minimum.width,
                    minimum.height,
                    maximum.width,
                    maximum.height
                ),
                "constraints",
                RequestStatus.Requested
            )
        if (status == RequestStatus.Unsupported)
            return status
    }
    owner.constraints = constraints
    return RequestStatus.Requested
}

/** Sets positive interactive resize steps, or restores the native default. */
public fun Window.setResizeIncrements(increments: LogicalSize?): RequestStatus {
    owner.requireOpen()
    val value = increments ?: LogicalSize(1.0, 1.0)
    checkIncrements(value)
    @Unsafe
    {
        return nativeRequestStatus(
            nativeWindowResizeIncrements(owner.pointer!!, value.width, value.height),
            "resize_increments"
        )
    }
}

/** Enables or disables interactive window resizing. */
public fun Window.setResizable(value: Boolean): RequestStatus {
    owner.requireOpen()
    @Unsafe
    {
        return nativeRequestStatus(nativeWindowResizable(owner.pointer!!, flag(value)), "resizable")
    }
}

/** Sets the native close, minimize, and zoom button availability. */
public fun Window.setEnabledButtons(buttons: WindowButtons): RequestStatus {
    owner.requireOpen()
    @Unsafe
    {
        val status =
            nativeRequestStatus(
                nativeWindowButtons(
                    owner.pointer!!,
                    flag(buttons.close),
                    flag(buttons.minimize),
                    flag(buttons.maximize)
                ),
                "buttons"
            )
        if (status == RequestStatus.Unsupported)
            return status
    }
    owner.buttons = buttons
    return RequestStatus.Applied
}

/** Selects a native ordering level without claiming keyboard focus. */
public fun Window.setWindowLevel(level: WindowLevel): RequestStatus {
    owner.requireOpen()
    if (
        level ==
            WindowLevel.AlwaysOnBottom &&
            (owner.hasOwner || owner.application.hasOwnedWindow(owner))
    )
        return RequestStatus.Unsupported
    val value =
        when (level) {
            case Normal -> 0;
            case AlwaysOnTop -> 1;
            case AlwaysOnBottom -> -1
        }
    @Unsafe
    {
        return nativeRequestStatus(nativeWindowLevel(owner.pointer!!, value), "level")
    }
}

/** Requests native miniaturization or restoration. */
public fun Window.requestMinimized(value: Boolean): RequestStatus {
    owner.requireOpen()
    if (value) {
        owner.application.cancelOwnedModals(owner, ModalCancelReason.OwnerHidden)
        when (owner.modalSession) {
            case Some(session) -> session.end(ModalResult.Cancelled(ModalCancelReason.WindowHidden))
            case None -> {}
        }
    }
    @Unsafe
    {
        return nativeRequestStatus(
            nativeWindowMinimized(owner.pointer!!, flag(value)),
            "minimized",
            RequestStatus.Requested
        )
    }
}

/** Requests native maximization or restoration; the OS determines the actual frame. */
public fun Window.requestMaximized(value: Boolean): RequestStatus {
    owner.requireOpen()
    @Unsafe
    {
        return nativeRequestStatus(
            nativeWindowMaximized(owner.pointer!!, flag(value)),
            "maximized",
            RequestStatus.Requested
        )
    }
}

/** Observes native miniaturization. */
public val Window.isMinimized: Boolean? get() {
    val value = owner.snapshot().minimized
    return if (value < 0)
        None
    else
        Some(value != 0)
}

/** Observes native zoom state. */
public val Window.isMaximized: Boolean? get() {
    val value = owner.snapshot().maximized
    return if (value < 0)
        None
    else
        Some(value != 0)
}

/** Requests a preferred appearance; None follows the application/system. */
public fun Window.requestTheme(theme: Theme?): RequestStatus {
    owner.requireOpen()
    val value =
        when (theme) {
            case Some(Theme.Light) -> 0;
            case Some(Theme.Dark) -> 1;
            case None -> -1
        }
    @Unsafe
    {
        return nativeRequestStatus(
            nativeWindowTheme(owner.pointer!!, value),
            "theme",
            RequestStatus.Requested
        )
    }
}

/** Controls the window background opacity independently of a blur request. */
public fun Window.setTransparent(value: Boolean): RequestStatus {
    owner.requireOpen()
    @Unsafe
    {
        return nativeRequestStatus(
            nativeWindowTransparent(owner.pointer!!, flag(value)),
            "transparent"
        )
    }
}

/** Places a native visual-effect background behind the renderer host view. */
public fun Window.setBlur(value: Boolean): RequestStatus {
    owner.requireOpen()
    @Unsafe
    {
        return nativeRequestStatus(nativeWindowBlur(owner.pointer!!, flag(value)), "blur")
    }
}

/** Requests the system's content-sharing hint, without promising capture prevention. */
public fun Window.setContentProtected(value: Boolean): RequestStatus {
    owner.requireOpen()
    @Unsafe
    {
        return nativeRequestStatus(
            nativeWindowContentProtection(owner.pointer!!, flag(value)),
            "content_protection"
            ,
            RequestStatus.Requested
        )
    }
}

/** Requests or cancels native user attention independently of activation. */
public fun Window.requestAttention(kind: AttentionKind): RequestStatus {
    owner.requireOpen()
    val value =
        when (kind) {
            case Informational -> 0;
            case Critical -> 1;
            case Cancel -> -1
        }
    @Unsafe
    {
        return nativeRequestStatus(
            nativeWindowAttention(owner.pointer!!, value),
            "attention",
            RequestStatus.Requested
        )
    }
}

internal fun flag(value: Boolean): Int =
    if (value)
        1
    else
        0

internal fun checkIncrements(value: LogicalSize) {
    checkSize(value)
    requireWindow(value.width > 0.0 && value.height > 0.0, "resize increments must be positive")
}

internal fun validateAttributes(attributes: WindowAttributes) {
    checkSize(attributes.size)
    attributes.constraints.validate()
    attributes.constraints.check(attributes.size)
    when (attributes.position) {
        case Some(value) -> requireWindow(
            value.x.isFinite() && value.y.isFinite(),
            "non-finite desktop position"
        );
        case None -> {}
    }
    when (attributes.resizeIncrements) {
        case Some(value) -> checkIncrements(value);
        case None -> {}
    }
}

internal fun applyCreationProperties(owner: WindowOwner, attributes: WindowAttributes) {
    val window = Window(owner)
    @Unsafe
    {
        platformCreationProperties(owner.pointer!!, attributes.titlebarFlags)
    }
    requireCreationStatus(window.setFrame(attributes.frame), "frame")
    requireCreationStatus(window.setShadow(attributes.shadow), "shadow")
    requireCreationStatus(window.setSizeConstraints(attributes.constraints), "constraints")
    requireCreationStatus(
        window.setResizeIncrements(attributes.resizeIncrements),
        "resize_increments"
    )
    requireCreationStatus(window.setEnabledButtons(attributes.buttons), "buttons")
    requireCreationStatus(window.setWindowLevel(attributes.level), "level")
    requireCreationStatus(window.requestTheme(attributes.theme), "theme")
    requireCreationStatus(window.setBlur(attributes.blur), "blur")
    requireCreationStatus(
        window.setContentProtected(attributes.contentProtected),
        "content_protection"
    )
    when (attributes.position) {
        case Some(value) -> requireCreationStatus(window.requestPosition(value), "position");
        case None -> {}
    }
}
