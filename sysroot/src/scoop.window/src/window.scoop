package scoop.window

/** Mutable creation attributes, copied before creating the native object. */
public class WindowAttributes internal constructor(
    public val title: String = "Scoop",
    public val size: LogicalSize = LogicalSize(800.0, 600.0),
    public val visible: Boolean = true,
    public val decorations: Boolean = true,
    public val resizable: Boolean = true,
    public val transparent: Boolean = false,
    public val requestActivation: Boolean = true,
    public val constraints: WindowSizeConstraints = WindowSizeConstraints(),
    public val position: DesktopPosition? = None,
    public val resizeIncrements: LogicalSize? = None,
    public val buttons: WindowButtons = WindowButtons(),
    public val level: WindowLevel = WindowLevel.Normal,
    public val theme: Theme? = None,
    public val blur: Boolean = false,
    public val contentProtected: Boolean = false
    ,
    internal val titlebarFlags: Int = 0
)

/** An explicitly destroyed native window owned by its application's thread. */
public class Window internal constructor(internal val owner: WindowOwner) {
    public val id: WindowId get() = owner.id
    public val state: WindowState get() {
        owner.application.checkThread();
        return owner.phase
    }
    public val metrics: WindowMetrics? get() {
        owner.application.checkThread();
        return owner.metrics
    }
    /** Creates an inactive, owner-thread deadline that closes with this window. */
    public fun createDeadline(callback: () -> Unit): WindowDeadline {
        owner.requireOpen()
        val value = WindowDeadline(owner, callback)
        owner.application.deadlines.add(value)
        return value
    }
    public val activity: WindowActivity get() = owner.activitySnapshot()
    /** Observes changes without acquiring a native lease or requesting frames. */
    public fun observeActivity(callback: (WindowActivity) -> Unit): Closeable {
        owner.requireOpen()
        val value = WindowActivityObserver(owner, owner.activitySnapshot(), callback)
        owner.activityObservers.add(value)
        return value
    }
    /** Coalesces a redraw until this window can draw; never calls a handler recursively. */
    public fun requestRedraw() {
        owner.requireOpen();
        owner.dirty = true;
        owner.application.mailbox.wake()
    }
    /** Starts Closing; existing leases delay the eventual Destroyed event. */
    public fun requestDestroy() {
        owner.application.checkThread();
        owner.close()
    }
    /** Requests a content size; native geometry notifications report the observed result. */
    public fun requestSize(size: LogicalSize): RequestStatus {
        owner.requireOpen();
        checkSize(size);
        owner.constraints.check(size)
        size.toPhysical(1.0)
        @Unsafe
        {
            checkNativeStatus(nativeWindowSize(owner.pointer!!, size.width, size.height), "size")
        }
        return RequestStatus.Requested
    }
    public fun setTitle(title: String) {
        owner.requireOpen()
        @Unsafe
        {
            title.withUtf8Bytes {
                pointer,
                count -> @Unsafe
                {
                    checkNativeStatus(nativeWindowTitle(owner.pointer!!, pointer, count), "title")
                }
            }
        }
    }
    public fun setVisible(visible: Boolean): RequestStatus {
        owner.requireOpen()
        @Unsafe
        {
            checkNativeStatus(
                nativeWindowVisible(
                    owner.pointer!!,
                    if (visible)
                        1
                    else
                        0
                ),
                "visible"
            )
        }
        owner.application.mailbox.wake()
        owner.notifyActivity()
        return RequestStatus.Applied
    }
    /** Asks the window system to activate this window; native events confirm focus. */
    public fun requestFocus(): RequestStatus {
        owner.requireOpen()
        @Unsafe
        {
            checkNativeStatus(nativeWindowFocus(owner.pointer!!), "focus")
        }
        return RequestStatus.Requested
    }
    public val isVisible: Boolean get() = owner.snapshot().visible != 0
    public val isFocused: Boolean get() = owner.snapshot().focused != 0
    public val isOccluded: Boolean get() = owner.snapshot().occluded != 0
    public val observedTheme: Theme? get() =
        Some(
            if (owner.snapshot().dark != 0)
                Theme.Dark
            else
                Theme.Light
        )
    public val desktopPosition: DesktopPosition? get() {
        val value = owner.snapshot();
        return Some(DesktopPosition(value.x, value.y))
    }
    public val outerBounds: DesktopRect? get() {
        val value = owner.snapshot();
        return Some(
            DesktopRect(DesktopPosition(value.x, value.y), value.outerWidth, value.outerHeight)
        )
    }
    /** AppKit and Win32 need no frame callback; presentation belongs to the renderer. */
    public fun prePresentNotify() {
        owner.requireOpen()
    }
}

internal class WindowOwner(val application: ApplicationOwner, val id: WindowId, native: Ptr<Unit>) {
    val activityObservers = ArrayList<WindowActivityObserver>()
    var constraints: WindowSizeConstraints = WindowSizeConstraints()
    var buttons: WindowButtons = WindowButtons()
    var pointer: Ptr<Unit>? = Some(native)
    var phase: WindowState = WindowState.Open
    var metrics: WindowMetrics? = None
    var dirty: Boolean = false
    var closingDelivered: Boolean = false
    var leases: Long = 0L
    fun requireOpen() {
        application.checkThread()
        if (phase != WindowState.Open && phase != WindowState.PendingConfigure)
            throw WindowException("window operation", WindowErrorKind.InvalidState)
    }
    fun snapshot(): NativeSnapshot {
        requireOpen();
        @Unsafe
        {
            return nativeWindowSnapshot(pointer!!)
        }
    }
    fun close() {
        if (phase == WindowState.Closing || phase == WindowState.Destroyed)
            return
        phase = WindowState.Closing
        dirty = false
        for (observer in activityObservers.toArray())
            observer.close()
        application.retireDeadlines(this)
        application.mailbox.wake()
    }
}
