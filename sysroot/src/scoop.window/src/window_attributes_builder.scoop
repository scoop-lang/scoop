package scoop.window

/** Configures one complete value; execution remains explicit. */
public fun windowAttributes(configure: WindowAttributesBuilder.() -> Unit = {}): WindowAttributes {
    val builder = WindowAttributesBuilder()
    builder.configure()
    return builder.snapshot()
}

public fun WindowAttributes.copy(
    configure: WindowAttributesBuilder.() -> Unit = {}
): WindowAttributes {
    val builder = WindowAttributesBuilder()
    builder.title = this.title
    builder.size = this.size
    builder.visible = this.visible
    builder.decorations = this.decorations
    builder.resizable = this.resizable
    builder.transparent = this.transparent
    builder.requestActivation = this.requestActivation
    builder.constraints = this.constraints
    builder.position = this.position
    builder.resizeIncrements = this.resizeIncrements
    builder.buttons = this.buttons
    builder.level = this.level
    builder.theme = this.theme
    builder.blur = this.blur
    builder.contentProtected = this.contentProtected
    builder.titlebarFlags = this.titlebarFlags
    builder.configure()
    return builder.snapshot()
}

public class WindowAttributesBuilder internal constructor() {
    internal var titlebarFlags: Int = 0
    public var title: String = "Scoop"
    public var size: LogicalSize = LogicalSize(800.0, 600.0)
    public var visible: Boolean = true
    public var decorations: Boolean = true
    public var resizable: Boolean = true
    public var transparent: Boolean = false
    public var requestActivation: Boolean = true
    public var constraints: WindowSizeConstraints = WindowSizeConstraints()
    public var position: DesktopPosition? = None
    public var resizeIncrements: LogicalSize? = None
    public var buttons: WindowButtons = WindowButtons()
    public var level: WindowLevel = WindowLevel.Normal
    public var theme: Theme? = None
    public var blur: Boolean = false
    public var contentProtected: Boolean = false
    internal fun snapshot(): WindowAttributes =
        WindowAttributes(
            title,
            size,
            visible,
            decorations,
            resizable,
            transparent,
            requestActivation,
            constraints,
            position,
            resizeIncrements,
            buttons,
            level,
            theme,
            blur,
            contentProtected,
            titlebarFlags
        )
}
