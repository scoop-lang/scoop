package scoop.window

/** Begins native data dragging from the currently dispatched mouse or direct-contact input. */
public fun Window.beginDrag(
    content: DragContent,
    effects: DragEffects = DragEffects(true, false, false),
    localData: Any? = None,
    preview: DragPreview? = None,
    onCompleted: (DragResult) -> Unit = {}
): DragSession {
    owner.requireInteractive()
    val input =
        owner.currentInput ?: throw WindowException("begin data drag", WindowErrorKind.InvalidState)
    val pointer =
        input.pointer ?: throw WindowException("begin data drag", WindowErrorKind.InvalidState)
    if (owner.systemOperationPending)
        throw WindowException("begin data drag", WindowErrorKind.ResourceBusy)
    when (owner.application.dragSource) {
        case Some(_) -> throw WindowException("begin data drag", WindowErrorKind.ResourceBusy)
        case None -> {}
    }
    checkDragContent(content, effects)
    val session = DragSession(owner, effects, localData, onCompleted)
    session.bind(prepareDragSource(owner, pointer, content, effects, preview, session))
    session.schedule(input.time)
    return session
}

private fun prepareDragSource(
    owner: WindowOwner,
    input: Ptr<Unit>,
    content: DragContent,
    effects: DragEffects,
    preview: DragPreview?,
    session: DragSession
): NativeDragSource {
    @Unsafe
    {
        val callback =
            foreignCallback<(Ptr<Unit>, Int, Int) -> Int>(
                { phase: Int, effect: Int -> session.nativeEvent(phase, effect) },
                0,
                ForeignCallbackMode.Reusable
            )
        var allocated: Ptr<Unit>? = None
        try {
            val mask =
                (
                    if (effects.copy)
                        1
                    else
                        0
                ) +
                    (
                        if (effects.move)
                            2
                        else
                            0
                    ) +
                    (
                        if (effects.link)
                            4
                        else
                            0
                    )
            val pointer =
                created(
                    nativeDragCreate(
                        owner.pointer!!,
                        input,
                        mask,
                        callback.function,
                        callback.context
                    ),
                    "prepare data drag"
                )
            allocated = Some(pointer)
            when (content) {
                case Text(val value) -> addDragText(pointer, 1, value)
                case Url(val value) -> addDragText(pointer, 2, value)
                case Files(val paths) -> for (path in paths) {
                    val status =
                        withDialogString(path.toOsString()) {
                            bytes,
                            count -> @Unsafe
                            {
                                return@withDialogString nativeDragAddPath(pointer, bytes, count)
                            }
                        }
                    checkDragContent(status)
                }
            }
            when (preview) {
                case Some(val value) -> {
                    val metrics =
                        platformObservedMetrics(owner) ?:
                            throw WindowException(
                                "data drag preview metrics",
                                WindowErrorKind.InvalidState
                            )
                    prepareDragPreview(pointer, value, metrics.scaleFactor)
                }
                case None -> {}
            }
            checkNativeStatus(nativeDragReady(pointer), "prepare data drag")
            return PlatformDragSource(owner.application, pointer, callback)
        } catch (error: Throwable) {
            when (allocated) {
                case Some(val value) -> nativeDragClose(value)
                case None -> {}
            }
            releaseForeignCallback(callback)
            throw error
        }
    }
}

private fun addDragText(pointer: Ptr<Unit>, format: Int, text: String) {
    @Unsafe
    {
        val status =
            text.withUtf8Bytes {
                bytes,
                count -> @Unsafe
                {
                    return@withUtf8Bytes nativeDragAdd(pointer, format, bytes, count)
                }
            }
        checkDragContent(status)
    }
}

private fun checkDragContent(status: Long) {
    if (status == -8L)
        throw IllegalArgumentException(Some("drag content cannot be represented by the platform"))
    checkNativeStatus(status, "copy drag content")
}

private class PlatformDragSource(
    private val application: ApplicationOwner,
    private val pointer: Ptr<Unit>,
    private val callback: ForeignCallback<(Ptr<Unit>, Int, Int) -> Int>
): NativeDragSource {
    public override fun setEffects(value: DragEffects) {
        val mask =
            (
                if (value.copy)
                    1
                else
                    0
            ) +
                (
                    if (value.move)
                        2
                    else
                        0
                ) +
                (
                    if (value.link)
                        4
                    else
                        0
                )
        @Unsafe
        {
            checkNativeStatus(nativeDragEffects(pointer, mask), "update drag effects")
        }
    }
    public override fun start() {
        @Unsafe
        {
            checkNativeStatus(nativeDragStart(pointer), "start data drag")
        }
    }
    public override fun close() {
        @Unsafe
        {
            nativeDragClose(pointer)
        }
        val owned = callback
        application.mailbox.postControl {
            @Unsafe
            {
                releaseForeignCallback(owned)
            }
        }
    }
}

@Extern(name = "scoop_window_drag_create")
private fun nativeDragCreate(
    window: Ptr<Unit>,
    input: Ptr<Unit>,
    effects: Int,
    callback: FunPtr<(Ptr<Unit>, Int, Int) -> Int>,
    context: Ptr<Unit>
): NativeCreateResult

@Extern(name = "scoop_window_drag_add")
private fun nativeDragAdd(source: Ptr<Unit>, format: Int, bytes: Ptr<UInt8>, length: Long): Long

@Extern(name = "scoop_window_drag_add_path")
private fun nativeDragAddPath(source: Ptr<Unit>, bytes: Ptr<Byte>, length: Long): Long

@Extern(name = "scoop_window_drag_ready")
private fun nativeDragReady(source: Ptr<Unit>): Long

@Extern(name = "scoop_window_drag_start")
private fun nativeDragStart(source: Ptr<Unit>): Long

@Extern(name = "scoop_window_drag_effects")
private fun nativeDragEffects(source: Ptr<Unit>, effects: Int): Long

@Extern(name = "scoop_window_drag_close")
private fun nativeDragClose(source: Ptr<Unit>)
