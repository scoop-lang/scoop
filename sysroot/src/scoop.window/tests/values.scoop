package scoop.window

import scoop.platform.time.MonotonicInstant
import scoop.test.*

@Test
private class WindowValueTest {
    @Test
    fun `drag previews select the closest backing size and retain signed logical hotspots`() {
        val small = DesktopImageRepresentation(PhysicalSize(2, 1), Array<UInt8>(8L) { 0.toUByte() })
        val large =
            DesktopImageRepresentation(PhysicalSize(4, 2), Array<UInt8>(32L) { 0.toUByte() })
        val image = DesktopImage(LogicalSize(2.0, 1.0), [small, large])
        val preview = DragPreview(image, LogicalPosition(-2.5, 0.5))
        assertTrue(preview.representation(1.0) === small)
        assertTrue(preview.representation(2.0) === large)
        assertEquals(LogicalPosition(-2.5, 0.5), preview.hotSpot)
        assertFailsWith<IllegalArgumentException> {
            DragPreview(image, LogicalPosition(Double.NaN, 0.0))
        }
    }

    @Test
    fun `fractional scale rounds drawable allocations upward`() {
        assertEquals(PhysicalSize(127, 64), LogicalSize(101.1, 50.5).toPhysical(1.25))
        assertEquals(PhysicalSize(0, 0), LogicalSize(0.0, 0.0).toPhysical(2.0))
        val metrics = WindowMetrics(LogicalSize(320.0, 240.0), PhysicalSize(640, 480), 2.0)
        assertEquals(PhysicalPosition(25.5, 8.0), metrics.toPhysical(LogicalPosition(12.75, 4.0)))
        assertEquals(LogicalPosition(12.75, 4.0), metrics.toLogical(PhysicalPosition(25.5, 8.0)))
        assertFalse(PhysicalSize(0, 10).isDrawable)
    }
    @Test
    fun `invalid dimensions and overflow fail at the operation boundary`() {
        assertFailsWith<IllegalArgumentException> { LogicalSize(-1.0, 5.0).toPhysical(1.0) }
        assertFailsWith<IllegalArgumentException> { LogicalSize(1.0, 5.0).toPhysical(0.0) }
        assertFailsWith<IllegalArgumentException> { LogicalSize(2147483647.0, 5.0).toPhysical(2.0) }
        assertFailsWith<IllegalArgumentException> { PhysicalSize(-1, 5).toLogical(1.0) }
    }
    @Test
    fun `pointer events preserve both timestamp origins in GC-free code`() {
        val instant = MonotonicInstant(7L, 123)
        val occurred = InputTime.Event(instant)
        val observed = InputTime.Observed(instant)
        assertNotEquals(occurred, observed)
        for (time in [occurred, observed]) {
            when (cancelPointer(time)) {
                case Cancelled(_, val captured) -> {
                    assertEquals(time, captured)
                    assertEquals(instant, captured.mark())
                }
                else -> fail()
            }
        }
    }
    @Test
    fun `window identities use value equality and hashing`() {
        assertEquals(WindowId(12L), WindowId(12L))
        assertNotEquals(WindowId(12L), WindowId(13L))
        assertEquals(WindowId(12L).hash(), WindowId(12L).hash())
    }
}

@NoGC
private fun cancelPointer(time: InputTime): PointerEvent =
    PointerEvent.Cancelled(PointerCancelReason.FocusLost, time)
