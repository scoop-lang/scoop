package scoop.window

import scoop.test.*
import scoop.window.accessibility.*

private class RecordedProjection : AccessibilityProjection {
    val messages = ArrayList<String>()
    var publications = 0
    var changedCount = 0L
    var geometryCount = 0L
    var failNext = false
    var closed = false
    public override fun publish(
        changed: Collection<AccessibilityNode>,
        geometry: Collection<AccessibilityNode>,
        removed: Array<Long>,
        focused: Long
    ) {
        if (failNext) {
            failNext = false
            throw IllegalStateException(Some("projection failed"))
        }
        changedCount = changed.size
        geometryCount = geometry.size
        publications += 1
    }
    public override fun retire(number: Long) {}
    public override fun announce(number: Long, text: String, priority: SemanticLive) {
        messages.add(text)
    }
    public override fun close() {
        closed = true
    }
}

@Test
private class SemanticPublicationTest {
    @Test
    fun `a hidden window prepares native accessibility and drops before first configuration`() {
        val handler = InitialPublicationHandler()
        Application(applicationOptions { lastWindowPolicy = LastWindowPolicy.Exit }).run(handler)
        assertTrue(handler.finished)
        assertTrue(handler.provider!!.isClosed)
        assertTrue(handler.node!!.isClosed)
        assertTrue(handler.dropTarget!!.isClosed)
        assertFailsWith<IllegalStateException> {
            handler.node!!.update(SemanticProperties(name = Some("After close")))
        }
    }

    @Test
    fun `announcements coalesce through busy ancestors and discarded targets never speak`() {
        val handler = PublicationHandler()
        Application(applicationOptions { lastWindowPolicy = LastWindowPolicy.Exit }).run(handler)
        assertTrue(handler.finished)
    }
}

private class InitialPublicationHandler: ApplicationHandler {
    var provider: AccessibilityProvider? = None
    var node: AccessibilityNode? = None
    var dropTarget: DropTarget? = None
    var finished = false
    public override fun onEvent(application: ActiveApplication, event: ApplicationEvent) {
        when (event) {
            case Resumed -> {
                val window =
                    application.createWindow(
                        windowAttributes {
                            visible = false
                            requestActivation = false
                        }
                    )
                val current = window.createAccessibilityProvider()
                provider = Some(current)
                val text = current.createNode(SemanticRole.Text)
                node = Some(text)
                text.update(SemanticProperties(value = Some("Before configuration")))
                current.publish()
                text.update(SemanticProperties(value = Some("Updated before configuration")))
                current.publish()
                assertFalse(current.isClosed)
                val drops =
                    window.registerDropTarget(
                        DropHandlers({ _ -> DropDecision.Reject }, { _ -> false })
                    )
                dropTarget = Some(drops)
                drops.periodicUpdates = true
                drops.enabled = false
                drops.enabled = true
                assertTrue(drops.periodicUpdates)
                assertTrue(drops.enabled)
                window.requestDestroy()
            }
            case Window(_, WindowEvent.Destroyed) -> {
                finished = true
                application.requestExit()
            }
            else -> {}
        }
    }
}

private class PublicationHandler: ApplicationHandler {
    var finished = false
    public override fun onEvent(application: ActiveApplication, event: ApplicationEvent) {
        when (event) {
            case Resumed -> {
                val window =
                    application.createWindow(
                        windowAttributes {
                            visible = false;
                            requestActivation = false
                        }
                    )
                val projection = RecordedProjection()
                val provider = AccessibilityProvider(window.owner)
                window.owner.accessibility = Some(provider)
                provider.bind(projection)
                try {
                    val group = provider.createNode(SemanticRole.Group)
                    val text = provider.createNode(SemanticRole.Text, Some(group))
                    text.update(
                        SemanticProperties(value = Some("Initial"), live = SemanticLive.Polite)
                    )
                    provider.publish()
                    assertEquals(0L, projection.messages.size)
                    val publications = projection.publications
                    provider.publish()
                    assertEquals(publications, projection.publications)
                    val geometry = SemanticGeometry(
                        LogicalRect(LogicalPosition(2.0, 5.0), LogicalSize(50.0, 16.0))
                    )
                    text.geometry = Some(geometry)
                    projection.failNext = true
                    assertFailsWith<IllegalStateException> { provider.publish() }
                    provider.publish()
                    assertEquals(0L, projection.changedCount)
                    assertEquals(1L, projection.geometryCount)
                    text.geometry = None
                    text
                        .update(
                            SemanticProperties(
                                value = Some("Initial"), live = SemanticLive.Polite, required = true
                            )
                        )
                    group.geometry = Some(geometry)
                    provider.publish()
                    assertEquals(1L, projection.changedCount)
                    assertEquals(1L, projection.geometryCount)
                    assertEquals(0L, projection.messages.size)
                    group.update(SemanticProperties(busy = true))
                    text.update(
                        SemanticProperties(value = Some("Working"), live = SemanticLive.Polite)
                    )
                    provider.publish()
                    text.update(
                        SemanticProperties(value = Some("Done"), live = SemanticLive.Polite)
                    )
                    provider.publish()
                    assertEquals(0L, projection.messages.size)
                    group.update(SemanticProperties())
                    provider.publish()
                    assertEquals(1L, projection.messages.size)
                    assertEquals("Done", projection.messages[0L])
                    text.announce("First")
                    text.announce("Last", SemanticLive.Assertive)
                    provider.publish()
                    assertEquals(2L, projection.messages.size)
                    assertEquals("Last", projection.messages[1L])
                    group.update(SemanticProperties(hidden = true))
                    text.update(
                        SemanticProperties(value = Some("Hidden"), live = SemanticLive.Polite)
                    )
                    provider.publish()
                    group.update(SemanticProperties())
                    provider.publish()
                    assertEquals(2L, projection.messages.size)
                    window.owner.inputBlocked = true
                    text.announce("Blocked")
                    provider.publish()
                    window.owner.inputBlocked = false
                    text.update(
                        SemanticProperties(
                            protectedText = true,
                            name = Some("Password"),
                            live = SemanticLive.Polite
                        )
                    )
                    text.announce("Private")
                    provider.publish()
                    assertEquals(2L, projection.messages.size)
                    text.update(SemanticProperties(value = Some("A😀B")))
                    val child = provider.createNode(SemanticRole.Link, Some(text))
                    text.textChildren = [SemanticTextChild(child.id, Utf8Range(1L, 5L))]
                    assertEquals(1L, text.textChildren.size)
                    child.reparent(Some(group))
                    assertEquals(0L, text.textChildren.size)
                    text.announce("Retired")
                    text.close()
                    provider.publish()
                    assertEquals(2L, projection.messages.size)
                    val slider = provider.createNode(SemanticRole.Slider)
                    slider.update(
                        SemanticProperties(range = Some(SemanticValueRange(0.0, 10.0, 5.0)))
                    )
                    assertFailsWith<IllegalArgumentException> {
                        slider.update(
                            SemanticProperties(range = Some(SemanticValueRange(0.0, 10.0, 11.0)))
                        )
                    }
                    assertFailsWith<IllegalArgumentException> {
                        slider.update(
                            SemanticProperties(selectionMode = Some(SemanticSelectionMode.Single))
                        )
                    }
                    provider.publish()
                    assertEquals(Some(SemanticValueRange(0.0, 10.0, 5.0)), slider.properties.range)
                } finally {
                    provider.close()
                }
                assertTrue(projection.closed)
                window.requestDestroy()
            }
            case Window(_, WindowEvent.Destroyed) -> {
                finished = true;
                application.requestExit()
            }
            else -> {}
        }
    }
}
