package scoop.window

import scoop.test.*
import scoop.window.accessibility.*

private class CollectionSource(
    private val keys: Array<SemanticItemKey>,
    private val labels: Array<String?>,
    public override val search: SemanticItemSearch = SemanticItemSearch(name = true),
    private val unavailable: Long? = None,
    private val hierarchyLevel: Long? = None,
    private val expanded: Boolean? = None
): SemanticCollectionSource {
    var descriptions = 0
    public override val count: Long get() = keys.size
    public override fun keyAt(index: Long): SemanticItemKey = keys[index]
    public override fun indexOfKey(key: SemanticItemKey): Long? {
        for (index in 0L ..< keys.size)
            if (keys[index] == key)
                return Some(index)
        return None
    }
    public override fun describe(index: Long): SemanticItemProperties? {
        descriptions += 1
        if (unavailable == Some(index))
            return None
        return Some(
            SemanticItemProperties(
                name = labels[index],
                automationId = Some(f"id-${index}"),
                selected = Some(index == 1L),
                hierarchyLevel = hierarchyLevel,
                expanded = expanded
            )
        )
    }
}

private fun item(result: SemanticItemResult): SemanticItem =
    when (result) {
        case Found(val value) -> value
        else -> fail(Some("expected a semantic item"))
    }

@Test
private class SemanticCollectionTest {
    @Test
    fun `selection keeps declared hierarchy metadata and invalid depth is rejected`() {
        val key = SemanticItemKey.Text("group")
        val source =
            CollectionSource(
                [key],
                [Some("Group")],
                hierarchyLevel = Some(3L),
                expanded = Some(false)
            )
        val snapshot = SemanticCollectionSnapshot(source, Some(SemanticCollectionSelection([key])))
        assertEquals(0, source.descriptions)
        val props = item(snapshot.itemForKey(key)).properties
        assertEquals(Some(3L), props.hierarchyLevel)
        assertEquals(Some(false), props.expanded)
        assertEquals(Some(true), props.selected)
        assertEquals(None, SemanticItemProperties().hierarchyLevel)
        assertEquals(Some(0L), SemanticItemProperties(hierarchyLevel = Some(0L)).hierarchyLevel)
        assertEquals(
            Some(Long.MAX_VALUE),
            SemanticItemProperties(hierarchyLevel = Some(Long.MAX_VALUE)).hierarchyLevel
        )
        val invalid =
            SemanticCollectionSnapshot(
                CollectionSource([key], [Some("Group")], hierarchyLevel = Some(-1L))
            )
        assertFailsWith<IllegalArgumentException> { invalid.itemAt(0L) }
    }

    @Test
    fun `snapshots keep stable typed keys and query only the requested data`() {
        val numeric = SemanticItemKey.Number(1L)
        val text = SemanticItemKey.Text("1")
        val source = CollectionSource([numeric, text], [Some("one"), Some("")])
        val first = SemanticCollectionSnapshot(source)
        assertEquals(0, source.descriptions)
        assertEquals(2L, first.count)
        assertEquals(text, item(first.itemAt(1L)).key)
        assertEquals(Some(""), item(first.itemForKey(text)).properties.name)
        assertEquals(2, source.descriptions)
        val reordered =
            SemanticCollectionSnapshot(CollectionSource([text, numeric], [Some(""), Some("one")]))
        assertEquals(0L, item(reordered.itemForKey(text)).index)
        assertEquals(1L, item(first.itemForKey(text)).index)
        assertEquals(SemanticItemResult.NotFound, first.itemAt(-1L))
        assertEquals(SemanticItemResult.NotFound, first.itemAt(2L))
        assertEquals(SemanticItemResult.NotFound, first.itemForKey(SemanticItemKey.Number(9L)))
    }

    @Test
    fun `search distinguishes unsupported unavailable and absent properties`() {
        val a = SemanticItemKey.Number(1L)
        val b = SemanticItemKey.Number(2L)
        val c = SemanticItemKey.Number(3L)
        val complete =
            SemanticCollectionSnapshot(
                CollectionSource([a, b, c], [Some("same"), Some("same"), Some("")])
            )
        assertEquals(b, item(complete.find(SemanticItemQuery.Name("same"), Some(a))).key)
        assertEquals(c, item(complete.find(SemanticItemQuery.Name(""))).key)
        assertEquals(SemanticItemResult.NotFound, complete.find(SemanticItemQuery.Name("absent")))
        assertEquals(
            SemanticItemResult.Unsupported,
            complete.find(SemanticItemQuery.AutomationId("id-0"))
        )
        assertEquals(
            SemanticItemResult.Unavailable,
            complete.find(SemanticItemQuery.Name("same"), Some(SemanticItemKey.Number(4L)))
        )
        val unknown = SemanticCollectionSnapshot(CollectionSource([a], [None]))
        assertEquals(SemanticItemResult.Unavailable, unknown.find(SemanticItemQuery.Name("x")))
        val unavailable =
            SemanticCollectionSnapshot(CollectionSource([a], [Some("one")], unavailable = Some(0L)))
        assertEquals(SemanticItemResult.Unavailable, unavailable.itemForKey(a))
        assertEquals(
            SemanticItemResult.Unavailable,
            unavailable.find(SemanticItemQuery.Name("one"))
        )
        val invalid = SemanticCollectionSnapshot(CollectionSource([a, a], [Some("x"), Some("y")]))
        assertFailsWith<IllegalArgumentException> { invalid.itemAt(1L) }
    }
}

private class CellDescriptions {
    var count = 0
    var key: SemanticItemKey? = None
}

@Test
private class SemanticGridTest {
    @Test
    fun `covered columns share metadata and actions with their anchor`() {
        val row = SemanticItemKey.Number(9L)
        val columns = Array(4L) { index -> SemanticGridColumn(SemanticItemKey.Number(index)) }
        val source = CollectionSource([row], [Some("row")])
        val calls = CellDescriptions()
        val grid =
            SemanticGrid(
                columns,
                {
                    _, column ->
                    calls.count += 1
                    Some(SemanticItemProperties(value = Some(f"${column}"), focusable = true))
                },
                span =
                    Some {
                        _,
                        column -> if (column == 1L || column == 2L)
                            SemanticGridSpan(1L, 2L)
                        else
                            SemanticGridSpan(column)
                    }
            )
        val snapshot = SemanticCollectionSnapshot(source, grid = Some(grid))
        val covered = item(snapshot.cellForKey(row, SemanticItemKey.Number(2L)))
        assertEquals(SemanticItemKey.Number(1L), covered.key)
        assertEquals(1L, covered.index)
        assertEquals(2L, covered.span)
        assertEquals(4L, covered.count)
        assertEquals(Some("1"), covered.properties.value)
        assertEquals(1, calls.count)
        assertEquals(1L, item(snapshot.cellForKey(row, SemanticItemKey.Number(3L))).span)
        assertEquals(0, source.descriptions)
        val actions =
            SemanticGridActions(
                realize =
                    Some {
                        key, column ->
                        assertEquals(row, key)
                        calls.key = Some(column)
                        SemanticActionResult.Completed
                    }
            )
        assertEquals(
            SemanticActionResult.Completed,
            performGridCell(snapshot, Some(actions), row, 2L, 12)
        )
        assertEquals(Some(SemanticItemKey.Number(1L)), calls.key)
    }

    @Test
    fun `grid spans reject invalid bounds without scanning other rows or columns`() {
        val row = SemanticItemKey.Number(1L)
        val source = CollectionSource([row], [Some("row")])
        val columns = Array(3L) { index -> SemanticGridColumn(SemanticItemKey.Number(index)) }
        for (
            span in [
                SemanticGridSpan(-1L),
                SemanticGridSpan(0L, 0L),
                SemanticGridSpan(Long.MAX_VALUE, 1L),
                SemanticGridSpan(1L),
                SemanticGridSpan(0L, 4L)
            ]
        ) {
            val snapshot =
                SemanticCollectionSnapshot(
                    source,
                    grid =
                        Some(
                            SemanticGrid(
                                columns,
                                {
                                    _,
                                    _ -> fail(
                                        Some("invalid ranges must fail before describing values")
                                    )
                                },
                                span = Some { _, _ -> span }
                            )
                        )
                )
            assertFailsWith<IllegalArgumentException> {
                snapshot.cellForKey(row, SemanticItemKey.Number(0L))
            }
        }
        assertEquals(0, source.descriptions)
    }

    @Test
    fun `selection snapshots and cells follow stable row and column keys`() {
        val a = SemanticItemKey.Number(1L)
        val b = SemanticItemKey.Number(2L)
        val title = SemanticItemKey.Text("title")
        val details = SemanticItemKey.Text("details")
        val source = CollectionSource([a, b], [Some("A"), Some("B")])
        val cells = CellDescriptions()
        val grid =
            SemanticGrid(
                [SemanticGridColumn(title, Some("Title")), SemanticGridColumn(details)],
                {
                    row, column ->
                    cells.count += 1
                    if (row == b && column == 1L)
                        None
                    else
                        Some(
                            SemanticItemProperties(
                                name =
                                    Some(
                                        if (row == a)
                                            "A title"
                                        else
                                            "B title"
                                    )
                            )
                        )
                }
            )
        val snapshot =
            SemanticCollectionSnapshot(
                source,
                Some(SemanticCollectionSelection([a], required = true)),
                Some(grid)
            )
        assertEquals(0, cells.count)
        assertEquals(0, source.descriptions)
        assertEquals(Some(true), item(snapshot.itemAt(0L)).properties.selected)
        assertEquals(Some(false), item(snapshot.itemAt(1L)).properties.selected)
        assertEquals(Some("A title"), item(snapshot.cellForKey(a, title)).properties.name)
        assertEquals(SemanticItemResult.Unavailable, snapshot.cellForKey(b, details))
        assertEquals(
            SemanticItemResult.NotFound,
            snapshot.cellForKey(SemanticItemKey.Number(9L), title)
        )
        assertEquals(
            SemanticItemResult.NotFound,
            snapshot.cellForKey(a, SemanticItemKey.Text("missing"))
        )
        assertEquals(2, cells.count)
        assertEquals(2, source.descriptions)
        assertFailsWith<IllegalArgumentException> { SemanticCollectionSelection([a, b]) }
        assertFailsWith<IllegalArgumentException> {
            SemanticCollectionSelection([a, a], multiple = true)
        }
        assertFailsWith<IllegalArgumentException> {
            SemanticCollectionSnapshot(
                source,
                Some(SemanticCollectionSelection([SemanticItemKey.Number(9L)]))
            )
        }
        assertFailsWith<IllegalArgumentException> {
            SemanticGrid([SemanticGridColumn(title), SemanticGridColumn(title)], { _, _ -> None })
        }
    }
}
