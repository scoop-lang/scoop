package scoop.window

import scoop.test.*
import scoop.window.platform.macos.*

@Test
private class WindowReceiverDslTests {
    @Test
    fun `window creation values snapshot portable and platform configuration without opening windows`() {
        val captured = ArrayList<WindowAttributesBuilder>()
        val original =
            windowAttributes {
                captured.add(this)
                title = "original"
                size = LogicalSize(360.0, 240.0)
                visible = false
                requestActivation = false
                macOSTitlebar { transparent = true }
                macOSTitlebar { titleHidden = true }
            }
        val derived =
            original.copy {
                title = "copy";
                macOSTitlebar { fullSizeContent = true }
            }
        captured[0L].title = "late"
        assertEquals("original", original.title)
        assertEquals("copy", derived.title)
        assertEquals(LogicalSize(360.0, 240.0), derived.size)
        assertEquals(3, original.titlebarFlags)
        assertEquals(7, derived.titlebarFlags)
        assertFalse(derived.visible)
        assertFalse(derived.requestActivation)
    }

    @Test
    fun `application creation options preserve activation policy when copied`() {
        val original =
            applicationOptions {
                lastWindowPolicy = LastWindowPolicy.Exit
                macOSActivationPolicy = ActivationPolicy.Accessory
            }
        val derived = original.copy { lastWindowPolicy = LastWindowPolicy.KeepRunning }
        assertEquals(LastWindowPolicy.Exit, original.lastWindowPolicy)
        assertEquals(LastWindowPolicy.KeepRunning, derived.lastWindowPolicy)
        assertEquals(1, derived.activationPolicy)
    }
}
