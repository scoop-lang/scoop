package scoop.window

import scoop.test.*
import scoop.tests.window.inspectGtkDragIcon
import scoop.tests.window.sendGtkDragPointer
import scoop.platform.time.MonotonicTimeSource
import scoop.time.Duration

@Test
private class LinuxDragInputTest {
    @Test
    @Ignore("Requires an isolated X11 display for protocol input; run separately with --ignored")
    fun `GTK retains threshold input and shows the prepared image at the hotspot during a system drag`() {
        val handler = GtkDragInputHandler()
        Application().run(handler)
        assertTrue(handler.previewObserved)
        assertEquals(2, handler.completions)
        assertEquals(1, handler.destroyed)
    }
}

private class GtkDragInputHandler: ApplicationHandler {
    var window: Window? = None
    var stage = 0
    var completions = 0
    var destroyed = 0
    var previewObserved = false
    private var inspect: WindowDeadline? = None

    public override fun onEvent(application: ActiveApplication, event: ApplicationEvent) {
        when (event) {
            case Resumed -> {
                application.setControlFlow(
                    ControlFlow.WaitUntil(MonotonicTimeSource.now() + Duration.seconds(10L))
                )
                window =
                    Some(
                        application.createWindow(
                            windowAttributes {
                                title = "Scoop GTK drag input"
                                size = LogicalSize(240.0, 160.0)
                                requestActivation = false
                            }
                        )
                    )
            }
            case NewEvents(StartCause.Deadline) -> {
                if (stage >= 1)
                    send(2)
                fail(Some("GTK drag input timed out"))
            }
            case Window(_, WindowEvent.RedrawRequested) -> if (stage == 0) {
                stage = 1
                send(0)
            }
            case Window(
                _,
                WindowEvent.Pointer(
                    PointerEvent.Button(_, MouseButton.Left, ElementState.Pressed, _)
                )
            ) -> if (stage == 1) {
                stage = 2
                send(1)
            }
            case Window(_, WindowEvent.Pointer(PointerEvent.Moved(_))) -> if (stage == 2) {
                stage = 3
                val activePreview = completions == 1
                try {
                    val session =
                        window!!.beginDrag(
                            DragContent.Text("drag 😀"),
                            preview =
                                Some(
                                    DragPreview(
                                        DesktopImage(
                                            LogicalSize(24.0, 12.0),
                                            [
                                                DesktopImageRepresentation(
                                                    PhysicalSize(48, 24),
                                                    Array<UInt8>(4608L) {
                                                        index -> if (index % 4L == 3L)
                                                            128.toUByte()
                                                        else
                                                            240.toUByte()
                                                    }
                                                )
                                            ]
                                        ),
                                        LogicalPosition(5.0, 7.0)
                                    )
                                )
                        ) {
                            result ->
                            when (result) {
                                case NotDropped -> {}
                                else -> fail(Some("drag without a destination did not cancel"))
                            }
                            completions += 1
                            if (activePreview) {
                                window!!.requestDestroy()
                                application.requestExit()
                            } else {
                                stage = 1
                                send(0)
                            }
                        }
                    assertFalse(session.isStarted)
                    if (activePreview) {
                        inspect = Some(window!!.createDeadline { verifyIcon() })
                        scheduleInspection()
                    } else {
                        assertTrue(session.cancelPending())
                    }
                } finally {
                    when (inspect) {
                        case None -> send(2)
                        case Some(_) -> Unit
                    }
                }
            }
            case Window(_, WindowEvent.Destroyed) -> destroyed += 1
            else -> {}
        }
    }

    private fun scheduleInspection() {
        inspect!!.schedule(MonotonicTimeSource.now() + Duration.milliseconds(25L))
    }

    private fun verifyIcon() {
        @Unsafe
        {
            val result = inspectGtkDragIcon(window!!.owner.pointer!!)
            if (result == 0) {
                scheduleInspection()
                return
            }
            send(2)
            assertEquals(1, result)
            previewObserved = true
        }
    }

    private fun send(phase: Int) {
        @Unsafe
        {
            assertEquals(1, sendGtkDragPointer(window!!.owner.pointer!!, phase))
        }
    }
}
