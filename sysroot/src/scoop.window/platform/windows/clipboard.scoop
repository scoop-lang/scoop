package scoop.window

internal fun platformReadClipboard(): String? {
    @Unsafe
    {
        val result = nativeClipboardRead()
        try {
            checkNativeStatus(result.error, "read clipboard")
            return when (result.bytes) {
                case Some(bytes) -> Some(String.fromUtf8(bytes, result.length))
                case None -> None
            }
        } finally {
            nativeClipboardRelease(result.bytes)
        }
    }
}

internal fun platformWriteClipboard(text: String) {
    @Unsafe
    {
        text.withUtf8Bytes {
            bytes,
            length -> @Unsafe
            {
                checkNativeStatus(nativeClipboardWrite(bytes, length), "write clipboard")
            }
        }
    }
}

@CLayout
private struct NativeClipboardText(val bytes: Ptr<UInt8>?, val length: Long, val error: Long)

@Extern(name = "scoop_window_clipboard_read")
private fun nativeClipboardRead(): NativeClipboardText

@Extern(name = "scoop_window_clipboard_release")
private fun nativeClipboardRelease(bytes: Ptr<UInt8>?)

@Extern(name = "scoop_window_clipboard_write")
private fun nativeClipboardWrite(bytes: Ptr<UInt8>, length: Long): Long
