        case F18 -> "F18"
        case F19 -> "F19"
        case F20 -> "F20"
        case AudioVolumeUp -> "AudioVolumeUp"
        case AudioVolumeDown -> "AudioVolumeDown"
        case AudioVolumeMute -> "AudioVolumeMute"
        case Numpad0 -> "Numpad0"
        case Numpad1 -> "Numpad1"
