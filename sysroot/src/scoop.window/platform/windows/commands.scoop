package scoop.window

internal fun platformTextCommands(
    pointer: Ptr<Unit>,
    key: LogicalKey,
    modifiers: Modifiers,
    state: ElementState,
    synthetic: Boolean
): Array<TextEditCommand> {
    if (state != ElementState.Pressed || synthetic)
        return []
    return when (windowsEditingCommand(key, modifiers)) {
        case Some(val command) -> [command]
        case None -> []
    }
}

internal fun windowsEditingCommand(key: LogicalKey, modifiers: Modifiers): TextEditCommand? {
    if (modifiers.control && !modifiers.superKey && !modifiers.alt && !modifiers.function) {
        if (windowsShortcutCharacter(key, "z"))
            return Some(
                if (modifiers.shift)
                    TextEditCommand.Redo
                else
                    TextEditCommand.Undo
            )
        if (windowsShortcutCharacter(key, "y"))
            return Some(TextEditCommand.Redo)
        if (!modifiers.shift) {
            if (windowsShortcutCharacter(key, "a"))
                return Some(TextEditCommand.SelectAll)
            if (windowsShortcutCharacter(key, "c"))
                return Some(TextEditCommand.Copy)
            if (windowsShortcutCharacter(key, "x"))
                return Some(TextEditCommand.Cut)
            if (windowsShortcutCharacter(key, "v"))
                return Some(TextEditCommand.Paste)
        }
        return when (key) {
            case Named(NamedKey.ArrowLeft) -> Some(
                TextEditCommand.Move(TextMovement.WordLeft, modifiers.shift)
            )
            case Named(NamedKey.ArrowRight) -> Some(
                TextEditCommand.Move(TextMovement.WordRight, modifiers.shift)
            )
            case Named(NamedKey.Home) -> Some(
                TextEditCommand.Move(TextMovement.DocumentStart, modifiers.shift)
            )
            case Named(NamedKey.End) -> Some(
                TextEditCommand.Move(TextMovement.DocumentEnd, modifiers.shift)
            )
            case Named(NamedKey.Backspace) -> Some(
                TextEditCommand.Delete(TextDeletion.WordBackward)
            )
            case Named(NamedKey.Delete) -> Some(TextEditCommand.Delete(TextDeletion.WordForward))
            else -> None
        }
    }
    if (modifiers.control || modifiers.superKey || modifiers.alt || modifiers.function)
        return None
    val movement =
        when (key) {
            case Named(NamedKey.ArrowLeft) -> Some(TextMovement.Left)
            case Named(NamedKey.ArrowRight) -> Some(TextMovement.Right)
            case Named(NamedKey.ArrowUp) -> Some(TextMovement.Up)
            case Named(NamedKey.ArrowDown) -> Some(TextMovement.Down)
            case Named(NamedKey.Home) -> Some(TextMovement.LineStart)
            case Named(NamedKey.End) -> Some(TextMovement.LineEnd)
            case Named(NamedKey.PageUp) -> Some(TextMovement.PageUp)
            case Named(NamedKey.PageDown) -> Some(TextMovement.PageDown)
            else -> None
        }
    when (movement) {
        case Some(val value) -> return Some(TextEditCommand.Move(value, modifiers.shift))
        case None -> {}
    }
    return when (key) {
        case Named(NamedKey.Backspace) -> Some(TextEditCommand.Delete(TextDeletion.Backward))
        case Named(NamedKey.Delete) -> Some(TextEditCommand.Delete(TextDeletion.Forward))
        case Named(NamedKey.Enter) -> Some(TextEditCommand.InsertNewline)
        case Named(NamedKey.Tab) -> Some(
            if (modifiers.shift)
                TextEditCommand.InsertBacktab
            else
                TextEditCommand.InsertTab
        )
        case Named(NamedKey.Escape) -> if (!modifiers.shift)
            Some(TextEditCommand.Cancel)
        else
            None
        else -> None
    }
}

private fun windowsShortcutCharacter(key: LogicalKey, text: String): Boolean =
    LogicalKey.Character(text).matchesShortcut(key)
