package scoop.window

internal fun linuxScanCode(key: KeyCode): UInt? =
    when (key) {
        case Escape -> Some(1u)
        case Digit1 -> Some(2u)
        case Digit2 -> Some(3u)
        case Digit3 -> Some(4u)
        case Digit4 -> Some(5u)
        case Digit5 -> Some(6u)
        case Digit6 -> Some(7u)
        case Digit7 -> Some(8u)
        case Digit8 -> Some(9u)
        case Digit9 -> Some(10u)
        case Digit0 -> Some(11u)
        case Minus -> Some(12u)
        case Equal -> Some(13u)
        case Backspace -> Some(14u)
        case Tab -> Some(15u)
        case KeyQ -> Some(16u)
        case KeyW -> Some(17u)
        case KeyE -> Some(18u)
        case KeyR -> Some(19u)
        case KeyT -> Some(20u)
        case KeyY -> Some(21u)
        case KeyU -> Some(22u)
        case KeyI -> Some(23u)
        case KeyO -> Some(24u)
        case KeyP -> Some(25u)
        case BracketLeft -> Some(26u)
        case BracketRight -> Some(27u)
        case Enter -> Some(28u)
        case ControlLeft -> Some(29u)
        case KeyA -> Some(30u)
        case KeyS -> Some(31u)
        case KeyD -> Some(32u)
        case KeyF -> Some(33u)
        case KeyG -> Some(34u)
        case KeyH -> Some(35u)
        case KeyJ -> Some(36u)
        case KeyK -> Some(37u)
        case KeyL -> Some(38u)
        case Semicolon -> Some(39u)
        case Quote -> Some(40u)
        case Backquote -> Some(41u)
        case ShiftLeft -> Some(42u)
        case Backslash -> Some(43u)
        case KeyZ -> Some(44u)
        case KeyX -> Some(45u)
        case KeyC -> Some(46u)
        case KeyV -> Some(47u)
        case KeyB -> Some(48u)
        case KeyN -> Some(49u)
        case KeyM -> Some(50u)
        case Comma -> Some(51u)
        case Period -> Some(52u)
        case Slash -> Some(53u)
        case ShiftRight -> Some(54u)
        case NumpadMultiply -> Some(55u)
        case AltLeft -> Some(56u)
        case Space -> Some(57u)
        case CapsLock -> Some(58u)
        case F1 -> Some(59u)
        case F2 -> Some(60u)
        case F3 -> Some(61u)
        case F4 -> Some(62u)
        case F5 -> Some(63u)
        case F6 -> Some(64u)
        case F7 -> Some(65u)
        case F8 -> Some(66u)
        case F9 -> Some(67u)
        case F10 -> Some(68u)
        case NumLock -> Some(69u)
        case ScrollLock -> Some(70u)
        case Numpad7 -> Some(71u)
        case Numpad8 -> Some(72u)
        case Numpad9 -> Some(73u)
        case NumpadSubtract -> Some(74u)
        case Numpad4 -> Some(75u)
        case Numpad5 -> Some(76u)
        case Numpad6 -> Some(77u)
        case NumpadAdd -> Some(78u)
        case Numpad1 -> Some(79u)
        case Numpad2 -> Some(80u)
        case Numpad3 -> Some(81u)
        case Numpad0 -> Some(82u)
        case NumpadDecimal -> Some(83u)
        case IntlBackslash -> Some(86u)
        case F11 -> Some(87u)
        case F12 -> Some(88u)
        case IntlRo -> Some(89u)
        case NumpadEnter -> Some(96u)
        case ControlRight -> Some(97u)
        case NumpadDivide -> Some(98u)
        case PrintScreen -> Some(99u)
        case AltRight -> Some(100u)
        case Home -> Some(102u)
        case ArrowUp -> Some(103u)
        case PageUp -> Some(104u)
        case ArrowLeft -> Some(105u)
        case ArrowRight -> Some(106u)
        case End -> Some(107u)
        case ArrowDown -> Some(108u)
        case PageDown -> Some(109u)
        case Insert -> Some(110u)
        case Delete -> Some(111u)
        case AudioVolumeMute -> Some(113u)
        case AudioVolumeDown -> Some(114u)
        case AudioVolumeUp -> Some(115u)
        case NumpadEqual -> Some(117u)
        case Pause -> Some(119u)
        case NumpadComma -> Some(121u)
        case Lang1 -> Some(122u)
        case Lang2 -> Some(123u)
        case IntlYen -> Some(124u)
        case SuperLeft -> Some(125u)
        case SuperRight -> Some(126u)
        case ContextMenu -> Some(127u)
        case Help -> Some(138u)
        case F13 -> Some(183u)
        case F14 -> Some(184u)
        case F15 -> Some(185u)
        case F16 -> Some(186u)
        case F17 -> Some(187u)
        case F18 -> Some(188u)
        case F19 -> Some(189u)
        case F20 -> Some(190u)
        case Fn -> Some(464u)
        else -> None
    }
