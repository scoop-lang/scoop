package scoop.window

// Physical positions use Linux evdev codes on both X11 and Wayland.
internal fun platformPhysicalKey(code: Long): PhysicalKey =
    when (code) {
        1L -> PhysicalKey.Code(KeyCode.Escape)
        2L -> PhysicalKey.Code(KeyCode.Digit1)
        3L -> PhysicalKey.Code(KeyCode.Digit2)
        4L -> PhysicalKey.Code(KeyCode.Digit3)
        5L -> PhysicalKey.Code(KeyCode.Digit4)
        6L -> PhysicalKey.Code(KeyCode.Digit5)
        7L -> PhysicalKey.Code(KeyCode.Digit6)
        8L -> PhysicalKey.Code(KeyCode.Digit7)
        9L -> PhysicalKey.Code(KeyCode.Digit8)
        10L -> PhysicalKey.Code(KeyCode.Digit9)
        11L -> PhysicalKey.Code(KeyCode.Digit0)
        12L -> PhysicalKey.Code(KeyCode.Minus)
        13L -> PhysicalKey.Code(KeyCode.Equal)
        14L -> PhysicalKey.Code(KeyCode.Backspace)
        15L -> PhysicalKey.Code(KeyCode.Tab)
        16L -> PhysicalKey.Code(KeyCode.KeyQ)
        17L -> PhysicalKey.Code(KeyCode.KeyW)
        18L -> PhysicalKey.Code(KeyCode.KeyE)
        19L -> PhysicalKey.Code(KeyCode.KeyR)
        20L -> PhysicalKey.Code(KeyCode.KeyT)
        21L -> PhysicalKey.Code(KeyCode.KeyY)
        22L -> PhysicalKey.Code(KeyCode.KeyU)
        23L -> PhysicalKey.Code(KeyCode.KeyI)
        24L -> PhysicalKey.Code(KeyCode.KeyO)
        25L -> PhysicalKey.Code(KeyCode.KeyP)
        26L -> PhysicalKey.Code(KeyCode.BracketLeft)
        27L -> PhysicalKey.Code(KeyCode.BracketRight)
        28L -> PhysicalKey.Code(KeyCode.Enter)
        29L -> PhysicalKey.Code(KeyCode.ControlLeft)
        30L -> PhysicalKey.Code(KeyCode.KeyA)
        31L -> PhysicalKey.Code(KeyCode.KeyS)
        32L -> PhysicalKey.Code(KeyCode.KeyD)
        33L -> PhysicalKey.Code(KeyCode.KeyF)
        34L -> PhysicalKey.Code(KeyCode.KeyG)
        35L -> PhysicalKey.Code(KeyCode.KeyH)
        36L -> PhysicalKey.Code(KeyCode.KeyJ)
        37L -> PhysicalKey.Code(KeyCode.KeyK)
        38L -> PhysicalKey.Code(KeyCode.KeyL)
        39L -> PhysicalKey.Code(KeyCode.Semicolon)
        40L -> PhysicalKey.Code(KeyCode.Quote)
        41L -> PhysicalKey.Code(KeyCode.Backquote)
        42L -> PhysicalKey.Code(KeyCode.ShiftLeft)
        43L -> PhysicalKey.Code(KeyCode.Backslash)
        44L -> PhysicalKey.Code(KeyCode.KeyZ)
        45L -> PhysicalKey.Code(KeyCode.KeyX)
        46L -> PhysicalKey.Code(KeyCode.KeyC)
        47L -> PhysicalKey.Code(KeyCode.KeyV)
        48L -> PhysicalKey.Code(KeyCode.KeyB)
        49L -> PhysicalKey.Code(KeyCode.KeyN)
        50L -> PhysicalKey.Code(KeyCode.KeyM)
        51L -> PhysicalKey.Code(KeyCode.Comma)
        52L -> PhysicalKey.Code(KeyCode.Period)
        53L -> PhysicalKey.Code(KeyCode.Slash)
        54L -> PhysicalKey.Code(KeyCode.ShiftRight)
        55L -> PhysicalKey.Code(KeyCode.NumpadMultiply)
        56L -> PhysicalKey.Code(KeyCode.AltLeft)
        57L -> PhysicalKey.Code(KeyCode.Space)
        58L -> PhysicalKey.Code(KeyCode.CapsLock)
        59L -> PhysicalKey.Code(KeyCode.F1)
        60L -> PhysicalKey.Code(KeyCode.F2)
        61L -> PhysicalKey.Code(KeyCode.F3)
        62L -> PhysicalKey.Code(KeyCode.F4)
        63L -> PhysicalKey.Code(KeyCode.F5)
        64L -> PhysicalKey.Code(KeyCode.F6)
        65L -> PhysicalKey.Code(KeyCode.F7)
        66L -> PhysicalKey.Code(KeyCode.F8)
        67L -> PhysicalKey.Code(KeyCode.F9)
        68L -> PhysicalKey.Code(KeyCode.F10)
        69L -> PhysicalKey.Code(KeyCode.NumLock)
        70L -> PhysicalKey.Code(KeyCode.ScrollLock)
        71L -> PhysicalKey.Code(KeyCode.Numpad7)
        72L -> PhysicalKey.Code(KeyCode.Numpad8)
        73L -> PhysicalKey.Code(KeyCode.Numpad9)
        74L -> PhysicalKey.Code(KeyCode.NumpadSubtract)
        75L -> PhysicalKey.Code(KeyCode.Numpad4)
        76L -> PhysicalKey.Code(KeyCode.Numpad5)
        77L -> PhysicalKey.Code(KeyCode.Numpad6)
        78L -> PhysicalKey.Code(KeyCode.NumpadAdd)
        79L -> PhysicalKey.Code(KeyCode.Numpad1)
        80L -> PhysicalKey.Code(KeyCode.Numpad2)
        81L -> PhysicalKey.Code(KeyCode.Numpad3)
        82L -> PhysicalKey.Code(KeyCode.Numpad0)
        83L -> PhysicalKey.Code(KeyCode.NumpadDecimal)
        86L -> PhysicalKey.Code(KeyCode.IntlBackslash)
        87L -> PhysicalKey.Code(KeyCode.F11)
        88L -> PhysicalKey.Code(KeyCode.F12)
        89L -> PhysicalKey.Code(KeyCode.IntlRo)
        96L -> PhysicalKey.Code(KeyCode.NumpadEnter)
        97L -> PhysicalKey.Code(KeyCode.ControlRight)
        98L -> PhysicalKey.Code(KeyCode.NumpadDivide)
        99L -> PhysicalKey.Code(KeyCode.PrintScreen)
        100L -> PhysicalKey.Code(KeyCode.AltRight)
        102L -> PhysicalKey.Code(KeyCode.Home)
        103L -> PhysicalKey.Code(KeyCode.ArrowUp)
        104L -> PhysicalKey.Code(KeyCode.PageUp)
        105L -> PhysicalKey.Code(KeyCode.ArrowLeft)
        106L -> PhysicalKey.Code(KeyCode.ArrowRight)
        107L -> PhysicalKey.Code(KeyCode.End)
        108L -> PhysicalKey.Code(KeyCode.ArrowDown)
        109L -> PhysicalKey.Code(KeyCode.PageDown)
        110L -> PhysicalKey.Code(KeyCode.Insert)
        111L -> PhysicalKey.Code(KeyCode.Delete)
        113L -> PhysicalKey.Code(KeyCode.AudioVolumeMute)
        114L -> PhysicalKey.Code(KeyCode.AudioVolumeDown)
        115L -> PhysicalKey.Code(KeyCode.AudioVolumeUp)
        117L -> PhysicalKey.Code(KeyCode.NumpadEqual)
        119L -> PhysicalKey.Code(KeyCode.Pause)
        121L -> PhysicalKey.Code(KeyCode.NumpadComma)
        122L -> PhysicalKey.Code(KeyCode.Lang1)
        123L -> PhysicalKey.Code(KeyCode.Lang2)
        124L -> PhysicalKey.Code(KeyCode.IntlYen)
        125L -> PhysicalKey.Code(KeyCode.SuperLeft)
        126L -> PhysicalKey.Code(KeyCode.SuperRight)
        127L -> PhysicalKey.Code(KeyCode.ContextMenu)
        138L -> PhysicalKey.Code(KeyCode.Help)
        183L -> PhysicalKey.Code(KeyCode.F13)
        184L -> PhysicalKey.Code(KeyCode.F14)
        185L -> PhysicalKey.Code(KeyCode.F15)
        186L -> PhysicalKey.Code(KeyCode.F16)
        187L -> PhysicalKey.Code(KeyCode.F17)
        188L -> PhysicalKey.Code(KeyCode.F18)
        189L -> PhysicalKey.Code(KeyCode.F19)
        190L -> PhysicalKey.Code(KeyCode.F20)
        464L -> PhysicalKey.Code(KeyCode.Fn)
        else -> PhysicalKey.Unidentified(NativeKeyCode.LinuxEvdev(code.toUInt()))
    }

internal fun platformNamedKey(scan: Long, symbol: Long): NamedKey? =
    when (symbol) {
        32L -> Some(NamedKey.Space)
        65027L -> Some(NamedKey.Alt)
        65056L -> Some(NamedKey.Tab)
        65288L -> Some(NamedKey.Backspace)
        65289L -> Some(NamedKey.Tab)
        65291L -> Some(NamedKey.Clear)
        65293L -> Some(NamedKey.Enter)
        65299L -> Some(NamedKey.Pause)
        65300L -> Some(NamedKey.ScrollLock)
        65307L -> Some(NamedKey.Escape)
        65319L -> Some(NamedKey.Kana)
        65328L -> Some(NamedKey.Eisu)
        65360L -> Some(NamedKey.Home)
        65361L -> Some(NamedKey.ArrowLeft)
        65362L -> Some(NamedKey.ArrowUp)
        65363L -> Some(NamedKey.ArrowRight)
        65364L -> Some(NamedKey.ArrowDown)
        65365L -> Some(NamedKey.PageUp)
        65366L -> Some(NamedKey.PageDown)
        65367L -> Some(NamedKey.End)
        65377L -> Some(NamedKey.PrintScreen)
        65379L -> Some(NamedKey.Insert)
        65383L -> Some(NamedKey.ContextMenu)
        65386L -> Some(NamedKey.Help)
        65407L -> Some(NamedKey.NumLock)
        65421L -> Some(NamedKey.Enter)
        65429L -> Some(NamedKey.Home)
        65430L -> Some(NamedKey.ArrowLeft)
        65431L -> Some(NamedKey.ArrowUp)
        65432L -> Some(NamedKey.ArrowRight)
        65433L -> Some(NamedKey.ArrowDown)
        65434L -> Some(NamedKey.PageUp)
        65435L -> Some(NamedKey.PageDown)
        65436L -> Some(NamedKey.End)
        65438L -> Some(NamedKey.Insert)
        65439L -> Some(NamedKey.Delete)
        65470L -> Some(NamedKey.F1)
        65471L -> Some(NamedKey.F2)
        65472L -> Some(NamedKey.F3)
        65473L -> Some(NamedKey.F4)
        65474L -> Some(NamedKey.F5)
        65475L -> Some(NamedKey.F6)
        65476L -> Some(NamedKey.F7)
        65477L -> Some(NamedKey.F8)
        65478L -> Some(NamedKey.F9)
        65479L -> Some(NamedKey.F10)
        65480L -> Some(NamedKey.F11)
        65481L -> Some(NamedKey.F12)
        65482L -> Some(NamedKey.F13)
        65483L -> Some(NamedKey.F14)
        65484L -> Some(NamedKey.F15)
        65485L -> Some(NamedKey.F16)
        65486L -> Some(NamedKey.F17)
        65487L -> Some(NamedKey.F18)
        65488L -> Some(NamedKey.F19)
        65489L -> Some(NamedKey.F20)
        65505L -> Some(NamedKey.Shift)
        65506L -> Some(NamedKey.Shift)
        65507L -> Some(NamedKey.Control)
        65508L -> Some(NamedKey.Control)
        65509L -> Some(NamedKey.CapsLock)
        65513L -> Some(NamedKey.Alt)
        65514L -> Some(NamedKey.Alt)
        65515L -> Some(NamedKey.Super)
        65516L -> Some(NamedKey.Super)
        65535L -> Some(NamedKey.Delete)
        269025041L -> Some(NamedKey.AudioVolumeDown)
        269025042L -> Some(NamedKey.AudioVolumeMute)
        269025043L -> Some(NamedKey.AudioVolumeUp)
        else -> None
    }

internal fun platformKeyLocation(code: Long): KeyLocation =
    when (code) {
        29L, 42L, 56L, 125L -> KeyLocation.Left
        54L, 97L, 100L, 126L -> KeyLocation.Right
        55L, 71L, 72L, 73L, 74L, 75L, 76L, 77L, 78L, 79L, 80L, 81L, 82L, 83L, 96L, 98L, 117L, 121L -> KeyLocation.Numpad
        else -> KeyLocation.Standard
    }

internal fun platformModifiers(flags: Long): Modifiers =
    Modifiers(
        flags.and(1L) != 0L,
        flags.and(2L) != 0L,
        flags.and(4L) != 0L,
        flags.and(8L) != 0L,
        flags.and(16L) != 0L,
        false,
        linuxModifierSides(flags, 256L, 512L),
        linuxModifierSides(flags, 1024L, 2048L),
        linuxModifierSides(flags, 4096L, 8192L),
        linuxModifierSides(flags, 16384L, 32768L),
        Some(flags.and(32L) != 0L),
        Some(flags.and(64L) != 0L),
        if (flags.and(131072L) != 0L)
            Some(flags.and(128L) != 0L)
        else
            None
    )

private fun linuxModifierSides(flags: Long, left: Long, right: Long): ModifierSides =
    if (flags.and(65536L) == 0L)
        ModifierSides(None, None)
    else
        ModifierSides(Some(flags.and(left) != 0L), Some(flags.and(right) != 0L))
