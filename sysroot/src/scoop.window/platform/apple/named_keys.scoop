package scoop.window

internal fun appleNamedKey(key: KeyCode): NamedKey? = when (key) {
    case Enter -> Some(NamedKey.Enter)
    case Tab -> Some(NamedKey.Tab)
    case Space -> Some(NamedKey.Space)
    case Backspace -> Some(NamedKey.Backspace)
    case Escape -> Some(NamedKey.Escape)
    case SuperRight -> Some(NamedKey.Super)
    case SuperLeft -> Some(NamedKey.Super)
    case ShiftLeft -> Some(NamedKey.Shift)
    case CapsLock -> Some(NamedKey.CapsLock)
    case AltLeft -> Some(NamedKey.Alt)
    case ControlLeft -> Some(NamedKey.Control)
    case ShiftRight -> Some(NamedKey.Shift)
    case AltRight -> Some(NamedKey.Alt)
    case ControlRight -> Some(NamedKey.Control)
    case Fn -> Some(NamedKey.Fn)
    case F17 -> Some(NamedKey.F17)
    case NumpadClear -> Some(NamedKey.Clear)
    case AudioVolumeUp -> Some(NamedKey.AudioVolumeUp)
    case AudioVolumeDown -> Some(NamedKey.AudioVolumeDown)
    case AudioVolumeMute -> Some(NamedKey.AudioVolumeMute)
    case NumpadEnter -> Some(NamedKey.Enter)
    case F18 -> Some(NamedKey.F18)
    case F19 -> Some(NamedKey.F19)
    case F20 -> Some(NamedKey.F20)
    case F5 -> Some(NamedKey.F5)
    case F6 -> Some(NamedKey.F6)
    case F7 -> Some(NamedKey.F7)
    case F3 -> Some(NamedKey.F3)
    case F8 -> Some(NamedKey.F8)
    case F9 -> Some(NamedKey.F9)
    case Lang2 -> Some(NamedKey.Eisu)
    case F11 -> Some(NamedKey.F11)
    case Lang1 -> Some(NamedKey.Kana)
    case F13 -> Some(NamedKey.F13)
    case F16 -> Some(NamedKey.F16)
    case F14 -> Some(NamedKey.F14)
    case F10 -> Some(NamedKey.F10)
    case ContextMenu -> Some(NamedKey.ContextMenu)
    case F12 -> Some(NamedKey.F12)
    case F15 -> Some(NamedKey.F15)
    case Help -> Some(NamedKey.Help)
    case Home -> Some(NamedKey.Home)
    case PageUp -> Some(NamedKey.PageUp)
    case Delete -> Some(NamedKey.Delete)
    case F4 -> Some(NamedKey.F4)
    case End -> Some(NamedKey.End)
    case F2 -> Some(NamedKey.F2)
    case PageDown -> Some(NamedKey.PageDown)
    case F1 -> Some(NamedKey.F1)
    case ArrowLeft -> Some(NamedKey.ArrowLeft)
    case ArrowRight -> Some(NamedKey.ArrowRight)
    case ArrowDown -> Some(NamedKey.ArrowDown)
    case ArrowUp -> Some(NamedKey.ArrowUp)
    case PrintScreen -> Some(NamedKey.PrintScreen)
    case Pause -> Some(NamedKey.Pause)
    case Insert -> Some(NamedKey.Insert)
    case ScrollLock -> Some(NamedKey.ScrollLock)
    case NumLock -> Some(NamedKey.NumLock)
    else -> None
}
