package scoop.window

/** Publishes applied text immediately, independently of drawing or candidate geometry. */
public fun Window.publishTextInputState(
    connection: TextInputConnection,
    state: TextInputState,
    after: TextInputOrigin? = None
): Boolean {
    checkTextConnection(connection)
    state.validate()
    val sequence =
        when (after) {
            case Some(origin) -> {
                requireWindow(
                    origin.connection == connection && origin.sequence > 0L,
                    "text batch belongs to another connection"
                )
                origin.sequence
            }
            case None -> 0L
        }
    @Unsafe
    {
        return state.surroundingText.withUtf8Bytes {
            bytes,
            length -> @Unsafe
            {
                return@withUtf8Bytes snapshotResult(
                    nativePublishText(
                        owner.pointer!!,
                        NativeTextSnapshot(
                            connection.generation,
                            state.revision,
                            sequence,
                            bytes,
                            length,
                            state.selection.anchor,
                            state.selection.cursor,
                            state.markedRange?.start ?: -1L,
                            state.markedRange?.end ?: -1L
                        )
                    )
                )
            }
        }
    }
}

/** Publishes geometry only for this connection's current, fully applied document revision. */
public fun Window.publishTextInputCaret(
    connection: TextInputConnection,
    revision: Long,
    area: LogicalRect?
): Boolean {
    checkTextConnection(connection)
    requireWindow(revision >= 0L, "negative text revision")
    when (area) {
        case Some(value) -> checkImeCursorArea(value);
        case None -> {}
    }
    @Unsafe
    {
        return snapshotResult(
            nativePublishTextCaret(
                owner.pointer!!,
                connection.generation,
                revision,
                area != None,
                area?.origin?.x ?: 0.0,
                area?.origin?.y ?: 0.0,
                area?.size?.width ?: 0.0,
                area?.size?.height ?: 0.0
            )
        )
    }
}

/** Makes the basic candidate rectangle unavailable until it is explicitly supplied again. */
public fun Window.clearImeCursorArea() {
    owner.requireOpen()
    @Unsafe
    {
        checkNativeStatus(nativeClearImeCaret(owner.pointer!!), "clear IME caret")
    }
}

private fun Window.checkTextConnection(connection: TextInputConnection) {
    owner.requireOpen()
    requireWindow(
        connection.window == id && connection.generation > 0L,
        "text connection belongs to another window"
    )
}

private fun snapshotResult(code: Long): Boolean {
    if (code == 1L)
        return false
    requireWindow(code != 2L, "invalid text snapshot revision or native batch sequence")
    checkNativeStatus(code, "publish text input snapshot")
    return true
}

@CLayout
private struct NativeTextSnapshot(
    val connection: Long,
    val revision: Long,
    val after: Long,
    val text: Ptr<UInt8>,
    val length: Long,
    val anchor: Long,
    val cursor: Long,
    val markedStart: Long,
    val markedEnd: Long
)

@Extern(name = "scoop_window_publish_text")
private fun nativePublishText(window: Ptr<Unit>, snapshot: NativeTextSnapshot): Long

@Extern(name = "scoop_window_publish_text_caret")
private fun nativePublishTextCaret(
    window: Ptr<Unit>,
    connection: Long,
    revision: Long,
    available: Boolean,
    x: Double,
    y: Double,
    width: Double,
    height: Double
): Long

@Extern(name = "scoop_window_clear_ime_caret")
private fun nativeClearImeCaret(window: Ptr<Unit>): Long
