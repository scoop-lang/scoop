package scoop.window

/** Completes keys which the native interpreter left without an editing command. */
internal fun darwinEditingCommand(key: LogicalKey, modifiers: Modifiers): TextEditCommand? {
    if (modifiers.superKey && !modifiers.control && !modifiers.alt && !modifiers.function) {
        if (darwinShortcutCharacter(key, "z"))
            return Some(
                if (modifiers.shift)
                    TextEditCommand.Redo
                else
                    TextEditCommand.Undo
            )
        if (!modifiers.shift) {
            if (darwinShortcutCharacter(key, "a"))
                return Some(TextEditCommand.SelectAll)
            if (darwinShortcutCharacter(key, "c"))
                return Some(TextEditCommand.Copy)
            if (darwinShortcutCharacter(key, "x"))
                return Some(TextEditCommand.Cut)
            if (darwinShortcutCharacter(key, "v"))
                return Some(TextEditCommand.Paste)
        }
        return when (key) {
            case Named(NamedKey.ArrowLeft) -> Some(
                TextEditCommand.Move(TextMovement.LineLeft, modifiers.shift)
            )
            case Named(NamedKey.ArrowRight) -> Some(
                TextEditCommand.Move(TextMovement.LineRight, modifiers.shift)
            )
            case Named(NamedKey.ArrowUp) -> Some(
                TextEditCommand.Move(TextMovement.DocumentStart, modifiers.shift)
            )
            case Named(NamedKey.ArrowDown) -> Some(
                TextEditCommand.Move(TextMovement.DocumentEnd, modifiers.shift)
            )
            case Named(NamedKey.Backspace) -> Some(TextEditCommand.Delete(TextDeletion.LineStart))
            case Named(NamedKey.Enter) -> Some(TextEditCommand.InsertNewline)
            else -> None
        }
    }
    if (modifiers.control && !modifiers.superKey && !modifiers.alt && !modifiers.function) {
        val movement =
            if (darwinShortcutCharacter(key, "a"))
                Some(TextMovement.LineStart)
            else
                if (darwinShortcutCharacter(key, "e"))
                    Some(TextMovement.LineEnd)
                else
                    if (darwinShortcutCharacter(key, "b"))
                        Some(TextMovement.Backward)
                    else
                        if (darwinShortcutCharacter(key, "f"))
                            Some(TextMovement.Forward)
                        else
                            if (darwinShortcutCharacter(key, "p"))
                                Some(TextMovement.Up)
                            else
                                if (darwinShortcutCharacter(key, "n"))
                                    Some(TextMovement.Down)
                                else
                                    None
        when (movement) {
            case Some(value) -> return Some(TextEditCommand.Move(value, modifiers.shift))
            case None -> {}
        }
        if (!modifiers.shift) {
            if (darwinShortcutCharacter(key, "h"))
                return Some(TextEditCommand.Delete(TextDeletion.Backward))
            if (darwinShortcutCharacter(key, "d"))
                return Some(TextEditCommand.Delete(TextDeletion.Forward))
            if (darwinShortcutCharacter(key, "k"))
                return Some(TextEditCommand.Delete(TextDeletion.ParagraphEnd))
        }
        return None
    }
    if (modifiers.superKey || modifiers.control)
        return None
    val movement =
        when (key) {
            case Named(NamedKey.ArrowLeft) -> Some(
                if (modifiers.alt)
                    TextMovement.WordLeft
                else
                    TextMovement.Left
            )
            case Named(NamedKey.ArrowRight) -> Some(
                if (modifiers.alt)
                    TextMovement.WordRight
                else
                    TextMovement.Right
            )
            case Named(NamedKey.ArrowUp) -> Some(
                if (modifiers.alt)
                    TextMovement.ParagraphStart
                else
                    TextMovement.Up
            )
            case Named(NamedKey.ArrowDown) -> Some(
                if (modifiers.alt)
                    TextMovement.ParagraphEnd
                else
                    TextMovement.Down
            )
            case Named(NamedKey.Home) -> Some(TextMovement.DocumentStart)
            case Named(NamedKey.End) -> Some(TextMovement.DocumentEnd)
            case Named(NamedKey.PageUp) -> Some(TextMovement.PageUp)
            case Named(NamedKey.PageDown) -> Some(TextMovement.PageDown)
            else -> None
        }
    when (movement) {
        case Some(value) -> return Some(TextEditCommand.Move(value, modifiers.shift))
        case None -> {}
    }
    return when (key) {
        case Named(NamedKey.Backspace) -> Some(
            TextEditCommand.Delete(
                if (modifiers.alt)
                    TextDeletion.WordBackward
                else
                    TextDeletion.Backward
            )
        )
        case Named(NamedKey.Delete) -> Some(
            TextEditCommand.Delete(
                if (modifiers.alt)
                    TextDeletion.WordForward
                else
                    TextDeletion.Forward
            )
        )
        case Named(NamedKey.Enter) -> Some(TextEditCommand.InsertNewline)
        case Named(NamedKey.Tab) -> Some(
            if (modifiers.shift)
                TextEditCommand.InsertBacktab
            else
                TextEditCommand.InsertTab
        )
        case Named(NamedKey.Escape) -> if (!modifiers.alt && !modifiers.shift)
            Some(TextEditCommand.Cancel)
        else
            None
        else -> None
    }
}

private fun darwinShortcutCharacter(key: LogicalKey, text: String): Boolean =
    LogicalKey.Character(text).matchesShortcut(key)
