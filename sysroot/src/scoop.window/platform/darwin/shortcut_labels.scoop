package scoop.window

internal fun applePhysicalLabel(key: KeyCode): String {
    val code = darwinScanCode(key)
    when (code) {
        case Some(val scan) -> {
            val named = darwinNamedKey(scan)
            when (named) {
                case Some(val value) -> return appleNamedLabel(value)
                case None -> {}
            }
            val text = darwinLayoutLabel(scan.toUInt())
            when (text) {
                case Some(val value) -> return value
                case None -> {}
            }
        }

        case None -> {}
    }
    return physicalKeyName(key)
}

internal fun darwinNamedKey(code: Long): NamedKey? = when (darwinPhysicalKey(code)) {
    case Code(val key) -> appleNamedKey(key)
    case Unidentified(_) -> None
}
