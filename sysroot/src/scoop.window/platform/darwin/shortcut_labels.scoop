        case KeyA -> "KeyA"
        case KeyB -> "KeyB"
        case KeyC -> "KeyC"
        case KeyD -> "KeyD"
        case KeyE -> "KeyE"
        case KeyF -> "KeyF"
        case KeyG -> "KeyG"
        case KeyH -> "KeyH"
        case KeyI -> "KeyI"
        case KeyJ -> "KeyJ"
