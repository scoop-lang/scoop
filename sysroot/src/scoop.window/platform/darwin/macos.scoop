package scoop.window.platform.macos

import scoop.window.*

/** Native application activation policy, selected before Application construction. */
public enum ActivationPolicy {
    Regular, Accessory, Prohibited
}

/** Native titlebar options; they do not add an application menu or widget hierarchy. */
public struct TitlebarOptions(val transparent: Boolean = false, val titleHidden: Boolean = false)

/** Selects AppKit policy before the immutable application configuration is published. */
public var ApplicationOptionsBuilder.macOSActivationPolicy: ActivationPolicy
get() =
    when (activationPolicy) {
        case 1 -> ActivationPolicy.Accessory
        case 2 -> ActivationPolicy.Prohibited
        else -> ActivationPolicy.Regular
    }
set(value) {
    activationPolicy =
        when (value) {
            case Regular -> 0
            case Accessory -> 1
            case Prohibited -> 2
        }
}

/** Configures titlebar flags without changing an existing native window. */
public fun WindowAttributesBuilder.macOSTitlebar(configure: TitlebarOptionsBuilder.() -> Unit) {
    val builder = TitlebarOptionsBuilder(titlebarFlags)
    builder.configure()
    titlebarFlags = titlebarBits(TitlebarOptions(builder.transparent, builder.titleHidden))
}

public class TitlebarOptionsBuilder internal constructor(flags: Int) {
    public var transparent: Boolean = flags.and(1) != 0
    public var titleHidden: Boolean = flags.and(2) != 0
}

/** Updates AppKit titlebar behavior on the owner thread. */
public fun Window.setMacOSTitlebar(options: TitlebarOptions): RequestStatus {
    owner.requireOpen()
    @Unsafe
    {
        nativeWindowTitlebar(owner.pointer!!, titlebarBits(options))
    }
    return RequestStatus.Applied
}

/** Returns the actual main-bundle identifier, or None for an unbundled executable. */
public fun ActiveApplication.macOSApplicationIdentifier(): String? {
    owner.checkThread()
    @Unsafe
    {
        val text = nativeBundleIdentifier()
        return when (text.data) {
            case Some(val pointer) -> Some(String.fromUtf8(pointer, text.length));
            case None -> None
        }
    }
}

private fun titlebarBits(options: TitlebarOptions): Int =
    flag(options.transparent) + flag(options.titleHidden) * 2

@CLayout
private struct NativeBundleIdentifier(val data: Ptr<UInt8>?, val length: Long)

@Extern(name = "scoop_window_bundle_identifier")
private fun nativeBundleIdentifier(): NativeBundleIdentifier
