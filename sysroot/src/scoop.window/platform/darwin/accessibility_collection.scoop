package scoop.window.accessibility

import scoop.window.*

/** One narrow owner callback for immutable collection data, never for UI construction. */
internal class DarwinCollectionQueries(
    private val application: ApplicationOwner,
    provider: AccessibilityProvider
): Closeable {
    private val callback = collectionCallback(application, provider)

    fun attach(pointer: Ptr<Unit>) {
        @Unsafe
        {
            nativeCollectionCallback(pointer, callback.function, callback.context)
        }
    }

    fun publish(pointer: Ptr<Unit>, node: AccessibilityNode) {
        @Unsafe
        {
            checkNativeStatus(
                nativeCollectionSource(
                    pointer,
                    node.id.number,
                    node.collectionValue?.count ?: -1L,
                    node.collectionRevision
                ),
                "publish semantic collection"
            )
            when (val key = node.itemKey) {
                case Some(val value) -> {
                    withCollectionKey(value) {
                        kind,
                        number,
                        bytes,
                        length -> @Unsafe
                        {
                            checkNativeStatus(
                                nativeCollectionRow(
                                    pointer,
                                    node.id.number,
                                    kind,
                                    number,
                                    bytes,
                                    length
                                ),
                                "publish semantic collection row"
                            )
                        }
                    }
                }
                case None -> {}
            }
        }
    }

    public override fun close() {
        val owned = callback
        application.mailbox.postControl {
            @Unsafe
            {
                releaseForeignCallback(owned)
            }
        }
    }
}

private class CollectionQueryStatus {
    var value = 4
}

private fun collectionCallback(application: ApplicationOwner, provider: AccessibilityProvider):
ForeignCallback<(Ptr<Unit>, Long, Int, Long, Int, Long, Ptr<UInt8>?, Long, Ptr<Unit>?) -> Int> {
    @Unsafe
    {
        return foreignCallback<
            (Ptr<Unit>, Long, Int, Long, Int, Long, Ptr<UInt8>?, Long, Ptr<Unit>?) -> Int
        >(
            {
                owner: Long,
                operation: Int,
                index: Long,
                kind: Int,
                number: Long,
                bytes: Ptr<UInt8>?,
                length: Long,
                reply: Ptr<Unit>? -> queryCollection(
                    application,
                    provider,
                    owner,
                    operation,
                    index,
                    kind,
                    number,
                    bytes,
                    length,
                    reply
                )
            },
            0,
            ForeignCallbackMode.Reusable
        )
    }
}

private fun queryCollection(
    application: ApplicationOwner,
    provider: AccessibilityProvider,
    owner: Long,
    operation: Int,
    index: Long,
    kind: Int,
    number: Long,
    bytes: Ptr<UInt8>?,
    length: Long,
    reply: Ptr<Unit>?
): Int {
    if (operation == 2) {
        try {
            val source = provider.collectionSource(owner, true) ?: return 4
            val key = collectionKey(kind, number, bytes, length) ?: return 4
            return if (source.contains(key))
                1
            else
                2
        } catch (error: Throwable) {
            application.recordFailure(error)
            application.beginExit()
            return 4
        }
    }
    val status = CollectionQueryStatus()
    val result =
        application.performAccessibility {
            val source = provider.collectionSource(owner, false)
            when (source) {
                case Some(val value) -> {
                    val item =
                        if (operation == 0)
                            value.itemAt(index)
                        else {
                            val key = collectionKey(kind, number, bytes, length)
                            when (key) {
                                case Some(val actual) -> value.itemForKey(actual)
                                case None -> SemanticItemResult.Unavailable
                            }
                        }
                    status.value =
                        when (item) {
                            case Found(val found) -> when (reply) {
                                case Some(val target) -> {
                                    writeCollectionItem(target, found);
                                    1
                                }
                                case None -> 4
                            }
                            case NotFound -> 2
                            case Unavailable -> 3
                            case Unsupported -> 5
                        }
                }
                case None -> {}
            }
            SemanticActionResult.Completed
        }
    return if (result == SemanticActionResult.Completed)
        status.value
    else
        0
}

private fun collectionKey(
    kind: Int,
    number: Long,
    bytes: Ptr<UInt8>?,
    length: Long
): SemanticItemKey? {
    if (kind == 0)
        return Some(SemanticItemKey.Number(number))
    if (kind != 1 || length < 0L)
        return None
    when (bytes) {
        case Some(val text) -> {
            @Unsafe
            {
                return Some(SemanticItemKey.Text(String.fromUtf8(text, length)))
            }
        }
        case None -> return if (length == 0L)
            Some(SemanticItemKey.Text(""))
        else
            None
    }
}

private fun withCollectionKey(key: SemanticItemKey, block: (Int, Long, Ptr<UInt8>?, Long) -> Unit) {
    when (key) {
        case Number(val number) -> block(0, number, None, 0L)
        case Text(val text) -> {
            @Unsafe
            {
                text.withUtf8Bytes { bytes, length -> block(1, 0L, Some(bytes), length) }
            }
        }
    }
}

private fun writeCollectionItem(reply: Ptr<Unit>, item: SemanticItem) {
    val props = item.properties
    @Unsafe
    {
        nativeCollectionItem(
            reply,
            item.index,
            item.count,
            if (props.enabled)
                1
            else
                0,
            when (props.selected) {
                case None -> -1;
                case Some(val value) -> if (value)
                    1
                else
                    0
            },
            when (props.expanded) {
                case None -> -1;
                case Some(val value) -> if (value)
                    1
                else
                    0
            }
        )
    }
    withCollectionKey(item.key) {
        kind,
        number,
        bytes,
        length -> @Unsafe
        {
            nativeCollectionItemKey(reply, kind, number, bytes, length)
        }
    }
    collectionText(reply, 0, props.name)
    collectionText(reply, 1, props.description)
    collectionText(reply, 2, props.automationId)
    collectionText(reply, 3, props.value)
}

private fun collectionText(reply: Ptr<Unit>, field: Int, value: String?) {
    when (value) {
        case Some(val text) -> {
            @Unsafe
            {
                text.withUtf8Bytes {
                    bytes,
                    length -> @Unsafe
                    {
                        nativeCollectionItemText(reply, field, bytes, length)
                    }
                }
            }
        }
        case None -> {}
    }
}

@Extern(name = "scoop_window_accessibility_collection_callback")
private fun nativeCollectionCallback(
    provider: Ptr<Unit>,
    callback: FunPtr<(Ptr<Unit>, Long, Int, Long, Int, Long, Ptr<UInt8>?, Long, Ptr<Unit>?) -> Int>,
    context: Ptr<Unit>
)

@Extern(name = "scoop_window_accessibility_collection")
private fun nativeCollectionSource(
    provider: Ptr<Unit>,
    number: Long,
    count: Long,
    revision: ULong
): Long

@Extern(name = "scoop_window_accessibility_collection_row")
private fun nativeCollectionRow(
    provider: Ptr<Unit>,
    node: Long,
    kind: Int,
    number: Long,
    text: Ptr<UInt8>?,
    length: Long
): Long

@Extern(name = "scoop_window_accessibility_collection_item")
private fun nativeCollectionItem(
    reply: Ptr<Unit>,
    index: Long,
    count: Long,
    enabled: Int,
    selected: Int,
    expanded: Int
)

@Extern(name = "scoop_window_accessibility_collection_item_key")
private fun nativeCollectionItemKey(
    reply: Ptr<Unit>,
    kind: Int,
    number: Long,
    text: Ptr<UInt8>?,
    length: Long
)

@Extern(name = "scoop_window_accessibility_collection_item_text")
private fun nativeCollectionItemText(reply: Ptr<Unit>, field: Int, text: Ptr<UInt8>, length: Long)
