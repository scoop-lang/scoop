package scoop.window

/** Reverse the backend's supported physical positions for layout queries. */
internal fun darwinScanCode(key: KeyCode): Long? =
    when (key) {
        case KeyA -> Some(0L)
        case KeyS -> Some(1L)
        case KeyD -> Some(2L)
        case KeyF -> Some(3L)
        case KeyH -> Some(4L)
        case KeyG -> Some(5L)
        case KeyZ -> Some(6L)
        case KeyX -> Some(7L)
        case KeyC -> Some(8L)
        case KeyV -> Some(9L)
        case IntlBackslash -> Some(10L)
        case KeyB -> Some(11L)
        case KeyQ -> Some(12L)
        case KeyW -> Some(13L)
        case KeyE -> Some(14L)
        case KeyR -> Some(15L)
        case KeyY -> Some(16L)
        case KeyT -> Some(17L)
        case Digit1 -> Some(18L)
        case Digit2 -> Some(19L)
        case Digit3 -> Some(20L)
        case Digit4 -> Some(21L)
        case Digit6 -> Some(22L)
        case Digit5 -> Some(23L)
        case Equal -> Some(24L)
        case Digit9 -> Some(25L)
        case Digit7 -> Some(26L)
        case Minus -> Some(27L)
        case Digit8 -> Some(28L)
        case Digit0 -> Some(29L)
        case BracketRight -> Some(30L)
        case KeyO -> Some(31L)
        case KeyU -> Some(32L)
        case BracketLeft -> Some(33L)
        case KeyI -> Some(34L)
        case KeyP -> Some(35L)
        case Enter -> Some(36L)
        case KeyL -> Some(37L)
        case KeyJ -> Some(38L)
        case Quote -> Some(39L)
        case KeyK -> Some(40L)
        case Semicolon -> Some(41L)
        case Backslash -> Some(42L)
        case Comma -> Some(43L)
        case Slash -> Some(44L)
        case KeyN -> Some(45L)
        case KeyM -> Some(46L)
        case Period -> Some(47L)
        case Tab -> Some(48L)
        case Space -> Some(49L)
        case Backquote -> Some(50L)
        case Backspace -> Some(51L)
        case Escape -> Some(53L)
        case SuperRight -> Some(54L)
        case SuperLeft -> Some(55L)
        case ShiftLeft -> Some(56L)
        case CapsLock -> Some(57L)
        case AltLeft -> Some(58L)
        case ControlLeft -> Some(59L)
        case ShiftRight -> Some(60L)
        case AltRight -> Some(61L)
        case ControlRight -> Some(62L)
        case Fn -> Some(63L)
        case F17 -> Some(64L)
        case NumpadDecimal -> Some(65L)
        case NumpadMultiply -> Some(67L)
        case NumpadAdd -> Some(69L)
        case NumpadClear -> Some(71L)
        case AudioVolumeUp -> Some(72L)
        case AudioVolumeDown -> Some(73L)
        case AudioVolumeMute -> Some(74L)
        case NumpadDivide -> Some(75L)
        case NumpadEnter -> Some(76L)
        case NumpadSubtract -> Some(78L)
        case F18 -> Some(79L)
        case F19 -> Some(80L)
        case NumpadEqual -> Some(81L)
        case Numpad0 -> Some(82L)
        case Numpad1 -> Some(83L)
        case Numpad2 -> Some(84L)
        case Numpad3 -> Some(85L)
        case Numpad4 -> Some(86L)
        case Numpad5 -> Some(87L)
        case Numpad6 -> Some(88L)
        case Numpad7 -> Some(89L)
        case F20 -> Some(90L)
        case Numpad8 -> Some(91L)
        case Numpad9 -> Some(92L)
        case IntlYen -> Some(93L)
        case IntlRo -> Some(94L)
        case NumpadComma -> Some(95L)
        case F5 -> Some(96L)
        case F6 -> Some(97L)
        case F7 -> Some(98L)
        case F3 -> Some(99L)
        case F8 -> Some(100L)
        case F9 -> Some(101L)
        case Lang2 -> Some(102L)
        case F11 -> Some(103L)
        case Lang1 -> Some(104L)
        case F13 -> Some(105L)
        case F16 -> Some(106L)
        case F14 -> Some(107L)
        case F10 -> Some(109L)
        case ContextMenu -> Some(110L)
        case F12 -> Some(111L)
        case F15 -> Some(113L)
        case Help -> Some(114L)
        case Home -> Some(115L)
        case PageUp -> Some(116L)
        case Delete -> Some(117L)
        case F4 -> Some(118L)
        case End -> Some(119L)
        case F2 -> Some(120L)
        case PageDown -> Some(121L)
        case F1 -> Some(122L)
        case ArrowLeft -> Some(123L)
        case ArrowRight -> Some(124L)
        case ArrowDown -> Some(125L)
        case ArrowUp -> Some(126L)
        else -> None
    }
