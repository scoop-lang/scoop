package scoop.tests.window

/** Identifies the display protocol of the leased GTK window. */
@Extern(name = "scoop_test_gtk_x11")
public fun usesX11(window: Ptr<Unit>): Boolean

/** Delivers X11 protocol events to the test's GTK content widget. These are synthesized input. */
@Extern(name = "scoop_test_gtk_input")
public fun sendGtkInput(window: Ptr<Unit>, view: Ptr<Unit>): Int

/** Press, drag motion, and release through an isolated X11 server, without activation. */
@Extern(name = "scoop_test_gtk_drag_pointer")
public fun sendGtkDragPointer(window: Ptr<Unit>, phase: Int): Int

/** Checks the mapped X11 drag icon against the expected logical image and pointer position. */
@Extern(name = "scoop_test_gtk_drag_icon")
public fun inspectGtkDragIcon(window: Ptr<Unit>): Int

/** Compares raw-event conversion used by contacts with GTK's delivered mouse position. */
@Extern(name = "scoop_test_gtk_contact_position")
public fun matchesGtkContactPosition(view: Ptr<Unit>, x: Double, y: Double): Boolean

/** Exercises scale notification with unchanged allocated logical dimensions. */
@Extern(name = "scoop_test_gtk_scale_notification")
public fun exerciseGtkScaleNotification(window: Ptr<Unit>): Boolean

/** Whether the display has the compositor required for a transparent GTK window. */
@Extern(name = "scoop_test_gtk_composited")
public fun isComposited(window: Ptr<Unit>): Boolean

@Extern(name = "scoop_test_gtk_clipboard_nul")
public fun writeNulClipboard(window: Ptr<Unit>): Boolean
