package scoop.tests.window

/** Returns one for a visible window station, zero for a service station, or -1 on error. */
@Unsafe
@Extern(name = "scoop_window_test_visible_station")
public fun nativeWindowStationVisible(): Int

/** Arms an actual WM_TIMER callback on a hidden window, without posting WM_TIMER. */
@Unsafe
@Extern(name = "scoop_window_test_start_polling_timer")
public fun startNativePollingTimer(window: Ptr<Unit>): Boolean

@Unsafe
@Extern(name = "scoop_window_test_polling_timer_fired")
public fun nativePollingTimerFired(): Boolean

/** Posts a real Win32 message to the application's HWND for protocol tests. */
@Unsafe
@Extern(name = "PostMessageW", lib = "user32")
public fun postMessage(window: Ptr<Unit>, message: UInt, wparam: ULong, lparam: Long): Int

/** Delivers one protocol message synchronously, without TranslateMessage synthesizing text. */
@Unsafe
@Extern(name = "SendMessageW", lib = "user32")
public fun sendMessage(window: Ptr<Unit>, message: UInt, wparam: ULong, lparam: Long): Long

@Unsafe
@Extern(name = "scoop_window_test_schedule_mode")
public fun scheduleNativeMode(window: Ptr<Unit>, mode: Int, milliseconds: Int): Int

@Unsafe
@Extern(name = "scoop_window_test_active_mode")
public fun activeNativeMode(): Int

@Unsafe
@Extern(name = "scoop_window_test_completed_modes")
public fun completedNativeModes(): Int

@Unsafe
@Extern(name = "scoop_window_test_system_dpi")
public fun setSystemDpiMode(): Int

/** Verifies owner-thread V2 preparation without changing an existing V1 HWND. */
@Unsafe
@Extern(name = "scoop_window_test_per_monitor_dpi")
public fun exercisePerMonitorDpi(): Int

@Unsafe
@Extern(name = "scoop_window_test_text")
public fun exerciseNativeText(window: Ptr<Unit>): Int

@Unsafe
@Extern(name = "scoop_window_test_snapshot")
public fun exerciseNativeSnapshot(window: Ptr<Unit>, phase: Int): Int

@Unsafe
@Extern(name = "scoop_window_test_caret")
public fun nativeCaretMatches(window: Ptr<Unit>): Int

@Unsafe
@Extern(name = "scoop_window_test_input")
public fun nativeInputSequence(window: Ptr<Unit>)

@Unsafe
@Extern(name = "scoop_window_test_pointer_cancellation")
public fun nativePointerCancellation(window: Ptr<Unit>)

/** Sends mouse down/up input; Windows produces its own click messages and timing. */
@Unsafe
@Extern(name = "scoop_window_test_mouse_clicks")
public fun nativeMouseClicks(window: Ptr<Unit>): Int
