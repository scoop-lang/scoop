package scoop.tests.window

/** Installs native text without the public clipboard normalization. */
public fun setNativeClipboardText(text: String): Int {
    @Unsafe
    {
        return text.withUtf8Bytes {
            bytes,
            length -> @Unsafe
            {
                return@withUtf8Bytes nativeClipboardText(bytes, length)
            }
        }
    }
}

@Extern(name = "scoop_window_test_clipboard_text")
private fun nativeClipboardText(bytes: Ptr<UInt8>, length: Long): Int

/** Saves every current pasteboard item and data type before a native clipboard test. */
@Extern(name = "scoop_window_test_clipboard_save")
public fun saveNativeClipboard(): Ptr<Unit>?

/** Restores and releases the snapshot, also cancelling an unused failure injection. */
@Extern(name = "scoop_window_test_clipboard_restore")
public fun restoreNativeClipboard(snapshot: Ptr<Unit>): Int

/** Installs a non-text item so readText can distinguish absence from empty text. */
@Extern(name = "scoop_window_test_clipboard_nontext")
public fun setNativeClipboardNonText(): Int

/** Makes the next native writeObjects call fail once, without changing production code. */
@Extern(name = "scoop_window_test_clipboard_fail_write")
public fun failNextNativeClipboardWrite(): Int

/** Writes an actual pasteboard type with unmodified bytes, including malformed UTF-8. */
public fun setNativeClipboardData(nativeType: String, data: Array<Byte>): Int {
    @Unsafe
    {
        return nativeType.withUtf8Bytes {
            typeBytes,
            typeLength -> @Unsafe
            {
                return@withUtf8Bytes data.withDataPointer {
                    bytes,
                    length -> @Unsafe
                    {
                        return@withDataPointer nativeClipboardData(
                            typeBytes,
                            typeLength,
                            bytes.cast<UInt8>(),
                            length
                        )
                    }
                }
            }
        }
    }
}

/** Checks bytes under a platform type without the public media type mapping. */
public fun nativeClipboardDataMatches(nativeType: String, text: String): Int {
    @Unsafe
    {
        return nativeType.withUtf8Bytes {
            typeBytes,
            typeLength -> @Unsafe
            {
                return@withUtf8Bytes text.withUtf8Bytes {
                    bytes,
                    length -> @Unsafe
                    {
                        return@withUtf8Bytes nativeClipboardMatches(
                            typeBytes,
                            typeLength,
                            bytes,
                            length
                        )
                    }
                }
            }
        }
    }
}

public fun nativeClipboardItemCount(): Long {
    @Unsafe
    {
        return nativeClipboardCount()
    }
}

@Extern(name = "scoop_window_test_clipboard_data")
private fun nativeClipboardData(
    nativeType: Ptr<UInt8>,
    typeLength: Long,
    bytes: Ptr<UInt8>,
    length: Long
): Int

@Extern(name = "scoop_window_test_clipboard_matches")
private fun nativeClipboardMatches(
    nativeType: Ptr<UInt8>,
    typeLength: Long,
    bytes: Ptr<UInt8>,
    length: Long
): Int

@Extern(name = "scoop_window_test_clipboard_count")
private fun nativeClipboardCount(): Long
