package scoop.tests.window

/** Installs native text without the public clipboard normalization. */
public fun setNativeClipboardText(text: String): Int {
    @Unsafe
    {
        return text.withUtf8Bytes {
            bytes,
            length -> @Unsafe
            {
                return@withUtf8Bytes nativeClipboardText(bytes, length)
            }
        }
    }
}

@Extern(name = "scoop_window_test_clipboard_text")
private fun nativeClipboardText(bytes: Ptr<UInt8>, length: Long): Int

/** Saves every current pasteboard item and data type before a native clipboard test. */
@Extern(name = "scoop_window_test_clipboard_save")
public fun saveNativeClipboard(): Ptr<Unit>?

/** Restores and releases the snapshot, also cancelling an unused failure injection. */
@Extern(name = "scoop_window_test_clipboard_restore")
public fun restoreNativeClipboard(snapshot: Ptr<Unit>): Int

/** Installs a non-text item so readText can distinguish absence from empty text. */
@Extern(name = "scoop_window_test_clipboard_nontext")
public fun setNativeClipboardNonText(): Int

/** Makes the next native writeObjects call fail once, without changing production code. */
@Extern(name = "scoop_window_test_clipboard_fail_write")
public fun failNextNativeClipboardWrite(): Int
