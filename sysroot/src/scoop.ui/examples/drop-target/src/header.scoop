package scoop.examples.ui.drop

import scoop.graphics.*
import scoop.graphics.text.*
import scoop.ui.*
import scoop.platform.system.OperatingSystem
import scoop.platform.system.operatingSystem
import scoop.ui.text.*

internal class DropHeader(private val props: Props<String>, scope: ComponentScope): Element<
    ParagraphMeasurement
>(scope) {
    private val paragraph = scope.resource { ParagraphHost() }
    public override fun measure(context: MeasureContext, constraints: Constraints): LayoutResult<
        ParagraphMeasurement
    > {
        val message = props.value
        val copy =
            if (operatingSystem == OperatingSystem.Darwin)
                "Option"
            else
                "Control"
        val shortcut =
            if (operatingSystem == OperatingSystem.Darwin)
                "Command C"
            else
                "Control C"
        val content =
            styledText {
                text(
                    f"Left: drag text; click to paste. Right: drag URL; click to copy.\n${
                        shortcut
                    } copies the focused region. Select text in the editor to move it; hold ${
                        copy
                    } to copy.\n\n" +
                        message
                )
                style { fontSize = 18.0 }
            }
        val measured = paragraph.measure(context, constraints, scope.defaultFonts, content)
        return LayoutResult(measured.metrics, measured, { measured.close() })
    }
    public override fun scene(context: SceneContext, measured: ParagraphMeasurement) {
        paragraph.scene(context, measured)
    }
}
