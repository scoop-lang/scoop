package scoop.ui

import scoop.collections.HashMap
import scoop.collections.sortedBy
import scoop.graphics.Point
import scoop.time.TimeMark

internal class LazyItemMeasure {
    var constraints: Constraints? = None
    var result: NodeLayout? = None
    var entry: LazyItemEntry? = None
    var origin: Point? = None
    val placed: Boolean get() = origin != None
}

internal class LazyLayoutItem(
    val entry: LazyItemEntry,
    val result: NodeLayout,
    val origin: Point?
) {
    val placed: Boolean get() = origin != None
}

/** Requests item preparation only at an explicit, synchronous framework boundary. */
public class LazyMeasureContext internal constructor(
    private val node: MountedNode,
    private val items: LazyChildren,
    private val mark: TimeMark
) {
    public val layoutDirection: LayoutDirection get() {
        checkActive();
        return node.layoutDirection
    }
    private var active = true
    private var borrowed = false
    private val measured = HashMap<Long, LazyItemMeasure>()
    public val time: TimeMark get() {
        checkActive()
        observeFrameTime()
        return mark
    }
    public val itemCount: Long get() {
        checkActive()
        return items.count
    }
    public val pinnedItems: Array<Long> get() {
        checkActive()
        return items.pinnedItems(node)
    }
    private fun checkActive() {
        node.root.checkThread()
        if (!active)
            throw IllegalStateException(Some("lazy measure context has ended"))
        if (borrowed)
            throw IllegalStateException(
                Some("lazy measure context is preparing or measuring an item")
            )
        if (!node.root.isOpen)
            throw UiLayoutEnded()
    }
    public fun measureItem(index: Long, constraints: Constraints): LayoutMetrics {
        checkActive()
        requireUi(index >= 0L && index < items.count, "item index is out of range")
        val entry = measured[index] ?: LazyItemMeasure()
        if (entry.placed)
            throw IllegalStateException(Some("item was already placed"))
        when (entry.result) {
            case Some(result) -> if (
                entry.constraints ==
                    Some(constraints) &&
                    result.version ==
                    result.node.layoutVersion
            )
                return result.metrics
            case None -> {}
        }
        entry.result = None
        measured.put(index, entry)
        constraints.check()
        borrowed = true
        try {
            val item = prepareUi<LazyItemEntry> { items.prepare(node, index, mark) }
            val result = item.node.measure(constraints, mark)
            entry.constraints = Some(constraints)
            entry.result = Some(result)
            entry.entry = Some(item)
            return result.metrics
        } finally {
            borrowed = false
        }
    }
    public fun placeItem(index: Long, origin: Point) {
        checkActive()
        requireUi(origin.x.isFinite() && origin.y.isFinite(), "non-finite item origin")
        val entry =
            measured[index] ?:
                throw IllegalStateException(Some("item must be measured before placement"))
        when (entry.result) {
            case None -> throw IllegalStateException(Some("item measurement did not complete"))
            case Some(_) -> {}
        }
        if (entry.placed)
            throw IllegalStateException(Some("item was already placed"))
        entry.origin = Some(origin)
    }
    internal fun finish(): Array<LazyLayoutItem> {
        checkActive()
        for (entry in measured.values)
            when (entry.result) {
                case None -> throw IllegalStateException(Some("item measurement did not complete"))
                case Some(_) -> {}
            }
        val selected = ArrayList<LazyLayoutItem>()
        for (value in measured.values)
            selected.add(LazyLayoutItem(value.entry!!, value.result!!, value.origin))
        return selected.sortedBy<LazyLayoutItem, Long> { value -> value.entry.index }.toArray()
    }
    internal fun end() {
        active = false
    }
}

/** Internal control flow only for a root explicitly closed during item preparation. */
internal class UiLayoutEnded: Exception(Some("UI root closed during layout"))
