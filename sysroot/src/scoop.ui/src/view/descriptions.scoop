package scoop.ui

internal interface ComponentDescriptionBase {
    fun sameType(other: ComponentDescriptionBase): Boolean
    fun create(): ComponentInstance
}

internal interface ElementDescriptionBase {
    fun sameType(other: ElementDescriptionBase): Boolean
    fun create(): ElementInstance
}

internal interface ComponentInstance {
    val value: Component
    fun replace(description: ComponentDescriptionBase)
}

internal interface ElementInstance {
    val value: Element
    fun replace(description: ElementDescriptionBase)
}

internal interface LazyDescriptionBase {
    fun sameType(other: LazyDescriptionBase): Boolean
    fun create(): LazyInstance
}

internal interface LazyInstance {
    val value: LazyElement
    fun replace(description: LazyDescriptionBase)
}

internal class LazyDescription<P, E: LazyElement>(
    val input: P,
    private val factory: (Props<P>) -> E
): LazyDescriptionBase {
    override fun sameType(other: LazyDescriptionBase): Boolean = other is LazyDescription<P, E>
    override fun create(): LazyInstance {
        val props = Props(input)
        return TypedLazyInstance<P, E>(props, factory(props))
    }
}

private class TypedLazyInstance<P, E: LazyElement>(
    private val props: Props<P>,
    private val instance: E
): LazyInstance {
    override val value: LazyElement get() = instance
    override fun replace(description: LazyDescriptionBase) {
        props.replace((description as LazyDescription<P, E>).input)
    }
}

internal class ComponentDescription<P, C: Component>(
    val input: P,
    private val factory: (Props<P>) -> C
): ComponentDescriptionBase {
    override fun sameType(other: ComponentDescriptionBase): Boolean =
        other is ComponentDescription<P, C>
    override fun create(): ComponentInstance {
        val props = Props(input)
        return TypedComponentInstance<P, C>(props, factory(props))
    }
}

private class TypedComponentInstance<P, C: Component>(
    private val props: Props<P>,
    private val instance: C
): ComponentInstance {
    override val value: Component get() = instance
    override fun replace(description: ComponentDescriptionBase) {
        props.replace((description as ComponentDescription<P, C>).input)
    }
}

internal class ElementDescription<P, E: Element>(
    val input: P,
    private val factory: (Props<P>) -> E
): ElementDescriptionBase {
    override fun sameType(other: ElementDescriptionBase): Boolean =
        other is ElementDescription<P, E>
    override fun create(): ElementInstance {
        val props = Props(input)
        return TypedElementInstance<P, E>(props, factory(props))
    }
}

private class TypedElementInstance<P, E: Element>(
    private val props: Props<P>,
    private val instance: E
): ElementInstance {
    override val value: Element get() = instance
    override fun replace(description: ElementDescriptionBase) {
        props.replace((description as ElementDescription<P, E>).input)
    }
}
