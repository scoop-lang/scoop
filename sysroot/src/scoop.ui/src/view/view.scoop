package scoop.ui

/** Identity is local to the immediate parent's complete child sequence. */
public enum ViewKey: Equals<ViewKey>, Hash {
    Position, Text(String), Number(Long)
    public override operator fun equals(other: ViewKey): Boolean =
        when ((this, other)) {
            case(Position, Position) -> true
            case(Text(a), Text(b)) -> a == b
            case(Number(a), Number(b)) -> a == b
            else -> false
        }
    public override fun hash(): Long =
        when (this) {
            case Position -> 0L
            case Text(value) -> value.hash()
            case Number(value) -> value.hash()
        }
}

/** Immutable description; constructing or copying it never mounts an instance. */
public class View internal constructor(internal val key: ViewKey, internal val body: ViewBody)

public fun empty(): View = View(ViewKey.Position, ViewBody.Empty)

/** Keeps logical ownership while presenting one child in the window's layer outlet. */
public fun portal(
    open: Binding<Boolean>,
    content: View,
    configure: PortalBuilder.() -> Unit = {}
): View {
    val builder = PortalBuilder()
    builder.configure()
    return View(builder.key, ViewBody.Portal(content, open, builder.snapshot()))
}

/** Factories retain a concrete class type and create a fresh instance for each new mount. */
public fun <C: Component> component(create: () -> C, key: ViewKey = ViewKey.Position): View =
    component(Unit, { _ -> create() }, key)

public fun <P, C: Component> component(
    props: P,
    create: (Props<P>) -> C,
    key: ViewKey = ViewKey.Position
): View = View(key, ViewBody.Component(ComponentDescription(props, create)))

/** Factories retain a concrete class type and create a fresh instance for each new mount. */
public fun <L, E: Element<L>> element(
    create: () -> E,
    children: Array<View> = [],
    key: ViewKey = ViewKey.Position
): View = element(Unit, { _ -> create() }, children, key)

public fun <P, L, E: Element<L>> element(
    props: P,
    create: (Props<P>) -> E,
    children: Array<View> = [],
    key: ViewKey = ViewKey.Position
): View = View(key, ViewBody.Element(ElementDescription(props, create), children))

internal enum ViewBody {
    Empty, Component(ComponentDescriptionBase), Element(ElementDescriptionBase, Array<View>),
    Portal(View, Binding<Boolean>, PortalOptions), Lazy(
        LazyDescriptionBase,
        ItemSource,
        Long
    ), Direction(View, LayoutDirection)
}

/** Type matching has no factory, input replacement, or mounting side effects. */
internal fun View.sameType(other: View): Boolean =
    when ((body, other.body)) {
        case(Empty, Empty) -> true
        case(Direction(_, _), Direction(_, _)) -> true
        case(Component(a), Component(b)) -> a.sameType(b)
        case(Element(a, _), Element(b, _)) -> a.sameType(b)
        case(Lazy(a, _, _), Lazy(b, _, _)) -> a.sameType(b)
        case(Portal(_, _, a), Portal(_, _, b)) -> a.mode == b.mode
        else -> false
    }

/** Factories retain a concrete class type and create a fresh instance for each new mount. */
public fun <L, E: LazyElement<L>> lazyElement(
    source: ItemSource,
    create: () -> E,
    retention: ItemRetention = ItemRetention.Dispose,
    key: ViewKey = ViewKey.Position
): View = lazyElement(source, Unit, { _ -> create() }, retention, key)

public fun <P, L, E: LazyElement<L>> lazyElement(
    source: ItemSource,
    props: P,
    create: (Props<P>) -> E,
    retention: ItemRetention = ItemRetention.Dispose,
    key: ViewKey = ViewKey.Position
): View =
    View(key, ViewBody.Lazy(LazyDescription(props, create), source, retentionLimit(retention)))
