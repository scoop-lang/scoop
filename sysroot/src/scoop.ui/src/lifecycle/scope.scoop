package scoop.ui

import scoop.graphics.*
import scoop.graphics.text.FontCollection
import scoop.surface.*
import scoop.window.*

/** Owns the resources of one mount; applications do not close individual components. */
public class ComponentScope internal constructor(private val node: MountedNode) {
    private val root: UiRoot get() = node.root
    private var active = true
    internal var fontReads: DependencyCollector? = None
    private val resources = ScopeResources()
    private val managed = resources.managed
    private val cleanup = resources.cleanup
    private val events =
        ScopedNativeEvents(root.host, resources, { checkMounted() }, { action -> dispatch(action) })
    private var route: InputScope? = None
    private var childRoute: InputScope? = None
    private var animationGroup: AnimationGroup? = None

    /** The root owns its fallback collection; explicit application collections remain borrowed. */
    public val defaultFonts: FontCollection get() {
        checkMounted()
        fontReads?.read(root.fonts.signal)
        when (currentEvaluation()) {
            case Some(evaluation) -> {
                evaluation.collector?.read(root.fonts.signal)
                evaluation.frameReads?.readDefaults(root.fonts)
            }
            case None -> {}
        }
        return root.fonts.value
    }

    /** The borrowed native owner; the mount does not acquire or transfer its lifetime. */
    public val layoutDirection: LayoutDirection get() {
        checkMounted();
        return node.layoutDirection
    }

    public val nativeWindow: Window get() {
        checkMounted()
        return root.window
    }

    public val application: ActiveApplication get() {
        checkMounted();
        return root.host.activeApplication
    }
    public val uiHost: UiHost get() {
        checkMounted();
        return root.host
    }
    public fun dispatch(action: () -> Unit): Boolean {
        if (!isMounted)
            return false
        return root.surface.dispatch {
            if (isMounted)
                action()
        } &&
            isMounted
    }
    public fun observeMenu(menu: Menu, action: (MenuActivation) -> Unit): Closeable =
        events.menu(menu, action)
    public fun observeWindow(window: Window, action: (WindowEvent) -> Unit): Closeable =
        events.window(window, action)
    public fun declareMenuBar(create: () -> UiMenuBarContent): UiMenuBarDeclaration {
        checkMounted()
        val value =
            root.host.menuBars.register(
                Some(nativeWindow),
                { isMounted },
                { action -> dispatch(action) },
                create
            )
        managed.add(value)
        value.update()
        return value
    }
    public fun observePopup(session: PopupSession, action: (PopupResult) -> Unit): Closeable =
        events.popup(session, action)
    public fun observeModal(session: ModalSession, action: (ModalResult) -> Unit): Closeable =
        events.modal(session, action)
    public fun <T> observeFileDialog(
        session: FileDialogSession<T>,
        action: (FileDialogResult<T>) -> Unit
    ): Closeable = events.file(session, action)
    public fun observeFrameMetrics(action: (WindowFrameMetrics?) -> Unit): Closeable =
        events.frame(nativeWindow, action)

    public val input: InputScope get() {
        checkMounted()
        when (route) {
            case Some(value) -> return value
            case None -> {}
        }
        val value =
            when (node.parent) {
                case Some(parent) -> root.surface.createScope(Some(parent.scope.forChildren()))
                case None -> root.surface.input
            }
        route = Some(value)
        managed.add(value)
        return value
    }
    internal fun forChildren(): InputScope = childRoute ?: input
    internal val hasInputActivity: Boolean get() =
        when (route) {
            case Some(value) -> !value.activity.isEmpty
            case None -> false
        }
    /** Routes logical descendants through an area owned by this mount. */
    public fun routeChildren(area: InputArea) {
        checkMounted()
        requireBehaviorArea(area)
        for (child in node.children)
            child.scope.reparentInput(area.scope)
        childRoute = Some(area.scope)
    }
    private fun reparentInput(parent: InputScope) {
        when (route) {
            case Some(value) -> if (!value.isClosed)
                value.parent = Some(parent)
            case None -> {}
        }
    }

    public val isMounted: Boolean get() {
        root.checkThread()
        return active && root.isOpen && root.surface.state == SurfaceWindowState.Open
    }
    /** Continues ordinary Tab navigation from the current focus within this owner. */
    public fun moveFocus(reverse: Boolean = false): Boolean {
        checkMounted()
        checkFocusMutation()
        return root.focus.moveFrom(node, reverse)
    }
    private fun checkMounted() {
        if (!isMounted)
            throw IllegalStateException(Some("component is no longer mounted"))
    }
    public fun <R: Closeable> resource(create: () -> R): R {
        checkMounted()
        val value = create()
        cleanup.add { value.close() }
        return value
    }
    public fun onDispose(action: () -> Unit) {
        checkMounted()
        cleanup.add(action)
    }
    /** Uses the native deadline while keeping callbacks inside this root's failure boundary. */
    public fun createDeadline(action: () -> Unit): WindowDeadline {
        checkMounted()
        val value =
            root.window.createDeadline {
                if (isMounted)
                    root.surface.dispatch(action)
            }
        managed.add(value)
        return value
    }
    /** Observes the native window while preserving this root's callback ownership. */
    public fun observeWindowActivity(action: (WindowActivity) -> Unit): Closeable {
        checkMounted()
        val value =
            root.window.observeActivity {
                activity -> if (isMounted)
                    root.surface.dispatch { action(activity) }
            }
        managed.add(value)
        return value
    }
    /** Local frame-request eligibility; ancestor and submitted placement gates still apply. */
    public var isFrameEnabled: Boolean
    get() {
        checkMounted()
        return node.localFrameEnabled
    }
    set(value) {
        checkMounted()
        checkOverlayMutation()
        node.setFrameEnabled(value)
    }
    public fun requestFrame() {
        checkMounted()
        node.request(UiInvalidation.Scene)
    }
    public fun requestLayout() {
        checkMounted()
        node.request(UiInvalidation.Layout)
    }
    public fun createWindowRegion(kind: WindowRegionKind): WindowRegionHandle {
        checkMounted()
        val parent =
            when (kind) {
                case Hit(_) -> Some(input);
                else -> None
            }
        val value = root.surface.createWindowRegion(kind, parent)
        managed.add(value)
        return value
    }
    public fun claimWindowFrame(): Closeable {
        checkMounted()
        when (root.windowFrame) {
            case Some(_) -> throw IllegalStateException(
                Some("window frame is already configured by another mount")
            )
            case None -> {}
        }
        val value = UiWindowFrameClaim(root)
        root.windowFrame = Some(value)
        managed.add(value)
        return value
    }
    public fun createArea(
        focusable: Boolean = false,
        textInput: Boolean = false,
        parent: InputArea? = None,
        handler: (RoutedEventContext, InputEvent) -> Unit = { _, _ -> Unit }
    ): InputArea {
        checkMounted()
        val route =
            when (parent) {
                case Some(value) -> {
                    requireBehaviorArea(value);
                    value.scope
                }
                case None -> input
            }
        val area = root.surface.createArea(focusable, textInput, Some(route), handler)
        managed.add(area)
        return area
    }
    public fun focusTarget(area: InputArea, options: FocusOptions = FocusOptions()): FocusTarget {
        checkMounted()
        checkFocusMutation()
        requireUi(!area.isClosed && area.focusable, "focus target requires an open focusable area")
        requireBehaviorArea(area)
        for (target in node.focusTargets)
            requireUi(target.area !== area, "area already has a focus target")
        val value = FocusTarget(node, area, options)
        node.focusTargets.add(value)
        managed.add(value)
        return value
    }
    public fun focusScope(options: FocusScopeOptions = FocusScopeOptions()): FocusScope {
        checkMounted()
        checkFocusMutation()
        when (node.focusScope) {
            case Some(_) -> throw IllegalStateException(Some("mount already has a focus scope"))
            case None -> {}
        }
        val value = FocusScope(node, options)
        node.focusScope = Some(value)
        managed.add(value)
        return value
    }
    public fun keyNavigation(options: NavigationOptions): KeyNavigation {
        checkMounted()
        checkFocusMutation()
        when (node.navigation) {
            case Some(_) -> throw IllegalStateException(Some("mount already has key navigation"))
            case None -> {}
        }
        val value = KeyNavigation(node, options)
        node.navigation = Some(value)
        managed.add(value)
        return value
    }
    public fun layoutAnchor(handle: LayoutAnchor): Closeable {
        checkMounted()
        checkOverlayMutation()
        val value = handle.bind(node)
        managed.add(value)
        return value
    }
    public fun scrollViewport(state: ScrollState): ScrollViewport {
        checkMounted()
        state.checkBinding()
        val value = ScrollViewport(node, state, animations().value(Point(0.0, 0.0)))
        managed.add(value)
        return value
    }
    public fun lazyFocus(
        viewport: ScrollViewport,
        options: LazyFocusOptions = LazyFocusOptions()
    ): LazyFocus {
        checkMounted()
        checkFocusMutation()
        requireUi(viewport.belongsTo(node), "item focus viewport must belong to this mount")
        when (node.lazyFocus) {
            case Some(_) -> throw IllegalStateException(Some("mount already has item focus"))
            case None -> {}
        }
        val items =
            node.lazyItems ?:
                throw IllegalArgumentException(Some("item focus requires a lazy element"))
        val value = LazyFocus(node, viewport, items, options)
        node.lazyFocus = Some(value)
        managed.add(value)
        return value
    }
    public fun animation(initial: Double): Animatable<Double> =
        animation(initial, AnimationConverters.DoubleValue)
    public fun animation(initial: Point): Animatable<Point> =
        animation(initial, AnimationConverters.PointValue)
    public fun animation(initial: Size): Animatable<Size> =
        animation(initial, AnimationConverters.SizeValue)
    public fun animation(initial: Color): Animatable<Color> =
        animation(initial, AnimationConverters.ColorValue)
    public fun <T> animation(initial: T, converter: AnimationConverter<T>): Animatable<T> {
        checkMounted()
        return animations().value(initial, converter)
    }
    private fun animations(): AnimationGroup {
        when (animationGroup) {
            case Some(value) -> return value
            case None -> {}
        }
        val value = root.surface.animations.group(node.frameEnabled)
        animationGroup = Some(value)
        managed.add(value)
        return value
    }
    internal fun updateFrameParticipation() {
        when (animationGroup) {
            case Some(value) -> if (!value.isClosed)
                value.isFrameEnabled = node.frameEnabled
            case None -> {}
        }
    }
    internal fun deactivate() {
        active = false
        when (route) {
            case Some(value) -> if (!value.isClosed)
                value.enabled = false
            case None -> {}
        }
    }
    internal fun retireInteraction(): Throwable? {
        return resources.retireManaged()
    }
    internal fun release(): Throwable? {
        return resources.release()
    }
}
