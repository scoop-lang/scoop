package scoop.ui

import scoop.graphics.*
import scoop.math.max
import scoop.math.min

public enum ScrollAxes {
    Horizontal, Vertical, Both

    public val horizontal: Boolean get() = this != ScrollAxes.Vertical
    public val vertical: Boolean get() = this != ScrollAxes.Horizontal
}

public enum ScrollAlignment {
    Nearest, Start, Center, End
}

/** Physical margins that make obscured content edges reachable by reveal. */
public struct ScrollPadding(
    val left: Double = 0.0,
    val top: Double = 0.0,
    val right: Double = 0.0,
    val bottom: Double = 0.0
) {
    internal fun extent(): Size {
        checkLayoutSize(Size(left, top))
        checkLayoutSize(Size(right, bottom))
        val size = Size(left + right, top + bottom)
        checkLayoutSize(size)
        return size
    }
}

public struct ScrollSnapshot(
    val offset: Point,
    val viewport: Size,
    val content: Size,
    val padding: ScrollPadding = ScrollPadding()
) {
    /** Content extent before the reveal margins were added. */
    public val bodySize: Size get() =
        Size(
            max(0.0, content.width - padding.left - padding.right),
            max(0.0, content.height - padding.top - padding.bottom)
        )
    /** Unobscured extent used by reveal and page navigation. */
    public val visibleSize: Size get() =
        Size(
            max(0.0, viewport.width - padding.left - padding.right),
            max(0.0, viewport.height - padding.top - padding.bottom)
        )
    public val maximum: Point get() =
        Point(max(0.0, content.width - viewport.width), max(0.0, content.height - viewport.height))
    public fun revealedOffset(
        rect: Rect,
        horizontal: ScrollAlignment = ScrollAlignment.Nearest,
        vertical: ScrollAlignment = ScrollAlignment.Nearest
    ): Point {
        checkScrollRect(rect)
        checkScrollPoint(offset)
        checkLayoutSize(viewport)
        checkLayoutSize(content)
        padding.extent()
        val visible = visibleSize
        return clampScroll(
            Point(
                revealScrollAxis(offset.x, visible.width, rect.x, rect.width, horizontal),
                revealScrollAxis(offset.y, visible.height, rect.y, rect.height, vertical)
            ),
            viewport,
            content
        )
    }
}

/** A layout correction based on a particular explicit positioning intent. */
public struct ScrollAdjustment(val requestRevision: ULong, val offset: Point)

internal enum ScrollRequest {
    Position(val point: Point),
    Reveal(val rect: Rect, val horizontal: ScrollAlignment, val vertical: ScrollAlignment)
}

internal fun checkScrollPoint(point: Point) {
    requireUi(point.x.isFinite() && point.y.isFinite(), "invalid scroll position or displacement")
}

internal fun checkScrollRect(rect: Rect) {
    checkScrollPoint(Point(rect.x, rect.y))
    checkLayoutSize(Size(rect.width, rect.height))
    checkScrollPoint(Point(rect.x + rect.width, rect.y + rect.height))
}

internal fun clampScroll(point: Point, viewport: Size, content: Size): Point =
    Point(
        min(max(0.0, point.x), max(0.0, content.width - viewport.width)),
        min(max(0.0, point.y), max(0.0, content.height - viewport.height))
    )

internal fun resolveScroll(
    request: ScrollRequest,
    previous: Point,
    viewport: Size,
    content: Size,
    padding: ScrollPadding = ScrollPadding()
): ScrollSnapshot {
    checkLayoutSize(viewport)
    checkLayoutSize(content)
    val point =
        when (request) {
            case Position(val value) -> value
            case Reveal(val rect, val horizontal, val vertical) ->
            ScrollSnapshot(previous, viewport, content, padding).revealedOffset(
                rect,
                horizontal,
                vertical
            )
        }
    checkScrollPoint(point)
    return ScrollSnapshot(clampScroll(point, viewport, content), viewport, content, padding)
}

private fun revealScrollAxis(
    offset: Double,
    viewport: Double,
    start: Double,
    length: Double,
    alignment: ScrollAlignment
): Double =
    when (alignment) {
        case Start -> start
        case Center -> start + (length - viewport) / 2.0
        case End -> start + length - viewport
        case Nearest -> {
            val end = start + length
            if (
                (start >= offset && end <= offset + viewport) ||
                    (start <= offset && end >= offset + viewport)
            )
                offset
            else
                if (start < offset)
                    if (length <= viewport)
                        start
                    else
                        end - viewport
                else
                    if (length <= viewport)
                        end - viewport
                    else
                        start
        }
    }
