package scoop.ui

import scoop.graphics.*
import scoop.math.max
import scoop.math.min

public enum ScrollAxes {
    Horizontal, Vertical, Both

    public val horizontal: Boolean get() = this != ScrollAxes.Vertical
    public val vertical: Boolean get() = this != ScrollAxes.Horizontal
}

public enum ScrollAlignment {
    Nearest, Start, Center, End
}

public struct ScrollSnapshot(val offset: Point, val viewport: Size, val content: Size) {
    public val maximum: Point get() =
        Point(max(0.0, content.width - viewport.width), max(0.0, content.height - viewport.height))
}

internal enum ScrollRequest {
    Position(val point: Point),
    Reveal(val rect: Rect, val horizontal: ScrollAlignment, val vertical: ScrollAlignment)
}

internal fun checkScrollPoint(point: Point) {
    requireUi(point.x.isFinite() && point.y.isFinite(), "invalid scroll position or displacement")
}

internal fun checkScrollRect(rect: Rect) {
    checkScrollPoint(Point(rect.x, rect.y))
    checkLayoutSize(Size(rect.width, rect.height))
    checkScrollPoint(Point(rect.x + rect.width, rect.y + rect.height))
}

internal fun clampScroll(point: Point, viewport: Size, content: Size): Point =
    Point(
        min(max(0.0, point.x), max(0.0, content.width - viewport.width)),
        min(max(0.0, point.y), max(0.0, content.height - viewport.height))
    )

internal fun resolveScroll(
    request: ScrollRequest,
    previous: Point,
    viewport: Size,
    content: Size
): ScrollSnapshot {
    checkLayoutSize(viewport)
    checkLayoutSize(content)
    val point =
        when (request) {
            case Position(value) -> value
            case Reveal(rect, horizontal, vertical) -> Point(
                revealScrollAxis(previous.x, viewport.width, rect.x, rect.width, horizontal),
                revealScrollAxis(previous.y, viewport.height, rect.y, rect.height, vertical)
            )
        }
    return ScrollSnapshot(clampScroll(point, viewport, content), viewport, content)
}

private fun revealScrollAxis(
    offset: Double,
    viewport: Double,
    start: Double,
    length: Double,
    alignment: ScrollAlignment
): Double =
    when (alignment) {
        case Start -> start
        case Center -> start + (length - viewport) / 2.0
        case End -> start + length - viewport
        case Nearest -> {
            val end = start + length
            if (
                (start >= offset && end <= offset + viewport) ||
                    (start <= offset && end >= offset + viewport)
            )
                offset
            else
                if (start < offset)
                    if (length <= viewport)
                        start
                    else
                        end - viewport
                else
                    if (length <= viewport)
                        end - viewport
                    else
                        start
        }
    }
