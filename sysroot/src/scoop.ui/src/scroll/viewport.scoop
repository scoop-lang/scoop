package scoop.ui

import scoop.graphics.*
import scoop.surface.*

public class ScrollLayout internal constructor(
    internal val owner: ScrollViewport,
    internal val binding: ULong,
    internal val revision: ULong,
    public val snapshot: ScrollSnapshot,
    public val overscroll: Point
) {
    public val presentationOffset: Point get() =
        Point(snapshot.offset.x - overscroll.x, snapshot.offset.y - overscroll.y)
}

private class ScrollMotion(val target: Point, val spec: AnimationSpec) {
    var started = false
}

/** A mount-owned layout and animation registration for one ScrollState. */
public class ScrollViewport internal constructor(
    internal val node: MountedNode,
    initial: ScrollState,
    private val animation: Animatable<Point>,
    edgeAnimation: Animatable<Point>
): Closeable {
    private var current = initial
    private var closed = false
    private var ready = false
    private var binding = 0UL
    private var motion: ScrollMotion? = None
    private var cachePolicy = PaintCachePolicy.None
    private var physicsOptions = ScrollPhysicsOptions()
    private var reduced = false
    internal var inputRevision = 0UL
    internal val edge = ScrollEdge(this, edgeAnimation)
    internal var inertia: ScrollInertia? = None
    internal val inertiaAnimation: Animatable<Point> get() = animation
    private val preferences = node.root.preferences.observe { _ -> preferenceChanged() }
    private var lastActivity = node.root.window.activity
    private val activity =
        node.scope.observeWindowActivity {
            value -> {
                val lost =
                    (lastActivity.focused && !value.focused) ||
                        (lastActivity.visible && !value.visible) ||
                        (ready && !lastActivity.occluded && value.occluded)
                lastActivity = value
                if (lost)
                    cancelAnimation()
            }
        }
    private var inputWatch: ScrollViewportInput? = None

    init {
        current.attach(this)
    }

    internal val active: Boolean get() = !closed && node.active && node.root.isOpen
    internal val bindingRevision: ULong get() = binding
    internal val semanticSnapshot: ScrollSnapshot? get() =
        if (active && ready)
            Some(current.snapshot)
        else
            None
    internal fun belongsTo(owner: MountedNode): Boolean = active && node === owner
    internal fun contains(owner: MountedNode): Boolean = withinFocusScope(owner, node)
    internal val moving: Boolean get() =
        active && (motion?.started != None || edge.moving || hasInertia)
    private val hasInertia: Boolean get() =
        when (inertia) {
            case Some(_) -> true
            case None -> false
        }
    internal val positioning: Boolean get() = motion?.started != None
    internal val motionReduced: Boolean get() =
        reduced || (node.root.preferences.value.reduceMotion ?: false)
    internal fun matches(value: ScrollState, generation: ULong): Boolean =
        active && current === value && binding == generation
    public val isClosed: Boolean get() {
        node.root.checkThread();
        return closed
    }
    public var state: ScrollState
    get() {
        node.root.checkThread();
        return current
    }
    set(value) {
        checkOpen()
        current.checkMutation()
        if (value === current)
            return
        value.checkBinding()
        cancelAnimation()
        current.detach(this)
        current = value
        binding += 1UL
        ready = false
        current.attach(this)
        requestFrame()
    }
    public var paintCache: PaintCachePolicy
    get() {
        node.root.checkThread()
        return cachePolicy
    }
    set(value) {
        checkOpen()
        current.checkMutation()
        checkPaintCachePolicy(value)
        if (cachePolicy == value)
            return
        cachePolicy = value
        node.request(UiInvalidation.Scene)
    }
    public var physics: ScrollPhysicsOptions
    get() {
        node.root.checkThread();
        return physicsOptions
    }
    set(value) {
        checkOpen()
        current.checkMutation()
        if (sameScrollPhysics(physicsOptions, value))
            return
        physicsOptions = value
        cancelAnimation()
    }
    public var reduceMotion: Boolean
    get() {
        node.root.checkThread();
        return reduced
    }
    set(value) {
        checkOpen()
        current.checkMutation()
        if (reduced == value)
            return
        reduced = value
        preferenceChanged()
    }
    private fun preferenceChanged() {
        if (!active || !motionReduced)
            return
        val target = motion?.target
        cancelAnimation()
        when (target) {
            case Some(val value) -> {
                current.request = ScrollRequest.Position(value)
                requestFrame()
            }
            case None -> {}
        }
    }
    internal fun watchInput(scope: InputScope) {
        when (inputWatch) {
            case Some(val previous) -> if (previous.scope === scope)
                return
            case None -> {}
        }
        inputWatch?.close()
        inputWatch = Some(ScrollViewportInput(this, scope))
    }
    private fun checkOpen() {
        node.root.checkThread()
        if (!active)
            throw IllegalStateException(Some("scroll viewport is no longer mounted"))
    }
    internal fun requestFrame() {
        if (active)
            node.request(
                if (node.frameInputs.usesLayout(this))
                    UiInvalidation.Layout
                else
                    UiInvalidation.Scene
            )
    }
    public fun layout(
        viewport: Size,
        content: Size,
        adjustment: ScrollAdjustment? = None,
        padding: ScrollPadding = ScrollPadding()
    ): ScrollLayout {
        checkOpen()
        observeScroll(this)
        checkLayoutSize(content)
        val margin = padding.extent()
        val extent = Size(content.width + margin.width, content.height + margin.height)
        var result = sample(viewport, extent, padding)
        when (adjustment) {
            case Some(val value) -> {
                checkScrollPoint(value.offset)
                if (value.requestRevision == current.revision && !positioning)
                    result =
                        ScrollSnapshot(
                            clampScroll(value.offset, viewport, extent),
                            viewport,
                            extent,
                            padding
                        )
            }
            case None -> {}
        }
        val resized =
            ready &&
                (
                    current.current.viewport !=
                        result.viewport ||
                        current.current.content !=
                        result.content ||
                        current.current.padding !=
                        result.padding
                )
        return ScrollLayout(
            this,
            binding,
            current.revision,
            result,
            if (resized)
                Point(0.0, 0.0)
            else
                edge.sample(result)
        )
    }
    public fun present(
        context: SceneContext,
        layout: ScrollLayout,
        content: ((SceneContext) -> Unit)? = None,
        contentOrigin: Point = Point(0.0, 0.0)
    ) {
        checkOpen()
        context.checkOwner(node)
        checkScrollPoint(contentOrigin)
        requireUi(layout.owner === this, "scroll layout belongs to a different viewport")
        requireUi(layout.binding == binding, "scroll layout belongs to a previous binding")
        context.presentScroll(this)
        context.onFrameComplete {
            frame -> if (
                frame.submission == FrameSubmission.Accepted && active && layout.binding == binding
            )
                complete(layout)
        }
        when (content) {
            case Some(val block) -> context.scrollContent(this, layout, contentOrigin, block)
            case None -> {}
        }
    }
    private fun sample(viewport: Size, content: Size, padding: ScrollPadding): ScrollSnapshot {
        checkLayoutSize(viewport)
        checkLayoutSize(content)
        return if (motion?.started ?: false)
            ScrollSnapshot(
                clampScroll(animation.value, viewport, content),
                viewport,
                content,
                padding
            )
        else
            current.plan(viewport, content, padding)
    }
    private fun complete(layout: ScrollLayout) {
        val offered = layout.snapshot
        val state = current
        val superseded = layout.revision != state.revision
        val correction =
            state.hasSnapshot &&
                layout.revision ==
                state.revision &&
                layout.revision ==
                state.publishedRevision &&
                !positioning &&
                state.current.offset !=
                offered.offset
        ready = true
        if (
            state.hasSnapshot &&
                (
                    state.current.viewport !=
                        offered.viewport ||
                        state.current.content !=
                        offered.content ||
                        state.current.padding !=
                        offered.padding
                )
        )
        {
            cancelInertia(true)
            edge.stop()
        }
        edge.complete()
        state.publish(offered, layout.revision == state.revision && !positioning, layout.revision)
        when (motion) {
            case Some(val value) -> {
                val target = clampScroll(value.target, offered.viewport, offered.content)
                val changedTarget = value.started && target != animation.target
                if (
                    target ==
                        offered.offset &&
                        (
                            !value.started ||
                                changedTarget ||
                                superseded ||
                                animation.state ==
                                AnimationState.Finished
                        )
                ) {
                    endMotion(changedTarget || superseded)
                } else
                    if (!value.started || changedTarget || superseded) {
                        startMotion(value, target)
                    }
            }
            case None -> {}
        }
        if (layout.revision != state.revision)
            requestFrame()
        if (correction)
            state.notifyIntent(ScrollIntent.LayoutCorrection(layout.revision))
    }
    internal fun animateTo(target: Point, spec: AnimationSpec): ULong {
        checkOpen()
        cancelAnimation()
        current.revision += 1UL
        val token = current.revision
        if (motionReduced) {
            current.request = ScrollRequest.Position(target)
            requestFrame()
            return token
        }
        if (
            ready &&
                clampScroll(target, current.current.viewport, current.current.content) ==
                current.current.offset
        ) {
            current.request = ScrollRequest.Position(current.current.offset)
            requestFrame()
            return token
        }
        val next = ScrollMotion(target, spec)
        motion = Some(next)
        try {
            if (ready)
                startMotion(
                    next,
                    clampScroll(target, current.current.viewport, current.current.content)
                )
        } catch (failure: Throwable) {
            motion = None
            throw failure
        }
        current.changed()
        requestFrame()
        return token
    }
    private fun startMotion(value: ScrollMotion, target: Point) {
        if (target == current.current.offset) {
            endMotion(false)
            return
        }
        animation.snapTo(current.current.offset)
        animation.animateTo(target, value.spec)
        value.started = true
        requestFrame()
    }
    internal fun cancelAnimation() {
        inputRevision += 1UL
        cancelInertia()
        edge.stop()
        cancelPositioning()
    }
    internal fun cancelInertia(keepPending: Boolean = false) {
        inertia?.stop(keepPending)
    }
    internal fun cancelPositioning() {
        when (motion) {
            case Some(_) -> {
                current.revision += 1UL
                endMotion(true)
            }
            case None -> {}
        }
    }
    private fun endMotion(stop: Boolean) {
        motion = None
        if (stop)
            animation.snapTo(current.current.offset)
        if (ready)
            current.request = ScrollRequest.Position(current.current.offset)
        current.changed()
        requestFrame()
    }
    public override fun close() {
        node.root.checkThread()
        current.checkMutation()
        if (closed)
            return
        cancelInertia()
        closed = true
        var index = 0L
        while (index < node.root.scrollEdges.size) {
            if (node.root.scrollEdges[index].viewport === this)
                node.root.scrollEdges.removeAt(index)
            else
                index += 1L
        }
        if (ready)
            current.request = ScrollRequest.Position(current.current.offset)
        motion = None
        inputWatch?.close()
        preferences.close()
        activity.close()
        edge.close()
        animation.close()
        current.detach(this)
    }
}
