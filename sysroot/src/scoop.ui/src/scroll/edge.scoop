package scoop.ui

import scoop.graphics.Point
import scoop.math.max
import scoop.math.min
import scoop.surface.*

/** One viewport's held stretch or release spring; it never changes ScrollSnapshot. */
internal class ScrollEdge(
    private val viewport: ScrollViewport,
    private val animation: Animatable<Point>
): Closeable {
    private var pull = Point(0.0, 0.0)
    private var releasing = false
    private var momentumEdge = Point(0.0, 0.0)
    val moving: Boolean get() = releasing
    val held: Boolean get() = pull != Point(0.0, 0.0)
    val inputActive: Boolean get() = held || releasing || momentumEdge != Point(0.0, 0.0)

    /** A native momentum tail cannot hold or restart an already reached edge. */
    fun consumeMomentum(amount: Point): Point {
        if (held)
            release()
        val current =
            if (releasing)
                animation.value
            else
                Point(0.0, 0.0)
        val direction =
            Point(
                if (momentumEdge.x == 0.0)
                    current.x
                else
                    momentumEdge.x,
                if (momentumEdge.y == 0.0)
                    current.y
                else
                    momentumEdge.y
            )
        val reverseX = scrollOpposesEdge(amount.x, direction.x)
        val reverseY = scrollOpposesEdge(amount.y, direction.y)
        val next =
            Point(
                if (reverseX)
                    0.0
                else
                    direction.x,
                if (reverseY)
                    0.0
                else
                    direction.y
            )
        if (releasing && (reverseX || reverseY)) {
            val speed = animation.velocity
            val start =
                Point(
                    if (reverseX)
                        0.0
                    else
                        current.x,
                    if (reverseY)
                        0.0
                    else
                        current.y
                )
            if (start == Point(0.0, 0.0))
                stop()
            else
                beginRelease(
                    start,
                    Point(
                        if (reverseX)
                            0.0
                        else
                            speed.x,
                        if (reverseY)
                            0.0
                        else
                            speed.y
                    )
                )
        }
        momentumEdge = next
        return Point(
            if (direction.x != 0.0 && !reverseX)
                amount.x
            else
                0.0,
            if (direction.y != 0.0 && !reverseY)
                amount.y
            else
                0.0
        )
    }

    fun absorbMomentum(amount: Point, axes: ScrollAxes): Point {
        val used = absorb(amount, axes)
        if (releasing && used != Point(0.0, 0.0))
            kick(used, Point(0.0, 0.0), used.x != 0.0, used.y != 0.0)
        else
            release()
        momentumEdge =
            Point(
                if (used.x != 0.0)
                    used.x
                else
                    momentumEdge.x,
                if (used.y != 0.0)
                    used.y
                else
                    momentumEdge.y
            )
        return used
    }

    fun endMomentum() {
        momentumEdge = Point(0.0, 0.0)
    }

    fun restoringFraction(amount: Point): Double =
        max(
            if (amount.x == 0.0)
                0.0
            else
                scrollRestoringPart(pull.x, amount.x) / amount.x,
            if (amount.y == 0.0)
                0.0
            else
                scrollRestoringPart(pull.y, amount.y) / amount.y
        )

    fun sample(snapshot: ScrollSnapshot): Point {
        val options = viewport.physics
        if (viewport.motionReduced || !options.elastic)
            return Point(0.0, 0.0)
        val amount =
            if (releasing)
                animation.value
            else
                Point(
                    scrollElasticDistance(pull.x, options),
                    scrollElasticDistance(pull.y, options)
                )
        return Point(
            edgeValue(amount.x, snapshot.offset.x, snapshot.maximum.x, options),
            edgeValue(amount.y, snapshot.offset.y, snapshot.maximum.y, options)
        )
    }

    fun restore(amount: Point): Point {
        val used =
            Point(scrollRestoringPart(pull.x, amount.x), scrollRestoringPart(pull.y, amount.y))
        if (used != Point(0.0, 0.0)) {
            pull = Point(pull.x + used.x, pull.y + used.y)
            viewport.requestFrame()
        }
        return used
    }

    fun absorb(amount: Point, axes: ScrollAxes): Point {
        val options = viewport.physics
        if (viewport.motionReduced || !options.elastic)
            return Point(0.0, 0.0)
        val snapshot = viewport.state.current
        val used =
            Point(
                if (axes.horizontal && (snapshot.maximum.x > 0.0 || options.shortContent))
                    amount.x
                else
                    0.0,
                if (axes.vertical && (snapshot.maximum.y > 0.0 || options.shortContent))
                    amount.y
                else
                    0.0
            )
        if (used != Point(0.0, 0.0)) {
            val next = Point(pull.x + used.x, pull.y + used.y)
            checkScrollPoint(next)
            pull = next
            viewport.requestFrame()
        }
        return used
    }

    fun release() {
        if (releasing || pull == Point(0.0, 0.0))
            return
        if (viewport.motionReduced || !viewport.physics.elastic) {
            stop()
            return
        }
        val state = viewport.state
        val accepted = state.current
        val start = sample(state.plan(accepted.viewport, accepted.content, accepted.padding))
        pull = Point(0.0, 0.0)
        if (start == Point(0.0, 0.0)) {
            viewport.requestFrame()
            return
        }
        beginRelease(start, Point(0.0, 0.0))
    }

    fun kick(amount: Point, velocity: Point, horizontal: Boolean, vertical: Boolean) {
        val options = viewport.physics
        if (viewport.motionReduced || !options.elastic)
            return
        val state = viewport.state
        val current = state.current
        val snapshot = state.plan(current.viewport, current.content, current.padding)
        val x = horizontal && (snapshot.maximum.x > 0.0 || options.shortContent)
        val y = vertical && (snapshot.maximum.y > 0.0 || options.shortContent)
        if (!x && !y)
            return
        val before = sample(snapshot)
        val speed =
            if (releasing)
                animation.velocity
            else
                AnimationVector()
        val start =
            Point(
                if (x)
                    edgeValue(
                        before.x + scrollElasticDistance(amount.x, options),
                        snapshot.offset.x,
                        snapshot.maximum.x,
                        options
                    )
                else
                    before.x,
                if (y)
                    edgeValue(
                        before.y + scrollElasticDistance(amount.y, options),
                        snapshot.offset.y,
                        snapshot.maximum.y,
                        options
                    )
                else
                    before.y
            )
        beginRelease(
            start,
            Point(
                if (x)
                    velocity.x * options.resistance
                else
                    speed.x,
                if (y)
                    velocity.y * options.resistance
                else
                    speed.y
            )
        )
    }

    private fun beginRelease(start: Point, velocity: Point) {
        pull = Point(0.0, 0.0)
        animation.snapTo(start)
        val options = viewport.physics
        animation.animateTo(
            Point(0.0, 0.0),
            AnimationSpec.Spring(options.stiffness, options.dampingRatio, 0.1, 1.0),
            initialVelocity = Some(AnimationVector(velocity.x, velocity.y))
        )
        releasing = true
        viewport.state.changed()
        viewport.requestFrame()
    }

    fun complete() {
        if (releasing && animation.state == AnimationState.Finished) {
            releasing = false
            viewport.state.changed()
        }
    }

    fun interruptRelease() {
        if (releasing)
            stop()
    }

    fun stop() {
        val moving = releasing
        val changed = moving || pull != Point(0.0, 0.0)
        releasing = false
        pull = Point(0.0, 0.0)
        momentumEdge = Point(0.0, 0.0)
        if (moving) {
            animation.snapTo(Point(0.0, 0.0))
            viewport.state.changed()
        }
        if (changed)
            viewport.requestFrame()
    }

    public override fun close() {
        stop()
        animation.close()
    }
}

private fun scrollOpposesEdge(amount: Double, edge: Double): Boolean =
    (amount < 0.0 && edge > 0.0) || (amount > 0.0 && edge < 0.0)

private fun edgeValue(
    amount: Double,
    offset: Double,
    maximum: Double,
    options: ScrollPhysicsOptions
): Double {
    if (maximum == 0.0 && !options.shortContent)
        return 0.0
    val limit = options.maxOverscroll
    if (amount > 0.0 && offset == 0.0)
        return min(limit, amount)
    if (amount < 0.0 && offset == maximum)
        return max(-limit, amount)
    return 0.0
}
