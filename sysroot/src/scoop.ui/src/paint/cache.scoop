package scoop.ui

import scoop.graphics.*
import scoop.time.TimeMark

/** One element's small set of independently versioned drawing layers. */
internal class PaintLayers: Closeable {
    val entries = ArrayList<CachedPaintLayer>()

    fun draw(
        canvas: Canvas,
        key: PaintKey,
        input: PaintLayerInput,
        policy: PaintCachePolicy,
        time: TimeMark? = None,
        reads: FrameReads? = None,
        block: (Canvas) -> Unit
    ): CachedPaintLayer? {
        input.check()
        var found: CachedPaintLayer? = None
        for (entry in entries) {
            if (
                entry.key ===
                    key &&
                    entry.input ==
                    input &&
                    entry.compatible(canvas) &&
                    entry.current(time)
            ) {
                found = Some(entry)
                break
            }
        }
        if (!paintLayerVisible(canvas, input.bounds)) {
            when (found) {
                case Some(value) -> value.clearTiles()
                case None -> remove(key)
            }
            return found
        }
        val layer = found ?: create(canvas, key, input, reads, block)
        try {
            layer.paint(canvas, policy)
            return Some(layer)
        } catch (error: Throwable) {
            throwUi(cleanupUi(Some(error)) { remove(key) })
            throw error
        }
    }
    private fun create(
        canvas: Canvas,
        key: PaintKey,
        input: PaintLayerInput,
        reads: FrameReads?,
        block: (Canvas) -> Unit
    ): CachedPaintLayer {
        remove(key)
        val drawing = canvas.recordDrawing(input.bounds, block)
        try {
            val layer = CachedPaintLayer(key, input, drawing, reads?.finish() ?: FrameInputs())
            entries.add(layer)
            return layer
        } catch (error: Throwable) {
            throw cleanupUi(Some(error)) { drawing.close() }!!
        }
    }
    fun retain(keys: ArrayList<PaintKey>) {
        var index = entries.size
        while (index > 0L) {
            index -= 1L
            val entry = entries[index]
            var found = false
            for (key in keys)
                if (entry.key === key)
                    found = true
            if (!found) {
                entries.removeAt(index)
                entry.close()
            }
        }
    }
    private fun remove(key: PaintKey) {
        var index = entries.size
        while (index > 0L) {
            index -= 1L
            val entry = entries[index]
            if (entry.key === key) {
                entries.removeAt(index)
                entry.close()
                return
            }
        }
    }
    public override fun close() {
        var failure: Throwable? = None
        for (entry in entries)
            failure = cleanupUi(failure) { entry.close() }
        entries.clear()
        throwUi(failure)
    }
}

private fun paintLayerVisible(canvas: Canvas, bounds: Rect): Boolean =
    when (canvas.localClipBounds) {
        case Some(clip) -> bounds.width >
            0.0 &&
            bounds.height >
            0.0 &&
            clip.width >
            0.0 &&
            clip.height >
            0.0 &&
            bounds.x <
            clip.x +
            clip.width &&
            clip.x <
            bounds.x +
            bounds.width &&
            bounds.y <
            clip.y +
            clip.height &&
            clip.y <
            bounds.y +
            bounds.height
        case None -> false
    }
