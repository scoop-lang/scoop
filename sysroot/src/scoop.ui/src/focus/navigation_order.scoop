package scoop.ui

import scoop.window.*

internal enum NavigationAxis {
    Linear, Row, Column
}

internal struct NavigationStep(
    val axis: NavigationAxis,
    val forward: Boolean,
    val edge: Boolean = false
)

internal fun navigationStep(
    options: NavigationOptions,
    key: LogicalKey,
    inherited: LayoutDirection = LayoutDirection.Ltr
): NavigationStep? = navigationStep(options.layout, options.direction ?: inherited, key)

internal fun navigationStep(
    layout: NavigationLayout,
    direction: LayoutDirection,
    key: LogicalKey
): NavigationStep? {
    val grid = layout == NavigationLayout.Grid
    val horizontal =
        if (grid)
            NavigationAxis.Row
        else
            NavigationAxis.Linear
    val vertical =
        if (grid)
            NavigationAxis.Column
        else
            NavigationAxis.Linear
    return when (key) {
        case Named(NamedKey.Home) -> Some(NavigationStep(horizontal, false, true))
        case Named(NamedKey.End) -> Some(NavigationStep(horizontal, true, true))
        case Named(NamedKey.ArrowLeft) -> if (layout != NavigationLayout.Vertical)
            Some(NavigationStep(horizontal, direction == LayoutDirection.Rtl))
        else
            None
        case Named(NamedKey.ArrowRight) -> if (layout != NavigationLayout.Vertical)
            Some(NavigationStep(horizontal, direction != LayoutDirection.Rtl))
        else
            None
        case Named(NamedKey.ArrowUp) -> if (layout != NavigationLayout.Horizontal)
            Some(NavigationStep(vertical, false))
        else
            None
        case Named(NamedKey.ArrowDown) -> if (layout != NavigationLayout.Horizontal)
            Some(NavigationStep(vertical, true))
        else
            None
        else -> None
    }
}

private fun navigationCoordinate(
    index: Long,
    axis: NavigationAxis,
    row: (Long) -> Int,
    column: (Long) -> Int
): Long =
    when (axis) {
        case Linear -> index
        case Row -> column(index).toLong()
        case Column -> row(index).toLong()
    }

internal fun navigationDestination(
    items: Array<NavigationItem>,
    index: Long,
    step: NavigationStep,
    loop: Boolean,
    accepts: (Long) -> Boolean
): Long? =
    navigationDestination(
        items.size,
        Some(index),
        step,
        loop,
        { item -> items[item].row },
        { item -> items[item].column },
        accepts
    )

/** Shared candidate search; applying its result is separate from focus ownership. */
internal fun navigationDestination(
    count: Long,
    index: Long?,
    step: NavigationStep,
    loop: Boolean,
    row: (Long) -> Int,
    column: (Long) -> Int,
    accepts: (Long) -> Boolean
): Long? {
    val lower =
        if (step.edge)
            !step.forward
        else
            step.forward
    val current =
        when (index) {
            case Some(value) -> value
            case None -> {
                var chosen: Long? = None
                for (candidate in 0L ..< count)
                    if (accepts(candidate)) {
                        if (lower)
                            return Some(candidate)
                        chosen = Some(candidate)
                    }
                return chosen
            }
        }
    val origin = navigationCoordinate(current, step.axis, row, column)
    var boundary: Long? = None
    var nearest: Long? = None
    for (candidate in 0L ..< count) {
        val sameAxis =
            when (step.axis) {
                case Linear -> true
                case Row -> row(candidate) == row(current)
                case Column -> column(candidate) == column(current)
            }
        if (!sameAxis || !accepts(candidate))
            continue
        val coordinate = navigationCoordinate(candidate, step.axis, row, column)
        val previous = boundary ?: candidate
        val previousCoordinate = navigationCoordinate(previous, step.axis, row, column)
        if (
            (lower && coordinate <= previousCoordinate) ||
                (!lower && coordinate >= previousCoordinate)
        )
            boundary = Some(candidate)
        if (
            !step.edge &&
                ((step.forward && coordinate > origin) || (!step.forward && coordinate < origin))
        ) {
            val prior = nearest ?: candidate
            val priorCoordinate = navigationCoordinate(prior, step.axis, row, column)
            if (
                (lower && coordinate <= priorCoordinate) ||
                    (!lower && coordinate >= priorCoordinate)
            )
                nearest = Some(candidate)
        }
    }
    if (step.edge)
        return boundary
    return when (nearest) {
        case Some(_) -> nearest;
        case None -> if (loop)
            boundary
        else
            None
    }
}
