package scoop.ui

public enum NavigationLayout {
    Horizontal, Vertical, Grid
}

public struct NavigationItem(val handle: FocusHandle, val row: Int = 0, val column: Int = 0)

public struct NavigationOptions(
    val items: Array<NavigationItem>,
    val layout: NavigationLayout = NavigationLayout.Vertical,
    val direction: LayoutDirection? = None,
    val loop: Boolean = false,
    val roving: Boolean = true
)
