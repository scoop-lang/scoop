package scoop.ui

import scoop.graphics.Canvas
import scoop.surface.*
import scoop.window.*

private enum FocusDestination {
    Target(FocusTarget), Group(FocusScope)
}

private class TabContinuation(
    val node: MountedNode,
    val after: FocusTarget,
    val reverse: Boolean,
    val loop: Boolean,
    val remaining: Long
)

private class PendingFocus(
    val destination: FocusDestination,
    val revision: ULong,
    var selected: FocusTarget?,
    val reveal: RevealAttempt,
    val continuation: TabContinuation?
)

internal class FocusController(private val root: UiRoot): Closeable {
    private var pending: PendingFocus? = None
    private var registration: Closeable? = None
    private var scene = FocusScene()
    private var drawing: FocusScene? = None

    fun beginFrame() {
        drawing?.close()
        drawing = Some(FocusScene())
    }
    fun place(area: InputArea, path: Array<ScrollReveal>) {
        drawing!!.place(area, path)
    }
    fun captureScroll(
        viewport: ScrollViewport,
        layout: ScrollLayout,
        canvas: Canvas
    ): ScrollReveal = drawing!!.capture(viewport, layout, canvas)
    fun publishScene(frame: FrameCompletion) {
        val current = drawing ?: return
        drawing = None
        if (frame.submission == FrameSubmission.Accepted) {
            val previous = scene
            scene = current
            previous.close()
        } else
            current.close()
    }
    fun canReveal(target: FocusTarget): Boolean = target.available && scene.canReveal(target.area)

    fun start() {
        registration =
            Some(
                root.surface.input.addDefaultAction {
                    context, event ->
                    val node = root.node ?: return@addDefaultAction
                    when (node.focusScope) {
                        case Some(_) -> {}
                        case None -> tab(node, true, context, event)
                    }
                }
            )
    }
    fun isPending(target: FocusTarget): Boolean {
        val value = pending ?: return false
        if (value.revision != root.surface.focusRevision || !value.reveal.isCurrent)
            return false
        return when (value.selected) {
            case Some(current) -> current === target
            case None -> false
        }
    }
    fun hasPendingIn(node: MountedNode): Boolean {
        val value = pending ?: return false
        if (value.revision != root.surface.focusRevision || !value.reveal.isCurrent)
            return false
        when (value.selected) {
            case Some(target) -> return target.available && withinFocusScope(target.node, node)
            case None -> {}
        }
        return when (value.destination) {
            case Target(target) -> target.available && withinFocusScope(target.node, node)
            case Group(scope) -> scope.available && withinFocusScope(scope.node, node)
        }
    }
    fun isPending(scope: FocusScope): Boolean {
        val value = pending ?: return false
        if (value.revision != root.surface.focusRevision || !value.reveal.isCurrent)
            return false
        return when (value.destination) {
            case Group(current) -> current === scope
            else -> false
        }
    }
    fun cancel(target: FocusTarget) {
        val value = pending ?: return
        when (value.selected) {
            case Some(current) -> if (current === target) {
                clearPending()
                return
            }
            case None -> {}
        }
        when (value.destination) {
            case Target(current) -> {
                if (current === target)
                    clearPending()
            }
            else -> {}
        }
    }
    fun cancel(scope: FocusScope) {
        val value = pending ?: return
        when (value.destination) {
            case Group(current) -> {
                if (current === scope)
                    clearPending()
            }
            else -> {}
        }
    }
    fun request(target: FocusTarget): Boolean = request(target, None)
    private fun request(target: FocusTarget, continuation: TabContinuation?): Boolean {
        clearPending()
        if (!root.isOpen)
            return false
        if (!target.available) {
            root.surface.reserveFocusRequest()
            return false
        }
        return begin(FocusDestination.Target(target), Some(target), continuation)
    }
    fun request(scope: FocusScope): Boolean {
        clearPending()
        if (!root.isOpen)
            return false
        if (!scope.available) {
            root.surface.reserveFocusRequest()
            return false
        }
        return begin(FocusDestination.Group(scope), select(scope), None)
    }
    private fun begin(
        destination: FocusDestination,
        selected: FocusTarget?,
        continuation: TabContinuation?
    ): Boolean {
        val reveal = RevealAttempt()
        when (selected) {
            case Some(target) -> if (reveal.advance(scene, target.area) == RevealProgress.Ready)
                return target.area.requestFocus()
            case None -> {}
        }
        pending =
            Some(
                PendingFocus(
                    destination,
                    root.surface.reserveFocusRequest(),
                    selected,
                    reveal,
                    continuation
                )
            )
        root.requestFrame()
        return true
    }
    fun capture(): FocusHandle? {
        val current = root.surface.focusedArea ?: return None
        val node = root.node ?: return None
        for (target in focusOrder(node))
            if (target.active && target.area === current)
                return Some(target.handle)
        return None
    }
    fun restore(handles: Array<FocusHandle>, fallback: FocusScope?): Boolean {
        for (handle in handles) {
            when (handle.target) {
                case Some(target) -> {
                    if (
                        target.node.root ===
                            root &&
                            target.available &&
                            (target.area.canFocus || canReveal(target))
                    )
                        return request(target)
                }
                case None -> {}
            }
        }
        when (fallback) {
            case Some(scope) -> if (scope.available)
                return request(scope)
            case None -> {}
        }
        val node = root.node ?: return false
        when (node.focusScope) {
            case Some(scope) -> if (scope.available)
                return request(scope)
            case None -> {}
        }
        for (target in focusOrder(node))
            if (target.acceptsTab)
                return request(target)
        return false
    }
    fun complete(frame: FrameCompletion) {
        if (frame.submission != FrameSubmission.Accepted)
            return
        val value = pending ?: return
        if (value.revision != root.surface.focusRevision) {
            clearPending()
            return
        }
        val target =
            when (value.selected) {
                case Some(current) -> Some(current)
                case None -> when (value.destination) {
                    case Target(current) -> Some(current)
                    case Group(scope) -> if (scope.available)
                        select(scope)
                    else
                        None
                }
            }
        when (target) {
            case Some(current) -> {
                value.selected = Some(current)
                val progress =
                    if (current.available)
                        value.reveal.advance(scene, current.area)
                    else
                        RevealProgress.Unavailable
                when (progress) {
                    case Moved -> {
                        root.requestFrame();
                        return
                    }
                    case Waiting -> {
                        root.requestFrame();
                        return
                    }
                    case Ready -> {
                        clearPending()
                        if (current.available && current.area.canFocus)
                            current.area.requestFocus()
                        return
                    }
                    case Cancelled -> {
                        clearPending();
                        return
                    }
                    case Unavailable -> {}
                }
            }
            case None -> {}
        }
        clearPending()
        when (value.continuation) {
            case Some(plan) -> continueTab(plan)
            case None -> {}
        }
    }
    private fun explicit(scope: FocusScope, handle: FocusHandle?): FocusTarget? {
        val reference = handle ?: return None
        val target = reference.target ?: return None
        return if (
            target.available &&
                withinFocusScope(target.node, scope.node) &&
                (target.area.canFocus || canReveal(target))
        )
            Some(target)
        else
            None
    }
    private fun select(scope: FocusScope): FocusTarget? {
        when (explicit(scope, scope.options.defaultFocus)) {
            case Some(target) -> return Some(target)
            case None -> {}
        }
        for (target in focusOrder(scope.node))
            if (target.acceptsTab)
                return Some(target)
        return explicit(scope, scope.options.fallback)
    }
    fun tab(node: MountedNode, loop: Boolean, context: RoutedEventContext, event: InputEvent) {
        val key =
            when (event) {
                case Keyboard(value) -> value
                else -> return
            }
        if (
            key.state !=
                ElementState.Pressed ||
                key.synthetic ||
                key.logicalKey !=
                LogicalKey.Named(NamedKey.Tab)
        )
            return
        val modifiers = key.modifiers
        if (modifiers.control || modifiers.alt || modifiers.superKey || modifiers.function)
            return
        if (move(node, modifiers.shift, loop))
            context.consume()
    }
    private fun move(
        node: MountedNode,
        reverse: Boolean,
        loop: Boolean,
        after: FocusTarget? = None,
        remaining: Long? = None
    ): Boolean {
        val targets = focusOrder(node)
        if (targets.size == 0L)
            return false
        var index = -1L
        for (position in 0L ..< targets.size) {
            val matches =
                when (after) {
                    case Some(target) -> targets[position] === target
                    case None -> targets[position].area.hasFocus
                }
            if (matches)
                index = position
        }
        when (after) {
            case Some(_) -> if (index < 0L)
                return false
            case None -> {}
        }
        if (index < 0L && reverse)
            index = targets.size
        var visited = 0L
        val count = remaining ?: targets.size
        while (visited < count) {
            index += if (reverse)
                -1L
            else
                1L
            if (index < 0L || index >= targets.size) {
                if (!loop)
                    return false
                index =
                    if (reverse)
                        targets.size - 1L
                    else
                        0L
            }
            val target = targets[index]
            if (target.acceptsTab) {
                val continuation =
                    TabContinuation(node, target, reverse, loop, count - visited - 1L)
                return request(target, Some(continuation))
            }
            visited += 1L
        }
        return false
    }
    private fun continueTab(plan: TabContinuation) {
        if (!root.isOpen || !plan.node.active || !plan.node.scope.input.isInputAllowed)
            return
        if (move(plan.node, plan.reverse, plan.loop, Some(plan.after), Some(plan.remaining)))
            return
        var cursor = plan.node.parent
        while (true) {
            val node = cursor ?: return
            if (!node.active || !node.scope.input.isInputAllowed)
                return
            when (node.focusScope) {
                case Some(scope) -> {
                    val atRoot =
                        when (node.parent) {
                            case None -> true;
                            case Some(_) -> false
                        }
                    if (
                        scope.available &&
                            move(node, plan.reverse, scope.options.loop || atRoot, Some(plan.after))
                    )
                        return
                }
                case None -> when (node.parent) {
                    case None -> {
                        move(node, plan.reverse, true, Some(plan.after));
                        return
                    }
                    case Some(_) -> {}
                }
            }
            cursor = node.parent
        }
    }
    private fun clearPending() {
        val previous = pending
        pending = None
        when (previous) {
            case Some(_) -> if (root.isOpen)
                root.requestFrame()
            case None -> {}
        }
    }
    public override fun close() {
        clearPending()
        registration?.close()
        registration = None
        val previous = drawing
        drawing = None
        var failure = cleanupUi(None) { previous?.close() }
        failure = cleanupUi(failure) { scene.close() }
        throwUi(failure)
    }
}
