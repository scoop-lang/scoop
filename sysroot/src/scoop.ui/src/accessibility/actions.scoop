package scoop.ui

import scoop.window.accessibility.*
import scoop.window.Utf8Range
import scoop.window.Utf8Selection

/** Capabilities follow actual handlers; every native entry shares the root boundary. */
internal fun semanticActions(handle: SemanticsHandle, actions: SemanticActions): SemanticActions {
    val invoke: (() -> SemanticActionResult)? =
        when (actions.invoke) {
            case Some(val action) -> Some { handle.controller.perform(handle, action) }
            case None -> None
        }
    val toggle: (() -> SemanticActionResult)? =
        when (actions.toggle) {
            case Some(val action) -> Some { handle.controller.perform(handle, action) }
            case None -> None
        }
    val setValue: ((String) -> SemanticActionResult)? =
        when (actions.setValue) {
            case Some(val action) -> Some {
                text -> handle.controller.perform(handle) { action(text) }
            }
            case None -> None
        }
    val focus: ((Boolean) -> SemanticActionResult)? =
        when (actions.focus) {
            case Some(val action) -> Some {
                value -> handle.controller.perform(handle) { action(value) }
            }
            case None -> when (handle.focus) {
                case Some(_) -> Some {
                    value -> handle.controller.perform(handle) { semanticFocus(handle, value) }
                }
                case None -> None
            }
        }
    val setSelection: ((Utf8Selection) -> SemanticActionResult)? =
        when (actions.setSelection) {
            case Some(val action) -> Some {
                value -> handle.controller.perform(handle) { action(value) }
            }
            case None -> None
        }
    val replaceText: ((Utf8Range, String) -> SemanticActionResult)? =
        when (actions.replaceText) {
            case Some(val action) -> Some {
                range,
                text -> handle.controller.perform(handle) { action(range, text) }
            }
            case None -> None
        }
    return SemanticActions(invoke, toggle, setValue, focus, setSelection, replaceText)
}

private fun semanticFocus(handle: SemanticsHandle, focused: Boolean): SemanticActionResult {
    val target = handle.focus ?: return SemanticActionResult.Unavailable
    if (!target.active)
        return SemanticActionResult.Unavailable
    if (!target.available)
        return SemanticActionResult.Rejected
    if (!focused) {
        target.handle.clearFocus()
        return if (!target.handle.hasFocus)
            SemanticActionResult.Completed
        else
            SemanticActionResult.Rejected
    }
    if (target.handle.isFocusActive)
        return SemanticActionResult.Completed
    if (!target.handle.requestFocus())
        return SemanticActionResult.Rejected
    return if (target.handle.isFocusActive)
        SemanticActionResult.Completed
    else
        SemanticActionResult.Busy
}
