package scoop.ui

import scoop.window.accessibility.*

/** Only an actual structural change walks the mounted tree, in declaration order. */
internal class SemanticOrder {
    private var next = 0L
    val handles = ArrayList<SemanticsHandle>()
    fun apply(node: MountedNode, inherited: SemanticsHandle?) {
        if (!node.active)
            return
        for (handle in node.semanticHandles) {
            if (!handle.active)
                continue
            val parent = semanticParent(handle.explicitParent, inherited)
            handle.resource.reparent(parent?.resource, next)
            handle.parent = parent
            handles.add(handle)
            next += 1L
        }
        val route = semanticParent(node.semanticRoute, inherited)
        for (child in node.children)
            apply(child, route)
    }
}

internal fun semanticParent(
    local: SemanticsHandle?,
    inherited: SemanticsHandle?
): SemanticsHandle? =
    when (local) {
        case Some(val value) -> Some(value)
        case None -> inherited
    }

internal fun inheritedSemantics(node: MountedNode): SemanticsHandle? {
    var ancestor = node.parent
    while (true) {
        val current = ancestor ?: return None
        when (val route = current.semanticRoute) {
            case Some(val handle) -> if (handle.active)
                return Some(handle)
            case None -> {}
        }
        ancestor = current.parent
    }
}

internal fun checkSemanticParent(node: MountedNode, parent: SemanticsHandle?) {
    when (parent) {
        case Some(val handle) -> {
            handle.checkOpen()
            var ancestor: MountedNode? = Some(node)
            while (true) {
                val current = ancestor ?: break
                if (current === handle.owner)
                    return
                ancestor = current.parent
            }
            throw IllegalArgumentException(
                Some("semantic parent must belong to this mount or an ancestor")
            )
        }
        case None -> {}
    }
}
