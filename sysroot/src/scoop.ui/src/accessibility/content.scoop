package scoop.ui

import scoop.collections.HashMap
import scoop.collections.HashSet
import scoop.window.accessibility.*

/** Reconciles declared content only when its membership or eligibility changes. */
internal class SemanticContent(private val ordered: Array<SemanticsHandle>) {
    private val children = HashMap<SemanticNodeId, ArrayList<SemanticsHandle>>()
    private val concealed = HashSet<SemanticNodeId>()
    private val merged = HashSet<SemanticNodeId>()
    private val content = HashMap<SemanticNodeId, Array<SemanticNodeId>>()

    init {
        for (handle in ordered) {
            if (!handle.active)
                continue
            var hidden = handle.properties.hidden
            when (val parent = handle.parent) {
                case Some(val value) -> {
                    val siblings =
                        when (val existing = children[value.id]) {
                            case Some(val items) -> items
                            case None -> {
                                val items = ArrayList<SemanticsHandle>()
                                children[value.id] = items
                                items
                            }
                        }
                    siblings.add(handle)
                    hidden = hidden || concealed.contains(value.id)
                }
                case None -> {}
            }
            if (hidden)
                concealed.add(handle.id)
        }
        for (handle in ordered) {
            if (!handle.active)
                continue
            val labels = ArrayList<SemanticNodeId>()
            if (handle.mergeLabels && !handle.properties.ignored && !concealed.contains(handle.id))
                collect(handle.id, labels)
            content[handle.id] = labels.toArray()
        }
    }

    private fun collect(parent: SemanticNodeId, labels: ArrayList<SemanticNodeId>) {
        val values = children[parent] ?: return
        for (child in values) {
            if (concealed.contains(child.id))
                continue
            if (child.properties.ignored)
                collect(child.id, labels)
            else
                if (child.mergeCandidate && !children.containsKey(child.id)) {
                    labels.add(child.id)
                    merged.add(child.id)
                }
        }
    }

    fun apply() {
        for (handle in ordered) {
            if (!handle.active)
                continue
            val next = content[handle.id]!!
            if (!sameContent(handle.resource.contentLabels, next))
                handle.resource.contentLabels = []
        }
        for (handle in ordered) {
            if (!handle.active)
                continue
            val ignored = merged.contains(handle.id)
            if (handle.merged != ignored) {
                handle.merged = ignored
                handle.resource.update(
                    semanticProperties(handle.properties, ignored),
                    semanticActions(handle, handle.actions),
                    handle.resource.relations
                )
            }
            handle.resource.contentLabels = content[handle.id]!!
        }
    }
}

private fun sameContent(before: Array<SemanticNodeId>, after: Array<SemanticNodeId>): Boolean {
    if (before.size != after.size)
        return false
    for (index in 0L ..< before.size)
        if (before[index] != after[index])
            return false
    return true
}

internal fun semanticProperties(value: SemanticProperties, merged: Boolean): SemanticProperties {
    if (!merged || value.ignored)
        return value
    return SemanticProperties(
        name = value.name,
        description = value.description,
        automationId = value.automationId,
        value = value.value,
        enabled = value.enabled,
        readOnly = value.readOnly,
        protectedText = value.protectedText,
        checked = value.checked,
        hidden = value.hidden,
        error = value.error,
        ignored = true,
        selection = value.selection,
        required = value.required
    )
}
