package scoop.ui

import scoop.graphics.Rect
import scoop.graphics.Point

public enum OverlayAlignment {
    Start, Center, End
}

public enum OverlaySide {
    Top, Right, Bottom, Left, Start, End
}

public enum AnchorVisibility {
    Close, Hide, KeepVisible
}

public enum OverlayCloseReason {
    Explicit, Escape, OutsidePress, AnchorUnavailable, OwnerClosed
}

public enum OutsidePress {
    Ignore, CloseAndConsume, CloseAndContinue
}

public struct OverlayDismiss(
    val escape: Boolean = false,
    val outsidePress: OutsidePress = OutsidePress.Ignore,
    val includeAnchor: Boolean = false
)

public enum OverlayMode {
    NonModal, FocusContained, Modal
}

public struct OverlayFocusOptions(
    val initialFocus: FocusHandle? = None,
    val restoreFocus: Boolean = true
)

public enum OverlayPlacement {
    Viewport(
        val horizontal: OverlayAlignment = OverlayAlignment.Center,
        val vertical: OverlayAlignment = OverlayAlignment.Center,
        val viewportPadding: Double = 8.0
    ),
    Anchored(
        val anchor: LayoutAnchor,
        val preferredSide: OverlaySide = OverlaySide.Bottom,
        val alignment: OverlayAlignment = OverlayAlignment.Start,
        val gap: Double = 4.0,
        val viewportPadding: Double = 8.0,
        val matchAnchorWidth: Boolean = false
    ),
    AtPoint(
        val point: Point,
        val preferredSide: OverlaySide = OverlaySide.Bottom,
        val alignment: OverlayAlignment = OverlayAlignment.Start,
        val gap: Double = 0.0,
        val viewportPadding: Double = 8.0
    )
}

public class PortalOptions internal constructor(
    public val placement: OverlayPlacement = OverlayPlacement.Viewport(),
    public val handle: OverlayHandle? = None,
    public val anchorVisibility: AnchorVisibility = AnchorVisibility.Close,
    public val mode: OverlayMode = OverlayMode.NonModal,
    public val focus: OverlayFocusOptions? = None,
    public val dismiss: OverlayDismiss = OverlayDismiss(),
    public val transition: PresenceOptions = PresenceOptions(),
    public val onCloseRequest: (OverlayCloseReason) -> Boolean = { _ -> true },
    public val onClosed: (OverlayCloseReason) -> Unit = { _ -> Unit }
) {
    init {
        requireUi(
            mode != OverlayMode.Modal || dismiss.outsidePress != OutsidePress.CloseAndContinue,
            "modal outside presses cannot continue to the background"
        )
        when (placement) {
            case Viewport(_, _, padding) -> checkOverlayDistance(padding)
            case AtPoint(point, _, _, gap, padding) -> {
                requireUi(point.x.isFinite() && point.y.isFinite(), "non-finite overlay point")
                checkOverlayDistance(gap)
                checkOverlayDistance(padding)
            }
            case Anchored(_, _, _, gap, padding, _) -> {
                checkOverlayDistance(gap)
                checkOverlayDistance(padding)
            }
        }
    }
    internal val focusOptions: OverlayFocusOptions? get() =
        if (mode == OverlayMode.NonModal)
            focus
        else
            Some(focus ?: OverlayFocusOptions())
}

/** Value geometry for the nearest portal in the current scene pass. */
public class OverlayLayout internal constructor(
    public val bounds: Rect,
    public val available: Rect,
    public val anchor: Rect?,
    public val side: OverlaySide?,
    public val presence: PresenceSnapshot = PresenceSnapshot(PresencePhase.Present, 1.0)
)

private fun checkOverlayDistance(value: Double) {
    requireUi(value.isFinite() && value >= 0.0, "invalid overlay gap or viewport padding")
}

internal val OverlayPlacement.anchor: LayoutAnchor? get() =
    when (this) {
        case Viewport(_, _, _) -> None
        case AtPoint(_, _, _, _, _) -> None
        case Anchored(value, _, _, _, _, _) -> Some(value)
    }

internal fun checkOverlayMutation() {
    when (currentEvaluation()) {
        case Some(_) -> throw IllegalStateException(
            Some("overlay bindings cannot change during render, measure, scene or draw")
        )
        case None -> {}
    }
}
