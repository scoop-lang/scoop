package scoop.ui

import scoop.graphics.Point
import scoop.surface.*

/** Frame identity contains values only; it never retains a Canvas borrow. */
internal class OverlayFrame {
    val unavailable = ArrayList<PortalInstance>()
}

internal class OverlayController(private val root: UiRoot): Closeable {
    private val sessions = ArrayList<PortalInstance>()
    private val focusSessions = ArrayList<OverlayFocusSession>()
    private val retiring = ArrayList<PortalInstance>()
    private var stopped = false
    private var registration: Closeable? = None
    var frame = OverlayFrame()

    val currentModal: OverlayFocusSession? get() {
        val boundary = root.surface.inputBoundary ?: return None
        for (session in focusSessions) {
            when (session.boundary) {
                case Some(val value) -> if (value === boundary)
                    return Some(session)
                case None -> {}
            }
        }
        return None
    }
    val currentFocus: OverlayFocusSession? get() {
        var index = focusSessions.size
        while (index > 0L) {
            index -= 1L
            val session = focusSessions[index]
            if (session.acceptsFocus && session.inCurrentDomain)
                return Some(session)
        }
        return None
    }
    fun start() {
        root.surface.input.beforePointerPress = { press -> beforePress(press) }
        registration =
            Some(root.surface.input.addDefaultAction { context, event -> dismiss(context, event) })
    }
    fun add(value: PortalInstance) {
        sessions.add(value)
        value.domain = containingModal(value.node.parent)
    }
    fun open(value: PortalInstance, reopening: Boolean = false) {
        if (!reopening) {
            removeSession(value)
            sessions.add(value)
        }
        when (value.focusSession) {
            case Some(_) -> {}
            case None -> {
                val session = OverlayFocusSession(value, value.options, currentFocus)
                value.focusSession = Some(session)
                value.domain =
                    if (session.isModal)
                        Some(session)
                    else
                        containingModal(value.node.parent)
                if (root.isOpen) {
                    focusSessions.add(session)
                    when (value.retirementRevision) {
                        case Some(val revision) -> session.beginClose(revision)
                        case None -> {}
                    }
                } else
                    session.finish()
            }
        }
    }

    /** Logical ancestry and registration order survive a change of modal policy. */
    fun reclassify() {
        for (portal in sessions) {
            val session = portal.focusSession
            portal.domain =
                when (session) {
                    case Some(val value) -> if (value.isModal)
                        Some(value)
                    else
                        containingModal(portal.node.parent)
                    case None -> containingModal(portal.node.parent)
                }
        }
    }

    fun remove(value: PortalInstance, pending: Boolean) {
        removeSession(value)
        if (pending)
            retiring.add(value)
    }
    private fun removeSession(value: PortalInstance) {
        for (index in 0L ..< sessions.size)
            if (sessions[index] === value) {
                sessions.removeAt(index);
                return
            }
    }
    fun beginFrame() {
        frame = OverlayFrame()
    }
    fun include(value: PortalInstance) {
        value.included = Some(frame)
    }
    fun paint(context: FrameContext) {
        paintDomain(None, context)
        for (session in focusSessions)
            if (session.isModal)
                paintDomain(Some(session), context)
        for (portal in sessions) {
            val included = portal.included
            when (included) {
                case Some(val value) -> if (value !== frame)
                    portal.node.clearPaintSubtree()
                case None -> portal.node.clearPaintSubtree()
            }
        }
    }
    private fun paintDomain(domain: OverlayFocusSession?, context: FrameContext) {
        for (portal in sessions) {
            val included = portal.included ?: continue
            if (!portal.isPresent || included !== frame || !sameModal(portal.domain, domain))
                continue
            val anchor =
                when (portal.anchor) {
                    case Some(val handle) -> {
                        val geometry = handle.geometry(frame)
                        val usable =
                            when (geometry) {
                                case Some(val value) -> value.visible ||
                                    portal.options.anchorVisibility ==
                                    AnchorVisibility.KeepVisible
                                case None -> false
                            }
                        if (!usable) {
                            portal.node.clearPaintSubtree()
                            if (portal.options.anchorVisibility != AnchorVisibility.Hide)
                                frame.unavailable.add(portal)
                            continue
                        }
                        geometry?.bounds
                    }
                    case None -> None
                }
            val plan =
                planOverlay(
                    portal.options.placement,
                    context.size,
                    anchor,
                    portal.node.layoutDirection
                )
            val child = portal.node.children[0L]
            val result = child.measure(plan.constraints, context.time)
            result.finishMeasurement()
            val metrics = result.metrics
            val layout = plan.layout(metrics.size, portal.snapshot, metrics.overlayAnchor)
            portal.focusSession?.place(context)
            result.scene(context, Point(layout.bounds.x, layout.bounds.y), Some(layout))
            portal.presented = Some(frame)
            when (portal.focusSession) {
                case Some(val modal) -> modal.presented = Some(frame)
                case None -> {}
            }
        }
    }
    fun complete(completion: FrameCompletion) {
        val completed = frame
        val unavailable = frame.unavailable.toArray()
        frame.unavailable.clear()
        if (completion.submission != FrameSubmission.Accepted)
            return
        var failure: Throwable? = None
        for (portal in unavailable) {
            if (portal.isOpen)
                failure =
                    cleanupUi(failure) { portal.forceClose(OverlayCloseReason.AnchorUnavailable) }
        }
        val previous = currentFocus
        var restore: OverlayFocusSession? = None
        val work = focusSessions.toArray()
        var index = work.size
        while (index > 0L) {
            index -= 1L
            val modal = work[index]
            if (modal.isClosing && !modal.wasPresented(completed)) {
                when (restore) {
                    case None -> if (
                        modal.canRestoreFocus &&
                            (sameModal(previous, Some(modal)) || modal.heldFocusOnClose)
                    )
                        restore = Some(modal)
                    case Some(_) -> {}
                }
                failure = cleanupUi(failure) { modal.finish() }
                removeModal(modal)
            }
        }
        val restoreTarget = restore
        if (root.isOpen)
            failure = cleanupUi(failure) { restoreTarget?.restore() }
        for (portal in sessions.toArray())
            if (root.isOpen)
                failure = cleanupUi(failure) { portal.complete(completed) }
        val pending = retiring.toArray()
        retiring.clear()
        for (portal in pending) {
            failure = cleanupUi(failure) { portal.complete(completed) }
            if (portal.hasPendingClose)
                retiring.add(portal)
        }
        for (modal in focusSessions.toArray())
            if (root.isOpen)
                failure = cleanupUi(failure) { modal.complete(completed) }
        throwUi(failure)
    }
    private fun removeModal(value: OverlayFocusSession) {
        for (index in 0L ..< focusSessions.size)
            if (focusSessions[index] === value) {
                focusSessions.removeAt(index)
                return
            }
    }
    fun stop() {
        if (stopped)
            return
        stopped = true
        var failure = cleanupUi(None) { registration?.close() }
        registration = None
        for (portal in sessions.toArray())
            failure = cleanupUi(failure) { portal.forceClose(OverlayCloseReason.OwnerClosed) }
        val work = focusSessions.toArray()
        focusSessions.clear()
        var index = work.size
        while (index > 0L) {
            index -= 1L
            val modal = work[index]
            failure = cleanupUi(failure) { modal.finish() }
        }
        throwUi(failure)
    }
    public override fun close() {
        var failure = cleanupUi(None) { stop() }
        val live = sessions.toArray()
        val retired = retiring.toArray()
        sessions.clear()
        retiring.clear()
        for (portal in live)
            failure = cleanupUi(failure) { portal.completeClose() }
        for (portal in retired)
            failure = cleanupUi(failure) { portal.completeClose() }
        throwUi(failure)
    }

    fun beforePress(press: InputPress): Boolean =
        dismissOverlayPress(root, sessions, currentModal, press)
    fun dismiss(context: RoutedEventContext, event: InputEvent) {
        dismissOverlayKey(root, sessions, currentModal, context, event)
    }
}
