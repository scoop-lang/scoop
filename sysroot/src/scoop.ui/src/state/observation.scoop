package scoop.ui

import scoop.surface.AnimationReadObserver
import scoop.collections.HashMap

private val stateSequence = AtomicLong(0L)

internal struct StateSignalId(val value: Long): Equals<StateSignalId>, Hash {
    public override operator fun equals(other: StateSignalId): Boolean = value == other.value
    public override fun hash(): Long = value.hash()
}

internal class StateSignal {
    val id = StateSignalId(stateSequence.fetchAdd(1L, MemoryOrder.Relaxed))
    private val observers = ArrayList<StateSubscription>()

    fun subscribe(node: MountedNode): StateSubscription {
        val subscription = StateSubscription(Some(this), Some(node), observers.size)
        observers.add(subscription)
        return subscription
    }
    fun remove(subscription: StateSubscription) {
        val index = subscription.index
        val last = observers.size - 1L
        if (index != last) {
            val moved = observers[last]
            observers[index] = moved
            moved.index = index
        }
        observers.removeAt(last)
    }
    fun changed(invalidation: UiInvalidation = UiInvalidation.None) {
        for (observer in observers.toArray()) {
            when (observer.node) {
                case Some(node) -> {
                    node.request(invalidation)
                    node.invalidate()
                }
                case None -> {}
            }
        }
    }
}

/** Closing a binding removes it without searching its source's other observers. */
internal class StateSubscription(
    private var source: StateSignal?,
    var node: MountedNode?,
    var index: Long
): Closeable {
    public override fun close() {
        val owner = source ?: return
        owner.remove(this)
        source = None
        node = None
        index = -1L
    }
}

internal class DependencyCollector {
    val sources = HashMap<StateSignalId, StateSignal>()
    fun read(source: StateSignal) {
        sources[source.id] = source
    }
}

internal class UiEvaluation(
    val collector: DependencyCollector? = None,
    val preparing: Boolean = false,
    val frameReads: FrameReads? = None
)

context(evaluation: UiEvaluation)
private fun boundEvaluation(): UiEvaluation = evaluation

internal fun currentEvaluation(): UiEvaluation? {
    try {
        val current = boundEvaluation()
        return if (current.preparing)
            None
        else
            Some(current)
    }
    catch (_: MissingContextException) {
        return None
    }
}

internal fun <T> evaluateUi(
    collector: DependencyCollector?,
    frameReads: FrameReads? = None,
    block: () -> T
): T {
    val evaluation = UiEvaluation(collector, frameReads = frameReads)
    val observer: AnimationReadObserver = frameReads ?: IgnoreAnimationReads
    context(evaluation) {
        context(observer) {
            return block()
        }
    }
}

/** Item preparation is a lifecycle boundary, even when requested by a layout callback. */
internal fun <T> prepareUi(block: () -> T): T {
    val evaluation = UiEvaluation(preparing = true)
    val observer: AnimationReadObserver = IgnoreAnimationReads
    context(evaluation) {
        context(observer) {
            return block()
        }
    }
}
