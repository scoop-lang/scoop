package scoop.ui

import scoop.platform.concurrent.currentThreadId

/** Owner-thread observable storage, independent of any single mounted component. */
public class State<T> internal constructor(initial: T) {
    private val thread = currentThreadId()
    private var current = initial
    private val signal = StateSignal()

    public var value: T
    get() {
        checkUiThread(thread)
        when (currentEvaluation()) {
            case Some(val evaluation) -> evaluation.collector?.read(signal)
            case None -> {}
        }
        return current
    }
    set(value) {
        checkMutation()
        publish(value)
    }

    /** Checks the owner and evaluation phase before mutating an external model; has no state effects. */
    public fun checkMutation() {
        checkUiThread(thread)
        when (currentEvaluation()) {
            case Some(_) -> throw IllegalStateException(
                Some("State cannot change during render, measure, scene or draw")
            )
            case None -> {}
        }
    }

    /** Publishes a synchronous transaction whose caller already passed checkMutation. */
    internal fun publish(value: T) {
        current = value
        signal.changed()
    }

    public operator fun getValue(thisRef: Any): T = value
    public operator fun setValue(thisRef: Any, value: T) {
        this.value = value
    }
    public fun binding(): Binding<T> = binding(get = { value }, set = { next -> value = next })
}

public fun <T> state(initial: T): State<T> = State(initial)

/** Explicit access to a current value; it does not create a second copy of that value. */
public class Binding<T> internal constructor(
    private val read: () -> T,
    private val write: (T) -> Unit
) {
    public var value: T
    get() = read()
    set(value) {
        write(value)
    }
}

public fun <T> binding(get: () -> T, set: (T) -> Unit): Binding<T> = Binding(get, set)

/** An explicit, stable rule for comparing inputs consumed by render or update. */
public class InputComparison<P> public constructor(internal val equivalent: (P, P) -> Boolean)

/** The latest parent input, replaced even when the input comparison skips evaluation. */
public class Props<P> internal constructor(initial: P, comparison: InputComparison<P>? = None) {
    private val thread = currentThreadId()
    private var current = initial
    private var comparison = comparison
    public val value: P get() {
        checkUiThread(thread)
        return current
    }
    internal fun replace(next: P, rule: InputComparison<P>? = None): Boolean {
        checkUiThread(thread)
        val previous = current
        val previousRule = comparison
        current = next
        comparison = rule
        return when ((previousRule, rule)) {
            case(Some(val before), Some(val after)) -> before ===
                after &&
                evaluateUi<Boolean>(None) { after.equivalent(previous, next) }
            else -> false
        }
    }
}
