package scoop.ui.text

import scoop.graphics.Rect
import scoop.ui.*

/** Retain source-over text commands without introducing an offscreen compositing layer. */
internal fun SceneContext.drawTextLayer(
    key: PaintKey,
    bounds: Rect,
    revision: Long,
    block: (PaintContext) -> Unit
) {
    if (retainsTextDrawing)
        drawRecording(key, bounds, revision, 1.0, PaintComposition.SourceOver, block)
    else
        draw(block)
}
