package scoop.ui.text

import scoop.graphics.Rect
import scoop.ui.*

/** Text uses source-over pixels; only explicit scene or pixel reuse needs a finite recording. */
internal fun SceneContext.drawTextLayer(
    key: PaintKey,
    bounds: Rect,
    revision: Long,
    block: (PaintContext) -> Unit
) {
    if (retainsTextDrawing)
        drawLayer(key, bounds, revision, block = block)
    else
        draw(block)
}
