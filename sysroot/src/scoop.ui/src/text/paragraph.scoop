package scoop.ui.text

import scoop.graphics.Point
import scoop.graphics.Rect
import scoop.graphics.text.*
import scoop.platform.concurrent.currentThreadId
import scoop.surface.InputArea
import scoop.ui.*

/** Public text/child adapter for any Element; it owns layouts but not fonts or children. */
public class ParagraphHost public constructor(): Closeable {
    private val thread = currentThreadId()
    private val cache = ParagraphCache()
    private val paintKey = PaintKey()
    private var closed = false

    public val isClosed: Boolean get() {
        checkUiThread(thread)
        return closed
    }
    private fun checkOpen() {
        checkUiThread(thread)
        if (closed)
            throw IllegalStateException(Some("paragraph host is closed"))
    }

    public fun measure(
        context: MeasureContext,
        constraints: Constraints,
        fonts: FontCollection,
        content: StyledText,
        settings: ParagraphStyle? = None,
        inlines: Array<InlineView> = []
    ): ParagraphMeasurement {
        checkOpen()
        constraints.check()
        val ordered = orderedInlines(content, inlines)
        requireUi(
            context.childCount == ordered.size,
            "paragraph children do not match inline views"
        )
        val metrics =
            Array<InlineMetrics>(ordered.size) {
                index ->
                val item = ordered[index]
                val limits =
                    when (item.size) {
                        case Some(val size) -> Constraints.tight(size)
                        case None -> Constraints(maxWidth = constraints.maxWidth)
                    }
                item.metrics(context.measureChild(index, limits))
            }
        val resolved =
            settings ?: paragraphStyle { direction = context.layoutDirection.textDirection() }
        val result = cache.update(fonts, content, resolved, constraints.maxWidth, metrics)
        var index = 0L
        for (placement in result.inlineObjects) {
            when (placement.box) {
                case Some(val box) -> context.placeChild(index, Point(box.rect.x, box.rect.y))
                case None -> {}
            }
            index += 1L
        }
        return ParagraphMeasurement(
            LayoutMetrics(
                constraints.constrain(result.size),
                Some(result.alphabeticBaseline),
                Some(result.ideographicBaseline)
            ),
            cache.retainLayout(),
            cache.generation
        )
    }

    public fun scene(context: SceneContext, measurement: ParagraphMeasurement) {
        checkOpen()
        val layout = measurement.layout
        context.drawTextLayout(paintKey, layout, measurement.generation)
        context.children()
    }

    public override fun close() {
        checkUiThread(thread)
        if (closed)
            return
        closed = true
        cache.close()
    }
}
