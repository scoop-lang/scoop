package scoop.ui.text

import scoop.graphics.Color
import scoop.time.Duration
import scoop.ui.requireUi

/** Direct text taps and holds are independent of native mouse and keyboard commands. */
public class TextTouchOptions public constructor(
    public val enabled: Boolean = true,
    public val threshold: Double = 8.0,
    public val longPressDelay: Duration? = Some(Duration.milliseconds(500L)),
    public val multiTap: Boolean = true,
    public val multiTapInterval: Duration? = None,
    public val selectionHandles: TextSelectionHandleOptions = TextSelectionHandleOptions()
) {
    init {
        requireUi(threshold.isFinite() && threshold >= 0.0, "invalid text touch threshold")
        when (longPressDelay) {
            case Some(val value) -> requireUi(value.floorSeconds >= 0L, "negative long press delay")
            case None -> {}
        }
        when (multiTapInterval) {
            case Some(val value) -> requireUi(
                value.floorSeconds >= 0L,
                "negative multi-tap interval"
            )
            case None -> {}
        }
    }
}

/** Visible contact targets share the text host's selection and clipped geometry. */
public class TextSelectionHandleOptions public constructor(
    public val enabled: Boolean = true,
    public val radius: Double = 6.0,
    public val hitRadius: Double = 18.0,
    public val color: Color? = None
) {
    init {
        requireUi(radius.isFinite() && radius > 0.0, "invalid text handle radius")
        requireUi(hitRadius.isFinite() && hitRadius >= radius, "invalid text handle hit radius")
        when (color) {
            case Some(val value) -> checkSelectableColor(value)
            case None -> {}
        }
    }
}
