package scoop.ui.text

import scoop.graphics.*
import scoop.graphics.text.*
import scoop.platform.concurrent.currentThreadId
import scoop.surface.*
import scoop.ui.*
import scoop.window.*

/** One mounted plain-text view, using the existing input, layout and scroll owners. */
public class TextEditHost public constructor(
    internal val scope: ComponentScope,
    initialState: TextEditorState,
    initialAppearance: TextEditAppearance,
    initialOptions: TextEditOptions = TextEditOptions(),
    private val onInteractionChanged: (TextEditInteraction) -> Unit = { _ -> Unit }
): Closeable {
    private val thread = currentThreadId()
    internal val window = scope.nativeWindow
    internal var current = initialState
    internal var appearance = initialAppearance
    internal var options = initialOptions
    internal var placeholder = ""
    internal var edited: (TextEditorState) -> Unit = { _ -> Unit }
    internal var submitted: (TextEditorState) -> Unit = { _ -> Unit }
    private var committed: (TextEditorState) -> Unit = { _ -> Unit }
    internal var closed = false
    internal var performing = false
    internal var notifying = false
    internal var connection: TextInputConnection? = None
    internal var sessionEnabled = false
    internal var retiring = false
    internal var preferredX: Double? = None
    internal val visual = State<TextEditInteraction>(TextEditInteraction())
    internal val body = ParagraphCache()
    internal val glyphs = ArrayList<EditorGlyphCache>()
    internal var currentLayout: TextEditLayout? = None
    internal var geometryGeneration = 0L
    internal val hint = ParagraphCache()
    internal val bodyKey = PaintKey()
    internal val hintKey = PaintKey()
    internal var currentDisplay: TextDisplay? = None
    internal var currentProjection = initialOptions.projection
    internal var content: StyledText? = None
    internal var hintContent: StyledText? = None
    internal var staged: EditorFrame? = None
    internal var accepted: EditorFrame? = None
    internal val semantics = SemanticTextHost()
    internal var semanticLayout: EditorSemanticLayout? = None
    internal var revealNeeded = false
    internal var revealRevision = 0UL
    internal var caretVisible = true
    internal var drag: EditorDrag? = None
    public val scroll = ScrollState()
    internal val viewport = scope.scrollViewport(scroll)
    public val area =
        scope.createArea(
            focusable = true,
            textInput = initialOptions.enabled && !initialOptions.readOnly
        ) { context, event -> editorHandle(this, context, event) }
    public val focus = scope.focusTarget(area, FocusOptions(visibility = FocusVisibility.Always))
    internal val contextMenu =
        TextContextMenu(
            scope,
            area,
            { options.contextMenu },
            { !closed && options.enabled && area.isFocusActive },
            { command -> execute(command) },
            true
        )
    internal val blink = scope.createDeadline { editorBlink(this) }
    internal val dragTimer = scope.createDeadline { editorDragTick(this) }
    internal val dropTarget = createEditorDropTarget(this)
    internal val dataSource = createEditorDragSource(this)
    internal val touchPan =
        scope.scrollPan(
            area,
            viewport,
            editorTouchAxes(initialOptions),
            options = editorTouchScroll(initialOptions)
        )
    internal val touchPress = createEditorContactPress(this)
    internal val touchHandles = createEditorSelectionHandles(this)
    private val touchScrollIntent =
        scroll.observeIntent {
            value -> when (value) {
                case LayoutCorrection(_) -> {}
                case User(_) -> {
                    touchPress.cancel();
                    revealNeeded = false
                }
                case Programmatic(_) -> touchPress.cancel()
            }
        }
    internal var caretPreferences = scope.interactionPreferences
    private var caretScale = window.metrics?.scaleFactor
    private val preferenceObserver =
        scope.observeInteractionPreferences { next -> editorPreferencesChanged(this, next) }
    private val geometryObserver =
        scope.observeWindow(window) {
            event -> when (event) {
                case GeometryChanged(val metrics) -> {
                    if (caretScale != Some(metrics.scaleFactor)) {
                        caretScale = Some(metrics.scaleFactor)
                        if (
                            !closed &&
                                appearance.caretWidth ==
                                None &&
                                caretPreferences.caretWidthPixels !=
                                None
                        )
                            scope.requestLayout()
                    }
                }
                else -> {}
            }
        }

    init {
        initialOptions.check()
        initialAppearance.check()
        checkDocument(initialState.committedText)
        area.scope.defaultAction = { context, event -> editorHandle(this, context, event) }
        area.scope.onEventFinished = { event -> editorFinish(this, event) }
        area.scope.enabled = initialOptions.enabled
        viewport.paintCache = initialOptions.paintCache
        refreshMenuCommands()
    }

    public val isClosed: Boolean get() {
        checkUiThread(thread);
        return closed
    }
    public val state: TextEditorState get() {
        checkOpen();
        return current
    }
    /** Last published interaction remains readable while input and resources retire. */
    public val interaction: TextEditInteraction get() {
        checkUiThread(thread);
        return visual.value
    }
    internal fun publishInteraction(value: TextEditInteraction) {
        if (visual.value == value)
            return
        visual.value = value
        onInteractionChanged(value)
    }
    /** Borrowed from the last accepted frame; measurements carry their own layouts. */
    public val layout: TextEditLayout get() {
        checkOpen();
        return accepted?.layout ?:
            throw IllegalStateException(Some("text editor has no accepted layout"))
    }
    public val display: TextDisplay get() {
        checkOpen()
        return accepted?.display ?:
            throw IllegalStateException(Some("text editor has no accepted layout"))
    }
    public fun caret(position: TextPosition): Rect? {
        checkOpen()
        val frame =
            accepted ?: throw IllegalStateException(Some("text editor has no accepted layout"))
        return frame.caretStyle.caret(
            frame.layout,
            editorVisualPosition(frame.layout, frame.display.toDisplay(position))
        )
    }
    public fun selectionBounds(range: Utf8Range): Array<TextBox> {
        checkOpen()
        return layout.selection(display.displayRange(range))
    }
    internal val copyAllowed: Boolean get() =
        when (options.copy) {
            case Default -> !options.protectedText && !options.projection.masked
            case Allow -> true
            case Deny -> false
        }
    /** The last accepted viewport and its clamped offsets. */
    public val scrollSnapshot: ScrollSnapshot get() {
        checkOpen()
        return accepted?.snapshot ?:
            throw IllegalStateException(Some("text editor has no accepted layout"))
    }

    internal fun checkOpen() {
        checkUiThread(thread)
        if (closed || !scope.isMounted)
            throw IllegalStateException(Some("text edit host is no longer mounted"))
    }
    internal fun checkDocument(text: String) {
        requireUi(
            options.multiline || !editorHasLineBreak(text),
            "single-line editor contains a hard line break"
        )
    }

    public fun update(
        state: TextEditorState,
        appearance: TextEditAppearance,
        options: TextEditOptions = TextEditOptions(),
        focus: FocusOptions = FocusOptions(),
        placeholder: String = "",
        onEdited: (TextEditorState) -> Unit = { _ -> Unit },
        onSubmit: (TextEditorState) -> Unit = { _ -> Unit },
        onCommitted: (TextEditorState) -> Unit = { _ -> Unit }
    ) {
        checkOpen()
        checkFocusMutation()
        options.check()
        appearance.check()
        requireUi(
            options.multiline || !editorHasLineBreak(state.committedText),
            "single-line editor contains a hard line break"
        )
        if (area.isFocusActive && options.enabled)
            state.checkHost(this)
        this.focus.options =
            if (focus.visibility == FocusVisibility.Automatic)
                focus.copy { this.visibility = FocusVisibility.Always }
            else
                focus
        val blinkChanged = this.options.caretBlink != options.caretBlink
        val rebound = current !== state
        val layoutChanged =
            rebound ||
                this.appearance.fonts !==
                appearance.fonts ||
                this.appearance.textStyle !==
                appearance.textStyle ||
                this.appearance.placeholderStyle !==
                appearance.placeholderStyle ||
                this.appearance.caretWidth !=
                appearance.caretWidth ||
                this.placeholder !=
                placeholder ||
                this.options.multiline !=
                options.multiline ||
                this.options.wrap !=
                options.wrap ||
                this.options.direction !=
                options.direction ||
                this.options.alignment !=
                options.alignment ||
                this.options.projection !==
                options.projection
        val restart =
            rebound ||
                this.options.readOnly !=
                options.readOnly ||
                this.options.enabled !=
                options.enabled ||
                this.options.multiline !=
                options.multiline
        if (layoutChanged || restart || this.options.contextMenu != options.contextMenu) {
            touchPress.cancel()
            touchPan.cancel()
            touchHandles.hide()
        }
        if (restart) {
            retireConnection()
            editorStopDrag(this, false)
            if (current.ownsHost(this))
                perform({ current.cancelComposition() }, notify = false)
            if (rebound)
                current.detachHost(this)
        }
        if (rebound)
            contextMenu.cancel()
        current = state
        this.appearance = appearance
        this.options = options
        touchPress.update(
            options.enabled && options.touch.enabled,
            options.touch.threshold,
            options.touch.longPressDelay,
            options.touch.multiTap,
            options.touch.multiTapInterval
        )
        touchPan.update(editorTouchAxes(options), ScrollChain.Chain, editorTouchScroll(options))
        touchHandles.update(options.enabled, options.touch)
        this.placeholder = placeholder
        edited = onEdited
        submitted = onSubmit
        committed = onCommitted
        if (blinkChanged) {
            blink.cancel()
            caretVisible = true
        }
        viewport.paintCache = options.paintCache
        area.scope.enabled = options.enabled
        area.textInput = options.enabled && !options.readOnly
        dropTarget?.update()
        dataSource?.update()
        refreshMenuCommands()
        if (area.isFocusActive && options.enabled)
            current.attachHost(this)
        if (restart)
            invalidate()
        editorInteraction(this, area.isFocusActive, visual.value.hovered && options.enabled)
        if (layoutChanged)
            scope.requestLayout()
        else
            scope.requestFrame()
    }

    public fun measure(
        constraints: Constraints,
        cells: TextEditCells? = None,
        scrollPadding: (Size, Size) -> ScrollPadding = { _, _ -> ScrollPadding() }
    ): TextEditMeasurement {
        checkOpen()
        when (cells) {
            case Some(_) -> requireUi(
                !options.multiline,
                "cell layout requires a single-line editor"
            )
            case None -> {}
        }
        return editorMeasure(this, constraints, cells, scrollPadding)
    }
    public fun scene(context: SceneContext, measurement: TextEditMeasurement) {
        checkOpen()
        editorScene(this, context, measurement)
    }
    public fun execute(command: TextEditCommand): Boolean {
        checkOpen()
        checkFocusMutation()
        if (!options.enabled || !area.isFocusActive || !area.scope.isInputAllowed)
            return false
        editorStopDrag(this, false)
        return editorCommand(this, command, None)
    }

    /** Opens a bound native menu at a visible caret or selection from accepted layout. */
    public fun showContextMenu(): Boolean {
        checkOpen()
        checkFocusMutation()
        return editorContextMenu(this, None, None)
    }

    internal fun modelChanged() {
        if (closed || performing)
            return
        dropTarget?.update()
        dataSource?.update()
        refreshMenuCommands()
        invalidate()
        editorStopDrag(this, false)
        current.breakUndoGroup()
        retireConnection()
    }
    internal fun invalidate(cancelContacts: Boolean = true) {
        if (cancelContacts) {
            touchPress.cancel()
            touchPan.cancel()
            touchHandles.hide()
        }
        preferredX = None
        if (!area.isClosed)
            area.setCaret(None, Some(current.revision))
        focus.node.root.focus.cancel(focus)
        revealNeeded =
            !(touchHandles.contact?.claimed ?: false) &&
                area.isFocusActive &&
                !focus.node.root.focus.pendingElsewhere(focus)
        revealRevision = focus.node.root.surface.focusRevision
        caretVisible = true
        blink.cancel()
        if (!closed && scope.isMounted)
            scope.requestLayout()
    }
    internal fun retireConnection() {
        if (!area.isClosed)
            retiring = area.restartTextInput()
    }
    internal fun publishNative(after: TextInputOrigin? = None) {
        if (
            closed ||
                retiring ||
                !sessionEnabled ||
                !area.isFocusActive ||
                options.readOnly ||
                !options.enabled
        )
            return
        when (connection) {
            case Some(val value) -> window.publishTextInputState(value, current.inputState, after)
            case None -> {}
        }
    }
    internal fun perform(
        action: () -> Boolean,
        endComposition: Boolean = false,
        notify: Boolean = true,
        cancelContacts: Boolean = true
    ): Boolean {
        val before = current.text
        val beforeCommitted = current.committedText
        val composing = current.isComposing
        performing = true
        val changed =
            try {
                action()
            } finally {
                performing = false
            }
        if (changed)
            invalidate(cancelContacts || before != current.text)
        if (endComposition && composing)
            retireConnection()
        refreshMenuCommands()
        publishNative()
        if (notify)
            notifyEdited(before, beforeCommitted)
        else
            dataSource?.update()
        return changed
    }
    internal fun notifyEdited(before: String, beforeCommitted: String) {
        if (notifying || closed)
            return
        dataSource?.update()
        val state = current
        val revision = state.revision
        val after = state.committedText
        val completed = !state.isComposing && beforeCommitted != after
        notifying = true
        try {
            if (before != state.text)
                edited(state)
            if (completed && !closed && current === state && state.revision == revision)
                committed(state)
        } finally {
            notifying = false
        }
    }

    public override fun close() {
        checkUiThread(thread)
        checkFocusMutation()
        if (closed)
            return
        closed = true
        val owned = current.detachHost(this)
        var failure: Throwable? = None
        failure = cleanupUi(failure) { semantics.close() }
        semanticLayout = None
        failure = cleanupUi(failure) { contextMenu.close() }
        failure = cleanupUi(failure) { touchPress.close() }
        failure = cleanupUi(failure) { touchPan.close() }
        failure = cleanupUi(failure) { touchHandles.close() }
        failure = cleanupUi(failure) { touchScrollIntent.close() }
        failure = cleanupUi(failure) { preferenceObserver.close() }
        failure = cleanupUi(failure) { geometryObserver.close() }
        failure = cleanupUi(failure) { blink.close() }
        failure = cleanupUi(failure) { dragTimer.close() }
        failure = cleanupUi(failure) { dropTarget?.close() }
        failure = cleanupUi(failure) { dataSource?.close() }
        drag = None
        if (owned)
            failure = cleanupUi(failure) { current.cancelComposition() }
        failure = cleanupUi(failure) { focus.close() }
        failure = cleanupUi(failure) { area.close() }
        failure = cleanupUi(failure) { viewport.close() }
        failure = cleanupUi(failure) { staged?.close() }
        staged = None
        failure = cleanupUi(failure) { accepted?.close() }
        accepted = None
        failure = cleanupUi(failure) { currentLayout?.release() }
        currentLayout = None
        for (glyph in glyphs)
            failure = cleanupUi(failure) { glyph.close() }
        glyphs.clear()
        failure = cleanupUi(failure) { body.close() }
        failure = cleanupUi(failure) { hint.close() }
        throwUi(failure)
    }
}
