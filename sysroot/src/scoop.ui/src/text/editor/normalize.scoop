package scoop.ui.text

internal fun editorHasLineBreak(text: String): Boolean {
    for (character in text)
        if (editorLineBreak(character))
            return true
    return false
}

internal fun editorLineBreak(character: Char): Boolean =
    character.code ==
        10 ||
        character.code ==
        13 ||
        character.code ==
        11 ||
        character.code ==
        12 ||
        character.code ==
        133 ||
        character.code ==
        8232 ||
        character.code ==
        8233
