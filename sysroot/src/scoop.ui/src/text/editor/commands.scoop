package scoop.ui.text

import scoop.window.*
import scoop.graphics.text.*

internal fun editorCommand(host: TextEditHost, command: TextEditCommand, key: KeyEvent?): Boolean {
    val state = host.current
    when (command) {
        case Move(movement, extend) -> {
            val result =
                editorMove(
                    editorInputLayout(host),
                    state.storage.value.endpoints,
                    movement,
                    extend,
                    host.preferredX,
                    host.scroll.viewport.height
                )
            host.perform({ editorSetSelection(host, result.selection) }, endComposition = true)
            host.invalidate()
            host.preferredX = result.preferredX
        }
        case Delete(deletion) -> {
            if (host.options.readOnly)
                return true
            val range = editorDeleteRange(editorInputLayout(host), state.selection, deletion)
            val kind =
                when (deletion) {
                    case Backward -> EditorEditKind.Backspace
                    case Forward -> EditorEditKind.Delete
                    else -> EditorEditKind.Separate
                }
            host.perform(
                { editorApplyEdit(host, range, "", TextEditSource.EditCommand, kind) },
                endComposition = true
            )
        }
        case Copy -> {
            val range = state.selection.range
            if (range.start != range.end)
                host.window.clipboard.writeText(state.text.utf8Slice(range))
        }
        case Cut -> {
            if (host.options.readOnly)
                return true
            val range = state.selection.range
            if (range.start != range.end) {
                val prepared =
                    prepareEditorEdit(
                        state,
                        range,
                        "",
                        host.options.policy,
                        TextEditSource.EditCommand,
                        !host.options.multiline
                    )
                if (prepared.accepted) {
                    host.window.clipboard.writeText(state.text.utf8Slice(range))
                    host.perform({ prepared.publish(state, false) }, endComposition = true)
                }
            }
        }
        case Paste -> {
            if (host.options.readOnly)
                return true
            when (host.window.clipboard.readText()) {
                case Some(value) -> {
                    host.perform(
                        {
                            editorApplyEdit(
                                host,
                                state.selection.range,
                                value,
                                TextEditSource.Paste
                            )
                        },
                        endComposition = true
                    )
                }
                case None -> {}
            }
        }
        case SelectAll -> host.perform(
            {
                editorSetSelection(
                    host,
                    EditorSelection(TextPosition(0L), TextPosition(state.text.byteLength))
                )
            },
            endComposition = true
        )
        case Undo -> {
            if (!host.options.readOnly)
                host.perform({ state.undo() }, endComposition = true)
        }
        case Redo -> {
            if (!host.options.readOnly)
                host.perform({ state.redo() }, endComposition = true)
        }
        case InsertNewline -> {
            if (editorSubmits(host.options, key)) {
                if (!(key?.isRepeat ?: false)) {
                    state.breakUndoGroup()
                    host.submitted(state)
                }
            } else
                if (host.options.multiline && !host.options.readOnly)
                    host.perform(
                        {
                            editorApplyEdit(
                                host,
                                state.selection.range,
                                "\n",
                                TextEditSource.EditCommand
                            )
                        },
                        endComposition = true
                    )
        }
        case InsertTab -> {
            if (host.options.tab == TextTabBehavior.Navigate)
                return false
            if (!host.options.readOnly)
                host.perform(
                    {
                        editorApplyEdit(
                            host,
                            state.selection.range,
                            "\t",
                            TextEditSource.EditCommand
                        )
                    },
                    endComposition = true
                )
        }
        case InsertBacktab -> return false
        case Cancel -> {
            if (!state.isComposing)
                return false
            host.perform({ state.cancelComposition() }, endComposition = true)
        }
    }
    return true
}

private fun editorSubmits(options: TextEditOptions, key: KeyEvent?): Boolean {
    val event = key ?: return options.submit == TextSubmitKeys.Enter
    val modifiers =
        when (options.submit) {
            case None -> return false
            case Enter -> ShortcutModifiers()
            case PrimaryEnter -> ShortcutModifiers(primary = true)
        }
    return ShortcutChord(ShortcutKey.Logical(LogicalKey.Named(NamedKey.Enter)), modifiers).matches(
        event
    )
}

internal fun editorApplyEdit(
    host: TextEditHost,
    range: Utf8Range,
    text: String,
    source: TextEditSource,
    kind: EditorEditKind = EditorEditKind.Separate
): Boolean =
    prepareEditorEdit(
        host.current,
        range,
        text,
        host.options.policy,
        source,
        !host.options.multiline,
        kind
    ).publish(host.current, false)

internal fun editorSetSelection(host: TextEditHost, selection: EditorSelection): Boolean {
    val state = host.current
    if (!state.isComposing)
        return state.setSelection(selection.anchor, selection.cursor)
    val raw = prepareEditorInput(state, TextInputBatch(None, [TextInputOperation.ClearPreedit]))!!
    return finishEditorInput(
        raw,
        host.options.policy,
        TextEditSource.EditCommand,
        !host.options.multiline,
        EditorEditKind.Separate,
        Some(selection)
    ).publish(state, false)
}
