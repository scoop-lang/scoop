package scoop.ui.text

import scoop.graphics.*
import scoop.graphics.text.*
import scoop.math.max
import scoop.surface.*
import scoop.ui.*

internal class EditorInputLayout(val layout: TextEditLayout, val display: TextDisplay)

internal class EditorMeasure(
    val retained: RetainedEditorLayout,
    val snapshot: ScrollSnapshot,
    val width: Double?,
    val revision: Long,
    val display: TextDisplay,
    val cells: TextEditCells?
)

internal class EditorFrame(
    private val retained: RetainedEditorLayout,
    val snapshot: ScrollSnapshot,
    val revision: Long,
    val display: TextDisplay,
    val cells: TextEditCells?
): Closeable {
    val layout: TextEditLayout get() = retained.layout
    public override fun close() {
        retained.close()
    }
}

private fun editorLayout(
    host: TextEditHost,
    width: Double?,
    cells: TextEditCells?
): EditorInputLayout {
    host.checkDocument(host.current.committedText)
    val input = editorSnapshot(host.current.storage.value)
    val cached = host.currentDisplay
    val display =
        when (cached) {
            case Some(previous) -> if (
                previous.source == input && host.currentProjection === host.options.projection
            )
                previous
            else
                projectEditorText(input, host.options.projection)
            case None -> projectEditorText(input, host.options.projection)
        }
    val text = display.text
    val style = host.appearance.textStyle
    val content =
        when (host.content) {
            case Some(previous) -> if (previous.text == text && previous.style === style)
                previous
            else
                styledText {
                    this.text(text)
                    this.style = style
                }
            case None -> styledText {
                this.text(text)
                this.style = style
            }
        }
    host.content = Some(content)
    val paragraph =
        host.body.update(
            host.appearance.fonts,
            content,
            paragraphStyle {
                this.alignment = host.options.alignment
                this.direction =
                    host.options.direction ?: host.scope.layoutDirection.textDirection()
            },
            width,
            []
        )
    val layout = editorGeometry(host, paragraph, cells)
    host.currentProjection = host.options.projection
    host.currentDisplay = Some(display)
    return EditorInputLayout(layout, display)
}

private fun editorHint(host: TextEditHost, width: Double?): TextLayout? {
    if (host.current.text.byteLength != 0L || host.placeholder.byteLength == 0L)
        return None
    val text =
        if (host.options.multiline)
            host.placeholder
        else
            mapEditorText(host.placeholder, editorNewlineEdits(host.placeholder)).text
    val style = host.appearance.placeholderStyle
    val content =
        when (host.hintContent) {
            case Some(previous) -> if (previous.text == text && previous.style === style)
                previous
            else
                styledText {
                    this.text(text)
                    this.style = style
                }
            case None -> styledText {
                this.text(text)
                this.style = style
            }
        }
    host.hintContent = Some(content)
    return Some(
        host.hint.update(
            host.appearance.fonts,
            content,
            paragraphStyle {
                this.alignment = host.options.alignment
                this.direction =
                    host.options.direction ?: host.scope.layoutDirection.textDirection()
            },
            width,
            []
        )
    )
}

private fun editorWidth(host: TextEditHost, viewport: Double?): Double? {
    if (!host.options.multiline || !host.options.wrap)
        return None
    return when (viewport) {
        case Some(width) -> Some(max(0.0, width - host.appearance.caretWidth))
        case None -> None
    }
}

internal fun editorMeasure(
    host: TextEditHost,
    constraints: Constraints,
    cells: TextEditCells?
): LayoutMetrics {
    constraints.check()
    val width = editorWidth(host, constraints.maxWidth)
    val text = editorLayout(host, width, cells)
    val layout = text.layout
    val paragraphMode =
        when (cells) {
            case None -> true;
            case Some(_) -> false
        }
    val hint =
        if (paragraphMode)
            editorHint(host, width)
        else
            None
    val caretPadding =
        if (paragraphMode)
            host.appearance.caretWidth
        else
            0.0
    val naturalWidth = max(layout.size.width, hint?.size?.width ?: 0.0) + caretPadding
    val size = constraints.constrain(Size(naturalWidth, layout.size.height))
    var contentWidth = layout.size.width
    for (line in layout.lines)
        contentWidth = max(contentWidth, line.rect.x + line.rect.width)
    val content =
        Size(max(size.width, contentWidth + caretPadding), max(size.height, layout.size.height))
    val snapshot = host.viewport.layout(size, content)
    val previous = host.measured
    host.measured =
        Some(
            EditorMeasure(
                layout.retain(),
                snapshot,
                width,
                host.current.revision,
                text.display,
                cells
            )
        )
    previous?.retained?.close()
    return LayoutMetrics(size, Some(layout.alphabeticBaseline), Some(layout.ideographicBaseline))
}

/** Pointer geometry stays paired with the last successful frame, even after a failed resize. */
internal fun editorInputText(host: TextEditHost): EditorInputLayout {
    when (host.accepted) {
        case Some(frame) -> {
            if (frame.display.source.text == host.current.text)
                return EditorInputLayout(frame.layout, frame.display)
            return editorLayout(
                host,
                editorWidth(host, Some(frame.snapshot.viewport.width)),
                frame.cells
            )
        }
        case None -> return editorLayout(host, None, host.measured?.cells ?: None)
    }
}

internal fun editorCaret(host: TextEditHost, text: EditorInputLayout): Rect? =
    text.layout.caret(
        editorVisualPosition(text.layout, text.display.mapping.forward(host.current.cursor)),
        host.appearance.caretWidth
    )

internal fun editorScene(host: TextEditHost, context: SceneContext) {
    val measure =
        host.measured ?: throw IllegalStateException(Some("text editor has not been measured"))
    val frame =
        EditorFrame(
            measure.retained.layout.retain(),
            measure.snapshot,
            measure.revision,
            measure.display,
            measure.cells
        )
    host.staged?.close()
    host.staged = Some(frame)
    val layout = frame.layout
    val appearance = host.appearance
    val input = host.current.inputState
    val caret = editorCaret(host, EditorInputLayout(layout, frame.display))
    val selection = layout.selection(frame.display.displayRange(input.selection.range))
    val marked =
        when (input.markedRange) {
            case Some(range) -> layout.selection(frame.display.displayRange(range))
            case None -> []
        }
    val active = host.area.isFocusActive
    val color =
        if (active)
            appearance.selectionColor
        else
            appearance.inactiveSelectionColor
    host.viewport.present(
        context,
        Some {
            content ->
            val snapshot = frame.snapshot
            host.area.setCaret(caret, Some(input.revision))
            content.place(
                host.area,
                Rect(
                    snapshot.offset.x,
                    snapshot.offset.y,
                    snapshot.viewport.width,
                    snapshot.viewport.height
                )
            )
            content.draw {
                paint -> for (box in selection)
                    paint.canvas.drawRect(box.rect, Paint(color))
            }
            val bounds = layout.paintBounds
            content.drawLayer(host.bodyKey, editorInkBounds(bounds), layout.generation) {
                paint -> paint.canvas.drawText(layout)
            }
            if (
                frame.layout.cellRects.size ==
                    0L &&
                    input.surroundingText.byteLength ==
                    0L &&
                    host.placeholder.byteLength >
                    0L
            ) {
                val hint = host.hint.layout
                content.drawLayer(
                    host.hintKey,
                    editorInkBounds(hint.paintBounds),
                    host.hint.generation
                ) { paint -> paint.canvas.drawText(hint) }
            }
            content.draw {
                paint ->
                for (box in marked)
                    paint.canvas.drawRect(
                        Rect(box.rect.x, box.rect.y + box.rect.height - 1.0, box.rect.width, 1.0),
                        Paint(appearance.markedColor)
                    )
                if (
                    active && host.caretVisible && input.selection.anchor == input.selection.cursor
                ) {
                    when (caret) {
                        case Some(rect) -> paint.canvas.drawRect(rect, Paint(appearance.caretColor))
                        case None -> {}
                    }
                }
            }
        }
    )
    context.onFrameComplete {
        completion ->
        when (host.staged) {
            case Some(staged) -> if (staged === frame)
                host.staged = None
            case None -> {}
        }
        if (host.closed || completion.submission == FrameSubmission.Discarded) {
            frame.close()
            return@onFrameComplete
        }
        val previous = host.accepted
        host.accepted = Some(frame)
        previous?.close()
        if (host.current.revision == frame.revision) {
            if (
                host.revealNeeded &&
                    !editorDragging(host) &&
                    host.area.isFocusActive &&
                    host.revealRevision ==
                    host.focus.node.root.surface.focusRevision
            ) {
                host.revealNeeded = false
                when (caret) {
                    case Some(rect) -> host.focus.reveal(rect)
                    case None -> {}
                }
            }
            editorDragAccepted(host)
            editorScheduleBlink(host)
        }
    }
}

private fun editorInkBounds(bounds: Rect): Rect =
    Rect(bounds.x - 1.0, bounds.y - 1.0, bounds.width + 2.0, bounds.height + 2.0)
