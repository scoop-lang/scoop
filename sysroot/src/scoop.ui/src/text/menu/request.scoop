package scoop.ui.text

import scoop.graphics.*
import scoop.graphics.text.*
import scoop.surface.*
import scoop.ui.*
import scoop.window.*

internal fun editorContextMenu(
    host: TextEditHost,
    pointer: PointerState?,
    local: Point?,
    touch: Boolean = false
): Boolean {
    if (
        host.closed ||
            !host.scope.isMounted ||
            !host.options.enabled ||
            (!touch && host.options.contextMenu.mode == TextContextMenuMode.Disabled) ||
            host.contextMenu.pending ||
            !host.area.scope.isInputAllowed ||
            host.window.state !=
            WindowState.Open ||
            host.window.isInputBlocked
    )
        return false
    val frame = host.accepted ?: return false
    val document = host.current
    if (frame.display.source.text != host.current.text)
        return false
    val bounds = host.area.visibleBounds ?: return false
    if (bounds.width <= 0.0 || bounds.height <= 0.0)
        return false
    when (pointer) {
        case Some(_) -> if (!host.area.requestFocus(FocusOrigin.Pointer))
            return false
        case None -> {}
    }
    if (
        !host.area.isFocusActive ||
            host.current !==
            document ||
            frame.display.source.text !=
            host.current.text
    )
        return false
    val options = host.options.contextMenu
    val popup = options.mode != TextContextMenuMode.Disabled
    if (popup && !host.contextMenu.eligible())
        return false
    val template =
        if (popup)
            Some(
                host.scope.application.textContextMenuTemplate(
                    options.mode == TextContextMenuMode.PreferSystem,
                    options.labels
                )
            )
        else
            None
    editorStopDrag(host, false)
    if (touch)
        host.touchHandles.show()
    val placement =
        when (pointer) {
            case Some(val value) -> {
                val point = local ?: return false
                val input = EditorInputLayout(frame.layout, frame.display, frame.caretStyle)
                val selected =
                    frame.layout.selection(frame.display.displayRange(host.current.selection.range))
                var inside = false
                for (box in selected)
                    if (textMenuContains(box.rect, point))
                        inside = true
                if (!inside && options.selection != TextContextMenuSelection.Preserve) {
                    val displayed = frame.layout.hitTest(point)
                    val selection =
                        if (textMenuSelectsWord(options, template, touch)) {
                            val range =
                                editorProjectedRange(input, frame.layout.wordRange(displayed))
                            EditorSelection(
                                TextPosition(range.start),
                                TextPosition(range.end, TextAffinity.Upstream)
                            )
                        } else {
                            val position =
                                frame.display.documentPosition(
                                    frame.display.mapping.reverse(displayed)
                                )
                            EditorSelection(position, position)
                        }
                    host.perform(
                        { editorSetSelection(host, selection) },
                        endComposition = true,
                        cancelContacts = !touch
                    )
                }
                PopupPlacement.Pointer(value.logicalPosition)
            }
            case None -> {
                val rect = editorMenuAnchor(host, frame, bounds) ?: return false
                PopupPlacement.Anchor(
                    LogicalRect(
                        LogicalPosition(rect.x, rect.y),
                        LogicalSize(rect.width, rect.height)
                    )
                )
            }
        }
    if (host.closed || !host.scope.isMounted || host.current !== document)
        return false
    return if (popup)
        host.contextMenu.open(template!!, placement, editorSystemMenuActions(host))
    else
        true
}

internal fun editorMenuAnchor(host: TextEditHost, frame: EditorFrame, bounds: Rect): Rect? {
    when (val caret = host.area.visibleCaretBounds) {
        case Some(val rect) -> if (rect.height > 0.0)
            return Some(rect)
        case None -> {}
    }
    for (box in frame.layout.selection(frame.display.displayRange(host.current.selection.range))) {
        when (val anchor = textMenuAnchor(host.area, box.rect, bounds)) {
            case Some(val rect) -> return Some(rect)
            case None -> {}
        }
    }
    return None
}

internal fun textMenuContains(rect: Rect, point: Point): Boolean =
    rect.width >
        0.0 &&
        rect.height >
        0.0 &&
        point.x >=
        rect.x &&
        point.y >=
        rect.y &&
        point.x <
        rect.x +
        rect.width &&
        point.y <
        rect.y +
        rect.height

internal fun textMenuKey(key: KeyEvent): Boolean =
    key.state ==
        ElementState.Pressed &&
        !key.synthetic &&
        !key.isRepeat &&
        !key.modifiers.control &&
        !key.modifiers.alt &&
        !key.modifiers.superKey &&
        key.modifiers.altGraph !=
        Some(true) &&
        (
            (key.logicalKey == LogicalKey.Named(NamedKey.ContextMenu) && !key.modifiers.shift) ||
                (key.logicalKey == LogicalKey.Named(NamedKey.F10) && key.modifiers.shift)
        )

internal fun textMenuSelectsWord(
    options: TextContextMenuOptions,
    template: TextContextMenuTemplate?,
    touch: Boolean
): Boolean =
    options.selection ==
        TextContextMenuSelection.SelectWord ||
        (
            options.selection ==
                TextContextMenuSelection.Platform &&
                (touch || (template?.selectWordOutsideSelection ?: false))
        )

internal fun textMenuAnchor(area: InputArea, local: Rect, bounds: Rect): Rect? {
    val rect = area.toWindow(local) ?: return None
    val left =
        if (rect.x > bounds.x)
            rect.x
        else
            bounds.x
    val top =
        if (rect.y > bounds.y)
            rect.y
        else
            bounds.y
    val right =
        if (rect.x + rect.width < bounds.x + bounds.width)
            rect.x + rect.width
        else
            bounds.x + bounds.width
    val bottom =
        if (rect.y + rect.height < bounds.y + bounds.height)
            rect.y + rect.height
        else
            bounds.y + bounds.height
    return if (right > left && bottom > top)
        Some(Rect(left, top, right - left, bottom - top))
    else
        None
}
