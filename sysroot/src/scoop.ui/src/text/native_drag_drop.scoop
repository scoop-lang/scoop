package scoop.ui.text

import scoop.ui.*

internal fun createEditorDropTarget(host: TextEditHost): EditorDropTarget? =
    Some(
        EditorDropTarget(host) {
            handlers,
            enabled -> host.scope.dropTarget(host.area, handlers, enabled)
        }
    )

internal fun createEditorDragSource(host: TextEditHost): EditorDragSource? =
    Some(
        EditorDragSource(host) {
            options,
            prepare -> host.scope.dragSource(host.area, options, prepare)
        }
    )

internal fun createSelectableDragSource(host: SelectableTextHost): SelectableDragSource? =
    Some(
        SelectableDragSource(host) {
            options,
            prepare -> host.scope.dragSource(host.area, options, prepare)
        }
    )
