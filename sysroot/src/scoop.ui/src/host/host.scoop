package scoop.ui

import scoop.platform.concurrent.currentThreadId
import scoop.graphics.text.FontCollection
import scoop.surface.SurfaceHost
import scoop.surface.SurfaceWindow
import scoop.surface.HostShortcutScope
import scoop.surface.ShortcutBinding
import scoop.window.*

/** Runs logical updates and Surface frames on the existing application owner. */
public class UiHost public constructor(
    private val onRootError: (WindowId, Throwable) -> Unit = { _, error -> throw error },
    private val handler: (UiHost, ActiveApplication, ApplicationEvent) -> Unit = { _, _, _ -> }
): ApplicationHandler, Closeable {
    private val thread = currentThreadId()
    private val roots = ArrayList<UiRoot>()
    private val pending = ArrayList<UiRoot>()
    private var proxy: ApplicationProxy? = None
    private var queued = false
    private var processing = false
    private var depth = 0
    private var nativeDepth = 0
    private var pendingRetirement = false
    private var closing = false
    private var hostShortcuts: HostShortcutScope? = None
    private val surfaces =
        SurfaceHost(
            onWindowError =
                {
                    id,
                    error -> try {
                        onRootError(id, error)
                    } catch (reported: Throwable) {
                        // Surface owns the original failure and combines a failing report with it.
                        throw cleanupUi(Some(reported)) { close() }!!
                    }
                },
            handler = { _, application, event -> handler(this, application, event) }
        )

    public val isClosed: Boolean get() {
        checkThread()
        return closing && roots.size == 0L && surfaces.isClosed
    }
    internal fun checkThread() {
        checkUiThread(thread)
    }

    public fun shortcutScope(bindings: Array<ShortcutBinding> = []): HostShortcutScope {
        checkThread()
        if (closing)
            throw IllegalStateException(Some("UI host is closed"))
        val scope = HostShortcutScope(surfaces, bindings)
        hostShortcuts = Some(scope)
        return scope
    }

    public fun <C: Component> attach(
        window: Window,
        create: (ComponentScope) -> C,
        fonts: FontCollection? = None
    ): UiWindow? {
        checkThread()
        if (closing)
            throw IllegalStateException(Some("UI host is closed"))
        return callback {
            var root: UiRoot? = None
            var surface: SurfaceWindow? = None
            try {
                val created = UiRoot(this, window, component(create), fonts)
                root = Some(created)
                roots.add(created)
                val attached = surfaces.attach(window, created)
                surface = Some(attached)
                if (attached.dispatch { created.mount(attached) })
                    Some(UiWindow(created))
                else
                    None
            } catch (error: Throwable) {
                when (surface) {
                    // A published Surface only propagates a failed error handler or host failure.
                    case Some(_) -> throw error
                    case None -> {
                        val failedRoot = root
                        val failure = cleanupUi(Some(error)) { failedRoot?.close() }!!
                        if (surfaces.isClosing)
                            throw failure
                        reportRootError(window.id, failure)
                    }
                }
                None
            }
        }
    }
    private fun reportRootError(id: WindowId, error: Throwable) {
        if (closing)
            throw error
        try {
            onRootError(id, error)
        } catch (reported: Throwable) {
            val failure: Throwable? =
                if (reported === error)
                    Some(error)
                else
                    Some(ResourceUseException(error, reported))
            throw cleanupUi(failure) { close() }!!
        }
    }
    public override fun onEvent(application: ActiveApplication, event: ApplicationEvent) {
        checkThread()
        when (proxy) {
            case None -> proxy = Some(application.proxy())
            case Some(_) -> {}
        }
        callback {
            nativeDepth += 1
            try {
                surfaces.onEvent(application, event)
                when (event) {
                    case Exiting -> close()
                    else -> {}
                }
            } finally {
                nativeDepth -= 1
            }
        }
    }
    internal fun enqueue(root: UiRoot) {
        if (closing || !root.isOpen)
            return
        if (!root.pendingEnqueued) {
            root.pendingEnqueued = true
            pending.add(root)
        }
        if (!processing)
            schedule()
    }
    private fun schedule() {
        if (queued || closing || pending.size == 0L)
            return
        val mailbox =
            proxy ?: throw IllegalStateException(Some("UI updates require a running host"))
        queued = true
        if (!mailbox.post { _ -> callback { flush() } }) {
            queued = false
            throw cleanupUi(Some(IllegalStateException(Some("UI update delivery failed")))) {
                close()
            }!!
        }
    }
    private fun flush() {
        queued = false
        if (closing)
            return
        processing = true
        val work = pending.toArray()
        pending.clear()
        for (root in work)
            root.pendingEnqueued = false
        try {
            for (root in work)
                if (root.isOpen)
                    root.surface.dispatch { root.flush() }
        } finally {
            processing = false
        }
        schedule()
    }
    private fun <T> callback(block: () -> T): T {
        depth += 1
        var result: T? = None
        var failure: Throwable? = None
        try {
            result = Some(block())
        }
        catch (error: Throwable) {
            failure = Some(error)
        }
        depth -= 1
        when (failure) {
            case Some(_) -> failure = cleanupUi(failure) { close() }
            case None -> {}
        }
        if (depth == 0)
            failure = cleanupUi(failure) { finishRetirement() }
        throwUi(failure)
        return result!!
    }
    internal fun retire(root: UiRoot) {
        if (nativeDepth > 0 || depth == 0)
            root.closeSurface()
        else
            pendingRetirement = true
    }
    private fun finishRetirement() {
        if (closing) {
            surfaces.close()
            pendingRetirement = false
        } else
            if (pendingRetirement) {
                pendingRetirement = false
                var failure: Throwable? = None
                for (root in roots.toArray())
                    if (!root.isOpen)
                        failure = cleanupUi(failure) { root.closeSurface() }
                when (failure) {
                    case Some(_) -> failure = cleanupUi(failure) { close() }
                    case None -> {}
                }
                throwUi(failure)
            }
    }
    internal fun detached(root: UiRoot) {
        removeRoot(roots, root)
        removeRoot(pending, root)
        root.pendingEnqueued = false
    }
    public override fun close() {
        checkThread()
        if (closing)
            return
        closing = true
        var failure = cleanupUi(None) { hostShortcuts?.close() }
        hostShortcuts = None
        queued = false
        pending.clear()
        for (root in roots.toArray()) {
            root.pendingEnqueued = false
            failure = cleanupUi(failure) { root.stop() }
        }
        if (nativeDepth > 0 || depth == 0)
            failure = cleanupUi(failure) { surfaces.close() }
        else
            pendingRetirement = true
        throwUi(failure)
    }
}

private fun removeRoot(values: ArrayList<UiRoot>, root: UiRoot) {
    var index = 0L
    while (index < values.size) {
        if (values[index] === root) {
            values.removeAt(index)
            return
        }
        index += 1L
    }
}

/** A single-window entry point with the same explicit root ownership as UiHost.use. */
public fun <C: Component> runUiApplication(
    title: String,
    create: (ComponentScope) -> C,
    fonts: FontCollection? = None
) {
    val application =
        Application(applicationOptions { this.lastWindowPolicy = LastWindowPolicy.Exit })
    UiHost(onRootError = { _, error -> throw error }) {
        host,
        active,
        event -> when (event) {
            case Resumed -> host.attach(
                active.createWindow(windowAttributes { this.title = title }),
                create,
                fonts
            )
            case Window(id, WindowEvent.CloseRequested) -> active.requestExit()
            else -> {}
        }
    }.use { host -> application.run(host) }
}
