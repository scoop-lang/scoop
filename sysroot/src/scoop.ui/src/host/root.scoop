package scoop.ui

import scoop.graphics.Point
import scoop.graphics.Color
import scoop.surface.*
import scoop.window.Window

private class SceneCompletion(val node: MountedNode, val action: (FrameCompletion) -> Unit)

/** Owns one root; closing it leaves the caller's native window intact. */
public class UiWindow internal constructor(private val root: UiRoot): Closeable {
    public val nativeWindow: Window get() = root.window
    public val isClosed: Boolean get() {
        root.checkThread();
        return root.closed
    }
    public override fun close() {
        root.requestClose()
    }
}

internal class UiRoot(
    val host: UiHost,
    val window: Window,
    private val initial: View
): SurfaceContent {
    private var attached: SurfaceWindow? = None
    internal var node: MountedNode? = None
    val focus = FocusController(this)
    val overlays = OverlayController(this)
    private val pending = ArrayList<MountedNode>()
    private val completions = ArrayList<SceneCompletion>()
    var pendingEnqueued = false
    var isOpen = true
    var closed = false
    val surface: SurfaceWindow get() =
        attached ?: throw IllegalStateException(Some("UI root is not attached"))

    fun checkThread() {
        host.checkThread()
    }
    fun requestFrame() {
        if (isOpen && surface.state == SurfaceWindowState.Open)
            surface.requestFrame()
    }
    fun mount(value: SurfaceWindow) {
        attached = Some(value)
        val current = createNode(this, None, initial)
        node = Some(current)
        focus.start()
        overlays.start()
        current.rebuild(UpdateTurn())
        current.mountPending()
    }
    fun enqueue(value: MountedNode) {
        pending.add(value)
        host.enqueue(this)
    }
    fun flush() {
        if (!isOpen)
            return
        val turn = UpdateTurn()
        val work = pending.toArray()
        pending.clear()
        var repaint = false
        for (value in work) {
            value.queued = false
            value.scheduled = Some(turn)
            if (value.active && value.frameEnabled)
                repaint = true
        }
        for (value in work) {
            if (
                value.active &&
                    isOpen &&
                    !sameTurn(value.updated, turn) &&
                    !value.hasScheduledAncestor(turn)
            ) {
                value.rebuild(turn)
                value.mountPending()
            }
        }
        if (isOpen && repaint)
            requestFrame()
    }
    public override fun paint(frame: FrameContext) {
        if (!isOpen)
            return
        val current = node ?: throw IllegalStateException(Some("UI root has not mounted"))
        frame.canvas.clear(Color.Transparent)
        focus.beginFrame()
        overlays.beginFrame()
        try {
            current.measure(Constraints.tight(frame.size), frame.time)
        } catch (error: UiLayoutEnded) {
            if (isOpen)
                throw error
            return
        }
        current.scene(frame, Point(0.0, 0.0))
        overlays.paint(frame)
    }
    fun addCompletion(node: MountedNode, action: (FrameCompletion) -> Unit) {
        completions.add(SceneCompletion(node, action))
    }
    public override fun onFrameComplete(frame: FrameCompletion) {
        if (isOpen)
            focus.publishScene(frame)
        if (isOpen)
            overlays.complete(frame)
        if (isOpen)
            focus.complete(frame)
        val work = completions.toArray()
        completions.clear()
        for (completion in work) {
            if (isOpen && completion.node.active)
                completion.action(frame)
        }
    }
    fun stop() {
        if (!isOpen)
            return
        isOpen = false
        pending.clear()
        completions.clear()
        var failure: Throwable? = None
        failure = cleanupUi(failure) { focus.close() }
        failure = cleanupUi(failure) { node?.deactivate() }
        failure = cleanupUi(failure) { overlays.close() }
        throwUi(failure)
    }
    fun requestClose() {
        checkThread()
        if (!isOpen)
            return
        stop()
        host.retire(this)
    }
    fun closeSurface() {
        when (attached) {
            case Some(value) -> value.close()
            case None -> close()
        }
    }
    public override fun close() {
        checkThread()
        if (closed)
            return
        stop()
        closed = true
        val current = node
        node = None
        var failure: Throwable? = None
        when (current) {
            case Some(value) -> failure = cleanupUi(failure) { value.unmount() }
            case None -> {}
        }
        host.detached(this)
        throwUi(failure)
    }
}
