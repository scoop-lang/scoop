package scoop.ui

import scoop.collections.sortedBy
import scoop.graphics.Point
import scoop.graphics.Color
import scoop.graphics.text.FontCollection
import scoop.surface.*
import scoop.window.Window
import scoop.window.WindowState

private class SceneCompletion(val node: MountedNode, val action: (FrameCompletion) -> Unit)

/** Owns one root; closing it leaves the caller's native window intact. */
public class UiWindow internal constructor(internal val root: UiRoot): Closeable {
    public val nativeWindow: Window get() = root.window
    public var defaultFonts: FontCollection
    get() {
        checkOpen();
        return root.fonts.value
    }
    set(value) {
        checkOpen()
        root.fonts.replace(value)
        root.requestFrame()
    }
    private fun checkOpen() {
        root.checkThread()
        if (!root.isOpen)
            throw IllegalStateException(Some("UI root is closed"))
    }
    public val isClosed: Boolean get() {
        root.checkThread();
        return root.closed
    }
    public override fun close() {
        root.requestClose()
    }
}

internal class UiRoot(
    val host: UiHost,
    val window: Window,
    private val initial: View,
    defaultFonts: FontCollection? = None
): SurfaceContent, UiUpdateRoot {
    private var attached: SurfaceWindow? = None
    internal var node: MountedNode? = None
    val layouts = LayoutStore()
    val frameDependencies = FrameDependencies()
    val focus = FocusController(this)
    val overlays = OverlayController(this)
    var windowFrame: UiWindowFrameClaim? = None
    private val pending = ArrayList<MountedNode>()
    private val completions = ArrayList<SceneCompletion>()
    override var pendingEnqueued = false
    override var isOpen = true
    var closed = false
    val surface: SurfaceWindow get() =
        attached ?: throw IllegalStateException(Some("UI root is not attached"))

    val fonts = RootFonts(defaultFonts)

    fun checkThread() {
        host.checkThread()
    }
    fun requestFrame() {
        if (isOpen && surface.state == SurfaceWindowState.Open)
            surface.requestFrame()
    }
    fun mount(value: SurfaceWindow) {
        attached = Some(value)
        val current = createNode(this, None, initial)
        node = Some(current)
        focus.start()
        overlays.start()
        current.rebuild(UpdateTurn())
        current.mountPending()
    }
    fun enqueue(value: MountedNode) {
        if (
            !isOpen ||
                surface.state !=
                SurfaceWindowState.Open ||
                window.state ==
                WindowState.Closing ||
                window.state ==
                WindowState.Destroyed
        )
            return
        pending.add(value)
        host.enqueue(this)
    }
    fun flush() {
        if (!isOpen)
            return
        val turn = UpdateTurn()
        val work = pending.toArray().sortedBy<MountedNode, Long> { value -> value.depth }
        pending.clear()
        for (value in work) {
            value.queued = false
        }
        for (value in work) {
            if (value.active && isOpen && !sameTurn(value.updated, turn)) {
                value.rebuild(turn)
                value.mountPending()
            }
        }
    }
    override fun dispatchUpdate() {
        surface.dispatch { flush() }
    }
    public override fun paint(frame: FrameContext) {
        if (!isOpen)
            return
        val current = node ?: throw IllegalStateException(Some("UI root has not mounted"))
        frame.canvas.clear(Color.Transparent)
        focus.beginFrame()
        overlays.beginFrame()
        frameDependencies.check(frame.time)
        layouts.begin()
        var success = false
        var failure: Throwable? = None
        try {
            val result = current.measure(Constraints.tight(frame.size), frame.time)
            result.finishMeasurement()
            result.scene(frame, Point(0.0, 0.0))
            overlays.paint(frame)
            success = true
        } catch (error: Throwable) {
            if (!(error is UiLayoutEnded) || isOpen)
                failure = Some(error)
        }
        val completed = success
        failure = cleanupUi(failure) { layouts.finish(completed) }
        throwUi(failure)
    }

    fun addCompletion(node: MountedNode, action: (FrameCompletion) -> Unit) {
        completions.add(SceneCompletion(node, action))
    }
    public override fun onFrameComplete(frame: FrameCompletion) {
        if (isOpen)
            focus.publishScene(frame)
        if (isOpen)
            overlays.complete(frame)
        if (isOpen)
            focus.complete(frame)
        val work = completions.toArray()
        completions.clear()
        for (completion in work) {
            if (isOpen && completion.node.active)
                completion.action(frame)
        }
    }
    fun stop() {
        if (!isOpen)
            return
        isOpen = false
        pending.clear()
        completions.clear()
        prepareUi {
            var failure: Throwable? = None
            failure = cleanupUi(failure) { focus.close() }
            failure = cleanupUi(failure) { node?.deactivate() }
            failure = cleanupUi(failure) { overlays.stop() }
            throwUi(failure)
        }
    }
    fun requestClose() {
        checkThread()
        if (!isOpen)
            return
        surface.dispatch {
            stop()
            host.retire(this)
        }
    }
    fun closeSurface() {
        when (attached) {
            case Some(val value) -> value.close()
            case None -> close()
        }
    }
    public override fun close() {
        checkThread()
        if (closed)
            return
        var failure = cleanupUi(None) { stop() }
        closed = true
        val current = node
        node = None
        when (current) {
            case Some(val value) -> failure = cleanupUi(failure) { value.unmount() }
            case None -> {}
        }
        failure = cleanupUi(failure) { layouts.close() }
        failure = cleanupUi(failure) { frameDependencies.close() }
        failure = cleanupUi(failure) { overlays.close() }
        failure = cleanupUi(failure) { fonts.close() }
        host.detached(this)
        throwUi(failure)
    }
}
