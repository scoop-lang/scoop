package scoop.ui

import scoop.window.*

internal class ScopedNativeEvents(
    internal val host: UiHost,
    private val resources: ScopeResources,
    internal val checkMounted: () -> Unit,
    internal val dispatch: (() -> Unit) -> Boolean
) {
    internal fun <E> own(registration: UiEventRegistration<E>): UiEventRegistration<E> {
        resources.managed.add(registration)
        registration.afterClose = Some { resources.forget(registration) }
        return registration
    }
    fun window(window: Window, action: (WindowEvent) -> Unit): Closeable {
        checkMounted()
        return own(
            host.windowEvents.subscribe(window.id, false) {
                value -> dispatch { action(value) }
            }
        )
    }
}
