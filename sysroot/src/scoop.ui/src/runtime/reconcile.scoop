package scoop.ui

internal fun MountedNode.reconcile(descriptions: Array<View>, turn: UpdateTurn) {
    val previous = children
    val plan =
        matchSiblings(
            previous,
            descriptions,
            { it.view.key },
            { it.key },
            { child, description -> child.active && child.view.sameType(description) }
        )
    val used = plan.used
    // Remove every stale interaction before running any unmount callback.
    var index = 0L
    for (child in previous) {
        if (!used[index])
            child.deactivate()
        index += 1L
    }
    var failure: Throwable? = None
    index = 0L
    for (child in previous) {
        if (!used[index])
            failure = cleanupUi(failure) { child.unmount() }
        index += 1L
    }
    throwUi(failure)
    if (!root.isOpen)
        return

    val next = ArrayList<MountedNode>()
    val created = ArrayList<MountedNode>()
    try {
        var position = 0L
        for (match in plan.positions) {
            val child =
                when (match) {
                    case Some(val value) -> previous[value]
                    case None -> {
                        val value = createNode(root, Some(this), descriptions[position])
                        created.add(value)
                        value
                    }
                }
            next.add(child)
            position += 1L
        }
    } catch (error: Throwable) {
        var cleanup: Throwable? = Some(error)
        for (child in created)
            cleanup = cleanupUi(cleanup) { child.unmount() }
        throwUi(cleanup)
    }
    // All surviving and newly allocated nodes remain reachable if a callback fails.
    children = next.toArray()
    var changed = previous.size != children.size
    if (!changed)
        for (position in 0L ..< children.size)
            if (previous[position] !== children[position])
                changed = true
    if (changed)
        request(UiInvalidation.Layout)
    index = 0L
    for (child in children) {
        child.replace(descriptions[index])
        child.rebuild(turn)
        index += 1L
    }
}
