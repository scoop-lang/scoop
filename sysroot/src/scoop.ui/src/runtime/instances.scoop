package scoop.ui

internal fun createNode(root: UiRoot, parent: MountedNode?, view: View): MountedNode =
    MountedNode(root, parent, view)

/** All scope fields are initialized before a factory can acquire resources on this node. */
internal fun createBody(node: MountedNode, view: View): NodeBody {
    try {
        return when (view.body) {
            case Empty -> NodeBody.Empty
            case Direction(_, _) -> NodeBody.Direction
            case Component(val description) -> NodeBody.Component(description.create(node.scope))
            case Element(val description, _) -> NodeBody.Element(description.create(node.scope))
            case Portal(_, val open, val options) -> NodeBody.Portal(
                PortalInstance(node.root, open, options)
            )
            case Lazy(val description, _, _) -> NodeBody.Lazy(
                description.create(node.scope),
                node.lazyItems!!
            )
        }
    } catch (error: Throwable) {
        node.active = false
        var failure: Throwable? = Some(error)
        failure = cleanupUi(failure) { node.scope.deactivate() }
        failure = cleanupUi(failure) { throwUi(node.scope.retireInteraction()) }
        failure = cleanupUi(failure) { throwUi(node.scope.release()) }
        throw failure!!
    }
}

internal fun releaseInstance(body: NodeBody) {
    when (body) {
        case Portal(val instance) -> instance.dispose()
        else -> {}
    }
}
