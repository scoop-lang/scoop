package scoop.ui

import scoop.collections.HashMap

internal enum NodeBody {
    Empty, Component(ComponentInstance), Element(ElementInstance), Portal(PortalInstance),
    Lazy(LazyInstance, LazyChildren), Direction
}

internal class UpdateTurn

internal class MountedNode(
    val root: UiRoot,
    val parent: MountedNode?,
    var view: View
): StateInvalidationTarget {
    val depth: Long = (parent?.depth ?: -1L) + 1L
    var layoutDirection: LayoutDirection =
        view.directionOverride ?: parent?.layoutDirection ?: LayoutDirection.Ltr
    val scope = ComponentScope(this)
    val paintLayers = PaintLayers()
    val focusTargets = ArrayList<FocusTarget>()
    var focusScope: FocusScope? = None
    var navigation: KeyNavigation? = None
    var lazyFocus: LazyFocus? = None
    var children: Array<MountedNode> = []
    var active = true
    var mounted = false
    var retired = false
    var queued = false
    var updated: UpdateTurn? = None
    val dependencies = HashMap<StateSignalId, StateSubscription>()
    var inputChanged = true
    var stateDirty = false
    var layoutVersion = 0L
    var sceneVersion = 0L
    val frameInputs = NodeFrameInputs(this)
    var layoutRound: LayoutRound? = None
    var currentLayout: NodeLayout? = None
    val layoutRequests = ArrayList<NodeLayout>()
    private var framesAllowed = true
    val localFrameEnabled: Boolean get() = framesAllowed
    private var participates = true
    val participatesInFrame: Boolean get() = participates
    var frameEnabled: Boolean = parent?.frameEnabled ?: true

    val lazyItems: LazyChildren? =
        when (view.body) {
            case Lazy(_, val source, val capacity) -> Some(LazyChildren(source, capacity))
            else -> None
        }
    val body: NodeBody = createBody(this, view)

    fun setFrameEnabled(value: Boolean) {
        if (framesAllowed == value)
            return
        framesAllowed = value
        invalidateScene()
        inheritFrameParticipation(parent?.frameEnabled ?: true)
    }
    fun setFrameParticipation(value: Boolean) {
        participates = value
        inheritFrameParticipation(parent?.frameEnabled ?: true)
    }
    private fun inheritFrameParticipation(parentEnabled: Boolean) {
        val next = framesAllowed && participates && parentEnabled
        if (next == frameEnabled)
            return
        frameEnabled = next
        sceneVersion += 1L
        if (!next)
            paintLayers.close()
        scope.updateFrameParticipation()
        for (child in children)
            child.inheritFrameParticipation(next)
    }

    fun clearPaintSubtree() {
        when (currentLayout) {
            case Some(val value) -> value.sceneCache = None
            case None -> {}
        }
        var failure: Throwable? = None
        failure = cleanupUi(failure) { paintLayers.close() }
        for (child in children)
            failure = cleanupUi(failure) { child.clearPaintSubtree() }
        throwUi(failure)
    }

    fun invalidateLayout() {
        layoutVersion += 1L
        sceneVersion += 1L
        if (mounted)
            parent?.invalidateLayout()
    }

    fun invalidateScene() {
        sceneVersion += 1L
        if (mounted)
            parent?.invalidateScene()
    }

    fun request(value: UiInvalidation) {
        when (value) {
            case None -> return
            case Scene -> invalidateScene()
            case Layout -> invalidateLayout()
        }
        if (active && root.isOpen && frameEnabled)
            root.requestFrame()
    }

    fun invalidate() {
        if (active && root.isOpen) {
            stateDirty = true
            if (!queued) {
                queued = true
                root.enqueue(this)
            }
        }
    }
    override fun stateChanged(invalidation: UiInvalidation) {
        request(invalidation)
        invalidate()
    }
    fun replace(next: View) {
        when ((body, next.body)) {
            case(Empty, Empty) -> {}
            case(Direction, Direction(_, _)) -> {}
            case(Component(val instance), Component(val description)) -> {
                if (!instance.replace(description))
                    inputChanged = true
            }
            case(Element(val instance), Element(val description, _)) -> {
                if (!instance.replace(description))
                    inputChanged = true
            }
            case(Portal(val instance), Portal(_, val open, val options)) -> instance.replace(
                open,
                options
            )
            case(Lazy(val instance, _), Lazy(val description, _, _)) -> {
                if (!instance.replace(description))
                    inputChanged = true
            }
            else -> throw IllegalStateException(Some("mismatched mounted view shape"))
        }
        view = next
    }
    fun rebuild(turn: UpdateTurn) {
        if (!active || !root.isOpen)
            return
        updated = Some(turn)
        val previousDirection = layoutDirection
        layoutDirection = view.directionOverride ?: parent?.layoutDirection ?: LayoutDirection.Ltr
        val shouldUpdate = inputChanged || stateDirty || layoutDirection != previousDirection
        inputChanged = false
        stateDirty = false
        if (layoutDirection != previousDirection)
            request(UiInvalidation.Layout)
        when (body) {
            case Empty -> {}
            case Direction -> when (view.body) {
                case Direction(val content, _) -> {
                    if (children.size == 1L && children[0L].view === content)
                        children[0L].refreshDirection(turn)
                    else
                        reconcile([content], turn)
                }
                else -> throw IllegalStateException(
                    Some("direction description was replaced by another shape")
                )
            }
            case Portal(val instance) -> when (view.body) {
                case Portal(val content, _, _) -> instance.prepare(this, content, turn)
                else -> throw IllegalStateException(
                    Some("portal description was replaced by another shape")
                )
            }
            case Component(val instance) -> if (shouldUpdate)
                rebuildComponent(instance, turn, false)
            case Element(val instance) -> {
                when (view.body) {
                    case Element(_, val descriptions) -> reconcile(descriptions, turn)
                    else -> throw IllegalStateException(
                        Some("element description was replaced by another shape")
                    )
                }
                if (shouldUpdate && active && root.isOpen && mounted)
                    request(updateInputs { instance.update() })
            }
            case Lazy(val instance, val items) -> {
                when (view.body) {
                    case Lazy(_, val source, val capacity) -> items.replace(
                        this,
                        source,
                        capacity,
                        turn
                    )
                    else -> throw IllegalStateException(
                        Some("lazy description was replaced by another shape")
                    )
                }
                if (layoutDirection != previousDirection)
                    for (child in children)
                        child.refreshDirection(turn)
                if (shouldUpdate && active && root.isOpen && mounted)
                    request(updateInputs { instance.update() })
            }
        }
    }
    fun mountPending() {
        if (!active || !root.isOpen)
            return
        if (!mounted) {
            when (body) {
                case Empty -> {}
                case Direction -> {}
                case Component(val instance) -> instance.value.onMount()
                case Element(val instance) -> instance.onMount()
                case Portal(val instance) -> instance.mount(this)
                case Lazy(val instance, _) -> instance.onMount()
            }
            mounted = true
            if (active && root.isOpen) {
                when (body) {
                    case Element(val instance) -> {
                        updateInputs { instance.update() }
                    }
                    case Lazy(val instance, val items) -> {
                        items.mount(this)
                        updateInputs { instance.update() }
                    }
                    else -> {}
                }
            }
        }
        for (child in children)
            child.mountPending()
    }
    fun deactivate() {
        if (!active)
            return
        active = false
        queued = false
        var failure: Throwable? = None
        failure =
            cleanupUi(failure) {
                when (body) {
                    case Portal(val instance) -> instance.retireInput()
                    else -> {}
                }
            }
        failure = cleanupUi(failure) { scope.deactivate() }
        failure = cleanupUi(failure) { frameInputs.close() }
        for (subscription in dependencies.values)
            subscription.close()
        dependencies.clear()
        for (child in children)
            failure = cleanupUi(failure) { child.deactivate() }
        throwUi(failure)
    }
    fun unmount() {
        if (retired)
            return
        retired = true
        deactivate()
        var failure: Throwable? = None
        for (child in children)
            failure = cleanupUi(failure) { child.unmount() }
        children = []
        failure = cleanupUi(failure) { throwUi(scope.retireInteraction()) }
        if (mounted) {
            failure =
                cleanupUi(failure) {
                    when (body) {
                        case Empty -> {}
                        case Direction -> {}
                        case Component(val instance) -> instance.value.onUnmount()
                        case Element(val instance) -> instance.onUnmount()
                        case Portal(_) -> {}
                        case Lazy(val instance, _) -> instance.onUnmount()
                    }
                }
        }
        failure = cleanupUi(failure) { throwUi(scope.release()) }
        failure = cleanupUi(failure) { paintLayers.close() }
        failure = cleanupUi(failure) { releaseInstance(body) }
        failure = cleanupUi(failure) { currentLayout?.close() }
        currentLayout = None
        for (result in layoutRequests)
            failure = cleanupUi(failure) { result.close() }
        layoutRequests.clear()
        throwUi(failure)
    }
}

internal fun sameTurn(previous: UpdateTurn?, current: UpdateTurn): Boolean =
    when (previous) {
        case Some(val value) -> value === current
        case None -> false
    }
