package scoop.ui

import scoop.graphics.text.TextDirection

public enum LayoutDirection {
    Ltr, Rtl
}

/** Layout inheritance is independent from a paragraph's explicit bidi direction. */
public fun LayoutDirection.textDirection(): TextDirection =
    if (this == LayoutDirection.Rtl)
        TextDirection.Rtl
    else
        TextDirection.Ltr

public fun direction(content: View, value: LayoutDirection, key: ViewKey = ViewKey.Position): View =
    View(key, ViewBody.Direction(content, value))

internal val View.directionOverride: LayoutDirection? get() =
    when (body) {
        case Direction(_, val value) -> Some(value)
        else -> None
    }

/** Only a direction change reaches this path; ordinary Props still use reconciliation. */
internal fun MountedNode.refreshDirection(turn: UpdateTurn) {
    if (!active || !root.isOpen)
        return
    val next = view.directionOverride ?: parent?.layoutDirection ?: LayoutDirection.Ltr
    if (next == layoutDirection)
        return
    layoutDirection = next
    request(UiInvalidation.Layout)
    updated = Some(turn)
    inputChanged = false
    stateDirty = false
    when (body) {
        case Component(val instance) -> rebuildComponent(instance, turn, true)
        case Element(val instance) -> {
            for (child in children)
                child.refreshDirection(turn)
            if (mounted && active && root.isOpen)
                request(updateInputs { instance.update() })
        }
        case Lazy(val instance, _) -> {
            for (child in children)
                child.refreshDirection(turn)
            if (mounted && active && root.isOpen)
                request(updateInputs { instance.update() })
        }
        else -> for (child in children)
            child.refreshDirection(turn)
    }
}

internal fun MountedNode.rebuildComponent(
    instance: ComponentInstance,
    turn: UpdateTurn,
    directionOnly: Boolean
) {
    val collector = DependencyCollector()
    val next = evaluateUi(Some(collector)) { instance.value.render() }
    if (!active || !root.isOpen)
        return
    replaceDependencies(collector)
    if (directionOnly && children.size == 1L && children[0L].view === next)
        children[0L].refreshDirection(turn)
    else
        reconcile([next], turn)
}

internal fun MountedNode.replaceDependencies(collector: DependencyCollector) {
    replaceStateDependencies(this, dependencies, collector)
}

/** Only root-default font reads are observed here; update retains its ordinary mutation rules. */
internal fun MountedNode.updateInputs(action: () -> UiInvalidation): UiInvalidation {
    val collector = DependencyCollector()
    scope.fontReads = Some(collector)
    try {
        val invalidation = action()
        if (active && root.isOpen)
            replaceDependencies(collector)
        return invalidation
    } finally {
        scope.fontReads = None
    }
}
