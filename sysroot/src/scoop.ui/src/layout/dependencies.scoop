package scoop.ui

import scoop.graphics.text.FontCollection
import scoop.surface.AnimationReadObserver
import scoop.surface.AnimationSource
import scoop.time.TimeMark

internal class AnimationRead(val source: AnimationSource, val revision: Long)

internal class DefaultFontRead(val source: RootFonts, val revision: Long)

internal class FontRead(val watch: FontWatch, val revision: Long)

/** Inputs of one completed layout or scene callback. */
internal class FrameInputs(
    val animations: Array<AnimationRead> = [],
    val fonts: Array<FontRead> = [],
    val time: TimeMark? = None,
    val scrolls: Array<ScrollViewport> = [],
    val defaults: Array<DefaultFontRead> = []
) {
    val dynamic: Boolean get() = animations.size > 0L || time != None || defaults.size > 0L
    val perFrame: Boolean get() = animations.size > 0L || time != None
    fun changed(mark: TimeMark): Boolean {
        if (frameChanged(mark))
            return true
        for (read in fonts)
            if (read.watch.revision != read.revision)
                return true
        return false
    }
    fun frameChanged(mark: TimeMark): Boolean {
        if (time != None && time != Some(mark))
            return true
        for (read in animations)
            if (read.source.revision != read.revision)
                return true
        for (read in defaults)
            if (read.source.revision != read.revision)
                return true
        return false
    }
    fun uses(watch: FontWatch): Boolean {
        for (font in fonts)
            if (font.watch === watch)
                return true
        return false
    }
}

internal class FrameReads(
    private val node: MountedNode,
    private val mark: TimeMark
): AnimationReadObserver {
    private val animations = ArrayList<AnimationRead>()
    private val fonts = ArrayList<FontRead>()
    private val scrolls = ArrayList<ScrollViewport>()
    private val defaults = ArrayList<DefaultFontRead>()
    private var time = false
    public override fun read(source: AnimationSource) {
        for (previous in animations)
            if (previous.source === source)
                return
        animations.add(AnimationRead(source, source.revision))
    }
    fun readDefaults(source: RootFonts) {
        for (previous in defaults)
            if (previous.source === source)
                return
        defaults.add(DefaultFontRead(source, source.revision))
    }
    fun readTime() {
        time = true
    }
    fun readScroll(value: ScrollViewport) {
        for (previous in scrolls)
            if (previous === value)
                return
        scrolls.add(value)
    }
    fun readFonts(value: FontCollection) {
        val watch = node.root.frameDependencies.fonts(value)
        for (previous in fonts)
            if (previous.watch === watch)
                return
        fonts.add(FontRead(watch, watch.revision))
    }
    /** A reused drawing keeps the reads collected when its commands were recorded. */
    fun include(value: FrameInputs) {
        for (read in value.animations)
            this.read(read.source)
        for (read in value.defaults)
            readDefaults(read.source)
        for (read in value.fonts) {
            var found = false
            for (previous in fonts)
                if (previous.watch === read.watch)
                    found = true
            if (!found)
                fonts.add(read)
        }
        for (scroll in value.scrolls)
            readScroll(scroll)
        if (value.time != None)
            readTime()
    }
    fun finish(): FrameInputs =
        FrameInputs(
            animations.toArray(),
            fonts.toArray(),
            if (time)
                Some(mark)
            else
                None,
            scrolls.toArray(),
            defaults.toArray()
        )
}

internal object IgnoreAnimationReads: AnimationReadObserver {
    public override fun read(source: AnimationSource) {}
}

internal fun observeFrameTime() {
    val evaluation = currentEvaluation() ?: return
    evaluation.frameReads?.readTime()
}

internal fun observeFonts(fonts: FontCollection) {
    val evaluation = currentEvaluation() ?: return
    evaluation.frameReads?.readFonts(fonts)
}

internal fun observeScroll(viewport: ScrollViewport) {
    val evaluation = currentEvaluation() ?: return
    evaluation.frameReads?.readScroll(viewport)
}

/** One registration per node and shared font, removed without searching other readers. */
internal class FontBinding(val owner: NodeFrameInputs, val watch: FontWatch, var layout: Boolean) {
    var index = -1L
    fun close() {
        if (index < 0L)
            return
        val last = watch.readers.removeAt(watch.readers.size - 1L)
        if (last !== this) {
            watch.readers[index] = last
            last.index = index
        }
        index = -1L
        if (watch.readers.size == 0L)
            watch.close()
    }
}

internal class FontWatch(val fonts: FontCollection) {
    val revision: Long get() = fonts.revision
    val readers = ArrayList<FontBinding>()
    private var subscription: Closeable? = None
    fun bind(owner: NodeFrameInputs, layout: Boolean): FontBinding {
        if (readers.size == 0L)
            subscription = Some(fonts.observeChanges { _ -> changed() })
        val value = FontBinding(owner, this, layout)
        value.index = readers.size
        readers.add(value)
        return value
    }
    private fun changed() {
        for (reader in readers) {
            reader.owner.node.request(
                if (reader.layout)
                    UiInvalidation.Layout
                else
                    UiInvalidation.Scene
            )
        }
    }
    fun close() {
        subscription?.close()
        subscription = None
    }
}

internal class NodeFrameInputs(val node: MountedNode) {
    var dynamicIndex = -1L
    private var layout = FrameInputs()
    private var scene = FrameInputs()
    private val fonts = ArrayList<FontBinding>()
    fun setLayout(value: FrameInputs) {
        layout = value
        refresh()
    }
    fun setScene(value: FrameInputs) {
        scene = value
        refresh()
    }
    fun usesLayout(viewport: ScrollViewport): Boolean {
        for (scroll in layout.scrolls)
            if (scroll === viewport)
                return true
        return false
    }
    private fun refresh() {
        node.root.frameDependencies.dynamic(this, layout.dynamic || scene.dynamic)
        var index = 0L
        while (index < fonts.size) {
            val binding = fonts[index]
            if (!layout.uses(binding.watch) && !scene.uses(binding.watch)) {
                binding.close()
                fonts.removeAt(index)
            } else {
                binding.layout = layout.uses(binding.watch)
                index += 1L
            }
        }
        for (read in layout.fonts)
            bind(read.watch, true)
        for (read in scene.fonts)
            bind(read.watch, layout.uses(read.watch))
    }
    private fun bind(watch: FontWatch, affectsLayout: Boolean) {
        for (binding in fonts)
            if (binding.watch === watch)
                return
        fonts.add(watch.bind(this, affectsLayout))
    }
    fun check(time: TimeMark) {
        if (!node.active)
            return
        if (layout.frameChanged(time))
            node.invalidateLayout()
        else
            if (scene.frameChanged(time))
                node.invalidateScene()
    }
    fun close() {
        node.root.frameDependencies.dynamic(this, false)
        for (binding in fonts)
            binding.close()
        fonts.clear()
        layout = FrameInputs()
        scene = FrameInputs()
    }
}

/** Fonts notify their readers; only time-based inputs are checked at requested frames. */
internal class FrameDependencies {
    private val animated = ArrayList<NodeFrameInputs>()
    private var collections = ArrayList<FontWatch>()
    fun fonts(value: FontCollection): FontWatch {
        for (watch in collections)
            if (watch.fonts === value)
                return watch
        val watch = FontWatch(value)
        collections.add(watch)
        return watch
    }
    fun dynamic(value: NodeFrameInputs, enabled: Boolean) {
        if (enabled) {
            if (value.dynamicIndex < 0L) {
                value.dynamicIndex = animated.size
                animated.add(value)
            }
        } else
            if (value.dynamicIndex >= 0L) {
                val last = animated.removeAt(animated.size - 1L)
                if (last !== value) {
                    animated[value.dynamicIndex] = last
                    last.dynamicIndex = value.dynamicIndex
                }
                value.dynamicIndex = -1L
            }
    }
    fun check(time: TimeMark) {
        val retained = ArrayList<FontWatch>()
        for (watch in collections) {
            if (watch.readers.size > 0L) {
                retained.add(watch)
            }
        }
        collections = retained
        for (value in animated)
            value.check(time)
    }
    fun close() {
        animated.clear()
        for (watch in collections)
            watch.close()
        collections.clear()
    }
}
