package scoop.ui

import scoop.graphics.*
import scoop.surface.FrameContext
import scoop.surface.FrameSubmission

internal fun NodeLayout.scene(
    frame: FrameContext,
    origin: Point,
    overlay: OverlayLayout? = None,
    scrollPath: Array<ScrollReveal> = [],
    paintCache: PaintCachePolicy = PaintCachePolicy.None,
    epochs: Array<SceneEpoch> = []
) {
    if (!node.active || !node.root.isOpen)
        return
    when (node.semanticItem) {
        case Some(val row) -> {
            frame.withState {
                local ->
                local.canvas.translate(origin.x, origin.y)
                row.controller.capture(
                    row,
                    local.canvas,
                    Rect(0.0, 0.0, metrics.size.width, metrics.size.height),
                    scrollPath
                )
            }
        }
        case None -> {}
    }
    when (body) {
        case Empty -> {}
        case Transparent -> children[0L].result!!.scene(
            frame,
            origin,
            overlay,
            scrollPath,
            paintCache,
            epochs
        )
        case Portal(val instance) -> node.root.overlays.include(instance)
        case Element(val value) -> sceneElement(
            frame,
            origin,
            overlay,
            scrollPath,
            paintCache,
            epochs,
            value
        )
        case Lazy(val value, _) -> sceneElement(
            frame,
            origin,
            overlay,
            scrollPath,
            paintCache,
            epochs,
            value
        )
    }
}

internal fun NodeLayout.presentChild(
    index: Long,
    frame: FrameContext,
    overlay: OverlayLayout?,
    scrollPath: Array<ScrollReveal>,
    paintCache: PaintCachePolicy,
    epochs: Array<SceneEpoch>
) {
    val child = children[index]
    val placed = child.origin != None
    if (child.node.participatesInFrame != placed)
        node
            .root
            .addCompletion(child.node) { completion ->
                if (completion.submission == FrameSubmission.Accepted)
                    child.node.setFrameParticipation(placed)
            }
    when (child.origin) {
        case Some(val origin) ->
            child.result!!.scene(frame, origin, overlay, scrollPath, paintCache, epochs)
        case None -> child.node.clearPaintSubtree()
    }
}

internal fun NodeLayout.presentChildren(
    frame: FrameContext,
    overlay: OverlayLayout?,
    scrollPath: Array<ScrollReveal>,
    paintCache: PaintCachePolicy,
    epochs: Array<SceneEpoch>,
    order: Array<Long>?
) {
    when (order) {
        case Some(val value) ->
            for (index in value)
                presentChild(index, frame, overlay, scrollPath, paintCache, epochs)
        case None ->
            for (index in 0L..<children.size)
                presentChild(index, frame, overlay, scrollPath, paintCache, epochs)
    }
}

private fun NodeLayout.sceneElement(
    frame: FrameContext,
    origin: Point,
    overlay: OverlayLayout?,
    scrollPath: Array<ScrollReveal>,
    paintCache: PaintCachePolicy,
    epochs: Array<SceneEpoch>,
    value: ElementLayout
) {
    frame
        .withState<Unit> { childFrame ->
            childFrame.canvas.translate(origin.x, origin.y)
            when (sceneCache) {
                case Some(val previous) ->
                    if (epochs.size >
                        0L &&
                        previous.matches(node, epochs, childFrame.canvas, frame.time)
                    ) {
                        previous.replay(this, childFrame, overlay, scrollPath, paintCache)
                        return@withState Unit
                    }
                case None -> {}
            }
            val recorder = if (epochs.size > 0L) Some(SceneRecorder()) else None
            val pass = ScenePass()
            val context = SceneContext(
                node,
                childFrame,
                this,
                overlay,
                pass,
                scrollPath = scrollPath,
                paintCache = paintCache,
                epochs = epochs,
                recorder = recorder
            )
            try {
                sceneCache = None
                val version = node.sceneVersion
                val reads = FrameReads(node, frame.time)
                evaluateUi<Unit>(None, Some(reads)) { value.scene(context) }
                if (node.active && node.root.isOpen) {
                    context.finish()
                    val inputs = reads.finish()
                    node.frameInputs.setScene(inputs)
                    when (recorder) {
                        case Some(val commands) ->
                            if (pass.cacheable && !inputs.perFrame)
                                sceneCache = Some(
                                    CachedScene(
                                        version,
                                        epochs,
                                        commands.finish(),
                                        pass.layers.toArray(),
                                        pass.paintKeys,
                                        pass.presentedChildren
                                    )
                                )
                        case None -> {}
                    }
                }
                Unit
            } finally {
                context.end()
            }
        }
}
