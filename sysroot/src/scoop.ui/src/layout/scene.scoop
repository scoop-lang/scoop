package scoop.ui

import scoop.graphics.*
import scoop.surface.FrameContext
import scoop.surface.FrameCompletion
import scoop.surface.FrameSubmission
import scoop.surface.InputArea
import scoop.surface.WindowRegionHandle
import scoop.time.TimeMark

internal class ScenePass {
    var presentedChildren = false
    var cacheable = true
    val paintKeys = ArrayList<PaintKey>()
    val scrolls = ArrayList<ScrollViewport>()
    val layers = ArrayList<CachedPaintLayer>()
}

/** Geometry, input and child presentation share one frame state, separate from pixel blocks. */
public class SceneContext internal constructor(
    private val node: MountedNode,
    private val frame: FrameContext,
    private val layout: NodeLayout,
    private val overlay: OverlayLayout? = None,
    private val pass: ScenePass = ScenePass(),
    private val scrollPath: Array<ScrollReveal> = [],
    private val paintCache: PaintCachePolicy = PaintCachePolicy.None,
    private val epochs: Array<SceneEpoch> = [],
    private val recorder: SceneRecorder? = None
) {
    private val extent = layout.metrics.size
    public val layoutDirection: LayoutDirection get() {
        checkActive();
        return node.layoutDirection
    }
    private var active = true
    private var borrowed = false
    public val size: Size get() {
        checkActive()
        return extent
    }
    public val time: TimeMark get() {
        checkActive()
        observeFrameTime()
        return frame.time
    }
    public val overlayLayout: OverlayLayout? get() {
        checkActive()
        pass.cacheable = false
        return overlay
    }
    internal val retainsTextDrawing: Boolean get() {
        checkActive()
        return epochs.size > 0L || paintCache != PaintCachePolicy.None
    }
    /** Captures current transform and clip without creating an input target. */
    public fun anchor(handle: LayoutAnchor, rect: Rect) {
        checkActive()
        handle.capture(node, node.root.overlays.frame, frame.canvas, rect)
        recorder?.add(SceneCommand.Anchor(handle, rect))
    }
    /** Runs after this frame ends, while this node remains mounted and its root remains open. */
    public fun onFrameComplete(action: (FrameCompletion) -> Unit) {
        checkActive()
        pass.cacheable = false
        node.root.addCompletion(node, action)
    }
    internal fun checkOwner(owner: MountedNode) {
        checkActive()
        requireUi(node === owner, "scene registration belongs to a different mount")
    }
    private fun checkActive() {
        node.root.checkThread()
        if (!active)
            throw IllegalStateException(Some("scene context has ended"))
        if (borrowed)
            throw IllegalStateException(Some("scene context has an active child scope"))
    }
    /** Runs a pixel-only block with an independent Canvas lifetime and save stack. */
    public fun draw(block: (PaintContext) -> Unit) {
        checkActive()
        pass.cacheable = false
        borrowed = true
        try {
            frame.canvas.withState {
                canvas ->
                val context = PaintContext(node.root, canvas, extent, frame.time)
                try {
                    block(context)
                } finally {
                    context.end()
                }
            }
        } finally {
            borrowed = false
        }
    }
    /** Records a finite, isolated layer; revision covers every input affecting its pixels. */
    public fun drawLayer(
        key: PaintKey,
        bounds: Rect,
        revision: Long,
        samplingOutset: Double = 1.0,
        block: (PaintContext) -> Unit
    ) {
        drawRecording(key, bounds, revision, samplingOutset, PaintComposition.Isolated, block)
    }
    internal fun drawRecording(
        key: PaintKey,
        bounds: Rect,
        revision: Long,
        samplingOutset: Double,
        composition: PaintComposition,
        block: (PaintContext) -> Unit
    ) {
        checkActive()
        usePaintKey(key)
        borrowed = true
        try {
            val reads = FrameReads(node, frame.time)
            val layer =
                node.paintLayers.draw(
                    frame.canvas,
                    key,
                    PaintLayerInput(extent, bounds, revision, samplingOutset, composition),
                    paintCache,
                    Some(frame.time),
                    Some(reads)
                ) {
                    canvas ->
                    val context = PaintContext(node.root, canvas, extent, frame.time)
                    try {
                        evaluateUi<Unit>(None, Some(reads)) { block(context) }
                    } finally {
                        context.end()
                    }
                }
            when (layer) {
                case Some(val value) -> {
                    when (currentEvaluation()) {
                        case Some(val evaluation) -> evaluation.frameReads?.include(value.inputs)
                        case None -> {}
                    }
                    pass.layers.add(value)
                    recorder?.add(SceneCommand.Drawing(value))
                }
                case None -> pass.cacheable = false
            }
        } finally {
            borrowed = false
        }
    }
    private fun usePaintKey(key: PaintKey) {
        for (previous in pass.paintKeys)
            requireUi(previous !== key, "paint key was already used in this scene")
        pass.paintKeys.add(key)
    }
    internal fun drawRetained(layer: CachedPaintLayer) {
        checkActive()
        usePaintKey(layer.key)
        borrowed = true
        try {
            layer.paint(frame.canvas, paintCache)
        } finally {
            borrowed = false
        }
    }
    /** Shares the one child presentation pass while isolating scene state. */
    public fun <T> withState(block: (SceneContext) -> T): T {
        checkActive()
        return withPath(scrollPath, paintCache, block)
    }
    internal fun presentScroll(viewport: ScrollViewport) {
        checkActive()
        pass.cacheable = false
        for (previous in pass.scrolls)
            if (previous === viewport)
                throw IllegalStateException(Some("scroll viewport was already presented"))
        pass.scrolls.add(viewport)
    }
    internal fun scrollContent(
        viewport: ScrollViewport,
        layout: ScrollLayout,
        origin: Point,
        block: (SceneContext) -> Unit
    ) {
        checkActive()
        val boundary = node.root.focus.captureScroll(viewport, layout, frame.canvas)
        val path =
            Array<ScrollReveal>(scrollPath.size + 1L) {
                index -> if (index < scrollPath.size)
                    scrollPath[index]
                else
                    boundary
            }
        withPath<Unit>(path, viewport.paintCache) {
            child ->
            val snapshot = layout.snapshot
            child.clipRect(Rect(0.0, 0.0, snapshot.viewport.width, snapshot.viewport.height))
            child.translate(origin.x - snapshot.offset.x, origin.y - snapshot.offset.y)
            block(child)
        }
    }
    private fun <T> withPath(
        path: Array<ScrollReveal>,
        policy: PaintCachePolicy,
        block: (SceneContext) -> T
    ): T {
        borrowed = true
        try {
            return frame.withState {
                childFrame ->
                val commands =
                    when (recorder) {
                        case Some(_) -> Some(SceneRecorder())
                        case None -> None
                    }
                val child =
                    SceneContext(
                        node,
                        childFrame,
                        layout,
                        overlay,
                        pass,
                        path,
                        policy,
                        epochs,
                        commands
                    )
                try {
                    val result = block(child)
                    when (commands) {
                        case Some(val value) -> recorder?.add(SceneCommand.Scope(value.finish()))
                        case None -> {}
                    }
                    result
                } catch (error: Throwable) {
                    pass.cacheable = false
                    throw error
                } finally {
                    child.end()
                }
            }
        } finally {
            borrowed = false
        }
    }
    public fun concat(transform: Transform) {
        checkActive()
        frame.canvas.concat(transform)
        recorder?.add(SceneCommand.Concat(transform))
    }
    public fun translate(x: Double, y: Double) {
        concat(Transform.translation(x, y))
    }
    public fun scale(x: Double, y: Double) {
        concat(Transform.scale(x, y))
    }
    public fun rotate(radians: Double) {
        concat(Transform.rotation(radians))
    }
    public fun clipRect(rect: Rect) {
        checkActive()
        frame.canvas.clipRect(rect)
        recorder?.add(SceneCommand.Clip(rect))
    }
    public fun clipPath(path: Path) {
        checkActive()
        pass.cacheable = false
        frame.canvas.clipPath(path)
    }
    public fun save() {
        checkActive()
        frame.canvas.save()
        recorder?.add(SceneCommand.Save)
    }
    public fun saveLayer(
        opacity: Double = 1.0,
        filter: ImageFilter? = None,
        blendMode: BlendMode = BlendMode.SrcOver
    ) {
        checkActive()
        frame.canvas.saveLayer(opacity, filter, blendMode)
        when (filter) {
            case Some(_) -> pass.cacheable = false
            case None -> recorder?.add(SceneCommand.SaveLayer(opacity, blendMode))
        }
    }
    public fun restore() {
        checkActive()
        frame.canvas.restore()
        recorder?.add(SceneCommand.Restore)
    }
    public fun place(area: InputArea, shape: Rect) {
        checkActive()
        frame.place(area, shape)
        node.root.focus.place(area, scrollPath)
        recorder?.add(SceneCommand.Place(area, shape))
    }
    public fun place(area: InputArea, shape: Path) {
        checkActive()
        pass.cacheable = false
        frame.place(area, shape)
        node.root.focus.place(area, scrollPath)
    }
    public fun place(region: WindowRegionHandle, shape: Rect) {
        checkActive()
        pass.cacheable = false
        frame.place(region, shape)
    }
    public fun place(region: WindowRegionHandle, shape: Path) {
        checkActive()
        pass.cacheable = false
        frame.place(region, shape)
    }
    public fun children() {
        presentChildren(None, None)
    }
    /** Presents a complete permutation without changing logical mount or input ownership. */
    public fun children(order: Array<Long>) {
        presentChildren(Some(order), None)
    }
    internal fun presentChildren(order: Array<Long>?, epoch: SceneEpoch?) {
        checkActive()
        if (pass.presentedChildren)
            throw IllegalStateException(Some("children were already presented"))
        when (order) {
            case Some(val value) -> {
                requireUi(
                    value.size == layout.children.size,
                    "child order must include every child"
                )
                val visited = MutableArray<Boolean>(layout.children.size) { _ -> false }
                for (index in value) {
                    requireUi(
                        index >= 0L && index < layout.children.size,
                        "child order index is out of bounds"
                    )
                    requireUi(!visited[index], "child order contains a duplicate index")
                    visited[index] = true
                }
            }
            case None -> {}
        }
        pass.presentedChildren = true
        recorder?.add(SceneCommand.Children(order, epoch))
        val childEpochs =
            when (epoch) {
                case Some(val value) -> Array<SceneEpoch>(epochs.size + 1L) {
                    index -> if (index < epochs.size)
                        epochs[index]
                    else
                        value
                }
                case None -> epochs
            }
        try {
            when (order) {
                case Some(val value) -> for (index in value)
                    presentChild(index, childEpochs)
                case None -> for (index in 0L ..< layout.children.size)
                    presentChild(index, childEpochs)
            }
        } catch (error: Throwable) {
            pass.cacheable = false
            throw error
        }
    }
    private fun presentChild(index: Long, childEpochs: Array<SceneEpoch>) {
        val child = layout.children[index]
        val placed = child.origin != None
        if (child.node.participatesInFrame != placed)
            node.root.addCompletion(child.node) {
                completion -> if (completion.submission == FrameSubmission.Accepted)
                    child.node.setFrameParticipation(placed)
            }
        when (child.origin) {
            case Some(val origin) -> child.result!!.scene(
                frame,
                origin,
                overlay,
                scrollPath,
                paintCache,
                childEpochs
            )
            case None -> child.node.clearPaintSubtree()
        }
    }
    internal fun finish() {
        if (!pass.presentedChildren) {
            for (child in layout.children)
                if (child.origin != None)
                    throw IllegalStateException(Some("placed children must be presented"))
            for (index in 0L ..< layout.children.size)
                presentChild(index, epochs)
        }
        node.paintLayers.retain(pass.paintKeys)
    }
    internal fun end() {
        active = false
    }
}
