package scoop.ui

/** Only the selected graph finalizes item retention; trials never publish geometry. */
internal fun NodeLayout.finishMeasurement() {
    if (!node.root.isOpen)
        throw UiLayoutEnded()
    val round = node.root.layouts.round
    if (sameLayoutRound(selected, round))
        return
    selected = Some(round)
    when ((body, node.body)) {
        case(Lazy(_, val selection), Lazy(_, val items)) -> items.finish(node, selection)
        else -> {}
    }
    for (child in children)
        child.result?.finishMeasurement()
}
