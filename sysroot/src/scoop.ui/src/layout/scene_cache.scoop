package scoop.ui

import scoop.graphics.*
import scoop.surface.FrameContext
import scoop.surface.InputArea
import scoop.platform.time.MonotonicInstant

/** An explicit revision of a cache boundary, without a global identity table. */
internal class SceneEpoch

/** Only value geometry and owned drawing records may outlive a scene callback. */
internal enum SceneCommand {
    Concat(Transform), Clip(Rect), Save, SaveLayer(Double, BlendMode), Restore,
    Place(InputArea, Rect), Anchor(LayoutAnchor, Rect), Semantics(SemanticsHandle, Rect),
    Children(Array<Long>?, Array<SceneEpoch>), Drawing(CachedPaintLayer), Scope(Array<SceneCommand>)
}

internal class SceneRecorder {
    private val commands = ArrayList<SceneCommand>()
    fun add(value: SceneCommand) {
        commands.add(value)
    }
    fun finish(): Array<SceneCommand> = commands.toArray()
}

/** Replays local operations into this frame; it never stores submitted input geometry. */
internal class CachedScene(
    private val version: Long,
    private val epochs: Array<SceneEpoch>,
    private val commands: Array<SceneCommand>,
    private val layers: Array<CachedPaintLayer>,
    private val paintKeys: ArrayList<PaintKey>,
    private val presentedChildren: Boolean
) {
    fun matches(
        node: MountedNode,
        current: Array<SceneEpoch>,
        canvas: Canvas,
        time: MonotonicInstant
    ): Boolean {
        if (version != node.sceneVersion || epochs.size != current.size) return false
        for (index in 0L..<epochs.size)
            if (epochs[index] !== current[index]) return false
        for (layer in layers)
            if (!layer.compatible(canvas) || !layer.current(Some(time))) return false
        return true
    }
    fun replay(
        layout: NodeLayout,
        frame: FrameContext,
        overlay: OverlayLayout?,
        scrollPath: Array<ScrollReveal>,
        paintCache: PaintCachePolicy
    ) {
        replayCommands(commands, layout, frame, overlay, scrollPath, paintCache)
        val node = layout.node
        if (node.active && node.root.isOpen) {
            if (!presentedChildren)
                layout.presentChildren(frame, overlay, scrollPath, paintCache, epochs, None)
            node.paintLayers.retain(paintKeys)
        }
    }
}

/** The recorder has already validated the child order and the balanced borrowing scopes. */
private fun replayCommands(
    commands: Array<SceneCommand>,
    layout: NodeLayout,
    frame: FrameContext,
    overlay: OverlayLayout?,
    scrollPath: Array<ScrollReveal>,
    paintCache: PaintCachePolicy
) {
    val node = layout.node
    val canvas = frame.canvas
    for (command in commands)
        when (command) {
            case Concat(val value) -> canvas.concat(value)
            case Clip(val value) -> canvas.clipRect(value)
            case Save -> canvas.save()
            case SaveLayer(val opacity, val blend) -> canvas.saveLayer(opacity, blendMode = blend)
            case Restore -> canvas.restore()

            case Place(val area, val rect) -> {
                frame.place(area, rect)
                node.root.focus.place(area, scrollPath)
            }

            case Anchor(val handle, val rect) ->
                handle.capture(node, node.root.overlays.frame, canvas, rect)

            case Semantics(val handle, val rect) -> {
                checkSemanticOwner(node, handle)
                handle.controller.capture(handle, canvas, rect, scrollPath)
            }

            case Children(val order, val childEpochs) ->
                layout.presentChildren(frame, overlay, scrollPath, paintCache, childEpochs, order)
            case Drawing(val layer) -> layer.paint(canvas, paintCache)
            case Scope(val nested) ->
                frame
                    .withState<Unit> { child ->
                        replayCommands(nested, layout, child, overlay, scrollPath, paintCache)
                    }
        }
}
