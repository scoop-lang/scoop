package scoop.ui

import scoop.graphics.Canvas
import scoop.graphics.Size
import scoop.time.TimeMark

/** A pure drawing borrow. Input and child placement belong to SceneContext. */
public class PaintContext internal constructor(
    private val root: UiRoot,
    private val target: Canvas,
    private val extent: Size,
    private val sample: TimeMark
) {
    private var active = true
    private var borrowed = false
    public val canvas: Canvas get() {
        checkActive()
        return target
    }
    public val size: Size get() {
        checkActive()
        return extent
    }
    public val time: TimeMark get() {
        checkActive()
        observeFrameTime()
        return sample
    }
    private fun checkActive() {
        root.checkThread()
        if (!active)
            throw IllegalStateException(Some("paint context has ended"))
        if (borrowed)
            throw IllegalStateException(Some("paint context has an active child scope"))
    }
    /** Isolates pixel operations without changing the surrounding scene geometry. */
    public fun <T> withState(block: (PaintContext) -> T): T {
        checkActive()
        borrowed = true
        try {
            return target.withState {
                canvas ->
                val child = PaintContext(root, canvas, extent, sample)
                try {
                    block(child)
                } finally {
                    child.end()
                }
            }
        } finally {
            borrowed = false
        }
    }
    internal fun end() {
        active = false
    }
}
