package scoop.ui

import scoop.graphics.Point
import scoop.graphics.Size
import scoop.time.TimeMark

private class ChildMeasure(val node: MountedNode) {
    var measuring = false
    var skipped = false
    var constraints: Constraints? = None
    var result: NodeLayout? = None
    var origin: Point? = None
}

/** One synchronous measure callback; children can be remeasured before their single placement. */
public class MeasureContext internal constructor(
    private val node: MountedNode,
    children: Array<MountedNode>,
    private val mark: TimeMark
) {
    private val root = node.root
    public val layoutDirection: LayoutDirection get() {
        checkActive();
        return node.layoutDirection
    }
    private var active = true
    private val entries =
        Array<ChildMeasure>(children.size) { index -> ChildMeasure(children[index]) }
    public val time: TimeMark get() {
        checkActive();
        observeFrameTime()
        return mark
    }
    public val childCount: Long get() {
        checkActive();
        return entries.size
    }
    private fun checkActive() {
        root.checkThread()
        if (!active)
            throw IllegalStateException(Some("measure context has ended"))
    }
    public fun measureChild(index: Long, constraints: Constraints): LayoutMetrics {
        checkActive()
        val entry = entries[index]
        if (entry.skipped)
            throw IllegalStateException(Some("child was skipped for this layout"))
        if (entry.origin != None)
            throw IllegalStateException(Some("child was already placed"))
        if (entry.measuring)
            throw IllegalStateException(Some("child measurement is reentrant"))
        when (entry.result) {
            case Some(result) -> if (
                entry.constraints == Some(constraints) && result.version == entry.node.layoutVersion
            )
                return result.metrics
            case None -> {}
        }
        entry.result = None
        entry.constraints = Some(constraints)
        entry.measuring = true
        try {
            val result = entry.node.measure(constraints, mark)
            entry.result = Some(result)
            return result.metrics
        } finally {
            entry.measuring = false
        }
    }
    public fun placeChild(index: Long, origin: Point) {
        checkActive()
        requireUi(origin.x.isFinite() && origin.y.isFinite(), "non-finite child origin")
        val entry = entries[index]
        when (entry.result) {
            case None -> throw IllegalStateException(
                Some("child must be measured before placement")
            )
            case Some(_) -> {}
        }
        if (entry.origin != None)
            throw IllegalStateException(Some("child was already placed"))
        entry.origin = Some(origin)
    }
    /** Retains the mounted child without measuring or presenting it in this layout. */
    public fun skipChild(index: Long) {
        checkActive()
        val entry = entries[index]
        if (entry.skipped || entry.measuring || entry.constraints != None || entry.origin != None)
            throw IllegalStateException(Some("child was already measured or skipped"))
        entry.skipped = true
    }
    internal fun finish(): Array<ChildLayout> {
        for (entry in entries) {
            when (entry.result) {
                case None -> if (!entry.skipped)
                    throw IllegalStateException(
                        Some("every child must be measured or explicitly skipped")
                    )
                case Some(_) -> {}
            }
        }
        return Array<ChildLayout>(entries.size) {
            index ->
            val entry = entries[index]
            ChildLayout(entry.node, entry.result, entry.origin)
        }
    }
    internal fun end() {
        active = false
    }
}

internal fun MountedNode.measure(constraints: Constraints, time: TimeMark): NodeLayout {
    if (!root.isOpen)
        throw UiLayoutEnded()
    constraints.check()
    val store = root.layouts
    if (!sameLayoutRound(layoutRound, store.round))
        store.touch(this)
    for (previous in layoutRequests)
        if (
            previous.version ==
                layoutVersion &&
                previous.direction ==
                layoutDirection &&
                previous.constraints ==
                constraints
        )
            return previous
    val result =
        when (body) {
            case Empty -> layoutResult(
                constraints,
                LayoutMetrics(Size(constraints.minWidth, constraints.minHeight)),
                [],
                LayoutBody.Empty
            )
            case Portal(instance) -> layoutResult(
                constraints,
                LayoutMetrics(Size(constraints.minWidth, constraints.minHeight)),
                [],
                LayoutBody.Portal(instance)
            )
            case Direction -> transparentLayout(constraints, time)
            case Component(_) -> transparentLayout(constraints, time)
            case Element(instance) -> measureElement(instance, constraints, time)
            case Lazy(instance, items) -> measureLazy(instance, items, constraints, time)
        }
    store.add(result)
    return result
}

private fun MountedNode.layoutResult(
    constraints: Constraints,
    metrics: LayoutMetrics,
    children: Array<ChildLayout>,
    body: LayoutBody,
    inputs: FrameInputs = FrameInputs()
): NodeLayout =
    NodeLayout(
        this,
        constraints,
        layoutVersion,
        layoutDirection,
        root.layouts.round,
        metrics,
        children,
        body,
        inputs
    )

private fun MountedNode.transparentLayout(constraints: Constraints, time: TimeMark): NodeLayout {
    val child = children[0L]
    val result = child.measure(constraints, time)
    return layoutResult(
        constraints,
        result.metrics,
        [ChildLayout(child, Some(result), Some(Point(0.0, 0.0)))],
        LayoutBody.Transparent
    )
}

private fun MountedNode.measureElement(
    instance: ElementInstance,
    constraints: Constraints,
    time: TimeMark
): NodeLayout {
    val context = MeasureContext(this, children, time)
    val reads = FrameReads(this, time)
    var result: ElementLayout? = None
    try {
        val measured =
            evaluateUi<ElementLayout>(None, Some(reads)) { instance.measure(context, constraints) }
        result = Some(measured)
        checkLayoutMetrics(measured.metrics, constraints)
        return layoutResult(
            constraints,
            measured.metrics,
            context.finish(),
            LayoutBody.Element(measured),
            reads.finish()
        )
    } catch (error: Throwable) {
        val failed = result
        throwUi(cleanupUi(Some(error)) { failed?.close() })
        throw error
    } finally {
        context.end()
    }
}

private fun MountedNode.measureLazy(
    instance: LazyInstance,
    items: LazyChildren,
    constraints: Constraints,
    time: TimeMark
): NodeLayout {
    val context = LazyMeasureContext(this, items, time)
    val reads = FrameReads(this, time)
    var result: ElementLayout? = None
    try {
        val measured =
            evaluateUi<ElementLayout>(None, Some(reads)) { instance.measure(context, constraints) }
        result = Some(measured)
        checkLayoutMetrics(measured.metrics, constraints)
        val selected = context.finish()
        val children =
            Array<ChildLayout>(selected.size) {
                index ->
                val child = selected[index]
                ChildLayout(child.entry.node, Some(child.result), child.origin)
            }
        return layoutResult(
            constraints,
            measured.metrics,
            children,
            LayoutBody.Lazy(measured, selected),
            reads.finish()
        )
    } catch (error: Throwable) {
        val failed = result
        throwUi(cleanupUi(Some(error)) { failed?.close() })
        throw error
    } finally {
        context.end()
    }
}
