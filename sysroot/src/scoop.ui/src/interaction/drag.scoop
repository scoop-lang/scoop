package scoop.ui

import scoop.graphics.Point
import scoop.math.abs
import scoop.surface.*
import scoop.window.*

/** An axis candidate becomes active only after claiming the original press path. */
public class Drag internal constructor(
    private val area: InputArea,
    initial: DragOptions,
    accepts: (Point) -> Boolean,
    handler: (DragEvent) -> Unit
): Closeable {
    private var options = initial
    private var accept = accepts
    private var receive = handler
    private var closed = false
    private var start: PointerState? = None
    private var previous: PointerState? = None
    private var input: DragInput? = None
    private val contacts = ArrayList<ContactId>()
    private var latest: DragSample? = None
    private var claimed = false
    private val events = area.scope.addEventHandler { context, event -> observe(context, event) }
    private val defaults = area.scope.addDefaultAction { context, event -> handle(context, event) }
    private val finished = area.scope.addEventFinished { event -> finish(event) }
    public val isDragging: Boolean get() {
        area.isClosed;
        return claimed
    }
    public val isClosed: Boolean get() {
        area.isClosed;
        return closed
    }

    public fun update(
        value: DragOptions,
        accepts: (Point) -> Boolean,
        handler: (DragEvent) -> Unit
    ) {
        requireUi(!closed && !area.isClosed, "drag behavior is closed")
        val changed =
            value.axis !=
                options.axis ||
                value.button !=
                options.button ||
                value.threshold !=
                options.threshold ||
                value.contacts !=
                options.contacts
        options = value
        accept = accepts
        receive = handler
        if (!value.enabled)
            cancel(DragCancelReason.Disabled)
        else
            if (changed)
                cancel(DragCancelReason.ConfigurationChanged)
    }
    private fun observe(context: RoutedEventContext, event: InputEvent) {
        if (closed)
            return
        if (context.phase == RoutedPhase.Notification) {
            when (event) {
                case Pointer(InputPointerEvent.Cancelled(val reason, _)) -> if (isMouse())
                    cancel(DragCancelReason.Input(reason), false)
                case Contact(InputContactEvent.Cancelled(val id, val reason, _)) -> {
                    forgetContact(contacts, id)
                    if (isContact(id))
                        cancel(DragCancelReason.Input(reason), false)
                }
                else -> {}
            }
            return
        }
        when (event) {
            case Pointer(
                InputPointerEvent.Button(val point, val button, ElementState.Pressed, _)
            ) -> {
                if (
                    options.enabled &&
                        (!options.contacts || contacts.size == 0L) &&
                        button ==
                        options.button
                )
                    begin(context, point.state, DragInput.Mouse(button))
            }
            case Contact(InputContactEvent.Began(val value)) -> {
                rememberContact(contacts, value.id)
                if (contacts.size > 1L) {
                    when (input) {
                        case Some(DragInput.Contact(_, _)) -> cancel(
                            DragCancelReason.AdditionalContact
                        )
                        else -> {}
                    }
                    return
                }
                if (options.enabled && options.contacts)
                    begin(context, value.pointer, DragInput.Contact(value.id, value.kind))
            }
            else -> {}
        }
    }
    private fun begin(context: RoutedEventContext, point: PointerState, source: DragInput) {
        if (start != None)
            return
        val local = context.localPosition ?: return
        if (accept(local) && !closed && !area.isClosed) {
            input = Some(source)
            start = Some(point)
            previous = Some(point)
            latest = sample(point)
        }
    }
    private fun isMouse(): Boolean =
        when (input) {
            case Some(DragInput.Mouse(_)) -> true
            else -> false
        }
    private fun isContact(id: ContactId): Boolean =
        when (input) {
            case Some(DragInput.Contact(val current, _)) -> current == id
            else -> false
        }
    private fun handle(context: RoutedEventContext, event: InputEvent) {
        if (closed || !options.enabled || start == None)
            return
        when (event) {
            case Pointer(
                InputPointerEvent.Button(val point, val button, ElementState.Pressed, _)
            ) -> if (isMouse() && button == options.button && options.threshold == 0.0)
                advance(context, point.state)
            case Pointer(InputPointerEvent.Moved(val point)) -> if (isMouse())
                advance(context, point.state)
            case Pointer(
                InputPointerEvent.Button(val point, val button, ElementState.Released, _)
            ) -> {
                if (isMouse() && button == options.button)
                    end(context, point.state)
            }
            case Contact(InputContactEvent.Began(val value)) -> if (
                isContact(value.id) && options.threshold == 0.0
            )
                advance(context, value.pointer)
            case Contact(InputContactEvent.Moved(val value)) -> if (isContact(value.id))
                advance(context, value.pointer)
            case Contact(InputContactEvent.Ended(val value)) -> {
                if (isContact(value.id))
                    end(context, value.pointer)
            }
            else -> {}
        }
    }
    private fun end(context: RoutedEventContext, point: PointerState) {
        if (!claimed)
            return
        val value = sample(point)
        context.consume()
        if (value == None) {
            cancel(DragCancelReason.GeometryUnavailable)
            return
        }
        clear()
        receive(DragEvent.Ended(value!!))
    }
    private fun advance(context: RoutedEventContext, point: PointerState) {
        val value = sample(point)
        if (value == None) {
            cancel(DragCancelReason.GeometryUnavailable);
            return
        }
        val current = value!!
        latest = value
        if (!claimed) {
            val cross =
                if (options.axis == DragAxis.Horizontal)
                    current.position.y - current.start.y
                else
                    current.position.x - current.start.x
            if (abs(current.displacement) < options.threshold && abs(cross) < options.threshold) {
                previous = Some(point);
                return
            }
            if (abs(current.displacement) < abs(cross)) {
                clear();
                return
            }
            val source = input ?: return
            val acquired =
                when (source) {
                    case Mouse(val button) -> area.scope.claimPointer(button)
                    case Contact(val id, _) -> area.scope.claimContacts([id])
                }
            if (!acquired || closed || area.isClosed || input != Some(source) || start == None) {
                if (acquired && !area.isClosed)
                    release(source)
                clear();
                return
            }
            claimed = true
            previous = Some(point)
            context.consume()
            receive(DragEvent.Started(current))
        } else {
            previous = Some(point)
            context.consume()
            receive(DragEvent.Moved(current))
        }
    }
    private fun sample(point: PointerState): DragSample? {
        val origin = start ?: return None
        val source = input ?: return None
        val before = previous ?: origin
        val local = area.toLocal(windowPoint(point)) ?: return None
        val beginning = area.toLocal(windowPoint(origin)) ?: return None
        val prior = area.toLocal(windowPoint(before)) ?: return None
        val duration = point.time.mark() - before.time.mark()
        val seconds =
            duration.floorSeconds.toDouble() +
                duration.nanosecondsOfSecond.toDouble() /
                1000000000.0
        val displacement = axis(local) - axis(beginning)
        val speed =
            if (seconds > 0.0)
                (axis(local) - axis(prior)) / seconds
            else
                0.0
        if (!displacement.isFinite() || !speed.isFinite())
            return None
        return Some(DragSample(beginning, local, displacement, speed, point.time, source))
    }
    private fun axis(point: Point): Double =
        if (options.axis == DragAxis.Horizontal)
            point.x
        else
            point.y
    private fun windowPoint(point: PointerState): Point =
        Point(point.logicalPosition.x, point.logicalPosition.y)
    private fun finish(event: InputEvent) {
        if (closed)
            return
        when (event) {
            case Pointer(InputPointerEvent.Button(_, val button, ElementState.Released, _)) -> {
                if (isMouse() && button == options.button && start != None)
                    cancel(DragCancelReason.PreventedRelease)
            }
            case Contact(InputContactEvent.Ended(val value)) -> {
                forgetContact(contacts, value.id)
                if (isContact(value.id))
                    cancel(DragCancelReason.PreventedRelease)
            }
            case Contact(InputContactEvent.Began(val value)) -> {
                when (input) {
                    case Some(DragInput.Contact(val current, _)) -> {
                        if (current != value.id)
                            cancel(DragCancelReason.AdditionalContact)
                    }
                    else -> {}
                }
            }
            else -> {}
        }
    }
    public fun cancel() {
        area.isClosed
        if (!closed)
            cancel(DragCancelReason.Explicit)
    }
    private fun clear() {
        start = None;
        previous = None;
        latest = None;
        input = None;
        claimed = false
    }
    private fun release(source: DragInput) {
        when (source) {
            case Mouse(_) -> area.scope.cancelPointerClaim()
            case Contact(val id, _) -> area.scope.cancelContactClaim(id)
        }
    }
    private fun cancel(reason: DragCancelReason, releaseClaim: Boolean = true) {
        val active = claimed
        val snapshot = latest
        val source = input
        clear()
        var failure =
            cleanupUi(None) {
                if (active && releaseClaim && !area.isClosed && source != None)
                    release(source!!)
            }
        failure =
            cleanupUi(failure) {
                if (active && snapshot != None)
                    receive(DragEvent.Cancelled(snapshot!!, reason))
            }
        throwUi(failure)
    }
    public override fun close() {
        area.isClosed
        if (closed)
            return
        closed = true
        var failure = cleanupUi(None) { cancel(DragCancelReason.Closed) }
        contacts.clear()
        failure = cleanupUi(failure) { events.close() }
        failure = cleanupUi(failure) { defaults.close() }
        failure = cleanupUi(failure) { finished.close() }
        throwUi(failure)
    }
}

public fun ComponentScope.drag(
    area: InputArea,
    options: DragOptions,
    accepts: (Point) -> Boolean = { _ -> true },
    handler: (DragEvent) -> Unit
): Drag {
    requireBehaviorArea(area)
    return resource { Drag(area, options, accepts, handler) }
}
