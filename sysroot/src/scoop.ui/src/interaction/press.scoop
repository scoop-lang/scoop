package scoop.ui

import scoop.graphics.Point
import scoop.math.hypot
import scoop.surface.*
import scoop.window.*

public struct InteractionState(
    val hovered: Boolean = false,
    val pressed: Boolean = false,
    val focused: Boolean = false,
    val focusVisible: Boolean = false
)

public struct PressOptions(
    val enabled: Boolean = true,
    val acceptsEnter: Boolean = true,
    val touchThreshold: Double = 8.0
)

private fun checkedPressOptions(value: PressOptions): PressOptions {
    requireUi(
        value.touchThreshold.isFinite() && value.touchThreshold >= 0.0,
        "press touch threshold must be finite and nonnegative"
    )
    return value
}

/** Owns subscriptions and activation state, borrowing the caller's input area. */
public class Press internal constructor(
    private val area: InputArea,
    initial: PressOptions,
    action: () -> Unit
): Closeable {
    private val visual = state(InteractionState())
    private var options = checkedPressOptions(initial)
    private var activate = action
    private var closed = false
    private var pointer = false
    private val contacts = ArrayList<ContactId>()
    private var contact: ContactState? = None
    private var contactPosition: PointerState? = None
    private var key: PhysicalKey? = None
    private var releaseActivates = false
    private val space = ShortcutChord(ShortcutKey.Logical(LogicalKey.Named(NamedKey.Space)))
    private val enter = ShortcutChord(ShortcutKey.Logical(LogicalKey.Named(NamedKey.Enter)))
    private val events =
        area.scope.addEventHandler { context, event -> notification(context, event) }
    private val defaults = area.scope.addDefaultAction { context, event -> handle(context, event) }
    private val finished = area.scope.addEventFinished { event -> finish(event) }
    public val interaction: InteractionState get() = visual.value
    public val isClosed: Boolean get() {
        area.isClosed;
        return closed
    }
    init {
        publish()
    }

    public fun update(value: PressOptions, onPress: () -> Unit) {
        requireUi(!closed && !area.isClosed, "press behavior is closed")
        options = checkedPressOptions(value)
        activate = onPress
        if (!value.enabled || (!value.acceptsEnter && key != None && !releaseActivates))
            cancel()
        publish()
    }
    private fun notification(context: RoutedEventContext, event: InputEvent) {
        if (closed)
            return
        if (context.phase != RoutedPhase.Notification) {
            when (event) {
                case Contact(InputContactEvent.Began(val value)) -> {
                    rememberContact(contacts, value.id)
                    if (contacts.size > 1L)
                        clearContact()
                    publish()
                }
                else -> {}
            }
            return
        }
        when (event) {
            case FocusChanged(false) -> {
                pointer = false
                key = None
                releaseActivates = false
            }
            case Pointer(InputPointerEvent.Cancelled(_, _)) -> {
                pointer = false
                key = None
                releaseActivates = false
            }
            case Contact(InputContactEvent.Cancelled(val id, _, _)) -> finishContact(id)
            else -> {}
        }
        publish()
    }
    private fun handle(context: RoutedEventContext, event: InputEvent) {
        if (closed || !options.enabled)
            return
        when (event) {
            case Pointer(InputPointerEvent.Button(val input, MouseButton.Left, val status, _)) -> {
                if (status == ElementState.Pressed) {
                    if (isContextMenuClick(MouseButton.Left, input.state.modifiers)) {
                        pointer = false
                        publish()
                        return
                    }
                    if (key == None && contacts.size == 0L && area.scope.isHovered)
                        pointer = true
                    publish()
                    context.consume()
                } else {
                    val fire = pointer && area.scope.isHovered
                    pointer = false
                    publish()
                    context.consume()
                    if (fire)
                        activate()
                }
            }
            case Contact(val value) -> touch(context, value)
            case Keyboard(val value) -> keyboard(context, value)
            else -> {}
        }
    }
    private fun touch(context: RoutedEventContext, event: InputContactEvent) {
        when (event) {
            case Began(val value) -> {
                if (contacts.size == 1L && !pointer && key == None && hits(value.pointer)) {
                    contact = Some(value)
                    contactPosition = Some(value.pointer)
                    publish()
                }
            }
            case Moved(val value) -> {
                if (contact?.id == Some(value.id)) {
                    contactPosition = Some(value.pointer)
                    if (!withinThreshold(value.pointer))
                        clearContact()
                    publish()
                }
            }
            case Ended(val value) -> {
                val fire =
                    contact?.id ==
                        Some(value.id) &&
                        contacts.size ==
                        1L &&
                        withinThreshold(value.pointer) &&
                        hits(value.pointer)
                finishContact(value.id)
                publish()
                if (fire) {
                    context.consume()
                    activate()
                }
            }
            case Cancelled(_, _, _) -> {}
        }
    }
    private fun withinThreshold(value: PointerState): Boolean {
        val origin = contact ?: return false
        val start = origin.pointer.logicalPosition
        val point = value.logicalPosition
        return hypot(point.x - start.x, point.y - start.y) <= options.touchThreshold
    }
    private fun hits(value: PointerState): Boolean =
        area.hitTest(Point(value.logicalPosition.x, value.logicalPosition.y))
    private fun clearContact() {
        contact = None
        contactPosition = None
    }
    private fun finishContact(id: ContactId) {
        forgetContact(contacts, id)
        if (contact?.id == Some(id))
            clearContact()
    }
    private fun keyboard(context: RoutedEventContext, event: KeyEvent) {
        if (!area.isFocusActive)
            return
        if (event.state == ElementState.Released && key == Some(event.physicalKey)) {
            val fire = releaseActivates && !event.synthetic && space.matches(event)
            key = None
            releaseActivates = false
            publish()
            context.consume()
            if (fire)
                activate()
            return
        }
        val isSpace = space.matches(event)
        val isEnter = options.acceptsEnter && enter.matches(event)
        if (!isSpace && !isEnter)
            return
        context.consume()
        if (
            event.state !=
                ElementState.Pressed ||
                event.isRepeat ||
                event.synthetic ||
                pointer ||
                contacts.size >
                0L ||
                key !=
                None
        )
            return
        key = Some(event.physicalKey)
        releaseActivates = isSpace
        publish()
        if (isEnter)
            activate()
    }
    private fun finish(event: InputEvent) {
        if (closed)
            return
        when (event) {
            case Pointer(
                InputPointerEvent.Button(_, MouseButton.Left, ElementState.Released, _)
            ) -> pointer = false
            case Keyboard(val value) -> {
                if (value.state == ElementState.Released && key == Some(value.physicalKey)) {
                    key = None
                    releaseActivates = false
                }
            }
            case Contact(InputContactEvent.Ended(val value)) -> finishContact(value.id)
            case Contact(InputContactEvent.Began(val value)) -> {
                if (contact?.id != Some(value.id))
                    clearContact()
            }
            case Contact(InputContactEvent.Moved(val value)) -> {
                if (contact?.id == Some(value.id)) {
                    contactPosition = Some(value.pointer)
                    if (!withinThreshold(value.pointer))
                        clearContact()
                }
            }
            else -> {}
        }
        publish()
    }
    private fun cancel() {
        pointer = false;
        key = None;
        releaseActivates = false
        clearContact()
    }
    private fun publish() {
        val enabled =
            !closed && !area.isClosed && options.enabled && area.scope.isEnabledInHierarchy
        val hovered = enabled && area.scope.isHovered
        val touching =
            when (contactPosition) {
                case Some(val point) -> withinThreshold(point) && hits(point)
                case None -> false
            }
        val next =
            InteractionState(
                hovered,
                enabled && ((pointer && hovered) || key != None || touching),
                enabled && area.isFocusActive,
                enabled && area.isFocusVisible
            )
        if (visual.value != next)
            visual.value = next
    }
    public override fun close() {
        area.isClosed
        if (closed)
            return
        closed = true
        cancel()
        contacts.clear()
        events.close()
        defaults.close()
        finished.close()
        publish()
    }
}

public fun ComponentScope.press(
    area: InputArea,
    options: PressOptions = PressOptions(),
    onPress: () -> Unit
): Press {
    requireBehaviorArea(area)
    return resource { Press(area, options, onPress) }
}
