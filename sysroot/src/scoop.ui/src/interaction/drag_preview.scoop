package scoop.ui

import scoop.graphics.*
import scoop.math.max
import scoop.math.min
import scoop.surface.InputArea
import scoop.window.*

/** Draws a native preview in source-local coordinates at the current display scale. */
public fun DragSourceStart.renderPreview(bounds: Rect, draw: (Canvas) -> Unit): DragPreview =
    rasterDragPreview(bounds, start, pointer.scaleFactor, draw)

private fun rasterDragPreview(
    bounds: Rect,
    anchor: Point,
    scale: Double,
    draw: (Canvas) -> Unit
): DragPreview {
    val size = LogicalSize(bounds.width, bounds.height)
    val pixels = size.toPhysical(scale)
    return RasterSurface(pixels.width, pixels.height).use {
        surface ->
        surface.draw {
            canvas ->
            canvas.clear(Color.Transparent)
            canvas.scale(
                pixels.width.toDouble() / bounds.width,
                pixels.height.toDouble() / bounds.height
            )
            canvas.translate(-bounds.x, -bounds.y)
            draw(canvas)
        }
        val bytes = surface.readPixels()
        val rep =
            DesktopImageRepresentation(pixels, Array<UInt8>(bytes.size) { bytes[it].toUByte() })
        DragPreview(
            DesktopImage(size, [rep]),
            LogicalPosition(anchor.x - bounds.x, anchor.y - bounds.y)
        )
    }
}

/** Paints only the visible selected regions, keeping the press anchored even in a scrolled or transformed area. */
public fun DragSourceStart.renderSelectionPreview(
    regions: Array<Rect>,
    area: InputArea,
    draw: (Canvas) -> Unit
): DragPreview? {
    val viewport = area.visibleBounds ?: return None
    val origin = area.toWindow(Rect(0.0, 0.0, 0.0, 0.0))?.origin ?: return None
    val x = area.toWindow(Rect(1.0, 0.0, 0.0, 0.0))!!.origin
    val y = area.toWindow(Rect(0.0, 1.0, 0.0, 0.0))!!.origin
    val transform =
        Transform(
            x.x - origin.x,
            x.y - origin.y,
            y.x - origin.x,
            y.y - origin.y,
            origin.x,
            origin.y
        )
    val anchor = transform.map(start)
    return PathBuilder().use {
        builder ->
        var left = Double.POSITIVE_INFINITY
        var top = Double.POSITIVE_INFINITY
        var right = Double.NEGATIVE_INFINITY
        var bottom = Double.NEGATIVE_INFINITY
        for (region in regions) {
            val rect = area.toWindow(region)!!
            if (intersectReveal(rect, viewport) == None)
                continue
            left = min(left, rect.x)
            top = min(top, rect.y)
            right = max(right, rect.x + rect.width)
            bottom = max(bottom, rect.y + rect.height)
            builder.addRect(region)
        }
        if (right <= left || bottom <= top)
            return@use None
        val horizontal = cropPreviewAxis(left, right, viewport.x, viewport.width, anchor.x, 360.0)
        val vertical = cropPreviewAxis(top, bottom, viewport.y, viewport.height, anchor.y, 240.0)
        val bounds = Rect(horizontal.start, vertical.start, horizontal.size, vertical.size)
        builder.build().use {
            shape -> Some(
                rasterDragPreview(bounds, anchor, pointer.scaleFactor) {
                    canvas ->
                    canvas.withState {
                        content ->
                        content.concat(transform)
                        content.clipPath(shape)
                        content.saveLayer(opacity = 0.8)
                        try {
                            draw(content)
                        } finally {
                            content.restore()
                        }
                    }
                    horizontal.fade(canvas, bounds, Point(bounds.x + bounds.width, bounds.y))
                    vertical.fade(canvas, bounds, Point(bounds.x, bounds.y + bounds.height))
                }
            )
        }
    }
}

private struct PreviewAxis(
    val start: Double,
    val size: Double,
    val cutStart: Boolean,
    val cutEnd: Boolean
) {
    fun fade(canvas: Canvas, bounds: Rect, end: Point) {
        if (!cutStart && !cutEnd)
            return
        val ramp = min(24.0 / size, 0.25)
        val mask =
            Gradient.linear(
                bounds.origin,
                end,
                [
                    GradientStop(
                        0.0,
                        if (cutStart)
                            Color.Transparent
                        else
                            Color.White
                    ),
                    GradientStop(ramp, Color.White),
                    GradientStop(1.0 - ramp, Color.White),
                    GradientStop(
                        1.0,
                        if (cutEnd)
                            Color.Transparent
                        else
                            Color.White
                    )
                ]
            )
        canvas.saveLayer(blendMode = BlendMode.DstIn, bounds = Some(bounds))
        try {
            canvas.drawRect(bounds, Paint(gradient = Some(mask)))
        } finally {
            canvas.restore()
        }
    }
}

private fun cropPreviewAxis(
    first: Double,
    last: Double,
    viewportStart: Double,
    viewportSize: Double,
    anchor: Double,
    limit: Double
): PreviewAxis {
    val visibleStart = max(first, viewportStart)
    val visibleEnd = min(last, viewportStart + viewportSize)
    val visibleSize = visibleEnd - visibleStart
    val size = min(limit, visibleSize)
    val overflow = visibleSize - size
    val offset = max(0.0, min(overflow, anchor - visibleStart - size * 0.5))
    return PreviewAxis(
        visibleStart + offset,
        size,
        first < visibleStart || offset > 0.0,
        last > visibleEnd || offset < overflow
    )
}
