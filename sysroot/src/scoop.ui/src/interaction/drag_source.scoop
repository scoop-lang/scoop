package scoop.ui

import scoop.graphics.Point
import scoop.surface.*
import scoop.window.*

/** Borrows an area and hands one confirmed press sequence to the native data session. */
public class DragSource internal constructor(
    private val root: UiRoot,
    private val scope: ComponentScope,
    private val area: InputArea,
    initial: DragSourceOptions,
    prepare: (DragSourceStart) -> DragSourceData?,
    begin: (DragSourceData, (DragResult) -> Unit) -> DragSession
): Closeable {
    private val visual = state(false)
    private var options = initial
    private var prepareData: ((DragSourceStart) -> DragSourceData?)? = Some(prepare)
    private var beginSession: ((DragSourceData, (DragResult) -> Unit) -> DragSession)? = Some(begin)
    private var session: DragSession? = None
    private var completion: ((DragResult) -> Unit)? = None
    private var press: PointerState? = None
    private var input: DragInput? = None
    private val contacts = ArrayList<ContactId>()
    private var moved = false
    private var began = false
    private var preparing = false
    private var closed = false
    private var revision = 0uL
    private val events = area.scope.addEventHandler { context, event -> observe(context, event) }
    private val defaults = area.scope.addDefaultAction { context, event -> handle(context, event) }
    private val finished = area.scope.addEventFinished { event -> finish(event) }

    public val isDragging: Boolean get() = visual.value
    public val isClosed: Boolean get() {
        val mounted = scope.isMounted
        return closed || !mounted || area.isClosed
    }
    private val available: Boolean get() = !isClosed && options.enabled && area.scope.isInputAllowed

    public fun update(options: DragSourceOptions, prepare: (DragSourceStart) -> DragSourceData?) {
        checkDropMutation()
        requireUi(!isClosed, "drag source is no longer mounted")
        if (
            options.threshold !=
                this.options.threshold ||
                !options.enabled ||
                options.mouse !=
                this.options.mouse ||
                options.contacts !=
                this.options.contacts
        )
            clearCandidate()
        this.options = options
        prepareData = Some(prepare)
        revision += 1uL
        reconcile()
    }

    private fun observe(context: RoutedEventContext, event: InputEvent) {
        if (closed)
            return
        if (context.phase == RoutedPhase.Notification) {
            when (event) {
                case Pointer(InputPointerEvent.Cancelled(_, _)) -> {
                    if (isMouse())
                        clearCandidate()
                }
                case Contact(InputContactEvent.Cancelled(val id, _, _)) -> {
                    forgetContact(contacts, id)
                    if (isContact(id))
                        clearCandidate()
                }
                else -> {}
            }
            reconcile()
            return
        }
        when (event) {
            case Pointer(
                InputPointerEvent.Button(
                    val pointer,
                    MouseButton.Left,
                    ElementState.Pressed,
                    val count
                )
            ) -> {
                clearCandidate()
                if (
                    available &&
                        options.mouse &&
                        contacts.size ==
                        0L &&
                        !visual.value &&
                        count ==
                        1 &&
                        context.localPosition !=
                        None &&
                        !isContextMenuClick(MouseButton.Left, pointer.state.modifiers)
                )
                {
                    press = Some(pointer.state)
                    input = Some(DragInput.Mouse(MouseButton.Left))
                }
            }
            case Contact(InputContactEvent.Began(val value)) -> {
                rememberContact(contacts, value.id)
                if (contacts.size > 1L) {
                    clearCandidate()
                    return
                }
                if (
                    available && options.contacts && !visual.value && context.localPosition != None
                ) {
                    press = Some(value.pointer)
                    input = Some(DragInput.Contact(value.id, value.kind))
                }
            }
            else -> {}
        }
    }

    internal fun handle(context: RoutedEventContext, event: InputEvent) {
        if (!available || visual.value || press == None)
            return
        when (event) {
            case Pointer(InputPointerEvent.Moved(val pointer)) -> if (isMouse()) {
                moved = true
                advance(context, pointer.state)
            }
            case Pointer(
                InputPointerEvent.Button(val pointer, MouseButton.Left, ElementState.Pressed, _)
            ) -> {
                began = true
                if (isMouse() && options.threshold == 0.0)
                    advance(context, pointer.state)
            }
            case Contact(InputContactEvent.Began(val value)) -> {
                began = true
                if (isContact(value.id) && options.threshold == 0.0)
                    advance(context, value.pointer)
            }
            case Contact(InputContactEvent.Moved(val value)) -> {
                if (isContact(value.id)) {
                    moved = true
                    advance(context, value.pointer)
                }
            }
            else -> {}
        }
    }

    private fun advance(context: RoutedEventContext, pointer: PointerState) {
        val origin = press ?: return
        val source = input ?: return
        if (!dragSourceThreshold(origin, pointer, options.threshold))
            return
        // A declined or invalidated preparation is not retried until the next press.
        clearCandidate()
        val position = context.localPosition ?: return
        val start =
            area.toLocal(Point(origin.logicalPosition.x, origin.logicalPosition.y)) ?: return
        val version = revision
        preparing = true
        val data =
            try {
                prepareData!!.invoke(DragSourceStart(start, position, origin, pointer, source)) ?:
                    return
            } finally {
                preparing = false
            }
        if (!available || revision != version || visual.value)
            return
        val claimed =
            when (source) {
                case Mouse(val button) -> area.scope.claimPointer(button)
                case Contact(val id, _) -> area.scope.claimContacts([id])
            }
        if (!claimed)
            return
        try {
            if (!available || revision != version) {
                releaseClaim(source)
                return
            }
            val value = beginSession!!.invoke(data) { result -> completed(result) }
            session = Some(value)
            completion = Some(data.onCompleted)
            root.dragSource = Some(this)
            publish(true)
            context.consume()
        } catch (error: Throwable) {
            var failure = cleanupUi(Some(error)) { releaseSession() }
            failure = cleanupUi(failure) { releaseClaim(source) }
            throw failure!!
        }
    }

    private fun finish(event: InputEvent) {
        when (event) {
            case Contact(InputContactEvent.Began(val value)) -> {
                if (isContact(value.id) && !began)
                    clearCandidate()
                began = false
            }
            case Pointer(
                InputPointerEvent.Button(_, MouseButton.Left, ElementState.Pressed, _)
            ) -> {
                if (isMouse() && !began)
                    clearCandidate()
                began = false
            }
            case Pointer(InputPointerEvent.Moved(_)) -> {
                if (isMouse() && !moved)
                    clearCandidate()
                moved = false
            }
            case Contact(InputContactEvent.Moved(val value)) -> {
                if (isContact(value.id) && !moved)
                    clearCandidate()
                moved = false
            }
            case Contact(InputContactEvent.Ended(val value)) -> {
                forgetContact(contacts, value.id)
                if (isContact(value.id))
                    clearCandidate()
            }
            case Pointer(
                InputPointerEvent.Button(_, MouseButton.Left, ElementState.Released, _)
            ) -> {
                if (isMouse())
                    clearCandidate()
            }
            else -> {}
        }
    }

    private fun isMouse(): Boolean =
        when (input) {
            case Some(DragInput.Mouse(_)) -> true
            else -> false
        }
    private fun isContact(id: ContactId): Boolean =
        when (input) {
            case Some(DragInput.Contact(val current, _)) -> current == id
            else -> false
        }
    internal fun hasContactCandidate(id: ContactId): Boolean = press != None && isContact(id)
    private fun clearCandidate() {
        press = None
        input = None
    }
    private fun releaseClaim(source: DragInput) {
        if (area.isClosed)
            return
        when (source) {
            case Mouse(_) -> area.scope.cancelPointerClaim()
            case Contact(val id, _) -> area.scope.cancelContactClaim(id)
        }
    }

    private fun completed(result: DragResult) {
        if (closed)
            return
        if (!scope.isMounted) {
            releaseSession()
            return
        }
        scope.dispatch {
            val action = completion
            val allowed = available
            releaseSession()
            if (allowed)
                action?.invoke(result)
        }
    }

    internal fun reconcile() {
        if (!available) {
            clearCandidate()
            releaseSession()
        }
    }

    internal fun updateEffects(effects: DragEffects) {
        val current = session ?: return
        if (current.isClosed)
            return
        when (current.result) {
            case Some(_) -> {}
            case None -> current.effects = effects
        }
    }

    public fun cancelPending(): Boolean {
        scope.isMounted
        checkDropMutation()
        if (closed)
            return false
        val candidate = press != None || preparing
        clearCandidate()
        preparing = false
        revision += 1uL
        return when (val current = session) {
            case Some(val value) -> value.cancelPending()
            case None -> candidate
        }
    }

    private fun publish(value: Boolean) {
        if (visual.value == value)
            return
        visual.value = value
        if (scope.isMounted)
            scope.requestFrame()
    }

    private fun releaseSession() {
        val previous = session
        session = None
        completion = None
        when (val current = root.dragSource) {
            case Some(val value) -> if (value === this)
                root.dragSource = None
            case None -> {}
        }
        try {
            previous?.close()
        } finally {
            publish(false)
        }
    }

    public override fun close() {
        scope.isMounted
        checkDropMutation()
        if (closed)
            return
        closed = true
        revision += 1uL
        clearCandidate()
        contacts.clear()
        preparing = false
        prepareData = None
        beginSession = None
        var failure = cleanupUi(None) { releaseSession() }
        failure = cleanupUi(failure) { events.close() }
        failure = cleanupUi(failure) { defaults.close() }
        failure = cleanupUi(failure) { finished.close() }
        throwUi(failure)
    }
}
