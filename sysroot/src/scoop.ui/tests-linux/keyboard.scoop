package scoop.ui.text

import scoop.graphics.text.*
import scoop.platform.time.MonotonicTimeSource
import scoop.test.*
import scoop.tests.textfonts.testSansBytes
import scoop.window.*

@Test
private class LinuxEditorKeysTest {
    @Test
    fun `Ctrl word selection and deletion operate on the laid out document and preserve undo`() {
        FontCollection(false).use {
            fonts ->
            fonts.register(testSansBytes, "Linux Editor Test")
            val state = TextEditorState("alpha beta\nnext")
            state.setSelection(Utf8Selection(10L, 10L))
            Paragraph(
                fonts,
                state.text,
                textStyle {
                    families = ["Linux Editor Test"]
                    fontSize = 20.0
                }
            ).use {
                paragraph -> paragraph.layout(240.0).use {
                    layout ->
                    val command =
                        editorFallbackKey(
                            linuxKey(
                                LogicalKey.Named(NamedKey.ArrowLeft),
                                control = true,
                                shift = true
                            )
                        )!!
                    when (command) {
                        case Move(movement, extend) -> {
                            val moved =
                                editorMove(
                                    layout,
                                    EditorSelection(state.anchor, state.cursor),
                                    movement,
                                    extend,
                                    None,
                                    80.0
                                )
                            state.setSelection(moved.selection.anchor, moved.selection.cursor)
                        }
                        else -> fail(Some("Ctrl+Shift+Left must extend by a word"))
                    }
                    assertEquals(Utf8Selection(10L, 6L), state.selection)
                    state.setSelection(Utf8Selection(10L, 10L))
                    when (
                        editorFallbackKey(
                            linuxKey(LogicalKey.Named(NamedKey.Backspace), control = true)
                        )!!
                    ) {
                        case Delete(deletion) -> state.replace(
                            editorDeleteRange(layout, state.selection, deletion),
                            ""
                        )
                        else -> fail(Some("Ctrl+Backspace must delete a word"))
                    }
                    assertEquals("alpha \nnext", state.text)
                    assertTrue(state.undo())
                    assertEquals("alpha beta\nnext", state.text)
                }
            }
        }
    }

    @Test
    fun `Linux editing uses Ctrl shortcuts and separates line and document navigation`() {
        assertEquals(
            Some(TextEditCommand.Undo),
            editorFallbackKey(linuxKey(LogicalKey.Character("z"), control = true))
        )
        assertEquals(
            Some(TextEditCommand.Redo),
            editorFallbackKey(linuxKey(LogicalKey.Character("Z"), control = true, shift = true))
        )
        assertEquals(
            Some(TextEditCommand.Copy),
            editorFallbackKey(linuxKey(LogicalKey.Character("c"), control = true))
        )
        assertEquals(None, editorFallbackKey(linuxKey(LogicalKey.Character("c"), superKey = true)))
        assertEquals(
            Some(TextEditCommand.Move(TextMovement.LineStart, false)),
            editorFallbackKey(linuxKey(LogicalKey.Named(NamedKey.Home)))
        )
        assertEquals(
            Some(TextEditCommand.Move(TextMovement.DocumentStart, true)),
            editorFallbackKey(
                linuxKey(LogicalKey.Named(NamedKey.Home), control = true, shift = true)
            )
        )
        assertEquals(
            Some(TextEditCommand.Move(TextMovement.LineEnd, false)),
            editorFallbackKey(linuxKey(LogicalKey.Named(NamedKey.End)))
        )
        assertEquals(
            Some(TextEditCommand.Move(TextMovement.DocumentEnd, false)),
            editorFallbackKey(linuxKey(LogicalKey.Named(NamedKey.End), control = true))
        )
    }
}

private fun linuxKey(
    key: LogicalKey,
    control: Boolean = false,
    shift: Boolean = false,
    superKey: Boolean = false
): KeyEvent =
    KeyEvent(
        PhysicalKey.Unidentified(NativeKeyCode.LinuxEvdev(0u)),
        key,
        KeyLocation.Standard,
        ElementState.Pressed,
        false,
        Modifiers(
            shift,
            control,
            false,
            superKey,
            false,
            false,
            ModifierSides(None, None),
            ModifierSides(None, None),
            ModifierSides(None, None),
            ModifierSides(None, None)
        ),
        false,
        InputTime.Observed(MonotonicTimeSource.markNow())
    )
