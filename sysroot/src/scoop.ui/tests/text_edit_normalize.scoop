package scoop.ui.text

import scoop.test.*
import scoop.window.*

@Test
private class TextEditorSingleLineTest {
    @Test
    fun `single line paste and transform normalize their output before the next callback`() {
        val editor = TextEditorState("LR", Some(Utf8Selection(1L, 1L)))
        val policy = textEditPolicy {
            singleLine = true
            paste { candidate ->
                assertEquals("Lx yR", candidate.after.text)
                TextEditDecision
                    .Transform(
                        [
                            TextEditReplacement(Utf8Range(1L, 2L), "A\r"),
                            TextEditReplacement(Utf8Range(2L, 4L), "\nB")
                        ]
                    )
            }
            transform { candidate ->
                assertEquals("LA BR", candidate.after.text)
                assertEquals(4L, candidate.after.cursor.byteOffset)
                assertEquals(Utf8Range(1L, 4L), candidate.insertedRanges[0L])
                TextEditDecision.Transform([TextEditReplacement(Utf8Range(3L, 4L), "😀\u2028Z")])
            }
            acceptsInsertedText { text -> text == "A 😀 Z" }
        }
        assertTrue(editor.applyEdit(Utf8Range(1L, 1L), "x\r\ny", policy, TextEditSource.Paste))
        assertEquals("LA 😀 ZR", editor.text)
        assertEquals(Utf8Selection(9L, 9L), editor.selection)
        assertTrue(editor.undo())
        assertEquals("LR", editor.text)
        assertFalse(editor.canUndo)
    }

    @Test
    fun `host single line mode normalizes a transformed commit before attaching raw preedit`() {
        val policy = textEditPolicy {
            transform { candidate ->
                TextEditDecision
                    .Transform([TextEditReplacement(candidate.insertedRanges[0L], "a\r\nb")])
            }
        }
        val batch = TextInputBatch(
            None,
            [
                TextInputOperation.Commit("x", TextReplacement.CurrentSelection),
                TextInputOperation.Preedit("候\n", None, TextReplacement.CurrentSelection)
            ]
        )
        val single = TextEditorState()
        assertTrue(applyEditorInput(single, batch, singleLine = true, policy = policy))
        assertEquals("a b候\n", single.text)
        assertEquals(Some(Utf8Range(3L, 7L)), single.markedRange)
        val multiline = TextEditorState()
        assertTrue(multiline.applyInput(batch, policy))
        assertEquals("a\r\nb候\n", multiline.text)
    }

    @Test
    fun `single line conversion preserves raw ordered native replacement coordinates`() {
        val state = TextEditorState("A")
        assertTrue(
            applyEditorInput(
                state,
                TextInputBatch(
                    None,
                    [
                        TextInputOperation.Commit("😀\r\nB", TextReplacement.CurrentSelection),
                        TextInputOperation.Commit("中", TextReplacement.Range(Utf8Range(7L, 8L)))
                    ]
                ),
                true
            )
        )
        assertEquals("A😀 中", state.text)
        assertEquals(Utf8Selection(9L, 9L), state.selection)
        assertEquals(1L, state.revision)
        assertTrue(state.undo())
        assertEquals("A", state.text)
        assertFalse(state.canUndo)
        assertTrue(state.redo())
        assertEquals("A😀 中", state.text)
    }

    @Test
    fun `raw marked text preserves reverse selection and restores the replacement baseline`() {
        val state = TextEditorState("AZ", Some(Utf8Selection(2L, 1L)))
        applyEditorInput(
            state,
            TextInputBatch(
                None,
                [
                    TextInputOperation.Preedit(
                        "仮\r\n😀",
                        Some(Utf8Selection(9L, 5L)),
                        TextReplacement.CurrentSelection
                    )
                ]
            ),
            true
        )
        assertEquals("A仮\r\n😀", state.text)
        assertEquals(Utf8Selection(10L, 6L), state.selection)
        assertEquals(Some(Utf8Range(1L, 10L)), state.markedRange)
        applyEditorInput(
            state,
            TextInputBatch(
                None,
                [TextInputOperation.Preedit("", None, TextReplacement.CurrentSelection)]
            ),
            true
        )
        assertEquals("AZ", state.text)
        assertEquals(Utf8Selection(2L, 1L), state.selection)
        assertFalse(state.isComposing)
        assertFalse(state.canUndo)
    }

    @Test
    fun `a final composition retains a normalized baseline independently of completed edits`() {
        val state = TextEditorState()
        applyEditorInput(
            state,
            TextInputBatch(
                None,
                [
                    TextInputOperation.Commit("X\r\n", TextReplacement.CurrentSelection),
                    TextInputOperation.Preedit(
                        "y\u2028z",
                        Some(Utf8Selection(5L, 5L)),
                        TextReplacement.CurrentSelection
                    )
                ]
            ),
            true
        )
        assertEquals("X y\u2028z", state.text)
        assertEquals(Some(Utf8Range(2L, 7L)), state.markedRange)
        assertTrue(state.cancelComposition())
        assertEquals("X ", state.text)
        assertEquals(Utf8Selection(2L, 2L), state.selection)
        assertTrue(state.undo())
        assertEquals("", state.text)
        state.applyEdit(
            Utf8Range(0L, 0L),
            "a\r\nb\nc\rd\u0085e\u2029f",
            textEditPolicy { this.singleLine = true }
        )
        assertEquals("a b c d e f", state.text)
    }
}
