package scoop.ui

import scoop.platform.time.MonotonicInstant
import scoop.graphics.Point
import scoop.math.abs
import scoop.platform.time.MonotonicTimeSource
import scoop.test.*
import scoop.time.*
import scoop.window.InputTime

private fun contactTime(milliseconds: Long): InputTime =
    InputTime.Event(MonotonicInstant(MonotonicTimeSource, Duration.milliseconds(milliseconds)))

@Test
private class ScrollInertiaTest {
    @Test
    fun `contact velocity uses recent timestamps and forgets holds duplicate and reversed time`() {
        val value = ScrollVelocity()
        value.add(Point(0.0, 0.0), contactTime(0L))
        value.add(Point(0.0, -30.0), contactTime(30L))
        assertEquals(Point(0.0, -1000.0), value.value())
        value.add(Point(0.0, -60.0), contactTime(60L))
        value.add(Point(0.0, -60.0), contactTime(60L))
        assertEquals(Point(0.0, -1000.0), value.value())
        value.add(Point(0.0, -60.0), contactTime(180L))
        assertEquals(Point(0.0, 0.0), value.value())
        value.add(Point(0.0, -80.0), contactTime(190L))
        assertEquals(Point(0.0, -2000.0), value.value())
        value.add(Point(0.0, -90.0), contactTime(185L))
        assertEquals(Point(0.0, 0.0), value.value())
        value.add(Point(0.0, -100.0), contactTime(185L))
        assertEquals(Point(0.0, 0.0), value.value())
    }

    @Test
    fun `inertia clamps vector speed without changing its direction`() {
        val options = ScrollInertiaOptions(maxVelocity = 5000.0)
        val result = scrollInertiaVelocity(Point(6000.0, 8000.0), options)
        assertTrue(abs(result.x - 3000.0) < 0.000001)
        assertTrue(abs(result.y - 4000.0) < 0.000001)
        assertEquals(Point(0.0, 0.0), scrollInertiaVelocity(Point(10.0, 10.0), options))
        assertEquals(
            Point(0.0, 0.0),
            scrollInertiaVelocity(Point(6000.0, 8000.0), ScrollInertiaOptions(false))
        )
        val large = scrollInertiaVelocity(Point(1.0e300, -1.0e300), options)
        assertTrue(large.x > 3500.0 && large.x < 3600.0)
        assertEquals(-large.x, large.y)
    }

    @Test
    fun `inertia defaults and physical parameters are explicit and validated`() {
        val value = ScrollPhysicsOptions().inertia
        assertTrue(value.enabled)
        assertEquals(2400.0, value.deceleration)
        assertEquals(50.0, value.minVelocity)
        assertEquals(8000.0, value.maxVelocity)
        assertFailsWith<IllegalArgumentException> { ScrollInertiaOptions(deceleration = 0.0) }
        assertFailsWith<IllegalArgumentException> { ScrollInertiaOptions(minVelocity = -1.0) }
        assertFailsWith<IllegalArgumentException> { ScrollInertiaOptions(minVelocity = 9000.0) }
        assertFailsWith<IllegalArgumentException> { ScrollInertiaOptions(maxVelocity = 0.0) }
        assertFailsWith<IllegalArgumentException> { ScrollInertiaOptions(deceleration = 1.0e-300) }
        assertTrue(sameScrollInertia(value, ScrollInertiaOptions()))
        assertFalse(
            sameScrollPhysics(
                ScrollPhysicsOptions(),
                ScrollPhysicsOptions(inertia = ScrollInertiaOptions(false))
            )
        )
    }
}
