package scoop.ui

import scoop.test.*

@Test
private class DescriptionTypeTest {
    @Test
    fun `component matching preserves all generic arguments without touching props or factories`() {
        val records = ReuseRecords()
        val first =
            ComponentDescription(
                ReuseInput<Array<Int>>(1),
                {
                    props,
                    mount -> ReuseComponent<Int, Array<Int>>(
                        records.create(0L, 1, { props.value.version }),
                        scope = mount
                    )
                }
            )
        val same =
            ComponentDescription(
                ReuseInput<Array<Int>>(2),
                {
                    props,
                    mount -> ReuseComponent<Int, Array<Int>>(
                        records.create(0L, 2, { props.value.version }),
                        scope = mount
                    )
                }
            )
        val different: Array<ComponentDescriptionBase> =
            [
                ComponentDescription(
                    ReuseInput<Array<Long>>(2),
                    {
                        _,
                        mount -> ReuseComponent<Int, Array<Int>>(
                            records.create(0L, 2, { 2 }),
                            scope = mount
                        )
                    }
                ),
                ComponentDescription(
                    ReuseInput<Array<Int>>(2),
                    {
                        _,
                        mount -> ReuseComponent<Long, Array<Int>>(
                            records.create(0L, 2, { 2 }),
                            scope = mount
                        )
                    }
                ),
                ComponentDescription(
                    ReuseInput<Array<Int>>(2),
                    {
                        _,
                        mount -> ReuseComponent<Int, Array<Long>>(
                            records.create(0L, 2, { 2 }),
                            scope = mount
                        )
                    }
                )
            ]
        assertEquals(0L, records.values.size)
        assertTrue(first.sameType(same))
        assertTrue(same.sameType(first))
        for (other in different) {
            assertFalse(first.sameType(other))
            assertFalse(other.sameType(first))
        }
        assertEquals(0L, records.values.size)
    }

