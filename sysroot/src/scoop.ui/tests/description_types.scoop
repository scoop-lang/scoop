        assertEquals(0L, records.values.size)
    }

    @Test
    fun `view shapes remain distinct while portal modes share identity`() {
        val records = ReuseRecords()
        val open = state(true)
        val views =
            [
                empty(),
                direction(empty(), LayoutDirection.Ltr),
                component(
                    {
                        mount -> ReuseComponent<Int, Int>(
                            records.create(0L, 0, { 0 }),
                            scope = mount
                        )
                    }
                ),
                element(
                    { mount -> ReuseElement<Int, Int>(records.create(0L, 0, { 0 }), scope = mount) }
                ),
                lazyElement(
                    ReuseEmptyItems(),
                    { mount -> ReuseLazy<Int, Int>(records.create(0L, 0, { 0 }), scope = mount) }
                ),
                portal(open.binding(), empty()),
                portal(open.binding(), empty()) {
                    this.options {
                        this.mode = OverlayMode.Modal
                        this.focus = Some(OverlayFocusOptions())
                    }
                },
                portal(open.binding(), empty()) { this.mode = OverlayMode.FocusContained }
            ]
        for (left in 0L ..< views.size)
            for (right in 0L ..< views.size)
                assertEquals(
                    left == right || (left >= 5L && right >= 5L),
                    views[left].sameType(views[right])
                )
        assertTrue(views[1L].sameType(direction(views[2L], LayoutDirection.Rtl)))
        assertTrue(views[5L].sameType(portal(state(false).binding(), views[2L])))
        assertTrue(
            views[6L].sameType(
                portal(open.binding(), views[3L]) {
                    this.options {
                        this.mode = OverlayMode.Modal
                        this.focus = Some(OverlayFocusOptions())
                    }
                }
            )
        )
        assertEquals(0L, records.values.size)
    }
}
