                LazyDescription(
                    ReuseInput<Array<Long>>(2),
                    {
                        _,
                        mount -> ReuseLazy<Int, Array<Int>>(
                            records.create(0L, 2, { 2 }),
                            scope = mount
                        )
                    }
                ),
                LazyDescription(
