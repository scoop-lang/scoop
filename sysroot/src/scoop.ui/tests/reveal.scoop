package scoop.ui

import scoop.graphics.*
import scoop.graphics.native.captureGeometry
import scoop.math.abs
import scoop.test.*

@Test
private class RevealGeometryTest {
    @Test
    fun `scroll reveal maps submitted bounds through rotated scaled viewport geometry`() {
        RasterSurface(200, 200).use {
            surface -> surface.draw {
                canvas ->
                canvas.translate(40.0, 20.0)
                canvas.concat(Transform(a = 0.0, b = 2.0, c = -3.0, d = 0.0))
                @Unsafe
                {
                    captureGeometry(canvas, Rect(0.0, 0.0, 20.0, 20.0)).use {
                        geometry ->
                        val rect = localReveal(geometry, Rect(10.0, 24.0, 21.0, 10.0))!!
                        assertTrue(abs(rect.x - 2.0) < 0.00001)
                        assertTrue(abs(rect.y - 3.0) < 0.00001)
                        assertTrue(abs(rect.width - 5.0) < 0.00001)
                        assertTrue(abs(rect.height - 7.0) < 0.00001)
                    }
                }
            }
        }
    }

    @Test
    fun `singular viewport geometry cannot create a reveal position`() {
        RasterSurface(40, 40).use {
            surface -> surface.draw {
                canvas ->
                canvas.scale(0.0, 1.0)
                @Unsafe
                {
                    captureGeometry(canvas, Rect(0.0, 0.0, 20.0, 20.0)).use {
                        geometry -> assertEquals(
                            None,
                            localReveal(geometry, Rect(0.0, 0.0, 8.0, 8.0))
                        )
                    }
                }
            }
        }
    }
}
