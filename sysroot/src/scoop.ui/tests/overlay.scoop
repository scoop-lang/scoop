package scoop.ui

import scoop.graphics.*
import scoop.platform.concurrent.Thread
import scoop.test.*

@Test
private class OverlayPlacementTest {
    @Test
    fun `viewport alignment stays bounded even when padding fills the window`() {
        val plan = planOverlay(OverlayPlacement.Viewport(), Size(320.0, 200.0), None)
        assertEquals(Some(304.0), plan.constraints.maxWidth)
        assertEquals(Some(184.0), plan.constraints.maxHeight)
        val layout = plan.layout(Size(40.0, 20.0))
        assertEquals(Rect(140.0, 90.0, 40.0, 20.0), layout.bounds)
        assertEquals(Rect(8.0, 8.0, 304.0, 184.0), layout.available)
        assertEquals(None, layout.anchor)
        assertEquals(None, layout.side)
        val end =
            planOverlay(
                OverlayPlacement.Viewport(OverlayAlignment.End, OverlayAlignment.Start, 10.0),
                Size(320.0, 200.0),
                None
            )
        assertEquals(Rect(270.0, 10.0, 40.0, 20.0), end.layout(Size(40.0, 20.0)).bounds)
        val empty =
            planOverlay(
                OverlayPlacement.Viewport(viewportPadding = 1000.0),
                Size(100.0, 80.0),
                None
            )
        assertEquals(Some(0.0), empty.constraints.maxWidth)
        assertEquals(Some(0.0), empty.constraints.maxHeight)
        assertEquals(Rect(50.0, 40.0, 0.0, 0.0), empty.layout(Size(0.0, 0.0)).bounds)
    }

    @Test
    fun `anchored layout measures once for either side then flips and shifts`() {
        val anchor = Rect(270.0, 160.0, 30.0, 20.0)
        val plan =
            planOverlay(OverlayPlacement.Anchored(LayoutAnchor()), Size(320.0, 200.0), Some(anchor))
        assertEquals(Some(148.0), plan.constraints.maxHeight)
        val layout = plan.layout(Size(80.0, 50.0))
        assertEquals(Some(OverlaySide.Top), layout.side)
        assertEquals(Some(anchor), layout.anchor)
        assertEquals(Rect(232.0, 106.0, 80.0, 50.0), layout.bounds)
        assertEquals(Rect(8.0, 8.0, 304.0, 148.0), layout.available)
        val small = plan.layout(Size(20.0, 5.0))
        assertEquals(Some(OverlaySide.Bottom), small.side)
        assertEquals(Rect(270.0, 184.0, 20.0, 5.0), small.bounds)
    }

    @Test
    fun `horizontal alignment is physical and matching width is clamped to available space`() {
        val plan =
            planOverlay(
                OverlayPlacement.Anchored(
                    LayoutAnchor(),
                    OverlaySide.Left,
                    OverlayAlignment.End,
                    5.0,
                    10.0
                ),
                Size(320.0, 200.0),
                Some(Rect(100.0, 50.0, 30.0, 20.0))
            )
        assertEquals(Some(175.0), plan.constraints.maxWidth)
        val layout = plan.layout(Size(60.0, 40.0))
        assertEquals(Some(OverlaySide.Left), layout.side)
        assertEquals(Rect(35.0, 30.0, 60.0, 40.0), layout.bounds)
        val wide =
            planOverlay(
                OverlayPlacement.Anchored(LayoutAnchor(), matchAnchorWidth = true),
                Size(320.0, 200.0),
                Some(Rect(10.0, 50.0, 600.0, 20.0))
            )
        assertEquals(304.0, wide.constraints.minWidth)
        assertEquals(Some(304.0), wide.constraints.maxWidth)
        assertEquals(Rect(8.0, 74.0, 304.0, 30.0), wide.layout(Size(304.0, 30.0)).bounds)
    }

    @Test
    fun `offscreen anchors and large gaps do not produce out of viewport or nonfinite origins`() {
        val plan =
            planOverlay(
                OverlayPlacement.Anchored(LayoutAnchor()),
                Size(320.0, 200.0),
                Some(Rect(900.0, 1000.0, 50.0, 20.0))
            )
        assertEquals(Rect(232.0, 142.0, 80.0, 50.0), plan.layout(Size(80.0, 50.0)).bounds)
        val huge =
            planOverlay(
                OverlayPlacement.Anchored(LayoutAnchor(), gap = 1.7e308),
                Size(320.0, 200.0),
                Some(Rect(100.0, 50.0, 30.0, 20.0))
            )
        assertEquals(Some(0.0), huge.constraints.maxHeight)
        assertEquals(Rect(100.0, 192.0, 20.0, 0.0), huge.layout(Size(20.0, 0.0)).bounds)
    }

    @Test
    fun `content alignment uses local selected geometry and keeps one bounded fallback`() {
        val anchor = Rect(100.0, 150.0, 120.0, 32.0)
        val plan =
            planOverlay(
                OverlayPlacement.ContentAligned(LayoutAnchor()),
                Size(400.0, 400.0),
                Some(anchor)
            )
        assertEquals(120.0, plan.constraints.minWidth)
        assertEquals(Some(206.0), plan.constraints.maxHeight)
        val aligned =
            plan.layout(Size(120.0, 160.0), contentAnchor = Some(Rect(4.0, 60.0, 112.0, 28.0)))
        assertEquals(Rect(100.0, 92.0, 120.0, 160.0), aligned.bounds)
        assertEquals(None, aligned.side)
        assertEquals(Rect(8.0, 8.0, 384.0, 384.0), aligned.available)
        val fallback = plan.layout(Size(120.0, 160.0))
        assertEquals(Some(OverlaySide.Bottom), fallback.side)
        assertEquals(Rect(100.0, 186.0, 120.0, 160.0), fallback.bounds)
        val edge =
            plan.layout(Size(120.0, 160.0), contentAnchor = Some(Rect(4.0, 180.0, 112.0, 28.0)))
        assertEquals(8.0, edge.bounds.y)
        val rtl =
            planOverlay(
                OverlayPlacement.ContentAligned(LayoutAnchor(), alignment = OverlayAlignment.Start),
                Size(400.0, 400.0),
                Some(anchor),
                LayoutDirection.Rtl
            )
        assertEquals(
            104.0,
            rtl.layout(
                Size(120.0, 160.0),
                contentAnchor = Some(Rect(4.0, 60.0, 112.0, 28.0))
            ).bounds.x
        )
    }

    @Test
    fun `content anchor validation and builder copies preserve the placement contract`() {
        val anchor = LayoutAnchor()
        val original =
            portalOptions {
                contentAligned(anchor) {
                    gap = 7.0;
                    viewportPadding = 10.0
                }
            }
        val copied = original.copy { contentAligned(anchor) { alignment = OverlayAlignment.End } }
        when (copied.placement) {
            case ContentAligned(val value, val side, val alignment, val gap, val padding, val match) -> {
                assertTrue(value === anchor);
                assertEquals(OverlaySide.Bottom, side)
                assertEquals(OverlayAlignment.End, alignment);
                assertEquals(7.0, gap)
                assertEquals(10.0, padding);
                assertTrue(match)
            }
            else -> fail(Some("expected content alignment"))
        }
        checkLayoutMetrics(
            LayoutMetrics(Size(10.0, 10.0), overlayAnchor = Some(Rect(-10.0, 20.0, 5.0, 8.0))),
            Constraints()
        )
        for (
            rect in [
                Rect(0.0, 0.0, -1.0, 2.0),
                Rect(0.0 / 0.0, 0.0, 1.0, 1.0),
                Rect(1.7e308, 0.0, 1.7e308, 1.0)
            ]
        )
            assertFailsWith<IllegalArgumentException> {
                checkLayoutMetrics(
                    LayoutMetrics(Size(10.0, 10.0), overlayAnchor = Some(rect)),
                    Constraints()
                )
            }
        assertFailsWith<IllegalArgumentException> {
            portalOptions { contentAligned(anchor) { gap = -1.0 } }
        }
    }

    @Test
    fun `overlay configuration rejects invalid distances and references stay on their owner thread`() {
        val restore = FocusHandle()
        val pointerFocus =
            overlayFocusOptions {
                autoFocus = false;
                restoreTarget = Some(restore)
            }
        assertFalse(pointerFocus.autoFocus)
        assertTrue(pointerFocus.restoreFocus)
        assertTrue(pointerFocus.copy { restoreFocus = false }.restoreTarget!! === restore)
        val pointerPopup =
            portalOptions {
                focus {
                    autoFocus = false;
                    restoreTarget = Some(restore)
                }
            }
        assertFalse(pointerPopup.focus!!.autoFocus)
        val copy = pointerPopup.copy { focus { restoreFocus = false } }.focus!!
        assertFalse(copy.autoFocus)
        assertTrue(copy.restoreTarget!! === restore)
        for (mode in [OverlayMode.FocusContained, OverlayMode.Modal])
            assertFailsWith<IllegalArgumentException> {
                portalOptions {
                    this.mode = mode;
                    focus = Some(pointerFocus)
                }
            }
        assertFailsWith<IllegalArgumentException> {
            portalOptions { this.placement = OverlayPlacement.Viewport(viewportPadding = -1.0) }
        }
        assertFailsWith<IllegalArgumentException> {
            portalOptions {
                this.placement = OverlayPlacement.Anchored(LayoutAnchor(), gap = 0.0 / 0.0)
            }
        }
        assertTrue(
            portal(state(true).binding(), empty()).sameType(
                portal(state(true).binding(), empty()) {
                    this.options {
                        this.mode = OverlayMode.Modal
                        this.focus = Some(OverlayFocusOptions())
                    }
                }
            )
        )
        val anchor = LayoutAnchor()
        val handle = OverlayHandle()
        Thread.start {
            assertFailsWith<IllegalStateException> { anchor.isAttached }
            assertFailsWith<IllegalStateException> { handle.isOpen }
            assertFailsWith<IllegalStateException> { handle.requestClose() }
        }.use { thread -> thread.join() }
        assertFalse(anchor.isAttached)
        assertFalse(handle.isAttached)
        assertFalse(handle.isOpen)
        handle.requestClose()
        assertEquals(None, handle.lastCloseReason)
    }
}
