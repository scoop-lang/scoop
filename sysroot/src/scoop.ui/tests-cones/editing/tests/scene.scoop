package scoop.tests.ui.editing

import scoop.graphics.*
import scoop.surface.*
import scoop.test.*
import scoop.ui.*
import scoop.ui.text.*
import scoop.window.*

internal class EditScene(private val probe: EditProbe, scope: ComponentScope): Component(scope) {
    public override fun render(): View {
        val revision = probe.revision.value
        val children = ArrayList<View>()
        for (
            index in 0L ..<
                if (probe.showObserver)
                    3L
                else
                    2L
        ) {
            val input = probe.model(index).inputState
            children.add(
                element(
                    EditFieldProps(index, probe.options(index)),
                    { props, mount -> EditField(probe, props, scope = mount) },
                    key = ViewKey.Number(index)
                )
            )
        }
        if (probe.displayTest.show)
            children.add(selectableTestView(probe))
        return cachedScene(
            direction(
                element(
                    revision,
                    { props, mount -> EditPanel(probe, props, scope = mount) },
                    children.toArray()
                ),
                probe.systemIme.direction.value
            )
        )
    }
}

private class EditPanel(
    private val probe: EditProbe,
    private val props: Props<Int>,
    scope: ComponentScope
): Element<Unit>(scope) {
    public override fun onMount() {
        probe.scope = Some(scope)
        scope.input.captureHandler =
            {
                context,
                event -> when (event) {
                    case Keyboard(_) -> {
                        if (probe.preventKeys)
                            context.preventDefault()
                    }
                    case Pointer(
                        InputPointerEvent.Button(_, MouseButton.Left, ElementState.Released, _)
                    ) -> {
                        if (probe.preventRelease)
                            context.preventDefault()
                    }
                    else -> {}
                }
            }
        scope.input.defaultAction =
            {
                context,
                event -> when (event) {
                    case Keyboard(val key) -> {
                        if (
                            key.state ==
                                ElementState.Pressed &&
                                key.logicalKey ==
                                LogicalKey.Named(NamedKey.Escape)
                        ) {
                            probe.escapes += 1
                            context.consume()
                        }
                    }
                    else -> {}
                }
            }
    }
    public override fun measure(context: MeasureContext, constraints: Constraints): LayoutResult<
        Unit
    > {
        for (index in 0L ..< context.childCount) {
            val selectable = probe.displayTest.show && index == context.childCount - 1L
            context.measureChild(
                index,
                Constraints.tight(
                    if (selectable)
                        Size(probe.displayTest.width, 140.0)
                    else
                        if (index == 1L)
                            Size(probe.multiWidth, 72.0)
                        else
                            Size(probe.primaryWidth, 32.0)
                )
            )
            context.placeChild(
                index,
                if (selectable)
                    Point(30.0, 210.0)
                else
                    if (index == 0L)
                        Point(30.0, 30.0)
                    else
                        if (index == 1L)
                            Point(30.0, 100.0)
                        else
                            Point(260.0, 30.0)
            )
        }
        return LayoutResult(LayoutMetrics(constraints.constrain(Size(520.0, 400.0))), Unit)
    }
    public override fun scene(context: SceneContext, measured: Unit) {
        probe.passes += 1
        context.draw { paint -> paint.canvas.clear(Color.White) }
        context.scale(probe.scale, probe.scale)
        context.children()
        val version = props.value
        val revisions = Array<Long>(2L) { index -> probe.model(index).revision }
        val displayDiscard = probe.displayTest.discard
        if (displayDiscard != 0) {
            probe.displayTest.discard = 0
            probe.window!!.requestSize(
                LogicalSize(
                    if (displayDiscard == 1)
                        552.0
                    else
                        566.0,
                    440.0
                )
            )
        }
        val discard = probe.discardNext
        if (discard) {
            probe.discardNext = false
            probe.window!!.requestSize(LogicalSize(540.0, 420.0))
        }
        context.onFrameComplete {
            frame -> if (frame.submission == FrameSubmission.Accepted) {
                probe.accepted += 1
                probe.acceptedVersion = version
                probe.acceptedRevisions = revisions
            }
            else {
                if (displayDiscard != 0) {
                    displayFrameDiscarded(probe, displayDiscard)
                    probe.scope!!.requestFrame()
                    return@onFrameComplete
                }
                assertTrue(discard)
                probe.discarded += 1
                assertFalse(probe.savedLayout!!.isClosed)
                assertTrue(probe.field(1L).execute(TextEditCommand.Move(TextMovement.Up, false)))
                assertEquals(probe.expectedMove!!, probe.multiline.cursor)
                probe.scope!!.requestFrame()
            }
        }
    }
}

private class EditFieldProps(val index: Long, val options: TextEditOptions)

private class EditField(
    private val probe: EditProbe,
    private val props: Props<EditFieldProps>,
    scope: ComponentScope
): Element<TextEditMeasurement>(scope) {
    private val host =
        scope.resource {
            TextEditHost(
                scope,
                probe.model(props.value.index),
                probe.appearance,
                props.value.options,
                { value -> probe.interactionChanged(props.value.index, value) }
            )
        }
    public override fun onMount() {
        val index = props.value.index
        val adapter = host
        assertEquals(0, probe.interactionCounts[index])
        if (index == 0L)
            scope.resource {
                adapter.area.scope.addEventHandler {
                    _,
                    event -> when (event) {
                        case TextInput(TextInputEvent.Enabled(val connection)) -> {
                            probe.displayTest.imeStarts += 1
                            probe.displayTest.connection = connection
                        }
                        else -> {}
                    }
                }
            }
        probe.fields[index] = Some(adapter)
        probe.mounts += 1
        update()
        if (index == 0L)
            assertTrue(probe.focus[0L].requestFocus())
    }
    public override fun update(): UiInvalidation {
        val input = props.value
        host.update(
            probe.model(input.index),
            probe.appearance,
            input.options,
            FocusOptions(Some(probe.focus[input.index]), tabStop = input.index != 2L),
            "placeholder",
            { state -> probe.edited(state) },
            { _ -> probe.submits += 1 }
        )
        return UiInvalidation.Layout
    }
    public override fun measure(context: MeasureContext, constraints: Constraints): LayoutResult<
        TextEditMeasurement
    > {
        val measured = host.measure(constraints)
        return LayoutResult(measured.metrics, measured, { measured.close() })
    }
    public override fun scene(context: SceneContext, measured: TextEditMeasurement) {
        host.scene(context, measured)
    }
    public override fun onUnmount() {
        probe.unmounts += 1
    }
}
