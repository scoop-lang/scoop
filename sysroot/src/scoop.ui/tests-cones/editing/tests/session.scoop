package scoop.tests.ui.editing

import scoop.graphics.*
import scoop.graphics.text.*
import scoop.platform.time.MonotonicTimeSource
import scoop.surface.*
import scoop.test.*
import scoop.tests.surface.*
import scoop.tests.textfonts.testSansBytes
import scoop.tests.window.*
import scoop.time.Duration
import scoop.ui.*
import scoop.ui.text.*
import scoop.window.*

@Test
private class PublicTextEditHostTest {
    @Test
    fun `native editing system IME projections selection and scrolling share one host`() {
        @Unsafe
        {
            val clipboard = saveNativeClipboard() ?: fail(Some("cannot save clipboard"))
            try {
                FontCollection().use {
                    fonts ->
                    fonts.register(testSansBytes, "Host Test")
                    val probe = EditProbe(fonts)
                    try {
                        UiHost { host, active, event -> probe.event(host, active, event) }.use {
                            host -> Application(
                                applicationOptions { this.lastWindowPolicy = LastWindowPolicy.Exit }
                            ).run(host)
                        }
                        assertTrue(probe.finished)
                        assertTrue(probe.systemIme.complete)
                        assertEquals(3, probe.mounts)
                        assertEquals(probe.mounts, probe.unmounts)
                        assertEquals(1, probe.displayTest.mounts)
                        assertEquals(1, probe.displayTest.unmounts)
                        assertEquals(1, probe.displayTest.inlineMounts)
                        assertEquals(1, probe.displayTest.inlineUnmounts)
                        assertTrue(probe.displayTest.host!!.isClosed)
                        for (host in probe.fields)
                            assertTrue(host!!.isClosed)
                        assertTrue(probe.interactionCounts[0L] > 0)
                        assertTrue(probe.interactionCounts[1L] > 0)
                        assertEquals(0, probe.interactionCounts[2L])
                        for (focus in probe.focus)
                            assertFalse(focus.isAttached)
                        assertFalse(probe.frames!!.snapshot().required)
                        assertFalse(fonts.isClosed)
                    } catch (error: Throwable) {
                        println("editing phase=" + probe.phase.toString())
                        editingFailure(error)
                        throw error
                    } finally {
                        try {
                            probe.frames?.close()
                        }
                        finally {
                            probe.systemIme.restoreSource()
                        }
                    }
                }
            } finally {
                assertEquals(0, restoreNativeClipboard(clipboard))
            }
        }
    }
}

internal class EditProbe(val fonts: FontCollection) {
    val systemIme = SystemImeProbe()
    val displayTest = DisplayProbe()
    val primary = TextEditorState("A😀éZ")
    val multiline = TextEditorState("one two\nthree")
    val focus = Array<FocusHandle>(3L) { _ -> FocusHandle() }
    val fields = MutableArray<TextEditHost?>(3L) { _ -> None }
    val interactionCounts = MutableArray<Int>(3L) { _ -> 0 }
    private val interactions = MutableArray<TextEditInteraction>(3L) { _ -> TextEditInteraction() }
    val revision = state(0)
    val appearance =
        TextEditAppearance(
            fonts,
            textStyle {
                this.families = ["Host Test"]
                this.fontSize = 20.0
            },
            textStyle {
                this.families = ["Host Test"]
                this.fontSize = 20.0
                this.color = Color(0.5, 0.5, 0.5)
            }
        )
    var policy = textEditPolicy()
    var readonly = false
    var showObserver = true
    var tab = TextTabBehavior.Navigate
    var blink = Duration.milliseconds(0L)
    var primaryWidth = 128.0
    var multiWidth = 180.0
    var scale = 1.0
    var preventKeys = false
    var preventRelease = false
    var checkSnapshot = false
    var discarded = 0
    var discardNext = false
    var savedLayout: TextEditLayout? = None
    var expectedMove: TextPosition? = None
    var savedEdits = 0
    var savedPasses = 0
    var savedLength = 0L
    var edits = 0
    var submits = 0
    var escapes = 0
    var mounts = 0
    var unmounts = 0
    var passes = 0
    var accepted = 0
    var acceptedVersion = -1
    var acceptedRevisions: Array<Long> = [-1L, -1L]
    var phase = 0
    var waiting = false
    var retriedFocus = false
    var finished = false
    var window: Window? = None
    var ui: UiWindow? = None
    var active: ActiveApplication? = None
    var scope: ComponentScope? = None
    var frames: FrameProbe? = None
    var checkpoint: WindowDeadline? = None
    var action: () -> Unit = {}

    fun options(index: Long): TextEditOptions =
        TextEditOptions(
            multiline = index == 1L,
            readOnly =
                if (index == 2L)
                    true
                else
                    readonly,
            enabled = index != 2L,
            tab = tab,
            submit =
                if (index == 1L)
                    TextSubmitKeys.PrimaryEnter
                else
                    TextSubmitKeys.Enter,
            paintCache = PaintCachePolicy.Tiles(64, 0),
            caretBlink = blink,
            policy = policy,
            projection = displayTest.projection,
            copy = displayTest.copy
        )
    fun model(index: Long): TextEditorState =
        if (index == 1L)
            multiline
        else
            primary
    fun field(index: Long): TextEditHost = fields[index]!!
    fun interactionChanged(index: Long, value: TextEditInteraction) {
        assertEquals(value, field(index).interaction)
        assertFalse(interactions[index] == value)
        interactions[index] = value
        interactionCounts[index] += 1
    }
    fun change() {
        revision.value += 1
    }
    fun edited(state: TextEditorState) {
        edits += 1
        if (checkSnapshot) {
            assertTrue(
                editorDocument(window!!, state),
                Some(f"immediate text snapshot phase=${this @EditProbe.phase}")
            )
            editorNativeCaret(window!!, state, None)
        }
    }
    fun event(host: UiHost, application: ActiveApplication, event: ApplicationEvent) {
        when (event) {
            case Resumed -> {
                active = Some(application)
                val native =
                    application.createWindow(
                        windowAttributes {
                            this.title = "Scoop text editing"
                            this.size = LogicalSize(520.0, 400.0)
                        }
                    )
                window = Some(native)
                native.setWindowLevel(WindowLevel.AlwaysOnTop)
                native.requestFocus()
                frames = Some(observeFrames(native))
                checkpoint =
                    Some(
                        native.createDeadline {
                            val current = action
                            assertTrue(application.proxy().post { _ -> current() })
                        }
                    )
                ui = host.attach(native, { mount -> EditScene(this, scope = mount) })
                application.setControlFlow(
                    ControlFlow.WaitUntil(MonotonicTimeSource.markNow() + Duration.seconds(40L))
                )
            }
            case AboutToWait -> {
                if (phase == 0 && accepted > 0 && !nativeFocused() && !retriedFocus) {
                    retriedFocus = true
                    window!!.requestFocus()
                }
                if (!finished && phase < 91 && !waiting && settled()) {
                    waiting = true
                    assertTrue(
                        application.proxy().post {
                            _ ->
                            waiting = false
                            if (settled())
                                advanceEditing(this)
                        }
                    )
                }
            }
            case Window(_, WindowEvent.Destroyed) -> {
                finished = phase == 91
                application.requestExit()
            }
            case NewEvents(StartCause.Deadline) -> fail(
                Some(
                    f"editor timeout phase=${this @EditProbe.phase}, passes=${
                        this @EditProbe.passes
                    }, accepted=${this @EditProbe.accepted}"
                )
            )
            else -> {}
        }
    }
    private fun nativeFocused(): Boolean = window!!.isFocused
    private fun settled(): Boolean {
        if (accepted == 0 || !nativeFocused() || frames!!.snapshot().required)
            return false
        if (acceptedVersion != revision.value)
            return false
        if (displayTest.focus.isPending || displayTest.actionFocus.isPending)
            return false
        for (target in focus)
            if (target.isPending)
                return false
        for (index in 0L ..< 2L) {
            if (acceptedRevisions[index] != model(index).revision)
                return false
            val host = fields[index] ?: return false
            if (host.area.isFocusActive && !readonly && !editorDocument(window!!, model(index)))
                return false
        }
        return true
    }
    fun next(block: () -> Unit) {
        phase += 1
        waiting = true
        block()
        assertTrue(active!!.proxy().post { _ -> waiting = false })
    }
    fun later(block: () -> Unit) {
        waiting = true
        action =
            {
                block()
                waiting = false
            }
        checkpoint!!.schedule(MonotonicTimeSource.markNow() + Duration.milliseconds(140L))
    }
    fun point(index: Long, byte: Long): Point {
        val host = field(index)
        val caret = host.caret(TextPosition(byte))!!
        val rect = host.area.toWindow(Rect(caret.x, caret.y + caret.height / 2.0, 0.0, 0.0))!!
        return Point(rect.x, rect.y)
    }
    fun click(index: Long, byte: Long, count: Int = 1, shift: Boolean = false) {
        val point = point(index, byte)
        editorPointer(window!!, point, true, count, shift)
        editorPointer(window!!, point, false, count, shift)
    }
}

private fun editingFailure(error: Throwable) {
    if (error is ResourceUseException) {
        editingFailure(error.primaryFailure)
        editingFailure(error.cleanupFailure)
    } else
        if (error is AssertionFailure) {
            println(
                error.location.file +
                    ":" +
                    error.location.line.toString() +
                    ": " +
                    (error.message ?: "assertion")
            )
            when (error.expected) {
                case Text(val value) -> println("expected: " + value);
                else -> {}
            }
            when (error.actual) {
                case Text(val value) -> println("actual: " + value);
                else -> {}
            }
        } else
            if (error is Exception)
                println(error.message ?: "editing failure")
}
