package scoop.tests.ui.drag

import scoop.graphics.*
import scoop.platform.time.MonotonicTimeSource
import scoop.surface.*
import scoop.test.*
import scoop.tests.surface.*
import scoop.tests.window.postDragInput
import scoop.time.Duration
import scoop.ui.*
import scoop.window.*
import scoop.window.native.*

@Test
private class UiDragSourceSessionTest {
    @Test
    fun `accepted source geometry preserves clicks and owns pending native completion`() {
        val probe = SourceSessionProbe()
        try {
            UiHost { host, active, event -> probe.event(host, active, event) }.use {
                host -> Application().run(host)
            }
            assertTrue(probe.finished)
            assertEquals(3, probe.clicks)
            assertEquals(5, probe.prepared)
            assertEquals(1, probe.completed)
            assertTrue(probe.source!!.isClosed)
            assertTrue(probe.view!!.restored())
        } finally {
            probe.view?.close()
        }
    }
}

internal class SourceSessionProbe {
    var source: DragSource? = None
    var press: Press? = None
    var window: Window? = None
    var ui: UiWindow? = None
    var view: ViewProbe? = None
    var ready = false
    var finished = false
    var clicks = 0
    var prepared = 0
    var completed = 0
    private var stage = 0
    private var mode = 0
    private var events = 0
    private var expected = 0
    private var queued = false

    fun prepare(value: DragSourceStart): DragSourceData? {
        prepared += 1
        assertEquals(Point(10.0, 12.5), value.start)
        assertEquals(Point(16.0, 12.5), value.position)
        assertEquals(LogicalPosition(40.0, 45.0), value.press.state.logicalPosition)
        assertEquals(LogicalPosition(52.0, 45.0), value.pointer.state.logicalPosition)
        if (mode == 0)
            return None
        val preparedMode = mode
        if (mode == 3) {
            assertTrue(source!!.cancelPending())
            assertFalse(source!!.cancelPending())
        }
        return Some(
            DragSourceData(
                DragContent.Text("prepared source"),
                onCompleted =
                    {
                        result ->
                        assertEquals(1, preparedMode)
                        assertFalse(source!!.isDragging)
                        assertFalse(press!!.interaction.pressed)
                        when (result) {
                            case NotDropped -> completed += 1
                            else -> fail(Some("pending cancellation must not start an OS session"))
                        }
                    }
            )
        )
    }

    fun event(host: UiHost, active: ActiveApplication, event: ApplicationEvent) {
        when (event) {
            case Resumed -> {
                val native =
                    active.createWindow(
                        windowAttributes {
                            title = "Scoop data source preparation"
                            size = LogicalSize(260.0, 180.0)
                            visible = false
                            requestActivation = false
                        }
                    )
                window = Some(native)
                view = Some(observeWindow(native))
                ui = host.attach(native, { scope -> SourceSessionRoot(this, scope) })
                active.setControlFlow(
                    ControlFlow.WaitUntil(MonotonicTimeSource.markNow() + Duration.seconds(15L))
                )
                native.setVisible(true)
            }
            case Window(_, WindowEvent.Pointer(val pointer)) -> {
                when (pointer) {
                    case Button(_, MouseButton.Left, _, _) -> events += 1
                    case Moved(_) -> {
                        events += 1
                        if (source?.isDragging ?: false) {
                            when (mode) {
                                case 1 -> {
                                    source!!.update(DragSourceOptions()) {
                                        _ -> fail(Some("new factory is for the next drag"))
                                    }
                                    assertTrue(source!!.cancelPending())
                                    assertFalse(source!!.cancelPending())
                                }
                                case 2 -> source!!.update(DragSourceOptions(enabled = false)) {
                                    _ -> fail()
                                }
                                case 4 -> ui!!.close()
                                else -> fail(Some("unexpected active source"))
                            }
                        }
                    }
                    else -> {}
                }
            }
            case AboutToWait -> {
                if (
                    ready &&
                        !finished &&
                        !queued &&
                        events >=
                        expected &&
                        (stage != 9 || completed == 1)
                ) {
                    queued = true
                    active.proxy().post {
                        application ->
                        queued = false
                        advance(application)
                    }
                }
            }
            case NewEvents(StartCause.Deadline) -> fail(
                Some(
                    f"source session timeout: accepted=${ready}, stage=${stage}, events=${events}/${
                        expected
                    }"
                )
            )
            else -> {}
        }
    }

    private fun configure(value: Int, threshold: Double = 4.0) {
        mode = value
        source!!.update(DragSourceOptions(threshold)) { start -> prepare(start) }
    }
    private fun input(kind: Int) {
        expected += 1
        @Unsafe
        {
            window!!.acquireNativeWindow().use {
                lease -> @Unsafe
                {
                    when (lease.handle) {
                        case AppKit(_, val view) -> postDragInput(view, kind)
                    }
                }
            }
        }
    }
    private fun release(x: Double) {
        expected += 1
        assertTrue(view!!.button(x, 45.0, false))
    }
    private fun advance(active: ActiveApplication) {
        when (stage) {
            case 0 -> {
                configure(0, 20.0);
                input(0)
            }
            case 1 -> input(1)
            case 2 -> {
                assertEquals(0, prepared);
                assertTrue(press!!.interaction.pressed);
                release(52.0)
            }
            case 3 -> {
                assertEquals(1, clicks);
                configure(0);
                input(0)
            }
            case 4 -> input(1)
            case 5 -> {
                assertEquals(1, prepared);
                input(2)
            }
            case 6 -> {
                assertEquals(1, prepared);
                release(64.0)
            }
            case 7 -> {
                assertEquals(2, clicks);
                configure(1);
                input(0)
            }
            case 8 -> input(1)
            case 9 -> {
                assertEquals(1, completed);
                assertFalse(source!!.isDragging);
                configure(2);
                input(0)
            }
            case 10 -> input(1)
            case 11 -> {
                assertFalse(source!!.isDragging);
                assertEquals(1, completed);
                configure(3);
                input(0)
            }
            case 12 -> input(1)
            case 13 -> {
                assertFalse(source!!.isDragging);
                assertTrue(press!!.interaction.pressed);
                release(52.0)
            }
            case 14 -> {
                assertEquals(3, clicks);
                configure(4);
                input(0)
            }
            case 15 -> input(1)
            else -> {
                assertTrue(ui!!.isClosed);
                finished = true;
                active.requestExit()
            }
        }
        stage += 1
    }
}

private class SourceSessionRoot(
    private val probe: SourceSessionProbe,
    scope: ComponentScope
): Component(scope) {
    public override fun render(): View = element({ scope -> SourceSessionElement(probe, scope) })
}

private class SourceSessionElement(
    private val probe: SourceSessionProbe,
    scope: ComponentScope
): Element<Unit>(scope) {
    private val area = scope.createArea()
    init {
        probe.source = Some(scope.dragSource(area) { value -> probe.prepare(value) })
        probe.press = Some(scope.press(area) { probe.clicks += 1 })
    }
    public override fun measure(context: MeasureContext, constraints: Constraints): LayoutResult<
        Unit
    > = LayoutResult(LayoutMetrics(constraints.constrain(Size(260.0, 180.0))), Unit)
    public override fun scene(context: SceneContext, value: Unit) {
        context.translate(20.0, 20.0)
        context.scale(2.0, 2.0)
        context.place(area, Rect(0.0, 0.0, 100.0, 60.0))
        context.draw { paint -> paint.canvas.clear(Color.White) }
        context.onFrameComplete {
            frame -> if (frame.submission == FrameSubmission.Accepted)
                probe.ready = true
        }
    }
}
