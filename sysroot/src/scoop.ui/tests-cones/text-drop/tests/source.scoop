package scoop.tests.ui.textdrop

import scoop.graphics.*
import scoop.graphics.text.*
import scoop.platform.time.MonotonicTimeSource
import scoop.surface.*
import scoop.test.*
import scoop.time.Duration
import scoop.ui.*
import scoop.ui.text.*
import scoop.window.*

internal class TextSourceProbe(val fonts: FontCollection) {
    val model = TextEditorState("a😀b", Some(Utf8Selection(5L, 1L)))
    val content =
        styledText {
            text("read only");
            style {
                families = ["Drop Test"];
                fontSize = 20.0
            }
        }
    val appearance =
        TextEditAppearance(
            fonts,
            textStyle {
                families = ["Drop Test"];
                fontSize = 20.0
            }
        )
    private val plain = textProjection()
    var editor: TextEditHost? = None
    var selectable: SelectableTextHost? = None
    var native: NativeTextDrop? = None
    var frames = 0
    var prepared = 0
    var callbacks = 0
    var finished = false
    var started = false
    private var testCase = 0
    private var step = 0
    private var requiredFrames = 1
    private var waiting = false
    private var expected = Point(0.0, 0.0)
    private var origin = Point(0.0, 0.0)
    private var expectedKind = 0

    private fun drag(enabled: Boolean = true): TextDragOptions =
        TextDragOptions(
            enabled = enabled && testCase != 7,
            copyPolicy =
                if (testCase == 4)
                    TextCopyPolicy.Allow
                else
                    TextCopyPolicy.Default,
            onCompleted = { _ -> callbacks += 1 }
        )

    private fun options(enabled: Boolean = true): TextEditOptions =
        TextEditOptions(
            readOnly = testCase == 2,
            projection = plain,
            copy = TextCopyPolicy.Allow,
            protectedText = testCase == 3 || testCase == 4,
            drag = drag(enabled),
            caretBlink = Some(Duration.milliseconds(0L))
        )

    fun configure(enabled: Boolean = true) {
        editor!!.update(model, appearance, options(enabled))
        selectable!!.update(fonts, content, SelectableTextOptions(drag = drag(enabled)))
    }

    fun input(event: InputEvent, readonly: Boolean) {
        if (!waiting || readonly != (testCase == 8))
            return
        val input =
            when (event) {
                case Pointer(
                    InputPointerEvent.Button(val value, MouseButton.Left, val state, _)
                ) -> {
                    val kind =
                        if (state == ElementState.Pressed)
                            0
                        else
                            2
                    if (kind != expectedKind)
                        return
                    value
                }
                case Pointer(InputPointerEvent.Moved(val value)) -> {
                    if (expectedKind != 1)
                        return
                    value
                }
                else -> return
            }
        if (input.state.logicalPosition != LogicalPosition(expected.x, expected.y))
            return
        waiting = false
        val export = testCase == 1 || testCase == 2 || testCase == 4 || testCase == 8
        if (step == 0) {
            assertEquals(0, native!!.sourceMask())
            if (export || testCase == 0) {
                if (readonly)
                    assertEquals(Utf8Selection(0L, content.text.byteLength), selectable!!.selection)
                else
                    assertEquals(Utf8Selection(5L, 1L), model.selection)
            }
            step = 1
        } else
            if (step == 1 && testCase != 0) {
                if (export) {
                    assertEquals(
                        if (testCase == 2 || readonly)
                            1
                        else
                            17,
                        native!!.sourceMask()
                    )
                    native!!.assertSource(
                        if (readonly)
                            "read only"
                        else
                            "😀"
                    )
                    prepared += 1
                    configure(false)
                    assertEquals(0, native!!.sourceMask())
                    step = 3
                } else {
                    assertEquals(0, native!!.sourceMask())
                    step = 2
                }
            } else {
                if (testCase == 0)
                    assertEquals(model.selection.anchor, model.selection.cursor)
                assertEquals(0, native!!.sourceMask())
                step = 3
            }
        assertEquals("a😀b", model.text)
        assertFalse(model.canUndo)
    }

    fun event(host: UiHost, active: ActiveApplication, event: ApplicationEvent) {
        when (event) {
            case Resumed -> {
                started = true
                val window =
                    active.createWindow(
                        windowAttributes {
                            title = "Scoop text source preparation"
                            size = LogicalSize(240.0, 160.0)
                            visible = false
                        }
                    )
                native = Some(nativeTextDrop(window))
                host.attach(window, { scope -> TextSourceRoot(this, scope) })
                active.setControlFlow(
                    ControlFlow.WaitUntil(MonotonicTimeSource.markNow() + Duration.seconds(15L))
                )
                window.setVisible(true)
            }
            case AboutToWait -> {
                if (finished || waiting || frames < requiredFrames)
                    return
                if (step == 3) {
                    testCase += 1
                    if (testCase == 9) {
                        finished = true
                        active.requestExit()
                        return
                    }
                    model.replaceAll("a😀b", Some(Utf8Selection(5L, 1L)))
                    configure()
                    selectable!!.setSelection(
                        TextPosition(0L),
                        TextPosition(content.text.byteLength)
                    )
                    step = 0
                    requiredFrames = frames + 1
                    return
                }
                if (step == 0) {
                    val box =
                        if (testCase == 8)
                            selectable!!.selectionBounds()[0L].rect
                        else
                            editor!!.selectionBounds(model.selection.range)[0L].rect
                    origin =
                        Point(
                            20.0 + box.x + 1.0,
                            (
                                if (testCase == 8)
                                    90.0
                                else
                                    20.0
                            ) +
                                box.y +
                                box.height /
                                2.0
                        )
                }
                expectedKind =
                    if (step == 0)
                        0
                    else
                        if (step == 1 && testCase != 0)
                            1
                        else
                            2
                expected =
                    if (expectedKind == 0 || testCase == 0)
                        origin
                    else
                        Point(origin.x + 12.0, origin.y)
                waiting = true
                native!!.input(
                    expectedKind,
                    expected,
                    if (testCase == 6)
                        2
                    else
                        1,
                    testCase == 5
                )
            }
            case NewEvents(StartCause.Deadline) -> fail(
                Some(f"text source timeout: case=${testCase}, step=${step}, frames=${frames}")
            )
            else -> {}
        }
    }
}

private class TextSourceRoot(private val probe: TextSourceProbe, scope: ComponentScope): Component(
    scope
) {
    public override fun render(): View = element({ mount -> TextSourceFields(probe, mount) })
}

private struct SourceMeasurements(val editor: TextEditMeasurement, val text: ParagraphMeasurement)

private class TextSourceFields(private val probe: TextSourceProbe, scope: ComponentScope): Element<
    SourceMeasurements
>(scope) {
    private val editor = scope.resource { TextEditHost(scope, probe.model, probe.appearance) }
    private val text = scope.resource { SelectableTextHost(scope, probe.fonts, probe.content) }
    public override fun onMount() {
        probe.editor = Some(editor)
        probe.selectable = Some(text)
        probe.configure()
        text.setSelection(TextPosition(0L), TextPosition(probe.content.text.byteLength))
        scope.resource { editor.area.scope.addEventFinished { event -> probe.input(event, false) } }
        scope.resource { text.area.scope.addEventFinished { event -> probe.input(event, true) } }
    }
    public override fun measure(context: MeasureContext, constraints: Constraints): LayoutResult<
        SourceMeasurements
    > {
        val edited = editor.measure(Constraints.tight(Size(180.0, 45.0)))
        val selected = text.measure(context, Constraints(maxWidth = Some(180.0)))
        return LayoutResult(
            LayoutMetrics(constraints.constrain(Size(240.0, 160.0))),
            SourceMeasurements(edited, selected),
            {
                edited.close();
                selected.close()
            }
        )
    }
    public override fun scene(context: SceneContext, measured: SourceMeasurements) {
        context.draw { paint -> paint.canvas.clear(Color.White) }
        context.translate(20.0, 20.0)
        editor.scene(context, measured.editor)
        context.translate(0.0, 70.0)
        text.scene(context, measured.text)
        context.onFrameComplete {
            frame -> if (frame.submission == FrameSubmission.Accepted)
                probe.frames += 1
        }
    }
}
