package scoop.tests.ui.gestures

import scoop.graphics.*
import scoop.platform.time.MonotonicTimeSource
import scoop.surface.*
import scoop.test.*
import scoop.tests.surface.*
import scoop.time.Duration
import scoop.ui.*
import scoop.window.*

@Test
private class PressDragUiTest {
    @Test
    fun `press composes with axis claims committed transforms and reentrant owner closure`() {
        val probe = GestureProbe()
        try {
            UiHost { host, active, event -> probe.event(host, active, event) }.use {
                host -> Application(
                    applicationOptions { lastWindowPolicy = LastWindowPolicy.Exit }
                ).run(host)
            }
            assertTrue(probe.finished)
            assertEquals(1, probe.mounts)
            assertEquals(1, probe.unmounts)
            assertEquals(123, probe.clicks)
            assertTrue(probe.originalCalls > 0)
            assertTrue(probe.press!!.isClosed)
            assertTrue(probe.drag!!.isClosed)
            assertTrue(probe.area!!.isClosed)
            assertTrue(probe.view!!.restored())
        } catch (error: Throwable) {
            println(
                f"gesture phase=${probe.phase}, events=${probe.completed}, clicks=${probe.clicks}"
            )
            reportGestureFailure(error)
            throw error
        } finally {
            probe.view?.close()
        }
    }
}

private fun reportGestureFailure(error: Throwable) {
    if (error is ResourceUseException) {
        reportGestureFailure(error.primaryFailure);
        reportGestureFailure(error.cleanupFailure)
    }
    else
        if (error is AssertionFailure) {
            println(
                f"${error.kind}: ${error.location.file}:${error.location.line} ${
                    error.message ?: ""
                }"
            )
            when (error.expected) {
                case Text(value) -> println(f"expected ${value}");
                else -> {}
            }
            when (error.actual) {
                case Text(value) -> println(f"actual ${value}");
                else -> {}
            }
        } else
            if (error is Exception)
                println(error.message ?: "gesture failure")
}

internal class GestureProbe {
    val shift = state(0.0)
    var committedShift: Double? = None
    var parent: InputArea? = None
    var area: InputArea? = None
    var scope: ComponentScope? = None
    var press: Press? = None
    var drag: Drag? = None
    var window: Window? = None
    var view: ViewProbe? = None
    var mounts = 0
    var unmounts = 0
    var clicks = 0
    var originalCalls = 0
    var childCancellations = 0
    var completed = 0
    var preventRelease = false
    var finished = false
    var phase = 0
    private var runtime: UiHost? = None
    private var expected = 0
    private var pending = false
    private var starts = 0
    private var ends = 0
    private var cancels = 0
    private var last: DragSample? = None
    private var focusRetried = false

    fun dragged(event: DragEvent) {
        when (event) {
            case Started(value) -> {
                starts += 1;
                last = Some(value)
            }
            case Moved(value) -> last = Some(value)
            case Ended(value) -> {
                ends += 1;
                last = Some(value)
            }
            case Cancelled(value, _) -> {
                cancels += 1;
                last = Some(value)
            }
        }
    }
    fun event(host: UiHost, active: ActiveApplication, event: ApplicationEvent) {
        when (event) {
            case Resumed -> {
                runtime = Some(host)
                val native =
                    active.createWindow(
                        windowAttributes {
                            title = "Scoop press and drag";
                            size = LogicalSize(260.0, 160.0);
                            visible = false
                        }
                    )
                window = Some(native)
                view = Some(observeWindow(native))
                host.attach(native, { GestureRoot(this) })
                active.setControlFlow(
                    ControlFlow.WaitUntil(MonotonicTimeSource.markNow() + Duration.seconds(30L))
                )
                active.proxy().post {
                    _ ->
                    native.setVisible(true);
                    native.setWindowLevel(WindowLevel.AlwaysOnTop);
                    native.requestFocus()
                }
            }
            case AboutToWait -> {
                val native = window ?: return
                if (finished || native.state != WindowState.Open || committedShift == None)
                    return
                if (!native.isFocused && !focusRetried) {
                    focusRetried = true;
                    native.requestFocus()
                }
                if (!pending && native.isFocused && completed >= expected) {
                    pending = true
                    active.proxy().post {
                        application ->
                        pending = false;
                        if (!finished)
                            advance(application)
                    }
                }
            }
            case Window(_, WindowEvent.Destroyed) -> active.requestExit()
            case NewEvents(StartCause.Deadline) -> fail(Some("press and drag timeout"))
            else -> {}
        }
    }
    private fun move(x: Double, y: Double) {
        expected += 1;
        assertTrue(moveSurfacePointer(window!!, x, y))
    }
    private fun button(x: Double, y: Double, down: Boolean) {
        expected += 1;
        assertTrue(view!!.button(x, y, down))
    }
    private fun key(code: Int, down: Boolean, repeat: Boolean = false, command: Boolean = false) {
        expected += 1;
        assertTrue(sendSurfaceKey(window!!, code, down, repeat, command))
    }
    private fun dragEnabled(value: Boolean) {
        drag!!.update(
            DragOptions(DragAxis.Horizontal, enabled = value),
            { _ -> true },
            { event -> dragged(event) }
        )
    }

    private fun repeatedClockMoves(active: ActiveApplication) {
        val mark = MonotonicTimeSource.markNow()
        routedMove(active, 60.0, InputTime.Event(mark))
        routedMove(active, 70.0, InputTime.Event(mark))
        assertEquals(0.0, last!!.velocity)
        routedMove(active, 70.0, InputTime.Event(mark + Duration.milliseconds(-1L)))
        assertEquals(0.0, last!!.velocity)
    }
    private fun routedMove(active: ActiveApplication, x: Double, time: InputTime) {
        val scale = window!!.metrics!!.scaleFactor
        val modifiers =
            Modifiers(
                false,
                false,
                false,
                false,
                false,
                false,
                ModifierSides(None, None),
                ModifierSides(None, None),
                ModifierSides(None, None),
                ModifierSides(None, None)
            )
        val pointer =
            PointerState(
                LogicalPosition(x, 30.0),
                PhysicalPosition(x * scale, 30.0 * scale),
                scale,
                modifiers,
                time
            )
        expected += 1
        runtime!!.onEvent(
            active,
            ApplicationEvent.Window(window!!.id, WindowEvent.Pointer(PointerEvent.Moved(pointer)))
        )
    }

    private fun advance(active: ActiveApplication) {
        when (phase) {
            case 0 -> {
                move(30.0, 30.0);
                button(30.0, 30.0, true);
                phase = 1
            }
            case 1 -> {
                assertTrue(press!!.interaction.pressed);
                move(130.0, 30.0);
                phase = 2
            }
            case 2 -> {
                assertFalse(press!!.interaction.pressed);
                move(30.0, 30.0);
                phase = 3
            }
            case 3 -> {
                assertTrue(press!!.interaction.pressed);
                button(30.0, 30.0, false);
                phase = 4
            }
            case 4 -> {
                assertEquals(1, clicks);
                key(49, true);
                phase = 5
            }
            case 5 -> {
                assertTrue(press!!.interaction.pressed);
                key(49, true, true);
                key(49, false);
                phase = 6
            }
            case 6 -> {
                assertEquals(2, clicks);
                key(49, true, command = true);
                key(49, false, command = true);
                phase = 7
            }
            case 7 -> {
                assertEquals(2, clicks);
                key(36, true);
                phase = 8
            }
            case 8 -> {
                assertEquals(3, clicks);
                key(36, true, true);
                key(36, false);
                phase = 9
            }
            case 9 -> {
                assertEquals(3, clicks);
                assertFalse(press!!.interaction.pressed);
                button(30.0, 30.0, true);
                phase = 10
            }
            case 10 -> {
                press!!.update(PressOptions(enabled = false), { clicks += 10 });
                button(30.0, 30.0, false);
                phase = 11
            }
            case 11 -> {
                assertEquals(3, clicks);
                press!!.update(PressOptions(), { clicks += 10 });
                button(30.0, 30.0, true);
                phase = 12
            }
            case 12 -> {
                preventRelease = true;
                button(30.0, 30.0, false);
                phase = 13
            }
            case 13 -> {
                assertEquals(3, clicks);
                assertFalse(press!!.interaction.pressed);
                preventRelease = false;
                dragEnabled(true);
                button(30.0, 30.0, true);
                move(32.0, 30.0);
                button(32.0, 30.0, false);
                phase = 14
            }
            case 14 -> {
                assertEquals(13, clicks);
                assertEquals(0, starts);
                button(30.0, 30.0, true);
                move(50.0, 30.0);
                phase = 15
            }
            case 15 -> {
                assertEquals(1, starts);
                assertEquals(1, childCancellations);
                assertFalse(press!!.interaction.pressed);
                shift.value = 10.0;
                phase = 16
            }
            case 16 -> if (committedShift == Some(10.0)) {
                repeatedClockMoves(active);
                phase = 17
            }
            case 17 -> {
                assertEquals(20.0, last!!.start.x);
                assertEquals(60.0, last!!.position.x);
                assertEquals(40.0, last!!.displacement);
                assertTrue(last!!.velocity.isFinite());
                button(70.0, 30.0, false);
                phase = 18
            }
            case 18 -> {
                assertEquals(1, ends);
                assertEquals(13, clicks);
                shift.value = 0.0;
                phase = 19
            }
            case 19 -> if (committedShift == Some(0.0)) {
                move(30.0, 30.0);
                button(30.0, 30.0, true);
                move(30.0, 50.0);
                button(30.0, 50.0, false);
                phase = 20
            }
            case 20 -> {
                assertEquals(23, clicks);
                assertEquals(1, starts);
                button(30.0, 30.0, true);
                move(50.0, 30.0);
                phase = 21
            }
            case 21 -> {
                assertEquals(2, starts);
                drag!!.cancel();
                assertEquals(1, cancels);
                assertFalse(drag!!.isDragging);
                assertTrue(view!!.button(50.0, 30.0, false));
                phase = 22
            }
            case 22 -> {
                assertEquals(23, clicks);
                dragEnabled(false);
                press!!.close();
                assertFalse(area!!.isClosed);
                move(30.0, 30.0);
                button(30.0, 30.0, true);
                button(30.0, 30.0, false);
                phase = 23
            }
            case 23 -> {
                assertEquals(23, clicks)
                press =
                    Some(
                        scope!!.press(area!!) {
                            clicks += 100;
                            finished = true;
                            window!!.requestDestroy()
                        }
                    )
                button(30.0, 30.0, true);
                button(30.0, 30.0, false)
                phase = 24
            }
            else -> {}
        }
    }
}
