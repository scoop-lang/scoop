package scoop.tests.ui.scrollpan

import scoop.graphics.Point
import scoop.test.*
import scoop.ui.*

internal fun panInertiaBoundaryStep(p: PanProbe) {
    when (p.phase) {
        0 -> {
            p.ui!!.preferences = uiPreferences { reduceMotion = Some(false) }
            p.innerHeight = 140.0
            p.outerHeight = 260.0
            p.innerPhysics = coastPhysics(ScrollBoundary.Elastic)
            p.outerPhysics = coastPhysics(ScrollBoundary.Elastic)
            p.changed()
        }
        1 -> {
            p.animatedSteps = true;
            p.fling(601L)
        }
        2 -> {
            assertTrue(p.outer.isAnimating);
            p.animatedSteps = false
        }
        3 -> {
            coastNear(40.0, p.inner.offset.y)
            coastNear(60.0, p.outer.offset.y)
            assertTrue(p.bounced)
            assertTrue(p.peakStretch > 0.0 && p.peakStretch <= 40.0)
            assertEquals(Point(0.0, 0.0), p.outerLayout!!.overscroll)
            assertEquals(Point(0.0, 0.0), p.innerLayout!!.overscroll)
            p.reset()
            p.bounced = false
            p.outerPhysics = coastPhysics()
            p.changed()
        }
        4 -> p.fling(602L)
        5 -> {
            coastNear(40.0, p.inner.offset.y)
            coastNear(60.0, p.outer.offset.y)
            assertFalse(p.bounced)
            p.reset()
            p.innerOptions = TouchScrollOptions(false)
            p.outerOptions = TouchScrollOptions(lockAxis = false)
            p.outerPhysics = coastPhysics(ScrollBoundary.Elastic)
            p.changed()
        }
        6 -> p.fling(603L, dx = -30.0)
        7 -> {
            coastNear(136.06601717798213, p.outer.offset.x)
            coastNear(60.0, p.outer.offset.y)
            assertTrue(p.bounced)
            assertEquals(Point(0.0, 0.0), p.outerLayout!!.overscroll)
            p.reset()
            p.outerHeight = 1000.0
            p.outerOptions = TouchScrollOptions()
            p.outerPhysics = coastPhysics()
            p.changed()
        }
        8 -> {
            p.animatedSteps = true;
            p.fling(604L)
        }
        9 -> {
            assertTrue(p.outer.isAnimating)
            p.outer.scrollTo(Point(0.0, 80.0))
            p.animatedSteps = false
        }
        10 -> {
            coastNear(80.0, p.outer.offset.y);
            assertFalse(p.outer.isAnimating)
        }
        11 -> {
            p.animatedSteps = true;
            p.fling(605L)
        }
        12 -> {
            assertTrue(p.outer.isAnimating)
            p.contact(701L, 0, 280.0, 150.0)
            p.animatedSteps = false
        }
        13 -> {
            assertFalse(p.outer.isAnimating)
            p.contact(701L, 2, 280.0, 150.0)
            p.reset()
        }
        14 -> {
            p.animatedSteps = true;
            p.fling(606L)
        }
        15 -> {
            assertTrue(p.outer.isAnimating)
            p.ui!!.preferences = uiPreferences { reduceMotion = Some(true) }
            p.savedOffset = p.outer.offset
            p.animatedSteps = false
        }
        16 -> {
            assertEquals(p.savedOffset, p.outer.offset)
            assertFalse(p.outer.isAnimating)
            p.ui!!.preferences = uiPreferences { reduceMotion = Some(false) }
            p.reset()
        }
        17 -> {
            p.animatedSteps = true;
            p.fling(607L)
        }
        18 -> {
            assertTrue(p.outer.isAnimating)
            p.outerScope!!.isFrameEnabled = false
            p.savedOffset = p.outer.offset
            p.animatedSteps = false
        }
        19 -> {
            assertEquals(p.savedOffset, p.outer.offset)
            assertFalse(p.outer.isAnimating)
            p.outerScope!!.isFrameEnabled = true
            p.reset()
        }
        20 -> {
            p.animatedSteps = true;
            p.fling(608L)
        }
        21 -> {
            assertTrue(p.outer.isAnimating)
            p.outerPan!!.cancel()
            p.savedOffset = p.outer.offset
            p.animatedSteps = false
        }
        22 -> {
            assertEquals(p.savedOffset, p.outer.offset)
            assertFalse(p.outer.isAnimating)
            p.reset()
        }
        23 -> {
            p.animatedSteps = true;
            p.fling(609L)
        }
        24 -> {
            assertTrue(p.outer.isAnimating)
            p.outerPhysics = coastPhysics(enabled = false)
            p.changed()
            p.animatedSteps = false
        }
        25 -> {
            assertFalse(p.outer.isAnimating)
            p.outerPhysics = coastPhysics()
            p.reset()
            p.changed()
        }
        26 -> {
            p.animatedSteps = true;
            p.fling(610L)
        }
        27 -> {
            assertTrue(p.outer.isAnimating)
            p.outerHeight = 400.0
            p.changed()
            p.animatedSteps = false
        }
        28 -> {
            assertFalse(p.outer.isAnimating)
            assertTrue(p.outer.offset.y >= 0.0 && p.outer.offset.y <= p.outer.maximum.y)
            p.reset()
            p.outerHeight = 1000.0
            p.changed()
        }
        29 -> {
            p.animatedSteps = true;
            p.fling(611L)
        }
        30 -> {
            assertTrue(p.outer.isAnimating)
            p.finished = true
            p.window!!.requestDestroy()
        }
        else -> fail(Some("unexpected inertia boundary phase"))
    }
}
