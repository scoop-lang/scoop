package scoop.tests.ui.scrollpan

import scoop.graphics.Point
import scoop.test.*
import scoop.ui.*

internal fun panMomentumStep(p: PanProbe) {
    when (p.phase) {
        0 -> {
            p.innerPhysics = elasticScroll()
            p.outerPhysics = elasticScroll()
            p.chain = ScrollChain.Contain
            p.animatedSteps = true
            p.changed()
        }
        1 -> p.wheel(60, momentum = 1)
        2 -> {
            assertTrue(p.inner.isAnimating, Some("Momentum must release its edge before Ended"))
            assertTrue(p.innerLayout!!.overscroll.y > 0.0)
            assertEquals(Point(0.0, 0.0), p.inner.offset)
            p.peakStretch = p.innerLayout!!.overscroll.y
            p.wheel(40, momentum = 2)
        }
        3 -> {
            assertTrue(p.inner.isAnimating)
            assertTrue(
                p.innerLayout!!.overscroll.y < p.peakStretch,
                Some("The native momentum tail must not restart the spring")
            )
            p.animatedSteps = false
        }
        4 -> {
            assertFalse(p.inner.isAnimating)
            assertEquals(Point(0.0, 0.0), p.innerLayout!!.overscroll)
            p.wheel(40, momentum = 2)
        }
        5 -> {
            assertFalse(p.inner.isAnimating)
            assertEquals(Point(0.0, 0.0), p.innerLayout!!.overscroll)
            p.wheel(-20, momentum = 2)
        }
        6 -> {
            assertFalse(p.inner.isAnimating)
            assertEquals(Point(0.0, 20.0), p.inner.offset)
            assertEquals(Point(0.0, 0.0), p.innerLayout!!.overscroll)
            p.wheel(0, momentum = 3)
            p.reset()
            p.chain = ScrollChain.Chain
            p.animatedSteps = true
            p.changed()
        }
        7 -> p.wheel(60, phase = 1)
        8 -> {
            assertFalse(p.outer.isAnimating)
            assertTrue(p.outerLayout!!.overscroll.y > 0.0)
            p.wheel(0, phase = 4)
        }
        9 -> {
            assertTrue(p.outer.isAnimating)
            p.peakStretch = p.outerLayout!!.overscroll.y
            p.wheel(40, momentum = 1)
        }
        10 -> {
            assertTrue(p.outer.isAnimating)
            assertFalse(p.inner.isAnimating)
            assertTrue(p.outerLayout!!.overscroll.y < p.peakStretch)
            p.wheel(-20, momentum = 2)
        }
        11 -> {
            assertFalse(p.outer.isAnimating)
            assertEquals(Point(0.0, 20.0), p.inner.offset)
            assertEquals(Point(0.0, 0.0), p.outerLayout!!.overscroll)
            p.wheel(0, momentum = 3)
            p.reset()
        }
        12 -> p.wheel(60, momentum = 1, horizontal = 40)
        13 -> {
            assertTrue(p.outer.isAnimating)
            assertTrue(p.outerLayout!!.overscroll.x > 0.0)
            assertTrue(p.outerLayout!!.overscroll.y > 0.0)
            p.savedOffset = p.outerLayout!!.overscroll
            p.wheel(40, momentum = 2, horizontal = -20)
        }
        14 -> {
            assertTrue(p.outer.isAnimating)
            assertEquals(Point(20.0, 0.0), p.outer.offset)
            assertEquals(Point(0.0, 0.0), p.inner.offset)
            assertEquals(0.0, p.outerLayout!!.overscroll.x)
            assertTrue(p.outerLayout!!.overscroll.y < p.savedOffset.y)
            p.wheel(0, momentum = 3)
        }
        15 -> {
            assertTrue(p.outer.isAnimating)
            p.animatedSteps = false
        }
        16 -> {
            assertFalse(p.outer.isAnimating)
            assertEquals(Point(0.0, 0.0), p.outerLayout!!.overscroll)
            p.wheel(40, phase = 1)
        }
        17 -> {
            assertFalse(p.outer.isAnimating)
            assertTrue(p.outerLayout!!.overscroll.y > 0.0)
            p.animatedSteps = true
            p.wheel(0, phase = 4)
            p.wheel(40, momentum = 1)
        }
        18 -> {
            assertTrue(p.outer.isAnimating)
            p.wheel(-15, phase = 1)
        }
        19 -> {
            assertFalse(p.outer.isAnimating)
            assertEquals(Point(0.0, 15.0), p.inner.offset)
            assertEquals(Point(0.0, 0.0), p.outerLayout!!.overscroll)
            p.wheel(0, phase = 4)
            p.animatedSteps = false
        }
        20 -> {
            assertFalse(p.frames!!.snapshot().required)
            p.finished = true
            p.window!!.requestDestroy()
        }
        else -> fail(Some("Unexpected native momentum phase"))
    }
}
