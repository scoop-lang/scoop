package scoop.tests.ui.scrollpan

import scoop.graphics.Point
import scoop.math.abs
import scoop.test.*
import scoop.ui.*

internal fun coastPhysics(
    boundary: ScrollBoundary = ScrollBoundary.Hard,
    enabled: Boolean = true
): ScrollPhysicsOptions =
    ScrollPhysicsOptions(
        boundary,
        maxOverscroll = 40.0,
        inertia = ScrollInertiaOptions(enabled, 300.0, 20.0, 300.0)
    )

internal fun coastNear(expected: Double, actual: Double) {
    assertTrue(abs(expected - actual) < 0.02, Some(f"expected ${expected}, got ${actual}"))
}

internal fun panInertiaStep(p: PanProbe) {
    when (p.phase) {
        0 -> {
            p.ui!!.preferences = uiPreferences { reduceMotion = Some(false) }
            p.innerHeight = 140.0
            p.outerHeight = 1000.0
            p.innerPhysics = coastPhysics()
            p.outerPhysics = coastPhysics()
            p.changed()
        }
        1 -> {
            p.animatedSteps = true
            p.fling(501L)
        }
        2 -> {
            assertTrue(p.inner.isAnimating)
            assertTrue(p.outer.isAnimating)
            assertFalse(p.innerPan!!.isPanning)
            assertFalse(p.innerArea!!.scope.activity.hasContact)
            p.beforeIntents = p.userIntents
            p.animatedSteps = false
        }
        3 -> {
            coastNear(40.0, p.inner.offset.y)
            coastNear(140.0, p.outer.offset.y)
            assertEquals(p.beforeIntents, p.userIntents)
            assertFalse(p.bounced)
            assertFalse(p.inner.isAnimating)
            assertFalse(p.outer.isAnimating)
            p.reset()
            p.innerPhysics = coastPhysics(enabled = false)
            p.changed()
        }
        4 -> p.fling(502L)
        5 -> {
            coastNear(30.0, p.inner.offset.y)
            coastNear(0.0, p.outer.offset.y)
            p.reset()
            p.innerPhysics = coastPhysics()
            p.outerPhysics = coastPhysics(enabled = false)
            p.changed()
        }
        6 -> p.fling(503L)
        7 -> {
            coastNear(40.0, p.inner.offset.y)
            coastNear(0.0, p.outer.offset.y)
            p.reset()
            p.outerPhysics = coastPhysics()
            p.chain = ScrollChain.Contain
            p.changed()
        }
        8 -> p.fling(504L)
        9 -> {
            coastNear(40.0, p.inner.offset.y)
            coastNear(0.0, p.outer.offset.y)
            p.reset()
            p.chain = ScrollChain.Chain
            p.ui!!.preferences = uiPreferences { reduceMotion = Some(true) }
            p.changed()
        }
        10 -> p.fling(505L)
        11 -> {
            coastNear(30.0, p.inner.offset.y)
            coastNear(0.0, p.outer.offset.y)
            p.reset()
            p.ui!!.preferences = uiPreferences { reduceMotion = Some(false) }
        }
        12 -> p.fling(506L, hold = 160L)
        13 -> {
            coastNear(30.0, p.inner.offset.y)
            coastNear(0.0, p.outer.offset.y)
            p.reset()
        }
        14 -> {
            p.wheel(-30, phase = 1)
            p.wheel(0, phase = 4)
        }
        15 -> {
            coastNear(30.0, p.inner.offset.y)
            coastNear(0.0, p.outer.offset.y)
            p.reset()
            p.scale = 2.0
            p.changed()
        }
        16 -> p.fling(507L, pen = true)
        17 -> {
            coastNear(40.0, p.inner.offset.y)
            coastNear(50.0, p.outer.offset.y)
            assertFalse(p.frames!!.snapshot().required)
            p.finished = true
            p.window!!.requestDestroy()
        }
        else -> fail(Some("unexpected inertia phase"))
    }
}
