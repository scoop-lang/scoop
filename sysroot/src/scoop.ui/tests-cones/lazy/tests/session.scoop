package scoop.tests.ui.lazy

import scoop.platform.time.MonotonicTimeSource
import scoop.test.*
import scoop.tests.surface.*
import scoop.time.Duration
import scoop.ui.*
import scoop.window.*

@Test
private class LazyItemsTest {
    @Test
    fun `lazy items keep normal state lifetime identity and cleanup across on demand layouts`() {
        val probe = LazyProbe()
        try {
            UiHost { host, active, event -> probe.event(host, active, event) }.use {
                host -> Application(ApplicationOptions(LastWindowPolicy.Exit)).run(host)
            }
            assertTrue(probe.finished)
            assertTrue(probe.ui!!.isClosed)
            assertEquals(7L, probe.rows.size)
            for (row in probe.rows) {
                assertEquals(1, row.mounts)
                assertEquals(1, row.unmounts)
                assertEquals(1, row.disposed)
                assertEquals(1, row.resource!!.closes)
            }
            assertEquals(7, probe.mountWrites.value)
            assertFailsWith<IllegalStateException> { probe.savedContext!!.itemCount }
        } finally {
            probe.frames?.close()
        }
    }
}

internal class LazyProbe {
    val mountWrites = state(0)
    val value7 = state(7)
    val rows = ArrayList<RowRecord>()
    val builds = ArrayList<Long>()
    val drawOrder = ArrayList<Long>()
    var source: State<ItemSource>? = None
    var selected: Array<Long> = [7L, 2L]
    var offscreen: Long? = None
    var activeContext: LazyMeasureContext? = None
    var savedContext: LazyMeasureContext? = None
    var window: Window? = None
    var ui: UiWindow? = None
    var scope: ComponentScope? = None
    var frames: FrameProbe? = None
    var phase = 0
    var ticket = 0
    var committed = -1
    var passes = 0
    var waiting = true
    var finished = false
    var retriedFocus = false
    private var original7: RowRecord? = None
    private var original8: RowRecord? = None
    private var original9: RowRecord? = None
    private var hiddenPasses = 0

    fun row(id: Long): RowRecord {
        var index = rows.size
        while (index > 0L) {
            index -= 1L
            if (rows[index].id == id && rows[index].unmounts == 0)
                return rows[index]
        }
        throw IllegalStateException(Some("test row is not mounted"))
    }
    fun event(host: UiHost, active: ActiveApplication, event: ApplicationEvent) {
        when (event) {
            case Resumed -> {
                source = Some(state<ItemSource>(ProtocolSource(this)))
                val native =
                    active.createWindow(
                        WindowAttributes(
                            "Scoop lazy protocol",
                            LogicalSize(240.0, 160.0),
                            visible = false
                        )
                    )
                window = Some(native)
                frames = Some(observeFrames(native))
                ui = Some(host.attach(native, { LazyScene(this) }))
                active.setControlFlow(
                    ControlFlow.WaitUntil(MonotonicTimeSource.markNow() + Duration.seconds(30L))
                )
                active.proxy().post {
                    _ ->
                    assertEquals(0L, builds.size)
                    assertEquals(0L, rows.size)
                    native.setVisible(true)
                    native.setWindowLevel(WindowLevel.AlwaysOnTop)
                    native.requestFocus()
                    waiting = false
                }
            }
            case AboutToWait -> {
                if (phase == 0 && passes > 0 && !window!!.isFocused && !retriedFocus) {
                    retriedFocus = true
                    window!!.requestFocus()
                }
                if (phase == 11 && ui!!.isClosed) {
                    phase = 12
                    window!!.requestDestroy()
                } else
                    if (!waiting && canAdvance()) {
                        waiting = true
                        assertTrue(
                            active.proxy().post {
                                owner ->
                                waiting = false
                                if (canAdvance())
                                    advance(owner)
                            }
                        )
                    }
            }
            case Window(_, WindowEvent.Destroyed) -> {
                finished = phase == 12;
                active.requestExit()
            }
            case NewEvents(StartCause.Deadline) -> fail(
                Some(f"lazy protocol timeout phase=${phase}, frames=${passes}")
            )
            else -> {}
        }
    }
    // Paused native demand alone does not imply that queued layout work has finished.
    private fun canAdvance(): Boolean =
        committed ==
            ticket &&
            window!!.isFocused &&
            window!!.isVisible &&
            !window!!.isOccluded &&
            !frames!!.snapshot().required

    private fun nextFrame() {
        ticket += 1
        scope!!.requestFrame()
    }
    private fun advance(active: ActiveApplication) {
        assertFailsWith<IllegalStateException> { savedContext!!.itemCount }
        when (phase) {
            case 0 -> {
                assertEquals(2L, rows.size)
                assertEquals(2L, builds.size)
                assertEquals(2L, drawOrder[0L])
                assertEquals(7L, drawOrder[1L])
                assertEquals(1, row(2L).localValue)
                original7 = Some(row(7L))
                assertTrue(row(2L).area!!.requestFocus())
                selected = [7L, 8L]
                phase = 1
                nextFrame()
            }
            case 1 -> {
                assertEquals(3L, rows.size)
                assertEquals(3L, builds.size)
                assertTrue(row(2L).area!!.hasFocus)
                assertEquals(None, row(2L).area!!.visibleBounds)
                original8 = Some(row(8L))
                value7.value = 42
                phase = 2
                nextFrame()
            }
            case 2 -> {
                assertSame(original7!!, row(7L))
                assertEquals(42, row(7L).input.value)
                assertEquals(4L, builds.size)
                assertTrue(row(7L).handle.requestFocus())
                phase = 3
                nextFrame()
            }
            case 3 -> {
                assertEquals(1, rows[1L].unmounts)
                assertEquals(4L, builds.size)
                row(7L).area!!.clearFocus()
                selected = [8L, 9L]
                phase = 4
                nextFrame()
            }
            case 4 -> {
                assertTrue(row(9L).area!!.hasFocus)
                original9 = Some(row(9L))
                assertEquals(1, original7!!.unmounts)
                selected = [0L, 1L]
                source!!.value = ProtocolSource(this, Some([9L, 8L]), 1)
                phase = 5
                nextFrame()
            }
            case 5 -> {
                assertSame(original8!!, row(8L))
                assertSame(original9!!, row(9L))
                assertEquals(0L, row(9L).input.index)
                assertEquals(1L, row(8L).input.index)
                assertEquals(1, row(8L).input.version)
                assertEquals(9L, drawOrder[0L])
                assertEquals(8L, drawOrder[1L])
                waiting = true
                window!!.setVisible(false)
                hiddenPasses = passes
                source!!.value = ProtocolSource(this, Some([8L]), 2)
                phase = 6
                active.proxy().post { application -> hidden(application) }
            }
            case 9 -> {
                assertFalse(row(17L).area!!.canFocus)
                assertTrue(row(17L).handle.requestFocus())
                selected = []
                ticket += 1
                phase = 10
            }
            case 10 -> {
                for (row in rows)
                    assertEquals(
                        1,
                        row.unmounts,
                        Some(
                            f"row=${row.id}, pending=${row.handle.isPending}, focus=${
                                row.handle.hasFocus
                            }, frames=${passes}, occluded=${window!!.isOccluded}"
                        )
                    )
                source!!.value = ProtocolSource(this, Some([99L]), 4)
                selected = [0L]
                offscreen = None
                ticket += 1
                phase = 11
                waiting = true
            }
            else -> {}
        }
    }
    private fun hidden(active: ActiveApplication) {
        assertEquals(hiddenPasses, passes)
        when (phase) {
            case 6 -> {
                assertEquals(1, original9!!.unmounts)
                assertTrue(original9!!.area!!.isClosed)
                assertSame(original8!!, row(8L))
                assertEquals(2, row(8L).input.version)
                source!!.value = ProtocolSource(this, Some([8L]), 3)
                phase = 7
                active.proxy().post { application -> hidden(application) }
            }
            case 7 -> {
                assertEquals(1, original8!!.unmounts)
                assertNotSame(original8!!, row(8L))
                assertEquals(3, row(8L).input.version)
                source!!.value = ProtocolSource(this, Some([]), 3)
                phase = 8
                active.proxy().post { application -> hidden(application) }
            }
            case 8 -> {
                for (row in rows)
                    assertEquals(1, row.unmounts)
                source!!.value = ProtocolSource(this, Some([17L]), 3)
                selected = [0L]
                offscreen = Some(0L)
                ticket += 1
                phase = 9
                waiting = false
                window!!.setVisible(true)
                window!!.requestFocus()
            }
            else -> {}
        }
    }
}
