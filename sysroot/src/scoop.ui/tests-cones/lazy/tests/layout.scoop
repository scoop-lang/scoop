package scoop.tests.ui.lazy

import scoop.collections.HashSet
import scoop.graphics.*
import scoop.surface.FrameSubmission
import scoop.test.*
import scoop.ui.*

internal class LazyScene(private val probe: LazyProbe): Component {
    public override fun render(): View {
        return element(
            { ProbeContainer(probe) },
            [lazyElement(probe.source!!.value, { ProtocolContainer(probe) })]
        )
    }
}

private class ProbeContainer(private val probe: LazyProbe): Element<Unit> {
    public override fun measure(context: MeasureContext, constraints: Constraints): LayoutResult<
        Unit
    > {
        val first = context.measureChild(0L, Constraints.tight(Size(80.0, 160.0)))
        val calls = probe.layoutCalls
        assertEquals(first, context.measureChild(0L, Constraints.tight(Size(80.0, 160.0))))
        assertEquals(calls, probe.layoutCalls)
        context.measureChild(0L, Constraints.tight(Size(60.0, 160.0)))
        val final = context.measureChild(0L, constraints)
        context.placeChild(0L, Point(0.0, 0.0))
        return LayoutResult(final, Unit)
    }
    public override fun scene(context: SceneContext, measured: Unit) {
        context.children()
    }
}

private class ProtocolContainer(private val probe: LazyProbe): LazyElement<Int> {
    public override fun onMount(scope: ComponentScope) {
        probe.scope = Some(scope)
    }
    public override fun measure(
        context: LazyMeasureContext,
        constraints: Constraints
    ): LayoutResult<Int> {
        probe.layoutCalls += 1
        val ticket = probe.ticket
        probe.activeContext = Some(context)
        probe.savedContext = Some(context)
        val chosen = HashSet<Long>()
        val item = Constraints.tight(Size(100.0, 24.0))
        val probing = constraints.maxWidth == Some(80.0) || constraints.maxWidth == Some(60.0)
        val selected =
            if (!probing || probe.selected.size == 0L)
                probe.selected
            else
                if (constraints.maxWidth == Some(80.0))
                    [probe.selected[0L]]
                else
                    [probe.selected[probe.selected.size - 1L]]
        assertFailsWith<IllegalStateException> { probe.mountWrites.value += 1 }
        assertFailsWith<IllegalArgumentException> { context.measureItem(-1L, item) }
        assertFailsWith<IllegalArgumentException> { context.measureItem(context.itemCount, item) }
        assertFailsWith<IllegalStateException> {
            context.placeItem(context.itemCount, Point(0.0, 0.0))
        }
        var position = 0L
        for (index in selected) {
            val metrics = context.measureItem(index, item)
            chosen.add(index)
            assertEquals(metrics, context.measureItem(index, item))
            assertEquals(
                Size(50.0, 24.0),
                context.measureItem(index, Constraints.tight(Size(50.0, 24.0))).size
            )
            assertEquals(metrics, context.measureItem(index, item))
            context.placeItem(
                index,
                Point(
                    0.0,
                    if (probe.offscreen == Some(index))
                        220.0
                    else
                        position.toDouble() * 24.0
                )
            )
            assertFailsWith<IllegalStateException> { context.measureItem(index, item) }
            assertFailsWith<IllegalStateException> { context.placeItem(index, Point(0.0, 0.0)) }
            position += 1L
        }
        // Intermediate probes deliberately omit pinned rows. Only the final layout
        // must place them; no trial may retire their state or input activity.
        val pinned: Array<Long> =
            if (probing)
                []
            else
                context.pinnedItems
        for (index in pinned) {
            if (chosen.add(index)) {
                context.measureItem(index, item)
                context.placeItem(index, Point(0.0, 220.0))
            }
        }
        if (probe.phase == 4 && !probing) {
            var sawPending = false
            for (index in pinned)
                if (index == 9L)
                    sawPending = true
            assertTrue(sawPending)
        }
        probe.activeContext = None
        return LayoutResult(LayoutMetrics(constraints.constrain(Size(240.0, 160.0))), ticket)
    }
    public override fun scene(context: SceneContext, ticket: Int) {
        probe.passes += 1
        probe.drawOrder.clear()
        context.draw { paint -> paint.canvas.clear(Color.White) }
        context.withState {
            content ->
            content.clipRect(Rect(0.0, 0.0, 200.0, 100.0))
            content.children()
        }
        val accepted = ticket
        context.onFrameComplete {
            frame -> if (frame.submission == FrameSubmission.Accepted)
                probe.committed = accepted
        }
    }
}
