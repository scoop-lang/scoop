package scoop.tests.ui.modal

import scoop.platform.time.MonotonicTimeSource
import scoop.surface.*
import scoop.test.*
import scoop.tests.surface.*
import scoop.time.Duration
import scoop.ui.*
import scoop.window.*

@Test
private class ModalUiTest {
    @Test
    fun `modal domains dismiss once retain closing barriers and restore the latest valid focus`() {
        val probe = ModalProbe()
        try {
            UiHost { host, active, event -> probe.event(host, active, event) }.use {
                host -> Application(
                    applicationOptions { this.lastWindowPolicy = LastWindowPolicy.Exit }
                ).run(host)
            }
            assertTrue(probe.finished)
            assertTrue(probe.view!!.restored())
            for (index in 0L ..< probe.layers.size) {
                assertFalse(probe.layers[index].isAttached)
                assertEquals(probe.mounts[index], probe.unmounts[index])
                when (probe.modalRoots[index]) {
                    case Some(val area) -> assertTrue(area.isClosed)
                    case None -> {}
                }
            }
            for (handle in probe.focus)
                assertFalse(handle.isAttached)
            assertEquals(Some(OverlayCloseReason.OwnerClosed), probe.layers[0L].lastCloseReason)
            assertEquals(Some(OverlayCloseReason.OwnerClosed), probe.layers[1L].lastCloseReason)
        } catch (error: Throwable) {
            probe.reportFailure(error)
            throw error
        } finally {
            probe.view?.close()
        }
    }
}

internal struct ModalClose(val layer: Long, val reason: OverlayCloseReason)

internal class ModalProbe {
    val layers = Array<OverlayHandle>(6L) { _ -> OverlayHandle() }
    val open = MutableArray<Boolean>(6L) { _ -> false }
    val mounts = MutableArray<Int>(6L) { _ -> 0 }
    val unmounts = MutableArray<Int>(6L) { _ -> 0 }
    val modalRoots = MutableArray<InputArea?>(6L) { _ -> None }
    val shortcuts = MutableArray<Int>(6L) { _ -> 0 }
    val focus = Array<FocusHandle>(9L) { _ -> FocusHandle() }
    val areas = MutableArray<InputArea?>(9L) { _ -> None }
    val downs = MutableArray<Int>(9L) { _ -> 0 }
    val ups = MutableArray<Int>(9L) { _ -> 0 }
    val cancels = MutableArray<Int>(9L) { _ -> 0 }
    val closed = ArrayList<ModalClose>()
    val revision = state(0)
    var committed = -1
    var passes = 0
    var paintOrder = ""
    var phase = 0
    var waiting = false
    var finished = false
    var blockEscape = false
    var emptyOuter = false
    var plainOuter = false
    var requestOnMount = -1L
    var requestOnBlur = -1L
    var requestOnClose = -1L
    var restore = true
    var outside = OutsidePress.CloseAndConsume
    var backgroundOutside = OutsidePress.CloseAndContinue
    var discardNext = false
    var discarded = 0
    var closeAfterPresent = false
    var closeOnBlur = false
    var closedAtPass = -1
    var backgroundKeys = 0
    var backgroundShortcut = 0
    var quietPasses = 0
    var window: Window? = None
    var ui: UiWindow? = None
    var view: ViewProbe? = None
    var rootScope: ComponentScope? = None
    private var retryFocus = false

    fun reportFailure(error: Throwable) {
        println(f"phase=${phase}, frames=${passes}")
        reportFailureDetail(error)
    }
    fun event(host: UiHost, active: ActiveApplication, event: ApplicationEvent) {
        when (event) {
            case Resumed -> {
                val native =
                    active.createWindow(
                        windowAttributes {
                            this.title = "Scoop modal input"
                            this.size = LogicalSize(400.0, 260.0)
                        }
                    )
                window = Some(native)
                view = Some(observeWindow(native))
                native.setWindowLevel(WindowLevel.AlwaysOnTop)
                native.requestFocus()
                ui = host.attach(native, { mount -> ModalScene(this, scope = mount) })
                waitFor(active, 30000L)
            }
            case AboutToWait -> {
                if (!finished && phase == 0 && passes > 0 && !window!!.isFocused && !retryFocus) {
                    retryFocus = true
                    window!!.requestFocus()
                }
                if (!finished && !waiting && committed == revision.value && window!!.isFocused)
                    advance(active)
            }
            case NewEvents(StartCause.Deadline) -> {
                if (phase == 46) {
                    quietPasses = passes
                    phase = 47
                    waitFor(active, 150L)
                } else
                    if (phase == 47) {
                        assertEquals(quietPasses, passes)
                        finished = true
                        ui!!.close()
                        window!!.requestDestroy()
                    } else {
                        fail(
                            Some(
                                f"modal timeout phase=${this @ModalProbe.phase}, frames=${
                                    this @ModalProbe.passes
                                }, committed=${this @ModalProbe.committed}, revision=${
                                    this @ModalProbe.revision.value
                                }"
                            )
                        )
                    }
            }
            else -> {}
        }
    }
    fun changed() {
        revision.value += 1
    }
    fun next() {
        phase += 1
        changed()
    }
    fun opened(index: Long) {
        open[index] = true
        next()
    }
    fun close(index: Long, reason: OverlayCloseReason) {
        closed.add(ModalClose(index, reason))
        open[index] = false
        changed()
    }
    fun beforeClose(index: Long) {
        if (index == 0L && requestOnClose >= 0L) {
            assertFalse(focus[requestOnClose].requestFocus())
            requestOnClose = -1L
        }
    }
    fun expectFocus(index: Long) {
        for (position in 0L ..< focus.size)
            assertEquals(
                position == index,
                focus[position].hasFocus,
                Some(f"phase=${phase}, target=${index}, checked=${position}")
            )
    }
    fun after(active: ActiveApplication, check: () -> Unit) {
        assertTrue(
            active.proxy().post {
                _ ->
                check()
                phase += 1
                waiting = false
            }
        )
    }
    fun key(
        active: ActiveApplication,
        code: Int,
        check: () -> Unit,
        repeat: Boolean = false,
        command: Boolean = false,
        shift: Boolean = false
    ) {
        waiting = true
        assertTrue(sendSurfaceKey(window!!, code, true, repeat, command, shift))
        assertTrue(sendSurfaceKey(window!!, code, false, false, command, shift))
        after(active, check)
    }
    fun click(active: ActiveApplication, x: Double, y: Double, check: () -> Unit) {
        waiting = true
        assertTrue(moveSurfacePointer(window!!, x, y))
        assertTrue(view!!.button(x, y, true))
        assertTrue(view!!.button(x, y, false))
        after(active, check)
    }
    fun waitFor(active: ActiveApplication, millis: Long) {
        active.setControlFlow(
            ControlFlow.WaitUntil(MonotonicTimeSource.markNow() + Duration.milliseconds(millis))
        )
    }
}

private fun reportFailureDetail(error: Throwable) {
    if (error is ResourceUseException) {
        reportFailureDetail(error.primaryFailure)
        reportFailureDetail(error.cleanupFailure)
    } else
        if (error is AssertionFailure) {
            println(
                f"${error.kind}: ${error.location.file}:${error.location.line} ${
                    error.message ?: ""
                }"
            )
            when (error.expected) {
                case Text(val value) -> println(f"expected ${value}");
                else -> {}
            }
            when (error.actual) {
                case Text(val value) -> println(f"actual ${value}");
                else -> {}
            }
        } else
            if (error is Exception)
                println(error.message ?: "window test failure")
}
