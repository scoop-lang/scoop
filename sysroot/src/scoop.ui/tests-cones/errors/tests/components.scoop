package scoop.tests.ui.errors

import scoop.graphics.*
import scoop.surface.*
import scoop.test.*
import scoop.ui.*

internal enum FailureMode {
    Factory, Render, Mount, Update, DuplicateKey, DuplicateInstance, RetiredComponent, RetiredElement, RetiredLazy, PortalHandle, PortalCycle, ModalMount, ModalClose, MissingMeasure, Measure, MissingPaint, Paint, FrameComplete, LazyBuild, LazyMount, LazyMeasure, LazyMissingPaint, LazyMissingPinned, LateUpdate
}

internal class FailureImage(private val record: FailureRecord, val name: String): Closeable {
    val image =
        RasterSurface(4, 4).use {
            raster ->
            raster.draw { canvas -> canvas.clear(Color.White) }
            raster.snapshot()
        }
    var closes = 0
    init {
        record.images.add(this)
    }
    public override fun close() {
        closes += 1
        image.close()
        record.log.add("close " + name)
        when (record.factoryFonts) {
            case Some(fonts) -> assertFalse(fonts.isClosed)
            case None -> {}
        }
        if (record.mode == FailureMode.Mount || record.mode == FailureMode.Factory)
            throw record.cleanupA
        if (record.mode == FailureMode.LateUpdate) {
            if (name == "leaf")
                throw record.cleanupA
            if (name == "second")
                throw record.cleanupB
        }
    }
}

internal class SmallComponent(scope: ComponentScope): Component(scope) {
    public override fun render(): View = empty()
}

internal class FailureRoot(private val record: FailureRecord, scope: ComponentScope): Component(
    scope
) {
    private val resource = scope.resource { FailureImage(record, "root") }
    public override fun render(): View {
        if (record.mode == FailureMode.Render)
            throw record.primary
        if (record.mode.isLazy)
            return lazyElement(
                LazyFailureSource(record),
                { mount -> LazyFailureContainer(record, scope = mount) }
            )
        val late = record.trigger.value
        val children: Array<View> =
            when (record.mode) {
                case DuplicateKey -> [
                    component({ mount -> SmallComponent(scope = mount) }, ViewKey.Text("same")),
                    component({ mount -> SmallComponent(scope = mount) }, ViewKey.Text("same"))
                ]
                case DuplicateInstance -> {
                    val shared = MutableArray<SmallComponent?>(1L) { _ -> None }
                    [
                        component(
                            {
                                mount ->
                                val value = SmallComponent(mount)
                                shared[0L] = Some(value)
                                value
                            }
                        ),
                        component({ _ -> shared[0L]!! })
                    ]
                }
                case MissingMeasure -> [component({ mount -> SmallComponent(scope = mount) })]
                case MissingPaint -> [component({ mount -> SmallComponent(scope = mount) })]
                case ModalMount -> failureModal(record)
                case ModalClose -> failureModal(record)
                case PortalHandle -> [
                    portal(record.overlayOpen.binding(), empty()) {
                        this.options {
                            this.handle = Some(this @FailureRoot.record.overlay)
                            this.onClosed =
                                { reason -> this @FailureRoot.record.overlayClosed(reason) }
                        }
                    },
                    portal(record.overlayOpen.binding(), empty()) {
                        this.options { this.handle = Some(this @FailureRoot.record.overlay) }
                    }
                ]
                case PortalCycle -> [
                    portal(
                        record.overlayOpen.binding(),
                        element({ mount -> FailurePortalAnchor(record.anchor, scope = mount) })
                    ) {
                        this.options {
                            this.placement =
                                OverlayPlacement.Anchored(this @FailureRoot.record.anchor)
                            this.handle = Some(this @FailureRoot.record.overlay)
                            this.onClosed =
                                { reason -> this @FailureRoot.record.overlayClosed(reason) }
                        }
                    }
                ]
                else -> []
            }
        return element(
            late,
            { props, mount -> FailureLeaf(props, record, scope = mount) },
            children
        )
    }
    public override fun onMount() {
        record.rootMounts += 1
        if (record.mode == FailureMode.Mount) {
            scope.onDispose { record.log.add("dispose root") }
            scope.resource<FailureImage> { throw record.primary }
        }
    }
    public override fun onUnmount() {
        record.rootUnmounts += 1
        assertFalse(resource.image.isClosed)
        record.log.add("unmount root")
    }
}

private class FailurePortalAnchor(private val anchor: LayoutAnchor, scope: ComponentScope): Element<
    Unit
>(scope) {
    public override fun onMount() {
        scope.layoutAnchor(anchor)
    }
    public override fun measure(context: MeasureContext, constraints: Constraints): LayoutResult<
        Unit
    > = LayoutResult(LayoutMetrics(constraints.constrain(Size(0.0, 0.0))), Unit)
    public override fun scene(context: SceneContext, measured: Unit) {}
}

private fun failureModal(record: FailureRecord): Array<View> =
    [
        portal(
            record.overlayOpen.binding(),
            element({ mount -> FailureModal(record, scope = mount) })
        ) {
            this.options {
                this.handle = Some(record.overlay)
                this.mode = OverlayMode.Modal
                this.focus = Some(OverlayFocusOptions())
                this.onClosed = { reason -> record.overlayClosed(reason) }
            }
        }
    ]

private class FailureModal(private val record: FailureRecord, scope: ComponentScope): Element<Unit>(
    scope
) {
    public override fun onMount() {
        record.modalRoot = scope.input.parent!!.area
        if (record.mode == FailureMode.ModalMount)
            throw record.primary
    }
    public override fun measure(context: MeasureContext, constraints: Constraints): LayoutResult<
        Unit
    > = LayoutResult(LayoutMetrics(constraints.constrain(Size(20.0, 20.0))), Unit)
    public override fun scene(context: SceneContext, measured: Unit) {
        context.onFrameComplete { _ -> record.overlay.requestClose() }
    }
}

internal class FailureLeaf(
    private val props: Props<Boolean>,
    private val record: FailureRecord,
    scope: ComponentScope
): Element<Unit>(scope) {
    private var resource: FailureImage? = None
    private var area: InputArea? = None
    private var motion: Animatable<Double>? = None
    public override fun onMount() {
        record.leafMounts += 1
        resource = Some(scope.resource { FailureImage(record, "leaf") })
        area = Some(scope.createArea { _, _ -> Unit })
        motion = Some(scope.animation(0.0))
    }
    public override fun update(): UiInvalidation {
        if (
            record.mode ==
                FailureMode.Update ||
                (record.mode == FailureMode.LateUpdate && props.value)
        )
            throw record.primary
        return UiInvalidation.Layout
    }
    public override fun measure(context: MeasureContext, constraints: Constraints): LayoutResult<
        Unit
    > {
        if (record.mode == FailureMode.Measure)
            throw record.primary
        if (record.mode != FailureMode.MissingMeasure) {
            var index = 0L
            while (index < context.childCount) {
                context.measureChild(index, Constraints())
                context.placeChild(index, Point(0.0, 0.0))
                index += 1L
            }
        }
        return LayoutResult(LayoutMetrics(constraints.constrain(Size(80.0, 50.0))), Unit)
    }
    public override fun scene(context: SceneContext, measured: Unit) {
        if (record.mode == FailureMode.FrameComplete) {
            context.onFrameComplete { _ -> throw record.primary }
            context.onFrameComplete { _ -> fail(Some("notification after a failed completion")) }
        }
        context.saveLayer(0.5)
        context.draw {
            paint ->
            paint.canvas.drawImage(resource!!.image, Rect(0.0, 0.0, 40.0, 40.0))
            if (record.mode == FailureMode.Paint)
                throw record.primary
        }
        if (record.mode != FailureMode.MissingPaint)
            context.children()
        context.restore()
    }
    public override fun onUnmount() {
        record.leafUnmounts += 1
        assertFalse(scope.isMounted)
        assertTrue(area!!.isClosed)
        assertEquals(AnimationState.Closed, motion!!.state)
        assertFalse(resource!!.image.isClosed)
        record.log.add("unmount leaf")
    }
}

internal class SecondRoot(private val record: FailureRecord, scope: ComponentScope): Component(
    scope
) {
    public override fun render(): View = empty()
    public override fun onMount() {
        scope.resource { FailureImage(record, "second") }
    }
}
