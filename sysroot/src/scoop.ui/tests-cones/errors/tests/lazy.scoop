package scoop.tests.ui.errors

import scoop.graphics.*
import scoop.surface.*
import scoop.test.*
import scoop.ui.*

internal val FailureMode.isLazy: Boolean get() =
    when (this) {
        case LazyBuild -> true
        case LazyMount -> true
        case LazyMeasure -> true
        case LazyMissingPaint -> true
        case LazyMissingPinned -> true
        else -> false
    }

internal class LazyFailureSource(private val record: FailureRecord): ItemSource {
    public override val count = 100000000L
    public override fun keyAt(index: Long): ViewKey = ViewKey.Number(index)
    public override fun indexOfKey(key: ViewKey): Long? =
        when (key) {
            case Number(index) -> if (index >= 0L && index < count)
                Some(index)
            else
                None
            else -> None
        }
    public override fun build(index: Long): View {
        if (index == 1L && record.mode == FailureMode.LazyBuild)
            throw record.primary
        return element({ LazyFailureItem(record, index) })
    }
}

internal class LazyFailureContainer(private val record: FailureRecord): LazyElement {
    private var scope: ComponentScope? = None
    public override fun onMount(scope: ComponentScope) {
        this.scope = Some(scope)
    }
    public override fun measure(
        context: LazyMeasureContext,
        constraints: Constraints
    ): LayoutMetrics {
        record.lazyContext = Some(context)
        for (index in 0L ..< 2L) {
            if (index == 0L && record.lazySkip)
                continue
            context.measureItem(index, Constraints.tight(Size(40.0, 30.0)))
            context.placeItem(index, Point(index.toDouble() * 45.0, 0.0))
        }
        return LayoutMetrics(constraints.constrain(Size(100.0, 60.0)))
    }
    public override fun scene(context: SceneContext) {
        if (record.mode != FailureMode.LazyMissingPaint)
            context.children()
        if (record.mode == FailureMode.LazyMissingPinned && !record.lazySkip)
            context.onFrameComplete {
                frame -> if (frame.submission == FrameSubmission.Accepted) {
                    assertTrue(record.lazyItems[0L].area!!.requestFocus())
                    record.lazySkip = true
                    scope!!.requestFrame()
                }
            }
    }
}

internal class LazyFailureItem(private val record: FailureRecord, val index: Long): Element {
    var area: InputArea? = None
    var unmounts = 0
    private var resource: FailureImage? = None
    init {
        record.lazyItems.add(this)
    }
    public override fun onMount(scope: ComponentScope) {
        resource = Some(scope.resource { FailureImage(record, "lazy " + index.toString()) })
        area = Some(scope.createArea(focusable = true))
        if (index == 1L && record.mode == FailureMode.LazyMount)
            throw record.primary
    }
    public override fun measure(context: MeasureContext, constraints: Constraints): LayoutMetrics {
        if (index == 1L && record.mode == FailureMode.LazyMeasure)
            throw record.primary
        return LayoutMetrics(constraints.constrain(Size(40.0, 30.0)))
    }
    public override fun scene(context: SceneContext) {
        context.place(area!!, Rect(0.0, 0.0, context.size.width, context.size.height))
    }
    public override fun onUnmount() {
        unmounts += 1
        assertFalse(resource!!.image.isClosed)
        assertTrue(area!!.isClosed)
    }
}
