package scoop.tests.ui.text

import scoop.graphics.*
import scoop.graphics.native.captureGeometry
import scoop.graphics.text.*
import scoop.surface.*
import scoop.test.*
import scoop.time.Duration
import scoop.ui.*
import scoop.ui.text.*
import scoop.window.*

internal val actionKey = InlineKey.Number(7L)

internal val imageKey = InlineKey.Text("picture")

internal class TextScene(private val probe: TextProbe, scope: ComponentScope): Component(scope) {
    public override fun render(): View {
        probe.rootRenders += 1
        val generation = probe.generation.value
        val content =
            if (generation >= 4)
                probe.reordered
            else
                probe.original
        val action =
            inlineView(
                actionKey,
                component(
                    generation,
                    { props, mount -> InlineCounter(props, probe, scope = mount) },
                    ViewKey.Number(
                        if (generation >= 5)
                            1L
                        else
                            0L
                    )
                )
            )
        val photo =
            inlineView(imageKey, element({ mount -> InlinePhoto(probe, scope = mount) })) {
                this.size = Some(Size(22.0, 28.0))
                this.alignment = InlineViewAlignment.Explicit(InlineAlignment.Middle)
            }
        // Binding order is intentionally different from the first content's logical order.
        val inlines = [photo, action]
        return element(
            ParagraphInput(content, inlines, generation),
            { props, mount -> SelfDrawnParagraph(props, probe, scope = mount) },
            inlineChildren(content, inlines)
        )
    }
}

private class ParagraphInput(
    val content: StyledText,
    val inlines: Array<InlineView>,
    val generation: Int
)

private class SelfDrawnParagraph(
    private val props: Props<ParagraphInput>,
    private val probe: TextProbe,
    scope: ComponentScope
): Element<ParagraphMeasurement>(scope) {
    private var host: ParagraphHost? = None
    public override fun onMount() {
        host = Some(scope.resource { ParagraphHost() })
        probe.paragraph = host
    }
    public override fun measure(context: MeasureContext, constraints: Constraints): LayoutResult<
        ParagraphMeasurement
    > {
        val input = props.value
        val narrow = input.generation == 2
        val settings =
            paragraphStyle {
                this.direction =
                    if (input.generation >= 4)
                        TextDirection.Rtl
                    else
                        TextDirection.Ltr
                this.maxLines =
                    if (narrow)
                        Some(1L)
                    else
                        None
            }
        val measured =
            host!!.measure(
                context,
                Constraints(
                    maxWidth =
                        Some(
                            if (narrow)
                                40.0
                            else
                                520.0
                        )
                ),
                probe.fonts,
                input.content,
                Some(settings),
                input.inlines
            )
        val metrics = measured.metrics
        return LayoutResult(
            LayoutMetrics(
                constraints.constrain(Size(metrics.size.width + 40.0, metrics.size.height + 40.0)),
                Some(metrics.alphabeticBaseline!! + 20.0),
                Some(metrics.ideographicBaseline!! + 20.0)
            ),
            measured,
            { measured.close() }
        )
    }
    public override fun scene(context: SceneContext, measured: ParagraphMeasurement) {
        context.draw { paint -> paint.canvas.clear(Color.White) }
        context.translate(20.0, 20.0)
        host!!.scene(context, measured)
        probe.layout = Some(measured.layout)
        probe.paintedGeneration = props.value.generation
        probe.paints += 1
    }
}

internal class InlineCounter(
    private val props: Props<Int>,
    private val probe: TextProbe,
    scope: ComponentScope
): Component(scope) {
    var count: Int by state(0)
    var mounts = 0
    var unmounts = 0
    var renders = 0
    init {
        probe.counters.add(this)
    }
    public override fun onMount() {
        mounts += 1
    }
    public override fun onUnmount() {
        unmounts += 1
    }
    public override fun render(): View {
        renders += 1
        return element(
            CounterInput(count, props.value > 0, { count += 1 }),
            { input, mount -> CounterInk(input, probe, scope = mount) }
        )
    }
}

internal class CounterInput(val count: Int, val green: Boolean, val click: () -> Unit)

internal class CounterInk(
    private val props: Props<CounterInput>,
    private val probe: TextProbe,
    scope: ComponentScope
): Element<Unit>(scope) {
    var area: InputArea? = None
    var width: Animatable<Double>? = None
    var origin = Point(0.0, 0.0)
    var size = Size(0.0, 0.0)
    var paints = 0
    var observed = 0
    private var down = false
    public override fun onMount() {
        probe.inks.add(this)
        width = Some(scope.animation(60.0))
        area =
            Some(
                scope.createArea(focusable = true) {
                    current, event ->
                    when (event) {
                        case Pointer(
                            InputPointerEvent.Button(_, MouseButton.Left, ElementState.Pressed, _)
                        ) -> {
                            down = true
                            current.currentTarget.area!!.requestFocus()
                        }
                        case Pointer(
                            InputPointerEvent.Button(
                                val pointer,
                                MouseButton.Left,
                                ElementState.Released,
                                _
                            )
                        ) -> {
                            val activate =
                                down &&
                                    Rect(0.0, 0.0, size.width, size.height).contains(
                                        current.localPosition!!
                                    )
                            down = false
                            if (activate)
                                props.value.click()
                        }
                        case Pointer(InputPointerEvent.Cancelled(_, _)) -> down = false
                        case FocusChanged(val focused) -> {
                            if (!focused)
                                down = false
                        }
                        else -> {}
                    }
                    current.consume()
                }
            )
    }
    public override fun update(): UiInvalidation {
        observed = props.value.count
        val target = 60.0 + props.value.count.toDouble() * 40.0
        if (width!!.target != target)
            width!!.animateTo(target, AnimationSpec.Tween(Duration.milliseconds(80L)))
        return UiInvalidation.Layout
    }
    public override fun measure(context: MeasureContext, constraints: Constraints): LayoutResult<
        Unit
    > {
        assertEquals(None, constraints.maxHeight)
        val size = constraints.constrain(Size(width!!.value, 32.0))
        return LayoutResult(LayoutMetrics(size, Some(24.0), Some(29.0)), Unit)
    }
    public override fun scene(context: SceneContext, measured: Unit) {
        size = context.size
        context.draw {
            paint ->
            @Unsafe
            {
                captureGeometry(paint.canvas, Rect(0.0, 0.0, size.width, size.height)).use {
                    geometry -> origin = geometry.toWindow(Point(0.0, 0.0))
                }
            }
            paint.canvas.drawRect(
                Rect(0.0, 0.0, size.width, size.height),
                Paint(
                    if (props.value.green)
                        Color(0.1, 0.7, 0.2)
                    else
                        Color(0.1, 0.3, 0.9)
                )
            )
            paints += 1
        }
        context.place(area!!, Rect(0.0, 0.0, size.width, size.height))
    }
}

internal class InlinePhoto(private val probe: TextProbe, scope: ComponentScope): Element<Unit>(
    scope
) {
    var image: Image? = None
    var origin = Point(0.0, 0.0)
    var unmounts = 0
    public override fun onMount() {
        probe.photos.add(this)
        image =
            Some(
                scope.resource {
                    RasterSurface(3, 3).use {
                        raster ->
                        raster.draw { canvas -> canvas.clear(Color(0.9, 0.1, 0.3)) }
                        raster.snapshot()
                    }
                }
            )
    }
    public override fun measure(context: MeasureContext, constraints: Constraints): LayoutResult<
        Unit
    > {
        assertEquals(Constraints.tight(Size(22.0, 28.0)), constraints)
        return LayoutResult(LayoutMetrics(constraints.constrain(Size(90.0, 70.0))), Unit)
    }
    public override fun scene(context: SceneContext, measured: Unit) {
        context.draw {
            paint ->
            @Unsafe
            {
                captureGeometry(
                    paint.canvas,
                    Rect(0.0, 0.0, paint.size.width, paint.size.height)
                ).use { geometry -> origin = geometry.toWindow(Point(0.0, 0.0)) }
            }
            paint.canvas.drawImage(image!!, Rect(0.0, 0.0, paint.size.width, paint.size.height))
        }
    }
    public override fun onUnmount() {
        unmounts += 1
        assertFalse(image!!.isClosed)
    }
}
