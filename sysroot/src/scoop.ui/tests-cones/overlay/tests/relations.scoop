package scoop.tests.ui.overlay

import scoop.graphics.*
import scoop.test.*
import scoop.ui.*

internal fun relationProbes(probe: OverlayProbe): Array<View> =
    [
        portal(
            element({ RelationAnchor(probe, probe.selfAnchor, true) }),
            PortalOptions(
                OverlayPlacement.Anchored(probe.selfAnchor),
                anchorVisibility = AnchorVisibility.Hide
            ),
            ViewKey.Text("self")
        ),
        portal(
            element({ RelationAnchor(probe, probe.cycleA, false) }),
            PortalOptions(
                OverlayPlacement.Anchored(probe.cycleB),
                anchorVisibility = AnchorVisibility.Hide
            ),
            ViewKey.Text("cycle-a")
        ),
        portal(
            element({ RelationAnchor(probe, probe.cycleB, true) }),
            PortalOptions(
                OverlayPlacement.Anchored(probe.cycleA),
                anchorVisibility = AnchorVisibility.Hide
            ),
            ViewKey.Text("cycle-b")
        ),
        portal(
            empty(),
            PortalOptions(
                OverlayPlacement.Anchored(probe.foreignAnchor),
                anchorVisibility = AnchorVisibility.Hide
            ),
            ViewKey.Text("foreign")
        )
    ]

private class RelationAnchor(
    private val probe: OverlayProbe,
    private val anchor: LayoutAnchor,
    private val cyclic: Boolean
): Element {
    public override fun onMount(scope: ComponentScope) {
        if (cyclic) {
            assertFailsWith<IllegalStateException> { scope.layoutAnchor(anchor) }
            assertFalse(anchor.isAttached)
            probe.relationChecks += 1
        } else
            scope.layoutAnchor(anchor)
    }
    public override fun measure(context: MeasureContext, constraints: Constraints): LayoutMetrics =
        LayoutMetrics(constraints.constrain(Size(0.0, 0.0)))
    public override fun scene(context: SceneContext) {}
}

internal class ForeignRoot(private val probe: OverlayProbe): Component {
    public override fun render(): View = empty()
    public override fun onMount(scope: ComponentScope) {
        assertFailsWith<IllegalArgumentException> { scope.layoutAnchor(probe.foreignAnchor) }
        assertFalse(probe.foreignAnchor.isAttached)
        probe.relationChecks += 1
    }
}
