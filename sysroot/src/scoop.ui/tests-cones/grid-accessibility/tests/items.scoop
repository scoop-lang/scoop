package scoop.tests.ui.gridaccessibility

import scoop.collections.HashSet
import scoop.graphics.*
import scoop.math.max
import scoop.math.min
import scoop.surface.FrameSubmission
import scoop.test.*
import scoop.ui.*
import scoop.window.accessibility.*

internal class AxRows(
    val probe: AxGridProbe,
    val reverse: Boolean = false,
    val omitColumn: Boolean = false,
    val omitRow: Boolean = false,
    val enabled: Boolean = true
): ItemSource {
    public override val count: Long get() =
        if (omitRow)
            99999999L
        else
            100000000L
    val columnCount: Long get() =
        if (omitColumn)
            299L
        else
            300L
    public override fun keyAt(index: Long): ViewKey =
        ViewKey.Number(
            if (omitRow && index >= 50000L)
                index + 1L
            else
                index
        )
    public override fun indexOfKey(key: ViewKey): Long? =
        when (key) {
            case Number(val value) -> {
                if (value < 0L || value >= 100000000L || (omitRow && value == 50000L))
                    None
                else
                    Some(
                        if (omitRow && value > 50000L)
                            value - 1L
                        else
                            value
                    )
            }
            else -> None
        }
    fun columnAt(index: Long): Long {
        val at =
            if (reverse)
                columnCount - index - 1L
            else
                index
        return if (omitColumn && at >= 250L)
            at + 1L
        else
            at
    }
    fun columnIndex(key: Long): Long? {
        if (key < 0L || key >= 300L || (omitColumn && key == 250L))
            return None
        val at =
            if (omitColumn && key > 250L)
                key - 1L
            else
                key
        return Some(
            if (reverse)
                columnCount - at - 1L
            else
                at
        )
    }
    public override fun build(index: Long): View {
        probe.rowBuilds += 1
        val row =
            when (keyAt(index)) {
                case Number(val key) -> key
                else -> fail(Some("numeric row expected"))
            }
        val columns = AxColumns(this, row, index)
        return lazyElement(columns, columns, { props, scope -> AxRow(props, scope) })
    }
    fun semantics(): ItemSemantics =
        ItemSemantics(
            this,
            { _ -> Some(SemanticItemProperties(enabled = enabled, focusable = true)) },
            grid =
                Some(
                    SemanticGrid(
                        Array(columnCount) {
                            index -> SemanticGridColumn(
                                SemanticItemKey.Number(columnAt(index)),
                                Some("Column"),
                                probe.leafHeader?.id
                            )
                        }
                    ) {
                        row, column ->
                        // Queries are protected by the ordinary read-only UI evaluation boundary.
                        assertFailsWith<IllegalStateException> { probe.queryGuard.value += 1 }
                        Some(
                            SemanticItemProperties(
                                value =
                                    Some(
                                        when (row) {
                                            case Number(val key) -> f"${key}:${columnAt(column)}"
                                            else -> "invalid"
                                        }
                                    ),
                                enabled = enabled,
                                focusable = true
                            )
                        )
                    }
                )
        )
}

internal class AxColumns(val rows: AxRows, val row: Long, val index: Long): ItemSource {
    public override val count: Long get() = rows.columnCount
    public override fun keyAt(index: Long): ViewKey = ViewKey.Number(rows.columnAt(index))
    public override fun indexOfKey(key: ViewKey): Long? =
        when (key) {
            case Number(val value) -> rows.columnIndex(value)
            else -> None
        }
    public override fun build(index: Long): View {
        rows.probe.cellBuilds += 1
        return element(
            AxCellProps(this, rows.columnAt(index), index),
            { props, scope -> AxCell(props, scope) },
            [element({ scope -> AxCellCaption(scope) })]
        )
    }
}

internal class AxTable(private val props: Props<AxRows>, scope: ComponentScope): LazyElement<Unit>(
    scope
) {
    private val semantics = scope.semantics(SemanticRole.Table)
    private val groupHeader = scope.semantics(SemanticRole.ColumnHeader)
    private val leafHeader = scope.semantics(SemanticRole.ColumnHeader)
    init {
        props.value.probe.table = Some(semantics)
        props.value.probe.groupHeader = Some(groupHeader)
        props.value.probe.leafHeader = Some(leafHeader)
        scope.routeSemanticsChildren(Some(semantics))
    }
    public override fun update(): UiInvalidation {
        val rows = props.value
        groupHeader.update(SemanticProperties(name = Some("Metrics")))
        leafHeader.update(SemanticProperties(name = Some("Column")))
        semantics.update(
            SemanticProperties(
                automationId = Some("grid"),
                table = Some(SemanticTableSize(rows.count, rows.columnCount))
            )
        )
        semantics.updateCollection(rows, Some(rows.semantics()), rows.probe.viewport)
        return UiInvalidation.Layout
    }
    public override fun measure(
        context: LazyMeasureContext,
        constraints: Constraints
    ): LayoutResult<Unit> {
        val scroll = context.input<AxLayout>().scroll.snapshot
        val first = (scroll.offset.y / 24.0).toLong()
        val selected = HashSet<Long>()
        for (index in first ..< first + 10L)
            if (index >= 0L && index < context.itemCount)
                selected.add(index)
        for (index in context.pinnedItems)
            selected.add(index)
        for (index in selected) {
            context.measureItem(index, Constraints.tight(Size(scroll.content.width, 24.0)))
            context.placeItem(index, Point(0.0, index.toDouble() * 24.0))
        }
        return LayoutResult(LayoutMetrics(constraints.constrain(scroll.content)), Unit)
    }
    public override fun scene(context: SceneContext, value: Unit) {
        context.semantics(semantics, Rect(0.0, 0.0, context.size.width, context.size.height))
        context.semantics(groupHeader, Rect(24.0, 24.0, 232.0, 12.0))
        context.semantics(leafHeader, Rect(24.0, 36.0, 232.0, 12.0))
        context.children()
    }
}

private class AxRow(private val props: Props<AxColumns>, scope: ComponentScope): LazyElement<Unit>(
    scope
) {
    public override fun onMount() {
        val input = props.value
        assertFailsWith<IllegalArgumentException> {
            scope.bindGridColumns(input.rows.probe.table!!, ViewKey.Number(input.row + 1L))
        }
        scope.bindGridColumns(input.rows.probe.table!!, ViewKey.Number(input.row))
    }
    public override fun measure(
        context: LazyMeasureContext,
        constraints: Constraints
    ): LayoutResult<Unit> {
        val scroll = context.input<AxLayout>().scroll.snapshot
        val first = (scroll.offset.x / 80.0).toLong()
        val selected = HashSet<Long>()
        selected.add(props.value.rows.columnIndex(0L)!!)
        for (index in first ..< first + 5L)
            if (index >= 0L && index < context.itemCount)
                selected.add(index)
        for (index in context.pinnedItems)
            selected.add(index)
        for (index in selected) {
            context.measureItem(index, Constraints.tight(Size(80.0, 24.0)))
            context.placeItem(
                index,
                Point(
                    if (props.value.rows.columnAt(index) == 0L)
                        scroll.offset.x + 24.0
                    else
                        index.toDouble() * 80.0,
                    0.0
                )
            )
        }
        return LayoutResult(
            LayoutMetrics(constraints.constrain(Size(scroll.content.width, 24.0))),
            Unit
        )
    }
    public override fun scene(context: SceneContext, value: Unit) = context.children()
}

private class AxCellProps(val source: AxColumns, val column: Long, val index: Long)

private class AxCell(private val props: Props<AxCellProps>, scope: ComponentScope): Element<Rect>(
    scope
) {
    private val focus = FocusHandle()
    private val area = scope.createArea(focusable = true)
    private val target = scope.focusTarget(area, FocusOptions(Some(focus)))
    private val semantics = scope.semantics(SemanticRole.Cell)
    private var presented = false
    public override fun onMount() {
        val input = props.value
        input.source.rows.probe.mounted += 1
        if (input.source.row == 50000L && input.column == 250L) {
            input.source.rows.probe.target = Some(focus)
            input.source.rows.probe.targetSemantics = Some(semantics)
        }
        if (input.source.row == 60000L && input.column == 260L)
            input.source.rows.probe.other = Some(focus)
        if (input.source.row == 70000L && input.column == 0L) {
            input.source.rows.probe.frozen = Some(focus)
            input.source.rows.probe.frozenSemantics = Some(semantics)
        }
        semantics.bindFocus(Some(target))
        semantics.mergeLabels = true
        scope.routeSemanticsChildren(Some(semantics))
    }
    public override fun onUnmount() {
        props.value.source.rows.probe.mounted -= 1
    }
    public override fun update(): UiInvalidation {
        val input = props.value
        semantics.update(
            SemanticProperties(
                value = Some(f"${input.source.row}:${input.column}"),
                enabled = input.source.rows.enabled,
                cell =
                    Some(
                        SemanticTableCell(
                            input.source.index,
                            input.index,
                            columnKey = Some(SemanticItemKey.Number(input.column))
                        )
                    )
            ),
            relations =
                SemanticRelations(
                    columnHeaders =
                        [
                            input.source.rows.probe.groupHeader!!.id,
                            input.source.rows.probe.leafHeader!!.id
                        ]
                )
        )
        return UiInvalidation.Layout
    }
    public override fun measure(context: MeasureContext, constraints: Constraints): LayoutResult<
        Rect
    > {
        val scroll = context.input<AxLayout>().scroll.snapshot
        val fixed = props.value.column == 0L
        val left =
            if (fixed)
                24.0
            else
                104.0
        val right =
            if (fixed)
                104.0
            else
                256.0
        val x =
            if (fixed)
                24.0
            else
                props.value.index.toDouble() * 80.0 - scroll.offset.x
        val start = max(0.0, left - x)
        val end = min(80.0, right - x)
        context.measureChild(0L, Constraints.tight(Size(80.0, 24.0)))
        context.placeChild(0L, Point(0.0, 0.0))
        return LayoutResult(
            LayoutMetrics(constraints.constrain(Size(80.0, 24.0))),
            Rect(start, 0.0, max(0.0, end - start), 24.0)
        )
    }
    public override fun scene(context: SceneContext, clip: Rect) {
        val bounds = Rect(0.0, 0.0, context.size.width, context.size.height)
        val inset = Rect(1.0, 1.0, context.size.width - 2.0, context.size.height - 2.0)
        val fixed = props.value.column == 0L
        val region =
            if (fixed)
                Rect(24.0, 24.0, 80.0, 156.0)
            else
                Rect(104.0, 24.0, 152.0, 156.0)
        context.withScrollReveal(
            props.value.source.rows.probe.viewport!!,
            region,
            if (fixed)
                ScrollAxes.Vertical
            else
                ScrollAxes.Both
        ) {
            cell ->
            cell.clipRect(clip)
            cell.place(area, bounds)
            cell.semantics(semantics, bounds)
            cell.draw { paint -> paint.canvas.drawRect(inset, Paint(Color(0.2, 0.4, 0.8))) }
            cell.children()
            cell.onFrameComplete {
                frame -> if (frame.submission == FrameSubmission.Accepted && !presented) {
                    presented = true
                    assertTrue(
                        semantics.geometry != None,
                        Some("a lazy cell with a merged caption lost its first accepted geometry")
                    )
                }
            }
        }
    }
}

private class AxCellCaption(scope: ComponentScope): Element<Unit>(scope) {
    private val semantics = scope.semantics(SemanticRole.Text)
    public override fun update(): UiInvalidation {
        semantics.update(SemanticProperties(name = Some("Cell caption")))
        return UiInvalidation.Layout
    }
    public override fun measure(context: MeasureContext, constraints: Constraints): LayoutResult<
        Unit
    > = LayoutResult(LayoutMetrics(constraints.constrain(Size(80.0, 24.0))), Unit)
    public override fun scene(context: SceneContext, value: Unit) {
        context.semantics(semantics, Rect(0.0, 0.0, context.size.width, context.size.height))
    }
}

internal fun axCaptionOverlay(probe: AxGridProbe): View {
    val captions = AxCaptionSource()
    return portal(
        probe.overlayOpen.binding(),
        lazyElement(captions, { scope -> AxCaptionOverlay(probe, scope) })
    ) {
        options {
            placement = OverlayPlacement.Viewport(OverlayAlignment.End, OverlayAlignment.End, 0.0)
        }
    }
}

private class AxCaptionSource: ItemSource {
    public override val count: Long get() = 1L
    public override fun keyAt(index: Long): ViewKey = ViewKey.Text("caption")
    public override fun indexOfKey(key: ViewKey): Long? =
        if (key == ViewKey.Text("caption"))
            Some(0L)
        else
            None
    public override fun build(index: Long): View = element({ scope -> AxCellCaption(scope) })
}

private class AxCaptionOverlay(private val probe: AxGridProbe, scope: ComponentScope): LazyElement<
    Unit
>(scope) {
    private val semantics = scope.semantics(SemanticRole.Group)
    init {
        scope.routeSemanticsChildren(Some(semantics))
        semantics.mergeLabels = true
    }
    public override fun measure(
        context: LazyMeasureContext,
        constraints: Constraints
    ): LayoutResult<Unit> {
        val size = Size(80.0, 24.0)
        context.measureItem(0L, Constraints.tight(size))
        context.placeItem(0L, Point(0.0, 0.0))
        return LayoutResult(LayoutMetrics(constraints.constrain(size)), Unit)
    }
    public override fun scene(context: SceneContext, value: Unit) {
        context.semantics(semantics, Rect(0.0, 0.0, context.size.width, context.size.height))
        context.children()
        context.onFrameComplete {
            frame -> if (frame.submission == FrameSubmission.Accepted && !probe.overlayPresented) {
                probe.overlayPresented = true
                assertTrue(
                    semantics.geometry != None,
                    Some("an overlay with a lazy caption lost its first accepted geometry")
                )
            }
        }
    }
}
