package scoop.tests.ui.gridaccessibility

import scoop.graphics.*
import scoop.platform.time.MonotonicTimeSource
import scoop.test.*
import scoop.tests.ui.accessibility.native.*
import scoop.time.Duration
import scoop.ui.*
import scoop.window.*
import scoop.window.accessibility.SemanticProperties
import scoop.window.native.*

@Test
private class GridAccessibilityTest {
    @Test(useProcess = true)
    fun `native cells realize reveal focus and retire across two lazy axes`() {
        val probe = AxGridProbe()
        try {
            UiHost { host, active, event -> probe.event(host, active, event) }.use {
                host -> Application().run(host)
            }
            assertTrue(probe.finished)
            assertTrue(probe.overlayPresented)
            assertEquals(0, probe.mounted)
            assertTrue(probe.rowBuilds < 300)
            assertTrue(probe.cellBuilds < 2000)
            assertEquals(0, probe.queryGuard.value)
        } finally {
            probe.close()
        }
    }
}

internal class AxGridProbe: Closeable {
    val scroll = ScrollState()
    val outside = FocusHandle()
    val rows = state(AxRows(this))
    val queryGuard = state(0)
    val overlayOpen = state(true)
    val cellOverlayOpen = state(false)
    var cellOverlayClicks = 0
    var overlayPresented = false
    var viewport: ScrollViewport? = None
    var frame: ComponentScope? = None
    var endedScene: SceneContext? = None
    var table: SemanticsHandle? = None
    var groupHeader: SemanticsHandle? = None
    var leafHeader: SemanticsHandle? = None
    var target: FocusHandle? = None
    var targetSemantics: SemanticsHandle? = None
    var distantSemantics: SemanticsHandle? = None
    var other: FocusHandle? = None
    var frozen: FocusHandle? = None
    var frozenSemantics: SemanticsHandle? = None
    var rowBuilds = 0
    var cellBuilds = 0
    var mounted = 0
    var finished = false
    private var phase = 0
    private var waiting = false
    private var retry = false
    private var initialized = false
    private var beforeRows = 0
    private var beforeCells = 0
    private var active: ActiveApplication? = None
    private var window: Window? = None
    private var ui: UiWindow? = None
    private var root: NativeNode? = None
    private var nativeTable: NativeNode? = None
    private var nativeView: Ptr<Unit>? = None
    private var cell: NativeNode? = None
    private var otherCell: NativeNode? = None
    private var replacement: NativeNode? = None
    private var frozenCell: NativeNode? = None
    private var spanCell: NativeNode? = None
    private var coveredCell: NativeNode? = None
    private var distantCell: NativeNode? = None
    private var rowPopup: NativeNode? = None
    private var beforeX = 0.0
    private var beforeSpanOffset = Point(0.0, 0.0)
    private var calls: NativeCalls? = None
    private val held = ArrayList<NativeNode>()

    fun event(host: UiHost, application: ActiveApplication, event: ApplicationEvent) {
        when (event) {
            case Resumed -> {
                active = Some(application)
                application.setControlFlow(
                    ControlFlow.WaitUntil(MonotonicTimeSource.now() + Duration.seconds(30L))
                )
                val native =
                    application.createWindow(
                        windowAttributes {
                            title = "Scoop Grid accessibility"
                            size = LogicalSize(280.0, 220.0)
                        }
                    )
                window = Some(native)
                ui = host.attach(native, { mount -> AxGridScene(this, mount) })
                @Unsafe
                {
                    val lease = native.acquireNativeWindow()
                    try {
                        val view =
                            when (lease.handle) {
                                case AppKit(_, val pointer) -> pointer
                            }
                        root = Some(keep(NativeNode(nativeRoot(view)!!)))
                        nativeView = Some(view)
                    } finally {
                        lease.close()
                    }
                }
                calls =
                    Some(
                        NativeCalls(application.proxy(), { tag -> inspect(tag) }) {
                            tag,
                            result -> completed(tag, result)
                        }
                    )
            }
            case NewEvents(StartCause.Deadline) -> fail(
                Some(
                    f"grid AX timeout phase=${phase}, nativeFocus=${
                        window?.isFocused ?: false
                    }, pending=${target?.isPending ?: false}, mounted=${mounted}, x=${
                        scroll.offset.x
                    }, y=${scroll.offset.y}"
                )
            )
            case Window(_, WindowEvent.Focused(true)) -> frame?.requestFrame()
            else -> {}
        }
    }
    fun accepted(snapshot: AxRows) {
        if (finished || waiting || snapshot !== rows.value)
            return
        when (calls) {
            case Some(_) -> {}
            case None -> return
        }
        if (!initialized) {
            initialized = true
            window!!.requestFocus()
            assertTrue(outside.requestFocus())
        }
        send()
    }
    private fun keep(node: NativeNode): NativeNode {
        held.add(node)
        return node
    }
    private fun at(row: Long, column: Long): NativeNode = keep(nativeTable!!.cell(row, column)!!)
    private fun send() {
        waiting = true
        retry = false
        when (phase) {
            case 1 -> calls!!.post(cell!!, phase, 19)
            case 3 -> calls!!.post(cell!!, phase, 19, selectionStart = 1L)
            case 5 -> calls!!.post(cell!!, phase, 19, selectionStart = 1L)
            case 7 -> calls!!.post(otherCell!!, phase, 2)
            case 9 -> calls!!.post(cell!!, phase, 3)
            case 10 -> calls!!.post(otherCell!!, phase, 3)
            case 12 -> calls!!.post(cell!!, phase, 19, selectionStart = 1L)
            case 15 -> calls!!.post(cell!!, phase, 19)
            case 18 -> calls!!.post(cell!!, phase, 19)
            case 21 -> calls!!.post(replacement!!, phase, 2)
            case 24 -> calls!!.post(frozenCell!!, phase, 19, selectionStart = 1L)
            case 26 -> calls!!.post(frozenCell!!, phase, 2)
            case 27 -> calls!!.post(frozenCell!!, phase, 3)
            case 28 -> calls!!.post(coveredCell!!, phase, 19, selectionStart = 1L)
            case 30 -> calls!!.post(spanCell!!, phase, 19)
            case 32 -> calls!!.post(spanCell!!, phase, 19, selectionStart = 1L)
            case 34 -> calls!!.post(spanCell!!, phase, 2)
            case 38 -> calls!!.post(spanCell!!, phase, 19)
            case 43 -> calls!!.post(distantCell!!, phase, 19, selectionStart = 1L)
            case 46 -> calls!!.post(rowPopup!!, phase)
            else -> calls!!.post(root!!, phase, 20)
        }
    }
    private fun inspect(tag: Int) {
        assertEquals(phase, tag)
        when (phase) {
            case 0 -> {
                assertFailsWith<IllegalStateException> {
                    endedScene!!.withScrollReveal<Unit>(viewport!!, Rect(0.0, 0.0, 280.0, 180.0)) {
                        _ -> fail(Some("an ended scene was accepted"))
                    }
                }
                nativeTable = Some(keep(root!!.find("grid")!!))
                beforeRows = rowBuilds
                beforeCells = cellBuilds
                cell = Some(at(50000L, 250L))
                assertTrue(cell!!.text(1, Some("50000:250")))
                assertTrue(cell!!.flag(15))
                assertTrue(cell!!.flag(16))
                assertFalse(cell!!.flag(2))
                assertEquals(beforeRows, rowBuilds)
                assertEquals(beforeCells, cellBuilds)
                checkHeaders(cell!!, ["Column"])
            }
            case 1 -> {
                assertEquals(beforeRows + 1, rowBuilds)
                assertEquals(beforeCells + 1, cellBuilds)
                assertTrue(target!!.isAttached)
                assertFalse(cell!!.flag(2))
                assertEquals(Point(0.0, 0.0), scroll.offset)
                assertTrue(outside.hasFocus)
                checkHeaders(cell!!, ["Metrics", "Column"])
            }
            case 2 -> {
                retry = target?.isAttached ?: false
                if (!retry)
                    checkHeaders(cell!!, ["Column"])
            }
            case 3 -> assertTrue(outside.hasFocus)
            case 4 -> {
                val geometry = targetSemantics?.geometry ?: None
                retry = (geometry?.visibleBounds ?: None) == None
                if (!retry) {
                    assertTrue(cell!!.flag(2))
                    assertFalse(cell!!.flag(4))
                    assertTrue(scroll.offset.x > 10000.0 && scroll.offset.y > 1000000.0)
                    assertEquals(Point(19824.0, 1199844.0), scroll.offset)
                    assertTrue(cell!!.frame(nativeView!!, 176.0, 156.0, 80.0, 24.0))
                    assertTrue(cell!!.cellSpan(50000L, 250L))
                    checkHeaders(cell!!, ["Metrics", "Column"])
                    assertTrue(outside.hasFocus)
                }
            }
            case 5 -> assertFalse(cell!!.flag(4))
            case 6 -> {
                checkHeaders(cell!!, ["Column"])
                beforeCells = cellBuilds
                otherCell = Some(at(60000L, 260L))
                assertTrue(otherCell!!.text(1, Some("60000:260")))
                assertEquals(beforeCells, cellBuilds)
            }
            case 7 -> assertTrue(other!!.isPending)
            case 8 -> {
                retry = !(other?.isFocusActive ?: false)
                if (!retry) {
                    assertTrue(otherCell!!.flag(4))
                    checkHeaders(otherCell!!, ["Metrics", "Column"])
                    assertEquals(Point(20624.0, 1439844.0), scroll.offset)
                    assertTrue(otherCell!!.frame(nativeView!!, 176.0, 156.0, 80.0, 24.0))
                    val adjacent = at(60000L, 0L)
                    assertTrue(
                        adjacent.flag(2),
                        Some(
                            "a newly mounted sibling with a merged caption has no accepted geometry"
                        )
                    )
                    assertTrue(adjacent.frame(nativeView!!, 24.0, 156.0, 80.0, 24.0))
                    assertFalse(cell!!.flag(4))
                    assertFalse(outside.hasFocus)
                }
            }
            case 9 -> assertTrue(otherCell!!.flag(4))
            case 10 -> {
                assertFalse(otherCell!!.flag(4))
                assertFalse(other!!.isPending)
            }
            case 11 -> {
                assertTrue(otherCell!!.same(at(60000L, 39L)))
                assertTrue(cell!!.same(at(50000L, 49L)))
                assertTrue(cell!!.text(1, Some("50000:250")))
            }
            case 12 -> scroll.scrollTo(Point(0.0, 0.0))
            case 13 -> {
                retry = scroll.offset != Point(0.0, 0.0) || (target?.isAttached ?: false)
                if (!retry) {
                    assertFalse(cell!!.flag(4))
                    beforeRows = rowBuilds
                    beforeCells = cellBuilds
                }
            }
            case 14 -> {
                assertFalse(cell!!.flag(1))
                beforeRows = rowBuilds
                beforeCells = cellBuilds
            }
            case 15 -> {
                assertEquals(beforeRows, rowBuilds)
                assertEquals(beforeCells, cellBuilds)
            }
            case 16 -> {
                assertFalse(cell!!.flag(0))
                checkHeaders(cell!!, [])
                assertTrue(otherCell!!.same(at(60000L, 39L)))
            }
            case 17 -> {
                replacement = Some(at(50000L, 49L))
                assertFalse(cell!!.same(replacement!!))
                assertFalse(cell!!.flag(0))
                assertTrue(replacement!!.flag(0))
                beforeCells = cellBuilds
            }
            case 18 -> assertEquals(beforeCells, cellBuilds)
            case 19 -> {
                assertFalse(replacement!!.flag(0))
                assertTrue(otherCell!!.same(at(59999L, 39L)))
            }
            case 20 -> {
                val restored = at(50000L, 49L)
                assertFalse(replacement!!.same(restored))
                assertFalse(replacement!!.flag(0))
                replacement = Some(restored)
            }
            case 21 -> {
                assertTrue(target!!.isPending)
                assertTrue(outside.requestFocus())
                assertFalse(target!!.isPending)
            }
            case 22 -> {
                retry = !outside.isFocusActive
                if (!retry)
                    assertFalse(replacement!!.flag(4))
            }
            case 23 -> {
                frozenCell = Some(at(70000L, 299L))
                beforeX = scroll.offset.x
            }
            case 24 -> assertTrue(outside.hasFocus)
            case 25 -> {
                val geometry = frozenSemantics?.geometry ?: None
                retry = (geometry?.visibleBounds ?: None) == None
                if (!retry) {
                    assertEquals(beforeX, scroll.offset.x)
                    assertTrue(frozenCell!!.frame(nativeView!!, 24.0, 156.0, 80.0, 24.0))
                    assertTrue(outside.hasFocus)
                }
            }
            case 26 -> {
                assertTrue(frozen!!.isFocusActive)
                assertTrue(frozenCell!!.flag(4))
                assertEquals(beforeX, scroll.offset.x)
            }
            case 27 -> {
                assertFalse(frozenCell!!.flag(4))
                coveredCell = Some(at(50000L, 48L))
                beforeSpanOffset = scroll.offset
            }
            case 28 -> {
                assertTrue(coveredCell!!.text(1, Some("50000:251")))
                assertTrue(coveredCell!!.cellSpan(50000L, 48L))
            }
            case 29 -> {
                beforeRows = rowBuilds
                beforeCells = cellBuilds
                assertFalse(coveredCell!!.flag(0))
                spanCell = Some(at(50000L, 251L))
                assertTrue(spanCell!!.same(at(50000L, 250L)))
                assertTrue(spanCell!!.same(at(50000L, 252L)))
                assertTrue(spanCell!!.text(1, Some("50000:250")))
                assertTrue(spanCell!!.cellSpan(50000L, 250L, columns = 3L))
                assertEquals(298L, spanCell!!.rowCellCount)
                assertFalse(spanCell!!.flag(2))
                assertEquals(beforeSpanOffset, scroll.offset)
                assertEquals(beforeRows, rowBuilds)
                assertEquals(beforeCells, cellBuilds)
            }
            case 30 -> {
                assertEquals(beforeRows + 1, rowBuilds)
                assertEquals(beforeCells + 1, cellBuilds)
                assertTrue(target!!.isAttached)
                assertTrue(spanCell!!.cellSpan(50000L, 250L, columns = 3L))
                checkHeaders(spanCell!!, ["Metrics", "Column"])
            }
            case 31 -> {
                retry = target?.isAttached ?: false
                if (!retry) {
                    assertTrue(spanCell!!.cellSpan(50000L, 250L, columns = 3L))
                    checkHeaders(spanCell!!, ["Column"])
                }
            }
            case 32 -> assertTrue(outside.hasFocus)
            case 33 -> {
                val geometry = targetSemantics?.geometry ?: None
                retry = (geometry?.visibleBounds ?: None) == None
                if (!retry) {
                    assertTrue(spanCell!!.frame(nativeView!!, 104.0, 24.0, 240.0, 24.0))
                    assertTrue(spanCell!!.same(at(50000L, 252L)))
                    assertTrue(outside.hasFocus)
                }
            }
            case 34 -> {
                assertTrue(target!!.isFocusActive)
                assertTrue(spanCell!!.flag(4))
            }
            case 35 -> {
                assertTrue(spanCell!!.same(at(50000L, 49L)))
                assertTrue(spanCell!!.same(at(50000L, 51L)))
                assertTrue(spanCell!!.cellSpan(50000L, 49L, columns = 3L))
                assertTrue(spanCell!!.text(1, Some("50000:250")))
            }
            case 36 -> {
                assertTrue(spanCell!!.same(at(50000L, 49L)))
                assertTrue(spanCell!!.cellSpan(50000L, 49L))
                assertFalse(coveredCell!!.flag(0))
                assertFalse(coveredCell!!.same(at(50000L, 48L)))
                assertEquals(300L, spanCell!!.rowCellCount)
                coveredCell = Some(at(50000L, 50L))
                assertFalse(coveredCell!!.same(spanCell!!))
            }
            case 37 -> {
                assertFalse(coveredCell!!.flag(0))
                assertFalse(spanCell!!.flag(1))
                assertTrue(spanCell!!.same(at(50000L, 50L)))
                beforeRows = rowBuilds
                beforeCells = cellBuilds
            }
            case 38 -> {
                assertEquals(beforeRows, rowBuilds)
                assertEquals(beforeCells, cellBuilds)
            }
            case 39 -> {
                assertFalse(spanCell!!.flag(0))
                assertTrue(at(50000L, 49L).text(1, Some("50000:249")))
            }
            case 40 -> {
                val restored = at(50000L, 50L)
                assertFalse(spanCell!!.same(restored))
                assertFalse(spanCell!!.flag(0))
                spanCell = Some(restored)
                assertTrue(spanCell!!.cellSpan(50000L, 49L, columns = 3L))
            }
            case 41 -> assertFalse(spanCell!!.flag(0))
            case 42 -> {
                val builtRows = rowBuilds
                val builtCells = cellBuilds
                distantCell = Some(at(50000000L, 250L))
                assertTrue(distantCell!!.text(1, Some("50000000:250")))
                assertFalse(distantCell!!.flag(2))
                assertEquals(builtRows, rowBuilds)
                assertEquals(builtCells, cellBuilds)
                assertEquals(Point(0.0, 0.0), scroll.offset)
            }
            case 43 -> assertTrue(outside.hasFocus)
            case 44 -> {
                val geometry = distantSemantics?.geometry ?: None
                retry = (geometry?.visibleBounds ?: None) == None
                if (!retry) {
                    assertTrue(distantCell!!.frame(nativeView!!, 176.0, 156.0, 80.0, 24.0))
                    assertEquals(Point(19824.0, 1199999844.0), scroll.offset)
                    assertTrue(outside.hasFocus)
                }
            }
            case 45 -> {
                val found = findRowPopup()
                when (found) {
                    case Some(val node) -> {
                        rowPopup = Some(keep(node))
                        assertTrue(node.flag(1))
                        assertTrue(node.flag(2))
                    }
                    case None -> retry = true
                }
            }
            case 46 -> {}
            case 47 -> {
                assertEquals(1, cellOverlayClicks)
                assertFalse(cellOverlayOpen.value)
                retry = rowPopup!!.flag(0)
            }
            case 48 -> {
                val found = findRowPopup()
                when (found) {
                    case Some(val node) -> {
                        assertFalse(rowPopup!!.flag(0))
                        rowPopup = Some(keep(node))
                        assertTrue(node.flag(1))
                    }
                    case None -> retry = true
                }
            }
            case 49 -> {
                retry = rowPopup!!.flag(0)
                if (!retry)
                    when (val found = findRowPopup()) {
                        case Some(val node) -> {
                            node.close()
                            fail(Some("a popup survived its row owner"))
                        }
                        case None -> {}
                    }
            }
            case 50 -> {
                assertFalse(nativeTable!!.flag(0))
                assertFalse(replacement!!.flag(0))
                assertFalse(otherCell!!.flag(0))
                assertFalse(frozenCell!!.flag(0))
                checkHeaders(replacement!!, [])
                checkHeaders(otherCell!!, [])
            }
            else -> fail(Some("unknown AX phase"))
        }
    }
    private fun findRowPopup(): NativeNode? {
        // Query only the window's direct children, never enumerate virtual grid rows.
        for (index in 0L ..< root!!.count) {
            val child = root!!.child(index)
            if (child.text(0, Some("Row popup action")))
                return Some(child)
            child.close()
        }
        return None
    }
    private fun checkHeaders(node: NativeNode, names: Array<String>) {
        for (index in 0L ..< names.size) {
            val header = node.columnHeader(index) ?: fail(Some(f"missing grid header ${index}"))
            header.use { value -> assertTrue(value.text(0, Some(names[index]))) }
        }
        when (node.columnHeader(names.size)) {
            case Some(val extra) -> {
                extra.close();
                fail(Some("unexpected grid header"))
            }
            case None -> {}
        }
    }
    private fun completed(tag: Int, result: Int) {
        assertEquals(phase, tag)
        val expected =
            when (phase) {
                case 3 -> 0
                case 12 -> 0
                case 15 -> 0
                case 18 -> 0
                case 24 -> 0
                case 28 -> 0
                case 32 -> 0
                case 38 -> 0
                case 43 -> 0
                else -> 1
            }
        assertEquals(expected, result, Some(f"native grid action phase ${phase}"))
        waiting = false
        if (retry) {
            frame!!.requestFrame()
            return
        }
        if (phase == 50) {
            finished = true
            active!!.requestExit()
            return
        }
        phase += 1
        when (phase) {
            case 2 -> frame!!.requestLayout()
            case 4 -> frame!!.requestFrame()
            case 6 -> {
                groupHeader!!.update(SemanticProperties(name = Some("Metrics"), hidden = true))
                frame!!.requestFrame()
            }
            case 7 -> {
                groupHeader!!.update(SemanticProperties(name = Some("Metrics")))
                frame!!.requestFrame()
            }
            case 8 -> frame!!.requestFrame()
            case 11 -> {
                assertTrue(outside.requestFocus())
                rows.value = AxRows(this, reverse = true)
            }
            case 13 -> frame!!.requestLayout()
            case 14 -> rows.value = AxRows(this, reverse = true, enabled = false)
            case 16 -> rows.value = AxRows(this, reverse = true, omitColumn = true)
            case 17 -> rows.value = AxRows(this, reverse = true)
            case 19 -> rows.value = AxRows(this, reverse = true, omitRow = true)
            case 20 -> rows.value = AxRows(this, reverse = true)
            case 22 -> frame!!.requestLayout()
            case 23 -> {
                frame!!.requestFrame()
            }
            case 25 -> frame!!.requestFrame()
            case 29 -> {
                assertTrue(outside.requestFocus())
                rows.value = AxRows(this, spanning = true)
            }
            case 31 -> frame!!.requestLayout()
            case 33 -> frame!!.requestFrame()
            case 35 -> rows.value = AxRows(this, reverse = true, spanning = true)
            case 36 -> rows.value = AxRows(this, reverse = true)
            case 37 -> rows.value = AxRows(this, reverse = true, enabled = false, spanning = true)
            case 39 -> rows.value = AxRows(this, reverse = true, omitColumn = true, spanning = true)
            case 40 -> rows.value = AxRows(this, reverse = true, spanning = true)
            case 41 -> rows.value = AxRows(this, reverse = true, omitRow = true, spanning = true)
            case 42 -> {
                assertTrue(outside.requestFocus())
                scroll.scrollTo(Point(0.0, 0.0))
                rows.value = AxRows(this)
            }
            case 44 -> frame!!.requestFrame()
            case 45 -> cellOverlayOpen.value = true
            case 47 -> frame!!.requestFrame()
            case 48 -> cellOverlayOpen.value = true
            case 49 -> scroll.scrollTo(Point(0.0, 0.0))
            case 50 -> {
                ui!!.close();
                send()
            }
            else -> send()
        }
    }
    public override fun close() {
        calls?.close()
        for (node in held)
            node.close()
    }
}
