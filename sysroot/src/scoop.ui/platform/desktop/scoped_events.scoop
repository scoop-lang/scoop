package scoop.ui

import scoop.window.*

private fun <E> ScopedNativeEvents.completed(value: E, action: (E) -> Unit): Closeable {
    val registration =
        own(
            UiEventRegistration<E>(
                { host.checkThread() },
                { event -> dispatch { action(event) } },
                true
            )
        )
    registration.deliver(value)
    return registration
}
internal fun ScopedNativeEvents.menu(menu: Menu, action: (MenuActivation) -> Unit): Closeable {
    checkMounted()
    return own(
        host.nativeEvents.menus.subscribe(menu.id, false) {
            value -> dispatch { action(value) }
        }
    )
}
internal fun ScopedNativeEvents.popup(session: PopupSession, action: (PopupResult) -> Unit): Closeable {
    checkMounted()
    when (session.result) {
        case Some(val value) -> return completed(value, action)
        case None -> {}
    }
    return own(
        host.nativeEvents.popups.subscribe(session.id, true) {
            value -> dispatch { action(value) }
        }
    )
}
internal fun ScopedNativeEvents.modal(session: ModalSession, action: (ModalResult) -> Unit): Closeable {
    checkMounted()
    when (session.result) {
        case Some(val value) -> return completed(value, action)
        case None -> {}
    }
    return own(
        host.nativeEvents.modals.subscribe(session.id, true) {
            value -> dispatch { action(value) }
        }
    )
}
internal fun <T> ScopedNativeEvents.file(session: FileDialogSession<T>, action: (FileDialogResult<T>) -> Unit): Closeable {
    checkMounted()
    when (session.result) {
        case Some(val value) -> return completed(value, action)
        case None -> {}
    }
    return own(
        host.nativeEvents.files.subscribe(session.id, true) {
            _ -> dispatch { action(session.result!!) }
        }
    )
}
internal fun ScopedNativeEvents.frame(window: Window, action: (WindowFrameMetrics?) -> Unit): Closeable {
    checkMounted()
    val registration =
        own(
            host.frameEvents.subscribe(window.id, false) {
                _ -> dispatch { action(window.frameMetrics) }
            }
        )
    registration.deliver(Unit)
    return registration
}
