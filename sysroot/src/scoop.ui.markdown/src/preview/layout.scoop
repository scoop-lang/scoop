package scoop.ui.markdown

import scoop.collections.*
import scoop.graphics.*
import scoop.graphics.text.TextPosition
import scoop.markdown.*
import scoop.math.max
import scoop.ui.*

private class MdPreviewMeasurePass(
    val host: MarkdownPreviewHost,
    val context: MeasureContext,
    val model: MarkdownParsedDocument,
    val presentation: MdRichPresentation?,
    val width: Double
) {
    val measured = HashMap<Long, MdPreviewMeasuredRow>()
    val keys = HashSet<MdDisplayKey>()
    var reused = 0L
    fun row(index: Long): MdPreviewMeasuredRow {
        when (measured[index]) {
            case Some(val value) -> return value;
            case None -> Unit
        }
        val row = mdFrameRow(model, presentation, index)
        val cache = host.caches[row.key] ?: MdPreviewRowCache()
        host.caches[row.key] = cache
        val resource = cache.measure(host, context, model, row, width)
        val value = MdPreviewMeasuredRow(index, row, resource)
        measured[index] = value
        keys.add(row.key)
        host.heights = host.heights.record(index, resource.height)
        host.maximumWidth = max(host.maximumWidth, resource.width)
        if (cache.reused)
            reused += 1L
        return value
    }

    fun adjustment(): ScrollAdjustment? {
        when (alignment()) {
            case Some(val value) -> return Some(value)
            case None -> Unit
        }
        val anchor = host.anchor ?: return None
        if (
            anchor.request !=
                host.scroll.requestRevision ||
                (presentation?.changes?.snapshot?.revision ?: model.snapshot.revision) !=
                host.editor.snapshot.revision
        )
            return None
        val kept = mdFrameRowForKey(model, presentation, anchor.key)
        val index =
            kept ?: mdFrameRowAt(model, presentation, anchor.source.position, anchor.source.bias)
        val measured = row(index)
        val local =
            when (kept) {
                case Some(_) -> {
                    if (anchor.cell < measured.resource.cells.size) {
                        val cell = measured.resource.cells[anchor.cell]
                        val position = cell.text.display.toDisplay(anchor.text)
                        val caret = cell.text.layout.caret(position)
                        cell.origin.y + (caret?.y ?: 0.0)
                    } else
                        0.0
                }
                case None -> {
                    val cellIndex =
                        mdFrameColumn(
                            model,
                            presentation,
                            index,
                            anchor.source.position,
                            anchor.source.bias
                        )
                    if (cellIndex < measured.resource.cells.size) {
                        val cell = measured.resource.cells[cellIndex]
                        val text = measured.row.cells[cellIndex]
                        val position =
                            cell.text.display.toDisplay(
                                TextPosition(
                                    text.textAt(
                                        mdFrameCellPosition(
                                            model,
                                            presentation,
                                            index,
                                            cellIndex,
                                            anchor.source.position,
                                            anchor.source.bias
                                        ).byteOffset,
                                        anchor.source.bias
                                    )
                                )
                            )
                        cell.origin.y + (cell.text.layout.caret(position)?.y ?: 0.0)
                    } else
                        0.0
                }
            }
        return Some(
            ScrollAdjustment(
                anchor.request,
                Point(
                    host.scroll.offset.x,
                    max(
                        0.0,
                        host.options.padding + host.heights.prefix(index) + local + anchor.delta
                    )
                )
            )
        )
    }

    private fun alignment(): ScrollAdjustment? {
        val value = host.alignment ?: return None
        if (
            value.request !=
                host.scroll.requestRevision ||
                (presentation?.changes?.snapshot?.revision ?: model.snapshot.revision) !=
                host.editor.snapshot.revision
        )
            return None
        val anchor = value.anchor
        val index = mdFrameRowAt(model, presentation, anchor.source.position, anchor.source.bias)
        val measured = row(index)
        val cellIndex =
            mdFrameColumn(model, presentation, index, anchor.source.position, anchor.source.bias)
        if (cellIndex >= measured.resource.cells.size)
            return None
        val cell = measured.resource.cells[cellIndex]
        val text = measured.row.cells[cellIndex]
        val position =
            cell.text.display.toDisplay(
                TextPosition(
                    text.textAt(
                        mdFrameCellPosition(
                            model,
                            presentation,
                            index,
                            cellIndex,
                            anchor.source.position,
                            anchor.source.bias
                        ).byteOffset,
                        anchor.source.bias
                    )
                )
            )
        val caret = cell.text.layout.caret(position) ?: return None
        return Some(
            ScrollAdjustment(
                value.request,
                Point(
                    host.scroll.offset.x,
                    max(
                        0.0,
                        host.options.padding +
                            host.heights.prefix(index) +
                            cell.origin.y +
                            caret.y +
                            anchor.fraction *
                            caret.height
                    )
                )
            )
        )
    }

    fun close() {
        for (entry in measured)
            entry.value.resource.release()
    }
}

internal fun mdMeasurePreview(
    host: MarkdownPreviewHost,
    context: MeasureContext,
    constraints: Constraints
): MarkdownPreviewMeasurement {
    val size =
        constraints.constrain(Size(constraints.maxWidth ?: 640.0, constraints.maxHeight ?: 480.0))
    val padding = host.options.padding
    val width = max(0.0, size.width - padding * 2.0)
    val presentation = host.presentation
    val model = mdPresentationModel(presentation, host.controller.latest)
    val estimate = mdPreviewEstimate(host.style, host.options)
    mdSyncPreviewHeights(host, model, presentation)
    val widthChanged = host.layoutWidth != width || host.fontRevision != host.fonts.revision
    if (widthChanged) {
        host.layoutWidth = width
        host.fontRevision = host.fonts.revision
        host.heights =
            mdHeightRun(presentation?.count ?: (model?.display?.rows?.size ?: 0L), estimate)
        host.maximumWidth = 0.0
    }
    val active =
        model ?:
            return MarkdownPreviewMeasurement(
                LayoutMetrics(size),
                None,
                None,
                host.heights,
                [],
                host.viewport.layout(size, size),
                host.scroll.requestRevision,
                padding,
                0L
            )
    val pass = MdPreviewMeasurePass(host, context, active, presentation, width)
    try {
        when (presentation) {
            case Some(val local) -> if (local.rowIndex >= 0L)
                pass.row(local.rowIndex)
            case None -> Unit
        }
        when (host.revealTarget) {
            case Some(val position) -> if (
                (presentation?.changes?.snapshot?.revision ?: active.snapshot.revision) ==
                    host.editor.snapshot.revision
            )
                pass.row(mdFrameRowAt(active, presentation, position))
            case None -> Unit
        }
        var adjustment = pass.adjustment()
        var scroll =
            host.viewport.layout(
                size,
                Size(
                    max(size.width, host.maximumWidth + padding * 2.0),
                    max(size.height, host.heights.total + padding * 2.0)
                ),
                adjustment
            )
        while (true) {
            val before = pass.measured.size
            val offset = scroll.snapshot.offset
            var index = host.heights.indexAt(max(0.0, offset.y - padding - host.options.overscan))
            val bottom = offset.y + size.height + host.options.overscan
            while (
                index <
                    mdFrameRowCount(active, presentation) &&
                    host.heights.prefix(index) +
                    padding <
                    bottom
            ) {
                pass.row(index)
                index += 1L
            }
            adjustment = pass.adjustment()
            scroll =
                host.viewport.layout(
                    size,
                    Size(
                        max(size.width, host.maximumWidth + padding * 2.0),
                        max(size.height, host.heights.total + padding * 2.0)
                    ),
                    adjustment
                )
            if (pass.measured.size == before)
                break
        }
        val rows = ArrayList<MdPreviewMeasuredRow>()
        for (entry in pass.measured)
            rows.add(entry.value)
        val retired = ArrayList<MdDisplayKey>()
        for (entry in host.caches)
            if (!pass.keys.contains(entry.key))
                retired.add(entry.key)
        for (key in retired) {
            host.caches[key]!!.close()
            host.caches.remove(key)
        }
        return MarkdownPreviewMeasurement(
            LayoutMetrics(size),
            model,
            if (
                (presentation?.changes?.snapshot?.revision ?: active.snapshot.revision) ==
                    host.editor.snapshot.revision
            )
                Some(host.editor.selection)
            else
                None,
            host.heights,
            rows.toArray(),
            scroll,
            host.scroll.requestRevision,
            padding,
            pass.reused,
            presentation = presentation,
            inputRevision = host.editor.inputRevision,
            marked = host.editor.markedRange
        )
    } catch (failure: Throwable) {
        pass.close()
        throw failure
    }
}
