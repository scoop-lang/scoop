package scoop.ui.markdown

import scoop.collections.HashMap
import scoop.graphics.*
import scoop.graphics.text.*
import scoop.markdown.*
import scoop.surface.FocusVisibility
import scoop.ui.*
import scoop.window.*

internal class MdPreviewAnchor(
    val source: MarkdownAnchor,
    val key: MdDisplayKey,
    val cell: Long,
    val text: TextPosition,
    val delta: Double,
    val request: ULong
)

/** Native preview of a borrowed shared parser; it owns viewport resources, never the document. */
public class MarkdownPreviewHost public constructor(
    internal val scope: ComponentScope,
    initialController: MarkdownParseController,
    initialStyle: MarkdownPreviewStyle = MarkdownPreviewStyle(),
    initialOptions: MarkdownPreviewOptions = MarkdownPreviewOptions(),
    private var suppliedFonts: FontCollection? = None
): Closeable {
    internal var controller = initialController
    internal val editor: MarkdownEditorState get() = controller.editor
    internal var style = initialStyle
    internal var options = initialOptions
    internal val fonts: FontCollection get() = suppliedFonts ?: scope.defaultFonts
    internal var closed = false
    internal var document: MarkdownParsedDocument? = None
    internal var heights = mdHeightRun(0L, mdPreviewEstimate(initialStyle, initialOptions))
    internal val caches = HashMap<MdDisplayKey, MdPreviewRowCache>()
    internal var layoutWidth = -1.0
    internal var maximumWidth = 0.0
    internal var fontRevision = -1L
    internal var accepted: MarkdownPreviewMeasurement? = None
    internal var anchor: MdPreviewAnchor? = None
    internal var revealTarget: MarkdownPosition? = None
    internal var drag: MarkdownPosition? = None
    internal var pressed: MarkdownPreviewHit? = None
    internal var moved = false
    internal var openLink: (String) -> Unit = { _ -> Unit }
    internal var openSource: (MarkdownRange) -> Unit = { _ -> Unit }
    private var subscription = editor.document.observe { change -> sourceChanged(change) }
    public val scroll = ScrollState()
    internal val viewport = scope.scrollViewport(scroll)
    public val area =
        scope.createArea(focusable = true) {
            context,
            event -> mdPreviewEvent(this, context, event)
        }
    public val focus = scope.focusTarget(area, FocusOptions(visibility = FocusVisibility.Always))
    init {
        options.check()
        area.scope.defaultAction = { context, event -> mdPreviewEvent(this, context, event) }
        area.scope.enabled = options.enabled
    }

    public val isClosed: Boolean get() = closed
    public val measurement: MarkdownPreviewMeasurement? get() {
        checkOpen();
        return accepted
    }

    internal fun checkOpen() {
        if (closed || !scope.isMounted)
            throw IllegalStateException(Some("Markdown preview is no longer mounted"))
        editor.snapshot
    }

    private fun sourceChanged(change: MarkdownChange) {
        when (anchor) {
            case Some(val value) -> anchor =
                Some(
                    MdPreviewAnchor(
                        change.map(value.source),
                        value.key,
                        value.cell,
                        value.text,
                        value.delta,
                        value.request
                    )
                )
            case None -> Unit
        }
        when (revealTarget) {
            case Some(val value) -> revealTarget = Some(change.map(MarkdownAnchor(value)).position)
            case None -> Unit
        }
        if (!closed && scope.isMounted)
            scope.requestLayout()
    }

    public fun update(
        controller: MarkdownParseController,
        style: MarkdownPreviewStyle,
        options: MarkdownPreviewOptions = MarkdownPreviewOptions(),
        focus: FocusOptions = FocusOptions(visibility = FocusVisibility.Always),
        fonts: FontCollection? = None,
        onOpenLink: (String) -> Unit = { _ -> Unit },
        onSource: (MarkdownRange) -> Unit = { _ -> Unit }
    ) {
        checkOpen()
        controller.editor.checkEdit()
        options.check()
        val rebound = controller !== this.controller
        val sameFonts =
            when ((suppliedFonts, fonts)) {
                case(Some(val a), Some(val b)) -> a === b
                case(None, None) -> true
                else -> false
            }
        if (rebound || style !== this.style || options != this.options || !sameFonts) {
            for (entry in caches)
                entry.value.close()
            caches.clear()
            layoutWidth = -1.0
        }
        if (rebound) {
            subscription.close()
            this.controller = controller
            subscription = editor.document.observe { change -> sourceChanged(change) }
            document = None
            anchor = None
            revealTarget = None
        }
        this.style = style
        this.options = options
        this.focus.options = focus
        suppliedFonts = fonts
        openLink = onOpenLink
        openSource = onSource
        area.scope.enabled = options.enabled
    }

    public fun measure(
        context: MeasureContext,
        constraints: Constraints
    ): MarkdownPreviewMeasurement {
        checkOpen()
        return mdMeasurePreview(this, context, constraints)
    }
    public fun scene(context: SceneContext, measurement: MarkdownPreviewMeasurement) {
        checkOpen()
        mdScenePreview(this, context, measurement)
    }
    internal fun currentFrame(): MarkdownPreviewMeasurement? {
        val frame = accepted ?: return None
        val latest = controller.current ?: return None
        return when (frame.document) {
            case Some(val value) -> if (
                value === latest && value.snapshot.revision == editor.snapshot.revision
            )
                Some(frame)
            else
                None
            case None -> None
        }
    }
    public fun hitTest(point: Point): MarkdownPreviewHit? {
        checkOpen();
        return currentFrame()?.hit(point) ?: None
    }
    public fun caret(position: MarkdownPosition, bias: MarkdownBias = MarkdownBias.After): Rect? {
        checkOpen()
        return currentFrame()?.caret(position, bias) ?: None
    }
    public fun reveal(position: MarkdownPosition) {
        checkOpen()
        editor.checkEdit()
        editor.snapshot.read(MarkdownRange(position.byteOffset, position.byteOffset))
        revealTarget = Some(position)
        scope.requestLayout()
    }
    public fun activate(hit: MarkdownPreviewHit) {
        checkOpen()
        editor.checkEdit()
        val frame = currentFrame() ?: return
        val model = frame.document!!
        if (hit.document !== model)
            return
        model.preview.node(hit.node)
        when (hit.action) {
            case Some(MdDisplayAction.Link(val destination)) -> openLink(destination)
            case Some(MdDisplayAction.Source(val range)) -> openSource(
                mdPreviewOriginalRange(model, range)
            )
            case None -> Unit
        }
    }
    public fun execute(command: TextEditCommand): Boolean {
        checkOpen()
        editor.checkEdit()
        if (!options.enabled || !area.isFocusActive || !area.scope.isInputAllowed)
            return false
        return mdPreviewCommand(this, command)
    }

    public override fun close() {
        if (closed)
            return
        editor.storage.checkMutation()
        closed = true
        var failure: Throwable? = None
        failure = mdCleanup(failure) { subscription.close() }
        failure = mdCleanup(failure) { focus.close() }
        failure = mdCleanup(failure) { area.close() }
        failure = mdCleanup(failure) { viewport.close() }
        failure = mdCleanup(failure) { accepted?.close() }
        accepted = None
        for (entry in caches)
            failure = mdCleanup(failure) { entry.value.close() }
        caches.clear()
        mdThrow(failure)
    }
}
