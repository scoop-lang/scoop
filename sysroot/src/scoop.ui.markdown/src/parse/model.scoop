package scoop.ui.markdown

import scoop.markdown.*

/** Resource access and processing are performed serially on the borrowed background executor. */
public class MarkdownExpansionOptions public constructor(
    public val baseUri: String,
    public val resolver: MarkdownResourceResolver,
    processors: List<MarkdownProcessor>
) {
    public val processors: Array<MarkdownProcessor> = processors.toArray()
    init {
        if (baseUri == "")
            throw IllegalArgumentException(Some("Markdown expansion requires a base URI"))
    }
}

public class MarkdownParseOptions public constructor(
    public val profile: MarkdownProfile = MarkdownProfile.Editor,
    public val expansion: MarkdownExpansionOptions? = None,
    imageExtensions: List<String> = ["mermaid", "math"],
    public val codeHighlighter: MarkdownCodeHighlighter? = Some(MarkdownDefaultCodeHighlighter())
) {
    public val imageExtensions: Array<String> = imageExtensions.toArray()
}

/** Original syntax is used for edits; preview syntax may additionally contain generated content. */
public class MarkdownParsedDocument internal constructor(
    public val source: ParsedMarkdown,
    public val processed: ProcessedMarkdown?,
    public val options: MarkdownParseOptions,
    previous: MarkdownParsedDocument? = None
) {
    public val sourceExtensions: MarkdownExtensionIndex =
        mdExtensionIndexFor(source, previous, false)
    public val previewExtensions: MarkdownExtensionIndex =
        if (preview === source)
            sourceExtensions
        else
            mdExtensionIndexFor(preview, previous, true)
    public val sourceNavigation: MarkdownNavigation =
        mdNavigationIndex(source, previous?.sourceNavigation)
    public val sourceFolds: MarkdownFoldIndex =
        mdFoldIndex(source, sourceNavigation, previous?.sourceFolds)
    public val previewNavigation: MarkdownNavigation =
        if (preview === source)
            sourceNavigation
        else
            mdNavigationIndex(preview, previous?.previewNavigation)
    public val sourceHighlights: MarkdownCodeHighlights =
        mdHighlightCode(source, options.codeHighlighter, previous?.sourceHighlights)
    public val sourceSyntax: MarkdownSourceHighlights =
        mdSourceSyntax(source, sourceHighlights, previous?.sourceSyntax)
    public val previewHighlights: MarkdownCodeHighlights =
        if (preview === source)
            sourceHighlights
        else
            mdHighlightCode(preview, options.codeHighlighter, previous?.previewHighlights)
    internal val display: MdDisplayDocument =
        mdProjectMarkdown(
            preview,
            previous?.display,
            options.imageExtensions,
            Some(previewHighlights),
            Some(previewNavigation),
            previewExtensions
        )
    public val preview: ParsedMarkdown get() =
        when (processed) {
            case Some(val result) -> result.expanded
            case None -> source
        }
    public val snapshot: MarkdownSnapshot get() = source.snapshot
    public val diagnostics: Array<MarkdownDiagnostic> get() =
        when (processed) {
            case Some(val result) -> result.diagnostics
            case None -> source.diagnostics
        }
}

private fun mdExtensionIndexFor(
    parsed: ParsedMarkdown,
    previous: MarkdownParsedDocument?,
    preview: Boolean
): MarkdownExtensionIndex {
    when (previous) {
        case Some(val value) -> {
            val old =
                if (preview)
                    value.preview
                else
                    value.source
            if (old === parsed)
                return if (preview)
                    value.previewExtensions
                else
                    value.sourceExtensions
        }
        case None -> Unit
    }
    return parsed.extensionIndex()
}

private fun mdNavigationIndex(
    parsed: ParsedMarkdown,
    previous: MarkdownNavigation?
): MarkdownNavigation {
    when (previous) {
        case Some(val value) -> if (value.parsed === parsed)
            return value
        case None -> Unit
    }
    return parsed.navigation()
}

public enum MarkdownParseState {
    Idle(MarkdownSnapshot),
    Pending(MarkdownSnapshot, MarkdownParsedDocument?),
    Ready(MarkdownParsedDocument),
    Failed(MarkdownSnapshot, Throwable, MarkdownParsedDocument?),
    Closed
}

internal class MdParseRequest(val snapshot: MarkdownSnapshot, val options: MarkdownParseOptions)

internal enum MdParseOutcome {
    Success(MarkdownParsedDocument),
    Failure(Throwable)
}

internal class MdParseCompletion(val request: MdParseRequest, val outcome: MdParseOutcome)

/** Owned by the serialized parse work, never accessed by UI reads or layout. */
internal class MdParseEngine {
    private var options: MarkdownParseOptions? = None
    private var session: MarkdownProcessingSession? = None
    private var previous: MarkdownParsedDocument? = None

    fun parse(request: MdParseRequest): MarkdownParsedDocument {
        val same =
            when (options) {
                case Some(val previous) -> previous === request.options
                case None -> false
            }
        if (!same) {
            options = Some(request.options)
            session =
                when (request.options.expansion) {
                    case Some(val expansion) ->
                    Some(MarkdownProcessingSession(expansion.resolver, expansion.processors))
                    case None -> None
                }
        }
        val result =
            when (request.options.expansion) {
                case Some(val expansion) -> {
                    val result =
                        session!!.process(
                            request.snapshot,
                            expansion.baseUri,
                            request.options.profile
                        )
                    when (previous) {
                        case Some(val value) -> {
                            val sameProcessed =
                                when (value.processed) {
                                    case Some(val old) -> old === result
                                    case None -> false
                                }
                            if (value.options === request.options && sameProcessed)
                                return value
                        }
                        case None -> Unit
                    }
                    MarkdownParsedDocument(
                        result.sourceParsed,
                        Some(result),
                        request.options,
                        previous
                    )
                }
                case None -> {
                    when (previous) {
                        case Some(val value) -> {
                            if (
                                value.options ===
                                    request.options &&
                                    value.snapshot.documentId ===
                                    request.snapshot.documentId &&
                                    value.snapshot.revision ==
                                    request.snapshot.revision
                            )
                                return value
                        }
                        case None -> Unit
                    }
                    MarkdownParsedDocument(
                        parseMarkdown(request.snapshot, request.options.profile),
                        None,
                        request.options,
                        previous
                    )
                }
            }
        previous = Some(result)
        return result
    }

    fun clear() {
        options = None
        session = None
        previous = None
    }
}
