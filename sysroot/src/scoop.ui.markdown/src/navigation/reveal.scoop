package scoop.ui.markdown

import scoop.markdown.*

internal fun mdRevealEditorPosition(view: MarkdownEditorViewState, position: MarkdownPosition) {
    val mount = view.mounted ?: return
    mount.props.folding?.reveal(position)
    val anchor = MdScrollAnchor(MarkdownAnchor(position, MarkdownBias.Before), 0.0)
    if (
        view.mode ==
            MarkdownEditorMode.Source ||
            (
                view.mode ==
                    MarkdownEditorMode.SideBySide &&
                    view.activePane ==
                    MarkdownEditorPane.Source
            )
    )
        mount.source?.alignViewport(anchor)
    else
        mount.rich?.alignViewport(anchor)
}
