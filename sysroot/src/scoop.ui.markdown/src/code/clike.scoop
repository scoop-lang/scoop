package scoop.ui.markdown

// Adapted from Prism clike, c, kotlin, rust and javascript; see licenses/prism.txt.
internal fun mdCodeCLike(language: String): Array<MdCodeRule> {
    val keywords =
        when (language) {
            case "scoop" -> "abstract|as|break|case|catch|class|companion|const|constructor|continue|default|do|else|enum|external|final|finally|for|fun|get|if|import|in|infix|init|interface|internal|is|operator|out|override|package|private|protected|public|reified|return|sealed|set|struct|super|this|throw|trait|try|typealias|val|var|vararg|when|where|while"
            case "kotlin" -> "abstract|actual|annotation|as|break|by|catch|class|companion|const|constructor|continue|crossinline|data|do|dynamic|else|enum|expect|external|final|finally|for|fun|get|if|import|in|infix|init|inline|inner|interface|internal|is|lateinit|noinline|object|open|operator|out|override|package|private|protected|public|reified|return|sealed|set|super|suspend|tailrec|this|throw|to|try|typealias|val|var|vararg|when|where|while"
            case "rust" -> "Self|as|async|await|break|const|continue|crate|dyn|else|enum|extern|fn|for|if|impl|in|let|loop|macro|match|mod|move|mut|pub|ref|return|self|static|struct|super|trait|try|type|union|unsafe|use|where|while|yield|bool|char|f32|f64|i8|i16|i32|i64|i128|isize|u8|u16|u32|u64|u128|usize|str"
            case "javascript" -> "as|async|await|break|case|catch|class|const|continue|debugger|declare|default|delete|do|else|enum|export|extends|finally|for|from|function|get|if|implements|import|in|instanceof|interface|let|namespace|new|of|package|private|protected|public|readonly|return|set|static|super|switch|this|throw|try|type|typeof|var|void|while|with|yield"
            else -> "alignas|alignof|asm|auto|bool|break|case|catch|char|class|const|constexpr|consteval|constinit|continue|default|delete|do|double|else|enum|explicit|export|extern|float|for|friend|goto|if|inline|int|long|mutable|namespace|new|noexcept|nullptr|operator|private|protected|public|register|reinterpret_cast|return|short|signed|sizeof|static|static_assert|static_cast|struct|switch|template|this|thread_local|throw|try|typedef|typename|union|unsigned|using|virtual|void|volatile|wchar_t|while|_Atomic|_Bool|_Complex|_Generic|_Noreturn|_Static_assert|_Thread_local"
        }
    val comment =
        if (language == "rust" || language == "kotlin")
            "(?<nested>/\\*(?:[^*/]++|\\*(?!/)|/(?!\\*)|(?&nested))*(?:\\*/|\\z))|//[^\\r\\n]*"
        else
            "/\\*[\\s\\S]*?(?:\\*/|\\z)|//[^\\r\\n]*"
    val strings =
        when (language) {
            case "scoop" -> "f?\"\"\"[\\s\\S]*?(?:\"\"\"|\\z)|f?\"(?:\\\\[\\s\\S]|[^\"\\\\\\r\\n])*(?:\"|(?=\\r?$))|'(?:\\\\[\\s\\S]|[^'\\\\\\r\\n])*(?:'|(?=\\r?$))"
            case "kotlin" -> "\"\"\"[\\s\\S]*?(?:\"\"\"|\\z)|\"(?:\\\\[\\s\\S]|[^\"\\\\\\r\\n])*(?:\"|(?=\\r?$))|'(?:\\\\[\\s\\S]|[^'\\\\\\r\\n])*(?:'|(?=\\r?$))"
            case "rust" -> "b?r(?<hashes>#{0,255})\"[\\s\\S]*?(?:\"\\k<hashes>|\\z)|b?\"(?:\\\\[\\s\\S]|[^\"\\\\])*(?:\"|\\z)|b?'(?:\\\\(?:u\\{[\\da-fA-F_]+\\}|x[\\da-fA-F]{2}|.)|[^'\\\\\\r\\n])'"
            case "javascript" -> "(?:`(?:\\\\[\\s\\S]|[^`\\\\])*(?:`|\\z))|\"(?:\\\\[\\s\\S]|[^\"\\\\\\r\\n])*(?:\"|(?=\\r?$))|'(?:\\\\[\\s\\S]|[^'\\\\\\r\\n])*(?:'|(?=\\r?$))"
            else -> "\"(?:\\\\[\\s\\S]|[^\"\\\\\\r\\n])*(?:\"|(?=\\r?$))|'(?:\\\\[\\s\\S]|[^'\\\\\\r\\n])*(?:'|(?=\\r?$))"
        }
    return [
        MdCodeRule(MarkdownCodeKind.Comment, comment),
        MdCodeRule(MarkdownCodeKind.String, "(?m)" + strings),
        MdCodeRule(
            MarkdownCodeKind.Annotation,
            if (language == "c")
                "(?m)^[ \\t]*#[ \\t]*[a-zA-Z_]\\w*"
            else
                "@[\\w.:]+"
        ),
        MdCodeRule(MarkdownCodeKind.Keyword, "(?<![.\\w])(?:" + keywords + ")\\b"),
        MdCodeRule(
            MarkdownCodeKind.Constant,
            "\\b(?:true|false|None|null|NULL|True|False|[A-Z_][A-Z_\\d]+)\\b"
        ),
        MdCodeRule(
            MarkdownCodeKind.Number,
            "\\b(?:0[xX][\\da-fA-F_]+|0[bB][01_]+|0[oO][0-7_]+|\\d[\\d_]*(?:\\.(?!\\.)[\\d_]*)?(?:[eE][+-]?[\\d_]+)?)(?:[uU]?[lLfFdD]?|[iu](?:8|16|32|64|128|size)|f(?:32|64))\\b"
        ),
        MdCodeRule(MarkdownCodeKind.Function, "(?:\\b[\\p{L}_][\\w]*|`[^`\\r\\n]+`)(?=\\s*\\()"),
        MdCodeRule(MarkdownCodeKind.Type, "\\b[A-Z][\\w]*\\b"),
        MdCodeRule(MarkdownCodeKind.Operator, "[+\\-*/%=!<>|&^~?:]+")
    ]
}
