package scoop.ui.markdown

import scoop.markdown.*

internal fun mdRefreshRich(host: MarkdownRichHost) {
    if (host.closed)
        return
    if (host.readOnly) {
        host.input?.close()
        host.input = None
        host.local = None
        host.preview.presentation = None
        return
    }
    if (host.ownsOtherComposition())
        return
    val editor = host.editor
    val ready = host.preview.controller.current
    when (ready) {
        case Some(val model) -> {
            val same =
                when (host.local) {
                    case Some(val previous) -> previous.base === model
                    case None -> false
                }
            if (!same)
                host.local = Some(MdRichRegionState(model, editor.selection))
        }
        case None -> Unit
    }
    val previous = host.input
    val usable =
        when (previous) {
            case Some(val active) -> active.content.snapshot ===
                editor.snapshot &&
                mdRichContains(active.content, editor.selection) &&
                mdRichReusableContent(active.content, editor.selection, editor.isComposing)
            case None -> false
        }
    if (usable) {
        previous!!.synchronize()
        val state = host.local ?: return
        mdPresentRichInput(host, state, previous!!)
        return
    }
    when (previous) {
        case Some(val active) -> {
            host.retire()
            active.close()
            host.input = None
        }
        case None -> Unit
    }
    val kept = host.preview.presentation
    host.preview.presentation =
        when (kept) {
            case Some(val value) -> if (value.changes.snapshot === editor.snapshot)
                Some(value)
            else
                None
            case None -> None
        }
    val state = host.local ?: return
    when (ready) {
        case Some(_) -> state.select(editor.selection)
        case None -> Unit
    }
    if (!editor.selection.collapsed) {
        val target =
            when (ready) {
                case Some(val model) -> mdRichTarget(model, editor.selection)
                case None -> None
            }
        when (target) {
            case Some(val value) -> {
                state.rows = None
                host.input = Some(MarkdownRichInput(editor, value.content))
                mdPresentRichTarget(host, state, value)
                return
            }
            case None -> Unit
        }
        val syntax = state.syntax(editor.selection) ?: return
        val input = MarkdownRichInput(editor, syntax.textContent(editor.selection.range))
        host.input = Some(input)
        mdPresentRichInput(host, state, input)
        return
    }
    val target =
        when (ready) {
            case Some(val model) -> when (
                mdRichTarget(model, editor.selection, host.area.isFocusActive)
            ) {
                case Some(val target) -> {
                    state.rows = None
                    Some(target)
                }
                case None -> state.project(editor.selection, host.area.isFocusActive)
            }
            case None -> state.project(editor.selection, host.area.isFocusActive)
        } ?:
            return
    val selection = mdRichClamp(target.content, editor.selection)
    if (selection != editor.selection)
        editor.setSelection(selection)
    host.input = Some(MarkdownRichInput(editor, target.content))
    mdPresentRichTarget(host, state, target)
}

private fun mdPresentRichTarget(
    host: MarkdownRichHost,
    state: MdRichRegionState,
    target: MdRichTarget
) {
    host.preview.presentation =
        Some(
            MdRichPresentation(
                state.base,
                target.content,
                target.row,
                target.cell,
                state.changes,
                state.rows
            )
        )
}

private fun mdPresentRichInput(
    host: MarkdownRichHost,
    state: MdRichRegionState,
    input: MarkdownRichInput
) {
    val content = input.content
    val region = content.region
    val blocks =
        when (region) {
            case Some(val syntax) -> {
                state.prepared(syntax);
                true
            }
            case None -> false
        }
    val inline = content.inlineContent
    val selected = host.editor.selection
    when (host.preview.presentation) {
        case Some(val previous) -> {
            val sameContent =
                when (region) {
                    case Some(val syntax) -> when (previous.regions) {
                        case Some(val rows) -> rows.syntax === syntax
                        case None -> false
                    }
                    case None -> when ((previous.content, inline)) {
                        case(Some(val a), Some(val b)) -> a === b
                        else -> false
                    }
                }
            if (previous.base === state.base && previous.changes === state.changes && sameContent) {
                var relocate = false
                when (previous.content) {
                    case Some(val active) -> if (
                        blocks && !host.editor.isComposing && mdRichContains(active, selected)
                    ) {
                        input.synchronize(active)
                        host.retire()
                        return
                    }
                    case None -> Unit
                }
                when (region) {
                    case Some(val syntax) -> if (!host.editor.isComposing) {
                        val next = syntax.inlineContentAt(selected.cursor, selected.cursorBias)
                        relocate =
                            when (next) {
                                case Some(val value) -> mdRichContains(value, selected)
                                case None -> false
                            }
                    }
                    case None -> Unit
                }
                if (!relocate)
                    return
            }
        }
        case None -> Unit
    }
    val caret =
        MarkdownSelection(
            selected.cursor,
            selected.cursor,
            selected.cursorBias,
            selected.cursorBias
        )
    val target =
        if (blocks)
            state.project(caret, host.area.isFocusActive)
        else
            when (inline) {
                case Some(val value) -> when (state.locate(value)) {
                    case Some(val located) -> Some(located)
                    case None -> state.project(caret, host.area.isFocusActive)
                }
                case None -> None
            }
    when (target) {
        case Some(val value) -> {
            if (blocks && !host.editor.isComposing && mdRichContains(value.content, selected)) {
                input.synchronize(value.content)
                host.retire()
            }
            val active =
                if (blocks)
                    value.content
                else
                    inline ?: value.content
            mdPresentRichTarget(host, state, MdRichTarget(active, value.row, value.cell))
        }
        case None -> when (region) {
            case Some(val syntax) -> host.preview.presentation =
                Some(MdRichPresentation(state.base, state.changes, state.projectRegion(syntax)))
            case None -> Unit
        }
    }
}

private fun mdRichReusableContent(
    content: MarkdownTextContent,
    selection: MarkdownSelection,
    composing: Boolean
): Boolean {
    if (!selection.collapsed || composing)
        return true
    return when (content.region) {
        case Some(val syntax) -> when (
            syntax.inlineContentAt(selection.cursor, selection.cursorBias)
        ) {
            case Some(_) -> true
            case None -> false
        }
        case None -> true
    }
}
