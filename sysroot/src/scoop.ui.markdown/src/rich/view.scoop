package scoop.ui.markdown

import scoop.graphics.text.FontCollection
import scoop.markdown.*
import scoop.ui.*
import scoop.ui.component.*

internal class MdRichProps(
    val controller: MarkdownParseController,
    val style: MarkdownPreviewStyle?,
    val options: MarkdownPreviewOptions,
    val readOnly: Boolean,
    val fonts: FontCollection?,
    val focus: FocusOptions,
    val changed: (MarkdownChange) -> Unit,
    val openLink: (String) -> Unit,
    val source: ((MarkdownRange) -> Unit)?,
    val images: MarkdownImageController?,
    val documentUri: String,
    val mount: MdEditorMount? = None
)

public fun markdownRichEditor(
    controller: MarkdownParseController,
    style: MarkdownPreviewStyle? = None,
    options: MarkdownPreviewOptions = MarkdownPreviewOptions(),
    readOnly: Boolean = false,
    fonts: FontCollection? = None,
    focus: FocusOptions = FocusOptions(),
    onChanged: (MarkdownChange) -> Unit = { _ -> Unit },
    onOpenLink: (String) -> Unit = { _ -> Unit },
    onSource: ((MarkdownRange) -> Unit)? = None,
    images: MarkdownImageController? = None,
    documentUri: String = ""
): View =
    mdRichEditor(
        MdRichProps(
            controller,
            style,
            options,
            readOnly,
            fonts,
            focus,
            onChanged,
            onOpenLink,
            onSource,
            images,
            documentUri
        )
    )

internal fun mdRichEditor(props: MdRichProps): View =
    component(props, { input, scope -> MdRichComponent(input, scope) })

private class MdRichComponent(val props: Props<MdRichProps>, scope: ComponentScope): Component(
    scope
) {
    private val source = MdRichSourceSession()
    public override fun render(): View {
        val session = source
        val input = props.value
        input.controller.status
        input.controller.editor.selection
        input.controller.editor.markedRange
        val current = source.current.value
        val local =
            when (current) {
                case Some(val value) -> if (
                    value.editor === input.controller.editor && value.range != None
                )
                    Some(value)
                else
                    None
                case None -> None
            }
        val content = element(input, { value, mount -> MdRichElement(value, mount, source) })
        return column {
            alignment = CrossAlignment.Stretch
            item(content) {
                grow = 2.0
                basis = FlexBasis.Fixed(0.0)
            }
            when (local) {
                case Some(val value) -> item(mdLocalSourceView(input, value, session)) {
                    grow = 1.0
                    basis = FlexBasis.Fixed(0.0)
                }
                case None -> Unit
            }
        }
    }
    public override fun onUnmount() {
        source.close()
    }
}

private class MdRichElement(
    val props: Props<MdRichProps>,
    scope: ComponentScope,
    val source: MdRichSourceSession
): Element<MarkdownPreviewMeasurement>(scope) {
    private val defaults = MarkdownPreviewStyle()
    private val host =
        scope.resource {
            MarkdownRichHost(
                scope,
                props.value.controller,
                props.value.style ?: defaults,
                props.value.options,
                props.value.readOnly,
                props.value.fonts,
                props.value.images,
                props.value.documentUri,
                props.value.mount?.state?.richScroll
            )
        }
    public override fun onMount() {
        update()
    }
    public override fun update(): UiInvalidation {
        val value = props.value
        source.bind(value.controller.editor, value.controller.current)
        val requestedFocus = value.focus
        source.returnFocus = requestedFocus.handle ?: source.richFocus
        host.update(
            value.controller,
            value.style ?: defaults,
            value.options,
            value.readOnly,
            FocusOptions(
                Some(source.returnFocus),
                requestedFocus.tabStop,
                requestedFocus.order,
                requestedFocus.visibility
            ),
            value.fonts,
            value.changed,
            value.openLink,
            {
                range -> when (value.source) {
                    case Some(val handler) -> handler(range)
                    case None -> source.open(
                        value.controller.editor,
                        range,
                        value.controller.current
                    )
                }
            },
            value.images,
            value.documentUri
        )
        value.mount?.attach(host.preview)
        if (!value.controller.isClosed)
            value.controller.start()
        return UiInvalidation.Layout
    }
    public override fun onUnmount() {
        props.value.mount?.detach(host.preview)
    }
    public override fun measure(context: MeasureContext, constraints: Constraints): LayoutResult<
        MarkdownPreviewMeasurement
    > {
        val result = host.measure(context, constraints)
        return LayoutResult(result.metrics, result, { result.close() })
    }
    public override fun scene(context: SceneContext, layout: MarkdownPreviewMeasurement) {
        host.scene(context, layout)
    }
}
