package scoop.ui.markdown

import scoop.markdown.*
import scoop.window.*

internal struct MdRichStyles(
    val emphasis: MarkdownStyleState = MarkdownStyleState.Unavailable,
    val strong: MarkdownStyleState = MarkdownStyleState.Unavailable,
    val strike: MarkdownStyleState = MarkdownStyleState.Unavailable
) {
    fun value(style: MarkdownInlineStyle): MarkdownStyleState =
        when (style) {
            case Emphasis -> emphasis
            case Strong -> strong
            case Strikethrough -> strike
        }
}

internal fun mdRichStyleValues(host: MarkdownRichHost): MdRichStyles {
    if (host.readOnly || !host.preview.options.enabled || host.ownsOtherComposition())
        return MdRichStyles()
    val input = host.input ?: return MdRichStyles()
    if (input.content.snapshot !== host.editor.snapshot)
        return MdRichStyles()
    return MdRichStyles(
        input.styleState(MarkdownInlineStyle.Emphasis),
        input.styleState(MarkdownInlineStyle.Strong),
        if (input.content.profile.strikethrough)
            input.styleState(MarkdownInlineStyle.Strikethrough)
        else
            MarkdownStyleState.Unavailable
    )
}

private val mdStrongKey =
    ShortcutChord(ShortcutKey.Logical(LogicalKey.Character("b")), ShortcutModifiers(primary = true))

private val mdEmphasisKey =
    ShortcutChord(ShortcutKey.Logical(LogicalKey.Character("i")), ShortcutModifiers(primary = true))

private val mdStrikeKey =
    ShortcutChord(
        ShortcutKey.Logical(LogicalKey.Character("x")),
        ShortcutModifiers(primary = true, shift = true)
    )

internal fun mdRichFormatKey(host: MarkdownRichHost, key: KeyEvent): Boolean {
    val style =
        if (mdStrongKey.matches(key))
            MarkdownInlineStyle.Strong
        else
            if (mdEmphasisKey.matches(key))
                MarkdownInlineStyle.Emphasis
            else
                if (mdStrikeKey.matches(key))
                    MarkdownInlineStyle.Strikethrough
                else
                    return false
    if (key.isRepeat)
        return true
    return host.toggleStyle(style)
}
