package scoop.ui.component

import scoop.graphics.*
import scoop.graphics.text.*
import scoop.test.*
import scoop.ui.*
import scoop.ui.style.*
import scoop.ui.style.shadcn.shadcnTheme
import scoop.ui.text.TextEditorState

@Test
private class ButtonGroupTest {
    @Test
    fun `connected edges share layout border and focus geometry in both directions`() {
        val theme = shadcnTheme()
        val visual = SurfaceVisual(SurfaceKind.Action, InteractionVisual(focusVisible = true))
        val local =
            styleOverride {
                this.border(
                    Some(
                        Border.Logical(
                            BorderEdge(2.0, Color.Black),
                            BorderEdge(3.0, Color.White),
                            BorderEdge(4.0, Color.Black),
                            BorderEdge(5.0, Color.White)
                        )
                    )
                )
                this.corners(
                    Corners.Logical(Size(2.0, 3.0), Size(4.0, 5.0), Size(6.0, 7.0), Size(8.0, 9.0))
                )
            }
        val options =
            surfaceOptions {
                this.style = local;
                this.padding = Some(Insets.all(7.0))
            }
        for (direction in [LayoutDirection.Ltr, LayoutDirection.Rtl]) {
            val original =
                theme.surfaceGeometry(Rect(0.0, 0.0, 100.0, 50.0), visual, options, direction)
            val base = theme.surfaceMetrics(visual, options, direction)
            assertSame(original, groupSurfaceGeometry(original, base, None, direction))
            val positions =
                [
                    GroupPosition(FlexAxis.Horizontal, true, false),
                    GroupPosition(FlexAxis.Horizontal, false, false),
                    GroupPosition(FlexAxis.Horizontal, false, true)
                ]
            for (position in positions) {
                val metrics =
                    groupSurfaceMetrics(
                        base,
                        Some(position),
                        groupEndRadius(theme, local),
                        direction
                    )
                val result = groupSurfaceGeometry(original, metrics, Some(position), direction)
                val edges = result.style.border!!.resolve(direction)
                assertEquals(3.0, edges.top.width)
                assertEquals(5.0, edges.bottom.width)
                assertEquals(
                    if (position.first)
                        2.0
                    else
                        0.0,
                    if (direction == LayoutDirection.Ltr)
                        edges.left.width
                    else
                        edges.right.width
                )
                assertEquals(
                    4.0,
                    if (direction == LayoutDirection.Ltr)
                        edges.right.width
                    else
                        edges.left.width
                )
                assertEquals(
                    if (position.first)
                        80.0
                    else
                        82.0,
                    result.content.width
                )
                assertEquals(28.0, result.content.height)
                assertEquals(
                    if (position.first)
                        94.0
                    else
                        96.0,
                    result.borderInner.bounds.width
                )
                assertEquals(result.outline.expanded(3.0), result.ring!!.outline)
                assertEquals(original.ring!!.border, result.ring!!.border)
                val corners = result.outline.radii
                assertEquals(
                    if (position.first)
                        Size(2.0, 3.0)
                    else
                        Size(0.0, 0.0),
                    if (direction == LayoutDirection.Ltr)
                        corners.topLeft
                    else
                        corners.topRight
                )
                assertEquals(
                    if (position.last)
                        Size(6.0, 7.0)
                    else
                        Size(0.0, 0.0),
                    if (direction == LayoutDirection.Ltr)
                        corners.bottomRight
                    else
                        corners.bottomLeft
                )
            }
            val vertical = Some(GroupPosition(FlexAxis.Vertical, false, true))
            val metrics = groupSurfaceMetrics(base, vertical, Some(12.0), direction)
            val result = groupSurfaceGeometry(original, metrics, vertical, direction)
            assertEquals(0.0, result.style.border!!.resolve(direction).top.width)
            assertEquals(7.0, result.content.y)
            assertEquals(
                CornerRadii(Size(0.0, 0.0), Size(0.0, 0.0), Size(12.0, 12.0), Size(12.0, 12.0)),
                result.outline.radii
            )
            val empty = theme.surfaceGeometry(Rect(0.0, 0.0, 0.0, 0.0), visual, options, direction)
            val zero = groupSurfaceGeometry(empty, metrics, vertical, direction)
            assertEquals(Size(0.0, 0.0), zero.content.size)
            assertEquals(Size(0.0, 0.0), zero.borderInner.bounds.size)
        }
    }

    @Test
    fun `default end corners use large while explicit control corners remain authoritative`() {
        val theme = shadcnTheme()
        val visual = InteractionVisual()
        val options =
            actionOptions(
                theme,
                ActionShape.Button(ButtonSize.Sm),
                ButtonVariant.Outline,
                buttonStyle(),
                visual
            )
        val base = theme.surfaceMetrics(SurfaceVisual(SurfaceKind.Action), options)
        val position = Some(GroupPosition(FlexAxis.Horizontal, true, true))
        val metrics =
            groupSurfaceMetrics(
                base,
                position,
                groupEndRadius(theme, styleOverride()),
                LayoutDirection.Ltr
            )
        assertEquals(
            Size(theme.tokens.corners.medium, theme.tokens.corners.medium),
            metrics.corners.topLeft
        )
        assertEquals(
            Size(theme.tokens.corners.large, theme.tokens.corners.large),
            metrics.corners.topRight
        )
        assertEquals(None, groupEndRadius(theme, styleOverride { this.corners(Corners.all(0.0)) }))
    }

    @Test
    fun `typed entries retain caller inputs defaults and explicit flex configuration`() {
        val builder = ButtonGroupBuilder()
        val editor = TextEditorState("Scoop")
        val source = ThemeSource(shadcnTheme())
        val alternate = ThemeSource(shadcnTheme(ThemeMode.Dark))
        val handle = FocusHandle()
        val target = FieldTarget()
        val action = state(0)
        builder.button("First", { action.value += 1 }) {
            this.variant = ButtonVariant.Outline
            this.key = ViewKey.Text("first")
            this.focus { this.handle = Some(handle) }
        }
        builder.button(styledText { this.text("Styled") }, {}) {}
        builder.button(empty(), {}) {}
        builder.button({ _ -> empty() }, {}) {}
        builder.input(editor) {
            this.theme = Some(alternate)
            this.readOnly = true
            this.labelTarget = Some(target)
        }
        builder.text("https://") {}
        builder.text(styledText { this.text(".com") }) {}
        builder.text(empty()) {}
        builder.separator()
        builder.item({ position -> button("Custom", {}) { this.group = Some(position) } }) {
            this.grow = 2.0
        }
        builder.add(empty()) { this.shrink = 0.0 }
        val snapshot = builder.snapshot()
        assertEquals(11L, snapshot.entries.size)
        assertEquals(ViewKey.Text("first"), snapshot.entries[0L].key)
        assertEquals(1.0, snapshot.entries[4L].layout.grow)
        assertEquals(2.0, snapshot.entries[9L].layout.grow)
        assertEquals(0.0, snapshot.entries[10L].layout.shrink)
        assertFalse(buttonGroupHasNested(snapshot.entries))
        val position = Some(GroupPosition(FlexAxis.Horizontal, false, true))
        when (snapshot.entries[0L].content) {
            case Button(val input) -> {
                val grouped = groupButtonProps(input, position, None, Some(source))
                grouped.onClick()
                assertEquals(1, action.value)
                assertSame(source, grouped.theme!!)
                assertSame(handle, grouped.focus.handle!!)
                assertEquals(ButtonVariant.Outline, grouped.variant)
                assertEquals(position, grouped.group)
            }
            else -> fail(Some("missing typed button"))
        }
        when (snapshot.entries[4L].content) {
            case Input(val input) -> {
                val grouped = groupInputProps(input, position, None, Some(source))
                assertSame(editor, grouped.state)
                assertSame(alternate, grouped.theme!!)
                assertSame(target, grouped.labelTarget!!)
                assertTrue(grouped.readOnly)
                assertEquals(position, grouped.group)
            }
            else -> fail(Some("missing typed input"))
        }
        builder.group { this.button("Nested", {}) {} }
        assertEquals(11L, snapshot.entries.size)
        assertTrue(buttonGroupHasNested(builder.snapshot().entries))
    }
}
