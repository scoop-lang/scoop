package scoop.ui.component

import scoop.graphics.*
import scoop.test.*
import scoop.ui.*
import scoop.ui.style.*

@Test
private class PanelColorPreferencesTest {
    @Test
    fun `menu text shortcuts and warning colors meet contrast on their actual row background`() {
        val shape = ActionShape.Button(ButtonSize.Default)
        val bounds = Rect(0.0, 0.0, 180.0, 28.0)
        for (mode in [ThemeMode.Light, ThemeMode.Dark])
            for (base in colorPreferenceThemes(mode)) {
                val theme = base.withPreferences(ThemePreferences(highContrast = true))
                val disabled = menuRowColors(theme, false, true, false)
                assertEquals(Color.Transparent, disabled.background)
                assertColorContrast(
                    disabled.foreground,
                    theme.tokens.palette.popover.background,
                    4.5
                )
                assertTrue(disabled.foreground != menuRowColors(theme, false, false).foreground)
                val ordinaryDisabled = menuRowColors(base, false, false, false)
                assertEquals(
                    if (base.tokens.disabledOpacity < 1.0)
                        base.tokens.palette.popover.foreground
                    else
                        base.tokens.palette.disabledText,
                    ordinaryDisabled.foreground
                )
                for (destructive in [false, true])
                    for (active in [false, true]) {
                        val visual = InteractionVisual(hovered = active)
                        val local = menuRowStyle(
                            buttonStyle { kind = SurfaceKind.Plain },
                            theme,
                            destructive,
                            active
                        )
                        val geometry = theme
                            .surfaceGeometry(
                                bounds,
                                SurfaceVisual(local.kind, visual),
                                actionOptions(theme, shape, ButtonVariant.Ghost, local, visual)
                            )
                        val colors = menuRowColors(theme, destructive, active)
                        assertEquals(colors.background, geometry.style.background!!.color)
                        if (!active) assertEquals(0.0, colors.background.alpha)
                        val background = if (colors.background.alpha == 0.0)
                            theme.tokens.palette.popover.background
                        else
                            colors.background
                        assertColorContrast(colors.foreground, background, 7.0)
                        assertColorContrast(
                            componentForeground(
                                theme,
                                theme.tokens.palette.muted.foreground,
                                background
                            ),
                            background,
                            7.0
                        )
                        if (destructive)
                            assertTrue(colors.foreground.red >= colors.foreground.green)
                    }
            }
    }

    @Test
    fun `panel captions dividers and borders use the card or popup instead of the root backdrop`() {
        for (mode in [ThemeMode.Light, ThemeMode.Dark])
            for (base in colorPreferenceThemes(mode)) {
                val theme = base.withPreferences(ThemePreferences(highContrast = true))
                val palette = theme.tokens.palette
                for (surface in [palette.background, palette.card, palette.popover]) {
                    assertColorContrast(
                        componentPanelBorder(theme, surface),
                        surface.background,
                        3.0
                    )
                    assertColorContrast(
                        componentForeground(theme, palette.border, surface.background, 3.0),
                        surface.background,
                        3.0
                    )
                    for (
                        requested in [
                            palette.muted.foreground,
                            palette.destructive.background,
                            palette
                                .destructive
                                .background
                                .withAlpha(
                                    palette.destructive.background.alpha * 0.9
                                )
                        ]
                    )
                        assertColorContrast(
                            componentForeground(theme, requested, surface.background),
                            surface.background,
                            7.0
                        )
                    assertEquals(surface.background, componentPanelSection(theme, surface))
                }
                val reduced = base.withPreferences(ThemePreferences(reduceTransparency = true))
                for (surface in [reduced.tokens.palette.card, reduced.tokens.palette.popover]) {
                    assertEquals(1.0, componentPanelBorder(reduced, surface).alpha)
                    assertEquals(1.0, componentPanelSection(reduced, surface).alpha)
                    assertEquals(
                        1.0,
                        componentForeground(
                            reduced,
                            reduced.tokens.palette.destructive.background.withAlpha(0.9),
                            surface.background
                        )
                            .alpha
                    )
                }
                assertEquals(
                    base.tokens.palette.background.foreground.withAlpha(0.1),
                    componentPanelBorder(base, base.tokens.palette.popover)
                )
                assertEquals(
                    base.tokens.palette.muted.foreground,
                    componentForeground(
                        base,
                        base.tokens.palette.muted.foreground,
                        base.tokens.palette.card.background
                    )
                )
            }
    }

    @Test
    fun `select trigger state fills and command field decoration follow resolved preferences`() {
        val shape = ActionShape.Button(ButtonSize.Default)
        val bounds = Rect(0.0, 0.0, 144.0, 32.0)
        for (mode in [ThemeMode.Light, ThemeMode.Dark])
            for (base in colorPreferenceThemes(mode))
                for (contrast in [false, true]) {
                    val theme = base
                        .withPreferences(
                            ThemePreferences(
                                highContrast = contrast,
                                reduceTransparency = !contrast
                            )
                        )
                    val local = selectTriggerStyle(buttonStyle(), theme, SelectSize.Default, false)
                    for (
                        visual in [
                            InteractionVisual(),
                            InteractionVisual(hovered = true),
                            InteractionVisual(pressed = true),
                            InteractionVisual(hovered = true, focusVisible = true),
                            InteractionVisual(enabled = false)
                        ]
                    ) {
                        val surface = SurfaceVisual(SurfaceKind.OutlinedAction, visual)
                        val geometry = theme
                            .surfaceGeometry(
                                bounds,
                                surface,
                                actionOptions(theme, shape, ButtonVariant.Outline, local, visual)
                            )
                        val fill = geometry.style.background!!.color
                        assertTrue(fill.alpha == 0.0 || fill.alpha == 1.0)
                        if (contrast)
                            assertColorContrast(
                                selectTriggerContent(
                                    theme,
                                    local,
                                    actionContentStyle(
                                        theme
                                            .tokens
                                            .typography
                                            .action
                                            .copy {
                                                color = actionTextColor(
                                                    theme, shape, ButtonVariant.Outline, surface
                                                )
                                            },
                                        shape, ButtonVariant.Outline, visual
                                    )
                                )
                                    .text
                                    .color,
                                fill,
                                if (visual.enabled) 7.0 else 4.5
                            )
                    }
                    val command = commandInputDecoration(theme).resolve(style())
                    assertEquals(1.0, command.background!!.color.alpha)
                    assertEquals(
                        1.0,
                        command.border!!.resolve(LayoutDirection.Ltr).left.color.alpha
                    )
                    if (contrast) {
                        assertEquals(
                            theme.tokens.palette.background.background,
                            command.background!!.color
                        )
                        assertColorContrast(
                            command.border!!.resolve(LayoutDirection.Ltr).left.color,
                            command.background!!.color,
                            3.0
                        )
                    }
                }
    }

    @Test
    fun `surface preferences preserve explicit menu trigger and input decoration overrides`() {
        val explicit = Color(0.3, 0.1, 0.7, 0.25)
        val custom = buttonStyle {
            surface {
                style {
                    background(Some(Paint(explicit)));
                    border(Some(Border.all(2.0, explicit)))
                }
            }
            text { color = Some(explicit) }
            states { pressed { background(Some(Paint(explicit))) } }
        }
        val shape = ActionShape.Button(ButtonSize.Default)
        val visual = InteractionVisual(pressed = true)
        for (mode in [ThemeMode.Light, ThemeMode.Dark])
            for (base in colorPreferenceThemes(mode))
                for (
                    preferences in [
                        ThemePreferences(highContrast = true),
                        ThemePreferences(reduceTransparency = true)
                    ]
                ) {
                    val theme = base.withPreferences(preferences)
                    for (
                        local in [
                            menuRowStyle(custom, theme, true, true),
                            selectTriggerStyle(custom, theme, SelectSize.Default, false)
                        ]
                    ) {
                        val geometry = theme
                            .surfaceGeometry(
                                Rect(0.0, 0.0, 144.0, 32.0),
                                SurfaceVisual(SurfaceKind.OutlinedAction, visual),
                                actionOptions(theme, shape, ButtonVariant.Outline, local, visual)
                            )
                        assertEquals(explicit, geometry.style.background!!.color)
                        assertEquals(Some(Border.all(2.0, explicit)), geometry.style.border)
                        assertEquals(
                            explicit,
                            local.text!!.resolve(theme.tokens.typography.body).color
                        )
                    }
                    val command = commandInputDecoration(theme)
                        .then(custom.surface.style)
                        .resolve(style())
                    assertEquals(explicit, command.background!!.color)
                    assertEquals(Some(Border.all(2.0, explicit)), command.border)
                    if (preferences.reduceTransparency) {
                        for (active in [false, true]) {
                            val colors = menuRowColors(theme, true, active)
                            assertEquals(
                                if (active) 1.0 else 0.0,
                                colors.background.alpha
                            )
                            assertEquals(1.0, colors.foreground.alpha)
                        }
                    }
                }
    }
}
