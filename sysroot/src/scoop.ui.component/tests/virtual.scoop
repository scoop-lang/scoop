package scoop.ui.component

import scoop.graphics.*
import scoop.test.*
import scoop.ui.*
import scoop.ui.style.Orientation

@Test
private class VirtualLayoutTest {
    @Test
    fun `fixed extents select half open visible ranges and clamp symmetric overscan`() {
        val size = Size(180.0, 60.0)
        val exact =
            ListGeometry(
                ItemExtentIndex(100000000L, ItemExtent.Fixed(20.0)),
                Orientation.Vertical,
                0.0,
                size
            )
        assertEquals(Size(180.0, 2000000000.0), exact.content)
        assertEquals(Constraints.tight(Size(180.0, 20.0)), exact.itemConstraints)
        assertEquals(ItemRange(0L, 3L), exact.range(0.0))
        assertEquals(ItemRange(1L, 4L), exact.range(20.0))
        assertEquals(ItemRange(1L, 5L), exact.range(21.0))
        assertEquals(ItemRange(99999997L, 100000000L), exact.range(1999999940.0))
        assertEquals(Point(0.0, 24680.0), exact.origin(1234L))
        val extra =
            ListGeometry(
                ItemExtentIndex(10L, ItemExtent.Fixed(20.0)),
                Orientation.Vertical,
                25.0,
                size
            )
        assertEquals(ItemRange(0L, 5L), extra.range(0.0))
        assertEquals(ItemRange(2L, 9L), extra.range(80.0))
        assertEquals(ItemRange(5L, 10L), extra.range(140.0))
        val large =
            ListGeometry(
                ItemExtentIndex(10L, ItemExtent.Fixed(20.0)),
                Orientation.Vertical,
                1.0e308,
                size
            )
        assertEquals(ItemRange(0L, 10L), large.range(80.0))
    }

    @Test
    fun `horizontal empty and zero viewports preserve finite geometry without creating rows`() {
        val horizontal =
            ListGeometry(
                ItemExtentIndex(8L, ItemExtent.Fixed(25.0)),
                Orientation.Horizontal,
                0.0,
                Size(80.0, 40.0)
            )
        assertEquals(Size(200.0, 40.0), horizontal.content)
        assertEquals(Constraints.tight(Size(25.0, 40.0)), horizontal.itemConstraints)
        assertEquals(Point(75.0, 0.0), horizontal.origin(3L))
        assertEquals(ItemRange(2L, 6L), horizontal.range(50.0))
        val empty =
            ListGeometry(
                ItemExtentIndex(0L, ItemExtent.Fixed(20.0)),
                Orientation.Vertical,
                30.0,
                Size(80.0, 40.0)
            )
        assertEquals(Size(80.0, 0.0), empty.content)
        assertEquals(ItemRange(0L, 0L), empty.range(0.0))
        val zero =
            ListGeometry(
                ItemExtentIndex(500L, ItemExtent.Fixed(20.0)),
                Orientation.Vertical,
                300.0,
                Size(80.0, 0.0)
            )
        assertEquals(ItemRange(0L, 0L), zero.range(100.0))
    }

    @Test
    fun `virtual viewports require bounded axes and reject invalid or overflowing lengths`() {
        assertEquals(
            Size(100.0, 80.0),
            virtualViewport(Constraints(maxWidth = Some(100.0), maxHeight = Some(80.0)), None, None)
        )
        assertEquals(
            Size(50.0, 80.0),
            virtualViewport(
                Constraints(50.0, Some(100.0), 20.0, Some(80.0)),
                Some(10.0),
                Some(300.0)
            )
        )
        assertEquals(Size(60.0, 0.0), virtualViewport(Constraints(), Some(60.0), Some(0.0)))
        assertFailsWith<IllegalArgumentException> {
            virtualViewport(Constraints(maxHeight = Some(80.0)), None, None)
        }
        assertFailsWith<IllegalArgumentException> {
            virtualViewport(Constraints(maxWidth = Some(80.0)), None, None)
        }
        for (extent in [0.0, -1.0, 1.0e308 * 2.0])
            assertFailsWith<IllegalArgumentException> {
                ListGeometry(
                    ItemExtentIndex(1L, ItemExtent.Fixed(extent)),
                    Orientation.Vertical,
                    0.0,
                    Size(40.0, 50.0)
                )
            }
        assertFailsWith<IllegalArgumentException> {
            ListGeometry(
                ItemExtentIndex(10L, ItemExtent.Fixed(1.0e308)),
                Orientation.Vertical,
                0.0,
                Size(40.0, 50.0)
            )
        }
        assertFailsWith<IllegalArgumentException> {
            ListGeometry(
                ItemExtentIndex(10L, ItemExtent.Fixed(20.0)),
                Orientation.Vertical,
                -1.0,
                Size(40.0, 50.0)
            )
        }
    }
}
