package scoop.ui.component

import scoop.test.*
import scoop.time.Duration
import scoop.ui.*
import scoop.ui.text.*
import scoop.window.TextInputPurpose

@Test
private class ContactInputOptionsTest {
    @Test
    fun `text field builders preserve independent keyboard purpose and display policy snapshots`() {
        val model = TextEditorState()
        val input = InputBuilder()
        input.inputPurpose = TextInputPurpose.Email
        input.softwareKeyboard = false
        input.primarySelection = TextPrimarySelectionOptions(false, Some(false))
        input.automaticTextReplacement = true
        val first = input.inputProps(model)
        input.inputPurpose = TextInputPurpose.Search
        input.softwareKeyboard = true
        assertEquals(TextInputPurpose.Email, first.inputPurpose)
        assertFalse(first.softwareKeyboard)
        assertFalse(first.primarySelection.publish)
        assertEquals(Some(false), first.primarySelection.paste)
        assertTrue(first.automaticTextReplacement)
        assertFalse(first.protectedText)
        val multiline = TextareaBuilder()
        multiline.inputPurpose = TextInputPurpose.Url
        multiline.softwareKeyboard = false
        multiline.primarySelection = TextPrimarySelectionOptions(paste = Some(true))
        multiline.automaticTextReplacement = true
        val second = multiline.textareaProps(model)
        assertEquals(TextInputPurpose.Url, second.inputPurpose)
        assertFalse(second.softwareKeyboard)
        assertEquals(Some(true), second.primarySelection.paste)
        assertTrue(second.automaticTextReplacement)
        val otp = InputOtpBuilder()
        assertEquals(
            TextInputPurpose.Digits,
            otpOptions(otp.snapshot(model, 4L), textProjection()).inputPurpose
        )
        otp.pattern = InputOtpPattern.Alphanumeric
        assertEquals(
            TextInputPurpose.Normal,
            otpOptions(otp.snapshot(model, 4L), textProjection()).inputPurpose
        )
        otp.inputPurpose = Some(TextInputPurpose.Decimal)
        otp.softwareKeyboard = false
        otp.primarySelection = TextPrimarySelectionOptions(publish = false)
        otp.automaticTextReplacement = true
        val pin = otpOptions(otp.snapshot(model, 4L), textProjection())
        assertEquals(TextInputPurpose.Decimal, pin.inputPurpose)
        assertFalse(pin.softwareKeyboard)
        assertFalse(pin.primarySelection.publish)
        assertTrue(pin.automaticTextReplacement)
    }
    @Test
    fun `hover popup touch configuration is independent from mouse delays and focus`() {
        val tooltip = TooltipBuilder()
        tooltip.longPress = LongPressOptions(delay = Duration.milliseconds(720L), threshold = 11.0)
        val first = tooltip.snapshot(empty(), PanelContent.Custom(empty()))
        tooltip.longPress = LongPressOptions(enabled = false)
        assertTrue(first.longPress.enabled)
        assertEquals(Duration.milliseconds(720L), first.input.hover.longPress.delay)
        assertEquals(11.0, first.input.hover.longPress.threshold)
        assertEquals(Duration.ZERO, first.openDelay)
        assertTrue(first.focus)
        assertFalse(
            tooltip.snapshot(empty(), PanelContent.Custom(empty())).input.hover.longPress.enabled
        )
        assertTrue(HoverCardBuilder().snapshot(empty(), empty()).input.hover.longPress.enabled)
        assertFalse(HoverOptions().longPress.enabled)
    }
}
