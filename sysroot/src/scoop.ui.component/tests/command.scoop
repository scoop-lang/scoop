package scoop.ui.component

import scoop.graphics.text.styledText
import scoop.test.*
import scoop.ui.*
import scoop.ui.text.TextEditorState
import scoop.window.*

@Test
private class CommandModelTest {
    @Test
    fun `fuzzy scoring keeps cmdk weights and handles scalar case val expansions`() {
        val vectors =
            [
                ("HTML", "HTML", 1.0),
                ("HTML", "HM", 0.1681317),
                ("haml", "HM", 0.16809807534131702),
                ("Open File", "of", 0.8908218089100001),
                ("OpenFile", "of", 0.16776204728870972),
                ("open file", "file", 0.9),
                ("file open", "file", 0.99),
                ("curtain", "uc", 0.099),
                ("ouch", "uc", 0.1683),
                ("Open file", "flie", 0.09000000000000001),
                ("book", "bok", 0.16983),
                ("foo-bar", "foo bar", 0.9999),
                ("settings", "stg", 0.028496727551584614),
                ("alpha", "zzz", 0.0)
            ]
        for (vector in vectors)
            assertEquals(vector._3, commandScore(vector._1, vector._2))
        assertTrue(commandScore("Straße", "STRASSE") > 0.99)
        assertEquals(1.0, commandScore("😀设置", "😀设置"))
        assertTrue(commandScore("设置编辑器", "设编") > 0.0)
        assertTrue(commandScore("İstanbul", "istan") > 0.0)
        assertTrue(commandScore("Preferences", "设置", ["设置"]) > 0.0)
        assertEquals(0.0, commandScore("", "text"))
    }

    @Test
    fun `search reads committed text across preedit cancel commit and external replacement`() {
        val query = TextEditorState("set")
        query.applyInput(
            TextInputBatch(
                None,
                [TextInputOperation.Preedit("ting", None, TextReplacement.CurrentSelection)]
            )
        )
        assertEquals("setting", query.text)
        assertEquals("set", query.committedText)
        assertTrue(query.isComposing)
        query.cancelComposition()
        assertEquals("set", query.committedText)
        query.applyInput(
            TextInputBatch(
                None,
                [TextInputOperation.Preedit("tings", None, TextReplacement.CurrentSelection)]
            )
        )
        query.applyInput(
            TextInputBatch(
                None,
                [TextInputOperation.Commit("tings", TextReplacement.CurrentSelection)]
            )
        )
        assertEquals("settings", query.committedText)
        assertFalse(query.isComposing)
        query.replaceAll("设置")
        assertEquals("设置", query.committedText)
    }

    @Test
    fun `ranked results sort stable groups drop empty decorations and preserve disabled commands`() {
        val source =
            commandItems {
                group(ViewKey.Text("a"), "First group") {
                    item(ViewKey.Number(1L), "Settings")
                    item(ViewKey.Number(2L), "Settings") { enabled = false }
                }
                separator(ViewKey.Text("separator"))
                group(ViewKey.Text("b"), "Second group") {
                    item(ViewKey.Number(3L), "Open Settings")
                }
                group(ViewKey.Text("empty"), "Empty group") { item(ViewKey.Number(4L), "Calendar") }
            }
        assertTrue(commandResults(source, "", CommandFilter.Ranked) === source)
        val result = commandResults(source, "settings", CommandFilter.Ranked)
        assertEquals(3L, result.itemCount)
        assertEquals(ViewKey.Text("a"), result.keyAt(0L))
        assertEquals(ViewKey.Number(1L), result.keyAt(1L))
        assertEquals(ViewKey.Number(2L), result.keyAt(2L))
        assertFalse(result.enabledAt(2L))
        assertEquals(None, result.indexOfKey(ViewKey.Text("empty")))
        assertEquals(0L, commandResults(source, "xyz", CommandFilter.Ranked).count)
        val reordered =
            commandResults(
                source,
                "anything",
                CommandFilter.Custom {
                    item,
                    _ -> if (item.key == ViewKey.Number(3L))
                        2.0
                    else
                        1.0
                }
            )
        assertEquals(ViewKey.Text("b"), reordered.keyAt(0L))
        assertEquals(ViewKey.Number(3L), reordered.keyAt(1L))
    }

    @Test
    fun `provided results are not enumerated or filtered and custom scores are checked`() {
        val source = UnreadCommandSource()
        assertTrue(commandResults(source, "remote query", CommandFilter.Provided) === source)
        val content = commandItems { item(ViewKey.Number(1L), "One") }
        assertFailsWith<IllegalArgumentException> {
            commandResults(content, "x", CommandFilter.Custom { _, _ -> -1.0 })
        }
        assertFailsWith<IllegalArgumentException> {
            commandResults(content, "x", CommandFilter.Custom { _, _ -> 0.0 / 0.0 })
        }
        assertEquals(0L, commandResults(content, "x", CommandFilter.Custom { _, _ -> 0.0 }).count)
    }

    @Test
    fun `command metadata and DSL keep explicit keys and one editing model`() {
        val entry = CommandEntry.Item(CommandItem(ViewKey.Text("one"), "One"))
        assertFailsWith<IllegalArgumentException> { CommandContent([entry, entry]) }
        assertFailsWith<IllegalArgumentException> {
            CommandContent(
                [
                    entry,
                    CommandEntry.Label(ViewKey.Text("one"), PanelContent.Custom(label("Heading")))
                ]
            )
        }
        assertFailsWith<IllegalArgumentException> {
            CommandContent([CommandEntry.Separator(ViewKey.Position)])
        }
        val query = TextEditorState("draft")
        val content = CommandContent([entry])
        val builder = CommandBuilder()
        builder.empty(styledText { text("Nothing") })
        builder.filter = CommandFilter.Provided
        builder.autoHighlight = false
        val input = builder.snapshot(content, query)
        assertTrue(input.query === query)
        assertEquals(320.0, input.width)
        assertFalse(input.autoHighlight)
        val children = ChildrenBuilder()
        children.command(content, query) { width = 200.0 }
        assertEquals(1L, children.childrenSnapshot().size)
        assertEquals("draft", query.text)
        assertFailsWith<IllegalArgumentException> {
            CommandProps(content, InputProps(query), maxHeight = -1.0)
        }
    }
}

private class UnreadCommandSource: CommandSource {
    public override val count: Long get() = 1000000L
    public override val itemCount: Long get() = count
    public override fun entryAt(index: Long): CommandEntry =
        throw IllegalStateException(Some("provided source was enumerated"))
    public override fun indexOfKey(key: ViewKey): Long? = None
}
