package scoop.examples.glass

import scoop.graphics.*
import scoop.graphics.text.*
import scoop.math.max
import scoop.math.min
import scoop.ui.*
import scoop.ui.style.*

/** A cacheable scene group; child glass samples the current background on every replay. */
internal class GlassOpacity(private val opacity: Props<Double>, scope: ComponentScope) :
    Element<Unit>(scope) {
    public override fun update(): UiInvalidation = UiInvalidation.Scene

    public override fun measure(context: MeasureContext, constraints: Constraints): LayoutResult<
        Unit
    > {
        val child = context.measureChild(0L, constraints)
        context.placeChild(0L, Point(0.0, 0.0))
        return LayoutResult(child, Unit)
    }

    public override fun scene(context: SceneContext, layout: Unit) {
        // Reserve the blur's 3-sigma neighborhood and the lens's 13-unit displacement.
        val bounds = Rect(-24.0, -24.0, context.size.width + 48.0, context.size.height + 48.0)
        context
            .withState { group ->
                group.saveBackdropLayer(opacity.value, bounds = Some(bounds))
                group.children()
            }
    }
}

internal class GlassPanel(
    private val name: String,
    private val material: GlassMaterial,
    private val enabled: Props<Boolean>,
    scope: ComponentScope
) : Element<Unit>(scope) {
    private val painter = scope.resource { StylePainter() }
    private val label = scope.resource { lettering(scope, name, 17.0, 650) }
    private val surface = style {
        corners = Corners.all(20.0)
        background = Some(Paint(Color(0.025, 0.058, 0.085, 0.47)))
        border = Some(Border.all(1.0, Color.White.withAlpha(0.62)))
        clipContent = true
    }

    public override fun measure(context: MeasureContext, constraints: Constraints): LayoutResult<
        Unit
    > {
        val size = constraints.constrain(Size(272.0, 68.0))
        val button = context
            .measureChild(
                0L,
                Constraints
                    .tight(Size(min(52.0, max(0.0, size.width - 20.0)), min(32.0, size.height)))
            )
        context
            .placeChild(
                0L,
                Point(
                    max(0.0, size.width - button.size.width - 14.0),
                    (size.height - button.size.height) * 0.5
                )
            )
        return LayoutResult(LayoutMetrics(size), Unit)
    }

    public override fun scene(context: SceneContext, layout: Unit) {
        val selected = if (enabled.value) Some(material) else None
        val appearance = surface.copy { glass = selected }
        painter
            .scene(context, appearance) { local ->
                if (local.size.width >= 174.0) {
                    local.draw { paint -> paint.canvas.drawText(label, Point(17.0, 22.0)) }
                }
                local.children()
            }
    }
}

internal fun lettering(
    scope: ComponentScope,
    value: String,
    pixels: Double,
    weight: Int
): TextLayout = Paragraph(
    scope.defaultFonts,
    value,
    textStyle {
        families = ["Inter", "Helvetica Neue", "Arial", "sans-serif"]
        fontSize = pixels
        this.weight = weight
        color = Color.White
    }
)
    .use { paragraph -> paragraph.layoutUnwrapped() }
