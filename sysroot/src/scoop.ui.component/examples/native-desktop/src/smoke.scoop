package scoop.examples.native_desktop

import scoop.asyncio.*
import scoop.time.Duration
import scoop.tray.*
import scoop.ui.component.*
import scoop.window.*
import scoop.desktop.DesktopProgress

private suspend fun waitDemo(label: String, ready: () -> Boolean) {
    println("Smoke: " + label)
    var count = 0
    while (!ready()) {
        requireDemo(count < 300, "Timed out: " + label)
        count += 1
        currentEventLoop().sleep(Duration.milliseconds(40L))
    }
}

internal suspend fun runDemoSmoke(demo: DesktopDemo, first: DemoDocument) {
    try {
        awaitDemoScenario(demo, first)
    } catch (error: Throwable) {
        demo.failed(error)
    }
}

private suspend fun awaitDemoScenario(demo: DesktopDemo, first: DemoDocument) {
    waitDemo("first frame") { first.frames > 0 }
    val root = first.root!!
    val second = demo.newDocument()
    waitDemo("second frame") { second.frames > 0 }
    waitDemo("notification settings") {
        when (demo.notificationSettings.value) {
            case Some(_) -> true
            case None -> false
        }
    }
    val beforeDesktop = first.frames
    demo.toggleTheme()
    demo.showBadge.value = true
    demo.badgeCount.value = 7
    demo.showDockMenu.value = false
    first.overlay.value = true
    first.caption.value = true
    when (first.desktopCapabilities) {
        case Some(caps) -> if (caps.progress)
            first.progress.value = DesktopProgress.Normal(25UL, 100UL)
        case None -> {}
    }
    waitDemo("desktop and SVG update") { first.frames > beforeDesktop }
    demo.showDockMenu.value = true
    requireDemo(demo.notificationCount == 0, "render submitted an unsolicited notification")
    demo.checked.value = true
    demo.color.value = 2
    demo.activate("Smoke")
    root.overrideMenu.value = true
    root.mode.value = 0
    waitDemo("system frame") {
        first.window.frameMetrics!!.frame == WindowFrame.System(WindowContentMode.Standard)
    }
    if (demo.capabilities!!.frame.extendedContent) {
        if (!platformExtendedMenuBar()) {
            val beforeHide = first.frames
            root.setMenuBarHidden(true)
            waitDemo("hidden menu frame") { first.frames > beforeHide }
        }
        root.selectFrame(1)
        waitDemo("extended frame") {
            first.window.frameMetrics!!.frame == WindowFrame.System(WindowContentMode.Extended)
        }
        if (!platformExtendedMenuBar())
            root.setMenuBarHidden(false)
    }
    root.selectFrame(2)
    waitDemo("client frame") { first.window.frameMetrics!!.frame == WindowFrame.Client }
    waitDemo("popup anchor") { root.popup.requestOpen() }
    root.popup.cancel()
    waitDemo("popup cancelled") { !root.popup.isPending }
    root.showTool()
    requireDemo(root.tool.isOpen, "owned tool did not open")
    requireDemo(root.tool.window!!.ownerWindow?.id == Some(first.window.id), "wrong tool owner")
    root.showShape()
    requireDemo(root.shape.isOpen, "shaped window did not open")
    root.showDialog()
    requireDemo(first.window.isInputBlocked && !second.window.isInputBlocked, "owner modal scope")
    requireDemo(root.response!!.accept(true), "owner modal response")
    waitDemo("owner result") { !root.dialog.isPending }
    val app = demo.applicationView!!
    app.showDialog()
    requireDemo(
        first.window.isInputBlocked && second.window.isInputBlocked,
        "application modal scope"
    )
    app.dialog.cancel()
    waitDemo("application result") { !app.dialog.isPending }
    root.openFile()
    root.files.cancel()
    waitDemo("owner file completion") { !root.files.isPending }
    demo.allowUnanchored.value = true
    app.showTrayWindow(None)
    app.closeTrayWindow()
    when (demo.tray.icon) {
        case Some(icon) -> if (icon.capabilities().programmaticMenu) {
            demo.tray.requestMenu()
            demo.tray.cancelMenu()
            waitDemo("tray menu completion") { !demo.tray.isMenuPending }
        }
        case None -> {}
    }
    demo.background()
    waitDemo("all documents closed") { demo.documents.size == 0L }
    demo.activate("Windowless smoke")
    demo.color.value = 1
    app.openFile()
    app.files.cancel()
    waitDemo("windowless file completion") { !app.files.isPending }
    val reopened = demo.newDocument()
    waitDemo("reopened frame") { reopened.frames > 0 }
    requireDemo(demo.nativeFailures == 0, "native operation failed during smoke")
    demo.smokeCompleted = true
    demo.application!!.requestExit()
}
