package scoop.examples.native_desktop

import scoop.tray.*
import scoop.graphics.Color
import scoop.graphics.svg.SvgDrawOptions
import scoop.icons.lucide.folder as folderIcon
import scoop.ui.component.desktop.toDesktopImage
import scoop.ui.*
import scoop.ui.component.*
import scoop.ui.style.*
import scoop.window.*

internal fun demoIcon(orange: Boolean): DesktopImage =
    folderIcon.toDesktopImage(
        LogicalSize(24.0, 24.0),
        [
            PhysicalSize(16, 16),
            PhysicalSize(24, 24),
            PhysicalSize(32, 32),
            PhysicalSize(48, 48),
            PhysicalSize(64, 64),
            PhysicalSize(128, 128),
            PhysicalSize(256, 256)
        ],
        SvgDrawOptions(
            Some(
                if (orange)
                    Color(0.92, 0.49, 0.18, 1.0)
                else
                    Color(0.14, 0.42, 0.84, 1.0)
            )
        )
    )

internal fun rectText(value: DesktopRect?): String =
    when (value) {
        case None -> "unknown"
        case Some(val rect) -> f"(${rect.origin.x}, ${rect.origin.y}) ${rect.width} × ${rect.height}"
    }

internal fun describeAnchor(anchor: TrayAnchor?): String =
    when (anchor) {
        case Some(TrayAnchor.Rectangle(val value)) -> "native icon rectangle " +
            rectText(Some(value.bounds))
        case Some(TrayAnchor.PointHint(val point)) -> f"host point hint (${point.x}, ${point.y})"
        case None -> "no anchor"
    }

internal fun activationText(event: TrayActivation): String {
    val kind =
        when (event.kind) {
            case Primary -> "primary";
            case Context -> "context";
            case Secondary -> "secondary"
        }
    val source =
        when (event.source) {
            case Pointer -> "pointer";
            case Keyboard -> "keyboard";
            case Unknown -> "unknown"
        }
    return kind + " / " + source + ": " + describeAnchor(event.anchor)
}

internal fun queryDesktop(demo: DesktopDemo) {
    val app = demo.application!!
    val caps = demo.capabilities!!
    var message = "Desktop coordinates / work areas:"
    for (monitor in app.monitors()) {
        message += "\n" +
            (monitor.name ?: "Display") +
            f" • scale ${monitor.scaleFactor} • work " +
            rectText(monitor.workArea)
    }
    message += "\nTaskbar: " +
        (
            if (caps.positioning.systemTaskbarBounds)
                rectText(app.systemTaskbarBounds())
            else
                "unsupported"
        )
    message += "\nMenu bar height: " +
        (
            if (caps.positioning.systemMenuBarHeight)
                when (app.systemMenuBarHeight()) {
                    case Some(val height) -> height.toString();
                    case None -> "unknown"
                }
            else
                "unsupported"
        )
    when (demo.tray.icon) {
        case Some(val icon) -> {
            val trayCaps = icon.capabilities()
            message += "\nTray rectangle: " +
                (
                    if (trayCaps.iconBounds)
                        when (icon.geometry()) {
                            case Some(val geometry) -> rectText(Some(geometry.bounds));
                            case None -> "temporarily unknown"
                        }
                    else
                        "unsupported; activation may provide a point hint"
                )
            message += f"\nTray window positioning: ${trayCaps.placeWindow}; host menu: ${
                trayCaps.hostMenu
            }; programmatic menu: ${trayCaps.programmaticMenu}"
        }
        case None -> message += "\nTray is not mounted"
    }
    demo.report(message)
}

internal fun traySection(demo: DesktopDemo): View {
    val available = demo.tray.availability == Some(TrayAvailability.Available)
    val menu =
        when (demo.tray.icon) {
            case Some(val icon) -> icon.capabilities().programmaticMenu;
            case None -> false
        }
    return panel(
        "Tray and windowless application",
        column {
            spacing = 10.0
            label(
                if (available)
                    "Tray host is available. Registration does not guarantee a visible icon; inspect the desktop overflow area too."
                else
                    "Tray host is unavailable. On Linux a StatusNotifierItem host / extension is required."
            )
            row {
                spacing = 8.0
                button(
                    "Blue / orange icon",
                    {
                        demo.color.value =
                            if (demo.color.value == 1)
                                2
                            else
                                1
                    }
                )
                button("Tray menu", { demo.tray.requestMenu() }) { enabled = menu && available }
                button("Panel beside tray", { demo.applicationView!!.showTrayWindow(None) })
                button("Close all windows, keep tray", { demo.background() }) {
                    enabled = available
                }
            }
            row {
                spacing = 12.0
                add(demoOption(demo.allowPointHint.binding(), "Allow host point hint"))
                add(demoOption(demo.allowScreenBounds.binding(), "Allow full-screen bounds"))
                add(demoOption(demo.allowUnanchored.binding(), "Allow unanchored window"))
            }
            label(
                f"Document windows: ${
                    demo.windowCount.value
                }. Tray menu actions and application state remain active after the last document closes."
            )
            label(
                "The panel re-queries icon geometry before placement, flips / slides at work-area edges, and preserves size. Wayland can refuse global placement; fallback requires the explicit choice above."
            )
        }
    )
}

internal class TrayPanel(
    private val demo: DesktopDemo,
    private val close: () -> Unit,
    scope: ComponentScope
): Component(scope) {
    public override fun render(): View {
        val demo = this.demo
        val close = this.close
        return frame(
            column {
                spacing = 12.0
                label("Tray panel") {
                    style {
                        fontSize = Some(22.0);
                        weight = Some(700)
                    }
                }
                label(
                    "This is a real native window, positioned beside the icon when the desktop permits it."
                )
                button("Update shared state", { demo.activate("Tray panel") })
                row {
                    spacing = 8.0
                    button("Open document", { demo.newDocument() })
                    button("Close", close)
                }
            }
        ) {
            padding = Some(Insets.all(20.0));
            surface = Some(SurfaceKind.Plain)
        }
    }
}
