package scoop.examples.ui.shadcn

import scoop.graphics.text.FontCollection
import scoop.ui.*
import scoop.window.*

internal fun runGallery(model: GalleryModel) {
    FontCollection().use {
        fonts -> context(model.source) {
            UiHost {
                host,
                active,
                event -> when (event) {
                    case Resumed -> {
                        val window =
                            active.createWindow(
                                windowAttributes {
                                    this.title = "Scoop — shadcn"
                                    this.size = LogicalSize(1120.0, 780.0)
                                }
                            )
                        host.attach(
                            window,
                            { mount -> Gallery(model, fonts, scope = mount) },
                            fonts = Some(fonts)
                        )
                        window.requestFocus()
                    }
                    case Window(_, WindowEvent.CloseRequested) -> active.requestExit()
                    case Window(_, WindowEvent.Focused(true)) -> {
                        if (model.usesSystemColors)
                            model.refreshTheme()
                    }
                    case Window(_, WindowEvent.ThemeChanged(_)) -> {
                        if (model.usesSystemColors)
                            model.refreshTheme()
                    }
                    else -> {}
                }
            }.use { host -> Application().run(host) }
        }
    }
}
