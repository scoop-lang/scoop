package scoop.examples.ui.shadcn

import scoop.graphics.*
import scoop.ui.*
import scoop.ui.component.*
import scoop.ui.component.column as makeColumn
import scoop.ui.component.row as makeRow
import scoop.ui.component.wrap as makeWrap
import scoop.ui.component.frame as makeFrame
import scoop.ui.component.scrollArea as makeScrollArea
import scoop.ui.style.*
import scoop.window.WindowMetrics

/** A gallery connection owns the models and theme shared by all its pages. */
public class GalleryScene public constructor() {
    private val model = GalleryModel()
    public val theme: ThemeSource get() = model.source
    public fun root(scope: ComponentScope): Component = Gallery(model, scope)
}

internal class Gallery(private val model: GalleryModel, scope: ComponentScope) : Component(scope) {
    private val compact = state(isNarrow(scope.nativeWindow.metrics))
    private val detail = state(false)
    private val appearance = state(false)

    public override fun onMount() {
        scope
            .observeWindow(scope.nativeWindow) { event ->
                when (event) {
                    case GeometryChanged(val metrics) -> compact.value = isNarrow(Some(metrics))
                    else -> {}
                }
            }
    }

    public override fun render(): View {
        val model = this.model
        if (!compact.value)
            return galleryView(model) { entry ->
                model.selected.value = entry
                detail.value = true
            }
        val entries = model.entries()
        val current = model.current(entries)
        val panel = this
        return cachedScene(
            direction(
                makeFrame(
                    makeColumn {
                        spacing = 8.0
                        padding = Insets.all(12.0)
                        alignment = CrossAlignment.Stretch
                        add(
                            makeRow {
                                spacing = 8.0
                                alignment = CrossAlignment.Center
                                if (panel.detail.value)
                                    button("Examples", { panel.detail.value = false }) {
                                        variant = ButtonVariant.Outline
                                        semantics = ComponentSemantics(
                                            automationId = Some("gallery-back")
                                        )
                                    }
                                item(
                                    galleryText(
                                        model,
                                        if (panel.detail.value && current != None)
                                            demoTitle(current!!)
                                        else
                                            "UI Gallery",
                                        18.0,
                                        600
                                    )
                                ) { grow = 1.0 }
                                button(
                                    "Appearance",
                                    { panel.appearance.value = !panel.appearance.value }
                                ) { variant = ButtonVariant.Outline }
                            }
                        )
                        if (panel.appearance.value) add(galleryAppearance(model))
                        val page = if (panel.detail.value && current != None)
                            makeScrollArea(
                                makeFrame(galleryDemo(model, current!!)) {
                                    padding = Some(Insets.all(4.0))
                                }
                            )
                        else
                            galleryNavigation(model, entries, current, true) { entry ->
                                when (entry) {
                                    case AppWorkspace -> model.appWorkspace.navigation.value = false
                                    case Sidebar -> model.sidebars.open.value = false
                                    else -> {}
                                }
                                model.selected.value = entry
                                panel.detail.value = true
                                panel.appearance.value = false
                            }
                        item(page) {
                            grow = 1.0;
                            basis = FlexBasis.Fixed(0.0)
                        }
                    }
                ) {
                    style {
                        background(
                            Some(
                                Paint(
                                    model.source.current.value.tokens.palette.background.background
                                )
                            )
                        )
                    }
                },
                model.direction.value
            )
        )
    }
}

private fun isNarrow(metrics: WindowMetrics?): Boolean {
    val value = metrics ?: return false
    return value.logicalSize.width - value.safeAreaInsets.left - value.safeAreaInsets.right < 720.0
}

private fun galleryView(model: GalleryModel, select: (Demo) -> Unit): View {
    val palette = model.source.current.value.tokens.palette
    val entries = model.entries()
    val current = model.current(entries)
    val content = when (current) {
        case Some(val value) -> galleryDemo(model, value)
        case None ->
            makeColumn {
                spacing = 12.0
                add(galleryText(model, "No matching examples", 24.0, 600))
                add(
                    galleryText(model, "Try Card, Alert, Button, Input, or Empty.", 14.0, 400, true)
                )
            }
    }
    return cachedScene(
        direction(
            makeFrame(
                makeColumn {
                    spacing = 24.0
                    padding = Insets.all(28.0)
                    alignment = CrossAlignment.Stretch
                    add(galleryToolbar(model))
                    item(
                        makeRow {
                            spacing = 32.0
                            alignment = CrossAlignment.Stretch
                            add(
                                galleryNavigation(model, entries, current, false, select)
                            )
                            item(
                                makeScrollArea(
                                    makeFrame(content) { padding = Some(Insets.all(6.0)) }
                                )
                            ) {
                                grow = 1.0
                                basis = FlexBasis.Fixed(0.0)
                            }
                        }
                    ) {
                        grow = 1.0
                        basis = FlexBasis.Fixed(0.0)
                    }
                    add(
                        galleryText(
                            model,
                            f"${galleryStyleTitle(model.style.value)}  /  Native Scoop controls",
                            12.0,
                            400,
                            true
                        )
                    )
                }
            ) { style { background(Some(Paint(palette.background.background))) } },
            model.direction.value
        )
    )
}

private fun galleryToolbar(model: GalleryModel): View {
    return makeRow {
        alignment = CrossAlignment.Center
        add(galleryText(model, "Scoop / UI Gallery", 22.0, 600))
        item(empty()) { grow = 1.0 }
        add(galleryAppearance(model))
    }
}

private fun galleryAppearance(model: GalleryModel): View {
    val theme = if (model.mode.value == ThemeMode.Light) "Dark theme" else "Light theme"
    val direction = if (model.direction.value == LayoutDirection.Ltr)
        "Switch to RTL"
    else
        "Switch to LTR"
    return makeWrap {
        spacing = 6.0
        lineSpacing = 6.0
        alignment = CrossAlignment.Center
        button(theme, { model.toggleTheme() }) { variant = ButtonVariant.Outline }
        button(direction, { model.toggleDirection() }) { variant = ButtonVariant.Outline }
        button(
            if (model.reduced.value) "Full motion" else "Reduce motion",
            { model.toggleMotion() }
        ) { variant = ButtonVariant.Outline }
        if (model.hasSystemColors)
            button(
                if (model.usesSystemColors) "Colors: System" else "Colors: Preset",
                { model.toggleColors() }
            ) { variant = ButtonVariant.Outline }
        select(
            binding<GalleryStyle?>(
                { Some(model.style.value) },
                { next -> model.selectStyle(next ?: model.style.value) }
            )
        ) {
            key = ViewKey.Text("gallery-style")
            width = Some(190.0)
            position = SelectPosition.Popup
            focus { handle = Some(model.styleFocus) }
            semantics = ComponentSemantics(
                name = Some("Style"),
                automationId = Some("gallery-style")
            )
            for (value in model.styles())
                item(
                    Choice(
                        ViewKey.Text(galleryStyleTitle(value)),
                        value,
                        galleryStyleTitle(value)
                    )
                )
        }
    }
}

private fun galleryNavigation(
    model: GalleryModel,
    entries: Array<Demo>,
    current: Demo?,
    compact: Boolean,
    select: (Demo) -> Unit
): View = makeFrame(
    makeScrollArea(
        makeColumn {
            spacing = 12.0
            alignment = CrossAlignment.Stretch
            padding = Insets(8.0, 4.0, 8.0, 4.0)
            input(model.query) {
                placeholder = "Search examples..."
                semantics = ComponentSemantics(
                    name = Some("Search examples"),
                    automationId = Some("gallery-search")
                )
            }
            if (model.query.text.byteLength > 0L)
                button("Clear search", { model.query.replaceAll("") }) {
                    variant = ButtonVariant.Ghost
                    semantics = ComponentSemantics(automationId = Some("gallery-clear-search"))
                }
            for (applications in [true, false]) {
                var present = false
                for (entry in entries)
                    if (applicationDemo(entry) == applications) present = true
                if (present)
                    add(
                        galleryText(
                            model,
                            if (applications) "APPLICATIONS" else "COMPONENTS",
                            11.0,
                            600,
                            true
                        )
                    )
                for (entry in entries)
                    if (applicationDemo(entry) == applications)
                        button(demoTitle(entry), { select(entry) }) {
                            semantics = ComponentSemantics(
                                automationId = Some("gallery-entry-" + demoTitle(entry))
                            )
                            variant = if (current == Some(entry))
                                ButtonVariant.Default
                            else
                                ButtonVariant.Outline
                            style {
                                surface {
                                    suggestedSize = Some(Size(190.0, if (compact) 44.0 else 32.0))
                                }
                            }
                        }
            }
        }
    ) {
        state = Some(model.catalogScroll)
        scrollbarBehavior { placement = ScrollbarPlacement.Gutter }
    }
) {
    if (!compact) width = Some(190.0)
    alignment = Alignment(AxisAlignment.Start, AxisAlignment.Start)
}

internal fun galleryText(
    model: GalleryModel,
    value: String,
    size: Double = 14.0,
    weight: Int = 400,
    muted: Boolean = false
): View {
    val palette = model.source.current.value.tokens.palette
    return label(value) {
        style {
            fontSize = Some(size)
            this.weight = Some(weight)
            color = Some(
                if (muted) palette.muted.foreground else palette.background.foreground
            )
        }
    }
}
