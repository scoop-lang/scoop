package scoop.examples.ui.shadcn

import scoop.ui.style.Insets
import scoop.ui.*
import scoop.ui.component.*
import scoop.ui.component.column as navColumn
import scoop.ui.component.row as navRow
import scoop.ui.text.TextEditorState

internal class NavigationMenuExamplesModel {
    val open = state<ViewKey?>(None)
    val page = state("Overview")
    val vertical = state(false)
    val viewport = state(true)
    val enabled = state(true)
    val narrow = state(false)
    val query = TextEditorState()
    val search = FocusHandle()
    fun navigate(page: String) {
        this.page.value = page;
        open.value = None
    }
}

private fun navExampleLink(
    model: NavigationMenuExamplesModel,
    title: String,
    description: String
): View =
    navigationMenuLink(
        navColumn {
            typography(title, TypographyRole.Small)
            typography(description, TypographyRole.Muted)
            spacing = 4.0;
            alignment = CrossAlignment.Stretch
        },
        { model.navigate(title) }
    ) { active = model.page.value == title }

internal fun navigationMenuExamples(model: NavigationMenuExamplesModel): View {
    val guides =
        navRow {
            this.item(
                navColumn {
                    add(
                        navExampleLink(
                            model,
                            "Getting started",
                            "Install Scoop and build a native application."
                        )
                    )
                    add(
                        navExampleLink(
                            model,
                            "Language guide",
                            "Values, types, and reusable components."
                        )
                    )
                    alignment = CrossAlignment.Stretch
                }
            ) {
                grow = 1.0;
                basis = FlexBasis.Fixed(0.0)
            }
            this.item(
                navColumn {
                    add(navExampleLink(model, "Examples", "Explore complete applications."))
                    add(
                        navExampleLink(
                            model,
                            "Component library",
                            "Compose native controls and layouts."
                        )
                    )
                    alignment = CrossAlignment.Stretch
                }
            ) {
                grow = 1.0;
                basis = FlexBasis.Fixed(0.0)
            }
            spacing = 4.0;
            alignment = CrossAlignment.Stretch
        }
    val docs =
        navColumn {
            input(model.query) {
                placeholder = "Search documentation";
                focus = FocusOptions(Some(model.search))
            }
            navigationMenuLink("Language reference", { model.navigate("Language reference") })
            navigationMenuLink("UI components", { model.navigate("UI components") })
            navigationMenuLink("Runtime and GC", { model.navigate("Runtime and GC") })
            spacing = 4.0;
            alignment = CrossAlignment.Stretch;
            padding = Insets.all(4.0)
        }
    return navColumn {
        add(panelHeading("Navigation Menu"))
        typography(
            "Browse destinations and rich panels with pointer or keyboard. Hover keeps the current focus; arrow down enters a panel.",
            TypographyRole.Muted
        )
        wrap {
            button(
                if (model.vertical.value)
                    "Orientation: vertical"
                else
                    "Orientation: horizontal",
                { model.vertical.value = !model.vertical.value }
            ) { variant = ButtonVariant.Outline; }
            button(
                if (model.viewport.value)
                    "Viewport: shared edge"
                else
                    "Viewport: trigger edge",
                { model.viewport.value = !model.viewport.value }
            ) { variant = ButtonVariant.Outline; }
            button(
                if (model.narrow.value)
                    "Panel: narrow"
                else
                    "Panel: normal",
                { model.narrow.value = !model.narrow.value }
            ) { variant = ButtonVariant.Outline; }
            button(
                if (model.enabled.value)
                    "Disable"
                else
                    "Enable",
                { model.enabled.value = !model.enabled.value }
            ) { variant = ButtonVariant.Outline; }
            spacing = 8.0;
            lineSpacing = 8.0
        }
        navigationMenu(Some(model.open.binding())) {
            orientation =
                if (model.vertical.value)
                    FlexAxis.Vertical
                else
                    FlexAxis.Horizontal
            viewport = model.viewport.value;
            enabled = model.enabled.value
            item(ViewKey.Text("guides"), "Guides", guides) {
                width =
                    if (model.narrow.value)
                        280.0
                    else
                        520.0
            }
            item(ViewKey.Text("docs"), "Documentation", docs) {
                width =
                    if (model.narrow.value)
                        220.0
                    else
                        320.0;
                initialFocus = Some(model.search)
            }
            link(ViewKey.Text("overview"), "Overview", { model.navigate("Overview") }) {
                active = model.page.value == "Overview"
            }
            link(ViewKey.Text("releases"), "Releases", { model.navigate("Releases") })
            link(ViewKey.Text("preview"), "Preview", {}) { enabled = false }
        }
        typography(f"Current page: ${model.page.value}", TypographyRole.H4)
        typography(
            "The open panel is independent from the current page. Panel contents remain ordinary links, columns, and a native editor.",
            TypographyRole.Muted
        )
        button("Open documentation", { model.open.value = Some(ViewKey.Text("docs")) }) {
            variant = ButtonVariant.Outline;
        }
        spacing = 24.0
    }
}
