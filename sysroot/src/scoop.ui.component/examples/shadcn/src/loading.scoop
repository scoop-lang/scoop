package scoop.examples.ui.shadcn

import scoop.graphics.*
import scoop.graphics.text.*
import scoop.ui.*
import scoop.ui.component.*
import scoop.ui.component.column as makeColumn
import scoop.ui.component.row as makeRow
import scoop.ui.component.card as makeCard
import scoop.ui.style.*

internal fun skeletonExamples(model: GalleryModel): View =
    makeColumn {
        this.add(panelHeading("Skeleton"))
        this.label("Keep content in place while it loads. Reveal it when ready.")
        this.row {
            this.skeleton {
                this.shape = SkeletonShape.Circle;
                this.width = Some(40.0);
                this.height = Some(40.0);
                this.animated = false
            }
            this.column {
                this.skeleton {
                    this.width = Some(220.0);
                    this.animated = false
                }
                this.skeleton {
                    this.width = Some(160.0);
                    this.height = Some(12.0);
                    this.animated = false
                }
                this.spacing = 8.0
            }
            this.spacing = 12.0
            this.alignment = CrossAlignment.Center
        }
        this.scrollArea(
            makeColumn {
                this.skeleton(component({ mount -> LoadedSkeletonCard(model, scope = mount) })) {
                    this.loading = model.skeletonLoading.value
                    this.animated = model.skeletonAnimated.value
                    this.width = Some(model.loadingExtent.value)
                }
                this.frame(empty()) { this.height = Some(400.0) }
                this.label("Scroll up to return to the preview.")
                this.spacing = 24.0
                this.padding = Insets.all(8.0)
                this.alignment = CrossAlignment.Start
            }
        ) {
            this.state = Some(model.skeletonScroll);
            this.width = Some(600.0);
            this.height = Some(180.0)
        }
        this.row {
            this.button(
                if (model.skeletonLoading.value)
                    "Reveal content"
                else
                    "Show skeleton",
                { model.skeletonLoading.value = !model.skeletonLoading.value }
            )
            this.button(
                if (model.skeletonAnimated.value)
                    "Pause pulse"
                else
                    "Animate pulse",
                { model.skeletonAnimated.value = !model.skeletonAnimated.value }
            ) { this.variant = ButtonVariant.Outline }
            this.button(
                if (model.reduced.value)
                    "Use full motion"
                else
                    "Reduce motion",
                { model.toggleMotion() }
            ) { this.variant = ButtonVariant.Outline }
            this.spacing = 8.0
        }
        this.spacing = 24.0
        this.padding = Insets.all(6.0)
        this.alignment = CrossAlignment.Start
    }

private class LoadedSkeletonCard(private val model: GalleryModel, scope: ComponentScope): Component(
    scope
) {
    private val count = state(0)
    public override fun onMount() {
        model.skeletonCreates += 1
    }
    public override fun render(): View {
        val model = this.model
        val count = this.count
        return makeCard(
            makeRow {
                this.button(
                    f"Saved ${count.value}",
                    {
                        count.value += 1
                        model.skeletonCount = count.value
                    }
                ) { this.focus = FocusOptions(Some(model.skeletonFocus)) }
                this.spinner { this.running = model.skeletonChildRunning.value }
                this.button(
                    "Toggle activity",
                    { model.skeletonChildRunning.value = !model.skeletonChildRunning.value }
                ) { this.variant = ButtonVariant.Ghost }
                this.spacing = 12.0
                this.alignment = CrossAlignment.Center
            }
        ) { this.title("Your workspace is ready"); }
    }
}

internal fun progressExamples(model: GalleryModel): View =
    makeColumn {
        this.add(panelHeading("Progress"))
        this.label("Track a known value, or show ongoing work until a total becomes available.")
        this.scrollArea(
            makeColumn {
                this.progress(model.progressValue.value) {
                    this.label("Uploading project files")
                    this.showValue = true
                    if (model.loadingTransparent.value)
                        this.indicatorColor = Some(Color.Transparent)
                }
                this.progress(3.0) {
                    this.minimum = 0.0;
                    this.maximum = 8.0;
                    this.label("Processing tasks");
                    this.valueLabel("3 of 8")
                    this.thickness = Some(8.0)
                    this.indicatorColor = Some(Color(0.22, 0.55, 0.42))
                }
                this.frame(empty()) { this.height = Some(400.0) }
                this.label("Scroll up to return to the preview.")
                this.spacing = 24.0
                this.padding = Insets.all(8.0)
                this.alignment = CrossAlignment.Stretch
            }
        ) {
            this.state = Some(model.progressScroll);
            this.width = Some(600.0);
            this.height = Some(180.0)
        }
        this.row {
            this.button("Start", { model.progressValue.value = Some(0.0) })
            this.button(
                "Advance 20%",
                {
                    model.progressValue.value =
                        Some(((model.progressValue.value ?: 0.0) + 20.0) % 120.0)
                }
            ) { this.variant = ButtonVariant.Outline }
            this.button("Unknown total", { model.progressValue.value = None }) {
                this.variant = ButtonVariant.Outline
            }
            this.button(
                if (model.reduced.value)
                    "Use full motion"
                else
                    "Reduce motion",
                { model.toggleMotion() }
            ) { this.variant = ButtonVariant.Outline }
            this.spacing = 8.0
        }
        this.spacing = 24.0
        this.padding = Insets.all(6.0)
        this.alignment = CrossAlignment.Start
    }
