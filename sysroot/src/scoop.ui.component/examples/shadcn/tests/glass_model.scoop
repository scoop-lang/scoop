package scoop.examples.ui.shadcn

import scoop.test.*
import scoop.ui.style.*

@Test
private class GalleryGlassModelTest {
    @Test
    fun `liquid glass is searchable without replacing the selected page or its draft`() {
        val model = GalleryModel()
        assertEquals(70L, model.entries().size)
        model.selected.value = Demo.Input
        model.glass.draft.replaceAll("保留的草稿")
        model.query.replaceAll("lIqUiD")
        assertEquals(1L, model.entries().size)
        assertEquals(Some(Demo.LiquidGlass), model.current(model.entries()))
        assertEquals(Demo.Input, model.selected.value)
        model.query.replaceAll("")
        assertEquals(Some(Demo.Input), model.current(model.entries()))
        assertEquals("保留的草稿", model.glass.draft.text)
    }

    @Test
    fun `glass choices survive complete theme replacement and remain independent of accessibility resolution`() {
        val gallery = GalleryModel()
        val model = gallery.glass
        val editor = model.draft
        val focus = model.likeFocus
        model.likes.value = 3
        model.connected.value = false
        model.draft.replaceAll("Same idea")
        for (role in galleryGlassRoles)
            model.toggleRole(role)
        for (
            preset in [
                GalleryGlassMaterial.Frosted,
                GalleryGlassMaterial.Clear,
                GalleryGlassMaterial.Liquid
            ]
        ) {
            model.preset.value = preset
            for (mode in [ThemeMode.Light, ThemeMode.Dark]) {
                if (gallery.mode.value != mode) gallery.toggleTheme()
                for (style in gallery.styles()) {
                    gallery.selectStyle(style)
                    gallery.refreshTheme()
                    val theme = gallery.source.current.value
                    val material = theme.tokens.glassSurfaces.control!!
                    assertEquals(model.material(mode).refraction, material.refraction)
                    assertEquals(model.material(mode).blurSigma, material.blurSigma)
                    for (role in galleryGlassRoles) {
                        assertTrue(theme.tokens.glassSurfaces.get(role)!! === material)
                        val solid = theme
                            .withPreferences(ThemePreferences(reduceTransparency = true))
                        when (solid.tokens.glassSurfaces.get(role)) {
                            case Some(_) -> fail(Some("a resolved solid theme reintroduced glass"))
                            case None -> {}
                        }
                        assertTrue(
                            solid
                                .withPreferences(ThemePreferences())
                                .tokens
                                .glassSurfaces
                                .get(role)!! ===
                                material
                        )
                    }
                }
            }
        }
        model.toggleRole(SurfaceRole.Input)
        gallery.refreshTheme()
        when (gallery.source.current.value.tokens.glassSurfaces.input) {
            case Some(_) -> fail(Some("the input selection was not cleared"))
            case None -> {}
        }
        assertTrue(model.uses(SurfaceRole.Toolbar))
        assertTrue(editor === model.draft)
        assertTrue(focus === model.likeFocus)
        assertEquals("Same idea", model.draft.text)
        assertEquals(3, model.likes.value)
        assertFalse(model.connected.value)
    }
}
