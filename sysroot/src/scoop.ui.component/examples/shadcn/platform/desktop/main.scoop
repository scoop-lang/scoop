package scoop.examples.ui.shadcn

import scoop.graphics.text.FontCollection
import scoop.ui.*
import scoop.window.*
import scoop.window.asyncio.runWithAsyncio

internal fun runGallery(model: GalleryModel) {
    FontCollection()
        .use { fonts ->
            context(model.source) {
                UiHost { host, active, event ->
                    when (event) {
                        case Resumed -> {
                            val window = active
                                .createWindow(
                                    windowAttributes {
                                        this.title = "Scoop — UI Gallery"
                                        this.size = LogicalSize(1120.0, 780.0)
                                    }
                                )
                            val root = host
                                .attach(
                                    window,
                                    { mount -> Gallery(model, scope = mount) },
                                    fonts = Some(fonts)
                                )
                            model.glass.bind(root)
                            window.requestFocus()
                        }

                        case Window(_, WindowEvent.CloseRequested) -> {
                            model.glass.bind(None)
                            active.requestExit()
                        }

                        case Window(_, WindowEvent.Focused(true)) -> {
                            if (model.usesSystemColors) model.refreshTheme()
                        }

                        case Window(_, WindowEvent.ThemeChanged(_)) -> {
                            if (model.usesSystemColors) model.refreshTheme()
                        }

                        else -> {}
                    }
                }
                    .use { host -> Application().runWithAsyncio(host) }
            }
        }
}
