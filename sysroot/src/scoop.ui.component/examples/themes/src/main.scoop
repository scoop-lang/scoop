package scoop.examples.ui.themes

import scoop.graphics.*
import scoop.graphics.text.*
import scoop.ui.*
import scoop.ui.component.*
import scoop.ui.style.*
import scoop.ui.text.TextEditorState
import scoop.window.*

internal class Showcase(private val model: ShowcaseModel, scope: ComponentScope): Component(scope) {
    private var count: Int by state(0)
    private val name = TextEditorState("Scoop")
    private val notes = TextEditorState()
    private val choices = Array<FocusHandle>(6L) { _ -> FocusHandle() }
    public override fun onMount() {
        val items = Array<NavigationItem>(choices.size) { index -> NavigationItem(choices[index]) }
        scope.keyNavigation(
            navigationOptions {
                addAll(items)
                layout = NavigationLayout.Horizontal
                loop = true
            }
        )
    }
    public override fun render(): View =
        showcaseView(model, count, name, notes, choices, { count += 1 })
}

internal class Gallery(
    private val props: Props<scoop.ui.style.Theme>,
    scope: ComponentScope
): Element<Unit>(scope) {
    private var fonts = scope.defaultFonts
    private var painter = GalleryPainter(fonts)
    init {
        scope.onDispose { painter.close() }
    }
    public override fun update(): UiInvalidation {
        val current = scope.defaultFonts
        if (current !== fonts) {
            painter.close()
            painter = GalleryPainter(current)
            fonts = current
        }
        return UiInvalidation.Scene
    }
    public override fun measure(context: MeasureContext, constraints: Constraints): LayoutResult<
        Unit
    > =
        LayoutResult(
            LayoutMetrics(constraints.constrain(Size(constraints.maxWidth ?: 1040.0, 300.0))),
            Unit
        )
    public override fun scene(context: SceneContext, measured: Unit) {
        context.draw { paint -> painter.paint(paint.canvas, props.value, paint.size.width) }
    }
}

fun main() {
    FontCollection().use {
        fonts ->
        val model = ShowcaseModel()
        context(model.source) {
            UiHost {
                host,
                active,
                event -> when (event) {
                    case Resumed -> {
                        val window =
                            active.createWindow(
                                windowAttributes {
                                    this.title = "Scoop — themes"
                                    this.size = LogicalSize(1120.0, 840.0)
                                }
                            )
                        model.systemTheme(window.observedTheme)
                        host.attach(
                            window,
                            { mount -> Showcase(model, scope = mount) },
                            fonts = Some(fonts)
                        )
                        window.requestFocus()
                    }
                    case Window(_, WindowEvent.ThemeChanged(value)) -> model.systemTheme(value)
                    case Window(_, WindowEvent.CloseRequested) -> active.requestExit()
                    else -> {}
                }
            }.use { host -> Application().run(host) }
        }
    }
}
