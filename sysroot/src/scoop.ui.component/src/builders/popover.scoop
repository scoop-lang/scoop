package scoop.ui.component

import scoop.graphics.text.*
import scoop.surface.AnimationSpec
import scoop.ui.*
import scoop.ui.style.*

public open class PopupTriggerBuilder internal constructor() {
    public var enabled: Boolean = true
    public var variant: ButtonVariant = ButtonVariant.Outline
    public var size: ButtonSize = ButtonSize.Default
    public var style: ButtonStyle = buttonStyle()
    public var focus: FocusOptions = FocusOptions()
    public var fonts: FontCollection? = None
    public fun style(configure: ButtonStyleBuilder.() -> Unit) {
        style = style.copy(configure)
    }
    public fun focus(configure: FocusOptionsBuilder.() -> Unit) {
        focus = focus.copy(configure)
    }
    internal fun snapshot(content: ButtonContent): PopupTriggerSpec =
        PopupTriggerSpec(content, enabled, variant, size, style, focus, fonts)
}

public class PopoverBuilder internal constructor(): PanelBuilder() {
    public var trigger: PopupTriggerSpec? = None
    public var anchor: LayoutAnchor? = None
    public var width: Double = 288.0
    public var side: OverlaySide = OverlaySide.Bottom
    public var alignment: OverlayAlignment = OverlayAlignment.Center
    public var gap: Double = 4.0
    public var viewportPadding: Double = 8.0
    public var matchAnchorWidth: Boolean = false
    public var anchorVisibility: AnchorVisibility = AnchorVisibility.Close
    public var mode: OverlayMode = OverlayMode.NonModal
    public var focus: OverlayFocusOptions = OverlayFocusOptions()
    public var handle: OverlayHandle? = None
    public var enabled: Boolean = true
    public var dismiss: OverlayDismiss? = None
    public var arrow: PopupArrow? = None
    public var transition: StyleValue<AnimationSpec?> = StyleValue.Inherit
    public var onOpenChange: (Boolean) -> Unit = {}
    public var onCloseRequest: (OverlayCloseReason) -> Boolean = { _ -> true }
    public var onClosed: (OverlayCloseReason) -> Unit = {}
    public fun trigger(text: String, configure: PopupTriggerBuilder.() -> Unit = {}) {
        setTrigger(ButtonContent.Label(LabelProps(LabelText.Plain(text, None))), configure)
    }
    public fun trigger(text: StyledText, configure: PopupTriggerBuilder.() -> Unit = {}) {
        setTrigger(ButtonContent.Label(LabelProps(LabelText.Styled(text))), configure)
    }
    public fun trigger(content: View, configure: PopupTriggerBuilder.() -> Unit = {}) {
        setTrigger(ButtonContent.Custom(content), configure)
    }
    private fun setTrigger(content: ButtonContent, configure: PopupTriggerBuilder.() -> Unit) {
        val builder = PopupTriggerBuilder()
        builder.configure()
        trigger = Some(builder.snapshot(content))
    }
    public fun focus(configure: OverlayFocusOptionsBuilder.() -> Unit) {
        focus = focus.copy(configure)
    }
    public fun transition(value: AnimationSpec?) {
        transition = StyleValue.Set(value)
    }
    internal fun snapshot(open: Binding<Boolean>, content: View): PopoverProps =
        PopoverProps(
            open,
            content,
            trigger,
            anchor,
            title,
            description,
            width,
            side,
            alignment,
            gap,
            viewportPadding,
            matchAnchorWidth,
            anchorVisibility,
            mode,
            focus,
            handle,
            enabled,
            dismiss,
            transition,
            onOpenChange,
            onCloseRequest,
            onClosed,
            fonts,
            theme,
            style,
            arrow
        )
}

internal fun makePopover(
    open: Binding<Boolean>,
    content: View,
    configure: PopoverBuilder.() -> Unit
): View {
    val builder = PopoverBuilder()
    builder.configure()
    return component(
        builder.snapshot(open, content),
        { current, mount -> Popover(current, scope = mount) },
        builder.key
    )
}
