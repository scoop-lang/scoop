package scoop.ui.component

import scoop.graphics.*
import scoop.collections.HashMap
import scoop.ui.*
import scoop.ui.style.*

public open class LinearBuilder internal constructor(): ChildrenBuilder() {
    public var spacing: Double = 0.0
    public var alignment: CrossAlignment = CrossAlignment.Start
    public var justify: MainAlignment = MainAlignment.Start
    public var padding: Insets = Insets()
    public var logicalPadding: LogicalInsets? = None
    public var clip: Boolean = false
    private val options = HashMap<Long, FlexItemOptions>()

    public fun item(content: View, configure: FlexItemBuilder.() -> Unit = {}): Unit {
        val value = flexItem(content, configure)
        val index = childCount
        add(content)
        options.put(index, value.options)
    }
    internal fun snapshot(): LinearProps {
        val children = childrenSnapshot()
        return LinearProps(
            Array<FlexItem>(children.size) {
                index -> FlexItem(children[index], options[index] ?: FlexItemOptions())
            },
            spacing,
            alignment,
            justify,
            padding,
            clip,
            logicalPadding
        )
    }
}

public class StackBuilder internal constructor(): ChildrenBuilder() {
    public var alignment: Alignment = Alignment()
    internal fun snapshot(): StackProps = StackProps(childrenSnapshot(), alignment)
}

internal fun makeRow(configure: LinearBuilder.() -> Unit): View {
    val builder = LinearBuilder()
    builder.configure()
    return component(builder.snapshot(), { props -> Row(props) }, builder.key)
}

internal fun makeColumn(configure: LinearBuilder.() -> Unit): View {
    val builder = LinearBuilder()
    builder.configure()
    return component(builder.snapshot(), { props -> Column(props) }, builder.key)
}

internal fun makeStack(configure: StackBuilder.() -> Unit): View {
    val builder = StackBuilder()
    builder.configure()
    return component(builder.snapshot(), { props -> Stack(props) }, builder.key)
}
