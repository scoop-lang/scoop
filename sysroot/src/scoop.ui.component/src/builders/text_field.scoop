package scoop.ui.component

import scoop.graphics.text.*
import scoop.time.Duration
import scoop.ui.*
import scoop.ui.style.ThemeSource
import scoop.ui.text.*
import scoop.window.TextInputPurpose

public open class InputBuilder internal constructor() {
    public var label: String = ""
    public var placeholder: String = ""
    public var enabled: Boolean = true
    public var readOnly: Boolean = false
    public var invalid: Boolean = false
    public var description: String = ""
    public var fonts: FontCollection? = None
    public var style: TextFieldStyle = textFieldStyle()
    public var theme: ThemeSource? = None
    public var focus: FocusOptions = FocusOptions()
    public var labelTarget: FieldTarget? = None
    public var group: GroupPosition? = None
    public var chrome: TextFieldChrome = TextFieldChrome.Framed
    public var direction: TextDirection? = None
    public var alignment: TextAlignment = TextAlignment.Start
    public var paintCache: PaintCachePolicy = PaintCachePolicy.None
    public var caretBlink: Duration? = None
    public var policy: TextEditPolicy = textEditPolicy()
    public var projection: TextProjection = textProjection()
    public var copy: TextCopyPolicy = TextCopyPolicy.Default
    public var protectedText: Boolean = false
    public var inputPurpose: TextInputPurpose = TextInputPurpose.Normal
    public var softwareKeyboard: Boolean = true
    public var primarySelection: TextPrimarySelectionOptions = TextPrimarySelectionOptions()
    public var automaticTextReplacement: Boolean = false
    public var acceptDrops: Boolean = true
    public var drag: TextDragOptions = TextDragOptions()
    public var touch: TextTouchOptions = TextTouchOptions()
    public var touchScroll: TouchScrollOptions = TouchScrollOptions()
    public var scrollPhysics: ScrollPhysicsOptions = ScrollPhysicsOptions()
    public var contextMenu: TextContextMenuOptions = TextContextMenuOptions()
    public var onEdited: (TextEditorState) -> Unit = { _ -> Unit }
    public var onSubmit: (TextEditorState) -> Unit = { _ -> Unit }
    public var key: ViewKey = ViewKey.Position
    public var semantics: ComponentSemantics = ComponentSemantics()
    public var expansion: TextFieldExpansion? = None

    public fun style(configure: TextFieldStyleBuilder.() -> Unit): Unit {
        style = style.copy(configure)
    }
    public fun focus(configure: FocusOptionsBuilder.() -> Unit): Unit {
        focus = focus.copy(configure)
    }
    public fun contextMenu(configure: TextContextMenuOptionsBuilder.() -> Unit): Unit {
        contextMenu = contextMenu.copy(configure)
    }
    internal fun inputProps(state: TextEditorState): InputProps = InputProps(
        state,
        placeholder,
        enabled,
        readOnly,
        invalid,
        description,
        fonts,
        style,
        theme,
        focus,
        direction,
        alignment,
        paintCache,
        caretBlink,
        onEdited,
        onSubmit,
        policy,
        projection,
        copy,
        labelTarget,
        group,
        chrome,
        contextMenu,
        protectedText,
        semantics,
        acceptDrops,
        drag,
        touch,
        touchScroll,
        scrollPhysics,
        expansion,
        inputPurpose,
        softwareKeyboard,
        primarySelection,
        automaticTextReplacement,
        label
    )
}

public class TextareaBuilder internal constructor() : InputBuilder() {
    public var rows: Long = 4L
    public var wrap: Boolean = true
    public var tab: TextTabBehavior = TextTabBehavior.Navigate
    public var submit: TextSubmitKeys = TextSubmitKeys.PrimaryEnter
    public var scrollbars: ScrollbarVisibility = ScrollbarVisibility.Auto
    public var scrollbarBehavior: ScrollbarBehavior = scrollbarBehavior()
        .copy { placement = ScrollbarPlacement.Gutter }

    public fun scrollbarBehavior(configure: ScrollbarBehaviorBuilder.() -> Unit): Unit {
        scrollbarBehavior = scrollbarBehavior.copy(configure)
    }

    internal fun textareaProps(state: TextEditorState): TextareaProps = TextareaProps(
        state,
        placeholder,
        rows,
        wrap,
        tab,
        submit,
        enabled,
        readOnly,
        invalid,
        description,
        fonts,
        style,
        theme,
        focus,
        direction,
        alignment,
        scrollbars,
        paintCache,
        caretBlink,
        onEdited,
        onSubmit,
        policy,
        projection,
        copy,
        labelTarget,
        group,
        chrome,
        contextMenu,
        scrollbarBehavior,
        protectedText,
        semantics,
        acceptDrops,
        drag,
        touch,
        touchScroll,
        scrollPhysics,
        inputPurpose,
        softwareKeyboard,
        primarySelection,
        automaticTextReplacement,
        label
    )
}

internal fun makeInput(state: TextEditorState, configure: InputBuilder.() -> Unit): View {
    val builder = InputBuilder()
    builder.configure()
    return component(
        builder.inputProps(state),
        { props, mount -> Input(props, scope = mount) },
        builder.key
    )
}

internal fun makeTextarea(state: TextEditorState, configure: TextareaBuilder.() -> Unit): View {
    val builder = TextareaBuilder()
    builder.configure()
    return component(
        builder.textareaProps(state),
        { props, mount -> Textarea(props, scope = mount) },
        builder.key
    )
}
