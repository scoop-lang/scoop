package scoop.ui.component

import scoop.graphics.*
import scoop.graphics.text.StyledText
import scoop.ui.*
import scoop.ui.portal as makePortal
import scoop.ui.direction as makeDirection
import scoop.ui.style.StyledBuilder
import scoop.ui.style.styled as makeStyled
import scoop.ui.text.TextEditorState
import scoop.window.ShortcutChord
import scoop.window.ShortcutLabel

/** Collects one ordered child sequence; members append exactly once. */
public open class ChildrenBuilder internal constructor() {
    private val entries = ArrayList<View>()
    internal val childCount: Long get() = entries.size
    public var key: ViewKey = ViewKey.Position

    public fun add(view: View): Unit {
        entries.add(view)
    }
    public fun addAll(views: Array<View>): Unit {
        for (view in views)
            add(view)
    }
    internal fun childrenSnapshot(): Array<View> = entries.toArray()

    public fun label(text: String, configure: PlainLabelBuilder.() -> Unit = {}): Unit {
        add(makePlainLabel(text, configure))
    }

    public fun fieldLabel(
        text: String,
        target: FieldTarget,
        configure: FieldLabelBuilder.() -> Unit = {}
    ): Unit {
        add(makeFieldLabel(FieldLabelContent.Text(LabelText.Plain(text, None)), target, configure))
    }
    public fun fieldLabel(
        text: StyledText,
        target: FieldTarget,
        configure: FieldLabelBuilder.() -> Unit = {}
    ): Unit {
        add(makeFieldLabel(FieldLabelContent.Text(LabelText.Styled(text)), target, configure))
    }
    public fun fieldLabel(
        content: View,
        target: FieldTarget,
        configure: FieldLabelBuilder.() -> Unit = {}
    ): Unit {
        add(makeFieldLabel(FieldLabelContent.Custom(content), target, configure))
    }

    public fun field(control: View, configure: FieldBuilder.() -> Unit = {}) {
        add(makeField(control, configure))
    }
    public fun fieldGroup(configure: FieldStackBuilder.() -> Unit = {}) {
        add(makeFieldStack(FieldStackKind.Group, configure))
    }
    public fun fieldContent(configure: FieldStackBuilder.() -> Unit = {}) {
        add(makeFieldStack(FieldStackKind.Content, configure))
    }
    public fun fieldSet(content: View, configure: FieldSetBuilder.() -> Unit = {}) {
        add(makeFieldSet(content, configure))
    }
    public fun fieldTitle(content: String, configure: FieldTextBuilder.() -> Unit = {}) {
        add(makeFieldText(fieldPlain(content), FieldTextRole.Title, configure))
    }
    public fun fieldTitle(content: StyledText, configure: FieldTextBuilder.() -> Unit = {}) {
        add(makeFieldText(fieldStyled(content), FieldTextRole.Title, configure))
    }
    public fun fieldTitle(content: View, configure: FieldTextBuilder.() -> Unit = {}) {
        add(makeFieldText(PanelContent.Custom(content), FieldTextRole.Title, configure))
    }
    public fun fieldDescription(content: String, configure: FieldTextBuilder.() -> Unit = {}) {
        add(makeFieldText(fieldPlain(content), FieldTextRole.Description, configure))
    }
    public fun fieldDescription(content: StyledText, configure: FieldTextBuilder.() -> Unit = {}) {
        add(makeFieldText(fieldStyled(content), FieldTextRole.Description, configure))
    }
    public fun fieldDescription(content: View, configure: FieldTextBuilder.() -> Unit = {}) {
        add(makeFieldText(PanelContent.Custom(content), FieldTextRole.Description, configure))
    }
    public fun fieldLegend(content: String, configure: FieldLegendBuilder.() -> Unit = {}) {
        add(makeFieldLegend(fieldPlain(content), configure))
    }
    public fun fieldLegend(content: StyledText, configure: FieldLegendBuilder.() -> Unit = {}) {
        add(makeFieldLegend(fieldStyled(content), configure))
    }
    public fun fieldLegend(content: View, configure: FieldLegendBuilder.() -> Unit = {}) {
        add(makeFieldLegend(PanelContent.Custom(content), configure))
    }
    public fun fieldError(content: String, configure: FieldErrorBuilder.() -> Unit = {}) {
        add(makeFieldError([], Some(fieldPlain(content)), configure))
    }
    public fun fieldError(content: StyledText, configure: FieldErrorBuilder.() -> Unit = {}) {
        add(makeFieldError([], Some(fieldStyled(content)), configure))
    }
    public fun fieldError(content: View, configure: FieldErrorBuilder.() -> Unit = {}) {
        add(makeFieldError([], Some(PanelContent.Custom(content)), configure))
    }
    public fun fieldSeparator(content: String, configure: FieldSeparatorBuilder.() -> Unit = {}) {
        add(makeFieldSeparator(Some(fieldPlain(content)), configure))
    }
    public fun fieldSeparator(
        content: StyledText,
        configure: FieldSeparatorBuilder.() -> Unit = {}
    ) {
        add(makeFieldSeparator(Some(fieldStyled(content)), configure))
    }
    public fun fieldSeparator(content: View, configure: FieldSeparatorBuilder.() -> Unit = {}) {
        add(makeFieldSeparator(Some(PanelContent.Custom(content)), configure))
    }
    public fun fieldError(errors: Array<String>, configure: FieldErrorBuilder.() -> Unit = {}) {
        add(makeFieldError(errors, None, configure))
    }
    public fun fieldSeparator(configure: FieldSeparatorBuilder.() -> Unit = {}) {
        add(makeFieldSeparator(None, configure))
    }

    public fun imageView(
        image: Image,
        naturalSize: Size,
        configure: ImageViewBuilder.() -> Unit = {}
    ): Unit {
        add(makeImageView(image, naturalSize, configure))
    }
    public fun pathView(
        path: Path,
        viewBox: Rect,
        configure: PathViewBuilder.() -> Unit = {}
    ): Unit {
        add(makePathView(path, viewBox, configure))
    }

    public fun selectableStyledText(
        content: StyledText,
        configure: SelectableStyledTextBuilder.() -> Unit = {}
    ): Unit {
        add(makeSelectableStyledText(content, configure))
    }

    public fun label(content: StyledText, configure: StyledLabelBuilder.() -> Unit = {}): Unit {
        add(makeStyledLabel(content, configure))
    }

    public fun slider(
        values: Binding<Array<Double>>,
        range: RangeSpec,
        configure: SliderBuilder.() -> Unit = {}
    ): Unit {
        add(makeSlider(values, range, configure))
    }

    public fun inputGroup(configure: InputGroupBuilder.() -> Unit): Unit {
        add(makeInputGroup(configure))
    }

    public fun <T: Equals<T>> radioGroup(
        selected: Binding<T?>,
        configure: RadioGroupBuilder<T>.() -> Unit = {}
    ): Unit {
        add(makeRadioGroup(selected, configure))
    }
    public fun <T: Equals<T>> toggleGroup(
        selected: Binding<T?>,
        configure: ToggleGroupBuilder<T>.() -> Unit = {}
    ): Unit {
        add(makeToggleGroup(ToggleGroupSelection.Single(selected), configure))
    }
    public fun <T: Equals<T>> toggleGroup(
        selected: Binding<Array<T>>,
        configure: ToggleGroupBuilder<T>.() -> Unit = {}
    ): Unit {
        add(makeToggleGroup(ToggleGroupSelection.Multiple(selected), configure))
    }

    public fun button(
        text: String,
        onClick: () -> Unit,
        configure: ButtonBuilder.() -> Unit = {}
    ): Unit {
        add(makeTextButton(text, onClick, configure))
    }

    public fun button(
        text: StyledText,
        onClick: () -> Unit,
        configure: StyledButtonBuilder.() -> Unit = {}
    ): Unit {
        add(makeStyledButton(text, onClick, configure))
    }

    public fun button(
        content: View,
        onClick: () -> Unit,
        configure: ContentButtonBuilder.() -> Unit = {}
    ): Unit {
        add(makeContentButton(content, onClick, configure))
    }

    public fun button(
        content: (ActionContentStyle) -> View,
        onClick: () -> Unit,
        configure: ContentButtonBuilder.() -> Unit = {}
    ): Unit {
        add(makeResolvedButton(content, onClick, configure))
    }
    public fun buttonGroup(configure: ButtonGroupBuilder.() -> Unit): Unit {
        add(makeButtonGroup(configure))
    }
    public fun badge(text: String, configure: BadgeBuilder.() -> Unit = {}): Unit {
        add(makeTextBadge(text, configure))
    }
    public fun badge(text: StyledText, configure: StyledBadgeBuilder.() -> Unit = {}): Unit {
        add(makeStyledBadge(text, configure))
    }
    public fun badge(content: View, configure: ContentBadgeBuilder.() -> Unit = {}): Unit {
        add(makeContentBadge(content, configure))
    }
    public fun badge(
        content: (ActionContentStyle) -> View,
        configure: ContentBadgeBuilder.() -> Unit = {}
    ): Unit {
        add(makeResolvedBadge(content, configure))
    }
    public fun spinner(configure: SpinnerBuilder.() -> Unit = {}): Unit {
        add(makeSpinner(configure))
    }

    public fun avatar(fallback: String, configure: AvatarBuilder.() -> Unit = {}): Unit {
        add(makeAvatar(PanelContent.Label(LabelProps(LabelText.Plain(fallback, None))), configure))
    }
    public fun avatar(fallback: StyledText, configure: AvatarBuilder.() -> Unit = {}): Unit {
        add(makeAvatar(PanelContent.Label(LabelProps(LabelText.Styled(fallback))), configure))
    }
    public fun avatar(fallback: View, configure: AvatarBuilder.() -> Unit = {}): Unit {
        add(makeAvatar(PanelContent.Custom(fallback), configure))
    }
    public fun avatarGroup(
        size: AvatarSize = AvatarSize.Default,
        configure: AvatarGroupBuilder.() -> Unit
    ): Unit {
        add(makeAvatarGroup(size, configure))
    }
    public fun skeleton(configure: SkeletonBuilder.() -> Unit = {}): Unit {
        add(makeSkeleton(empty(), Some(16.0), configure))
    }
    public fun skeleton(content: View, configure: SkeletonBuilder.() -> Unit = {}): Unit {
        add(makeSkeleton(content, None, configure))
    }
    public fun progress(value: Double?, configure: ProgressBuilder.() -> Unit = {}): Unit {
        add(makeProgress(value, configure))
    }
    public fun progress(value: Double, configure: ProgressBuilder.() -> Unit = {}): Unit {
        add(makeProgress(Some(value), configure))
    }

    public fun typography(
        text: String,
        role: TypographyRole = TypographyRole.P,
        configure: TypographyBuilder.() -> Unit = {}
    ): Unit {
        add(makeTypography(TypographyContent.Plain(text), role, configure))
    }
    public fun typography(
        content: StyledText,
        role: TypographyRole = TypographyRole.P,
        configure: TypographyBuilder.() -> Unit = {}
    ): Unit {
        add(makeTypography(TypographyContent.Styled(content), role, configure))
    }
    public fun typography(
        role: TypographyRole = TypographyRole.P,
        configure: TypographyTextBuilder.() -> Unit
    ): Unit {
        add(makeTypographyText(role, configure))
    }
    public fun typographyList(configure: TypographyListBuilder.() -> Unit): Unit {
        add(makeTypographyList(configure))
    }
    public fun typographyTable(configure: TypographyTableBuilder.() -> Unit): Unit {
        add(makeTypographyTable(configure))
    }
    public fun kbd(text: String, configure: KbdBuilder.() -> Unit = {}): Unit {
        add(makeKbd(KbdContent.Text(text), false, configure))
    }
    public fun kbd(content: View, configure: KbdBuilder.() -> Unit = {}): Unit {
        add(makeKbd(KbdContent.Custom(content), false, configure))
    }
    public fun kbd(chord: ShortcutChord, configure: KbdBuilder.() -> Unit = {}): Unit {
        add(makeKbd(KbdContent.Chord(chord), false, configure))
    }
    public fun kbd(label: ShortcutLabel, configure: KbdBuilder.() -> Unit = {}): Unit {
        add(makeKbd(KbdContent.Label(label), false, configure))
    }
    public fun kbdGroup(chord: ShortcutChord, configure: KbdBuilder.() -> Unit = {}): Unit {
        add(makeKbd(KbdContent.Chord(chord), true, configure))
    }
    public fun kbdGroup(label: ShortcutLabel, configure: KbdBuilder.() -> Unit = {}): Unit {
        add(makeKbd(KbdContent.Label(label), true, configure))
    }
    public fun kbdGroup(configure: KbdGroupBuilder.() -> Unit): Unit {
        add(makeKbdGroup(configure))
    }

    public fun card(content: View, configure: CardBuilder.() -> Unit = {}): Unit {
        add(makeCard(content, configure))
    }
    public fun alert(content: View, configure: AlertBuilder.() -> Unit = {}): Unit {
        add(makeAlert(content, configure))
    }
    public fun emptyState(content: View, configure: EmptyStateBuilder.() -> Unit = {}): Unit {
        add(makeEmptyState(content, configure))
    }
    public fun separator(configure: SeparatorBuilder.() -> Unit = {}): Unit {
        add(makeSeparator(configure))
    }
    public fun contentItem(configure: ItemBuilder.() -> Unit = {}): Unit {
        add(makeItem(None, ItemSize.Default, configure))
    }
    public fun contentItem(content: View, configure: ItemBuilder.() -> Unit = {}): Unit {
        add(makeItem(Some(content), ItemSize.Default, configure))
    }
    public fun itemGroup(
        size: ItemSize = ItemSize.Default,
        configure: ItemGroupBuilder.() -> Unit
    ): Unit {
        add(makeItemGroup(size, configure))
    }
    public fun itemSeparator(configure: ItemSeparatorBuilder.() -> Unit = {}): Unit {
        add(makeItemSeparator(configure))
    }
    public fun aspectRatio(
        content: View,
        ratio: Double,
        configure: AspectRatioBuilder.() -> Unit = {}
    ): Unit {
        add(makeAspectRatio(content, ratio, configure))
    }

    public fun checkbox(
        checked: Binding<CheckState>,
        configure: CheckboxBuilder.() -> Unit = {}
    ): Unit {
        add(makeCheckbox(checked, configure))
    }
    public fun switchControl(
        checked: Binding<Boolean>,
        configure: SwitchBuilder.() -> Unit = {}
    ): Unit {
        add(makeSwitch(checked, configure))
    }
    public fun toggle(
        text: String,
        pressed: Binding<Boolean>,
        configure: ToggleBuilder.() -> Unit = {}
    ): Unit {
        add(makeTextToggle(text, pressed, configure))
    }
    public fun toggle(
        text: StyledText,
        pressed: Binding<Boolean>,
        configure: StyledToggleBuilder.() -> Unit = {}
    ): Unit {
        add(makeStyledToggle(text, pressed, configure))
    }
    public fun toggle(
        content: View,
        pressed: Binding<Boolean>,
        configure: ContentToggleBuilder.() -> Unit = {}
    ): Unit {
        add(makeContentToggle(ButtonContent.Custom(content), pressed, configure))
    }
    public fun toggle(
        content: (ActionContentStyle) -> View,
        pressed: Binding<Boolean>,
        configure: ContentToggleBuilder.() -> Unit = {}
    ): Unit {
        add(makeContentToggle(ButtonContent.Resolved(content), pressed, configure))
    }

    public fun checkbox(
        checked: Binding<Boolean>,
        configure: CheckboxBuilder.() -> Unit = {}
    ): Unit {
        add(makeCheckbox(checked, configure))
    }

    public fun checkbox(
        initialChecked: Boolean = false,
        configure: CheckboxBuilder.() -> Unit = {}
    ): Unit {
        add(makeOwnedCheckbox(initialChecked, configure))
    }

    public fun input(state: TextEditorState, configure: InputBuilder.() -> Unit = {}): Unit {
        add(makeInput(state, configure))
    }

    public fun inputOtp(
        state: TextEditorState,
        length: Long,
        configure: InputOtpBuilder.() -> Unit = {}
    ): Unit {
        add(makeInputOtp(state, length, configure))
    }

    public fun textarea(state: TextEditorState, configure: TextareaBuilder.() -> Unit = {}): Unit {
        add(makeTextarea(state, configure))
    }

    public fun row(configure: LinearBuilder.() -> Unit = {}): Unit {
        add(makeRow(configure))
    }

    public fun column(configure: LinearBuilder.() -> Unit = {}): Unit {
        add(makeColumn(configure))
    }

    public fun flex(configure: FlexBuilder.() -> Unit = {}): Unit {
        add(makeFlex(configure))
    }

    public fun wrap(configure: WrapBuilder.() -> Unit = {}): Unit {
        add(makeWrap(configure))
    }

    public fun grid(configure: GridBuilder.() -> Unit = {}): Unit {
        add(makeGrid(configure))
    }

    public fun direction(
        content: View,
        value: LayoutDirection,
        key: ViewKey = ViewKey.Position
    ): Unit {
        add(makeDirection(content, value, key))
    }

    public fun stack(configure: StackBuilder.() -> Unit = {}): Unit {
        add(makeStack(configure))
    }

    public fun frame(content: View, configure: FrameBuilder.() -> Unit = {}): Unit {
        add(makeFrame(content, configure))
    }

    public fun absolute(configure: AbsoluteBuilder.() -> Unit = {}): Unit {
        add(makeAbsolute(configure))
    }

    public fun scrollArea(content: View, configure: ScrollAreaBuilder.() -> Unit = {}): Unit {
        add(makeScrollArea(content, configure))
    }

    public fun virtualList(
        source: ItemSource,
        itemExtent: ItemExtent,
        configure: VirtualListBuilder.() -> Unit = {}
    ): Unit {
        add(makeVirtualList(source, itemExtent, configure))
    }

    public fun portal(
        open: Binding<Boolean>,
        content: View,
        configure: PortalBuilder.() -> Unit = {}
    ): Unit {
        add(makePortal(open, content, configure))
    }

    public fun styled(content: View, configure: StyledBuilder.() -> Unit = {}): Unit {
        add(makeStyled(content, configure))
    }
}
