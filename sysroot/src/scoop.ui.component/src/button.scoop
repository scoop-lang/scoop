package scoop.ui.component

import scoop.graphics.*
import scoop.graphics.text.*
import scoop.ui.*
import scoop.ui.style.*
import scoop.ui.text.InlineView
import scoop.window.accessibility.*

public enum ButtonContent {
    Label(LabelProps), Custom(View), Resolved((ActionContentStyle) -> View)
}

public class ButtonProps public constructor(
    public val content: ButtonContent,
    public val onClick: () -> Unit,
    public val enabled: Boolean = true,
    public val style: ButtonStyle = buttonStyle(),
    public val theme: ThemeSource? = None,
    public val focus: FocusOptions = FocusOptions(),
    public val invalid: Boolean = false,
    public val variant: ButtonVariant = ButtonVariant.Default,
    public val size: ButtonSize = ButtonSize.Default,
    public val group: GroupPosition? = None,
    public val labelTarget: FieldTarget? = None,
    public val semantics: ComponentSemantics = ComponentSemantics()
)

public class Button public constructor(
    private val props: Props<ButtonProps>,
    scope: ComponentScope
) : Component(scope) {
    private val button = ButtonControl({ props.value }, scope)
    public override fun onMount() {
        button.mount()
    }
    public override fun render(): View = button.render()
}

internal class ButtonControl(
    private val read: () -> ButtonProps,
    private val scope: ComponentScope,
    role: SemanticRole = SemanticRole.Button,
    private val semanticState: () -> SemanticProperties? = { None },
    private val semanticActions: () -> SemanticActions? = { None },
    private val semanticFallbackName: () -> String? = { None }
) {
    private val themes = ThemeAccess(scope)
    private val text = ActionTextStyle()
    private val click: () -> Unit = { read().onClick() }
    private val control = PressControl(scope, PressOptions(read().enabled), read().focus, click)
    private val semantics = createComponentSemantics(scope, role)
    init {
        when (semantics) {
            case Some(val handle) -> {
                handle.bindFocus(Some(control.focus))
                handle.mergeLabels = true
                scope.routeSemanticsChildren(Some(handle))
            }

            case None -> {}
        }
    }
    fun mount() {
        themes.mount(read().theme)
    }
    fun render(): View {
        val input = read()
        val theme = themes.read(input.theme)
        val interaction = control.press.interaction
        val shape = ActionShape.Button(input.size)
        val visual = SurfaceVisual(
            actionSurfaceKind(shape, input.variant, input.style.kind),
            interaction.asVisual(input.enabled, input.invalid),
            SurfaceRole.Control
        )
        val base = text
            .resolve(
                theme.tokens.typography.action,
                actionTextColor(theme, shape, input.variant, visual),
                input.style.text,
                actionFontScale(shape),
                actionLineHeight(shape)
            )
        return element(
            ActionInkProps(
                theme,
                shape,
                input.variant,
                input.style,
                visual,
                ActionBehavior.Press(control, click, input.focus),
                input.group,
                input.labelTarget,
                semantics = semantics,
                semanticOptions = input.semantics,
                semanticState = semanticState(),
                semanticActions = semanticActions(),
                semanticFallbackName = semanticFallbackName()
            ),
            { current, mount -> ActionInk(current, scope = mount) },
            [
                actionContent(
                    input.content,
                    actionContentStyle(base, shape, input.variant, visual.interaction)
                )
            ]
        )
    }
}

public fun button(
    text: String,
    onClick: () -> Unit,
    configure: ButtonBuilder.() -> Unit = {}
): View = makeTextButton(text, onClick, configure)

public fun button(
    text: StyledText,
    onClick: () -> Unit,
    configure: StyledButtonBuilder.() -> Unit = {}
): View = makeStyledButton(text, onClick, configure)

public fun button(
    content: View,
    onClick: () -> Unit,
    configure: ContentButtonBuilder.() -> Unit = {}
): View = makeContentButton(content, onClick, configure)

public fun button(
    content: (ActionContentStyle) -> View,
    onClick: () -> Unit,
    configure: ContentButtonBuilder.() -> Unit = {}
): View = makeResolvedButton(content, onClick, configure)
