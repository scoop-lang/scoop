package scoop.ui.component

import scoop.graphics.text.*
import scoop.ui.*
import scoop.ui.style.*
import scoop.ui.text.*

internal class TextFieldInput(
    val state: TextEditorState,
    val placeholder: String,
    val invalid: Boolean,
    val description: String,
    val fonts: FontCollection?,
    val style: TextFieldStyle,
    val theme: ThemeSource?,
    val focus: FocusOptions,
    val options: TextEditOptions,
    val rows: Long,
    val scrollbars: ScrollbarVisibility,
    val onEdited: (TextEditorState) -> Unit,
    val onSubmit: (TextEditorState) -> Unit,
    val labelTarget: FieldTarget?,
    val group: GroupPosition?,
    val chrome: TextFieldChrome
)

/** Shares composition while keeping the two public component identities distinct. */
internal class TextFieldRenderer(private val scope: ComponentScope) {
    private val themes = ThemeAccess()
    private val body = ActionTextStyle()
    private val hint = ActionTextStyle()
    private val description = ActionTextStyle()
    private val visual = state(TextEditInteraction())
    private val interactionChanged: (TextEditInteraction) -> Unit = { next -> visual.value = next }
    fun render(input: TextFieldInput): View {
        val snapshot = input.state.inputState
        val interaction = visual.value
        val fonts = input.fonts ?: scope.defaultFonts
        val visual =
            SurfaceVisual(
                SurfaceKind.Plain,
                InteractionVisual(
                    input.options.enabled,
                    interaction.hovered,
                    focusVisible = interaction.focusVisible,
                    invalid = input.invalid
                )
            )
        val theme = themes.read(input.theme)
        val palette = theme.tokens.palette
        val text =
            body.resolve(
                theme.tokens.typography.body,
                theme.surfaceTextColor(visual),
                input.style.text
            )
        val placeholder =
            hint.resolve(
                theme.tokens.typography.body,
                palette.muted.foreground,
                input.style.placeholder
            )
        val children: Array<View> =
            if (input.description.byteLength == 0L)
                []
            else
                [
                    component(
                        LabelProps(
                            LabelText.Plain(input.description, None),
                            input.fonts,
                            baseStyle =
                                Some(
                                    description.resolve(
                                        theme.tokens.typography.caption,
                                        if (!input.options.enabled)
                                            palette.disabledText
                                        else
                                            if (input.invalid)
                                                palette.destructive.background
                                            else
                                                palette.muted.foreground,
                                        input.style.description
                                    )
                                )
                        ),
                        { props, mount -> Label(props, scope = mount) }
                    )
                ]
        return element(
            TextFieldInkProps(
                input,
                theme,
                visual,
                textFieldOptions(input, theme, visual.interaction),
                text,
                placeholder,
                interactionChanged,
                fonts
            ),
            { props, mount -> TextFieldInk(props, scope = mount) },
            children
        )
    }
}

internal class TextFieldInkProps(
    val input: TextFieldInput,
    val theme: Theme,
    val visual: SurfaceVisual,
    val surface: SurfaceOptions,
    val text: TextStyle,
    val placeholder: TextStyle,
    val onInteractionChanged: (TextEditInteraction) -> Unit,
    val fonts: FontCollection
)

internal fun textFieldAppearance(
    input: TextFieldInput,
    theme: Theme,
    text: TextStyle,
    placeholder: TextStyle,
    fonts: FontCollection
): TextEditAppearance {
    val style = input.style
    val palette = theme.tokens.palette
    return TextEditAppearance(
        fonts,
        text,
        placeholder,
        style.selectionColor ?: palette.primary.background.withAlpha(0.30),
        style.inactiveSelectionColor ?: palette.muted.foreground.withAlpha(0.20),
        style.caretColor ?: palette.primary.background,
        style.markedColor ?: palette.primary.background,
        style.caretWidth
    )
}
