package scoop.ui.component

import scoop.graphics.*
import scoop.ui.style.*

public enum TextFieldChrome {
    Framed, Bare
}

internal fun textFieldOptions(
    input: TextFieldInput,
    theme: Theme,
    visual: InteractionVisual
): SurfaceOptions {
    var surface = input.style.options(visual)
    if (theme.tokens.textField == TextFieldTreatment.Outlined && surface.validation == None) {
        val error = theme.tokens.palette.destructive.background
        surface = surface
            .copy {
                validation = Some(
                    OutlineStyle(
                        error, if (visual.focusVisible || theme.preferences.highContrast)
                            2.0
                        else
                            1.0,
                        0.0, Some(error)
                    )
                )
            }
    }
    if (!input.options.multiline || surface.padding != None) return surface
    val density = theme.tokens.typography.body.fontSize / 14.0
    val padding = theme
        .surfaceMetrics(SurfaceVisual(SurfaceKind.Plain, visual, SurfaceRole.Input), surface)
        .padding
    return surface
        .copy {
            this.padding = Some(
                Insets(
                    lowerBound(10.0 * density, padding.left),
                    lowerBound(8.0 * density, padding.top),
                    lowerBound(10.0 * density, padding.right),
                    lowerBound(8.0 * density, padding.bottom)
                )
            )
        }
}

internal fun bareTextFieldMetrics(base: SurfaceMetrics): SurfaceMetrics {
    val border = base.borderInsets.totals()
    return SurfaceMetrics(
        Size(
            lowerBound(base.suggestedSize.width - border.width, 0.0),
            lowerBound(base.suggestedSize.height - border.height, 0.0)
        ),
        Size(
            lowerBound(base.minimumSize.width - border.width, 0.0),
            lowerBound(base.minimumSize.height - border.height, 0.0)
        ),
        base.padding,
        Insets(),
        CornerRadii(),
        0.0
    )
}

internal fun bareTextFieldGeometry(
    base: SurfaceGeometry,
    metrics: SurfaceMetrics
): SurfaceGeometry {
    val outline = RoundedOutline(base.bounds)
    val inset = metrics.padding
    return SurfaceGeometry(
        base.bounds,
        outline,
        outline,
        outline.inset(inset.left, inset.top, inset.right, inset.bottom).bounds,
        None,
        base.style.copy { this.corners = Corners.Physical(CornerRadii()) },
        1.0
    )
}
