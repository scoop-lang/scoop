package scoop.ui.component

import scoop.graphics.*
import scoop.graphics.text.*
import scoop.surface.*
import scoop.ui.*
import scoop.ui.style.*
import scoop.ui.text.*
import scoop.window.*
import scoop.window.accessibility.SemanticRole

internal class TextFieldInk(
    internal val props: Props<TextFieldInkProps>,
    scope: ComponentScope
): Element<TextFieldDrawing>(scope) {
    internal val fonts: FontCollection get() = props.value.fonts
    internal val host =
        scope.resource {
            val value = props.value
            TextEditHost(
                scope,
                value.input.state,
                textFieldAppearance(value.input, value.theme, value.text, value.placeholder, fonts),
                value.input.options,
                value.onInteractionChanged
            )
        }
    internal val lineHeight = TextFieldLineHeight()
    private val semantics = createComponentSemantics(scope, SemanticRole.TextField)
    private val padding = scope.createArea()
    private val field =
        scope.resource { FieldLink(scope, host.area, host.focus, semantics) { updateSemantics() } }
    internal val scrollbarFeedback =
        scope.resource {
            ScrollbarFeedback(scope, { scrollbarProps() }, host.area) { feedbackChanged() }
        }
    private val horizontal =
        ScrollBarControl(
            scope,
            { scrollbarProps() },
            host.area,
            Orientation.Horizontal,
            scrollbarFeedback,
            semantics
        ) { handle, orientation -> updateBar(handle, orientation) }
    private val vertical =
        ScrollBarControl(
            scope,
            { scrollbarProps() },
            host.area,
            Orientation.Vertical,
            scrollbarFeedback,
            semantics
        ) { handle, orientation -> updateBar(handle, orientation) }
    private val painters = scope.resource { ThemePainterCache() }
    private val content = scope.resource { StylePainter() }

    private fun updateBar(handle: SemanticsHandle, orientation: Orientation) {
        val value = scrollbarProps()
        handle.updateScrollBar(
            host,
            scrollSemanticOrientation(orientation),
            value.lineStep,
            scrollBarProperties(value, orientation)
        )
    }

    init {
        scope.routeChildren(host.area)
        scope.routeSemanticsChildren(semantics)
        padding.scope.parent = Some(host.area.scope)
        padding.scope.defaultAction =
            {
                context,
                event -> when (event) {
                    case Pointer(
                        InputPointerEvent.Button(_, MouseButton.Left, ElementState.Pressed, _)
                    ) -> {
                        host.focus.handle.requestFocus(FocusOrigin.Pointer)
                        context.consume()
                    }
                    else -> {}
                }
            }
    }
    private fun feedbackChanged() {
        horizontal.feedbackChanged()
        vertical.feedbackChanged()
        if (scope.isMounted)
            scope.requestFrame()
    }
    private fun appearance(): TextEditAppearance {
        val value = props.value
        return textFieldAppearance(value.input, value.theme, value.text, value.placeholder, fonts)
    }
    private fun scrollbarProps(): ScrollControlProps {
        val value = props.value
        return ScrollControlProps(
            host.scroll,
            if (value.input.options.wrap)
                ScrollAxes.Vertical
            else
                ScrollAxes.Both,
            value.text.fontSize,
            ScrollChain.Chain,
            value.input.scrollbars,
            value.input.style.scrollbar,
            value.input.options.enabled,
            value.input.focus,
            value.input.options.paintCache,
            value.theme,
            scrollbarBehavior = value.input.scrollbarBehavior
        )
    }
    public override fun update(): UiInvalidation {
        val value = props.value
        val input = value.input
        host.update(
            input.state,
            appearance(),
            input.options,
            input.focus,
            input.placeholder,
            input.onEdited,
            input.onSubmit
        )
        field.update(input.labelTarget, input.options.enabled)
        updateSemantics()
        padding.scope.enabled = input.options.enabled
        scrollbarFeedback.update()
        horizontal.update()
        vertical.update()
        painters.get(value.theme)
        return UiInvalidation.Layout
    }
    private fun updateSemantics() {
        val handle = semantics ?: return
        if (handle.isClosed)
            return
        val input = props.value.input
        val description =
            if (input.description.byteLength == 0L)
                None
            else
                Some(input.description)
        handle.updateTextEditor(
            host,
            input.semantics.properties(
                description = description,
                required = field.isRequired(handle),
                error =
                    if (input.invalid)
                        description
                    else
                        None
            ),
            field.relations(handle, input.semantics.relations)
        )
    }
    public override fun measure(context: MeasureContext, constraints: Constraints): LayoutResult<
        TextFieldDrawing
    > = measureTextField(this, context, constraints)
    public override fun scene(context: SceneContext, current: TextFieldDrawing) {
        val value = props.value
        val geometry = current.geometry
        when (semantics) {
            case Some(val handle) -> context.semantics(handle, geometry.bounds)
            case None -> {}
        }
        val painter = painters.get(value.theme)
        if (geometry.opacity < 1.0)
            context.saveLayer(geometry.opacity)
        if (value.input.chrome == TextFieldChrome.Framed)
            context.draw {
                paint -> painter.drawSurface(
                    paint.canvas,
                    geometry,
                    value.visual,
                    SurfaceLayer.Background
                )
            }
        context.place(padding, geometry.bounds)
        content.scene(context, geometry.bounds, geometry.contentStyle) {
            local ->
            local.translate(geometry.content.x, geometry.content.y)
            local.save()
            try {
                local.translate(current.viewport.x, current.viewport.y)
                host.scene(local, current.editor)
            } finally {
                local.restore()
            }
            scrollbarFeedback.scene(
                local,
                Rect(0.0, 0.0, geometry.content.width, geometry.content.height),
                current.horizontal,
                current.vertical
            )
            horizontal.scene(local, current.editor.scrollSnapshot, current.horizontal, painter)
            vertical.scene(local, current.editor.scrollSnapshot, current.vertical, painter)
        }
        if (value.input.chrome == TextFieldChrome.Framed)
            context.draw {
                paint -> painter.drawSurface(
                    paint.canvas,
                    geometry,
                    value.visual,
                    SurfaceLayer.Foreground
                )
            }
        if (geometry.opacity < 1.0)
            context.restore()
        context.children()
    }
}
