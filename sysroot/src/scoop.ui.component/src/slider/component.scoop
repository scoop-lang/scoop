package scoop.ui.component

import scoop.graphics.*
import scoop.surface.*
import scoop.ui.*
import scoop.ui.style.*

internal class SliderSlot {
    var area: InputArea? = None
    var focus: FocusTarget? = None
}

internal class SliderInput(
    val props: SliderProps,
    val values: Array<Double>,
    val theme: Theme,
    val slots: Array<SliderSlot>,
    val active: State<Long?>,
    val owner: State<SliderControl?>
)

public class Slider public constructor(private val props: Props<SliderProps>): Component {
    private val themes = ThemeAccess()
    private val active = state<Long?>(None)
    private val owner = state<SliderControl?>(None)
    private var slots: Array<SliderSlot> = []
    public override fun onMount(scope: ComponentScope) {
        themes.mount(props.value.theme)
    }
    public override fun render(): View {
        val input = props.value
        val values = input.values.value
        val theme = themes.read(input.theme)
        if (values.size != slots.size) {
            val previous = slots
            slots =
                Array<SliderSlot>(values.size) {
                    index -> if (index < previous.size)
                        previous[index]
                    else
                        SliderSlot()
                }
        }
        val config = SliderInput(input, values, theme, slots, active, owner)
        val children =
            Array<View>(values.size) {
                index -> element(
                    SliderThumbProps(config, index, active.value == Some(index)),
                    { current -> SliderThumb(current) },
                    key = ViewKey.Number(index)
                )
            }
        return element(config, { current -> SliderLayout(current) }, children)
    }
}

private class SliderLayout(private val props: Props<SliderInput>): Element {
    private var control: SliderControl? = None
    private var track: StylePainter? = None
    private var fill: StylePainter? = None
    private var geometry: SliderGeometry? = None
    public override fun onMount(scope: ComponentScope) {
        control = Some(SliderControl(scope, { props.value }))
        props.value.owner.value = control
        track = Some(scope.resource { StylePainter() })
        fill = Some(scope.resource { StylePainter() })
    }
    public override fun update() {
        control!!.update()
    }
    public override fun measure(context: MeasureContext, constraints: Constraints): LayoutMetrics {
        val input = props.value
        val style = input.props.style
        val density = input.theme.tokens.typography.body.fontSize / 14.0
        val horizontal = input.props.orientation == Orientation.Horizontal
        val maximum =
            if (horizontal)
                constraints.maxWidth
            else
                constraints.maxHeight
        val length = maximum ?: style.length ?: 160.0 * density
        val side = style.thumbSize ?: 12.0 * density
        val size =
            constraints.constrain(
                if (horizontal)
                    Size(length, side)
                else
                    Size(side, length)
            )
        val shape =
            sliderGeometry(input.props, input.values, input.theme, size, context.layoutDirection)
        for (index in 0L ..< context.childCount) {
            val rect = shape.thumbs[index]
            context.measureChild(index, Constraints.tight(Size(rect.width, rect.height)))
            context.placeChild(index, Point(rect.x, rect.y))
        }
        geometry = Some(shape)
        return LayoutMetrics(size)
    }
    public override fun scene(context: SceneContext) {
        val input = props.value
        val shape = geometry!!
        if (!input.props.enabled)
            context.saveLayer(input.theme.tokens.disabledOpacity)
        track!!.scene(
            context,
            shape.track,
            sliderPartStyle(input.theme.tokens.palette.muted.background, input.props.style.track)
        ) { _ -> }
        if (shape.fill.width > 0.0 && shape.fill.height > 0.0)
            fill!!.scene(
                context,
                shape.fill,
                sliderPartStyle(
                    input.theme.tokens.palette.primary.background,
                    input.props.style.range
                )
            ) { _ -> }
        val order = ArrayList<Long>()
        var top: Long? = None
        for (index in 0L ..< input.slots.size) {
            if (input.slots[index].area?.hasFocus ?: false)
                top = Some(index)
        }
        when (input.active.value) {
            case Some(index) -> top = Some(index);
            case None -> {}
        }
        for (index in 0L ..< input.slots.size)
            if (top != Some(index))
                order.add(index)
        when (top) {
            case Some(index) -> order.add(index);
            case None -> {}
        }
        control!!.place(context, shape)
        context.children(order.toArray())
        if (!input.props.enabled)
            context.restore()
        context.onFrameComplete {
            result -> if (result.submission == FrameSubmission.Accepted)
                control!!.accept(shape)
        }
    }
    public override fun onUnmount() {
        control!!.retire()
    }
}
