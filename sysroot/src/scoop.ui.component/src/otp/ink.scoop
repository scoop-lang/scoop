package scoop.ui.component

import scoop.charset.graphemeBoundaries
import scoop.graphics.*
import scoop.graphics.text.*
import scoop.ui.*
import scoop.ui.style.*
import scoop.ui.text.*
import scoop.window.TextInputPurpose
import scoop.window.accessibility.*

internal class OtpInk(internal val props: Props<OtpInkProps>, scope: ComponentScope): Element<
    OtpDrawing
>(scope) {
    private val projection = textProjection()
    internal val host =
        scope.resource {
            val value = props.value
            TextEditHost(
                scope,
                value.input.state,
                otpAppearance(value.input, value.theme, value.text, value.fonts),
                otpOptions(value.input, projection),
                value.onInteractionChanged
            )
        }
    private val semantics = createComponentSemantics(scope, SemanticRole.TextField)
    private val field =
        scope.resource { FieldLink(scope, host.area, host.focus, semantics) { updateSemantics() } }
    private val painters = scope.resource { ThemePainterCache() }

    init {
        scope.routeChildren(host.area)
        scope.routeSemanticsChildren(semantics)
    }

    public override fun update(): UiInvalidation {
        val input = props.value.input
        host.update(
            input.state,
            otpAppearance(input, props.value.theme, props.value.text, props.value.fonts),
            otpOptions(input, projection),
            input.focus,
            onEdited = { state -> props.value.input.onEdited(state) },
            onCommitted =
                {
                    state ->
                    val current = props.value.input
                    if (
                        state ===
                            current.state &&
                            graphemeBoundaries(state.text).size -
                            1L ==
                            current.length
                    )
                        current.onComplete(state)
                }
        )
        field.update(input.labelTarget, input.enabled)
        updateSemantics()
        painters.get(props.value.theme)
        return UiInvalidation.Layout
    }
    private fun updateSemantics() {
        val handle = semantics ?: return
        if (handle.isClosed)
            return
        val input = props.value.input
        handle.bindReference(input.semantics.reference)
        handle.updateTextEditor(
            host,
            input.semantics.properties(
                required = field.isRequired(handle),
                invalid = input.invalid
            ),
            field.relations(handle, input.semantics.relations)
        )
    }
    public override fun measure(context: MeasureContext, constraints: Constraints): LayoutResult<
        OtpDrawing
    > = measureOtp(this, context, constraints)
    public override fun scene(context: SceneContext, current: OtpDrawing) {
        val value = props.value
        when (semantics) {
            case Some(val handle) -> context.semantics(
                handle,
                Rect(0.0, 0.0, context.size.width, context.size.height)
            )
            case None -> {}
        }
        val painter = painters.get(value.theme)
        val adapter = host
        val offset = current.editor.scrollSnapshot.offset
        if (!value.input.enabled)
            context.saveLayer(value.theme.tokens.disabledOpacity)
        context.clipRect(Rect(0.0, 0.0, context.size.width, context.size.height))
        context.translate(current.origin.x, current.origin.y)
        context.draw {
            paint ->
            paint.canvas.translate(-offset.x, -offset.y)
            for (slot in current.slots)
                painter.drawSurface(
                    paint.canvas,
                    slot.geometry,
                    slot.visual,
                    SurfaceLayer.Background
                )
        }
        adapter.scene(context, current.editor)
        context.withState<Unit> {
            content ->
            val viewport = current.editor.scrollSnapshot.viewport
            content.clipRect(Rect(0.0, -current.origin.y, viewport.width, content.size.height))
            content.translate(-offset.x, -offset.y)
            content.children()
        }
        context.draw {
            paint ->
            paint.canvas.translate(-offset.x, -offset.y)
            for (index in 0L ..< current.slots.size)
                if (index != current.active)
                    painter.drawSurface(
                        paint.canvas,
                        current.slots[index].geometry,
                        current.slots[index].visual,
                        SurfaceLayer.Foreground
                    )
            val active = current.slots[current.active]
            painter.drawSurface(
                paint.canvas,
                active.geometry,
                active.visual,
                SurfaceLayer.Foreground
            )
        }
        if (!value.input.enabled)
            context.restore()
    }
}

internal fun otpAppearance(
    input: InputOtpProps,
    theme: Theme,
    text: TextStyle,
    fonts: FontCollection
): TextEditAppearance {
    val style = input.style
    val colors = theme.tokens.palette
    val selection = themeTextSelection(theme)
    return TextEditAppearance(
        fonts,
        text,
        text,
        style.selectionColor ?: selection.background,
        style.inactiveSelectionColor ?: selection.inactiveBackground,
        style.caretColor ?: colors.background.foreground,
        style.markedColor ?: colors.primary.background,
        style.caretWidth,
        theme.tokens.motion.preference == MotionPreference.Reduced,
        selectionTextColor =
            selectionTextColor(style.selectionTextColor, style.selectionColor, selection.text),
        inactiveSelectionTextColor =
            selectionTextColor(
                style.inactiveSelectionTextColor,
                style.inactiveSelectionColor,
                selection.inactiveText
            )
    )
}

internal fun otpOptions(input: InputOtpProps, projection: TextProjection): TextEditOptions =
    TextEditOptions(
        readOnly = input.readOnly,
        enabled = input.enabled,
        submit = TextSubmitKeys.None,
        caretBlink = input.caretBlink,
        policy = otpPolicy(input.pattern, input.length),
        projection = projection,
        contextMenu = input.contextMenu,
        protectedText = input.protectedText,
        acceptDrops = input.acceptDrops,
        drag = input.drag,
        touch = input.touch,
        touchScroll = input.touchScroll,
        scrollPhysics = input.scrollPhysics,
        inputPurpose =
            input.inputPurpose ?:
                when (input.pattern) {
                    case Digits -> TextInputPurpose.Digits
                    else -> TextInputPurpose.Normal
                },
        softwareKeyboard = input.softwareKeyboard,
        primarySelection = input.primarySelection,
        automaticTextReplacement = input.automaticTextReplacement
    )
