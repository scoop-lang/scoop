package scoop.ui.component

import scoop.ui.*
import scoop.ui.style.Orientation

/** Logical item indexes in a half-open interval, excluding overscan. */
public struct VirtualRange(val start: Long, val end: Long)

public struct VirtualReadingAnchor(val key: ViewKey, val offset: Double)

public struct VirtualReadingSnapshot(
    val visible: VirtualRange,
    val anchor: VirtualReadingAnchor?,
    val atEnd: Boolean
)

internal class VirtualItemAnchor(val key: ViewKey, val index: Long, val inside: Double)

internal class VirtualReadingPosition(
    val state: ScrollState,
    val orientation: Orientation,
    val revision: ULong,
    val anchor: VirtualItemAnchor?,
    val snapshot: VirtualReadingSnapshot
)

internal class VirtualListFrame(
    val props: VirtualListInkProps,
    val snapshot: ScrollSnapshot,
    val revision: ULong,
    val hasViewport: Boolean,
    val reading: VirtualReadingPosition,
    val request: ItemScrollRequest?,
    val requestDone: Boolean,
    val recheck: Boolean
)
