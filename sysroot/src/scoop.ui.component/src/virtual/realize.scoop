package scoop.ui.component

import scoop.collections.HashSet
import scoop.graphics.Point
import scoop.ui.*
import scoop.ui.style.Orientation

/** One synchronous measure pass. No context or mutable geometry escapes into a frame callback. */
internal class VirtualListLayout(
    private val context: LazyMeasureContext,
    constraints: Constraints,
    private val props: VirtualListInkProps,
    private val control: ScrollControl,
    private val measurements: VirtualMeasurements,
    previous: VirtualReadingPosition?,
    private val request: ItemScrollRequest?
) {
    private val input = props.input
    private val state = props.controls.state
    private val revision = state.requestRevision
    private val size = virtualViewport(constraints, input.width, input.height)
    private val vertical = input.orientation == Orientation.Vertical
    private val hasViewport = size.width > 0.0 && size.height > 0.0
    private val index =
        measurements.prepare(
            input.source,
            context.itemCount,
            input.itemExtent,
            input.orientation,
            if (vertical)
                size.width
            else
                size.height,
            context.layoutDirection
        )
    private val geometry =
        ListGeometry(index, input.orientation, input.overscan, size, context.layoutDirection)
    private val measured = HashSet<Long>()
    private val requestActive = request?.revision == Some(revision)
    private val destination: Long? =
        if (requestActive)
            virtualIndex(input.source, index.count, request!!.key)
        else
            None
    private val mayAnchor =
        when (previous) {
            case Some(value) -> value.state ===
                state &&
                value.orientation ==
                input.orientation &&
                value.revision ==
                revision &&
                !state.isAnimating
            case None -> false
        }
    private val followEnd =
        mayAnchor && input.anchor == VirtualListAnchor.FollowEnd && previous!!.snapshot.atEnd
    private val initialStart =
        geometry.reversed &&
            !state.hasPositionRequest &&
            when (previous) {
                case None -> !state.hasSnapshot || state.viewport.width == 0.0
                case Some(_) -> false
            }
    private val anchor: VirtualItemAnchor? =
        if (mayAnchor && !followEnd)
            previous!!.anchor
        else
            None
    private val anchorIndex: Long? =
        when (anchor) {
            case Some(value) -> if (index.count > 0L)
                Some(
                    virtualIndex(input.source, index.count, value.key) ?:
                        if (value.index < index.count)
                            value.index
                        else
                            index.count - 1L
                )
            else
                None
            case None -> None
        }

    fun measure(): VirtualListFrame {
        if (hasViewport) {
            when (destination) {
                case Some(at) -> ensure(at)
                case None -> when (anchorIndex) {
                    case Some(at) -> ensure(at)
                    case None -> {}
                }
            }
        }
        var changed = true
        while (changed) {
            changed = false
            for (at in context.pinnedItems)
                if (ensure(at))
                    changed = true
            var cursor = currentRange().start
            while (cursor < index.count) {
                val range = currentRange()
                if (cursor < range.start)
                    cursor = range.start
                if (cursor >= range.end)
                    break
                if (ensure(cursor))
                    changed = true
                cursor += 1L
            }
        }
        val layout = snapshot()
        val final = layout.snapshot
        val range = geometry.range(geometry.logicalOffset(final.offset))
        val pinned = HashSet<Long>()
        for (at in context.pinnedItems)
            pinned.add(at)
        var recheck = false
        for (at in measured) {
            val origin = geometry.origin(at)
            context.placeItem(at, Point(origin.x - final.offset.x, origin.y - final.offset.y))
            if ((at < range.start || at >= range.end) && !pinned.contains(at))
                recheck = true
        }
        val offset = geometry.logicalOffset(final.offset)
        val first = index.indexAt(offset)
        val nextAnchor =
            if (hasViewport && first < index.count)
                Some(
                    VirtualItemAnchor(
                        input.source.keyAt(first),
                        first,
                        lowerBound(offset - index.prefix(first), 0.0)
                    )
                )
            else
                None
        val reading =
            VirtualReadingPosition(
                state,
                input.orientation,
                revision,
                nextAnchor,
                VirtualReadingSnapshot(
                    geometry.visibleRange(offset),
                    when (nextAnchor) {
                        case Some(value) -> Some(VirtualReadingAnchor(value.key, value.inside))
                        case None -> None
                    },
                    offset == geometry.maximum
                )
            )
        val requestDone = requestActive && (destination == None || hasViewport)
        return VirtualListFrame(
            props,
            layout,
            revision,
            hasViewport,
            reading,
            request,
            requestDone,
            recheck
        )
    }
    private fun ensure(at: Long): Boolean {
        if (measured.contains(at))
            return false
        val metrics = context.measureItem(at, geometry.itemConstraints)
        measured.add(at)
        measurements.record(
            at,
            if (vertical)
                metrics.size.height
            else
                metrics.size.width
        )
        return true
    }
    private fun currentRange(): VirtualRange =
        geometry.range(geometry.logicalOffset(snapshot().snapshot.offset))
    private fun snapshot(): ScrollLayout {
        val base = control.layout(size, geometry.content)
        var adjustment: ScrollAdjustment? = None
        when (destination) {
            case Some(at) -> adjustment =
                Some(
                    ScrollAdjustment(
                        revision,
                        when (request!!.position) {
                            case Item(alignment) -> geometry.alignedOffset(
                                base.snapshot,
                                at,
                                alignment
                            )
                            case Reading(inside) -> geometry.scrollOffset(
                                index.prefix(at) + upperBound(inside, index.extent(at))
                            )
                        }
                    )
                )
            case None -> {
                if (followEnd)
                    adjustment =
                        Some(ScrollAdjustment(revision, geometry.scrollOffset(geometry.maximum)))
                else
                    when (anchorIndex) {
                        case Some(at) -> adjustment =
                            Some(
                                ScrollAdjustment(
                                    revision,
                                    geometry.scrollOffset(
                                        index.prefix(at) +
                                            upperBound(anchor!!.inside, index.extent(at))
                                    )
                                )
                            )
                        case None -> if (initialStart || mayAnchor)
                            adjustment =
                                Some(ScrollAdjustment(revision, geometry.scrollOffset(0.0)))
                    }
            }
        }
        return control.layout(size, geometry.content, adjustment)
    }
}
