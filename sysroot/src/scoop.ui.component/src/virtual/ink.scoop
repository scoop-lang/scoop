package scoop.ui.component

import scoop.surface.FrameSubmission
import scoop.ui.*
import scoop.ui.style.Orientation

internal class VirtualListInk(
    private val props: Props<VirtualListInkProps>,
    scope: ComponentScope
): LazyElement<VirtualListFrame>(scope) {
    private var control: ScrollControl? = None
    private var focus: LazyFocus? = None
    private var handle: VirtualListHandle? = None
    private var state: ScrollState? = None
    private val measurements = VirtualMeasurements()
    private var committed: VirtualReadingPosition? = None
    private var pending: ItemScrollRequest? = None

    val active: Boolean get() = scope.isMounted
    val scrollPending: Boolean get() =
        active && pending?.revision == Some(props.value.controls.state.requestRevision)
    val focusPending: Boolean get() = focus?.isPending ?: false
    fun focusItem(key: ViewKey, edge: ItemFocusEdge): Boolean {
        if (!active)
            return false
        pending = None
        return focus!!.requestFocus(key, edge)
    }
    fun requestItem(
        key: ViewKey,
        alignment: ScrollAlignment,
        margin: Double,
        previousPeek: Double
    ): Boolean {
        if (!active)
            return false
        return request(key, VirtualPosition.Item(alignment, margin, previousPeek))
    }
    fun restore(anchor: VirtualReadingAnchor): Boolean {
        if (!active)
            return false
        val source = props.value.input.source
        if (virtualIndex(source, source.count, anchor.key) == None)
            return false
        return request(anchor.key, VirtualPosition.Reading(anchor.offset))
    }
    private fun request(key: ViewKey, position: VirtualPosition): Boolean {
        val source = props.value.input.source
        val current = props.value.controls.state
        focus!!.cancelRequest()
        val revision = current.beginLayoutRequest()
        // Observers may close the list or issue a newer request synchronously.
        if (
            !active ||
                current.requestRevision !=
                revision ||
                props.value.controls.state !==
                current ||
                props.value.input.source !==
                source
        )
            return false
        pending = Some(ItemScrollRequest(key, position, revision, source))
        return true
    }
    public override fun onMount() {
        control = Some(ScrollControl(scope) { props.value.controls })
        focus = Some(scope.lazyFocus(control!!.viewport))
    }
    public override fun update(): UiInvalidation {
        val input = props.value
        itemEstimate(input.input.itemExtent)
        nonnegative(input.input.overscan, "invalid virtual overscan")
        when (input.input.endPadding) {
            case Fixed(length) -> nonnegative(length, "invalid virtual end padding")
            case FillViewport -> {}
        }
        control!!.update()
        focus!!.options =
            LazyFocusOptions(
                input.input.navigation,
                if (input.input.orientation == Orientation.Vertical)
                    NavigationLayout.Vertical
                else
                    NavigationLayout.Horizontal,
                input.input.focus.order
            )
        if (!input.input.enabled)
            focus!!.cancelRequest()
        val sameHandle =
            when ((handle, input.input.handle)) {
                case(Some(old), Some(next)) -> old === next
                case(None, None) -> true
                else -> false
            }
        if (!sameHandle) {
            input.input.handle?.bind(this)
            handle?.unbind(this)
            handle = input.input.handle
            pending = None
            focus!!.cancelRequest()
        }
        val sameState =
            when (state) {
                case Some(old) -> old === input.controls.state
                case None -> false
            }
        if (!sameState) {
            state = Some(input.controls.state)
            committed = None
            pending = None
            focus!!.cancelRequest()
        }
        when (pending) {
            case Some(value) -> when (value.position) {
                case Reading(_) -> if (value.source !== input.input.source)
                    pending = None
                case Item(_, _, _) -> {}
            }
            case None -> {}
        }
        return UiInvalidation.Layout
    }
    public override fun measure(
        context: LazyMeasureContext,
        constraints: Constraints
    ): LayoutResult<VirtualListFrame> {
        val item =
            when (focus!!.pendingItem) {
                case Some(key) -> Some(
                    ItemScrollRequest(
                        key,
                        VirtualPosition.Item(ScrollAlignment.Nearest, 0.0, 0.0),
                        props.value.controls.state.requestRevision,
                        props.value.input.source
                    )
                )
                case None -> pending
            }
        val frame =
            VirtualListLayout(
                context,
                constraints,
                props.value,
                control!!,
                measurements,
                committed,
                item
            ).measure()
        val drawing = frame
        return LayoutResult(LayoutMetrics(frame.snapshot.viewport), drawing)
    }
    public override fun scene(context: SceneContext, drawing: VirtualListFrame) {
        val frame = drawing
        control!!.scene(context, frame.layout, frame.snapshot.offset)
        context.onFrameComplete {
            result -> if (
                result.submission ==
                    FrameSubmission.Accepted &&
                    active &&
                    frame.reading.state ===
                    props.value.controls.state
            ) {
                handle?.publish(this, frame.reading.snapshot)
            }
        }
        context.onFrameComplete {
            result -> if (
                result.submission ==
                    FrameSubmission.Accepted &&
                    active &&
                    props.value ===
                    frame.props &&
                    frame.revision ==
                    props.value.controls.state.requestRevision
            ) {
                if (frame.hasViewport)
                    committed = Some(frame.reading)
                val sameRequest =
                    when ((pending, frame.request)) {
                        case(Some(current), Some(previous)) -> current === previous
                        else -> false
                    }
                if (sameRequest && frame.requestDone)
                    pending = None
                if (frame.recheck)
                    scope.requestLayout()
            }
        }
    }
    public override fun onUnmount() {
        handle?.unbind(this)
        handle = None
        pending = None
        committed = None
    }
}
