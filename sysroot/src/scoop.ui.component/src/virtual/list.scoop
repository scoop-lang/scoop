package scoop.ui.component

import scoop.ui.*
import scoop.ui.style.*

public class VirtualListProps public constructor(
    public val source: ItemSource,
    public val itemExtent: ItemExtent,
    public val state: ScrollState? = None,
    public val orientation: Orientation = Orientation.Vertical,
    public val overscan: Double = 0.0,
    public val width: Double? = None,
    public val height: Double? = None,
    public val lineStep: Double = 40.0,
    public val chain: ScrollChain = ScrollChain.Chain,
    public val scrollbars: ScrollbarVisibility = ScrollbarVisibility.Auto,
    public val scrollbar: ScrollbarOptions = scrollbarOptions(),
    public val enabled: Boolean = true,
    public val focus: FocusOptions = FocusOptions(),
    public val theme: ThemeSource? = None,
    public val handle: VirtualListHandle? = None,
    public val anchor: VirtualListAnchor = VirtualListAnchor.KeepVisible,
    public val retention: ItemRetention = ItemRetention.Dispose,
    public val navigation: ItemNavigation = ItemNavigation.None,
    public val paintCache: PaintCachePolicy = PaintCachePolicy.None,
    public val endPadding: VirtualListEndPadding = VirtualListEndPadding.Fixed(0.0)
)

/** Creates item subtrees only for the viewport, overscan and existing input sessions. */
public class VirtualList public constructor(
    private val props: Props<VirtualListProps>,
    scope: ComponentScope
): Component(scope) {
    private val local = ScrollState()
    private val themes = ThemeAccess()
    public override fun onMount() {
        themes.mount(props.value.theme)
    }
    public override fun render(): View {
        val input = props.value
        val axes =
            if (input.orientation == Orientation.Vertical)
                ScrollAxes.Vertical
            else
                ScrollAxes.Horizontal
        val controls =
            ScrollControlProps(
                input.state ?: local,
                axes,
                input.lineStep,
                input.chain,
                input.scrollbars,
                input.scrollbar,
                input.enabled,
                FocusOptions(
                    input.focus.handle,
                    input.focus.tabStop && input.navigation == ItemNavigation.None,
                    input.focus.order
                ),
                input.paintCache,
                themes.read(input.theme)
            )
        return lazyElement(
            input.source,
            VirtualListInkProps(input, controls),
            { value, mount -> VirtualListInk(value, scope = mount) },
            retention = input.retention
        )
    }
}

public fun virtualList(
    source: ItemSource,
    itemExtent: ItemExtent,
    configure: VirtualListBuilder.() -> Unit = {}
): View = makeVirtualList(source, itemExtent, configure)

internal class VirtualListInkProps(val input: VirtualListProps, val controls: ScrollControlProps)
