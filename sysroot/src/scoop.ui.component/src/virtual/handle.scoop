package scoop.ui.component

import scoop.platform.concurrent.currentThreadId
import scoop.ui.*

/** A stable reference to one mounted list; the associated ScrollState owns its position. */
public class VirtualListHandle public constructor() {
    private val thread = currentThreadId()
    private var target: VirtualListInk? = None
    private val snapshot = state<VirtualReadingSnapshot?>(None)

    private fun checkThread() {
        if (currentThreadId() != thread)
            throw IllegalStateException(Some("virtual list handle used from another thread"))
    }
    public val isAttached: Boolean get() {
        checkThread()
        return target?.active ?: false
    }
    public val isPending: Boolean get() {
        checkThread()
        return (target?.scrollPending ?: false) || (target?.focusPending ?: false)
    }
    public val reading: VirtualReadingSnapshot? get() {
        checkThread()
        return snapshot.value
    }
    public fun restore(anchor: VirtualReadingAnchor): Boolean {
        checkThread()
        requireComponent(
            anchor.key != ViewKey.Position,
            "reading restoration requires an explicit key"
        )
        nonnegative(anchor.offset, "invalid reading offset")
        return target?.restore(anchor) ?: false
    }
    public fun scrollToItem(
        key: ViewKey,
        alignment: ScrollAlignment = ScrollAlignment.Nearest,
        margin: Double = 0.0,
        previousItemPeek: Double = 0.0
    ): Boolean {
        checkThread()
        requireComponent(
            key != ViewKey.Position,
            "virtual item positioning requires an explicit key"
        )
        nonnegative(margin, "invalid virtual positioning margin")
        nonnegative(previousItemPeek, "invalid virtual previous item peek")
        return target?.requestItem(key, alignment, margin, previousItemPeek) ?: false
    }
    public fun focusItem(key: ViewKey, edge: ItemFocusEdge = ItemFocusEdge.First): Boolean {
        checkThread()
        requireComponent(key != ViewKey.Position, "virtual item focus requires an explicit key")
        return target?.focusItem(key, edge) ?: false
    }
    internal fun bind(value: VirtualListInk) {
        checkThread()
        when (target) {
            case Some(current) -> requireComponent(
                current === value || !current.active,
                "virtual list handle already has a target"
            )
            case None -> {}
        }
        target = Some(value)
        replaceSnapshot(None)
    }
    internal fun unbind(value: VirtualListInk) {
        checkThread()
        when (target) {
            case Some(current) -> if (current === value) {
                target = None
                replaceSnapshot(None)
            }
            case None -> {}
        }
    }
    internal fun publish(owner: VirtualListInk, value: VirtualReadingSnapshot) {
        checkThread()
        when (target) {
            case Some(current) -> if (current === owner && current.active)
                replaceSnapshot(Some(value))
            case None -> {}
        }
    }
    private fun replaceSnapshot(value: VirtualReadingSnapshot?) {
        if (snapshot.value != value)
            snapshot.value = value
    }
}

internal enum VirtualPosition {
    Item(val alignment: ScrollAlignment, val margin: Double, val previousPeek: Double),
    Reading(val offset: Double)
}

internal class ItemScrollRequest(
    val key: ViewKey,
    val position: VirtualPosition,
    val revision: ULong,
    val source: ItemSource
)
