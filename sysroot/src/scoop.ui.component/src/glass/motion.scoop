package scoop.ui.component

import scoop.collections.HashMap
import scoop.graphics.*
import scoop.surface.*
import scoop.ui.*

/** One progress value keeps all geometry and foreground layout on the same frame sample. */
internal class GlassShapeMotion(private val progress: Animatable<Double>, initial: RoundedOutline) :
    Closeable {
    private var origin = initial.normalized()
    private var target = origin
    val settled: Boolean get() = progress.value == 1.0
    fun retarget(outline: RoundedOutline, animation: AnimationSpec?) {
        val next = outline.normalized()
        if (next != target) {
            origin = sample()
            target = next
            progress.snapTo(0.0)
        }
        changeProgress(progress, 1.0, animation)
    }
    fun sample(): RoundedOutline {
        val amount = upperBound(lowerBound(progress.value, 0.0), 1.0)
        val from = origin.bounds
        val to = target.bounds
        return RoundedOutline(
            Rect(
                glassLerp(from.x, to.x, amount), glassLerp(from.y, to.y, amount),
                glassLerp(from.width, to.width, amount), glassLerp(from.height, to.height, amount)
            ),
            CornerRadii(
                glassLerp(origin.radii.topLeft, target.radii.topLeft, amount),
                glassLerp(origin.radii.topRight, target.radii.topRight, amount),
                glassLerp(origin.radii.bottomRight, target.radii.bottomRight, amount),
                glassLerp(origin.radii.bottomLeft, target.radii.bottomLeft, amount)
            )
        )
            .normalized()
    }
    public override fun close() {
        progress.close()
    }
}

private fun glassLerp(from: Double, to: Double, amount: Double): Double = from *
    (1.0 - amount) +
    to *
    amount

private fun glassLerp(from: Size, to: Size, amount: Double): Size = Size(
    glassLerp(from.width, to.width, amount),
    glassLerp(from.height, to.height, amount)
)

internal class GlassEffectMotions : Closeable {
    private val values = HashMap<ViewKey, GlassMotionEntry>()
    private var presented = false
    fun sample(key: ViewKey): RoundedOutline = values[key]!!.motion.sample()
    fun update(scope: ComponentScope, items: Array<GlassEffectItem>, animation: AnimationSpec?) {
        synchronize(Array<ViewKey>(items.size) { index -> items[index].key }, animation)
        for (item in items)
            when (item.bounds) {
                case Some(val bounds) ->
                    retarget(scope, item.key, RoundedOutline(bounds, item.corners), animation)
                case None -> {}
            }
    }
    fun synchronize(keys: Array<ViewKey>, animation: AnimationSpec?) {
        val next = HashMap<ViewKey, Boolean>()
        for (key in keys) {
            next[key] = true
            when (values[key]) {
                case Some(val existing) -> existing.leaving = false
                case None -> {}
            }
        }
        for (entry in values.entries) {
            val value = entry.value
            if (!next.containsKey(entry.key) && !value.leaving) {
                value.leaving = true
                value.motion.retarget(collapsedGlass(value.motion.sample()), animation)
            } else if (value.leaving && !panelPresent(animation))
                value.motion.retarget(collapsedGlass(value.motion.sample()), None)
        }
    }
    fun retarget(
        scope: ComponentScope,
        key: ViewKey,
        outline: RoundedOutline,
        animation: AnimationSpec?
    ): RoundedOutline {
        val entry = when (values[key]) {
            case Some(val existing) -> existing

            case None -> {
                val created = GlassMotionEntry(
                    GlassShapeMotion(
                        scope.animation(1.0),
                        if (presented && panelPresent(animation))
                            collapsedGlass(outline)
                        else
                            outline
                    )
                )
                values[key] = created
                created
            }
        }
        entry.motion.retarget(outline, animation)
        return entry.motion.sample()
    }
    fun outlines(keys: Array<ViewKey>): Array<RoundedOutline> {
        val result = ArrayList<RoundedOutline>()
        for (key in keys)
            result.add(sample(key))
        val retired = ArrayList<ViewKey>()
        for (entry in values.entries)
            if (entry.value.leaving) {
                if (entry.value.motion.settled)
                    retired.add(entry.key)
                else
                    result.add(entry.value.motion.sample())
            }
        for (key in retired) {
            values[key]!!.motion.close()
            values.remove(key)
        }
        presented = true
        return result.toArray()
    }
    fun clear() {
        for (entry in values.entries)
            entry.value.motion.close()
        values.clear()
        presented = false
    }
    public override fun close() {
        clear()
    }
}

private class GlassMotionEntry(val motion: GlassShapeMotion) {
    var leaving = false
}

internal fun collapsedGlass(outline: RoundedOutline): RoundedOutline = RoundedOutline(
    Rect(
        outline.bounds.x + outline.bounds.width * 0.5,
        outline.bounds.y + outline.bounds.height * 0.5,
        0.0,
        0.0
    )
)
