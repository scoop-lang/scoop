package scoop.ui.component

import scoop.ui.*

/** Creates the input resources before the owner's first render. */
internal class PressControl(
    scope: ComponentScope,
    options: PressOptions,
    focusOptions: FocusOptions,
    onClick: () -> Unit
) {
    val area = scope.createArea(focusable = true)
    val focus = scope.focusTarget(area, focusOptions)
    val press = scope.press(area, options, onClick)
    init {
        scope.routeChildren(area)
    }
}
