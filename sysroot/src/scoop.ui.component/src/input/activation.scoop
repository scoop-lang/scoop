package scoop.ui.component

import scoop.surface.*
import scoop.ui.*
import scoop.window.*

internal struct InteractionState(
    val hovered: Boolean = false,
    val pressed: Boolean = false,
    val focused: Boolean = false
)

/** One pointer or keyboard activation sequence, using the committed Surface hover path. */
internal class Activation(private val acceptsEnter: Boolean) {
    val visual = state(InteractionState())
    private var enabled = true
    private var hovered = false
    private var focused = false
    private var pointer = false
    private var key: PhysicalKey? = None

    fun update(accepts: Boolean) {
        enabled = accepts
        if (!accepts) {
            hovered = false;
            focused = false;
            cancel()
        }
        publish()
    }
    fun handle(
        area: InputArea,
        context: RoutedEventContext,
        event: InputEvent,
        activate: () -> Unit
    ) {
        if (context.phase == RoutedPhase.Notification) {
            when (event) {
                case FocusChanged(value) -> {
                    focused = value && enabled
                    if (!focused)
                        cancel()
                }
                case Pointer(InputPointerEvent.Cancelled(_, _)) -> pointer = false
                case Pointer(InputPointerEvent.Entered(_)) -> hovered = enabled
                case Pointer(InputPointerEvent.Left(_)) -> hovered = false
                else -> {}
            }
        } else
            if (context.phase == RoutedPhase.Default) {
                when (event) {
                    case Pointer(InputPointerEvent.Button(_, MouseButton.Left, state, _)) -> {
                        if (enabled) {
                            if (state == ElementState.Pressed) {
                                if (hovered && key == None)
                                    pointer = true
                            } else {
                                val fire = pointer && hovered
                                pointer = false
                                publish()
                                if (fire)
                                    activate()
                            }
                            context.consume()
                        }
                    }
                    case Keyboard(value) -> {
                        if (keyboard(area, value, activate))
                            context.consume()
                    }
                    else -> {}
                }
            }
        publish()
    }
    fun finish(event: InputEvent) {
        when (event) {
            case Pointer(
                InputPointerEvent.Button(_, MouseButton.Left, ElementState.Released, _)
            ) -> pointer = false
            case Keyboard(value) -> {
                if (value.state == ElementState.Released && key == Some(value.physicalKey))
                    key = None
            }
            else -> {}
        }
        publish()
    }
    private fun keyboard(area: InputArea, event: KeyEvent, activate: () -> Unit): Boolean {
        if (!enabled || !area.isFocusActive)
            return false
        val supported =
            when (event.logicalKey) {
                case Named(NamedKey.Space) -> true
                case Named(NamedKey.Enter) -> acceptsEnter
                else -> false
            }
        if (event.state == ElementState.Released && key == Some(event.physicalKey)) {
            key = None
            publish()
            if (!event.synthetic)
                activate()
            return true
        }
        if (!supported)
            return false
        if (
            event.state ==
                ElementState.Pressed &&
                !event.isRepeat &&
                !event.synthetic &&
                !pointer &&
                key ==
                None
        )
            key = Some(event.physicalKey)
        return true
    }
    private fun cancel() {
        pointer = false;
        key = None
    }
    private fun publish() {
        val next = InteractionState(hovered, (pointer && hovered) || key != None, focused)
        if (visual.value != next)
            visual.value = next
    }
}
