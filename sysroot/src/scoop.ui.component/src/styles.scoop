package scoop.ui.component

import scoop.graphics.text.SpanStyle
import scoop.surface.AnimationSpec
import scoop.ui.style.*

/** Explicit state overrides, composed before theme geometry is calculated. */
public class InteractionStyles public constructor(
    public val hovered: StyleOverride = styleOverride(),
    public val pressed: StyleOverride = styleOverride(),
    public val focused: StyleOverride = styleOverride(),
    public val disabled: StyleOverride = styleOverride()
) {
    internal fun apply(base: StyleOverride, visual: InteractionVisual): StyleOverride {
        var result = base
        if (visual.enabled) {
            if (visual.hovered)
                result = result.then(hovered)
            if (visual.pressed)
                result = result.then(pressed)
            if (visual.focused)
                result = result.then(focused)
        } else
            result = result.then(disabled)
        return result
    }
}

public class ButtonStyle public constructor(
    public val kind: SurfaceKind = SurfaceKind.Action,
    public val surface: SurfaceOptions = surfaceOptions(),
    public val text: SpanStyle? = None,
    public val states: InteractionStyles = InteractionStyles(),
    public val transition: StyleValue<AnimationSpec?> = StyleValue.Inherit
) {
    internal fun options(visual: InteractionVisual): SurfaceOptions {
        val localStyle = states.apply(surface.style, visual)
        return surface.copy { this.style = localStyle }
    }
}

public class CheckboxStyle public constructor(
    public val marker: CheckboxOptions = checkboxOptions(),
    public val padding: Insets? = None,
    public val states: InteractionStyles = InteractionStyles(),
    public val transition: StyleValue<AnimationSpec?> = StyleValue.Inherit,
    public val selectionTransition: StyleValue<AnimationSpec?> = StyleValue.Inherit
) {
    internal fun options(visual: InteractionVisual): CheckboxOptions {
        val localStyle = states.apply(marker.style, visual)
        return marker.copy { this.style = localStyle }
    }
}
