package scoop.ui.component

import scoop.graphics.text.*
import scoop.time.Duration
import scoop.ui.*
import scoop.ui.style.ThemeSource
import scoop.ui.text.*

public class InputProps public constructor(
    public val state: TextEditorState,
    public val placeholder: String = "",
    public val enabled: Boolean = true,
    public val readOnly: Boolean = false,
    public val invalid: Boolean = false,
    public val description: String = "",
    public val fonts: FontCollection? = None,
    public val style: TextFieldStyle = TextFieldStyle(),
    public val theme: ThemeSource? = None,
    public val focus: FocusOptions = FocusOptions(),
    public val direction: TextDirection = TextDirection.Ltr,
    public val alignment: TextAlignment = TextAlignment.Start,
    public val paintCache: PaintCachePolicy = PaintCachePolicy.None,
    public val caretBlink: Duration = Duration.milliseconds(500L),
    public val onEdited: (TextEditorState) -> Unit = { _ -> Unit },
    public val onSubmit: (TextEditorState) -> Unit = { _ -> Unit }
)

/** A themed single-line view of the caller's editing model. */
public class Input public constructor(private val props: Props<InputProps>): Component {
    private val field = TextFieldRenderer()
    public override fun onMount(scope: ComponentScope) {
        field.mount(props.value.theme)
    }
    public override fun render(): View {
        val input = props.value
        return field.render(
            TextFieldInput(
                input.state,
                input.placeholder,
                input.invalid,
                input.description,
                input.fonts,
                input.style,
                input.theme,
                input.focus,
                TextEditOptions(
                    readOnly = input.readOnly,
                    enabled = input.enabled,
                    direction = input.direction,
                    alignment = input.alignment,
                    paintCache = input.paintCache,
                    caretBlink = input.caretBlink
                ),
                1L,
                ScrollbarVisibility.Hidden,
                input.onEdited,
                input.onSubmit
            )
        )
    }
}

public fun input(
    state: TextEditorState,
    placeholder: String = "",
    enabled: Boolean = true,
    readOnly: Boolean = false,
    invalid: Boolean = false,
    description: String = "",
    fonts: FontCollection? = None,
    style: TextFieldStyle = TextFieldStyle(),
    theme: ThemeSource? = None,
    focus: FocusOptions = FocusOptions(),
    direction: TextDirection = TextDirection.Ltr,
    alignment: TextAlignment = TextAlignment.Start,
    paintCache: PaintCachePolicy = PaintCachePolicy.None,
    caretBlink: Duration = Duration.milliseconds(500L),
    onEdited: (TextEditorState) -> Unit = { _ -> Unit },
    onSubmit: (TextEditorState) -> Unit = { _ -> Unit },
    key: ViewKey = ViewKey.Position
): View =
    component(
        InputProps(
            state,
            placeholder,
            enabled,
            readOnly,
            invalid,
            description,
            fonts,
            style,
            theme,
            focus,
            direction,
            alignment,
            paintCache,
            caretBlink,
            onEdited,
            onSubmit
        ),
        { props -> Input(props) },
        key
    )
