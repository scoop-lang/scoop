package scoop.ui.component

import scoop.graphics.text.*
import scoop.time.Duration
import scoop.ui.*
import scoop.ui.style.ThemeSource
import scoop.ui.text.*

public class InputProps public constructor(
    public val state: TextEditorState,
    public val placeholder: String = "",
    public val enabled: Boolean = true,
    public val readOnly: Boolean = false,
    public val invalid: Boolean = false,
    public val description: String = "",
    public val fonts: FontCollection? = None,
    public val style: TextFieldStyle = textFieldStyle(),
    public val theme: ThemeSource? = None,
    public val focus: FocusOptions = FocusOptions(),
    public val direction: TextDirection? = None,
    public val alignment: TextAlignment = TextAlignment.Start,
    public val paintCache: PaintCachePolicy = PaintCachePolicy.None,
    public val caretBlink: Duration? = None,
    public val onEdited: (TextEditorState) -> Unit = { _ -> Unit },
    public val onSubmit: (TextEditorState) -> Unit = { _ -> Unit },
    public val policy: TextEditPolicy = textEditPolicy(),
    public val projection: TextProjection = textProjection(),
    public val copy: TextCopyPolicy = TextCopyPolicy.Default,
    public val labelTarget: FieldTarget? = None,
    public val group: GroupPosition? = None,
    public val chrome: TextFieldChrome = TextFieldChrome.Framed,
    public val contextMenu: TextContextMenuOptions = TextContextMenuOptions(),
    public val protectedText: Boolean = false,
    public val semantics: ComponentSemantics = ComponentSemantics(),
    public val acceptDrops: Boolean = true
)

/** A themed single-line view of the caller's editing model. */
public class Input public constructor(
    private val props: Props<InputProps>,
    scope: ComponentScope
): Component(scope) {
    private val field = TextFieldRenderer(scope)
    public override fun render(): View = field.render(singleLineInput(props.value))
}

private fun singleLineInput(input: InputProps): TextFieldInput =
    TextFieldInput(
        input.state,
        input.placeholder,
        input.invalid,
        input.description,
        input.fonts,
        input.style,
        input.theme,
        input.focus,
        TextEditOptions(
            readOnly = input.readOnly,
            enabled = input.enabled,
            direction = input.direction,
            alignment = input.alignment,
            paintCache = input.paintCache,
            caretBlink = input.caretBlink,
            policy = input.policy,
            projection = input.projection,
            copy = input.copy,
            contextMenu = input.contextMenu,
            protectedText = input.protectedText,
            acceptDrops = input.acceptDrops
        ),
        1L,
        ScrollbarVisibility.Hidden,
        input.onEdited,
        input.onSubmit,
        input.labelTarget,
        input.group,
        input.chrome,
        semantics = input.semantics
    )

public fun input(state: TextEditorState, configure: InputBuilder.() -> Unit = {}): View =
    makeInput(state, configure)
