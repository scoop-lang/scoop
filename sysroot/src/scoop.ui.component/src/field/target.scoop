package scoop.ui.component

import scoop.surface.*
import scoop.ui.*
import scoop.window.accessibility.*

/** Stable label association; the mounted control owns its lifetime and action. */
public class FieldTarget public constructor() {
    private val current = state<FieldLink?>(None)
    private val annotations = ArrayList<FieldAnnotation>()
    internal val connection: FieldLink? get() = current.value
    public val isAttached: Boolean get() = current.value?.isAttached ?: false
    public val isEnabled: Boolean get() = current.value?.isEnabled ?: false

    internal fun checkBinding(link: FieldLink) {
        when (current.value) {
            case Some(val previous) -> requireComponent(
                previous === link || !previous.isAttached,
                "field target already has a control"
            )
            case None -> {}
        }
    }
    internal fun bind(link: FieldLink) {
        current.value = Some(link)
    }
    internal fun unbind(link: FieldLink) {
        when (current.value) {
            case Some(val previous) -> if (previous === link)
                current.value = None
            case None -> {}
        }
    }
    internal fun addAnnotation(annotation: FieldAnnotation) {
        annotations.add(annotation)
        current.value?.semanticsChanged()
    }
    internal fun removeAnnotation(annotation: FieldAnnotation) {
        for (index in 0L ..< annotations.size)
            if (annotations[index] === annotation) {
                annotations.removeAt(index)
                current.value?.semanticsChanged()
                return
            }
    }
    internal fun annotationChanged() {
        current.value?.semanticsChanged()
    }
    internal fun relations(
        source: SemanticsHandle,
        declared: SemanticRelations
    ): SemanticRelations {
        val labels = ArrayList<SemanticNodeId>()
        val descriptions = ArrayList<SemanticNodeId>()
        val errors = ArrayList<SemanticNodeId>()
        for (annotation in annotations) {
            val node = annotation.nodeFor(source) ?: continue
            when (annotation.kind) {
                case Label -> labels.add(node.id)
                case Description -> descriptions.add(node.id)
                case Error -> errors.add(node.id)
            }
        }
        return SemanticRelations(
            if (declared.labelledBy.size > 0L)
                declared.labelledBy
            else
                labels.toArray(),
            if (declared.describedBy.size > 0L)
                declared.describedBy
            else
                descriptions.toArray(),
            if (declared.errorMessages.size > 0L)
                declared.errorMessages
            else
                errors.toArray(),
            declared.controls
        )
    }
}

internal class FieldLink(
    private val scope: ComponentScope,
    private val area: InputArea,
    private val focus: FocusTarget,
    private val refreshSemantics: () -> Unit = {}
): Closeable {
    private val enabled = state(false)
    private var target: FieldTarget? = None
    private var action: () -> Unit = {}
    private var closed = false
    val isAttached: Boolean get() = !closed && scope.isMounted
    val isEnabled: Boolean get() = isAttached && enabled.value

    fun semanticsChanged() {
        if (isAttached)
            refreshSemantics()
    }
    fun relations(source: SemanticsHandle, declared: SemanticRelations): SemanticRelations =
        when (val current = target) {
            case Some(val value) -> value.relations(source, declared)
            case None -> declared
        }

    fun update(value: FieldTarget?, accepts: Boolean, activate: () -> Unit = {}) {
        value?.checkBinding(this)
        if (!sameFieldTarget(target, value)) {
            target?.unbind(this)
            target = value
            value?.bind(this)
        }
        if (enabled.value != accepts)
            enabled.value = accepts
        action = activate
    }
    fun activate(source: ComponentScope, expected: FieldTarget) {
        if (!isEnabled || !source.isMounted || !sameFieldTarget(target, Some(expected)))
            return
        if (
            source.nativeWindow !==
                scope.nativeWindow ||
                !source.input.isInputAllowed ||
                !area.scope.isInputAllowed ||
                !area.canFocus
        )
            return
        if (focus.handle.requestFocus(FocusOrigin.Pointer))
            action()
    }
    public override fun close() {
        if (closed)
            return
        closed = true
        target?.unbind(this)
        target = None
        action = {}
    }
}

internal fun sameFieldTarget(left: FieldTarget?, right: FieldTarget?): Boolean =
    when (left) {
        case Some(val a) -> when (right) {
            case Some(val b) -> a === b
            case None -> false
        }
        case None -> when (right) {
            case Some(_) -> false
            case None -> true
        }
    }
