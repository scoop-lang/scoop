package scoop.ui.component

import scoop.graphics.text.*
import scoop.ui.*
import scoop.ui.text.*

public class SelectableStyledTextProps public constructor(
    public val content: StyledText,
    public val fonts: FontCollection? = None,
    public val settings: ParagraphStyle? = None,
    public val inlines: Array<InlineView> = [],
    public val options: SelectableTextOptions = SelectableTextOptions(),
    public val focus: FocusOptions = FocusOptions(),
    public val actions: Array<TextRangeAction> = [],
    public val decorations: Array<TextRangeDecoration> = [],
    public val onSelectionChanged: (TextPosition, TextPosition) -> Unit = { _, _ -> Unit }
)

/** Styled selection delegates layout, input and lifetime to the public text host. */
public class SelectableStyledText public constructor(
    private val props: Props<SelectableStyledTextProps>,
    scope: ComponentScope
): Component(scope) {
    public override fun render(): View {
        val input = props.value
        return element(
            input,
            { current, mount -> SelectableStyledTextInk(current, scope = mount) },
            inlineChildren(input.content, input.inlines)
        )
    }
}

public fun selectableStyledText(
    content: StyledText,
    configure: SelectableStyledTextBuilder.() -> Unit = {}
): View = makeSelectableStyledText(content, configure)

internal fun makeSelectableStyledText(
    content: StyledText,
    configure: SelectableStyledTextBuilder.() -> Unit = {}
): View {
    val builder = SelectableStyledTextBuilder()
    builder.configure()
    return component(
        builder.snapshot(content),
        { props, mount -> SelectableStyledText(props, scope = mount) },
        builder.key
    )
}

private class SelectableStyledTextInk(
    private val props: Props<SelectableStyledTextProps>,
    scope: ComponentScope
): Element<ParagraphMeasurement>(scope) {
    private fun fonts(): FontCollection = props.value.fonts ?: scope.defaultFonts
    private val host =
        scope.resource {
            SelectableTextHost(scope, fonts(), props.value.content, props.value.options)
        }
    public override fun update(): UiInvalidation {
        val input = props.value
        host.update(
            fonts(),
            input.content,
            input.options,
            input.focus,
            input.actions,
            input.decorations,
            input.onSelectionChanged
        )
        return UiInvalidation.Layout
    }
    public override fun measure(context: MeasureContext, constraints: Constraints): LayoutResult<
        ParagraphMeasurement
    > {
        val input = props.value
        val measured = host.measure(context, constraints, input.settings, input.inlines)
        return LayoutResult(measured.metrics, measured, { measured.close() })
    }
    public override fun scene(context: SceneContext, measured: ParagraphMeasurement) {
        host.scene(context, measured)
    }
}
