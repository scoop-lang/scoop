package scoop.ui.component

import scoop.graphics.*
import scoop.surface.FocusOrigin
import scoop.ui.*
import scoop.ui.style.*

public class MenubarEntry public constructor(
    public val key: ViewKey,
    public val trigger: PopupTriggerSpec,
    public val content: MenuContent
)

public class MenubarProps public constructor(
    public val open: Binding<ViewKey?>,
    public val entries: Array<MenubarEntry>,
    public val options: MenuOptions = MenuOptions(),
    public val style: StyleOverride = styleOverride(),
    public val onOpenChange: (ViewKey?) -> Unit = {}
) {
    init {
        for (index in 0L ..< entries.size) {
            requireComponent(
                entries[index].key != ViewKey.Position,
                "menubar requires an explicit key"
            )
            for (previous in 0L ..< index)
                requireComponent(
                    entries[previous].key != entries[index].key,
                    "duplicate menubar key"
                )
        }
    }
}

public class Menubar public constructor(private val props: Props<MenubarProps>): Component {
    private val themes = ThemeAccess()
    private val storage = ChoiceHandles()
    private var handles: Array<FocusHandle> = []
    public override fun onMount(scope: ComponentScope) {
        themes.mount(props.value.options.theme)
    }
    private fun setOpen(key: ViewKey?) {
        val binding = props.value.open
        val previous = binding.value
        if (previous == key)
            return
        binding.value = key
        val accepted = binding.value
        if (accepted != previous)
            props.value.onOpenChange(accepted)
    }
    private fun select(key: ViewKey, origin: FocusOrigin) {
        val input = props.value
        if (!input.options.enabled)
            return
        for (index in 0L ..< input.entries.size)
            if (input.entries[index].key == key && input.entries[index].trigger.enabled) {
                setOpen(Some(key))
                if (input.open.value == Some(key))
                    handles[index].requestFocus(origin)
                return
            }
    }
    private fun navigate(handle: FocusHandle) {
        if (props.value.open.value == None)
            return
        for (index in 0L ..< handles.size)
            if (handles[index] === handle) {
                setOpen(Some(props.value.entries[index].key));
                return
            }
    }
    private fun horizontal(key: ViewKey, reverse: Boolean) {
        val input = props.value
        var current = -1L
        for (index in 0L ..< input.entries.size)
            if (input.entries[index].key == key)
                current = index
        if (current < 0L)
            return
        var index = current
        var visited = 0L
        while (visited < input.entries.size) {
            index += if (reverse)
                -1L
            else
                1L
            if ((index < 0L || index >= input.entries.size) && !input.options.loop)
                return
            if (index < 0L)
                index = input.entries.size - 1L
            if (index >= input.entries.size)
                index = 0L
            if (input.entries[index].trigger.enabled) {
                select(input.entries[index].key, FocusOrigin.Keyboard);
                return
            }
            visited += 1L
        }
    }
    public override fun render(): View {
        val input = props.value
        val theme = themes.read(input.options.theme)
        val density = theme.tokens.typography.body.fontSize / 14.0
        val keys = Array<ViewKey>(input.entries.size) { index -> input.entries[index].key }
        handles =
            storage.resolve(
                keys,
                Array<FocusOptions>(keys.size) { index -> input.entries[index].trigger.focus }
            )
        val children =
            Array<View>(keys.size) {
                index ->
                val entry = input.entries[index]
                val key = entry.key
                val trigger = entry.trigger
                val opened = input.open.value == Some(key) && trigger.enabled
                val button =
                    PopupTriggerSpec(
                        trigger.content,
                        trigger.enabled,
                        ButtonVariant.Ghost,
                        ButtonSize.Sm,
                        menubarTriggerStyle(trigger.style, theme, opened),
                        choiceFocus(trigger.focus, handles[index]),
                        trigger.fonts
                    )
                component(
                    MenuRootInput(
                        Some(
                            binding(
                                {
                                    props.value.open.value ==
                                        Some(key) &&
                                        menubarEnabled(props.value, key)
                                },
                                {
                                    value -> if (value)
                                        setOpen(Some(key))
                                    else
                                        if (props.value.open.value == Some(key))
                                            setOpen(None)
                                }
                            )
                        ),
                        entry.content,
                        input.options,
                        MenuRootTrigger.Button(button, None),
                        focus = OverlayFocusOptions(restoreTarget = Some(handles[index])),
                        onOpenChange = {},
                        horizontal = Some({ reverse -> horizontal(key, reverse) }),
                        hovered =
                            {
                                if (props.value.open.value != None)
                                    select(key, FocusOrigin.Pointer)
                            }
                    ),
                    { current -> MenubarMenu(current) }
                )
            }
        val visual =
            styleOverride {
                background(Some(Paint(theme.tokens.palette.background.background)))
                border(Some(Border.all(1.0, theme.tokens.palette.border)))
                corners(Corners.all(8.0 * density))
            }.then(input.style)
        return panelFrame(
            choiceLayout(
                children,
                keys,
                handles,
                FlexAxis.Horizontal,
                2.0 * density,
                input.options.loop,
                input.options.enabled,
                styleOverride(),
                navigate = { handle -> navigate(handle) },
                fitCross = false
            ),
            Insets.all(4.0 * density),
            visual
        )
    }
}

internal fun menubarTriggerStyle(local: ButtonStyle, theme: Theme, opened: Boolean): ButtonStyle {
    val density = theme.tokens.typography.body.fontSize / 14.0
    val active = styleOverride { background(Some(Paint(theme.tokens.palette.muted.background))) }
    return local.copy {
        surface {
            if (suggestedSize == None)
                suggestedSize = Some(Size(0.0, 24.0 * density))
            if (minimumSize == None)
                minimumSize = Some(Size(0.0, 0.0))
            if (padding == None)
                padding = Some(Insets(6.0 * density, 2.0 * density, 6.0 * density, 2.0 * density))
            if (focus == None)
                focus = Some(OutlineStyle(Color.Transparent, 0.0, 0.0))
            style =
                styleOverride {
                    if (opened)
                        background(Some(Paint(theme.tokens.palette.muted.background)))
                    border(None)
                    corners(Corners.all(4.0 * density))
                    boxShadows([])
                }.then(local.surface.style)
        }
        states {
            hovered = active.then(local.surface.style).then(local.states.hovered)
            pressed = active.then(local.surface.style).then(local.states.pressed)
        }
    }
}

private fun menubarEnabled(input: MenubarProps, key: ViewKey): Boolean {
    for (entry in input.entries)
        if (entry.key == key)
            return entry.trigger.enabled && input.options.enabled
    return false
}

private class MenubarMenu(private val props: Props<MenuRootInput>): Component {
    private val root = MenuRoot({ props.value })
    public override fun onMount(scope: ComponentScope) {
        root.mount(scope)
    }
    public override fun render(): View = root.render()
}

public class MenubarBuilder internal constructor(): MenuOptionsBuilder() {
    private val entries = ArrayList<MenubarEntry>()
    public var barStyle: StyleOverride = styleOverride()
    public var onOpenChange: (ViewKey?) -> Unit = {}
    public fun add(entry: MenubarEntry) {
        entries.add(entry)
    }
    public fun menu(
        key: ViewKey,
        text: String,
        content: MenuContent,
        configure: PopupTriggerBuilder.() -> Unit = {}
    ) {
        val builder = PopupTriggerBuilder()
        builder.configure()
        add(
            MenubarEntry(
                key,
                builder.snapshot(ButtonContent.Label(LabelProps(LabelText.Plain(text, None)))),
                content
            )
        )
    }
    public fun menu(
        key: ViewKey,
        trigger: View,
        content: MenuContent,
        configure: PopupTriggerBuilder.() -> Unit = {}
    ) {
        val builder = PopupTriggerBuilder()
        builder.configure()
        add(MenubarEntry(key, builder.snapshot(ButtonContent.Custom(trigger)), content))
    }
    internal fun snapshot(open: Binding<ViewKey?>): MenubarProps =
        MenubarProps(open, entries.toArray(), options(), barStyle, onOpenChange)
}

public fun menubar(open: Binding<ViewKey?>, configure: MenubarBuilder.() -> Unit = {}): View =
    makeMenubar(open, configure)

internal fun makeMenubar(open: Binding<ViewKey?>, configure: MenubarBuilder.() -> Unit): View {
    val builder = MenubarBuilder()
    builder.configure()
    return component(builder.snapshot(open), { current -> Menubar(current) }, builder.key)
}
