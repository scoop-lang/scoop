package scoop.ui.component

import scoop.graphics.Color
import scoop.icons.lucide.*
import scoop.ui.View
import scoop.ui.empty

internal fun toastIcon(kind: ToastKind, size: Double, color: Color): View {
    val asset =
        when (kind) {
            case Success -> circleCheck
            case Info -> info
            case Warning -> triangleAlert
            case Error -> octagonX
            case Default -> return empty()
            case Loading -> return empty()
        }
    return makeIcon(asset) {
        this.size = size
        this.color = Some(color)
    }
}
