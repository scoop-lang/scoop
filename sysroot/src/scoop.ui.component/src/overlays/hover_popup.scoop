package scoop.ui.component

import scoop.graphics.*
import scoop.graphics.text.*
import scoop.surface.AnimationSpec
import scoop.time.Duration
import scoop.ui.*
import scoop.ui.style.*
import scoop.window.accessibility.*

public class Tooltip public constructor(
    private val props: Props<TooltipProps>,
    scope: ComponentScope
): Component(scope) {
    private val popup = HoverPopup({ props.value.input }, scope)
    public override fun onMount() {
        popup.mount()
    }
    public override fun render(): View = popup.render()
}

public class HoverCard public constructor(
    private val props: Props<HoverCardProps>,
    scope: ComponentScope
): Component(scope) {
    private val popup = HoverPopup({ props.value.input }, scope)
    public override fun onMount() {
        popup.mount()
    }
    public override fun render(): View = popup.render()
}

/** Composition shared by the two hover families; Hover owns all input and deadline state. */
private class HoverPopup(private val read: () -> HoverPopupInput, scope: ComponentScope) {
    private val local = state(false)
    private val anchor = LayoutAnchor()
    private val semanticPopup = SemanticsReference()
    private val localHandle = OverlayHandle()
    private val link = HoverPopupLink()
    private val themes = ThemeAccess(scope)
    private val bodyStyle = ActionTextStyle()
    private val open = binding({ read().open?.value ?: local.value }, { next -> setOpen(next) })
    private val portalOpen =
        binding(
            { open.value },
            {
                next -> if (next)
                    setOpen(true)
                else
                    link.dismiss { setOpen(false) }
            }
        )
    fun mount() {
        themes.mount(read().theme)
    }
    private fun setOpen(next: Boolean) {
        val input = read()
        val previous = open.value
        if (previous == next)
            return
        when (input.open) {
            case Some(val value) -> value.value = next
            case None -> local.value = next
        }
        val accepted = open.value
        if (previous != accepted)
            read().onOpenChange(accepted)
    }
    private fun setExpanded(value: Boolean): SemanticActionResult {
        if (!read().hover.enabled)
            return SemanticActionResult.Rejected
        if (value)
            setOpen(true)
        else
            (read().handle ?: localHandle).requestClose()
        return if (open.value == value)
            SemanticActionResult.Completed
        else
            SemanticActionResult.Rejected
    }
    fun render(): View {
        val input = read()
        val theme = themes.read(input.theme)
        val palette = theme.tokens.palette
        val density = theme.tokens.typography.body.fontSize / 14.0
        val passive = input.kind == HoverPopupKind.Tooltip
        val backgroundColor =
            if (passive)
                tooltipBackground(palette)
            else
                palette.popover.background
        val foreground =
            if (passive)
                palette.background.background
            else
                palette.popover.foreground
        val base =
            if (passive)
                theme.tokens.typography.body.copy {
                    fontSize = 12.0 * density
                    lineHeight = Some(16.0 / 12.0)
                }
            else
                theme.tokens.typography.body
        val text = bodyStyle.resolve(base, foreground, None)
        val visual =
            styleOverride {
                background(Some(Paint(backgroundColor)))
                corners(
                    Corners.all(
                        (
                            if (passive)
                                6.0
                            else
                                8.0
                        ) *
                            density
                    )
                )
                if (!passive) {
                    border(Some(Border.all(1.0, palette.background.foreground.withAlpha(0.1))))
                    boxShadows(theme.tokens.effects.floating)
                }
            }.then(input.style)
        val panel =
            panelFrame(
                panelCaption(input.content, text, input.fonts),
                if (passive)
                    Insets(12.0 * density, 6.0 * density, 12.0 * density, 6.0 * density)
                else
                    Insets.all(10.0 * density),
                visual,
                if (passive)
                    None
                else
                    Some(input.width * density)
            )
        val motion =
            theme.tokens.motion.resolve(
                input.transition.resolve(Some(AnimationSpec.Tween(Duration.milliseconds(100L))))
            )
        val content =
            element(
                HoverPopupContentProps(
                    link,
                    passive,
                    if (passive)
                        Some(input.width * density)
                    else
                        None
                ),
                { current, mount -> HoverPopupContent(current, scope = mount) },
                [panel]
            )
        val localAnchor = anchor
        val currentInputs = read
        val popup =
            portal(
                portalOpen,
                element(
                    PopupMotionProps(
                        input.hover.enabled,
                        8.0 * density,
                        popupArrowInk(input.arrow, density, visual.background.resolve(None))
                    ),
                    { current, mount -> PopupMotion(current, scope = mount) },
                    [
                        semanticContent(
                            content,
                            if (passive)
                                SemanticRole.Text
                            else
                                SemanticRole.Dialog,
                            SemanticProperties(
                                name = input.semantics.name,
                                value =
                                    if (passive)
                                        candidateCaption(input.content)
                                    else
                                        None,
                                readOnly = passive,
                                enabled = input.hover.enabled
                            ),
                            actions = SemanticActions(dismiss = Some { setExpanded(false) }),
                            mergeLabels = passive,
                            reference = Some(semanticPopup)
                        )
                    ]
                )
            ) {
                placement =
                    OverlayPlacement.Anchored(
                        localAnchor,
                        input.side,
                        input.alignment,
                        input.gap * density,
                        input.viewportPadding * density
                    )
                handle = Some(input.handle ?: this @HoverPopup.localHandle)
                dismiss = OverlayDismiss(true, OutsidePress.CloseAndContinue, true)
                transition = PresenceOptions(motion, motion)
                onClosed = { reason -> currentInputs().onClosed(reason) }
            }
        return element(
            HoverPopupLayoutProps(anchor, link, open, input.hover, passive),
            { current, mount -> HoverPopupLayout(current, scope = mount) },
            [
                semanticContent(
                    input.trigger,
                    SemanticRole.Group,
                    input.semantics.properties(
                        enabled = input.hover.enabled,
                        description = candidateCaption(input.content),
                        expanded =
                            if (passive)
                                None
                            else
                                Some(open.value)
                    ),
                    actions =
                        if (passive)
                            SemanticActions()
                        else
                            SemanticActions(setExpanded = Some { value -> setExpanded(value) }),
                    relations = semanticControls(input.semantics.relations, semanticPopup.id),
                    mergeLabels = false,
                    reference = input.semantics.reference
                ),
                popup
            ]
        )
    }
}

/** System text colors can carry alpha; popup surfaces must cover the content behind them. */
internal fun tooltipBackground(palette: ThemePalette): Color =
    mixThemeColor(
        palette.background.background.withAlpha(1.0),
        palette.background.foreground.withAlpha(1.0),
        palette.background.foreground.alpha
    )
