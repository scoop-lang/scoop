package scoop.ui.component

import scoop.graphics.*
import scoop.ui.*
import scoop.ui.style.*

internal class ModalBodyProps(
    val options: ModalOptions,
    val theme: Theme,
    val scrollState: ScrollState? = options.scrollState,
    val fillHeight: Boolean = true
)

/** Reuses the eager viewport controller and retains the same body when scrolling is toggled. */
internal class ModalBody(private val props: Props<ModalBodyProps>): Element {
    private val local = ScrollState()
    private var control: ScrollControl? = None
    private var snapshot: ScrollSnapshot? = None
    private fun controls(): ScrollControlProps {
        val input = props.value
        val options = input.options
        return ScrollControlProps(
            input.scrollState ?: local,
            ScrollAxes.Vertical,
            40.0,
            ScrollChain.Contain,
            if (options.scrollable)
                ScrollbarVisibility.Auto
            else
                ScrollbarVisibility.Hidden,
            scrollbarOptions(),
            options.enabled,
            FocusOptions(tabStop = false),
            PaintCachePolicy.None,
            input.theme
        )
    }
    public override fun onMount(scope: ComponentScope) {
        control = Some(ScrollControl(scope) { controls() })
    }
    public override fun update() {
        control!!.update()
    }
    public override fun measure(context: MeasureContext, constraints: Constraints): LayoutMetrics {
        val scroll = props.value.options.scrollable
        val padding = 16.0 * props.value.theme.tokens.typography.body.fontSize / 14.0
        val insets = Size(padding * 2.0, padding * 2.0)
        val inner = childConstraints(constraints, insets)
        val child =
            context.measureChild(
                0L,
                Constraints(
                    inner.minWidth,
                    inner.maxWidth,
                    maxHeight =
                        if (scroll)
                            None
                        else
                            inner.maxHeight
                )
            )
        val content = Size(child.size.width + insets.width, child.size.height + insets.height)
        val size =
            constraints.constrain(
                Size(
                    content.width,
                    if (scroll && props.value.fillHeight)
                        constraints.maxHeight ?: content.height
                    else
                        content.height
                )
            )
        snapshot = Some(control!!.layout(size, content))
        context.placeChild(0L, Point(padding, padding))
        return LayoutMetrics(size)
    }
    public override fun scene(context: SceneContext) {
        control!!.scene(context, snapshot!!)
    }
}
