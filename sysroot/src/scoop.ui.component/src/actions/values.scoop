package scoop.ui.component

import scoop.graphics.svg.SvgAsset
import scoop.ui.View

import scoop.graphics.text.TextStyle
import scoop.ui.style.InteractionVisual

public enum ButtonVariant {
    Default, Outline, Secondary, Ghost, Destructive, Link
}

public enum ButtonSize {
    Xs, Sm, Default, Lg, IconXs, IconSm, Icon, IconLg
}

/** Resolved once per render; content remains an ordinary caller-owned View. */
public struct ActionContentStyle(
    val text: TextStyle,
    val iconSize: Double,
    val spacing: Double,
    val interaction: InteractionVisual,
    val underline: Boolean
) {
    public fun icon(asset: SvgAsset, configure: IconBuilder.() -> Unit = {}): View {
        val appearance = this
        return makeIcon(asset) {
            size = appearance.iconSize
            color = Some(appearance.text.color)
            this.configure()
        }
    }
}

internal enum ActionShape {
    Button(ButtonSize), Badge, Toggle(ToggleVariant, ToggleSize, Boolean), Tab(TabsVariant, Boolean)
}

internal fun actionFontScale(shape: ActionShape): Double =
    when (shape) {
        case Tab(_, _) -> 1.0
        case Toggle(_, size, _) -> if (size == ToggleSize.Sm)
            12.8 / 14.0
        else
            1.0
        case Badge -> 12.0 / 14.0
        case Button(size) -> when (size) {
            case Xs -> 12.0 / 14.0
            case IconXs -> 12.0 / 14.0
            case Sm -> 12.8 / 14.0
            case IconSm -> 12.8 / 14.0
            else -> 1.0
        }
    }

internal fun actionIconSize(shape: ActionShape): Double =
    when (shape) {
        case Tab(_, _) -> 16.0
        case Toggle(_, size, _) -> if (size == ToggleSize.Sm)
            14.0
        else
            16.0
        case Badge -> 12.0
        case Button(size) -> when (size) {
            case Xs -> 12.0
            case IconXs -> 12.0
            case Sm -> 14.0
            case IconSm -> 16.0
            else -> 16.0
        }
    }

internal fun actionSpacing(shape: ActionShape): Double =
    when (shape) {
        case Tab(_, _) -> 6.0
        case Toggle(_, _, _) -> 4.0
        case Badge -> 4.0
        case Button(size) -> when (size) {
            case Xs -> 4.0
            case Sm -> 4.0
            case IconXs -> 4.0
            case IconSm -> 4.0
            else -> 6.0
        }
    }

internal fun isIconAction(shape: ActionShape): Boolean =
    when (shape) {
        case Tab(_, _) -> false
        case Toggle(_, _, _) -> false
        case Badge -> false
        case Button(size) -> when (size) {
            case IconXs -> true
            case IconSm -> true
            case Icon -> true
            case IconLg -> true
            else -> false
        }
    }
