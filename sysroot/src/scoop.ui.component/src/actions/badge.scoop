package scoop.ui.component

import scoop.graphics.text.*
import scoop.ui.*
import scoop.ui.style.*
import scoop.window.accessibility.*

public class BadgeProps public constructor(
    public val content: ButtonContent,
    public val onClick: (() -> Unit)? = None,
    public val variant: ButtonVariant = ButtonVariant.Default,
    public val enabled: Boolean = true,
    public val invalid: Boolean = false,
    public val style: ButtonStyle = buttonStyle(),
    public val theme: ThemeSource? = None,
    public val focus: FocusOptions = FocusOptions(),
    public val semantics: ComponentSemantics = ComponentSemantics()
)

public class Badge public constructor(
    private val props: Props<BadgeProps>,
    scope: ComponentScope
): Component(scope) {
    public override fun render(): View {
        val input = props.value
        return when (input.onClick) {
            case Some(val action) -> component(
                BadgeActionInput(input, action),
                { current, mount -> BadgeAction(current, scope = mount) }
            )
            case None -> component(
                input,
                { current, mount -> BadgeDisplay(current, scope = mount) }
            )
        }
    }
}

public fun badge(text: String, configure: BadgeBuilder.() -> Unit = {}): View =
    makeTextBadge(text, configure)

public fun badge(text: StyledText, configure: StyledBadgeBuilder.() -> Unit = {}): View =
    makeStyledBadge(text, configure)

public fun badge(content: View, configure: ContentBadgeBuilder.() -> Unit = {}): View =
    makeContentBadge(content, configure)

public fun badge(
    content: (ActionContentStyle) -> View,
    configure: ContentBadgeBuilder.() -> Unit = {}
): View = makeResolvedBadge(content, configure)

private class BadgeActionInput(val value: BadgeProps, val action: () -> Unit)

private class BadgeAction(
    private val props: Props<BadgeActionInput>,
    scope: ComponentScope
): Component(scope) {
    private val control =
        PressControl(
            scope,
            PressOptions(props.value.value.enabled),
            props.value.value.focus,
            { props.value.action() }
        )
    private val semantics = createComponentSemantics(scope, SemanticRole.Button)
    init {
        semantics?.bindFocus(Some(control.focus))
        when (semantics) {
            case Some(val value) -> value.mergeLabels = true;
            case None -> {}
        }
        scope.routeSemanticsChildren(semantics)
    }
    private val themes = ThemeAccess(scope)
    private val text = ActionTextStyle()
    public override fun onMount() {
        themes.mount(props.value.value.theme)
    }
    public override fun render(): View {
        val input = props.value
        val interaction = control.press.interaction
        return badgeContent(
            input.value,
            themes,
            text,
            interaction,
            ActionBehavior.Press(control, input.action, input.value.focus),
            semantics
        )
    }
}

private class BadgeDisplay(private val props: Props<BadgeProps>, scope: ComponentScope): Component(
    scope
) {
    private val semantics = createComponentSemantics(scope, SemanticRole.Group)
    init {
        when (semantics) {
            case Some(val value) -> value.mergeLabels = true;
            case None -> {}
        }
        scope.routeSemanticsChildren(semantics)
    }
    private val themes = ThemeAccess(scope)
    private val text = ActionTextStyle()
    public override fun onMount() {
        themes.mount(props.value.theme)
    }
    public override fun render(): View =
        badgeContent(
            props.value,
            themes,
            text,
            InteractionState(),
            ActionBehavior.Passive,
            semantics
        )
}

private fun badgeContent(
    input: BadgeProps,
    themes: ThemeAccess,
    text: ActionTextStyle,
    interaction: InteractionState,
    behavior: ActionBehavior,
    semantics: SemanticsHandle?
): View {
    val theme = themes.read(input.theme)
    val shape = ActionShape.Badge
    val visual = SurfaceVisual(input.style.kind, interaction.asVisual(input.enabled, input.invalid))
    val base =
        text.resolve(
            theme.tokens.typography.action,
            actionTextColor(theme, shape, input.variant, visual),
            input.style.text,
            actionFontScale(shape),
            actionLineHeight(shape)
        )
    return element(
        ActionInkProps(
            theme,
            shape,
            input.variant,
            input.style,
            visual,
            behavior,
            semantics = semantics,
            semanticOptions = input.semantics
        ),
        { current, mount -> ActionInk(current, scope = mount) },
        [
            actionContent(
                input.content,
                actionContentStyle(base, shape, input.variant, visual.interaction)
            )
        ]
    )
}
