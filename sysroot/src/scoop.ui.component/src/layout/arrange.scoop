package scoop.ui.component

import scoop.graphics.*
import scoop.ui.Constraints
import scoop.ui.LayoutDirection

public enum AxisAlignment {
    Start, Center, End
}

public struct Alignment(
    val horizontal: AxisAlignment = AxisAlignment.Center,
    val vertical: AxisAlignment = AxisAlignment.Center
)

internal class LayoutPlan(val size: Size, val origins: Array<Point>)

internal fun alignmentOffset(alignment: AxisAlignment, available: Double, content: Double): Double =
    when (alignment) {
        case Start -> 0.0
        case Center -> (available - content) / 2.0
        case End -> available - content
    }

internal fun alignedOrigin(
    bounds: Rect,
    child: Size,
    alignment: Alignment,
    direction: LayoutDirection = LayoutDirection.Ltr
): Point =
    Point(
        bounds.x +
            logicalX(
                alignmentOffset(alignment.horizontal, bounds.width, child.width),
                child.width,
                bounds.width,
                direction
            ),
        bounds.y + alignmentOffset(alignment.vertical, bounds.height, child.height)
    )

internal fun arrangeStack(
    children: Array<Size>,
    parent: Constraints,
    alignment: Alignment,
    direction: LayoutDirection = LayoutDirection.Ltr
): LayoutPlan {
    var width = 0.0
    var height = 0.0
    for (child in children) {
        width = lowerBound(width, child.width);
        height = lowerBound(height, child.height)
    }
    val size = parent.constrain(Size(width, height))
    val bounds = Rect(0.0, 0.0, size.width, size.height)
    return LayoutPlan(
        size,
        Array<Point>(children.size) {
            index -> alignedOrigin(bounds, children[index], alignment, direction)
        }
    )
}

internal fun frameChildConstraints(
    parent: Constraints,
    width: Double?,
    height: Double?,
    inset: Size,
    maxWidth: Double? = None,
    maxHeight: Double? = None
): Constraints = Constraints(
    maxWidth = insetMaximum(
        frameMaximum(width, parent.minWidth, parent.maxWidth, maxWidth),
        inset.width
    ),
    maxHeight = insetMaximum(
        frameMaximum(height, parent.minHeight, parent.maxHeight, maxHeight),
        inset.height
    )
)

internal fun frameExtent(value: Double, cap: Double?): Double = upperBound(value, cap ?: value)

private fun frameMaximum(
    requested: Double?,
    minimum: Double,
    maximum: Double?,
    cap: Double?
): Double? {
    val available = when (requested) {
        case Some(val value) -> Some(frameExtent(lowerBound(value, minimum), maximum))
        case None -> maximum
    }
    return when (available) {
        case Some(val value) -> Some(frameExtent(value, cap))
        case None -> cap
    }
}
