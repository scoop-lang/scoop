package scoop.ui.component

import scoop.graphics.*
import scoop.ui.*

public class Flex public constructor(
    private val props: Props<FlexProps>,
    scope: ComponentScope
) : Component(scope) {
    public override fun render(): View = flexElement(props.value)
}

internal fun flexElement(input: FlexProps): View = element(
    input,
    { props, mount -> LinearInk(props, scope = mount) },
    input.layout.children
)

private class LinearInk(private val props: Props<FlexProps>, scope: ComponentScope) :
    Element<Unit>(scope) {
    public override fun measure(context: MeasureContext, constraints: Constraints): LayoutResult<
        Unit
    > {
        val input = props.value
        val layout = when (input.layoutFor) {
            case Some(val resolve) -> resolve(constraints)
            case None -> input.base
        }
        return LayoutResult(
            measureFlex(context, constraints, input.layout.items, layout, rules = input.itemRules),
            Unit
        )
    }

    public override fun scene(context: SceneContext, measured: Unit) {
        containerScene(context, props.value.layout.clip)
    }
}

internal fun measureFlex(
    context: MeasureContext,
    constraints: Constraints,
    items: Array<FlexItem>,
    layout: FlexLayout,
    fitCross: Boolean = false,
    rules: Array<FlexItemRule> = [],
    placement: ((Long, LayoutMetrics, Point) -> Point)? = None
): LayoutMetrics {
    val vertical = layout.axis == FlexAxis.Vertical
    val edges = layout.logicalPadding?.resolve(context.layoutDirection) ?: layout.padding
    val padding = edges.totals()
    val mainMaximum = insetMaximum(
        if (vertical) constraints.maxHeight else constraints.maxWidth,
        flexMain(padding, vertical)
    )
    val crossMaximum = insetMaximum(
        if (vertical) constraints.maxWidth else constraints.maxHeight,
        flexCross(padding, vertical)
    )
    val crossMinimum = if (vertical) constraints.minWidth else constraints.minHeight
    val parentCrossMaximum = if (vertical) constraints.maxWidth else constraints.maxHeight
    val fixedCross = parentCrossMaximum == Some(crossMinimum)
    val initialCross = if (fitCross && !fixedCross) None else crossMaximum
    val selection = selectFlexItems(context, constraints, items, rules)
    val options = selection.options
    val aligns = Array<CrossAlignment>(options.size) { index ->
        options[index].align ?: layout.alignment
    }
    for (align in aligns)
        requireComponent(
            !vertical || align != CrossAlignment.Baseline,
            "baseline alignment requires a horizontal flex"
        )
    val content = MutableArray<LayoutMetrics?>(options.size) { _ -> None }
    val bases = Array<Double>(options.size) { index ->
        val option = options[index]
        val basis = when (option.basis) {
            case Fixed(val value) -> value

            case Content -> {
                val measured = context
                    .measureChild(
                        selection.child(index),
                        flexConstraints(None, initialCross, vertical)
                    )
                content[index] = Some(measured)
                flexMain(measured.size, vertical)
            }
        }
        flexClamp(basis, option)
    }
    val gaps = flexGaps(options.size, layout.spacing)
    nonnegative(gaps, "flex spacing overflow")
    val allocated = when (mainMaximum) {
        case Some(val maximum) -> allocateFlex(bases, options, lowerBound(maximum - gaps, 0.0))
        case None -> bases
    }
    val first = Array<LayoutMetrics>(allocated.size) { index ->
        val measured = content[index]
        // An unbounded content pass has no allocation to impose. Keep its subtree
        // when bounds did not change the basis; nested natural layouts stay linear.
        if (mainMaximum ==
            None &&
            measured !=
            None &&
            flexMain(measured!!.size, vertical) ==
            allocated[index] &&
            !(fixedCross && aligns[index] == CrossAlignment.Stretch)
        )
            measured!!
        else
            context
                .measureChild(
                    selection.child(index),
                    flexConstraints(
                        Some(allocated[index]),
                        initialCross,
                        vertical,
                        fixedCross && aligns[index] == CrossAlignment.Stretch
                    )
                )
    }
    val natural = flexCrossMetrics(first, aligns, vertical)
    val main = flexTotal(allocated, gaps)
    var grow = false
    for (option in options)
        if (option.grow > 0.0) grow = true
    val desiredMain = if (grow) mainMaximum ?: main else main
    val size = constraints
        .constrain(
            flexSize(
                desiredMain + flexMain(padding, vertical),
                natural.extent + flexCross(padding, vertical),
                vertical
            )
        )
    val availableCross = lowerBound(flexCross(size, vertical) - flexCross(padding, vertical), 0.0)
    val metrics = Array<LayoutMetrics>(first.size) { index ->
        if (aligns[index] == CrossAlignment.Stretch)
            context
                .measureChild(
                    selection.child(index),
                    flexConstraints(Some(allocated[index]), Some(availableCross), vertical, true)
                )
        else
            first[index]
    }
    val cross = flexCrossMetrics(metrics, aligns, vertical)
    val remaining = flexMain(size, vertical) - flexMain(padding, vertical) - main
    val spacing = flexSpacing(layout.justify, remaining, metrics.size)
    var cursor = spacing.leading
    var alphabetic: Double? = None
    var ideographic: Double? = None
    for (index in 0L..<metrics.size) {
        val metric = metrics[index]
        val offset = flexCrossOffset(
            aligns[index],
            availableCross,
            metric,
            cross.baseline,
            vertical
        )
        val start = if (vertical) offset else cursor
        val origin = Point(
            edges.left +
                logicalX(
                    start,
                    metric.size.width,
                    lowerBound(size.width - padding.width, 0.0),
                    context.layoutDirection
                ),
            edges.top + if (vertical) cursor else offset
        )
        val childIndex = selection.child(index)
        val placed = when (placement) {
            case Some(val place) -> place(childIndex, metric, origin)
            case None -> origin
        }
        context.placeChild(childIndex, placed)
        if (alphabetic == None) {
            when (metric.alphabeticBaseline) {
                case Some(val value) -> alphabetic = Some(value + origin.y)
                case None -> {}
            }
        }
        if (ideographic == None) {
            when (metric.ideographicBaseline) {
                case Some(val value) -> ideographic = Some(value + origin.y)
                case None -> {}
            }
        }
        cursor += flexMain(metric.size, vertical) + layout.spacing + spacing.between
    }
    return LayoutMetrics(size, alphabetic, ideographic)
}
