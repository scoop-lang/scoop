package scoop.ui.component

import scoop.graphics.Rect
import scoop.ui.*

internal fun containerScene(context: SceneContext, clip: Boolean, order: Array<Long>? = None) {
    if (!clip) {
        when (order) {
            case Some(val value) -> context.children(value);
            case None -> context.children()
        }
        return
    }
    val size = context.size
    context.withState {
        clipped ->
        clipped.clipRect(Rect(0.0, 0.0, size.width, size.height))
        when (order) {
            case Some(val value) -> clipped.children(value);
            case None -> clipped.children()
        }
    }
}

internal fun logicalX(
    start: Double,
    width: Double,
    available: Double,
    direction: LayoutDirection
): Double =
    if (direction == LayoutDirection.Rtl)
        available - start - width
    else
        start
