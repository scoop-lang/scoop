package scoop.ui.component

import scoop.graphics.*
import scoop.ui.*

public class Row public constructor(private val props: Props<LinearProps>): Component {
    public override fun render(): View = flexElement(props.value, false)
}

public class Column public constructor(private val props: Props<LinearProps>): Component {
    public override fun render(): View = flexElement(props.value, true)
}

public fun row(configure: LinearBuilder.() -> Unit = {}): View = makeRow(configure)

public fun column(configure: LinearBuilder.() -> Unit = {}): View = makeColumn(configure)

public class StackProps public constructor(
    public val children: Array<View>,
    public val alignment: Alignment = Alignment()
)

public class Stack public constructor(private val props: Props<StackProps>): Component {
    public override fun render(): View =
        element(props.value, { current -> StackInk(current) }, props.value.children)
}

public fun stack(configure: StackBuilder.() -> Unit = {}): View = makeStack(configure)

private class StackInk(private val props: Props<StackProps>): Element<Unit> {
    public override fun measure(context: MeasureContext, constraints: Constraints): LayoutResult<
        Unit
    > {
        val childConstraints =
            Constraints(maxWidth = constraints.maxWidth, maxHeight = constraints.maxHeight)
        val sizes =
            Array<Size>(context.childCount) {
                index -> context.measureChild(index, childConstraints).size
            }
        val plan = arrangeStack(sizes, constraints, props.value.alignment, context.layoutDirection)
        for (index in 0L until context.childCount)
            context.placeChild(index, plan.origins[index])
        return LayoutResult(LayoutMetrics(plan.size), Unit)
    }
    public override fun scene(context: SceneContext, measured: Unit) {
        context.children()
    }
}
