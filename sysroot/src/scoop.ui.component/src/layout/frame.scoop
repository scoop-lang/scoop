package scoop.ui.component

import scoop.graphics.*
import scoop.ui.*
import scoop.ui.style.*

public class FrameProps public constructor(
    public val content: View,
    public val width: Double? = None,
    public val height: Double? = None,
    public val padding: Insets? = None,
    public val alignment: Alignment = Alignment(),
    public val style: StyleOverride = styleOverride(),
    public val surface: SurfaceKind? = None,
    public val theme: ThemeSource? = None,
    public val logicalPadding: LogicalInsets? = None
) {
    init {
        when (width) {
            case Some(value) -> nonnegative(value, "invalid frame width");
            case None -> {}
        }
        when (height) {
            case Some(value) -> nonnegative(value, "invalid frame height");
            case None -> {}
        }
        padding?.totals()
        logicalPadding?.resolve(LayoutDirection.Ltr)
    }
}

public class Frame public constructor(
    private val props: Props<FrameProps>,
    scope: ComponentScope
): Component(scope) {
    private val themes = ThemeAccess()
    public override fun onMount() {
        when (props.value.surface) {
            case Some(_) -> themes.mount(props.value.theme);
            case None -> {}
        }
    }
    public override fun render(): View {
        val value = props.value
        val theme =
            when (value.surface) {
                case Some(_) -> Some(themes.read(value.theme));
                case None -> None
            }
        return element(
            FrameInput(value, theme),
            { current, mount -> FrameInk(current, scope = mount) },
            [value.content]
        )
    }
}

public fun frame(content: View, configure: FrameBuilder.() -> Unit = {}): View =
    makeFrame(content, configure)

private class FrameInput(val value: FrameProps, val theme: Theme?)

private struct FrameLayoutInputs(
    val width: Double?,
    val height: Double?,
    val insets: Insets,
    val minimum: Size,
    val suggested: Size,
    val alignment: Alignment
)

private fun frameOptions(input: FrameInput, direction: LayoutDirection): SurfaceOptions =
    surfaceOptions {
        this.padding =
            when (input.value.logicalPadding) {
                case Some(value) -> Some(value.resolve(direction))
                case None -> input.value.padding
            }
        this.style = input.value.style
    }

private fun frameLayoutInputs(input: FrameInput, direction: LayoutDirection): FrameLayoutInputs {
    val options = frameOptions(input, direction)
    val metrics =
        when (input.theme) {
            case Some(theme) -> Some(
                theme.surfaceMetrics(
                    SurfaceVisual(input.value.surface ?: SurfaceKind.Plain),
                    options,
                    direction
                )
            )
            case None -> None
        }
    return FrameLayoutInputs(
        input.value.width,
        input.value.height,
        metrics?.contentInsets ?: options.padding ?: Insets(),
        metrics?.minimumSize ?: Size(0.0, 0.0),
        metrics?.suggestedSize ?: Size(0.0, 0.0),
        input.value.alignment
    )
}

private class FrameInk(private val props: Props<FrameInput>, scope: ComponentScope): Element<Unit>(
    scope
) {
    private var painters: ThemePainterCache? = None
    private var style: StylePainter? = None
    private var previous: FrameLayoutInputs? = None
    private var previousTheme: Theme? = None
    public override fun onMount() {
        painters = Some(scope.resource { ThemePainterCache() })
        style = Some(scope.resource { StylePainter() })
    }
    public override fun update(): UiInvalidation {
        val input = props.value
        when (input.theme) {
            case Some(theme) -> painters!!.get(theme)
            case None -> painters!!.clear()
        }
        val next = frameLayoutInputs(input, scope.layoutDirection)
        val themeChanged =
            when (input.theme) {
                case Some(theme) -> !sameTheme(previousTheme, theme)
                case None -> panelPresent(previousTheme)
            }
        val changed = previous != Some(next) || themeChanged
        previous = Some(next)
        previousTheme = input.theme
        return if (changed)
            UiInvalidation.Layout
        else
            UiInvalidation.Scene
    }
    public override fun measure(context: MeasureContext, constraints: Constraints): LayoutResult<
        Unit
    > {
        val input = props.value
        val value = input.value
        val metrics = frameLayoutInputs(input, context.layoutDirection)
        val total = metrics.insets.totals()
        val child =
            context.measureChild(
                0L,
                frameChildConstraints(constraints, value.width, value.height, total)
            )
        val natural = Size(child.size.width + total.width, child.size.height + total.height)
        validSize(natural)
        val size =
            constraints.constrain(
                Size(
                    value.width ?:
                        lowerBound(
                            natural.width,
                            lowerBound(metrics.minimum.width, metrics.suggested.width)
                        ),
                    value.height ?:
                        lowerBound(
                            natural.height,
                            lowerBound(metrics.minimum.height, metrics.suggested.height)
                        )
                )
            )
        val bounds = Rect(0.0, 0.0, size.width, size.height)
        val content =
            when (input.theme) {
                case Some(theme) -> theme.surfaceGeometry(
                    bounds,
                    SurfaceVisual(value.surface ?: SurfaceKind.Plain),
                    frameOptions(input, context.layoutDirection),
                    context.layoutDirection
                ).content
                case None -> Rect(
                    metrics.insets.left,
                    metrics.insets.top,
                    lowerBound(size.width - total.width, 0.0),
                    lowerBound(size.height - total.height, 0.0)
                )
            }
        val origin = alignedOrigin(content, child.size, value.alignment, context.layoutDirection)
        context.placeChild(0L, origin)
        return LayoutResult(offsetMetrics(child, size, origin.y), Unit)
    }
    public override fun scene(context: SceneContext, measured: Unit) {
        val input = props.value
        when (input.theme) {
            case None -> style!!.scene(context, input.value.style.resolve(style())) {
                content -> content.children()
            }
            case Some(theme) -> {
                val visual = SurfaceVisual(input.value.surface ?: SurfaceKind.Plain)
                val geometry =
                    theme.surfaceGeometry(
                        Rect(0.0, 0.0, context.size.width, context.size.height),
                        visual,
                        frameOptions(input, context.layoutDirection),
                        context.layoutDirection
                    )
                val painter = painters!!.get(theme)
                if (geometry.opacity < 1.0)
                    context.saveLayer(geometry.opacity)
                context.draw {
                    paint -> painter.drawSurface(
                        paint.canvas,
                        geometry,
                        visual,
                        SurfaceLayer.Background
                    )
                }
                style!!.scene(context, geometry.bounds, geometry.contentStyle) {
                    content -> content.children()
                }
                context.draw {
                    paint -> painter.drawSurface(
                        paint.canvas,
                        geometry,
                        visual,
                        SurfaceLayer.Foreground
                    )
                }
                if (geometry.opacity < 1.0)
                    context.restore()
            }
        }
    }
}
