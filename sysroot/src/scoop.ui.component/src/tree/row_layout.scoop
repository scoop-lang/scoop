package scoop.ui.component

import scoop.graphics.*
import scoop.surface.*
import scoop.ui.*
import scoop.window.accessibility.*

private const val treeCellPadding: Double = 4.0

internal const val treeRowSlotSize: Double = 20.0

internal class TreeRowDrawing<T>(
    val input: TreeRowInput<T>,
    val owner: TreeRowView<T>,
    val selected: Boolean,
    val interaction: InteractionState
)

internal class TreeRowInk<T>(private val props: Props<TreeRowDrawing<T>>, scope: ComponentScope) :
    Element<Rect>(scope) {
    // The row's main target lives outside this group; only F2 enters cell Tab order.
    private val group = scope.focusScope()
    private val selected = scope.animation(if (props.value.selected) 1.0 else 0.0)
    private val hovered = scope.animation(if (props.value.interaction.hovered) 1.0 else 0.0)
    private val reveal = scope.animation(1.0)
    private var previous = props.value.input.plan.projection
    private var previousIndex = props.value.input.index
    public override fun onMount() {
        props.value.owner.cellGroup = Some(group)
        when (props.value.input.plan.controller.presented) {
            case Some(val old) ->
                if (old.indexOfKey(props.value.input.row.key) == None) reveal.snapTo(0.0)
            case None -> {}
        }
    }
    public override fun onUnmount() {
        props.value.owner.cellGroup = None
    }
    public override fun update(): UiInvalidation {
        val drawing = props.value
        drawing.owner.update()
        val input = drawing.input
        val motion = input.plan.appearance.theme.tokens.motion
        val enabled = input.plan.input.enabled && input.row.node.enabled
        changeProgress(
            selected,
            if (drawing.selected) 1.0 else 0.0,
            if (enabled) motion.resolve(motion.selection) else None
        )
        changeProgress(
            hovered, if (drawing.interaction.hovered && enabled) 1.0 else 0.0,
            if (enabled) motion.resolve(motion.hover) else None
        )
        if (previous !== input.plan.projection && previousIndex != input.index) reveal.snapTo(0.72)
        previous = input.plan.projection
        previousIndex = input.index
        changeProgress(reveal, 1.0, if (enabled) motion.resolve(motion.selection) else None)
        return UiInvalidation.Layout
    }
    public override fun measure(context: MeasureContext, constraints: Constraints): LayoutResult<
        Rect
    > {
        val plan = props.value.input.plan
        val widths = plan.tracks.resolve(constraints.maxWidth ?: constraints.minWidth)
        val count = if (plan.explicit) plan.columns.size else 1L
        val sizes = ArrayList<Size>()
        var height = 24.0 * plan.appearance.density
        for (index in 0L..<count) {
            val value = context
                .measureChild(
                    index,
                    Constraints(
                        widths.values[index],
                        Some(widths.values[index]),
                        maxHeight = constraints.maxHeight
                    )
                )
            sizes.add(value.size)
            height = lowerBound(height, value.size.height)
        }
        val size = constraints.constrain(Size(widths.total, height))
        val treeIndex = plan.columnIndex(plan.treeColumn)!!
        val rtl = context.layoutDirection == LayoutDirection.Rtl
        var treeX = 0.0
        var x = 0.0
        for (index in 0L..<count) {
            val childX = if (rtl) widths.total - x - sizes[index].width else x
            if (index == treeIndex) treeX = childX
            context
                .placeChild(
                    index,
                    Point(childX, lowerBound((size.height - sizes[index].height) / 2.0, 0.0))
                )
            x += widths.values[index]
        }
        return LayoutResult(
            LayoutMetrics(size),
            Rect(treeX, 0.0, sizes[treeIndex].width, size.height)
        )
    }
    public override fun scene(context: SceneContext, treeColumn: Rect) {
        val drawing = props.value
        val plan = drawing.input.plan
        val palette = plan.appearance.theme.tokens.palette
        val bounds = Rect(0.0, 0.0, context.size.width, context.size.height)
        val direction = context.layoutDirection
        val selection = selected.value
        val hover = hovered.value
        context
            .draw { paint ->
                // Round fills and guides at the same device-pixel boundary between rows.
                paint
                    .canvas
                    .drawRect(
                        bounds, Paint(
                            palette.background.background.withAlpha(1.0),
                            antiAlias = false
                        )
                    )
                if (hover > 0.0)
                    paint
                        .canvas
                        .drawRect(
                            bounds,
                            Paint(
                                palette.muted.background.withAlpha(0.5 * hover),
                                antiAlias = false
                            )
                        )
                if (selection > 0.0)
                    paint
                        .canvas
                        .drawRect(
                            bounds,
                            Paint(palette.muted.background.withAlpha(selection), antiAlias = false)
                        )
                if (plan.input.showLines)
                    drawTreeLines(paint.canvas, drawing.input, treeColumn, direction)
                if (drawing.interaction.focusVisible) {
                    val line = lowerBound(plan.appearance.density, 1.0)
                    paint.canvas.drawRect(Rect(0.0, 0.0, bounds.width, line), Paint(palette.ring))
                    paint
                        .canvas
                        .drawRect(
                            Rect(0.0, lowerBound(bounds.height - line, 0.0), bounds.width, line),
                            Paint(palette.ring)
                        )
                }
            }
        if (plan.explicit || plan.input.fullRow || panelPresent(plan.input.drag))
            context.place(drawing.owner.area, bounds)
        context.save()
        context.clipRect(bounds)
        context.saveBackdropLayer(reveal.value)
        context.children()
        // Restore the reveal layer and row clip before drawing drag feedback.
        context.restore()
        context.restore()
        drawing.owner.drag?.scene(context, bounds)
    }
}

internal class TreeCellInput<T>(
    val row: TreeRowInput<T>,
    val owner: TreeRowView<T>,
    val column: Long,
    val id: String,
    val content: View,
    val alignment: AxisAlignment
)

internal fun <T> treeCell(
    row: TreeRowInput<T>,
    owner: TreeRowView<T>,
    column: Long,
    id: String,
    content: View,
    alignment: AxisAlignment
): View = component(
    TreeCellInput(row, owner, column, id, content, alignment),
    { value, scope -> TreeCellView(value, scope) },
    ViewKey.Text(id)
)

private class TreeCellView<T>(private val props: Props<TreeCellInput<T>>, scope: ComponentScope) :
    Component(scope) {
    private val target = TreeCellTarget(scope, scope.focusScope())
    public override fun onMount() {
        props.value.owner.cells[props.value.id] = target
    }
    public override fun onUnmount() {
        props.value.owner.cells.remove(props.value.id)
    }
    public override fun render(): View = element(
        props.value,
        { value, mount -> TreeCellInk(value, mount) },
        [props.value.content]
    )
}

private class TreeCellInk<T>(private val props: Props<TreeCellInput<T>>, scope: ComponentScope) :
    Element<Rect>(scope) {
    private val semantics = createComponentSemantics(scope, SemanticRole.Cell)
    init {
        scope.routeSemanticsChildren(semantics)
    }
    public override fun update(): UiInvalidation {
        val input = props.value
        val plan = input.row.plan
        val row = input.row.row
        semantics
            ?.update(
                SemanticProperties(
                    ignored = !plan.explicit,
                    cell = if (plan.explicit)
                        Some(
                            SemanticTableCell(
                                input.row.index,
                                input.column,
                                columnKey = Some(SemanticItemKey.Text(input.id))
                            )
                        )
                    else
                        None
                ),
                relations = SemanticRelations(
                    columnHeaders = if (plan.explicit)
                        semanticIds(plan.headers[input.column].id)
                    else
                        []
                )
            )
        return UiInvalidation.Layout
    }
    public override fun measure(context: MeasureContext, constraints: Constraints): LayoutResult<
        Rect
    > {
        val input = props.value
        val density = input.row.plan.appearance.density
        val padding = treeCellPadding * density
        val child = context
            .measureChild(
                0L,
                Constraints(
                    maxWidth = insetMaximum(constraints.maxWidth, padding * 2.0),
                    maxHeight = insetMaximum(constraints.maxHeight, padding * 2.0)
                )
            )
        val size = constraints
            .constrain(Size(child.size.width + padding * 2.0, child.size.height + padding * 2.0))
        val origin = alignedOrigin(
            Rect(
                padding,
                padding,
                lowerBound(size.width - padding * 2.0, 0.0),
                lowerBound(size.height - padding * 2.0, 0.0)
            ),
            child.size,
            Alignment(input.alignment, AxisAlignment.Center),
            context.layoutDirection
        )
        context.placeChild(0L, origin)
        return LayoutResult(LayoutMetrics(size), Rect(origin.x, 0.0, child.size.width, size.height))
    }
    public override fun scene(context: SceneContext, content: Rect) {
        val input = props.value
        val plan = input.row.plan
        val bounds = Rect(0.0, 0.0, context.size.width, context.size.height)
        when (semantics) {
            case Some(val value) -> context.semantics(value, bounds);
            case None -> {}
        }
        if (input.id ==
            plan.treeColumn &&
            !plan.explicit &&
            !plan.input.fullRow &&
            !panelPresent(plan.input.drag)
        )
            context.place(input.owner.area, content)
        context.clipRect(bounds)
        context.children()
    }
}

private fun <T> drawTreeLines(
    canvas: Canvas,
    input: TreeRowInput<T>,
    column: Rect,
    direction: LayoutDirection
) {
    val plan = input.plan
    val row = input.row
    val hasVisibleChildren = row.subtreeEnd > input.index + 1L
    if (row.depth == 0L && !hasVisibleChildren) return
    val density = plan.appearance.density
    val step = plan.input.indent * density
    val halfSlot = treeRowSlotSize / 2.0 * density
    val rtl = direction == LayoutDirection.Rtl
    val columnRight = column.x + column.width
    val height = column.height
    val center = height / 2.0
    val color = Paint(plan.appearance.theme.tokens.palette.border, antiAlias = false)
    fun stemX(depth: Long): Double {
        val offset = treeCellPadding * density + halfSlot + depth.toDouble() * step
        return if (rtl) columnRight - offset - density else column.x + offset
    }
    fun segment(x: Double, width: Double, top: Double, bottom: Double) {
        val left = lowerBound(x, column.x)
        val right = upperBound(x + width, columnRight)
        if (right > left && bottom > top)
            canvas.drawRect(Rect(left, top, right - left, bottom - top), color)
    }
    var at = row.parent
    while (at != None) {
        val ancestor = plan.projection.rowAt(at!!)
        if (ancestor.depth > 0L && !ancestor.lastSibling)
            segment(stemX(ancestor.depth - 1L), density, 0.0, height)
        at = ancestor.parent
    }
    if (row.depth > 0L) {
        val x = stemX(row.depth - 1L)
        val top = lowerBound(center - density / 2.0, 0.0)
        val bottom = upperBound(center + density / 2.0, height)
        segment(x, density, 0.0, if (row.lastSibling) bottom else height)
        segment(if (rtl) x + density - step else x + density, step - density, top, bottom)
    }
    if (hasVisibleChildren) segment(stemX(row.depth), density, center + halfSlot, height)
}
