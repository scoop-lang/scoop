package scoop.ui.component

import scoop.graphics.*
import scoop.ui.*
import scoop.ui.style.*

/** Bars share resolved bounds, including the fixed corner of a gutter layout. */
internal class ScrollBarsLayout(
    size: Size,
    snapshot: ScrollSnapshot,
    axes: ScrollAxes,
    visibility: ScrollbarVisibility,
    thickness: Double,
    direction: LayoutDirection,
    placement: ScrollbarPlacement = ScrollbarPlacement.Overlay
) {
    private val width = upperBound(thickness, size.width)
    private val height = upperBound(thickness, size.height)
    private val hasX =
        axes.horizontal &&
            showScrollbar(visibility, snapshot.bodySize.width - snapshot.viewport.width) &&
            height >
            0.0 &&
            size.width >
            0.0
    private val hasY =
        axes.vertical &&
            showScrollbar(visibility, snapshot.bodySize.height - snapshot.viewport.height) &&
            width >
            0.0 &&
            size.height >
            0.0
    private val cornerX =
        if (
            hasY ||
                (
                    placement ==
                        ScrollbarPlacement.Gutter &&
                        axes.vertical &&
                        visibility !=
                        ScrollbarVisibility.Hidden
                )
        )
            width
        else
            0.0
    private val cornerY =
        if (
            hasX ||
                (
                    placement ==
                        ScrollbarPlacement.Gutter &&
                        axes.horizontal &&
                        visibility !=
                        ScrollbarVisibility.Hidden
                )
        )
            height
        else
            0.0
    val horizontal: Rect? =
        if (hasX && size.width > cornerX)
            Some(
                Rect(
                    if (direction == LayoutDirection.Rtl)
                        cornerX
                    else
                        0.0,
                    size.height - height,
                    size.width - cornerX,
                    height
                )
            )
        else
            None
    val vertical: Rect? =
        if (hasY && size.height > cornerY)
            Some(
                Rect(
                    if (direction == LayoutDirection.Rtl)
                        0.0
                    else
                        size.width - width,
                    0.0,
                    width,
                    size.height - cornerY
                )
            )
        else
            None
}

internal fun scrollSurfaceOptions(local: StyleOverride, outline: OutlineStyle?): SurfaceOptions {
    val decoration =
        styleOverride {
            this.background(None)
            this.border(None)
            this.corners(Corners.all(0.0))
            this.boxShadows([])
        }.then(local).then(styleOverride { this.clipContent(true) })
    return surfaceOptions {
        this.minimumSize = Some(Size(0.0, 0.0))
        this.suggestedSize = Some(Size(0.0, 0.0))
        this.padding = Some(Insets(0.0, 0.0, 0.0, 0.0))
        this.style = decoration
        this.focus = outline
    }
}
