package scoop.ui.component

import scoop.graphics.*
import scoop.surface.*
import scoop.ui.*
import scoop.ui.style.*
import scoop.window.*
import scoop.window.accessibility.*

/** Pointer state uses only the geometry of an accepted frame. */
internal class ScrollBarControl(
    private val scope: ComponentScope,
    private val props: () -> ScrollControlProps,
    parent: InputArea,
    private val orientation: Orientation,
    private val feedback: ScrollbarFeedback,
    parentSemantics: SemanticsHandle?,
    private val publishSemantics: (SemanticsHandle, Orientation) -> Unit
) {
    private val semantics = createComponentSemantics(scope, SemanticRole.ScrollBar, parentSemantics)
    private val area = scope.createArea { context, event -> handle(context, event) }
    private var currentState = props().state
    private var geometry: ScrollbarGeometry? = None
    private var pointer: Point? = None
    private var hovered = false
    private var hover: ScrollbarRegion? = None
    private var pressed: ScrollbarRegion? = None
    private var grab = 0.0
    private var pageDirection = 0.0
    private var trackClaimed = false
    private var drag: Drag? = None
    private val width = scope.animation(feedback.options.idleWidth)
    private val strength = scope.animation(feedback.options.idleOpacity)

    init {
        drag =
            Some(
                scope.drag(
                    area,
                    dragOptions(),
                    { point -> acceptsDrag(point) },
                    { event -> handleDrag(event) }
                )
            )
        area.scope.parent = Some(parent.scope)
        scope.resource { area.scope.addDefaultAction { context, event -> handle(context, event) } }
        scope.resource {
            area.scope.addEventFinished {
                event -> when (event) {
                    case Pointer(
                        InputPointerEvent.Button(_, MouseButton.Left, ElementState.Released, _)
                    ) -> release()
                    else -> {}
                }
            }
        }
    }
    fun cancel() {
        drag!!.cancel()
        release()
    }
    fun update() {
        val value = props()
        if (value.state !== currentState) {
            cancel()
            geometry = None
            currentState = value.state
        }
        area.scope.enabled = value.enabled
        if (!value.enabled)
            cancel()
        drag!!.update(
            dragOptions(),
            { point -> acceptsDrag(point) },
            { event -> handleDrag(event) }
        )
        feedbackChanged()
        updateSemantics()
    }
    private fun updateSemantics() {
        when (semantics) {
            case Some(val handle) -> if (!handle.isClosed)
                publishSemantics(handle, orientation)
            case None -> {}
        }
    }
    fun feedbackChanged() {
        val options = feedback.options
        val active = pressed != None
        val over = hover != None
        val targetWidth =
            if (active)
                options.dragWidth
            else
                if (over)
                    options.hoverWidth
                else
                    options.idleWidth
        changeProgress(
            width,
            targetWidth,
            options.transition(
                if (targetWidth > width.target)
                    options.input.expandDuration
                else
                    options.input.contractDuration
            )
        )
        changeProgress(
            strength,
            if (active)
                options.dragOpacity
            else
                if (over)
                    options.hoverOpacity
                else
                    options.idleOpacity,
            options.transition(options.input.shadeDuration, true)
        )
    }
    fun scene(
        context: SceneContext,
        snapshot: ScrollSnapshot,
        bounds: Rect?,
        painter: ThemePainter
    ) {
        val value = props()
        val range = scrollbarAxis(orientation, snapshot.maximum)
        val extent =
            if (orientation == Orientation.Horizontal)
                snapshot.content.width
            else
                snapshot.content.height
        val visible =
            if (orientation == Orientation.Horizontal)
                snapshot.viewport.width
            else
                snapshot.viewport.height
        val alpha = strength.value * feedback.opacity.value
        val thickness = width.value
        val visual =
            ScrollbarVisual(
                orientation,
                if (range > 0.0)
                    scrollbarAxis(orientation, snapshot.offset) / range
                else
                    0.0,
                if (extent > 0.0)
                    upperBound(visible / extent, 1.0)
                else
                    1.0,
                value.enabled && range > 0.0,
                if (feedback.options.shade)
                    hover
                else
                    None,
                if (feedback.options.shade)
                    pressed
                else
                    None,
                alpha,
                feedback.options.showTrack
            )
        val next =
            when (bounds) {
                case Some(val rect) -> {
                    if (
                        rect.width >
                            0.0 &&
                            rect.height >
                            0.0 &&
                            alpha >
                            0.0 &&
                            thickness >
                            0.0 &&
                            feedback.options.baseThickness >
                            0.0
                    ) {
                        val shape = value.theme.scrollbarGeometry(rect, visual, value.scrollbar)
                        when (semantics) {
                            case Some(val handle) -> context.semantics(handle, rect)
                            case None -> {}
                        }
                        if (visual.enabled)
                            context.place(area, rect)
                        val baseline = feedback.options.baseThickness
                        context.draw {
                            paint -> drawScrollbarWidth(
                                paint.canvas,
                                painter,
                                shape,
                                visual,
                                thickness,
                                baseline
                            )
                        }
                        Some(shape)
                    } else
                        None
                }
                case None -> None
            }
        val state = currentState
        context.onFrameComplete {
            frame -> if (
                frame.submission ==
                    FrameSubmission.Accepted &&
                    currentState ===
                    state &&
                    scope.isMounted
            ) {
                geometry = next
                if (!panelPresent(next))
                    cancel()
                pointer = area.pointerPosition
                hovered = area.scope.isHovered
                refreshHover()
                updateSemantics()
            }
        }
    }
    private fun changed() {
        if (scope.isMounted) {
            feedbackChanged()
            scope.requestFrame()
        }
    }
    private fun refreshHover() {
        val next =
            when (geometry) {
                case Some(val shape) -> when (pointer) {
                    case Some(val point) -> if (hovered)
                        scrollbarPart(shape, point)
                    else
                        None
                    case None -> None
                }
                case None -> None
            }
        if (next != hover) {
            hover = next
            feedback.hover(orientation, next != None)
            if (pressed != None && pressed != Some(ScrollbarRegion.Thumb) && next == pressed)
                feedback.repeat(orientation, true) { repeatStep() }
            changed()
        }
    }
    private fun release() {
        feedback.stopRepeat(orientation)
        val wasPressed = pressed != None
        pressed = None
        val claimed = trackClaimed
        trackClaimed = false
        if (claimed && !area.isClosed)
            area.scope.cancelPointerClaim()
        if (wasPressed)
            changed()
    }
    private fun handle(context: RoutedEventContext, event: InputEvent) {
        if (context.phase == RoutedPhase.Notification) {
            when (event) {
                case Pointer(InputPointerEvent.Entered(_)) -> {
                    hovered = true
                    pointer = context.localPosition
                    refreshHover()
                }
                case Pointer(InputPointerEvent.Left(_)) -> {
                    hovered = false
                    pointer = None
                    refreshHover()
                }
                case Pointer(InputPointerEvent.Cancelled(_, _)) -> release()
                else -> {}
            }
            return
        }
        if (context.phase == RoutedPhase.Target) {
            pointer = context.localPosition
            refreshHover()
        }
        if (context.phase != RoutedPhase.Default || !props().enabled)
            return
        val shape = geometry ?: return
        val point = context.localPosition ?: return
        when (event) {
            case Pointer(
                InputPointerEvent.Button(_, MouseButton.Left, ElementState.Pressed, _)
            ) -> {
                val part = scrollbarPart(shape, point) ?: return
                if (
                    part ==
                        ScrollbarRegion.Thumb ||
                        (
                            part ==
                                ScrollbarRegion.Track &&
                                feedback.options.input.trackPress ==
                                ScrollbarTrackPress.Jump
                        )
                )
                    return
                if (!area.scope.claimPointer(MouseButton.Left))
                    return
                trackClaimed = true
                pressed = Some(part)
                pageDirection = scrollbarTrackDirection(shape, point)
                currentState.cancelAnimation()
                val moved = step(part)
                if (moved)
                    feedback.repeat(orientation, false) { repeatStep() }
                changed()
                context.consume()
            }
            case Pointer(
                InputPointerEvent.Button(_, MouseButton.Left, ElementState.Released, _)
            ) -> {
                if (pressed != None) {
                    release()
                    context.consume()
                }
            }
            else -> {}
        }
    }
    private fun step(part: ScrollbarRegion): Boolean {
        val distance =
            when (part) {
                case Decrement -> -props().lineStep
                case Increment -> props().lineStep
                case Track -> pageDirection *
                    if (orientation == Orientation.Horizontal)
                        currentState.snapshot.visibleSize.width
                    else
                        currentState.snapshot.visibleSize.height
                case Thumb -> return false
            }
        return moveBy(distance)
    }
    private fun repeatStep(): Boolean {
        if (!scope.isMounted || !props().enabled || !area.scope.isInputAllowed)
            return false
        val part = pressed ?: return false
        val shape = geometry ?: return false
        val point = area.pointerPosition ?: return false
        if (!hovered || scrollbarPart(shape, point) != Some(part))
            return false
        if (part == ScrollbarRegion.Track && scrollbarTrackDirection(shape, point) != pageDirection)
            return false
        return step(part)
    }
    private fun dragOptions(): DragOptions =
        DragOptions(
            if (orientation == Orientation.Horizontal)
                DragAxis.Horizontal
            else
                DragAxis.Vertical,
            threshold = 0.0,
            enabled = props().enabled
        )
    private fun acceptsDrag(point: Point): Boolean =
        when (geometry) {
            case Some(val shape) -> {
                val part = scrollbarPart(shape, point)
                part ==
                    Some(ScrollbarRegion.Thumb) ||
                    (
                        part ==
                            Some(ScrollbarRegion.Track) &&
                            feedback.options.input.trackPress ==
                            ScrollbarTrackPress.Jump
                    )
            }
            case None -> false
        }
    private fun handleDrag(event: DragEvent) {
        when (event) {
            case Started(val value) -> {
                val shape =
                    when (geometry) {
                        case Some(val value) -> value
                        case None -> {
                            drag!!.cancel();
                            return
                        }
                    }
                val jump = scrollbarPart(shape, value.position) == Some(ScrollbarRegion.Track)
                pressed = Some(ScrollbarRegion.Thumb)
                val origin = Point(shape.thumb.bounds.x, shape.thumb.bounds.y)
                grab =
                    if (jump)
                        0.5
                    else
                        if (shape.thumbLength > 0.0)
                            (
                                scrollbarAxis(orientation, value.position) -
                                    scrollbarAxis(orientation, origin)
                            ) /
                                shape.thumbLength
                        else
                            0.0
                currentState.cancelAnimation()
                changed()
                if (jump)
                    dragTo(value.position)
                else
                    currentState.beginLayoutRequest(ScrollOrigin.User)
            }
            case Moved(val value) -> dragTo(value.position)
            case Ended(val value) -> {
                dragTo(value.position);
                release()
            }
            case Cancelled(_, _) -> release()
        }
    }
    private fun dragTo(point: Point) {
        val shape =
            when (geometry) {
                case Some(val value) -> value
                case None -> {
                    drag!!.cancel();
                    return
                }
            }
        val offset = currentState.offset
        val destination =
            scrollbarThumbOffset(
                shape,
                point,
                grab,
                scrollbarAxis(orientation, currentState.maximum)
            )
        currentState.scrollTo(
            if (orientation == Orientation.Horizontal)
                Point(destination, offset.y)
            else
                Point(offset.x, destination),
            ScrollOrigin.User
        )
    }
    private fun moveBy(distance: Double): Boolean =
        currentState.scrollBy(
            if (orientation == Orientation.Horizontal)
                Point(distance, 0.0)
            else
                Point(0.0, distance),
            ScrollOrigin.User
        ) !=
            Point(0.0, 0.0)
}

internal fun scrollbarTrackDirection(shape: ScrollbarGeometry, point: Point): Double =
    if (
        scrollbarAxis(shape.orientation, point) <
            scrollbarAxis(shape.orientation, Point(shape.thumb.bounds.x, shape.thumb.bounds.y))
    )
        -1.0
    else
        1.0
