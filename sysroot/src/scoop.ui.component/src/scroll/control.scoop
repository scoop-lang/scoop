package scoop.ui.component

import scoop.graphics.*
import scoop.surface.*
import scoop.ui.*
import scoop.ui.style.*
import scoop.ui.style.Theme
import scoop.window.*

internal class ScrollControlProps(
    val state: ScrollState,
    val axes: ScrollAxes,
    val lineStep: Double,
    val chain: ScrollChain,
    val scrollbars: ScrollbarVisibility,
    val scrollbar: ScrollbarOptions,
    val enabled: Boolean,
    val focus: FocusOptions,
    val paintCache: PaintCachePolicy,
    val theme: Theme,
    val style: StyleOverride = styleOverride(),
    val focusOutline: OutlineStyle? = None,
    val scrollbarBehavior: ScrollbarBehavior = scrollbarBehavior()
)

/** Shared input, range publication and themed bars for eager and lazy viewports. */
internal class ScrollControl(
    private val scope: ComponentScope,
    private val props: () -> ScrollControlProps
) {
    private val painters = scope.resource { ThemePainterCache() }
    private val decoration = scope.resource { StylePainter() }
    val viewport = scope.scrollViewport(props().state)
    private val area =
        scope.createArea(focusable = true) { context, event -> handle(context, event) }
    private val focus = scope.focusTarget(area, props().focus)
    private val feedback =
        scope.resource { ScrollbarFeedback(scope, props, area) { feedbackChanged() } }
    private val horizontal = ScrollBarControl(scope, props, area, Orientation.Horizontal, feedback)
    private val vertical = ScrollBarControl(scope, props, area, Orientation.Vertical, feedback)
    private var direction = scope.layoutDirection
    private var reservation = Size(0.0, 0.0)
    val gutter: Size get() = reservation

    init {
        area.scope.defaultAction = { context, event -> handle(context, event) }
        scope.routeChildren(area)
    }
    private fun feedbackChanged() {
        horizontal.feedbackChanged()
        vertical.feedbackChanged()
        if (scope.isMounted)
            scope.requestFrame()
    }
    fun update(): Boolean {
        val value = props()
        requireComponent(
            value.lineStep.isFinite() && value.lineStep > 0.0,
            "invalid scroll line step"
        )
        viewport.state = value.state
        viewport.paintCache = value.paintCache
        focus.options = value.focus
        area.scope.enabled = value.enabled
        feedback.update()
        horizontal.update()
        vertical.update()
        painters.get(value.theme)
        val next =
            scrollbarGutter(
                value.axes,
                value.scrollbars,
                feedback.options.thickness,
                value.scrollbarBehavior.placement
            )
        val changed = next != gutter
        reservation = next
        return changed
    }
    fun contentViewport(outer: Size, direction: LayoutDirection): Rect =
        scrollbarViewport(outer, gutter, direction)
    fun layout(
        viewportSize: Size,
        contentSize: Size,
        adjustment: ScrollAdjustment? = None
    ): ScrollLayout {
        val value = props()
        val padding =
            scrollbarPadding(
                viewportSize,
                contentSize,
                value.axes,
                value.scrollbars,
                feedback.options.thickness,
                value.scrollbarBehavior.placement,
                scope.layoutDirection
            )
        return viewport.layout(viewportSize, contentSize, adjustment, padding)
    }
    fun scene(context: SceneContext, layout: ScrollLayout, contentOrigin: Point = Point(0.0, 0.0)) {
        val value = props()
        val snapshot = layout.snapshot
        val size = context.size
        val presentedDirection = context.layoutDirection
        val body = contentViewport(size, presentedDirection)
        context.onFrameComplete {
            frame -> if (frame.submission == FrameSubmission.Accepted && scope.isMounted) {
                if (direction != presentedDirection) {
                    horizontal.cancel()
                    vertical.cancel()
                }
                direction = presentedDirection
            }
        }
        val bounds = Rect(0.0, 0.0, size.width, size.height)
        val visual =
            SurfaceVisual(
                SurfaceKind.Plain,
                InteractionVisual(enabled = value.enabled, focusVisible = area.isFocusVisible)
            )
        val geometry =
            value.theme.surfaceGeometry(
                bounds,
                visual,
                scrollSurfaceOptions(value.style, value.focusOutline),
                presentedDirection
            )
        val painter = painters.get(value.theme)
        val bars =
            ScrollBarsLayout(
                size,
                snapshot,
                value.axes,
                value.scrollbars,
                feedback.options.thickness,
                presentedDirection,
                value.scrollbarBehavior.placement
            )
        context.draw {
            paint -> painter.drawSurface(paint.canvas, geometry, visual, SurfaceLayer.Background)
        }
        decoration.scene(context, bounds, geometry.contentStyle) {
            local ->
            local.place(area, bounds)
            local.save()
            try {
                local.translate(body.x, body.y)
                viewport.present(
                    local,
                    layout,
                    Some { content -> content.children() },
                    contentOrigin
                )
            } finally {
                local.restore()
            }
            feedback.scene(local, bounds, bars.horizontal, bars.vertical)
            horizontal.scene(local, snapshot, bars.horizontal, painter)
            vertical.scene(local, snapshot, bars.vertical, painter)
        }
        context.draw {
            paint -> painter.drawSurface(paint.canvas, geometry, visual, SurfaceLayer.Foreground)
        }
    }

    private fun handle(context: RoutedEventContext, event: InputEvent) {
        if (context.phase == RoutedPhase.Notification) {
            when (event) {
                case FocusChanged(_) -> {
                    if (scope.isMounted)
                        scope.requestFrame()
                }
                case FocusVisibilityChanged(_) -> {
                    if (scope.isMounted)
                        scope.requestFrame()
                }
                else -> {}
            }
            return
        }
        if (context.phase != RoutedPhase.Default || !props().enabled)
            return
        val input = props()
        val state = props().state
        when (event) {
            case Pointer(InputPointerEvent.Wheel(_, _, _, _)) -> {
                state.cancelAnimation()
                context.consumeScroll(input.lineStep) {
                    amount ->
                    val consumed =
                        state.scrollBy(
                            Point(
                                if (input.axes.horizontal)
                                    -amount.x
                                else
                                    0.0,
                                if (input.axes.vertical)
                                    -amount.y
                                else
                                    0.0
                            ),
                            ScrollOrigin.User
                        )
                    Point(-consumed.x, -consumed.y)
                }
                if (input.chain == ScrollChain.Contain)
                    context.preventDefault()
            }
            case Keyboard(val key) -> {
                if (context.target === area.scope && scrollKey(state, input.axes, direction, key))
                    context.consume()
            }
            else -> {}
        }
    }
}

private fun scrollKey(
    state: ScrollState,
    axes: ScrollAxes,
    direction: LayoutDirection,
    key: KeyEvent
): Boolean {
    val modifiers = key.modifiers
    if (
        key.state !=
            ElementState.Pressed ||
            key.synthetic ||
            modifiers.control ||
            modifiers.alt ||
            modifiers.shift ||
            modifiers.superKey ||
            modifiers.function
    )
        return false
    val current = state.snapshot
    val reversed = !axes.vertical && direction == LayoutDirection.Rtl
    val step =
        if (axes.vertical)
            Point(0.0, current.visibleSize.height)
        else
            Point(
                if (reversed)
                    -current.visibleSize.width
                else
                    current.visibleSize.width,
                0.0
            )
    when (key.logicalKey) {
        case Named(NamedKey.PageUp) -> state.scrollBy(Point(-step.x, -step.y), ScrollOrigin.User)
        case Named(NamedKey.PageDown) -> state.scrollBy(step, ScrollOrigin.User)
        case Named(NamedKey.Home) -> state.scrollTo(
            if (reversed)
                current.maximum
            else
                Point(0.0, 0.0),
            ScrollOrigin.User
        )
        case Named(NamedKey.End) -> state.scrollTo(
            if (reversed)
                Point(0.0, 0.0)
            else
                current.maximum,
            ScrollOrigin.User
        )
        else -> return false
    }
    return true
}
