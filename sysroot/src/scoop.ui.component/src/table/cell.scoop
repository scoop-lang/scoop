package scoop.ui.component

import scoop.graphics.*
import scoop.ui.*
import scoop.window.accessibility.*

internal class TableCellLayout(
    val padding: Double,
    val alignment: AxisAlignment,
    val natural: Boolean,
    val semantics: TableCellSemantics
)

/** Natural header/end content aligns within the shared column, not within a stretched label. */
internal class TableCellInk(
    private val props: Props<TableCellLayout>,
    scope: ComponentScope
): Element<Unit>(scope) {
    private var semantics: SemanticsHandle? = None
    public override fun update(): UiInvalidation {
        val input = props.value.semantics
        when (semantics) {
            case Some(val old) -> if (old.role != input.role) {
                old.close();
                semantics = None
            }
            case None -> {}
        }
        if (!panelPresent(semantics)) {
            semantics = createComponentSemantics(scope, input.role)
            scope.routeSemanticsChildren(semantics)
        }
        when (semantics) {
            case Some(val handle) -> {
                handle.mergeLabels = true
                handle.bindReference(input.reference)
                handle.update(input.properties, relations = input.relations)
            }
            case None -> {}
        }
        return UiInvalidation.Layout
    }
    public override fun measure(context: MeasureContext, constraints: Constraints): LayoutResult<
        Unit
    > {
        val input = props.value
        val inset = input.padding * 2.0
        val maximum = insetMaximum(constraints.maxWidth, inset)
        val height = insetMaximum(constraints.maxHeight, inset)
        val natural = input.natural || input.alignment != AxisAlignment.Start
        var child =
            context.measureChild(
                0L,
                Constraints(
                    maxWidth =
                        if (natural)
                            None
                        else
                            maximum,
                    maxHeight = height
                )
            )
        if (natural && child.size.width > (maximum ?: child.size.width))
            child = context.measureChild(0L, Constraints(maxWidth = maximum, maxHeight = height))
        val size = constraints.constrain(Size(child.size.width + inset, child.size.height + inset))
        val bounds =
            Rect(
                input.padding,
                input.padding,
                lowerBound(size.width - inset, 0.0),
                lowerBound(size.height - inset, 0.0)
            )
        val origin =
            alignedOrigin(
                bounds,
                child.size,
                Alignment(input.alignment, AxisAlignment.Center),
                context.layoutDirection
            )
        context.placeChild(0L, origin)
        return LayoutResult(offsetMetrics(child, size, origin.y), Unit)
    }
    public override fun scene(context: SceneContext, value: Unit) {
        when (semantics) {
            case Some(val handle) -> context.semantics(
                handle,
                Rect(0.0, 0.0, context.size.width, context.size.height)
            )
            case None -> {}
        }
        context.children()
    }
}
