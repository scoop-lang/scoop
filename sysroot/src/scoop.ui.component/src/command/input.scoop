package scoop.ui.component

import scoop.graphics.*
import scoop.icons.lucide.search as searchIcon
import scoop.ui.*
import scoop.ui.style.*
import scoop.ui.style.Theme
import scoop.window.accessibility.*

internal fun commandInput(
    input: CommandProps,
    focus: FocusHandle,
    theme: Theme,
    collection: SemanticNodeId?,
    active: ViewKey?
): View {
    val field = input.input
    val density = theme.tokens.typography.body.fontSize / 14.0
    val editor =
        InputProps(
            field.state,
            field.placeholder,
            field.enabled,
            field.readOnly,
            field.invalid,
            field.description,
            field.fonts,
            field.style,
            field.theme,
            field.focus.copy { handle = Some(focus) },
            field.direction,
            field.alignment,
            field.paintCache,
            field.caretBlink,
            field.onEdited,
            field.onSubmit,
            field.policy,
            field.projection,
            field.copy,
            field.labelTarget,
            field.group,
            field.chrome,
            field.contextMenu,
            field.protectedText,
            candidateInputSemantics(field.semantics, collection, active),
            field.acceptDrops,
            field.drag,
            field.touch,
            field.touchScroll,
            field.scrollPhysics,
            inputPurpose = field.inputPurpose,
            softwareKeyboard = field.softwareKeyboard,
            primarySelection = field.primarySelection,
            automaticTextReplacement = field.automaticTextReplacement
        )
    val addons = ArrayList<InputGroupAddon>()
    if (input.showSearchIcon)
        addons.add(
            InputGroupAddon(
                input.searchIcon ?:
                    makeIcon(searchIcon) {
                        size = 16.0 * density
                        color =
                            Some(
                                componentForeground(
                                    theme,
                                    theme.tokens.palette.muted.foreground,
                                    theme.tokens.palette.background.background,
                                    3.0
                                )
                            )
                    },
                key = ViewKey.Text("search")
            )
        )
    val group =
        component(
            InputGroupProps(
                InputGroupControl.Input(editor),
                addons.toArray(),
                enabled = field.enabled,
                invalid = field.invalid,
                fonts = field.fonts,
                theme = field.theme,
                surface =
                    field.style.surface.copy {
                        style = commandInputDecoration(theme).then(field.style.surface.style)
                    }
            ),
            { current, mount -> InputGroup(current, scope = mount) }
        )
    return panelFrame(group, Insets(16.0 * density, 16.0 * density, 16.0 * density, 4.0 * density))
}

internal fun commandInputDecoration(theme: Theme): StyleOverride {
    val colors = theme.tokens.palette
    val ink = colors.input.withAlpha(colors.input.alpha * 0.3)
    return styleOverride {
        background(
            Some(
                Paint(
                    if (theme.preferences.highContrast)
                        colors.background.background
                    else
                        componentBackground(theme, ink)
                )
            )
        )
        border(
            Some(
                Border.all(1.0, componentForeground(theme, ink, colors.background.background, 3.0))
            )
        )
        corners(Corners.all(8.0 * theme.tokens.typography.body.fontSize / 14.0))
        boxShadows([])
    }
}
