package scoop.ui.component

import scoop.graphics.text.*
import scoop.time.Duration
import scoop.ui.*
import scoop.ui.style.ThemeSource
import scoop.ui.text.*
import scoop.window.TextInputPurpose

public class TextareaProps public constructor(
    public val state: TextEditorState,
    public val placeholder: String = "",
    public val rows: Long = 4L,
    public val wrap: Boolean = true,
    public val tab: TextTabBehavior = TextTabBehavior.Navigate,
    public val submit: TextSubmitKeys = TextSubmitKeys.PrimaryEnter,
    public val enabled: Boolean = true,
    public val readOnly: Boolean = false,
    public val invalid: Boolean = false,
    public val description: String = "",
    public val fonts: FontCollection? = None,
    public val style: TextFieldStyle = textFieldStyle(),
    public val theme: ThemeSource? = None,
    public val focus: FocusOptions = FocusOptions(),
    public val direction: TextDirection? = None,
    public val alignment: TextAlignment = TextAlignment.Start,
    public val scrollbars: ScrollbarVisibility = ScrollbarVisibility.Auto,
    public val paintCache: PaintCachePolicy = PaintCachePolicy.None,
    public val caretBlink: Duration? = None,
    public val onEdited: (TextEditorState) -> Unit = { _ -> Unit },
    public val onSubmit: (TextEditorState) -> Unit = { _ -> Unit },
    public val policy: TextEditPolicy = textEditPolicy(),
    public val projection: TextProjection = textProjection(),
    public val copy: TextCopyPolicy = TextCopyPolicy.Default,
    public val labelTarget: FieldTarget? = None,
    public val group: GroupPosition? = None,
    public val chrome: TextFieldChrome = TextFieldChrome.Framed,
    public val contextMenu: TextContextMenuOptions = TextContextMenuOptions(),
    public val scrollbarBehavior: ScrollbarBehavior =
        scrollbarBehavior { placement = ScrollbarPlacement.Gutter },
    public val protectedText: Boolean = false,
    public val semantics: ComponentSemantics = ComponentSemantics(),
    public val acceptDrops: Boolean = true,
    public val drag: TextDragOptions = TextDragOptions(),
    public val touch: TextTouchOptions = TextTouchOptions(),
    public val touchScroll: TouchScrollOptions = TouchScrollOptions(),
    public val scrollPhysics: ScrollPhysicsOptions = ScrollPhysicsOptions(),
    public val inputPurpose: TextInputPurpose = TextInputPurpose.Normal,
    public val softwareKeyboard: Boolean = true,
    public val primarySelection: TextPrimarySelectionOptions = TextPrimarySelectionOptions(),
    public val automaticTextReplacement: Boolean = false
) {
    init {
        requireComponent(rows > 0L, "text field rows must be positive")
    }
}

/** A fixed-row viewport; text, selection and history live in the shared editor model. */
public class Textarea public constructor(
    private val props: Props<TextareaProps>,
    scope: ComponentScope
): Component(scope) {
    private val field = TextFieldRenderer(scope)
    public override fun render(): View = field.render(multilineInput(props.value))
}

private fun multilineInput(input: TextareaProps): TextFieldInput =
    TextFieldInput(
        input.state,
        input.placeholder,
        input.invalid,
        input.description,
        input.fonts,
        input.style,
        input.theme,
        input.focus,
        TextEditOptions(
            multiline = true,
            wrap = input.wrap,
            readOnly = input.readOnly,
            enabled = input.enabled,
            tab = input.tab,
            submit = input.submit,
            direction = input.direction,
            alignment = input.alignment,
            paintCache = input.paintCache,
            caretBlink = input.caretBlink,
            policy = input.policy,
            projection = input.projection,
            copy = input.copy,
            contextMenu = input.contextMenu,
            protectedText = input.protectedText,
            acceptDrops = input.acceptDrops,
            drag = input.drag,
            touch = input.touch,
            touchScroll = input.touchScroll,
            scrollPhysics = input.scrollPhysics,
            inputPurpose = input.inputPurpose,
            softwareKeyboard = input.softwareKeyboard,
            primarySelection = input.primarySelection,
            automaticTextReplacement = input.automaticTextReplacement
        ),
        input.rows,
        input.scrollbars,
        input.onEdited,
        input.onSubmit,
        input.labelTarget,
        input.group,
        input.chrome,
        input.scrollbarBehavior,
        input.semantics
    )

public fun textarea(state: TextEditorState, configure: TextareaBuilder.() -> Unit = {}): View =
    makeTextarea(state, configure)
