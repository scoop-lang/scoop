package scoop.ui.component

import scoop.graphics.*
import scoop.surface.*
import scoop.ui.*
import scoop.ui.style.*

internal class CarouselLayoutResult(val geometry: CarouselGeometry, val visible: Array<Boolean>)

internal class CarouselViewport(private val props: Props<CarouselInput>): Element<
    CarouselLayoutResult
> {
    private var control: CarouselControl? = None
    private var painter: StylePainter? = None
    private var ring: ThemePainterCache? = None
    public override fun onMount(scope: ComponentScope) {
        val value = CarouselControl(scope, { props.value });
        control = Some(value)
        props.value.owner.control = Some(value)
        painter = Some(scope.resource { StylePainter() });
        ring = Some(scope.resource { ThemePainterCache() })
    }
    public override fun update(): UiInvalidation {
        control!!.update();
        ring!!.get(props.value.theme)
        return UiInvalidation.Layout
    }
    public override fun measure(context: MeasureContext, constraints: Constraints): LayoutResult<
        CarouselLayoutResult
    > {
        val input = props.value
        val horizontal = input.props.orientation == Orientation.Horizontal
        val density = input.theme.tokens.typography.body.fontSize / 14.0
        val padding = input.props.viewport.padding * density
        val main =
            (
                if (horizontal)
                    constraints.maxWidth
                else
                    constraints.maxHeight
            ) ?:
                0.0
        val innerMain = lowerBound(0.0, main - padding * 2.0)
        val maxCross =
            if (horizontal)
                constraints.maxHeight
            else
                constraints.maxWidth
        val innerMaxCross =
            when (maxCross) {
                case Some(value) -> Some(lowerBound(0.0, value - padding * 2.0));
                case None -> None
            }
        val spacing = input.props.spacing * density
        var naturalCross = 0.0
        val sizes = ArrayList<Double>()
        for (index in 0L ..< context.childCount) {
            val extent = carouselExtent(input.props.itemSize(index), innerMain, spacing)
            val measured =
                context.measureChild(
                    index,
                    if (horizontal)
                        Constraints(extent ?: 0.0, extent, 0.0, innerMaxCross)
                    else
                        Constraints(0.0, innerMaxCross, extent ?: 0.0, extent)
                )
            naturalCross =
                lowerBound(
                    naturalCross,
                    if (horizontal)
                        measured.size.height
                    else
                        measured.size.width
                )
            sizes.add(
                if (horizontal)
                    measured.size.width
                else
                    measured.size.height
            )
        }
        val extents = sizes.toArray()
        val size =
            constraints.constrain(resizableSize(main, naturalCross + padding * 2.0, horizontal))
        val inner =
            Rect(
                upperBound(padding, size.width),
                upperBound(padding, size.height),
                lowerBound(0.0, size.width - padding * 2.0),
                lowerBound(0.0, size.height - padding * 2.0)
            )
        val cross =
            if (horizontal)
                inner.height
            else
                inner.width
        val shape =
            CarouselGeometry(
                size,
                inner,
                carouselTrack(extents, innerMain, spacing, input.props.loop),
                input.keys,
                input.props.orientation,
                context.layoutDirection
            )
        val offset = control!!.visualPosition(shape)
        val visible = MutableArray<Boolean>(context.childCount) { _ -> false }
        for (index in 0L ..< context.childCount) {
            val child =
                context.measureChild(
                    index,
                    Constraints.tight(resizableSize(extents[index], cross, horizontal))
                )
            val position = carouselItemPosition(shape.track, index, offset)
            if (
                position <
                    shape.track.viewport &&
                    position +
                    extents[index] >
                    0.0 &&
                    child.size.width >
                    0.0 &&
                    child.size.height >
                    0.0
            ) {
                visible[index] = true
                val along =
                    if (horizontal)
                        logicalX(position, child.size.width, inner.width, shape.direction)
                    else
                        position
                context.placeChild(
                    index,
                    Point(
                        inner.x +
                            if (horizontal)
                                along
                            else
                                0.0,
                        inner.y +
                            if (horizontal)
                                0.0
                            else
                                along
                    )
                )
            }
        }
        return LayoutResult(
            LayoutMetrics(size),
            CarouselLayoutResult(shape, Array<Boolean>(visible.size) { index -> visible[index] })
        )
    }
    public override fun scene(context: SceneContext, layout: CarouselLayoutResult) {
        val input = props.value
        val shape = layout.geometry
        val bounds = Rect(0.0, 0.0, context.size.width, context.size.height)
        if (bounds.width > 0.0 && bounds.height > 0.0)
            context.place(control!!.area, bounds)
        painter!!.scene(context, input.props.viewport.style.resolve(style())) {
            local ->
            local.clipRect(bounds);
            local.children()
        }
        if (control!!.area.isFocusVisible) {
            val visual = SurfaceVisual(SurfaceKind.Plain, InteractionVisual(focusVisible = true))
            val geometry =
                input.theme.surfaceGeometry(
                    bounds,
                    visual,
                    surfaceOptions {
                        style {
                            background(None);
                            border(None);
                            corners(Corners.all(0.0))
                        }
                        focus = Some(OutlineStyle(input.theme.tokens.palette.ring, 1.0, 1.0))
                    },
                    context.layoutDirection
                )
            context.draw {
                paint -> ring!!.get(input.theme).drawSurface(paint.canvas, geometry, visual)
            }
        }
        context.onFrameComplete {
            frame -> if (frame.submission == FrameSubmission.Accepted) {
                for (index in 0L ..< input.items.size)
                    when (input.items[index].scope) {
                        case Some(scope) -> if (scope.isMounted)
                            scope.input.enabled = layout.visible[index]
                        case None -> {}
                    }
                control!!.accept(shape)
            }
        }
    }
    public override fun onUnmount() {
        control!!.retire()
    }
}

internal class CarouselItemOwner {
    var scope: ComponentScope? = None
}

/** The keyed scope follows only the final viewport placement. */
internal class CarouselItemLayout(private val props: Props<CarouselItemOwner>): Element<Unit> {
    private var scope: ComponentScope? = None
    private var owner: CarouselItemOwner? = None
    public override fun onMount(scope: ComponentScope) {
        this.scope = Some(scope)
        scope.input.enabled = false
    }
    public override fun update(): UiInvalidation {
        when (owner) {
            case Some(previous) -> previous.scope = None
            case None -> {}
        }
        owner = Some(props.value)
        props.value.scope = scope
        return UiInvalidation.Layout
    }
    public override fun onUnmount() {
        when (owner) {
            case Some(previous) -> previous.scope = None
            case None -> {}
        }
    }
    public override fun measure(context: MeasureContext, constraints: Constraints): LayoutResult<
        Unit
    > {
        val child = context.measureChild(0L, constraints)
        context.placeChild(0L, Point(0.0, 0.0))
        return LayoutResult(child, Unit)
    }
    public override fun scene(context: SceneContext, measured: Unit) {
        context.children()
    }
}
