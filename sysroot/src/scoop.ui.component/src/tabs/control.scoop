package scoop.ui.component

import scoop.ui.*
import scoop.ui.style.*

internal class TabControlProps(
    val content: ButtonContent,
    val selected: Boolean,
    val enabled: Boolean,
    val variant: TabsVariant,
    val axis: FlexAxis,
    val style: ButtonStyle,
    val focus: FocusOptions,
    val theme: Theme,
    val activate: () -> Unit
)

internal class TabControl(private val props: Props<TabControlProps>): Component {
    private val control = state<PressControl?>(None)
    private val text = ActionTextStyle()
    public override fun onMount(scope: ComponentScope) {
        val area = scope.createArea(focusable = true)
        val focus = scope.focusTarget(area, props.value.focus)
        val press = scope.press(area, PressOptions(props.value.enabled)) { props.value.activate() }
        scope.routeChildren(area)
        control.value = Some(PressControl(area, focus, press))
    }
    public override fun render(): View {
        val input = props.value
        val interaction =
            when (control.value) {
                case Some(value) -> value.press.interaction;
                case None -> InteractionState()
            }
        val visual = SurfaceVisual(input.style.kind, interaction.asVisual(input.enabled, false))
        val shape = ActionShape.Tab(input.variant, input.selected)
        val base =
            text.resolve(
                input.theme.tokens.typography.action,
                actionTextColor(input.theme, shape, ButtonVariant.Ghost, visual),
                input.style.text,
                actionFontScale(shape),
                actionLineHeight(shape)
            )
        return element(
            TabIndicatorProps(
                input.selected && input.variant == TabsVariant.Line,
                input.axis,
                input.theme,
                input.enabled
            ),
            { current -> TabIndicator(current) },
            [
                element(
                    ActionInkProps(
                        input.theme,
                        shape,
                        ButtonVariant.Ghost,
                        input.style,
                        visual,
                        ActionBehavior.Press(control, input.activate, input.focus)
                    ),
                    { current -> ActionInk(current) },
                    [
                        actionContent(
                            input.content,
                            actionContentStyle(base, shape, ButtonVariant.Ghost, visual.interaction)
                        )
                    ]
                )
            ]
        )
    }
}
