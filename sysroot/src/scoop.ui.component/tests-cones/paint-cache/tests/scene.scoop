package scoop.tests.ui.paintcache

import scoop.graphics.*
import scoop.graphics.native.withSkiaCanvas
import scoop.surface.FrameSubmission
import scoop.tests.graphics.readNativePixel
import scoop.ui.*
import scoop.ui.component.*

internal class CacheScene(private val probe: CacheProbe, scope: ComponentScope): Component(scope) {
    private val sources = Array<ItemSource>(4L) { index -> PaintSource(probe, index.toInt()) }
    public override fun render(): View {
        val mode = probe.mode.value
        val policy = probe.policy.value
        return cachedScene(
            element(
                probe.placed.value,
                { props, mount -> CachePanel(probe, props, scope = mount) },
                [
                    virtualList(sources[mode.toLong()], ItemExtent.Fixed(24.0)) {
                        this.state = Some(this @CacheScene.probe.scroll)
                        this.scrollbars = ScrollbarVisibility.Hidden
                        this.theme = Some(this @CacheScene.probe.theme)
                        this.retention =
                            if (mode >= 2)
                                ItemRetention.KeepAlive(3L)
                            else
                                ItemRetention.Dispose
                        this.paintCache = policy
                    },
                    scrollArea(paintRow(probe, mode, -1L)) {
                        this.state = Some(this @CacheScene.probe.eagerScroll)
                        this.scrollbars = ScrollbarVisibility.Hidden
                        this.theme = Some(this @CacheScene.probe.theme)
                        this.paintCache = policy
                    }
                ],
                ViewKey.Number(mode.toLong())
            )
        )
    }
}

private class CachePanel(
    private val probe: CacheProbe,
    private val props: Props<Boolean>,
    scope: ComponentScope
): Element<Unit>(scope) {
    public override fun onMount() {
        probe.scope = Some(scope)
    }
    public override fun measure(context: MeasureContext, constraints: Constraints): LayoutResult<
        Unit
    > {
        context.measureChild(0L, Constraints.tight(Size(144.0, 48.0)))
        if (props.value)
            context.placeChild(0L, Point(16.0, 16.0))
        context.measureChild(1L, Constraints.tight(Size(120.0, 48.0)))
        context.placeChild(1L, Point(180.0, 16.0))
        return LayoutResult(LayoutMetrics(constraints.constrain(Size(320.0, 120.0))), Unit)
    }
    public override fun scene(context: SceneContext, measured: Unit) {
        probe.passes += 1
        context.draw { paint -> paint.canvas.clear(Color.White) }
        context.children()
        context.draw {
            paint -> @Unsafe
            {
                paint.canvas.withSkiaCanvas {
                    native -> @Unsafe
                    {
                        probe.inside = readNativePixel(native, 156.0, 20.0)
                        probe.outside = readNativePixel(native, 164.0, 20.0)
                    }
                }
            }
        }
        val ticket = probe.ticket
        context.onFrameComplete {
            frame -> if (frame.submission == FrameSubmission.Accepted)
                probe.accepted(ticket)
        }
    }
}
