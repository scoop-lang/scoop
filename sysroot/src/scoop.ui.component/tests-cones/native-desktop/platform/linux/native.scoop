package scoop.tests.ui.native_desktop

import scoop.window.*
import scoop.window.native.*

internal fun nativeMenuLabel(target: Window, activate: Boolean = false): Int {
    @Unsafe
    {
        return target.acquireNativeWindow().use {
            lease -> @Unsafe
            {
                when (lease.handle) {
                    case Gtk(window, _) -> return@use menuProbe(
                        window,
                        if (activate)
                            1
                        else
                            0
                    )
                }
            }
        }
    }
}

@Extern(name = "scoop_test_native_ui_menu")
private fun menuProbe(window: Ptr<Unit>, activate: Int): Int
