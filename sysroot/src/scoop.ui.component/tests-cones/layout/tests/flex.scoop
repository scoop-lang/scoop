package scoop.tests.ui.layout

import scoop.graphics.*
import scoop.graphics.text.*
import scoop.test.*
import scoop.ui.*
import scoop.ui.component.*
import scoop.ui.component.label as makeLabel

internal fun flexContract(collection: FontCollection): View =
    row {
        spacing = 8.0
        alignment = CrossAlignment.Baseline
        item(element({ FixedFlexCell() })) {
            basis = FlexBasis.Fixed(80.0);
            shrink = 0.0
        }
        item(
            element(
                { FlexTextCell() },
                [
                    makeLabel("One two three four five six seven eight nine ten eleven twelve") {
                        this.fonts = Some(collection)
                        this.style =
                            Some(
                                spanStyle {
                                    fontSize = Some(20.0);
                                    families = Some(["Layout Sans"])
                                }
                            )
                    }
                ]
            )
        ) {
            basis = FlexBasis.Fixed(0.0);
            grow = 1.0
        }
    }

private class FixedFlexCell: Element {
    public override fun measure(context: MeasureContext, constraints: Constraints): LayoutMetrics {
        assertEquals(80.0, constraints.minWidth)
        assertEquals(Some(80.0), constraints.maxWidth)
        return LayoutMetrics(constraints.constrain(Size(80.0, 28.0)), Some(20.0))
    }
    public override fun scene(context: SceneContext) {
        assertEquals(80.0, context.size.width)
    }
}

private class FlexTextCell: Element {
    private var height = 0.0
    public override fun measure(context: MeasureContext, constraints: Constraints): LayoutMetrics {
        assertEquals(212.0, constraints.minWidth)
        assertEquals(Some(212.0), constraints.maxWidth)
        val metrics = context.measureChild(0L, constraints)
        assertTrue(metrics.size.height > 40.0)
        height = metrics.size.height
        context.placeChild(0L, Point(0.0, 0.0))
        return metrics
    }
    public override fun scene(context: SceneContext) {
        assertEquals(Size(212.0, height), context.size)
        context.draw {
            paint -> assertEquals(388.0, windowBounds(paint.canvas, Rect(0.0, 0.0, 1.0, 1.0)).x)
        }
        context.children()
    }
}
