package scoop.tests.ui.layout

import scoop.ui.component.frame as makeFrame

import scoop.graphics.*
import scoop.graphics.native.withSkiaCanvas
import scoop.graphics.text.*
import scoop.surface.*
import scoop.test.*
import scoop.tests.graphics.readNativePixel
import scoop.ui.*
import scoop.ui.component.*
import scoop.ui.style.*
import scoop.ui.text.*
import scoop.window.*

internal class LayoutScene(private val probe: LayoutProbe, scope: ComponentScope): Component(
    scope
) {
    public override fun render(): View {
        probe.renders += 1
        val generation = probe.generation.value
        if (generation >= 10)
            return component({ mount -> CombinationScene(probe, scope = mount) })
        val keys =
            if (generation == 0)
                ["a", "b"]
            else
                ["b", "a"]
        val cells =
            Array<View>(keys.size) {
                index -> component(
                    keys[index],
                    { props, mount -> Cell(props, probe, scope = mount) },
                    ViewKey.Text(keys[index])
                )
            }
        val themed = generation == 1 || generation == 5
        val front =
            element(
                "front",
                { props, mount -> StackBox(props, probe, scope = mount) },
                key = ViewKey.Text("front")
            )
        val back =
            element(
                "back",
                { props, mount -> StackBox(props, probe, scope = mount) },
                key = ViewKey.Text("back")
            )
        val text =
            if (generation >= 5)
                probe.rtl
            else
                probe.text
        return element(
            generation,
            { props, mount -> LayoutPanel(props, probe, scope = mount) },
            [
                frame(
                    if (probe.showRows.value)
                        row {
                            this.addAll(cells)
                            this.spacing = 6.0
                        }
                    else
                        empty()
                ) {
                    this.width = Some(180.0)
                    this.height = Some(80.0)
                    this.padding = Some(Insets.all(8.0))
                    this.alignment = Alignment(AxisAlignment.Start, AxisAlignment.Center)
                    this.surface =
                        if (themed)
                            Some(SurfaceKind.Elevated)
                        else
                            None
                    this.style =
                        styleOverride {
                            this.contentEffects(
                                if (themed)
                                    [ContentEffect.Glow(2.0, 2.0, Color(0.2, 0.3, 1.0))]
                                else
                                    []
                            )
                        }
                },
                frame(element({ mount -> BaselineBox(probe, scope = mount) })) {
                    this.width = Some(120.0)
                    this.height = Some(70.0)
                    this.padding = Some(Insets(6.0, 8.0, 10.0, 12.0))
                    this.alignment = Alignment(AxisAlignment.End, AxisAlignment.Center)
                },
                frame(
                    stack {
                        this.addAll(
                            if (generation >= 3)
                                [front, back]
                            else
                                [back, front]
                        )
                        this.alignment = Alignment(AxisAlignment.End, AxisAlignment.End)
                    }
                ) {
                    this.width = Some(60.0)
                    this.height = Some(50.0)
                    this.style =
                        styleOverride {
                            this.corners(Corners.all(18.0))
                            this.clipContent(true)
                        }
                },
                label(text) {
                    this.fonts = Some(this @LayoutScene.probe.fonts)
                    this.settings {
                        this.direction =
                            if (generation >= 5)
                                TextDirection.Rtl
                            else
                                TextDirection.Ltr
                        this.maxLines =
                            if (generation == 4)
                                Some(1L)
                            else
                                None
                    }
                    this.inlines =
                        [
                            inlineView(
                                InlineKey.Text("image"),
                                element(
                                    { mount -> InlineImage(this @LayoutScene.probe, scope = mount) }
                                )
                            ) {
                                this.size =
                                    Some(
                                        if (generation >= 5)
                                            Size(34.0, 24.0)
                                        else
                                            Size(22.0, 28.0)
                                    )
                                this.alignment =
                                    InlineViewAlignment.Explicit(InlineAlignment.Middle)
                            },
                            inlineView(
                                InlineKey.Text("button"),
                                makeFrame(
                                    element(
                                        this @LayoutScene.probe.inlineClicks.value,
                                        {
                                            props,
                                            mount -> ButtonObserver(
                                                props,
                                                this @LayoutScene.probe,
                                                scope = mount
                                            )
                                        },
                                        [
                                            component(
                                                ButtonProps(
                                                    ButtonContent.Label(
                                                        LabelProps(
                                                            LabelText.Plain(
                                                                f"Inline ${
                                                                    this @LayoutScene.probe.inlineClicks.value
                                                                }",
                                                                None
                                                            ),
                                                            Some(this @LayoutScene.probe.fonts)
                                                        )
                                                    ),
                                                    {
                                                        this @LayoutScene.probe.inlineClicks.value += 1
                                                    }
                                                ),
                                                {
                                                    props, mount ->
                                                    this @LayoutScene.probe.buttonCreates += 1;
                                                    Button(props, scope = mount)
                                                }
                                            )
                                        ]
                                    )
                                ) {
                                    this.width = Some(110.0)
                                    this.padding = Some(Insets.all(3.0))
                                }
                            )
                        ]
                },
                flexContract(probe.fonts),
                visualContract(generation, probe.visuals)
            ]
        )
    }
}

private class LayoutPanel(
    private val props: Props<Int>,
    private val probe: LayoutProbe,
    scope: ComponentScope
): Element<Unit>(scope) {
    public override fun update(): UiInvalidation {
        probe.updates += 1
        return UiInvalidation.Layout
    }
    public override fun measure(context: MeasureContext, constraints: Constraints): LayoutResult<
        Unit
    > {
        probe.measures += 1
        assertEquals(None, context.measureChild(0L, Constraints()).alphabeticBaseline)
        context.placeChild(0L, Point(20.0, 20.0))
        val baseline = context.measureChild(1L, Constraints())
        assertEquals(Size(120.0, 70.0), baseline.size)
        assertEquals(Some(35.0), baseline.alphabeticBaseline)
        assertEquals(Some(39.0), baseline.ideographicBaseline)
        context.placeChild(1L, Point(210.0, 20.0))
        assertEquals(
            None,
            context.measureChild(2L, Constraints.tight(Size(60.0, 50.0))).alphabeticBaseline
        )
        context.placeChild(2L, Point(20.0, 150.0))
        probe.textMetrics =
            Some(
                context.measureChild(
                    3L,
                    Constraints(
                        maxWidth =
                            Some(
                                if (props.value == 4)
                                    40.0
                                else
                                    520.0
                            )
                    )
                )
            )
        context.placeChild(3L, Point(20.0, 240.0))
        val flex =
            context.measureChild(
                4L,
                Constraints(minWidth = 300.0, maxWidth = Some(300.0), maxHeight = Some(200.0))
            )
        assertEquals(300.0, flex.size.width)
        assertTrue(flex.alphabeticBaseline!! >= 20.0)
        context.placeChild(4L, Point(300.0, 110.0))
        context.measureChild(5L, Constraints.tight(Size(208.0, 64.0)))
        context.placeChild(5L, Point(360.0, 340.0))
        return LayoutResult(LayoutMetrics(constraints.constrain(Size(600.0, 440.0))), Unit)
    }
    public override fun scene(context: SceneContext, measured: Unit) {
        probe.paints += 1
        context.draw { paint -> paint.canvas.clear(Color.White) }
        context.children()
        context.draw {
            paint -> @Unsafe
            {
                paint.canvas.withSkiaCanvas {
                    native -> @Unsafe
                    {
                        assertEquals(16711680L, readNativePixel(native, 295.0, 45.0))
                        assertEquals(16777215L, readNativePixel(native, 21.0, 151.0))
                    }
                }
            }
        }
        probe.paintedGeneration = props.value
    }
}

internal class Cell(
    private val props: Props<String>,
    private val probe: LayoutProbe,
    scope: ComponentScope
): Component(scope) {
    val id: String get() = props.value
    var count: Int by state(0)
    var unmounts = 0
    var ink: CellInk? = None
    init {
        probe.cells.add(this)
    }
    public override fun onUnmount() {
        unmounts += 1
    }
    public override fun render(): View =
        element(
            CellInput(id, count, { count += 1 }),
            { props, mount -> CellInk(props, this, scope = mount) }
        )
}

internal class CellInput(val id: String, val count: Int, val click: () -> Unit)

internal class CellInk(
    private val props: Props<CellInput>,
    private val owner: Cell,
    scope: ComponentScope
): Element<Unit>(scope) {
    var area: InputArea? = None
    var bounds = Rect(0.0, 0.0, 0.0, 0.0)
    public override fun onMount() {
        owner.ink = Some(this)
        area =
            Some(
                scope.createArea(focusable = true) {
                    current, event ->
                    when (event) {
                        case Pointer(
                            InputPointerEvent.Button(_, MouseButton.Left, ElementState.Pressed, _)
                        ) -> current.currentTarget.area!!.requestFocus()
                        case Pointer(
                            InputPointerEvent.Button(_, MouseButton.Left, ElementState.Released, _)
                        ) -> props.value.click()
                        else -> {}
                    }
                    current.consume()
                }
            )
    }
    public override fun measure(context: MeasureContext, constraints: Constraints): LayoutResult<
        Unit
    > =
        LayoutResult(
            LayoutMetrics(
                constraints.constrain(Size(32.0 + props.value.count.toDouble() * 8.0, 24.0))
            ),
            Unit
        )
    public override fun scene(context: SceneContext, measured: Unit) {
        val local = Rect(0.0, 0.0, context.size.width, context.size.height)
        context.draw {
            paint ->
            bounds = windowBounds(paint.canvas, local)
            paint.canvas.drawRect(
                local,
                Paint(
                    if (props.value.id == "a")
                        Color(1.0, 0.0, 0.0)
                    else
                        Color(0.0, 0.5, 0.0)
                )
            )
        }
        context.place(area!!, local)
    }
}

private class BaselineBox(private val probe: LayoutProbe, scope: ComponentScope): Element<Unit>(
    scope
) {
    public override fun measure(context: MeasureContext, constraints: Constraints): LayoutResult<
        Unit
    > =
        LayoutResult(
            LayoutMetrics(constraints.constrain(Size(30.0, 20.0)), Some(12.0), Some(16.0)),
            Unit
        )
    public override fun scene(context: SceneContext, measured: Unit) {
        context.draw {
            paint ->
            val bounds = Rect(0.0, 0.0, paint.size.width, paint.size.height)
            assertEquals(Rect(290.0, 43.0, 30.0, 20.0), windowBounds(paint.canvas, bounds))
            paint.canvas.drawRect(bounds, Paint(Color(0.0, 0.0, 1.0)))
        }
    }
}

private class StackBox(
    private val props: Props<String>,
    private val probe: LayoutProbe,
    scope: ComponentScope
): Element<Unit>(scope) {
    private var area: InputArea? = None
    public override fun onMount() {
        area =
            Some(
                scope.createArea {
                    current, event ->
                    when (event) {
                        case Pointer(
                            InputPointerEvent.Button(_, MouseButton.Left, ElementState.Released, _)
                        ) -> {
                            if (props.value == "front")
                                probe.frontClicks += 1
                            else
                                probe.backClicks += 1
                        }
                        else -> {}
                    }
                    current.consume()
                }
            )
    }
    public override fun measure(context: MeasureContext, constraints: Constraints): LayoutResult<
        Unit
    > =
        LayoutResult(
            LayoutMetrics(
                constraints.constrain(
                    if (props.value == "front")
                        Size(20.0, 20.0)
                    else
                        Size(60.0, 50.0)
                )
            ),
            Unit
        )
    public override fun scene(context: SceneContext, measured: Unit) {
        val bounds = Rect(0.0, 0.0, context.size.width, context.size.height)
        context.draw {
            paint -> paint.canvas.drawRect(
                bounds,
                Paint(
                    if (props.value == "front")
                        Color(0.0, 1.0, 0.0)
                    else
                        Color(1.0, 0.0, 0.0)
                )
            )
        }
        context.place(area!!, bounds)
    }
}

private class ButtonObserver(
    private val props: Props<Int>,
    private val probe: LayoutProbe,
    scope: ComponentScope
): Element<Unit>(scope) {
    public override fun measure(context: MeasureContext, constraints: Constraints): LayoutResult<
        Unit
    > {
        val metrics = context.measureChild(0L, constraints)
        probe.buttonMetrics = Some(metrics)
        context.placeChild(0L, Point(0.0, 0.0))
        return LayoutResult(metrics, Unit)
    }
    public override fun scene(context: SceneContext, measured: Unit) {
        probe.buttonPaints += 1;
        context.children()
    }
}

internal class InlineImage(private val probe: LayoutProbe, scope: ComponentScope): Element<Unit>(
    scope
) {
    var image: Image? = None
    var unmounts = 0
    var size = Size(0.0, 0.0)
    public override fun onMount() {
        probe.image = Some(this)
        probe.imageCreates += 1
        image =
            Some(
                scope.resource {
                    RasterSurface(3, 3).use {
                        surface ->
                        surface.draw {
                            canvas ->
                            canvas.clear(Color.Transparent);
                            canvas.drawRect(Rect(0.0, 0.0, 2.0, 3.0), Paint(Color(0.5, 0.0, 0.8)))
                        }
                        surface.snapshot()
                    }
                }
            )
    }
    public override fun measure(context: MeasureContext, constraints: Constraints): LayoutResult<
        Unit
    > {
        val size = constraints.constrain(Size(22.0, 28.0))
        return LayoutResult(LayoutMetrics(size), Unit)
    }
    public override fun scene(context: SceneContext, measured: Unit) {
        size = context.size
        context.draw {
            paint -> paint.canvas.drawImage(
                image!!,
                Rect(0.0, 0.0, paint.size.width, paint.size.height)
            )
        }
    }
    public override fun onUnmount() {
        unmounts += 1
    }
}
