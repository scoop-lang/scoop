package scoop.tests.ui.hoverpopup

import scoop.graphics.Rect
import scoop.test.*
import scoop.time.Duration
import scoop.ui.OverlaySide
import scoop.ui.style.*
import scoop.ui.style.shadcn.shadcnTheme

internal fun hoverPopupStep(p: HoverPopupProbe) {
    when (p.phase) {
        case 0 -> {
            p.outside();
            assertTrue(p.after.requestFocus())
        }
        case 1 -> assertTrue(p.trigger.requestFocus())
        case 2 -> {
            assertTrue(p.layer.isOpen);
            assertTrue(p.popupBounds.width > 24.0 && p.popupBounds.width < 200.0)
            assertTrue(p.trigger.hasFocus)
            assertTrue(p.content.isAttached);
            assertFalse(p.content.requestFocus())
            p.key(53)
        }
        case 3 -> {
            assertFalse(p.layer.isOpen);
            p.changed();
            p.overTrigger()
        }
        case 4 -> {
            assertFalse(p.layer.isOpen)
            assertTrue(p.after.requestFocus());
            p.outside()
        }
        case 5 -> assertTrue(p.trigger.requestFocus())
        case 6 -> {
            assertTrue(p.layer.isOpen);
            p.key(49, " ")
        }
        case 7 -> {
            assertFalse(p.layer.isOpen);
            assertEquals(1, p.actions)
            assertTrue(p.after.requestFocus())
            p.openDelay = Duration.milliseconds(300L)
            p.closeDelay = Duration.milliseconds(80L)
            p.focus = false;
            p.changed()
        }
        case 8 -> {
            p.overTrigger();
            p.hold = 80L
        }
        case 9 -> {
            assertFalse(p.layer.isOpen);
            p.outside();
            p.hold = 350L
        }
        case 10 -> {
            assertFalse(p.layer.isOpen);
            p.overTrigger();
            p.hold = 380L
        }
        case 11 -> {
            assertTrue(p.layer.isOpen);
            p.move(260.0, 138.0);
            p.hold = 140L
        }
        case 12 -> {
            assertTrue(p.layer.isOpen);
            p.click(p.contentBounds)
        }
        case 13 -> {
            assertTrue(p.layer.isOpen);
            assertEquals(0, p.contentActions);
            assertTrue(p.after.hasFocus)
            assertEquals(1, p.actions)
            p.outside();
            p.hold = 140L
        }
        case 14 -> {
            assertFalse(p.layer.isOpen)
            p.controlled = true;
            p.deny = true;
            p.savedChanges = p.changes;
            p.changed()
        }
        case 15 -> {
            p.overTrigger();
            p.hold = 380L
        }
        case 16 -> {
            assertFalse(p.layer.isOpen);
            assertFalse(p.external.value)
            assertEquals(p.savedChanges, p.changes)
            p.deny = false;
            p.version = 7;
            p.changed();
            p.outside()
        }
        case 17 -> {
            p.overTrigger();
            p.hold = 380L
        }
        case 18 -> {
            assertTrue(p.layer.isOpen);
            assertTrue(p.external.value)
            assertEquals(7, p.callbackVersion)
            p.other.value = true;
            p.second = true;
            p.savedMounts = p.mounts;
            p.shortHeight = p.popupBounds.height;
            p.longHint = true;
            p.changed()
        }
        case 19 -> {
            assertTrue(p.layer.isOpen);
            assertEquals(p.savedMounts, p.mounts)
            assertEquals(320.0, p.popupBounds.width)
            assertTrue(p.popupBounds.height > p.shortHeight)
            p.layer.requestClose()
        }
        case 20 -> {
            assertFalse(p.layer.isOpen);
            assertFalse(p.other.value);
            assertTrue(p.external.value)
            p.outside();
            assertTrue(p.after.requestFocus())
            p.controlled = false;
            p.card = true;
            p.focus = true
            p.openDelay = Duration.milliseconds(40L);
            p.changed()
        }
        case 21 -> {
            p.overTrigger();
            p.hold = 100L
        }
        case 22 -> {
            assertTrue(p.layer.isOpen);
            assertTrue(p.after.hasFocus)
            p.move(260.0, 138.0);
            p.hold = 160L
        }
        case 23 -> {
            assertTrue(p.layer.isOpen);
            p.move(p.contentBounds.x + 10.0, p.contentBounds.y + 10.0)
        }
        case 24 -> {
            assertTrue(p.layer.isOpen);
            p.click(p.contentBounds)
        }
        case 25 -> {
            assertEquals(1, p.contentActions);
            assertTrue(p.content.hasFocus)
            p.outside();
            p.hold = 400L
        }
        case 26 -> {
            assertTrue(p.layer.isOpen);
            p.key(53)
        }
        case 27 -> {
            assertFalse(p.layer.isOpen);
            p.overTrigger();
            p.hold = 100L
        }
        case 28 -> {
            assertTrue(p.layer.isOpen)
            p.click(Rect(p.triggerX, 120.0, 140.0, 36.0))
        }
        case 29 -> {
            assertTrue(p.layer.isOpen);
            assertEquals(2, p.actions)
            p.savedMounts = p.mounts;
            p.rtl = true;
            p.triggerX = 300.0
            p.theme.current.value =
                shadcnTheme(ThemeMode.Dark) {
                    tokens { motion { preference = MotionPreference.Reduced } }
                }
            p.changed()
        }
        case 30 -> {
            assertTrue(p.content.requestFocus());
            p.key(49, " ")
        }
        case 31 -> {
            assertTrue(p.layer.isOpen);
            assertEquals(Some(OverlaySide.Left), p.side)
            assertEquals(p.savedMounts, p.mounts);
            assertEquals(1, p.observed)
            p.enabled = false;
            p.changed()
        }
        case 32 -> {
            assertFalse(p.layer.isOpen)
            assertTrue(p.trigger.requestFocus());
            p.key(49, " ")
        }
        case 33 -> {
            assertEquals(3, p.actions);
            assertFalse(p.layer.isOpen)
            p.enabled = true;
            p.outside();
            assertTrue(p.after.requestFocus());
            p.changed()
        }
        case 34 -> {
            p.overTrigger();
            p.hold = 100L
        }
        case 35 -> {
            assertTrue(p.layer.isOpen);
            p.mounted.value = false
        }
        case 36 -> {
            assertFalse(p.layer.isAttached);
            assertFalse(p.trigger.isAttached)
            assertFalse(p.content.isAttached);
            assertEquals(p.mounts, p.unmounts)
            assertFalse(p.frames!!.snapshot().required)
            p.native!!.requestDestroy()
        }
        else -> throw IllegalStateException(Some("unexpected hover popup phase"))
    }
}
