package scoop.tests.ui.command

import scoop.test.*
import scoop.surface.FocusOrigin
import scoop.tests.surface.moveSurfacePointer
import scoop.ui.*
import scoop.ui.style.*
import scoop.ui.style.shadcn.shadcnTheme

internal fun commandStep(p: CommandProbe) {
    when (p.phase) {
        case 0 -> {
            moveSurfacePointer(p.native!!, 640.0, 490.0)
            assertTrue(p.editor.requestFocus(FocusOrigin.Keyboard))
        }
        case 1 -> {
            assertEquals(Some(ViewKey.Number(1L)), p.active.value);
            p.key(125)
        }
        case 2 -> {
            assertEquals(Some(ViewKey.Number(3L)), p.active.value)
            assertTrue(p.editor.hasFocus);
            assertEquals(0, p.calls);
            assertEquals("", p.query.text)
            p.key(119)
        }
        case 3 -> {
            assertEquals(Some(ViewKey.Number(5L)), p.active.value);
            p.key(115)
        }
        case 4 -> {
            assertEquals(Some(ViewKey.Number(1L)), p.active.value);
            p.key(48, "\t")
        }
        case 5 -> {
            assertTrue(p.after.hasFocus);
            p.click(3L)
        }
        case 6 -> {
            assertEquals(3L, p.selected);
            assertEquals(1, p.calls);
            assertTrue(p.editor.hasFocus)
            moveSurfacePointer(p.native!!, 640.0, 490.0);
            p.query.replaceAll("set")
        }
        case 7 -> {
            assertEquals(Some(ViewKey.Number(3L)), p.active.value);
            p.preservedScores = p.scores
            p.text("ting", true)
        }
        case 8 -> {
            assertEquals(p.preservedScores, p.scores)
            assertEquals("set", p.query.committedText);
            assertTrue(p.query.isComposing)
            assertEquals(Some(ViewKey.Number(3L)), p.active.value);
            p.key(125)
        }
        case 9 -> {
            assertEquals(p.preservedScores, p.scores)
            assertTrue(p.query.isComposing);
            assertEquals(Some(ViewKey.Number(3L)), p.active.value)
            p.key(36, "\r")
        }
        case 10 -> {
            assertEquals(p.preservedScores, p.scores)
            assertEquals(1, p.calls);
            assertEquals(0, p.submissions);
            p.text("tings")
        }
        case 11 -> {
            assertEquals("settings", p.query.committedText);
            assertFalse(p.query.isComposing)
            assertEquals(Some(ViewKey.Number(3L)), p.active.value);
            p.key(36, "\r")
        }
        case 12 -> {
            assertEquals(2, p.calls);
            p.query.replaceAll("")
        }
        case 13 -> p.text("she", true)
        case 14 -> {
            assertEquals("", p.query.committedText);
            p.text("设置")
        }
        case 15 -> {
            assertEquals("设置", p.query.committedText);
            assertEquals(Some(ViewKey.Number(4L)), p.active.value)
            assertTrue(p.editor.hasFocus);
            p.key(36, "\r")
        }
        case 16 -> {
            assertEquals(3, p.calls);
            assertEquals(4L, p.selected);
            p.query.replaceAll("nope")
        }
        case 17 -> {
            assertEquals(None, p.active.value);
            p.key(36, "\r")
        }
        case 18 -> {
            assertEquals(3, p.calls);
            p.query.replaceAll("");
            p.active.value = Some(ViewKey.Number(5L))
            p.reverse = true;
            p.version = 2;
            p.changed()
        }
        case 19 -> {
            p.preservedFactories = p.factories
            p.reverse = false;
            p.changed()
            assertEquals(Some(ViewKey.Number(5L)), p.active.value);
            p.key(36, "\r")
        }
        case 20 -> {
            assertEquals(p.preservedFactories, p.factories)
            p.reverse = true
            assertEquals(4, p.calls);
            assertEquals(2, p.reported);
            assertEquals(5L, p.selected)
            p.omit = 5L;
            p.changed()
        }
        case 21 -> {
            assertEquals(Some(ViewKey.Number(4L)), p.active.value)
            p.auto = false;
            p.omit = 4L;
            p.changed()
        }
        case 22 -> {
            assertEquals(None, p.active.value);
            p.key(125)
        }
        case 23 -> {
            assertEquals(Some(ViewKey.Number(3L)), p.active.value);
            p.rebind = true;
            p.changed()
        }
        case 24 -> {
            assertEquals(Some(ViewKey.Number(1L)), p.second.value);
            assertEquals(Some(ViewKey.Number(3L)), p.active.value)
            p.second.value = Some(ViewKey.Number(999L))
        }
        case 25 -> {
            assertEquals(None, p.second.value);
            p.long = true;
            p.auto = true
            p.query.replaceAll("provided query");
            p.changed()
        }
        case 26 -> {
            assertEquals(Some(ViewKey.Number(0L)), p.second.value);
            assertTrue(p.factories < 80)
            p.key(119)
        }
        case 27 -> {
            assertEquals(Some(ViewKey.Number(4999L)), p.second.value);
            assertTrue(p.editor.hasFocus)
            assertTrue(p.scroll.snapshot.offset.y > 10000.0);
            assertTrue(p.rows[4999L] != None)
            assertTrue(p.factories < 100);
            p.key(36, "\r")
        }
        case 28 -> {
            assertEquals(5, p.calls);
            assertEquals(4999L, p.selected)
            p.narrow = true;
            p.theme.current.value = shadcnTheme(ThemeMode.Dark);
            p.changed()
        }
        case 29 -> {
            assertEquals(160.0, p.actualWidth)
            assertEquals(Some(ViewKey.Number(4999L)), p.second.value);
            p.key(115)
        }
        case 30 -> {
            assertEquals(Some(ViewKey.Number(0L)), p.second.value);
            p.enabled = false;
            p.changed()
        }
        case 31 -> {
            assertFalse(p.editor.hasFocus);
            p.shown = false;
            p.changed()
        }
        case 32 -> {
            assertFalse(p.editor.isAttached);
            assertFalse(p.list.isAttached);
            assertFalse(p.scroll.isAttached)
            assertFalse(p.frames!!.snapshot().required)
            p.shown = true;
            p.enabled = true;
            p.long = false;
            p.omit = 0L;
            p.reverse = false;
            p.rebind = false
            p.query.replaceAll("");
            p.active.value = None;
            p.changed()
        }
        case 33 -> {
            assertTrue(p.editor.requestFocus(FocusOrigin.Keyboard));
            p.key(119)
        }
        case 34 -> {
            assertEquals(Some(ViewKey.Number(5L)), p.active.value);
            assertEquals(0, p.submissions)
            assertFalse(p.frames!!.snapshot().required);
            p.zero = true;
            p.changed()
        }
        case 35 -> {
            assertEquals(0.0, p.actualWidth);
            p.zero = false;
            p.changed()
        }
        case 36 -> {
            assertEquals(160.0, p.actualWidth)
            assertTrue(p.editor.requestFocus(FocusOrigin.Keyboard))
        }
        case 37 -> {
            assertTrue(p.editor.hasFocus);
            p.text("ni", true)
        }
        case 38 -> {
            assertTrue(p.query.isComposing);
            p.key(53, "\u001b")
        }
        case 39 -> {
            assertFalse(p.query.isComposing);
            assertEquals("", p.query.committedText)
            assertEquals(Some(ViewKey.Number(5L)), p.active.value)
            p.prevent = true;
            p.key(36, "\r")
        }
        case 40 -> {
            assertEquals(5, p.calls);
            assertEquals(0, p.submissions);
            p.native!!.requestDestroy()
        }
        else -> fail(Some("unexpected command phase"))
    }
}
