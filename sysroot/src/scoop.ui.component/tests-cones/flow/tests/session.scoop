package scoop.tests.ui.flow

import scoop.graphics.*
import scoop.platform.time.MonotonicTimeSource
import scoop.surface.InputArea
import scoop.test.*
import scoop.time.Duration
import scoop.ui.*
import scoop.window.*

@Test
private class FlowLayoutUiTest {
    @Test
    fun `wrap and grid use final geometry in both directions without remounting their contents`() {
        val probe = FlowProbe()
        UiHost { host, active, event -> probe.event(host, active, event) }.use {
            host -> Application(
                applicationOptions { lastWindowPolicy = LastWindowPolicy.Exit }
            ).run(host)
        }
        assertTrue(probe.finished)
        for (record in probe.records) {
            assertEquals(1, record.mounts)
            assertEquals(1, record.unmounts)
            assertTrue(record.area!!.isClosed)
        }
    }
}

internal class FlowRecord(val natural: Size, val baseline: Double? = None) {
    var area: InputArea? = None
    var last: Size? = None
    var mounts = 0
    var unmounts = 0
}

internal class FlowProbe {
    val desired = state(LayoutDirection.Ltr)
    val records =
        [
            FlowRecord(Size(70.0, 20.0), Some(15.0)),
            FlowRecord(Size(70.0, 30.0), Some(10.0)),
            FlowRecord(Size(80.0, 25.0), Some(20.0)),
            FlowRecord(Size(30.0, 18.0)),
            FlowRecord(Size(90.0, 24.0)),
            FlowRecord(Size(0.0, 0.0)),
            FlowRecord(Size(10.0, 16.0)),
            FlowRecord(Size(20.0, 20.0)),
            FlowRecord(Size(20.0, 10.0)),
            FlowRecord(Size(15.0, 10.0)),
            FlowRecord(Size(20.0, 10.0))
        ]
    var committed: LayoutDirection? = None
    var window: Window? = None
    var finished = false
    private var phase = 0
    private var waiting = false

    fun event(host: UiHost, active: ActiveApplication, event: ApplicationEvent) {
        when (event) {
            case Resumed -> {
                val native =
                    active.createWindow(
                        windowAttributes {
                            title = "Scoop wrap and grid"
                            size = LogicalSize(460.0, 240.0)
                            visible = false
                        }
                    )
                window = Some(native)
                host.attach(native, { mount -> FlowRoot(this, scope = mount) })
                active.setControlFlow(
                    ControlFlow.WaitUntil(MonotonicTimeSource.markNow() + Duration.seconds(30L))
                )
                active.proxy().post {
                    _ ->
                    native.setVisible(true);
                    native.setWindowLevel(WindowLevel.AlwaysOnTop);
                    native.requestFocus()
                }
            }
            case AboutToWait -> if (!waiting && committed != None && phase < 2) {
                waiting = true
                active.proxy().post {
                    _ ->
                    waiting = false
                    if (phase == 0 && committed == Some(LayoutDirection.Ltr)) {
                        verify(false)
                        desired.value = LayoutDirection.Rtl
                        phase = 1
                    } else
                        if (phase == 1 && committed == Some(LayoutDirection.Rtl)) {
                            verify(true)
                            finished = true
                            phase = 2
                            window!!.requestDestroy()
                        }
                }
            }
            case Window(_, WindowEvent.Destroyed) -> active.requestExit()
            case NewEvents(StartCause.Deadline) -> fail(Some("flow layout timeout"))
            else -> {}
        }
    }

    private fun rect(index: Long): Rect = records[index].area!!.visibleBounds!!
    private fun verify(rtl: Boolean) {
        assertEquals(
            Rect(
                if (rtl)
                    102.0
                else
                    18.0,
                13.0,
                70.0,
                20.0
            ),
            rect(0L)
        )
        assertEquals(
            Rect(
                if (rtl)
                    28.0
                else
                    92.0,
                18.0,
                70.0,
                30.0
            ),
            rect(1L)
        )
        assertEquals(
            Rect(
                if (rtl)
                    92.0
                else
                    18.0,
                54.0,
                80.0,
                25.0
            ),
            rect(2L)
        )
        val textHeight = records[5L].last!!.height
        assertTrue(textHeight > 30.0)
        assertEquals(
            Rect(
                if (rtl)
                    314.0
                else
                    250.0,
                12.0,
                46.0,
                textHeight
            ),
            rect(3L)
        )
        assertEquals(
            Rect(
                if (rtl)
                    314.0
                else
                    206.0,
                17.0 + textHeight,
                90.0,
                24.0
            ),
            rect(4L)
        )
        assertEquals(
            Rect(
                if (rtl)
                    262.0
                else
                    300.0,
                12.0,
                48.0,
                textHeight
            ),
            rect(5L)
        )
        assertEquals(
            Rect(
                if (rtl)
                    210.0
                else
                    352.0,
                12.0,
                48.0,
                textHeight
            ),
            rect(6L)
        )
        assertEquals(
            Rect(
                if (rtl)
                    250.0
                else
                    340.0,
                19.0 + textHeight,
                20.0,
                20.0
            ),
            rect(7L)
        )
        assertEquals(
            Rect(
                if (rtl)
                    80.0
                else
                    20.0,
                145.0,
                20.0,
                10.0
            ),
            rect(8L)
        )
        assertEquals(
            Rect(
                if (rtl)
                    95.0
                else
                    10.0,
                210.0,
                15.0,
                10.0
            ),
            rect(9L)
        )
        assertEquals(
            Rect(
                if (rtl)
                    190.0
                else
                    130.0,
                185.0,
                20.0,
                10.0
            ),
            rect(10L)
        )
        for (record in records)
            assertEquals(1, record.mounts)
    }
}
