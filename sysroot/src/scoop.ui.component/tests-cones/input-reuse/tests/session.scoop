package scoop.tests.ui.componentinputreuse

import scoop.platform.time.MonotonicTimeSource
import scoop.test.*
import scoop.tests.surface.*
import scoop.time.Duration
import scoop.ui.*
import scoop.ui.style.*
import scoop.ui.style.shadcn.shadcnTheme
import scoop.window.*

@Test
private class ComponentInputReuseTest {
    @Test
    fun `cached button text retains hover pixels and stops work after the final transition`() {
        val probe = ButtonInputProbe()
        val source = ThemeSource(probe.theme)
        try {
            context(source) {
                UiHost { host, active, event -> probe.event(host, active, event) }.use {
                    host -> Application().run(host)
                }
            }
        } finally {
            probe.rendering?.close()
            probe.view?.close()
        }
        assertTrue(probe.finished)
        assertEquals(2, probe.clicked)
    }
}

internal class ButtonInputProbe {
    val theme = InputTheme(shadcnTheme())
    val version = state(0)
    var clicked = -1
    var scope: ComponentScope? = None
    var view: ViewProbe? = None
    var rendering: FrameProbe? = None
    private var quiet: FrameSnapshot? = None
    var window: Window? = None
    var baseline: Array<Long> = []
    var baselineMetrics = 0
    var frames = 0
    var phase = 0
    var finished = false

    fun event(host: UiHost, active: ActiveApplication, event: ApplicationEvent) {
        when (event) {
            case Resumed -> {
                active.setControlFlow(
                    ControlFlow.WaitUntil(MonotonicTimeSource.markNow() + Duration.seconds(20L))
                )
                val native =
                    active.createWindow(
                        windowAttributes {
                            title = "Button input reuse"
                            size = LogicalSize(260.0, 160.0)
                            visible = false
                        }
                    )
                window = Some(native)
                view = Some(observeWindow(native))
                rendering = Some(observeFrames(native))
                host.attach(native, { mount -> InputScene(this, active, scope = mount) })
                native.setVisible(true)
                native.setWindowLevel(WindowLevel.AlwaysOnTop)
                native.requestFocus()
                assertTrue(moveSurfacePointer(native, 230.0, 140.0))
            }
            case NewEvents(StartCause.Deadline) -> when (phase) {
                case 6 -> {
                    val snapshot = rendering!!.snapshot()
                    assertFalse(snapshot.required)
                    assertTrue(snapshot.paused)
                    quiet = Some(snapshot)
                    assertTrue(moveSurfacePointer(window!!, 235.0, 145.0))
                    phase = 7
                    active.setControlFlow(
                        ControlFlow.WaitUntil(
                            MonotonicTimeSource.markNow() + Duration.milliseconds(250L)
                        )
                    )
                }
                case 7 -> {
                    assertEquals(quiet!!, rendering!!.snapshot())
                    finished = true
                    active.requestExit()
                }
                else -> fail(Some(f"button input reuse deadline at ${phase}"))
            }
            else -> {}
        }
    }
    fun accepted(active: ActiveApplication, generation: Int, pixels: Array<Long>) {
        frames += 1
        when (phase) {
            case 0 -> {
                if (frames < 3)
                    scope!!.requestFrame()
                else {
                    baseline = pixels
                    baselineMetrics = theme.metrics
                    phase = 1
                    version.value = 1
                }
            }
            case 1 -> if (generation == 1) {
                assertEquals(baselineMetrics, theme.metrics)
                phase = 2
                assertTrue(moveSurfacePointer(window!!, 55.0, 38.0))
                click()
                assertTrue(
                    active.proxy().post {
                        _ ->
                        assertEquals(1, clicked)
                        scope!!.requestFrame()
                    }
                )
            }
            case 2 -> if (theme.hovered && clicked == 1) {
                assertFalse(samePixels(baseline, pixels))
                baselineMetrics = theme.metrics
                phase = 3
                version.value = 2
            }
            case 3 -> if (generation == 2) {
                assertEquals(baselineMetrics, theme.metrics)
                phase = 4
                click()
                assertTrue(
                    active.proxy().post {
                        _ ->
                        assertEquals(2, clicked)
                        phase = 5
                        assertTrue(moveSurfacePointer(window!!, 230.0, 140.0))
                        scope!!.requestFrame()
                    }
                )
            }
            case 5 -> {
                if (!theme.hovered && samePixels(baseline, pixels)) {
                    phase = 6
                    active.setControlFlow(
                        ControlFlow.WaitUntil(
                            MonotonicTimeSource.markNow() + Duration.milliseconds(400L)
                        )
                    )
                }
            }
            else -> {}
        }
    }
    private fun click() {
        assertTrue(view!!.button(55.0, 38.0, true))
        assertTrue(view!!.button(55.0, 38.0, false))
    }
}

private fun samePixels(a: Array<Long>, b: Array<Long>): Boolean {
    if (a.size != b.size)
        return false
    for (index in 0L ..< a.size)
        if (a[index] != b[index])
            return false
    return true
}
