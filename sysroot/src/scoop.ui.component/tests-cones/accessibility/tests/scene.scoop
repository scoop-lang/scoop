package scoop.tests.ui.component.accessibility

import scoop.graphics.*
import scoop.graphics.text.*
import scoop.ui.*
import scoop.ui.component.*
import scoop.ui.text.*
import scoop.window.accessibility.*

internal class ControlsRoot(private val probe: ControlsProbe, scope: ComponentScope): Component(
    scope
) {
    private val related = scope.semantics(SemanticRole.Text)
    private val checked =
        binding(
            get = { probe.checked.value },
            set =
                {
                    next -> if (!probe.reject.value)
                        probe.checked.value = next
                }
        )
    init {
        related.update(SemanticProperties(value = Some("Related name"), ignored = true))
        probe.relatedHandle = Some(related)
    }
    public override fun render(): View {
        val probe = this.probe
        val version = probe.version.value
        val caption = probe.caption.value
        val name = probe.name.value
        val relations =
            if (probe.related.value)
                SemanticRelations(labelledBy = [related.id])
            else
                SemanticRelations()
        val choicesEnabled = probe.enabled.value
        val isReadOnly = probe.readOnly.value
        val protectInput = probe.protectedText.value
        val hidden = probe.hidden.value
        val labelName = probe.labelName.value
        val views =
            [
                buttonGroup {
                    this.button(caption, { probe.clicked = version }) {
                        semantics =
                            ComponentSemantics(
                                name = name,
                                automationId = Some("button"),
                                relations = relations,
                                hidden = hidden
                            )
                    }
                },
                label("Plain label") {
                    semantics = ComponentSemantics(name = labelName, automationId = Some("label"))
                },
                label(probe.labelText) {
                    inlines =
                        [
                            inlineView(
                                InlineKey.Text("badge"),
                                element({ mount -> InlineBox(mount) })
                            )
                        ]
                    semantics = ComponentSemantics(automationId = Some("rich"))
                },
                checkbox(checked) {
                    enabled = choicesEnabled
                    semantics =
                        ComponentSemantics(name = Some("Choice"), automationId = Some("checkbox"))
                },
                button(
                    row {
                        this.label("Outer")
                        this.button("Inner", { probe.innerClicks += 1 }) {
                            semantics = ComponentSemantics(automationId = Some("inner"))
                        }
                    },
                    { probe.outerClicks += 1 }
                ) { semantics = ComponentSemantics(automationId = Some("outer")) },
                inputGroup {
                    this.input(probe.editor) {
                        readOnly = isReadOnly
                        protectedText = protectInput
                        description = "Hint"
                        contextMenu { mode = TextContextMenuMode.Disabled }
                        semantics =
                            ComponentSemantics(
                                name = Some("Document"),
                                automationId = Some("input")
                            )
                    }
                },
                textarea(probe.multiline) {
                    placeholder = "Not a label"
                    contextMenu { mode = TextContextMenuMode.Disabled }
                    semantics = ComponentSemantics(automationId = Some("textarea"))
                }
            ]
        return element({ mount -> ControlsPanel(probe, views.size, mount) }, views)
    }
}

private class ControlsPanel(
    private val probe: ControlsProbe,
    private val count: Long,
    scope: ComponentScope
): Element<Unit>(scope) {
    public override fun measure(context: MeasureContext, constraints: Constraints): LayoutResult<
        Unit
    > {
        probe.measures += 1
        var y = 0.0
        for (index in 0L ..< count) {
            val child = context.measureChild(index, Constraints(maxWidth = Some(320.0)))
            context.placeChild(index, Point(0.0, y))
            y += child.size.height + 8.0
        }
        return LayoutResult(LayoutMetrics(constraints.constrain(Size(320.0, y))), Unit)
    }
    public override fun scene(context: SceneContext, layout: Unit) {
        probe.scenes += 1
        context.children()
    }
}

private class InlineBox(scope: ComponentScope): Element<Unit>(scope) {
    public override fun measure(context: MeasureContext, constraints: Constraints): LayoutResult<
        Unit
    > = LayoutResult(LayoutMetrics(constraints.constrain(Size(12.0, 12.0))), Unit)
    public override fun scene(context: SceneContext, layout: Unit) {
        context.draw {
            paint -> paint.canvas.drawRect(Rect(0.0, 0.0, 12.0, 12.0), Paint(Color.Black))
        }
    }
}
