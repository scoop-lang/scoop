package scoop.tests.ui.component.accessibility

import scoop.graphics.*
import scoop.platform.time.MonotonicTimeSource
import scoop.surface.FrameSubmission
import scoop.test.*
import scoop.tests.ui.accessibility.native.*
import scoop.time.Duration
import scoop.ui.*
import scoop.ui.component.*
import scoop.ui.component.label as semanticLabel
import scoop.ui.style.ThemeSource
import scoop.ui.style.shadcn.shadcnTheme
import scoop.window.*
import scoop.window.native.*

@Test
private class ModalSemanticBoundaryTest {
    @Test
    fun `modal semantics exclude background actions and respect close veto`() {
        val probe = ModalSemanticProbe()
        try {
            context(ThemeSource(shadcnTheme())) {
                UiHost { host, active, event -> probe.event(host, active, event) }.use {
                    host -> Application().run(host)
                }
            }
            assertTrue(probe.finished)
            assertEquals(1, probe.clicks)
        } finally {
            probe.close()
        }
    }
}

internal class ModalSemanticProbe: Closeable {
    val open = state(false)
    var veto = true
    var clicks = 0
    var finished = false
    private var phase = 0
    private var active: ActiveApplication? = None
    private var ui: UiWindow? = None
    private var tree: NativeNode? = None
    private var background: NativeNode? = None
    private var modal: NativeNode? = None
    private var calls: NativeCalls? = None
    fun event(host: UiHost, application: ActiveApplication, event: ApplicationEvent) {
        when (event) {
            case Resumed -> {
                active = Some(application)
                application.setControlFlow(
                    ControlFlow.WaitUntil(MonotonicTimeSource.markNow() + Duration.seconds(20L))
                )
                val window =
                    application.createWindow(
                        windowAttributes {
                            title = "Scoop modal semantic boundary"
                            requestActivation = false
                            size = LogicalSize(500.0, 400.0)
                        }
                    )
                ui = host.attach(window, { scope -> ModalSemanticRoot(this, scope) })
                @Unsafe
                {
                    val lease = window.acquireNativeWindow()
                    try {
                        val view =
                            when (lease.handle) {
                                case AppKit(_, val pointer) -> pointer
                            }
                        tree = Some(NativeNode(nativeRoot(view)!!))
                    } finally {
                        lease.close()
                    }
                }
                background =
                    Some(tree!!.find("background") ?: fail(Some("background semantics missing")))
                calls =
                    Some(NativeCalls(application.proxy()) { tag, result -> completed(tag, result) })
            }
            case NewEvents(StartCause.Deadline) -> fail(
                Some(f"modal semantic phase ${phase} timed out")
            )
            else -> {}
        }
    }
    fun accepted(showing: Boolean) {
        if (phase == 0 && !showing) {
            phase = 1
            later {
                assertTrue(background!!.flag(0))
                open.value = true
            }
        } else
            if (phase == 1 && showing) {
                phase = 2
                later {
                    assertFalse(background!!.flag(0))
                    modal = Some(tree!!.find("modal") ?: fail(Some("dialog semantics missing")))
                    assertEquals(1L, modal!!.trait(9))
                    assertTrue(modal!!.text(6, Some("AXDialog")))
                    calls!!.post(background!!, 0)
                }
            } else
                if (phase == 3 && !showing) {
                    phase = 4
                    later {
                        assertTrue(background!!.flag(0))
                        calls!!.post(background!!, 3)
                    }
                }
    }
    private fun completed(tag: Int, result: Int) {
        when (tag) {
            case 0 -> {
                assertEquals(0, result)
                assertEquals(0, clicks)
                calls!!.post(modal!!, 1, action = 18)
            }
            case 1 -> {
                assertEquals(0, result)
                assertTrue(open.value)
                veto = false
                calls!!.post(modal!!, 2, action = 18)
            }
            case 2 -> {
                assertEquals(1, result)
                assertFalse(open.value)
                phase = 3
            }
            case 3 -> {
                assertEquals(1, result)
                finished = true
                active!!.requestExit()
            }
            else -> fail(Some("unexpected modal semantic action"))
        }
    }
    private fun later(action: () -> Unit) {
        assertTrue(active!!.proxy().post { _ -> action() })
    }
    public override fun close() {
        calls?.close();
        calls = None
        modal?.close();
        modal = None
        background?.close();
        background = None
        tree?.close();
        tree = None
    }
}

private class ModalSemanticRoot(
    private val probe: ModalSemanticProbe,
    scope: ComponentScope
): Component(scope) {
    public override fun render(): View {
        val probe = this.probe
        val showing = probe.open.value
        val body =
            column {
                this.button("Background", { probe.clicks += 1 }) {
                    semantics = advancedSemantics("background", "Background")
                }
                this.dialog(probe.open.binding(), semanticLabel("Dialog content")) {
                    semantics = advancedSemantics("modal", "Confirmation")
                    this.title("Confirmation")
                    this.transition(None)
                    onCloseRequest = { _ -> !probe.veto }
                }
            }
        return element(showing, { value, mount -> ModalSemanticFrame(value, probe, mount) }, [body])
    }
}

private class ModalSemanticFrame(
    private val props: Props<Boolean>,
    private val probe: ModalSemanticProbe,
    scope: ComponentScope
): Element<Unit>(scope) {
    public override fun measure(context: MeasureContext, constraints: Constraints): LayoutResult<
        Unit
    > {
        val child = context.measureChild(0L, constraints)
        context.placeChild(0L, Point(0.0, 0.0))
        return LayoutResult(child, Unit)
    }
    public override fun scene(context: SceneContext, value: Unit) {
        val showing = props.value
        context.children()
        context.onFrameComplete {
            frame -> if (frame.submission == FrameSubmission.Accepted && scope.isMounted)
                probe.accepted(showing)
        }
    }
}
