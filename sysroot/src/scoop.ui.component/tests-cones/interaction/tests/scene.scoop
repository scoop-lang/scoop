package scoop.tests.ui.controls

import scoop.graphics.*
import scoop.graphics.native.withSkiaCanvas
import scoop.graphics.text.*
import scoop.test.*
import scoop.surface.*
import scoop.tests.graphics.readNativePixel
import scoop.ui.*
import scoop.ui.binding as makeBinding
import scoop.ui.component.*
import scoop.ui.style.*
import scoop.window.KeyCode
import scoop.window.PhysicalKey
import scoop.window.ShortcutChord
import scoop.window.ShortcutKey
import scoop.window.ShortcutModifiers

internal class ControlScene(private val probe: ControlProbe, scope: ComponentScope): Component(
    scope
) {
    var count: Int by state(7)
    var mounts = 0
    var unmounts = 0
    public override fun onMount() {
        mounts += 1
        probe.scene = Some(this)
        probe.shortcuts =
            Some(
                scope.resource {
                    ShortcutScope(
                        scope.input,
                        [
                            shortcutBinding(
                                ShortcutChord(
                                    ShortcutKey.Physical(PhysicalKey.Code(KeyCode.KeyN)),
                                    ShortcutModifiers(primary = true)
                                ),
                                { probe.shortcutCalls += 1 }
                            )
                        ]
                    )
                }
            )
        scope.input.captureHandler =
            {
                context,
                event -> if (probe.blockDefaults) {
                    when (event) {
                        case Pointer(
                            InputPointerEvent.Button(_, _, _, _)
                        ) -> context.preventDefault()
                        case Keyboard(_) -> context.preventDefault()
                        else -> {}
                    }
                }
            }
        scope.input.handler =
            {
                context,
                event -> if (probe.blockDefaults && context.phase == RoutedPhase.Bubble) {
                    when (event) {
                        case Pointer(InputPointerEvent.Button(_, _, _, _)) -> {
                            assertTrue(context.defaultPrevented)
                            probe.blockedBubbles += 1
                        }
                        else -> {}
                    }
                }
            }
    }
    public override fun onUnmount() {
        unmounts += 1
    }
    public override fun render(): View {
        probe.renders += 1
        val theme = probe.source.current.value
        val generation = probe.generation.value
        val binding =
            if (probe.useSecond.value)
                probe.secondBinding
            else
                probe.firstBinding
        val delta =
            if (probe.newCallback.value)
                10
            else
                1
        val effects =
            when (probe.effects.value) {
                case 1 -> style {
                    this.contentEffects = [ContentEffect.Glow(3.0, 3.0, Color(0.0, 0.3, 1.0))]
                }
                case 2 -> style { this.contentEffects = [ContentEffect.Blur(1.5, 1.5)] }
                else -> style()
            }
        val buttonStyle = buttonStyle { surface { style { this.corners(Corners.all(9.0)) } } }
        return element(
            PanelProps(generation, count, theme.tokens.palette.background.background),
            { props, mount -> ControlPanel(props, probe, scope = mount) },
            [
                styled(
                    component(
                        ButtonProps(
                            ButtonContent.Custom(
                                component(
                                    LabelProps(
                                        LabelText.Plain(
                                            f"Count: ${this @ControlScene.count}",
                                            None
                                        ),
                                        Some(probe.fonts),
                                        baseStyle = Some(theme.tokens.typography.action)
                                    ),
                                    {
                                        current,
                                        mount -> CustomButtonContent(current, probe, scope = mount)
                                    }
                                )
                            ),
                            { count += delta },
                            binding.value,
                            buttonStyle,
                            focus = FocusOptions(Some(probe.buttonFocus))
                        ),
                        {
                            props, mount ->
                            probe.buttonCreates += 1;
                            Button(props, scope = mount)
                        }
                    )
                ) { this.style = effects },
                component(
                    CheckboxProps(
                        makeBinding(
                            get =
                                {
                                    if (binding.value)
                                        CheckState.Checked
                                    else
                                        CheckState.Unchecked
                                },
                            set = { next -> binding.value = next == CheckState.Checked }
                        ),
                        probe.checkEnabled.value,
                        focus = FocusOptions(Some(probe.checkFocus))
                    ),
                    {
                        props, mount ->
                        probe.checkCreates += 1;
                        Checkbox(props, scope = mount)
                    }
                ),
                checkbox(initialChecked = false) {
                    this.focus = FocusOptions(Some(this @ControlScene.probe.ownedFocus))
                },
                component(
                    LabelProps(
                        LabelText.Plain("Theme body", Some(spanStyle { this.weight = Some(700) })),
                        Some(probe.fonts)
                    ),
                    {
                        props, mount ->
                        probe.labelCreates += 1;
                        Label(props, scope = mount)
                    }
                )
            ]
        )
    }
}

private class PanelProps(val generation: Int, val count: Int, val background: Color)

private class ControlPanel(
    private val props: Props<PanelProps>,
    private val probe: ControlProbe,
    scope: ComponentScope
): Element<Unit>(scope) {
    public override fun update(): UiInvalidation {
        probe.updates += 1
        return UiInvalidation.Layout
    }
    public override fun measure(context: MeasureContext, constraints: Constraints): LayoutResult<
        Unit
    > {
        probe.measures += 1
        probe.buttonMetrics = Some(context.measureChild(0L, Constraints()))
        context.placeChild(0L, Point(20.0, 20.0))
        probe.checkMetrics = Some(context.measureChild(1L, Constraints()))
        context.placeChild(1L, Point(20.0, 100.0))
        context.measureChild(2L, Constraints())
        context.placeChild(2L, Point(140.0, 100.0))
        probe.labelMetrics = Some(context.measureChild(3L, Constraints()))
        context.placeChild(3L, Point(20.0, 180.0))
        return LayoutResult(LayoutMetrics(constraints.constrain(Size(360.0, 240.0))), Unit)
    }
    public override fun scene(context: SceneContext, measured: Unit) {
        probe.paints += 1
        context.draw { paint -> paint.canvas.clear(props.value.background) }
        probe.inScene = true
        try {
            context.children()
        } finally {
            probe.inScene = false
        }
        context.draw {
            paint -> @Unsafe
            {
                paint.canvas.withSkiaCanvas {
                    native -> @Unsafe
                    {
                        probe.buttonPixel = readNativePixel(native, 30.0, 25.0)
                    }
                }
            }
        }
        probe.paintedGeneration = props.value.generation
        probe.paintedCount = props.value.count
    }
}

private class CustomButtonContent(
    private val props: Props<LabelProps>,
    private val probe: ControlProbe,
    scope: ComponentScope
): Component(scope) {
    public override fun onMount() {
        probe.contentMounts += 1
    }
    public override fun render(): View =
        component(props.value, { current, mount -> Label(current, scope = mount) })
    public override fun onUnmount() {
        probe.contentUnmounts += 1
    }
}
