package scoop.tests.ui.variable

import scoop.graphics.*
import scoop.surface.*
import scoop.test.*
import scoop.ui.*
import scoop.ui.component.*
import scoop.window.*

internal class VariableScene(private val probe: VariableProbe, scope: ComponentScope): Component(
    scope
) {
    public override fun render(): View =
        element(
            probe.width.value,
            { props, mount -> VariablePanel(probe, props, scope = mount) },
            [
                if (probe.show.value)
                    virtualList(probe.data!!.value, ItemExtent.Variable(20.0)) {
                        this.state = Some(this @VariableScene.probe.scroll)
                        this.overscan = 20.0
                        this.theme = Some(this @VariableScene.probe.theme)
                        this.handle = Some(this @VariableScene.probe.handle.value)
                        this.anchor = this @VariableScene.probe.anchor.value
                    }
                else
                    empty(),
                component({ mount -> ReadingObserver(probe, scope = mount) })
            ]
        )
}

private class VariablePanel(
    private val probe: VariableProbe,
    private val width: Props<Double>,
    scope: ComponentScope
): Element<Unit>(scope) {
    public override fun onMount() {
        probe.scope = Some(scope)
        assertEquals(None, probe.handle.value.reading)
        scope.resource {
            probe.scroll.observeIntent {
                event ->
                probe.intents.add(event)
                when (event) {
                    case User(_) -> probe.userIntents += 1
                    case LayoutCorrection(revision) -> {
                        assertEquals(revision, probe.scroll.requestRevision)
                        probe.corrections += 1
                    }
                    case Programmatic(_) -> if (probe.overrideRestore) {
                        probe.overrideRestore = false
                        probe.scroll.scrollTo(Point(0.0, 0.0), ScrollOrigin.User)
                    }
                }
            }
        }
    }
    public override fun measure(context: MeasureContext, constraints: Constraints): LayoutResult<
        Unit
    > {
        context.measureChild(0L, Constraints.tight(Size(width.value, 60.0)))
        context.placeChild(0L, Point(20.0, 20.0))
        context.measureChild(1L, Constraints.tight(Size(0.0, 0.0)))
        context.placeChild(1L, Point(0.0, 0.0))
        return LayoutResult(LayoutMetrics(constraints.constrain(Size(220.0, 140.0))), Unit)
    }
    public override fun scene(context: SceneContext, measured: Unit) {
        val ticket = probe.ticket
        val discard = probe.discardNext
        val before = probe.scroll.offset
        val beforeReading = probe.handle.value.reading
        context.onFrameComplete {
            frame -> if (frame.submission == FrameSubmission.Accepted && probe.lateRequest) {
                probe.lateRequest = false
                probe.scroll.scrollTo(Point(0.0, 0.0))
            }
        }
        context.draw { paint -> paint.canvas.clear(Color.White) }
        context.children()
        probe.passes += 1
        if (discard) {
            probe.discardNext = false
            probe.window!!.requestSize(LogicalSize(260.0, 140.0))
        }
        context.onFrameComplete {
            frame -> when (frame.submission) {
                case Accepted -> probe.committed = ticket
                case Discarded -> {
                    assertTrue(discard)
                    assertEquals(before, probe.scroll.offset)
                    assertEquals(beforeReading, probe.handle.value.reading)
                    probe.discarded += 1
                    probe.scope!!.requestFrame()
                }
            }
        }
    }
}

internal class VariableSource(
    private val probe: VariableProbe,
    private val order: Array<Long>? = None,
    private val start: Long = 0L,
    private val length: Long = 100000000L
): ItemSource {
    public override val count: Long get() = order?.size ?: length
    private fun key(index: Long): Long = order?.get(index) ?: start + index
    public override fun keyAt(index: Long): ViewKey = ViewKey.Number(key(index))
    public override fun indexOfKey(key: ViewKey): Long? =
        when (key) {
            case Number(id) -> when (order) {
                case Some(keys) -> {
                    var found: Long? = None
                    for (at in 0L ..< keys.size)
                        if (keys[at] == id)
                            found = Some(at)
                    found
                }
                case None -> {
                    val at = id - start
                    if (at >= 0L && at < length)
                        Some(at)
                    else
                        None
                }
            }
            else -> None
        }
    public override fun build(index: Long): View {
        val id = key(index)
        val height =
            when (id) {
                case 0L -> 0.0
                case 1L -> 40.0
                case 2L -> 10.0
                case 3L -> 30.0
                else -> 20.0
            }
        return component(
            VariableRowInput(id, height),
            { props, mount -> VariableRow(probe, props, scope = mount) }
        )
    }
}

private class VariableRowInput(val key: Long, val height: Double)

internal class VariableRecord(val key: Long) {
    val growth = state(0.0)
    var area: InputArea? = None
    var mounts = 0
    var unmounts = 0
    var disposed = 0
}

private class VariableRow(
    private val probe: VariableProbe,
    private val props: Props<VariableRowInput>,
    scope: ComponentScope
): Component(scope) {
    private val record = VariableRecord(props.value.key)
    init {
        probe.rows.add(record)
    }
    public override fun render(): View {
        val height = props.value.height + record.growth.value
        val children: Array<View> =
            if (record.key == 50L)
                [imageView(probe.image, Size(160.0, height))]
            else
                []
        return element(
            height,
            { value, mount -> VariableInk(record, value, scope = mount) },
            children
        )
    }
    public override fun onMount() {
        record.mounts += 1
        record.area = Some(scope.createArea(focusable = true))
        scope.onDispose { record.disposed += 1 }
    }
    public override fun onUnmount() {
        record.unmounts += 1
        assertTrue(record.area!!.isClosed)
    }
}

private class VariableInk(
    private val record: VariableRecord,
    private val height: Props<Double>,
    scope: ComponentScope
): Element<Unit>(scope) {
    public override fun measure(context: MeasureContext, constraints: Constraints): LayoutResult<
        Unit
    > {
        if (context.childCount > 0L) {
            val image = context.measureChild(0L, constraints)
            context.placeChild(0L, Point(0.0, 0.0))
            return LayoutResult(image, Unit)
        }
        val width = constraints.maxWidth!!
        val factor =
            if (width < 100.0)
                2.0
            else
                1.0
        return LayoutResult(
            LayoutMetrics(constraints.constrain(Size(width, height.value * factor))),
            Unit
        )
    }
    public override fun scene(context: SceneContext, measured: Unit) {
        val bounds = Rect(0.0, 0.0, context.size.width, context.size.height)
        context.place(record.area!!, bounds)
        context.draw { paint -> paint.canvas.drawRect(bounds, Paint(Color(0.2, 0.5, 0.8))) }
        context.children()
    }
}

private class ReadingObserver(private val probe: VariableProbe, scope: ComponentScope): Component(
    scope
) {
    public override fun render(): View {
        probe.readingRenders += 1
        probe.observed = probe.handle.value.reading
        return empty()
    }
}
