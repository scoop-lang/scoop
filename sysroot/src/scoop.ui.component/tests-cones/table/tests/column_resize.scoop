package scoop.tests.ui.table

import scoop.graphics.*
import scoop.test.*
import scoop.ui.*
import scoop.ui.component.*
import scoop.ui.component.frame as resizeFrame
import scoop.ui.component.row as resizeRow
import scoop.ui.style.*
import scoop.ui.style.shadcn.shadcnTheme

internal fun standaloneResize(p: TableProbe): View {
    val handler = p.resizeHandler
    val density = p.theme.current.value.tokens.typography.body.fontSize / 14.0
    val content =
        tableColumnResize(
            observedTableCell(
                p,
                200L,
                0,
                element(
                    Unit,
                    { _, scope -> ResizeMeasuredContent(scope) },
                    [label("Shared header")]
                )
            ),
            binding(
                { p.resizeWidth.value },
                {
                    value -> if (p.resizeAccept)
                        p.resizeWidth.value = value
                }
            )
        ) {
            size = TableColumnSize(GridTrack.Fixed(160.0), 80.0, Some(300.0))
            enabled = !p.disabled
            focus = FocusOptions(Some(p.resizeFocus))
            semantics =
                ComponentSemantics(
                    name = Some("Resize shared column"),
                    automationId = Some("shared-column-resize")
                )
            onResizeStart =
                {
                    p.resizeStarts += 1;
                    p.resizeAllowed
                }
            if (p.resizeCustom)
                onResizeEnd =
                    Some {
                        end ->
                        p.resizeEnds += 1
                        p.resizeFinishedHandler = handler
                        when (end) {
                            case Completed -> {}
                            case Cancelled(_) -> {
                                p.resizeCancels += 1
                                p.resizeWidth.value = Some(90.0)
                            }
                        }
                    }
        }
    return resizeRow {
        add(
            resizeFrame(content) {
                width = Some((p.resizeWidth.value ?: 160.0) * density)
                height = Some(40.0 * density)
            }
        )
    }
}

private class ResizeMeasuredContent(scope: ComponentScope): Element<Long>(scope) {
    public override fun measure(context: MeasureContext, constraints: Constraints): LayoutResult<
        Long
    > {
        val input = context.input<Long>()
        val size =
            constraints.constrain(
                Size(constraints.maxWidth ?: 160.0, constraints.maxHeight ?: 40.0)
            )
        context.measureChild(
            0L,
            Constraints(maxWidth = Some(size.width), maxHeight = Some(size.height))
        )
        context.placeChild(0L, Point(0.0, 0.0))
        return LayoutResult(LayoutMetrics(size), input)
    }
    public override fun scene(context: SceneContext, value: Long) {
        assertEquals(917L, value)
        context.children()
    }
}

private fun beginResize(p: TableProbe) {
    val bounds = p.cell(200L, 0).bounds
    val density = p.theme.current.value.tokens.typography.body.fontSize / 14.0
    p.dragX =
        if (p.rtl)
            bounds.x + 4.0 * density
        else
            bounds.x + bounds.width - 4.0 * density
    p.dragY = bounds.y + bounds.height / 2.0
    p.press(p.dragX, p.dragY, true)
}

private fun nativeResize(p: TableProbe, action: Int = 20, value: String = "") {
    p.resizeWaiting = true
    p.calls!!.post(p.resizeNode ?: p.nativeRoot!!, p.phase, action, value)
}

internal fun inspectResizeSemantics(p: TableProbe, tag: Int) {
    when (tag) {
        case 44 -> {
            p.resizeNode =
                Some(
                    p.nativeRoot!!.find("shared-column-resize") ?:
                        fail(Some("missing public resize handle"))
                )
            assertTrue(p.resizeNode!!.text(0, Some("Resize shared column")))
            assertTrue(p.resizeNode!!.text(2, Some("AXSplitter")))
            assertEquals(160L, p.resizeNode!!.numericValue)
            assertTrue(p.resizeNode!!.flag(1))
        }
        case 79 -> assertFalse(p.resizeNode!!.flag(1))
        case 84 -> assertFalse(p.resizeNode!!.flag(0))
        else -> {}
    }
}

internal fun advanceColumnResize(p: TableProbe) {
    when (p.phase) {
        case 43 -> {
            p.shown = true
            p.standaloneResize = true
            p.finite = false
            p.rtl = false
            p.theme.current.value =
                shadcnTheme() { tokens { motion { preference = MotionPreference.Reduced } } }
            p.changed()
        }
        case 44 -> {
            p.savedCell = Some(p.cell(200L, 0))
            assertEquals(160.0, p.savedCell!!.bounds.width)
            nativeResize(p)
        }
        case 45 -> beginResize(p)
        case 46 -> p.move(p.dragX + 40.0, p.dragY)
        case 47 -> {
            assertEquals(Some(200.0), p.resizeWidth.value)
            assertEquals(1, p.resizeStarts)
            p.press(p.dragX + 40.0, p.dragY, false)
        }
        case 48 -> {
            assertTrue(p.savedCell!! === p.cell(200L, 0))
            beginResize(p)
        }
        case 49 -> p.move(p.dragX + 30.0, p.dragY)
        case 50 -> {
            assertEquals(Some(230.0), p.resizeWidth.value);
            p.key(53)
        }
        case 51 -> {
            assertEquals(Some(200.0), p.resizeWidth.value)
            p.press(p.dragX + 30.0, p.dragY, false)
        }
        case 52 -> beginResize(p)
        case 53 -> p.move(p.dragX + 20.0, p.dragY)
        case 54 -> {
            assertEquals(Some(220.0), p.resizeWidth.value);
            p.resizeWidth.value = Some(170.0)
        }
        case 55 -> {
            assertEquals(Some(170.0), p.resizeWidth.value)
            p.press(p.dragX + 20.0, p.dragY, false)
            p.key(124)
        }
        case 56 -> {
            assertEquals(Some(180.0), p.resizeWidth.value);
            p.key(115)
        }
        case 57 -> {
            assertEquals(None, p.resizeWidth.value)
            p.resizeCustom = true
            p.changed()
        }
        case 58 -> beginResize(p)
        case 59 -> p.move(p.dragX + 40.0, p.dragY)
        case 60 -> {
            assertEquals(Some(200.0), p.resizeWidth.value)
            p.resizeHandler = 2
            p.changed()
        }
        case 61 -> p.key(53)
        case 62 -> {
            assertEquals(Some(90.0), p.resizeWidth.value)
            assertEquals(1, p.resizeEnds)
            assertEquals(1, p.resizeCancels)
            assertEquals(1, p.resizeFinishedHandler)
            p.press(p.dragX + 40.0, p.dragY, false)
            p.resizeAllowed = false
            p.changed()
        }
        case 63 -> beginResize(p)
        case 64 -> p.move(p.dragX + 50.0, p.dragY)
        case 65 -> {
            assertEquals(Some(90.0), p.resizeWidth.value)
            assertEquals(5, p.resizeStarts)
            assertEquals(1, p.resizeEnds)
            p.press(p.dragX + 50.0, p.dragY, false)
            p.resizeAllowed = true
            p.resizeAccept = false
            p.changed()
        }
        case 66 -> beginResize(p)
        case 67 -> p.move(p.dragX + 30.0, p.dragY)
        case 68 -> {
            assertEquals(Some(90.0), p.resizeWidth.value)
            assertEquals(2, p.resizeEnds)
            assertEquals(2, p.resizeCancels)
            p.press(p.dragX + 30.0, p.dragY, false)
            p.resizeAccept = true
            p.rtl = true
            p.resizeWidth.value = None
            p.theme.current.value =
                shadcnTheme() {
                    tokens {
                        typography { body { fontSize = 21.0 } };
                        motion { preference = MotionPreference.Reduced }
                    }
                }
            p.changed()
        }
        case 69 -> {
            assertEquals(240.0, p.cell(200L, 0).bounds.width);
            beginResize(p)
        }
        case 70 -> p.move(p.dragX - 60.0, p.dragY)
        case 71 -> {
            assertEquals(Some(200.0), p.resizeWidth.value)
            assertEquals(300.0, p.cell(200L, 0).bounds.width)
            p.press(p.dragX - 60.0, p.dragY, false)
        }
        case 72 -> {
            assertEquals(3, p.resizeEnds);
            assertEquals(2, p.resizeCancels);
            p.key(124)
        }
        case 73 -> {
            assertEquals(Some(190.0), p.resizeWidth.value);
            p.key(123)
        }
        case 74 -> {
            assertEquals(Some(200.0), p.resizeWidth.value);
            nativeResize(p, 9, "275")
        }
        case 75 -> {
            assertEquals(Some(275.0), p.resizeWidth.value);
            nativeResize(p, 10)
        }
        case 76 -> {
            assertEquals(Some(285.0), p.resizeWidth.value);
            nativeResize(p, 9, "999")
        }
        case 77 -> {
            assertEquals(
                Some(285.0),
                p.resizeWidth.value,
                Some("out-of-range native values preserve the application width")
            )
            p.resizeAccept = false
            nativeResize(p, 11)
        }
        case 78 -> {
            assertEquals(Some(285.0), p.resizeWidth.value);
            p.disabled = true;
            p.changed()
        }
        case 79 -> {
            assertFalse(p.resizeFocus.requestFocus());
            nativeResize(p, 10)
        }
        case 80 -> {
            p.resizeAccept = true
            p.disabled = false
            p.rtl = false
            p.resizeWidth.value = Some(160.0)
            p.theme.current.value =
                shadcnTheme() { tokens { motion { preference = MotionPreference.Reduced } } }
            p.changed()
        }
        case 81 -> beginResize(p)
        case 82 -> p.move(p.dragX + 400.0, p.dragY)
        case 83 -> {
            assertEquals(Some(300.0), p.resizeWidth.value);
            p.shown = false;
            p.changed()
        }
        case 84 -> {
            assertEquals(Some(90.0), p.resizeWidth.value)
            assertEquals(4, p.resizeEnds)
            assertEquals(3, p.resizeCancels)
            nativeResize(p)
        }
        case 85 -> p.native!!.requestDestroy()
        else -> fail(Some("unexpected public resize phase"))
    }
}
