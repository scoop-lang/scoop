package scoop.tests.ui.navigationmenu

import scoop.test.*
import scoop.surface.FocusOrigin
import scoop.ui.*

internal fun navStep(p: NavProbe) {
    when (p.phase) {
        case 0 -> {
            p.pointer(645.0, 490.0);
            assertTrue(p.guides.requestFocus(FocusOrigin.Keyboard))
        }
        case 1 -> {
            assertTrue(p.guides.hasFocus);
            p.key(124)
        }
        case 2 -> {
            assertTrue(p.docs.hasFocus);
            p.key(123)
        }
        case 3 -> {
            assertTrue(p.guides.hasFocus);
            p.key(125)
        }
        case 4 -> {
            assertOpen(p, "guides");
            assertTrue(p.first.hasFocus);
            p.pointer(645.0, 490.0)
        }
        case 5 -> {
            assertOpen(p, "guides");
            p.key(48, "\t")
        }
        case 6 -> {
            assertTrue(p.second.hasFocus);
            p.key(48, "\t", 1);
            p.key(53, "\u001b")
        }
        case 7 -> {
            assertEquals(None, p.open.value);
            assertTrue(p.guides.hasFocus);
            p.hover(2L)
        }
        case 8 -> {
            assertOpen(p, "docs");
            assertTrue(p.guides.hasFocus)
            val bar = p.bounds[0L]!!;
            val panel = p.bounds[200L]!!;
            val trigger = p.bounds[2L]!!
            p.pointer(trigger.x + trigger.width / 2.0, (bar.y + bar.height + panel.y) / 2.0)
        }
        case 9 -> {
            assertOpen(p, "docs");
            p.hover(200L)
        }
        case 10 -> {
            assertOpen(p, "docs");
            p.click(201L)
        }
        case 11 -> {
            assertTrue(p.editor.hasFocus)
            assertEquals(0, navigationMenuText(p.native!!, "设置", false));
            p.key(123)
        }
        case 12 -> {
            assertEquals("设置", p.query.text);
            p.pointer(645.0, 490.0)
        }
        case 13 -> {
            assertOpen(p, "docs");
            assertTrue(p.editor.hasFocus);
            p.key(53, "\u001b")
        }
        case 14 -> {
            assertEquals(None, p.open.value);
            assertTrue(p.docs.hasFocus);
            p.reject = true;
            p.key(125)
        }
        case 15 -> {
            assertEquals(None, p.open.value);
            assertTrue(p.docs.hasFocus);
            p.reject = false;
            p.veto = true;
            p.key(125)
        }
        case 16 -> {
            assertOpen(p, "docs");
            assertTrue(p.editor.hasFocus);
            p.key(53, "\u001b")
        }
        case 17 -> {
            assertOpen(p, "docs");
            assertTrue(p.editor.hasFocus);
            p.veto = false;
            p.key(53, "\u001b")
        }
        case 18 -> {
            assertEquals(None, p.open.value);
            assertTrue(p.docs.hasFocus);
            p.open.value = Some(ViewKey.Text("guides"))
        }
        case 19 -> {
            assertOpen(p, "guides");
            assertTrue(p.docs.hasFocus);
            p.key(123)
        }
        case 20 -> {
            assertTrue(p.guides.hasFocus);
            p.key(124)
        }
        case 21 -> {
            assertOpen(p, "docs");
            assertTrue(p.docs.hasFocus);
            p.key(125)
        }
        case 22 -> {
            assertTrue(p.editor.hasFocus);
            p.pointer(645.0, 490.0);
            p.key(48, "\t")
        }
        case 23 -> {
            assertTrue(p.docFirst.hasFocus);
            p.key(48, "\t")
        }
        case 24 -> {
            assertTrue(p.docSecond.hasFocus);
            p.key(48, "\t")
        }
        case 25 -> {
            assertTrue(p.home.hasFocus);
            assertEquals(None, p.open.value);
            p.key(36, "\r")
        }
        case 26 -> {
            assertEquals(1, p.actions);
            p.vertical = true;
            p.rtl = true;
            p.narrow = true;
            p.changed()
        }
        case 27 -> {
            assertTrue(p.home.hasFocus);
            assertTrue(p.guides.requestFocus(FocusOrigin.Keyboard))
        }
        case 28 -> p.key(123)
        case 29 -> {
            assertOpen(p, "guides");
            assertTrue(p.first.hasFocus)
            val bar = p.bounds[0L]!!;
            val panel = p.bounds[100L]!!
            val docs = p.bounds[2L]!!
            assertTrue(
                docs.x + docs.width > bar.x + bar.width - 30.0,
                Some(f"RTL trigger edge ${docs.x + docs.width}, list edge ${bar.x + bar.width}")
            )
            assertTrue(panel.x + panel.width < p.bounds[1L]!!.x)
            p.key(53, "\u001b")
        }
        case 30 -> {
            assertEquals(None, p.open.value);
            assertTrue(p.guides.hasFocus)
            p.reverse = true;
            p.viewport = false;
            p.vertical = false;
            p.changed()
        }
        case 31 -> {
            assertTrue(p.guides.hasFocus);
            p.open.value = Some(ViewKey.Text("missing"))
        }
        case 32 -> {
            assertOpen(p, "missing");
            assertFalse(p.first.isAttached);
            assertFalse(p.editor.isAttached)
            p.key(125)
        }
        case 33 -> {
            assertOpen(p, "guides");
            p.enabled = false;
            p.changed()
        }
        case 34 -> {
            assertOpen(p, "guides");
            assertFalse(p.first.hasFocus);
            p.shown = false;
            p.changed()
        }
        case 35 -> {
            assertFalse(p.guides.isAttached);
            assertFalse(p.docs.isAttached);
            assertFalse(p.home.isAttached)
            assertFalse(p.editor.isAttached)
            p.shown = true;
            p.enabled = true;
            p.open.value = None;
            p.zero = true;
            p.changed()
        }
        case 36 -> {
            assertEquals(0.0, p.actualWidth);
            p.zero = false;
            p.changed()
        }
        case 37 -> assertTrue(p.docs.requestFocus(FocusOrigin.Keyboard))
        case 38 -> {
            p.prevent = true;
            p.key(125)
        }
        case 39 -> {
            assertEquals(None, p.open.value);
            p.prevent = false;
            p.animate = true;
            p.changed()
        }
        case 40 -> p.key(125)
        case 41 -> {
            assertOpen(p, "docs");
            assertTrue(p.editor.hasFocus)
        }
        case 42 -> {
            assertFalse(p.frames!!.snapshot().required);
            p.quiet = Some(p.frames!!.snapshot())
        }
        case 43 -> {
            assertEquals(p.quiet!!, p.frames!!.snapshot());
            p.key(53, "\u001b")
        }
        case 44 -> {
            assertEquals(None, p.open.value);
            p.shown = false;
            p.changed()
        }
        case 45 -> {
            assertFalse(p.guides.isAttached);
            assertFalse(p.editor.isAttached)
            assertFalse(p.frames!!.snapshot().required);
            p.native!!.requestDestroy()
        }
        else -> throw IllegalStateException(Some("unexpected navigation menu phase"))
    }
}

private fun assertOpen(p: NavProbe, key: String) {
    assertEquals(Some(ViewKey.Text(key)), p.open.value)
}
