package scoop.tests.ui.disclosure

import scoop.test.*
import scoop.ui.style.*
import scoop.ui.style.shadcn.shadcnTheme

internal fun disclosureMounting(p: DisclosureProbe) {
    when (p.phase) {
        case 0 -> {
            assertEquals(0, p.factories[0L])
            for (id in 1L ..< 5L) {
                assertEquals(1, p.factories[id])
                assertEquals(0, p.records[id]!!.measures)
            }
            p.click(0L)
        }
        case 1 -> {
            assertEquals(1, p.requests)
            assertEquals(0, p.callbacks)
            assertFalse(p.open[0L].value)
            p.deny = false
            p.click(0L)
            p.delay = 500L
        }
        case 2 -> {
            assertTrue(p.open[0L].value)
            assertEquals(1, p.factories[0L])
            assertEquals(1, p.callbacks)
            p.records[0L]!!.local.value = 12
            assertTrue(p.records[0L]!!.focus.requestFocus())
        }
        case 3 -> {
            assertTrue(p.records[0L]!!.focus.hasFocus)
            assertEquals(0, disclosureText(p.native!!, "ni", true))
        }
        case 4 -> {
            assertTrue(p.records[0L]!!.model.isComposing)
            p.open[0L].value = false
            p.changed()
            p.delay = 80L
        }
        case 5 -> {
            assertFalse(p.records[0L]!!.focus.hasFocus)
            assertFalse(p.records[0L]!!.model.isComposing)
            assertEquals(0, p.unmounts[0L])
            assertEquals(1, disclosureText(p.native!!, "X", false))
            p.open[0L].value = true
            p.changed()
        }
        case 6 -> {
            assertEquals(1, p.factories[0L])
            assertEquals(12, p.records[0L]!!.observed)
            assertFalse(p.records[0L]!!.focus.hasFocus)
            p.open[0L].value = false
            p.changed()
            p.delay = 500L
        }
        case 7 -> {
            assertEquals(1, p.unmounts[0L])
            assertFalse(p.records[0L]!!.focus.isAttached)
            p.open[1L].value = true
            p.changed()
            p.delay = 500L
        }
        else -> fail(Some("unexpected mount phase"))
    }
}

internal fun disclosureRetention(p: DisclosureProbe) {
    when (p.phase) {
        case 8 -> {
            assertEquals(1, p.factories[1L])
            p.records[1L]!!.local.value = 21
            assertTrue(p.records[1L]!!.focus.requestFocus())
        }
        case 9 -> {
            assertTrue(p.records[1L]!!.focus.hasFocus)
            p.open[1L].value = false
            p.changed()
            p.delay = 500L
        }
        case 10 -> {
            assertFalse(p.records[1L]!!.focus.hasFocus)
            assertEquals(0, p.unmounts[1L])
            p.measured = p.records[1L]!!.measures
            p.records[1L]!!.local.value = 33
            p.records[1L]!!.scope!!.isFrameEnabled = true
            p.records[1L]!!.scope!!.requestFrame()
            p.changed()
        }
        case 11 -> {
            assertEquals(p.generation.value, p.records[1L]!!.version)
            assertEquals(33, p.records[1L]!!.observed)
            assertEquals(p.measured, p.records[1L]!!.measures)
            assertFalse(p.frames!!.snapshot().required)
            p.quiet = Some(p.frames!!.snapshot())
            p.records[1L]!!.scope!!.requestFrame()
            p.delay = 250L
        }
        case 12 -> {
            assertEquals(p.quiet!!.callbacks, p.frames!!.snapshot().callbacks)
            assertEquals(p.quiet!!.presentations, p.frames!!.snapshot().presentations)
            p.open[1L].value = true
            p.changed()
            p.delay = 500L
        }
        case 13 -> {
            assertEquals(1, p.factories[1L])
            assertEquals(33, p.records[1L]!!.observed)
            assertFalse(p.records[1L]!!.focus.hasFocus)
            p.zero = true
            p.changed()
        }
        case 14 -> {
            assertFalse(p.records[1L]!!.focus.hasFocus)
            assertFalse(p.frames!!.snapshot().required)
            p.zero = false
            p.open[0L].value = true
            p.changed()
            p.delay = 500L
        }
        case 15 -> {
            assertEquals(2, p.factories[0L])
            assertEquals(7, p.records[0L]!!.observed)
            p.alternate.value = true
            p.rebound = true
            p.changed()
        }
        else -> fail(Some("unexpected retention phase"))
    }
}

internal fun disclosureNavigation(p: DisclosureProbe) {
    when (p.phase) {
        case 16 -> {
            p.click(0L)
            p.delay = 80L
        }
        case 17 -> {
            assertFalse(p.alternate.value)
            assertTrue(p.open[0L].value)
            assertEquals(1, p.reboundCallbacks)
            assertEquals(1, p.callbacks)
            assertEquals(1, p.unmounts[0L])
            p.theme.current.value =
                shadcnTheme { tokens { motion { this.preference = MotionPreference.Reduced } } }
            p.open[1L].value = false
            p.changed()
        }
        case 18 -> {
            assertEquals(2, p.unmounts[0L])
            assertFalse(p.frames!!.snapshot().required)
            p.selected.value = Some(0)
            p.records[2L]!!.local.value = 29
            assertTrue(p.headers[2L].requestFocus())
            p.changed()
        }
        case 19 -> {
            assertTrue(p.headers[2L].hasFocus)
            p.key(125)
        }
        case 20 -> {
            assertTrue(p.headers[3L].hasFocus)
            assertEquals(Some(0), p.selected.value)
            p.key(119)
        }
        case 21 -> {
            assertTrue(p.headers[3L].hasFocus)
            p.key(49, " ")
        }
        case 22 -> {
            assertEquals(Some(1), p.selected.value)
            assertEquals(1, p.accordionCallbacks)
            assertTrue(p.headers[2L].requestFocus())
        }
        case 23 -> {
            assertTrue(p.headers[2L].hasFocus)
            p.key(48, "\t")
        }
        else -> fail(Some("unexpected navigation phase"))
    }
}

internal fun disclosureReorder(p: DisclosureProbe) {
    when (p.phase) {
        case 24 -> {
            assertTrue(p.headers[3L].hasFocus)
            p.key(49, " ")
        }
        case 25 -> {
            assertEquals(Some(1), p.selected.value)
            assertEquals(1, p.accordionCallbacks)
            p.multiple = true
            p.many.value = [99, 0, 1]
            p.reorder = true
            p.changed()
        }
        case 26 -> {
            for (id in 2L ..< 5L)
                assertEquals(1, p.factories[id])
            assertEquals(29, p.records[2L]!!.observed)
            assertTrue(p.records[2L]!!.focus.requestFocus())
        }
        case 27 -> {
            assertTrue(p.records[2L]!!.focus.hasFocus)
            p.key(125)
            assertTrue(p.records[2L]!!.focus.hasFocus)
            assertEquals(0, disclosureText(p.native!!, "X", false))
            p.reorder = false
            p.changed()
        }
        case 28 -> {
            assertTrue(p.records[2L]!!.focus.hasFocus)
            assertEquals("draftX", p.records[2L]!!.model.text)
            for (id in 2L ..< 5L)
                assertEquals(1, p.factories[id])
            p.native!!.setVisible(false)
            p.delay = 250L
        }
        case 29 -> {
            assertFalse(p.frames!!.snapshot().required)
            assertTrue(p.frames!!.snapshot().paused)
            p.native!!.setVisible(true)
            p.native!!.requestFocus()
            p.changed()
        }
        case 30 -> {
            assertEquals("draftX", p.records[2L]!!.model.text)
            p.enabled = false
            p.changed()
        }
        case 31 -> {
            assertFalse(p.records[2L]!!.focus.hasFocus)
            assertEquals(1, disclosureText(p.native!!, "Y", false))
            p.click(2L)
        }
        else -> fail(Some("unexpected reorder phase"))
    }
}

internal fun disclosureFinish(p: DisclosureProbe) {
    when (p.phase) {
        case 32 -> {
            assertEquals(3L, p.many.value.size)
            assertEquals(99, p.many.value[0L])
            assertEquals(1, p.accordionCallbacks)
            p.gone = true
            p.changed()
        }
        case 33 -> {
            for (id in 0L ..< 5L)
                assertEquals(p.mounts[id], p.unmounts[id])
            assertFalse(p.frames!!.snapshot().required)
            p.quiet = Some(p.frames!!.snapshot())
            p.delay = 250L
        }
        case 34 -> {
            assertEquals(p.quiet!!.callbacks, p.frames!!.snapshot().callbacks)
            assertEquals(p.quiet!!.presentations, p.frames!!.snapshot().presentations)
            p.native!!.requestDestroy()
        }
        else -> fail(Some("unexpected final phase"))
    }
}
