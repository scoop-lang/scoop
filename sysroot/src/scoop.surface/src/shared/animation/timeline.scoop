package scoop.surface

import scoop.graphics.Color
import scoop.graphics.Point
import scoop.graphics.Size
import scoop.platform.concurrent.currentThreadId
import scoop.platform.time.MonotonicTimeSource
import scoop.time.*

internal class AnimationEntry(
    val owner: Closeable,
    val sample: (TimeMark) -> Unit,
    val frameEnabled: () -> Boolean,
    val deadline: () -> TimeMark?
)

private class AnimationCompletion(
    val time: TimeMark,
    val frameEnabled: () -> Boolean,
    val callback: () -> Unit
)

/** Shared owner-thread animation clock, driven by Surface frames or explicit offline sampling. */
public class AnimationTimeline public constructor(
    private val source: TimeSource = MonotonicTimeSource,
    private val invalidate: () -> Unit = {}
): Closeable {
    private val thread = currentThreadId()
    private var closed = false
    private var frame: TimeMark? = None
    private var previous: TimeMark? = None
    private val owned = ArrayList<AnimationEntry>()
    private val active = ArrayList<AnimationEntry>()
    private val groups = ArrayList<AnimationGroup>()
    private val completions = ArrayList<AnimationCompletion>()
    internal var scheduleChanged: () -> Unit = {}
    public val isClosed: Boolean get() = closed
    public val hasWork: Boolean get() {
        checkThread();
        return active.size > 0L || completions.size > 0L
    }
    public val hasFrameWork: Boolean get() {
        checkThread()
        for (entry in active)
            if (entry.frameEnabled())
                return true
        for (entry in completions)
            if (entry.frameEnabled())
                return true
        return false
    }

    public fun value(initial: Double): Animatable<Double> =
        value(initial, AnimationConverters.DoubleValue)
    public fun value(initial: Point): Animatable<Point> =
        value(initial, AnimationConverters.PointValue)
    public fun value(initial: Size): Animatable<Size> =
        value(initial, AnimationConverters.SizeValue)
    public fun value(initial: Color): Animatable<Color> =
        value(initial, AnimationConverters.ColorValue)
    public fun <T> value(initial: T, converter: AnimationConverter<T>): Animatable<T> {
        return createValue(initial, converter, None)
    }
    public fun group(frameEnabled: Boolean = true): AnimationGroup {
        checkOpen()
        val result = AnimationGroup(this, frameEnabled)
        groups.add(result)
        return result
    }
    internal fun <T> createValue(
        initial: T,
        converter: AnimationConverter<T>,
        group: AnimationGroup?
    ): Animatable<T> {
        checkOpen()
        val result = Animatable(this, initial, converter, group)
        val entry =
            AnimationEntry(
                result,
                { time -> result.sample(time) },
                { result.requestsFrames },
                { result.deadline }
            )
        owned.add(entry)
        group?.add(entry)
        return result
    }
    /** Advances all values once; completions run after the sampling pass. */
    public fun advanceTo(time: TimeMark) {
        val repaint = hasFrameWork
        withFrame(time) {}
        if (!closed && repaint)
            invalidate()
    }
    internal fun <T> withFrame(time: TimeMark, block: () -> T): T {
        checkOpen()
        if (frame != None)
            throw IllegalStateException(Some("animation sampling is not reentrant"))
        checkTime(time)
        frame = Some(time)
        try {
            for (animation in active.toArray()) {
                if (closed)
                    break
                animation.sample(time)
            }
            val callbacks = completions.toArray()
            completions.clear()
            for (completion in callbacks) {
                if (closed)
                    break
                completion.callback()
            }
            return block()
        } finally {
            frame = None
            if (!closed)
                scheduleChanged()
        }
    }
    internal fun nextDeadline(includeFrameWork: Boolean): TimeMark? {
        checkThread()
        var next: TimeMark? = None
        for (completion in completions)
            if (next == None || completion.time < next!!)
                next = Some(completion.time)
        for (entry in active) {
            if (includeFrameWork || !entry.frameEnabled()) {
                when (entry.deadline()) {
                    case Some(time) -> if (next == None || time < next!!)
                        next = Some(time)
                    case None -> {}
                }
            }
        }
        return next
    }
    internal fun now(): TimeMark {
        checkOpen()
        when (frame) {
            case Some(value) -> return value;
            case None -> {}
        }
        val result = source.markNow()
        checkTime(result)
        return result
    }
    private fun checkTime(time: TimeMark) {
        requireAnimation(time.source === source, "animation clock source mismatch")
        when (previous) {
            case Some(value) -> requireAnimation(time >= value, "animation time moved backwards");
            case None -> {}
        }
        previous = Some(time)
    }
    internal fun changed(frameEnabled: Boolean) {
        if (!closed) {
            if (frameEnabled)
                invalidate()
            scheduleChanged()
        }
    }
    internal fun schedule(animation: Closeable) {
        checkOpen()
        for (existing in active)
            if (existing.owner === animation)
                return
        for (entry in owned) {
            if (entry.owner === animation) {
                active.add(entry)
                return
            }
        }
        throw IllegalStateException(Some("animation is not owned by this timeline"))
    }
    internal fun unschedule(animation: Closeable) {
        removeAnimationEntry(active, animation)
    }
    internal fun detached(animation: Closeable) {
        unschedule(animation);
        removeAnimationEntry(owned, animation)
    }
    internal fun detachedGroup(group: AnimationGroup) {
        for (index in 0L ..< groups.size) {
            if (groups[index] === group) {
                groups.removeAt(index)
                return
            }
        }
    }
    internal fun finished(time: TimeMark, frameEnabled: () -> Boolean, callback: () -> Unit) {
        if (!closed)
            completions.add(AnimationCompletion(time, frameEnabled, callback))
    }
    internal fun checkThread() {
        if (thread != currentThreadId())
            throw IllegalStateException(Some("animation requires its owner thread"))
    }
    internal fun checkOpen() {
        checkThread()
        if (closed)
            throw IllegalStateException(Some("animation timeline is closed"))
    }
    public override fun close() {
        checkThread()
        if (closed)
            return
        closed = true
        scheduleChanged = {}
        completions.clear()
        for (group in groups.toArray())
            group.close()
        for (animation in owned.toArray())
            animation.owner.close()
        active.clear()
        owned.clear()
    }
}

internal fun removeAnimationEntry(values: ArrayList<AnimationEntry>, wanted: Closeable) {
    var index = 0L
    while (index < values.size) {
        if (values[index].owner === wanted) {
            values.removeAt(index);
            return
        }
        index += 1L
    }
}
