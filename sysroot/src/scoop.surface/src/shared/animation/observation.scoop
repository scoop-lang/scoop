package scoop.surface

/** The revision of one existing timeline value, without exposing its generic payload. */
public interface AnimationSource {
    public val revision: Long
}

/** Optional synchronous read tracking; the timeline remains the only animation scheduler. */
public interface AnimationReadObserver {
    public fun read(source: AnimationSource)
}

internal fun observeAnimation(source: AnimationSource) {
    val observer = contextOrNone<AnimationReadObserver>() ?: return
    observer.read(source)
}
