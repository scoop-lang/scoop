package scoop.surface

import scoop.window.*

internal fun runShortcutBindings(
    context: RoutedEventContext,
    event: InputEvent,
    bindings: Array<ShortcutBinding>,
    isActive: () -> Boolean
) {
    if (!isActive())
        return
    val key =
        when (event) {
            case Keyboard(value) -> value
            else -> return
        }
    if (key.state != ElementState.Pressed || key.synthetic || !shortcutAllowed(context, key))
        return
    var chosen: ShortcutBinding? = None
    for (binding in bindings) {
        if (!isActive())
            return
        if (
            binding.enabled &&
                (!key.isRepeat || binding.allowRepeat) &&
                binding.chord.matches(key) &&
                binding.canExecute()
        ) {
            if (!isActive())
                return
            when (chosen) {
                case Some(_) -> throw IllegalArgumentException(
                    Some("multiple shortcut bindings match this key event")
                )
                case None -> chosen = Some(binding)
            }
        }
    }
    when (chosen) {
        case Some(binding) -> if (isActive()) {
            context.consume()
            binding.action()
        }
        case None -> {}
    }
}
