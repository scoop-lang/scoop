package scoop.surface

import scoop.graphics.Size
import scoop.platform.time.MonotonicTimeSource
import scoop.window.*

public enum SurfaceWindowState {
    Open, Closing, Closed
}

/** Shared owner of painting, frame demand and the renderer's explicit window lease. */
public class SurfaceWindow internal constructor(
    private val host: SurfaceHost,
    public val nativeWindow: Window,
    private val content: SurfaceContent,
    private val renderer: WindowRenderer
): Closeable {
    private var phase = SurfaceWindowState.Open
    private var depth = 0
    private var configured: WindowMetrics? = None
    private val scheduler = FrameScheduler()
    public val animations: AnimationTimeline = windowAnimations(nativeWindow)
    private val inputs = windowInputs(nativeWindow)
    init {
        host.bindShortcuts(inputs.rootScope)
    }
    public val input: InputScope get() {
        host.checkThread()
        return inputs.rootScope
    }
    public val focusedArea: InputArea? get() {
        host.checkThread();
        return inputs.logicalFocus
    }
    public val focusRevision: ULong get() {
        host.checkThread()
        return inputs.focusRevision
    }
    /** Records a deferred or rejected focus intent without changing the current target. */
    public fun reserveFocusRequest(): ULong = inputs.reserveFocusRequest()
    public val inputBoundary: InputBoundary? get() {
        host.checkThread()
        return inputs.currentBoundary
    }
    public val state: SurfaceWindowState get() {
        host.checkThread();
        return phase
    }

    public fun createArea(
        focusable: Boolean = false,
        textInput: Boolean = false,
        parent: InputScope? = None,
        handler: (RoutedEventContext, InputEvent) -> Unit = { _, _ -> Unit }
    ): InputArea = inputs.createArea(focusable, textInput, parent, handler)
    public fun createScope(
        parent: InputScope? = None,
        handler: (RoutedEventContext, InputEvent) -> Unit = { _, _ -> Unit }
    ): InputScope = inputs.createScope(parent, handler)
    public fun clearFocus() {
        inputs.clearFocus()
    }

    public fun requestFrame() {
        host.checkThread()
        if (phase != SurfaceWindowState.Open)
            throw IllegalStateException(Some("Surface window is closing"))
        scheduler.request()
        refresh()
    }
    internal fun refresh() {
        host.checkThread()
        if (phase != SurfaceWindowState.Open)
            return
        if (nativeWindow.state != WindowState.Open) {
            close();
            return
        }
        when (nativeWindow.metrics) {
            case Some(metrics) -> {
                if (configured != Some(metrics)) {
                    renderer.configure(metrics)
                    configured = Some(metrics)
                    scheduler.request()
                    inputs.geometryChanged()
                }
                if (phase != SurfaceWindowState.Open)
                    return
                renderer.setFrameDemand(
                    (scheduler.dirty || animations.hasWork) &&
                        metrics.physicalSize.isDrawable &&
                        nativeWindow.isVisible &&
                        !nativeWindow.isOccluded
                )
            }
            case None -> renderer.setFrameDemand(false)
        }
    }
    internal fun event(event: WindowEvent) {
        host.checkThread()
        if (phase != SurfaceWindowState.Open)
            return
        callback {
            when (event) {
                case Closing -> close()
                case Destroyed -> close()
                case RedrawRequested -> {
                    scheduler.request();
                    render()
                }
                case GeometryChanged(_) -> refresh()
                case Occluded(_) -> {
                    scheduler.request();
                    refresh()
                }
                case ThemeChanged(_) -> requestFrame()
                else -> inputs.event(event)
            }
        }
    }
    private fun render() {
        refresh()
        if (phase != SurfaceWindowState.Open)
            return
        val metrics = configured ?: return
        if (!metrics.physicalSize.isDrawable || !nativeWindow.isVisible || nativeWindow.isOccluded)
            return
        when (renderer.acquire()) {
            case Deferred -> {
                scheduler.request();
                refresh()
            }
            case Ready(frame) -> {
                val time = MonotonicTimeSource.markNow()
                val size = Size(metrics.logicalSize.width, metrics.logicalSize.height)
                val accepted =
                    frame.use {
                        current -> inputs.beginFrame().use {
                            placements ->
                            scheduler.begin()
                            animations.withFrame<Unit>(time) {
                                if (phase == SurfaceWindowState.Open) {
                                    current.draw {
                                        canvas -> content.paint(
                                            FrameContext(this, canvas, size, time, placements)
                                        )
                                    }
                                }
                            }
                            // A painter can resize or close its native window synchronously.
                            refresh()
                            val accepted =
                                if (
                                    phase !=
                                        SurfaceWindowState.Open ||
                                        nativeWindow.state !=
                                        WindowState.Open ||
                                        !nativeWindow.isVisible ||
                                        nativeWindow.isOccluded
                                )
                                    false
                                else
                                    current.submit()
                            if (accepted)
                                inputs.publish(placements)
                            accepted
                        }
                    }
                if (!accepted)
                    scheduler.request()
                if (phase == SurfaceWindowState.Open)
                    content.onFrameComplete(
                        FrameCompletion(
                            time,
                            size,
                            if (accepted)
                                FrameSubmission.Accepted
                            else
                                FrameSubmission.Discarded
                        )
                    )
                refresh()
            }
        }
    }
    private fun callback(block: () -> Unit) {
        depth += 1
        var failure: Throwable? = None
        try {
            block()
        } catch (error: Throwable) {
            failure = Some(error)
        }
        depth -= 1
        when (failure) {
            case Some(_) -> failure = cleanupFailure(failure) { close() }
            case None -> {}
        }
        failure = cleanupFailure(failure) { finishClosing() }
        throwFailure(failure)
    }
    public override fun close() {
        host.checkThread()
        if (phase != SurfaceWindowState.Open)
            return
        phase = SurfaceWindowState.Closing
        host.requestRetirement()
        var failure = cleanupFailure(None) { renderer.setFrameDemand(false) }
        failure = cleanupFailure(failure) { inputs.close() }
        failure = cleanupFailure(failure) { animations.close() }
        throwFailure(cleanupFailure(failure) { finishClosing() })
    }
    internal fun finishClosing() {
        if (phase == SurfaceWindowState.Closing && depth == 0 && !host.callbackActive)
            retire()
    }
    internal fun rollbackAttach() {
        val failure = cleanupFailure(None) { close() }
        // A failed attach has not exposed this window or entered its content callbacks.
        throwFailure(cleanupFailure(failure) { retire() })
    }
    private fun retire() {
        if (phase == SurfaceWindowState.Closed)
            return
        phase = SurfaceWindowState.Closed
        var failure = cleanupFailure(None) { content.close() }
        failure = cleanupFailure(failure) { renderer.close() }
        throwFailure(cleanupFailure(failure) { host.detached(this) })
    }
}

private fun windowAnimations(window: Window): AnimationTimeline =
    AnimationTimeline(MonotonicTimeSource) {
        if (window.state == WindowState.Open)
            window.requestRedraw()
    }

private fun windowInputs(window: Window): InputRouter =
    InputRouter(
        window.isFocused,
        {
            if (window.state == WindowState.Open)
                window.requestRedraw()
        },
        {
            allowed -> if (window.state == WindowState.Open) {
                window.setImeAllowed(allowed)
            }
        },
        {
            rect -> if (window.state == WindowState.Open)
                window.setImeCursorArea(
                    LogicalRect(
                        LogicalPosition(rect.x, rect.y),
                        LogicalSize(rect.width, rect.height)
                    )
                )
        }
    )
