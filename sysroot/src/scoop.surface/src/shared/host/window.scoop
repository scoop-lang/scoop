package scoop.surface

import scoop.graphics.Size
import scoop.platform.time.MonotonicTimeSource
import scoop.time.TimeMark
import scoop.window.*

public enum SurfaceWindowState {
    Open, Closing, Closed
}

/** Shared owner of painting, frame demand and the renderer's explicit window lease. */
public class SurfaceWindow internal constructor(
    private val host: SurfaceHost,
    public val nativeWindow: Window,
    private val content: SurfaceContent,
    private val renderer: WindowRenderer
): Closeable {
    private var phase = SurfaceWindowState.Open
    private var failure: Throwable? = None
    private var depth = 0
    private var configured: WindowMetrics? = None
    private val scheduler = FrameScheduler()
    private var animationDeadline: WindowDeadline? = None
    private var scheduledAnimationTime: TimeMark? = None
    public val animations: AnimationTimeline = windowAnimations(nativeWindow)
    private val inputs = windowInputs(nativeWindow)
    private val regions = WindowRegionStore(this, inputs, host.frameCapabilities())
    init {
        inputs.windowRegions = Some(regions)
        host.bindShortcuts(inputs.rootScope)
        animations.scheduleChanged = { refresh() }
    }
    public val input: InputScope get() {
        host.checkThread()
        return inputs.rootScope
    }
    public val focusedArea: InputArea? get() {
        host.checkThread();
        return inputs.logicalFocus
    }
    public val focusRevision: ULong get() {
        host.checkThread()
        return inputs.focusRevision
    }
    /** Records a deferred or rejected focus intent without changing the current target. */
    public fun reserveFocusRequest(): ULong = inputs.reserveFocusRequest()
    public val focusBoundary: InputBoundary? get() {
        host.checkThread()
        return inputs.currentFocusBoundary
    }
    public val inputBoundary: InputBoundary? get() {
        host.checkThread()
        return inputs.currentBoundary
    }
    public val state: SurfaceWindowState get() {
        host.checkThread();
        return phase
    }

    public fun createArea(
        focusable: Boolean = false,
        textInput: Boolean = false,
        parent: InputScope? = None,
        handler: (RoutedEventContext, InputEvent) -> Unit = { _, _ -> Unit }
    ): InputArea = inputs.createArea(focusable, textInput, parent, handler)
    public fun createScope(
        parent: InputScope? = None,
        handler: (RoutedEventContext, InputEvent) -> Unit = { _, _ -> Unit }
    ): InputScope = inputs.createScope(parent, handler)
    public fun createWindowRegion(
        kind: WindowRegionKind,
        parent: InputScope? = None
    ): WindowRegionHandle = regions.create(kind, parent)
    public fun clearFocus() {
        inputs.clearFocus()
    }

    public fun requestFrame() {
        host.checkThread()
        if (phase != SurfaceWindowState.Open)
            throw IllegalStateException(Some("Surface window is closing"))
        scheduler.request()
        refresh()
    }
    internal fun refresh() {
        host.checkThread()
        if (phase != SurfaceWindowState.Open)
            return
        callback { refreshWindow() }
    }
    internal fun initialize() {
        refreshWindow()
    }
    private fun refreshWindow() {
        if (
            nativeWindow.state !=
                WindowState.Open &&
                nativeWindow.state !=
                WindowState.PendingConfigure
        ) {
            close();
            return
        }
        var drawable = false
        when (nativeWindow.metrics) {
            case Some(metrics) -> {
                if (configured != Some(metrics)) {
                    renderer.configure(metrics)
                    configured = Some(metrics)
                    scheduler.request()
                    regions.geometryChanged()
                    inputs.geometryChanged()
                }
                if (phase != SurfaceWindowState.Open)
                    return
                drawable =
                    metrics.physicalSize.isDrawable &&
                        nativeWindow.isVisible &&
                        !nativeWindow.isOccluded
                renderer.setFrameDemand((scheduler.dirty || animations.hasFrameWork) && drawable)
            }
            case None -> {
                configured = None
                renderer.setFrameDemand(false)
            }
        }
        refreshAnimationDeadline(drawable)
    }
    private fun refreshAnimationDeadline(drawable: Boolean) {
        val next = animations.nextDeadline(!drawable)
        if (next == scheduledAnimationTime)
            return
        scheduledAnimationTime = next
        when (next) {
            case None -> animationDeadline?.cancel()
            case Some(time) -> {
                val deadline =
                    animationDeadline ?:
                        nativeWindow.createDeadline {
                            scheduledAnimationTime = None
                            callback {
                                animations.advanceTo(MonotonicTimeSource.markNow())
                                refresh()
                            }
                        }
                animationDeadline = Some(deadline)
                deadline.schedule(time)
            }
        }
    }
    internal fun event(event: WindowEvent) {
        host.checkThread()
        if (phase != SurfaceWindowState.Open)
            return
        callback {
            when (event) {
                case Closing -> close()
                case Destroyed -> close()
                case RedrawRequested -> {
                    scheduler.request();
                    render()
                }
                case GeometryChanged(_) -> refresh()
                case FrameChanged -> {
                    regions.geometryChanged();
                    requestFrame()
                }
                case Occluded(_) -> {
                    scheduler.request();
                    refresh()
                }
                case ThemeChanged(_) -> requestFrame()
                else -> inputs.event(event)
            }
        }
    }
    private fun render() {
        refresh()
        if (phase != SurfaceWindowState.Open)
            return
        val metrics = configured ?: return
        if (!metrics.physicalSize.isDrawable || !nativeWindow.isVisible || nativeWindow.isOccluded)
            return
        when (renderer.acquire()) {
            case Deferred -> {
                scheduler.request();
                refresh()
            }
            case Ready(frame) -> {
                val time = MonotonicTimeSource.markNow()
                val size = Size(metrics.logicalSize.width, metrics.logicalSize.height)
                val accepted =
                    frame.use {
                        current -> regions.begin(metrics.scaleFactor).use {
                            nativeRegions -> inputs.beginFrame().use {
                                placements ->
                                scheduler.begin()
                                animations.withFrame<Unit>(time) {
                                    if (phase == SurfaceWindowState.Open) {
                                        current.draw {
                                            canvas -> content.paint(
                                                FrameContext(
                                                    this,
                                                    canvas,
                                                    size,
                                                    time,
                                                    placements,
                                                    nativeRegions
                                                )
                                            )
                                        }
                                    }
                                }
                                // A painter can resize or close its native window synchronously.
                                refresh()
                                val accepted =
                                    if (
                                        phase !=
                                            SurfaceWindowState.Open ||
                                            nativeWindow.state !=
                                            WindowState.Open ||
                                            !nativeWindow.isVisible ||
                                            nativeWindow.isOccluded
                                    )
                                        false
                                    else
                                        current.submit()
                                if (accepted) {
                                    regions.publish(nativeRegions)
                                    inputs.publish(placements)
                                }
                                accepted
                            }
                        }
                    }
                if (!accepted)
                    scheduler.request()
                if (phase == SurfaceWindowState.Open)
                    content.onFrameComplete(
                        FrameCompletion(
                            time,
                            size,
                            if (accepted)
                                FrameSubmission.Accepted
                            else
                                FrameSubmission.Discarded
                        )
                    )
                refresh()
            }
        }
    }
    private fun callback(block: () -> Unit) {
        depth += 1
        var error: Throwable? = None
        try {
            block()
        } catch (caught: Throwable) {
            error = Some(caught)
        }
        depth -= 1
        when (error) {
            case Some(value) -> fail(value)
            case None -> finishClosing()
        }
    }
    /** Runs synchronous logical work under this window's callback and retirement boundary. */
    public fun dispatch(block: () -> Unit): Boolean {
        host.checkThread()
        if (phase != SurfaceWindowState.Open)
            return false
        callback(block)
        return phase == SurfaceWindowState.Open
    }
    private fun fail(error: Throwable) {
        failure = cleanupFailure(failure) { throw error }
        stop()
        finishClosing()
    }
    public override fun close() {
        host.checkThread()
        stop()
        finishClosing()
    }
    private fun stop() {
        if (phase != SurfaceWindowState.Open)
            return
        phase = SurfaceWindowState.Closing
        host.requestRetirement()
        failure = cleanupFailure(failure) { renderer.setFrameDemand(false) }
        failure = cleanupFailure(failure) { animationDeadline?.close() }
        failure = cleanupFailure(failure) { regions.close() }
        inputs.windowRegions = None
        failure = cleanupFailure(failure) { inputs.close() }
        failure = cleanupFailure(failure) { animations.close() }
    }
    internal fun finishClosing() {
        if (phase == SurfaceWindowState.Closing && depth == 0 && !host.callbackActive) {
            val error = retire()
            when (error) {
                case Some(value) -> host.reportWindowError(nativeWindow.id, value)
                case None -> {}
            }
        }
    }
    internal fun rollbackAttach() {
        stop()
        // A failed attach has not exposed this window or entered its content callbacks.
        throwFailure(retire())
    }
    private fun retire(): Throwable? {
        if (phase == SurfaceWindowState.Closed)
            return None
        phase = SurfaceWindowState.Closed
        failure = cleanupFailure(failure) { content.close() }
        failure = cleanupFailure(failure) { renderer.close() }
        val error = failure
        failure = None
        // Releasing a failed shared renderer remains a host-level error.
        try {
            host.detached(this)
        } catch (shared: Throwable) {
            throw cleanupFailure(error) { throw shared }!!
        }
        return error
    }
}

private fun windowAnimations(window: Window): AnimationTimeline =
    AnimationTimeline(MonotonicTimeSource) {
        if (window.state == WindowState.Open)
            window.requestRedraw()
    }

private fun windowInputs(window: Window): InputRouter =
    InputRouter(
        window.isFocused,
        {
            if (window.state == WindowState.Open)
                window.requestRedraw()
        },
        {
            allowed -> if (window.state == WindowState.Open) {
                window.setImeAllowed(allowed)
            }
        },
        {
            caret -> if (window.state == WindowState.Open)
                publishWindowCaret(window, caret)
            else
                false
        }
    )
