package scoop.surface

import scoop.graphics.Point
import scoop.window.*

internal fun InputRouter.pointerEvent(event: PointerEvent) {
    when (event) {
        case Cancelled(reason, time) -> {
            cancelPress(InputCancelReason.Window(reason), time, true)
            return
        }
        else -> {}
    }
    val state = eventState(event)
    pointer = Some(state)
    inside = true
    val point = Point(state.logicalPosition.x, state.logicalPosition.y)
    val target = hit(point)
    val fallback =
        if (target.size == 0L)
            path(inputRoot)
        else
            target
    val firstPress =
        when (event) {
            case Button(_, _, ElementState.Pressed, _) -> buttons.size == 0L
            else -> false
        }
    val selected =
        when (event) {
            case Button(_, button, ElementState.Pressed, _) -> {
                if (buttons.size == 0L)
                    pressed = Some(fallback)
                if (!hasButton(buttons, button))
                    buttons.add(button)
                pressed ?: []
            }
            case Button(_, button, ElementState.Released, _) -> {
                val route: Array<InputScope> =
                    if (hasButton(buttons, button))
                        pressed ?: []
                    else
                        []
                removeButton(buttons, button)
                if (buttons.size == 0L)
                    pressed = None
                route
            }
            case Left(_) -> {
                inside = false
                []
            }
            else -> pressed ?: fallback
        }
    // Freeze all coordinates before hover callbacks can change logical or published geometry.
    val chain = deliveries(selected, Some(point))
    val consumed = interceptPress(firstPress, chain, state, event)
    refreshHover(state.time)
    if (consumed)
        return
    val value = InputPointer(state, state.time)
    when (event) {
        case Moved(_) -> route(
            chain,
            InputEvent.Pointer(InputPointerEvent.Moved(value)),
            state.time
        )
        case Button(_, button, state, clicks) -> route(
            chain,
            InputEvent.Pointer(InputPointerEvent.Button(value, button, state, clicks)),
            value.time
        )
        case Wheel(_, delta, phase, momentum) -> {
            val logical =
                when (delta) {
                    case LineDelta(x, y) -> InputScrollDelta.Lines(x, y)
                    case PixelDelta(x, y) -> {
                        requireInput(
                            state.scaleFactor.isFinite() && state.scaleFactor > 0.0,
                            "invalid scroll scale"
                        )
                        InputScrollDelta.Pixels(x / state.scaleFactor, y / state.scaleFactor)
                    }
                }
            route(
                chain,
                InputEvent.Pointer(InputPointerEvent.Wheel(value, logical, phase, momentum)),
                state.time
            )
        }
        else -> {}
    }
}

private fun InputRouter.interceptPress(
    first: Boolean,
    chain: Array<RouteDelivery>,
    state: PointerState,
    event: PointerEvent
): Boolean {
    if (!first || chain.size == 0L)
        return false
    val(button, clicks) =
        when (event) {
            case Button(_, value, ElementState.Pressed, count) -> (value, count)
            else -> return false
        }
    val root = inputRoot
    if (!root.isInputAllowed)
        return false
    try {
        val consumed =
            root.beforePointerPress(
                InputPress(chain[0L].scope, InputPointer(state, state.time), button, clicks)
            )
        if (consumed)
            pressed = Some([])
        return consumed
    } catch (error: Throwable) {
        pressed = Some([])
        throw error
    }
}

internal fun InputRouter.reconcilePress(boundaryChange: Boolean = false) {
    when (pressed) {
        case Some(route) -> {
            if (route.size > 0L && (boundaryChange || !samePath(route, path(route[0L]))))
                cancelPress(
                    if (boundaryChange)
                        InputCancelReason.BoundaryChanged
                    else
                        InputCancelReason.AreaChanged,
                    inputObservation(),
                    false
                )
        }
        case None -> {}
    }
}

internal fun InputRouter.cancelPress(reason: InputCancelReason, time: InputTime, reset: Boolean) {
    val old = pressed ?: []
    pressed =
        if (reset)
            None
        else
            Some([])
    if (reset)
        buttons.clear()
    var failure: Throwable? = None
    for (scope in old)
        failure =
            cleanupFailure(failure) {
                notify(
                    scope,
                    InputEvent.Pointer(InputPointerEvent.Cancelled(reason, time)),
                    time,
                    Some(old[0L]),
                    terminal = true
                )
            }
    throwFailure(failure)
}

internal fun InputRouter.refreshHover(time: InputTime) {
    val next: Array<InputScope> =
        when (pointer) {
            case Some(state) -> if (inside && !closed)
                hit(Point(state.logicalPosition.x, state.logicalPosition.y))
            else
                []
            case None -> []
        }
    replaceHover(next, time)
}

internal fun InputRouter.replaceHover(next: Array<InputScope>, time: InputTime) {
    val old = hover
    hover = next
    val state = pointer
    val entries: Array<RouteDelivery> =
        when (state) {
            case Some(value) -> deliveries(
                next,
                Some(Point(value.logicalPosition.x, value.logicalPosition.y))
            )
            case None -> []
        }
    var failure: Throwable? = None
    for (scope in old) {
        if (!containsScope(next, scope))
            failure =
                cleanupFailure(failure) {
                    notify(
                        scope,
                        InputEvent.Pointer(InputPointerEvent.Left(time)),
                        time,
                        Some(old[0L]),
                        terminal = true
                    )
                }
    }
    var index = entries.size
    while (index > 0L) {
        index -= 1L
        val entry = entries[index]
        if (!containsScope(old, entry.scope))
            failure =
                cleanupFailure(failure) {
                    notify(
                        entry.scope,
                        InputEvent.Pointer(InputPointerEvent.Entered(InputPointer(state!!, time))),
                        time,
                        Some(next[0L]),
                        entry.position
                    )
                }
    }
    throwFailure(failure)
}

private fun eventState(event: PointerEvent): PointerState =
    when (event) {
        case Entered(state) -> state
        case Left(state) -> state
        case Moved(state) -> state
        case Button(state, _, _, _) -> state
        case Wheel(state, _, _, _) -> state
        case Cancelled(_, _) -> throw IllegalStateException(Some("cancel has no pointer position"))
    }

private fun hasButton(buttons: ArrayList<MouseButton>, button: MouseButton): Boolean {
    for (value in buttons)
        if (value == button)
            return true
    return false
}

private fun removeButton(buttons: ArrayList<MouseButton>, button: MouseButton) {
    var index = 0L
    while (index < buttons.size) {
        if (buttons[index] == button) {
            buttons.removeAt(index)
            return
        }
        index += 1L
    }
}
