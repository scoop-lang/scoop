package scoop.surface

public enum InputBoundaryMode {
    AllInput, FocusOnly
}

/** Explicit input barrier; a retired scope stays blocking until this registration closes. */
public class InputBoundary public constructor(
    public val input: InputScope,
    mode: InputBoundaryMode = InputBoundaryMode.AllInput,
    enabled: Boolean = true
): Closeable {
    internal var closed = false
    private val owner = input.owner
    internal var currentMode = mode
    internal var accepts = enabled
    public val mode: InputBoundaryMode get() {
        owner.checkThread()
        return currentMode
    }
    public val enabled: Boolean get() {
        owner.checkThread()
        return accepts
    }
    init {
        input.checkOpen()
        try {
            owner.installBoundary(this)
        } catch (error: Throwable) {
            closed = true
            throwFailure(cleanupFailure(Some(error)) { owner.removeBoundary(this) })
            throw error
        }
    }
    public val isClosed: Boolean get() {
        owner.checkThread()
        return closed
    }
    public val isCurrent: Boolean get() {
        owner.checkThread()
        return !closed && sameBoundary(owner.currentFocusBoundary, Some(this))
    }
    /** Changes effective input policy without moving this registration above its children. */
    public fun update(mode: InputBoundaryMode, enabled: Boolean) {
        owner.checkOpen()
        if (closed)
            throw IllegalStateException(Some("input boundary is closed"))
        if (currentMode == mode && accepts == enabled)
            return
        val previous = owner.currentBoundary
        val affected = accepts || enabled
        currentMode = mode
        accepts = enabled
        if (affected)
            owner.boundaryChanged(previous)
    }
    public override fun close() {
        owner.checkThread()
        if (closed)
            return
        closed = true
        owner.removeBoundary(this)
    }
}

internal fun sameBoundary(left: InputBoundary?, right: InputBoundary?): Boolean =
    when ((left, right)) {
        case(Some(a), Some(b)) -> a === b
        case(None, None) -> true
        else -> false
    }

internal val InputRouter.currentFocusBoundary: InputBoundary? get() {
    val root = inputRoot
    var index = boundaries.size
    while (index > 0L) {
        index -= 1L
        val boundary = boundaries[index]
        if (!boundary.accepts)
            continue
        var cursor: InputScope? = Some(boundary.input)
        while (true) {
            val current = cursor ?: break
            if (current === root)
                return Some(boundary)
            cursor = current.ancestor
        }
    }
    return None
}

internal val InputRouter.currentBoundary: InputBoundary? get() {
    var index = boundaries.size
    while (index > 0L) {
        index -= 1L
        val boundary = boundaries[index]
        if (boundary.accepts && boundary.currentMode == InputBoundaryMode.AllInput)
            return Some(boundary)
    }
    return None
}

internal val InputRouter.inputRoot: InputScope get() = currentBoundary?.input ?: rootScope

internal val InputRouter.focusRoot: InputScope get() = currentFocusBoundary?.input ?: rootScope

internal fun InputRouter.allowsFocus(scope: InputScope): Boolean =
    allows(scope) && withinBoundary(scope, focusRoot)

internal fun InputRouter.installBoundary(value: InputBoundary) {
    checkOpen()
    for (current in boundaries)
        requireInput(current.input !== value.input, "input scope already has a boundary")
    val previous = currentBoundary
    boundaries.add(value)
    if (value.accepts)
        boundaryChanged(previous)
}

internal fun InputRouter.removeBoundary(value: InputBoundary) {
    val previous = currentBoundary
    for (index in 0L ..< boundaries.size) {
        if (boundaries[index] === value) {
            boundaries.removeAt(index)
            if (value.accepts)
                boundaryChanged(previous)
            return
        }
    }
}

private fun InputRouter.boundaryChanged(previous: InputBoundary?) {
    if (!sameBoundary(previous, currentBoundary)) {
        boundaryRevision += 1uL
        pendingBoundaryChange = true
    }
    changed()
}

internal fun InputRouter.allows(scope: InputScope): Boolean {
    if (closed)
        return false
    return withinBoundary(scope, inputRoot)
}

private fun withinBoundary(scope: InputScope, boundary: InputScope): Boolean {
    var reached = false
    var cursor: InputScope? = Some(scope)
    while (true) {
        val current = cursor ?: return reached
        if (current.closed || !current.accepts)
            return false
        if (current === boundary)
            reached = true
        cursor = current.ancestor
    }
}
