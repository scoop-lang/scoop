package scoop.surface

import scoop.graphics.*
import scoop.graphics.native.*

internal class AreaPlacement(
    val area: InputArea,
    val geometry: CanvasGeometry,
    val localCaret: Rect?,
    val caretRevision: Long?,
    val visibleCaret: Rect?
)

/** Owns one published set of independent native geometry snapshots. */
internal class AreaScene(val placements: Array<AreaPlacement>): Closeable {
    fun find(area: InputArea): AreaPlacement? {
        for (placement in placements)
            if (placement.area === area)
                return Some(placement)
        return None
    }
    public override fun close() {
        var failure: Throwable? = None
        for (placement in placements)
            failure = cleanupFailure(failure) { placement.geometry.close() }
        throwFailure(failure)
    }
}

/** A frame transaction owns snapshots until they are transferred at successful submission. */
internal class InputFrame(val owner: InputRouter): Closeable {
    private val placements = ArrayList<AreaPlacement>()
    private var ended = false
    fun place(canvas: Canvas, area: InputArea, shape: Rect) {
        check(area)
        @Unsafe
        {
            append(canvas, area, captureGeometry(canvas, shape)) { child -> child.clipRect(shape) }
        }
    }
    fun place(canvas: Canvas, area: InputArea, shape: Path) {
        check(area)
        @Unsafe
        {
            append(canvas, area, captureGeometry(canvas, shape)) { child -> child.clipPath(shape) }
        }
    }
    private fun check(area: InputArea) {
        owner.checkOpen()
        if (ended)
            throw IllegalStateException(Some("input frame has ended"))
        requireInput(area.owner === owner, "input area belongs to another window")
        area.checkOpen()
        for (placement in placements) {
            requireInput(placement.area !== area, "area placed twice in one frame")
        }
    }
    private fun append(
        canvas: Canvas,
        area: InputArea,
        geometry: CanvasGeometry,
        clip: (Canvas) -> Unit
    ) {
        try {
            val local = area.caret
            val visible =
                when (local) {
                    case Some(rect) -> canvas.withState {
                        child ->
                        clip(child)
                        @Unsafe
                        {
                            return@withState captureGeometry(child, rect).use {
                                caret -> caret.visibleBounds
                            }
                        }
                    }
                    case None -> None
                }
            placements.add(AreaPlacement(area, geometry, local, area.caretRevision, visible))
        }
        catch (error: Throwable) {
            throwFailure(cleanupFailure(Some(error)) { geometry.close() });
            throw error
        }
    }
    fun take(): AreaScene {
        owner.checkOpen()
        if (ended)
            throw IllegalStateException(Some("input frame has ended"))
        val result = AreaScene(placements.toArray())
        ended = true
        placements.clear()
        return result
    }
    public override fun close() {
        owner.checkThread()
        if (ended)
            return
        ended = true
        var failure: Throwable? = None
        for (placement in placements)
            failure = cleanupFailure(failure) { placement.geometry.close() }
        placements.clear()
        throwFailure(failure)
    }
}

internal fun InputRouter.path(scope: InputScope): Array<InputScope> {
    val result = ArrayList<InputScope>()
    val boundary = inputRoot
    var reached = false
    var next: InputScope? = Some(scope)
    while (true) {
        val current =
            next ?:
                return if (reached)
                    result.toArray()
                else
                    []
        if (current.closed || !current.accepts)
            return []
        if (!reached) {
            when (current.area) {
                case Some(area) -> {
                    val placement = scene.find(area) ?: return []
                    if (placement.geometry.toLocal(Point(0.0, 0.0)) == None)
                        return []
                }
                case None -> {}
            }
            result.add(current)
            if (current === boundary)
                reached = true
        }
        next = current.ancestor
    }
}

internal fun InputRouter.hit(point: Point): Array<InputScope> {
    var index = scene.placements.size
    while (index > 0L) {
        index -= 1L
        val placement = scene.placements[index]
        if (
            !placement.area.closed &&
                !placement.area.ignoreSelf &&
                placement.geometry.hitTest(point)
        ) {
            val result = path(placement.area.scope)
            if (result.size > 0L)
                return result
        }
    }
    return []
}
