package scoop.surface

import scoop.graphics.Point
import scoop.graphics.native.CanvasGeometry
import scoop.window.InputTime

internal class RouteFlags(
    val cancelable: Boolean,
    val scroll: ScrollConsumption? = None,
    val gesture: InputGestureRoute? = None,
    val contact: InputContactRoute? = None,
    val movement: ContactConsumption? = None
) {
    var stopped = false
    var prevented = false
    var remainder: RouteRemainder? = None
}

/** A synchronous delivery borrow; propagation and default cancellation are independent. */
public class RoutedEventContext internal constructor(
    private val owner: InputRouter,
    private val destination: InputScope,
    private val receiver: InputScope,
    private val stage: RoutedPhase,
    private val stamp: InputTime,
    private val position: Point?,
    private val geometry: CanvasGeometry?,
    private val flags: RouteFlags
) {
    private var active = true
    public val target: InputScope get() {
        checkActive()
        return destination
    }
    public val currentTarget: InputScope get() {
        checkActive()
        return receiver
    }
    public val phase: RoutedPhase get() {
        checkActive()
        return stage
    }
    public val time: InputTime get() {
        checkActive()
        return stamp
    }
    public val localPosition: Point? get() {
        checkActive()
        return position
    }
    public val cancelable: Boolean get() {
        checkActive()
        return flags.cancelable
    }
    public val propagationStopped: Boolean get() {
        checkActive()
        return flags.stopped
    }
    public val defaultPrevented: Boolean get() {
        checkActive()
        return flags.prevented
    }
    /** Remaining source-unit displacement; the event itself keeps its original delta. */
    public val scrollRemaining: InputScrollDelta? get() {
        checkActive()
        return when (flags.scroll) {
            case Some(val scroll) -> Some(scroll.remaining)
            case None -> None
        }
    }
    /** Applies a local portion, then returns the unconsumed displacement to source units. */
    public fun consumeScroll(
        lineStep: Double,
        onRemainder: ((Point) -> Point)? = None,
        apply: (Point) -> Point
    ) {
        checkActive()
        if (stage != RoutedPhase.Default)
            throw IllegalStateException(Some("scroll consumption requires the default phase"))
        val scroll = flags.scroll ?: throw IllegalStateException(Some("event is not a wheel"))
        if (!flags.prevented) {
            scroll.consume(lineStep, geometry, position, apply)
            when (onRemainder) {
                case Some(val action) -> {
                    val delivery = RouteDelivery(receiver, position, geometry)
                    flags.remainder =
                        Some(
                            RouteRemainder(delivery) {
                                scroll.consume(
                                    lineStep,
                                    delivery.geometry,
                                    delivery.position,
                                    action,
                                    true
                                )
                            }
                        )
                }
                case None -> {}
            }
        }
    }
    /** Remaining window-logical movement after the contact owner opens this delivery. */
    public val contactRemaining: Point? get() {
        checkActive()
        return if (owner.contactDeliveryAllowed(flags.contact, receiver))
            when (flags.movement) {
                case Some(val movement) -> movement.remaining
                case None -> None
            }
        else
            None
    }
    /** The contact owner opens movement sharing; ancestors consume only its remainder. */
    public fun consumeContactMovement(
        onRemainder: ((Point) -> Point)? = None,
        apply: (Point) -> Point
    ) {
        checkActive()
        if (stage != RoutedPhase.Default)
            throw IllegalStateException(Some("contact consumption requires the default phase"))
        val movement =
            flags.movement ?: throw IllegalStateException(Some("event is not a contact movement"))
        if (!flags.prevented && owner.contactDeliveryAllowed(flags.contact, receiver)) {
            movement.consume(receiver, geometry, apply)
            when (onRemainder) {
                case Some(val action) -> {
                    val delivery = RouteDelivery(receiver, position, geometry)
                    flags.remainder =
                        Some(
                            RouteRemainder(delivery) {
                                movement.consume(delivery.scope, delivery.geometry, action, true)
                            }
                        )
                }
                case None -> {}
            }
        }
    }
    public fun stopPropagation() {
        checkActive()
        if (flags.cancelable)
            flags.stopped = true
    }
    public fun preventDefault() {
        checkActive()
        if (flags.cancelable)
            flags.prevented = true
    }
    public fun consume() {
        checkActive()
        if (flags.cancelable) {
            flags.stopped = true
            flags.prevented = true
        }
    }
    private fun checkActive() {
        owner.checkThread()
        if (!active)
            throw IllegalStateException(Some("routed event context has ended"))
    }
    internal fun end() {
        active = false
    }
}
