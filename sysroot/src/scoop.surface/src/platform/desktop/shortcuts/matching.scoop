package scoop.surface

import scoop.window.*

internal fun ShortcutModifiers.matches(event: Modifiers): Boolean =
    shift ==
        event.shift &&
        (control || (primary && !primaryUsesSuper())) ==
        event.control &&
        alt ==
        event.alt &&
        (superKey || (primary && primaryUsesSuper())) ==
        event.superKey &&
        function ==
        event.function

private fun sameModifiers(left: ShortcutModifiers, right: ShortcutModifiers): Boolean =
    left.shift ==
        right.shift &&
        (left.control || (left.primary && !primaryUsesSuper())) ==
        (right.control || (right.primary && !primaryUsesSuper())) &&
        left.alt ==
        right.alt &&
        (left.superKey || (left.primary && primaryUsesSuper())) ==
        (right.superKey || (right.primary && primaryUsesSuper())) &&
        left.function ==
        right.function

private fun sameKey(left: ShortcutKey, right: ShortcutKey): Boolean =
    when ((left, right)) {
        case(Logical(a), Logical(b)) -> a.matchesShortcut(b)
        case(Physical(a), Physical(b)) -> a == b
        else -> false
    }

internal fun ShortcutKey.matches(event: KeyEvent): Boolean =
    when (this) {
        case Logical(key) -> key.matchesShortcut(event.logicalKey)
        case Physical(key) -> key == event.physicalKey
    }

internal fun checkedBindings(bindings: Array<ShortcutBinding>): Array<ShortcutBinding> {
    for (index in 0L ..< bindings.size) {
        val current = bindings[index]
        if (!current.enabled)
            continue
        for (previous in 0L ..< index) {
            val other = bindings[previous]
            requireInput(
                !other.enabled ||
                    !sameModifiers(current.modifiers, other.modifiers) ||
                    !sameKey(current.key, other.key),
                "duplicate enabled shortcut combination"
            )
        }
    }
    return bindings
}

/** Ancestors must not reinterpret text, dead keys or an AltGr chord as a bare shortcut. */
internal fun shortcutAllowed(context: RoutedEventContext, event: KeyEvent): Boolean {
    if (context.currentTarget === context.target)
        return true
    val editing =
        when (context.target.area) {
            case Some(area) -> area.textInput
            case None -> false
        }
    if (!editing)
        return true
    when (event.logicalKey) {
        case Dead(_) -> return false
        else -> {}
    }
    val modifiers = event.modifiers
    if (modifiers.superKey || (modifiers.control && !modifiers.alt))
        return true
    return when (event.logicalKey) {
        case Named(value) -> value != NamedKey.Space
        else -> false
    }
}
