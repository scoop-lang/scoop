package scoop.surface

import scoop.graphics.*
import scoop.test.*
import scoop.window.*

@Test
private class InputScrollTest {
    @Test
    fun `nested scroll keeps source units while each receiver applies its own scale and line step`() {
        InputRig().use {
            rig ->
            val parent = rig.area("parent")
            val child = rig.area("child", parent = Some(parent.scope))
            val amounts = ArrayList<Point>()
            val original = InputScrollDelta.Lines(2.0, -3.0)
            rig.frame {
                frame, canvas ->
                frame.place(canvas, parent, Rect(0.0, 0.0, 150.0, 100.0))
                canvas.withState {
                    scaled ->
                    scaled.scale(2.0, 4.0)
                    frame.place(scaled, child, Rect(0.0, 0.0, 40.0, 25.0))
                }
            }
            child.scope.defaultAction =
                {
                    context,
                    event -> when (event) {
                        case Pointer(InputPointerEvent.Wheel(_, val delta, _, _)) -> {
                            assertEquals(original, delta)
                            assertEquals(Some(original), context.scrollRemaining)
                            context.consumeScroll(10.0) {
                                amount ->
                                amounts.add(amount);
                                Point(5.0, -2.5)
                            }
                            assertEquals(
                                Some(InputScrollDelta.Lines(1.0, -2.0)),
                                context.scrollRemaining
                            )
                        }
                        else -> {}
                    }
                }
            parent.scope.defaultAction =
                {
                    context,
                    event -> when (event) {
                        case Pointer(InputPointerEvent.Wheel(_, val delta, _, _)) -> {
                            assertEquals(original, delta)
                            context.consumeScroll(20.0) {
                                amount ->
                                amounts.add(amount);
                                Point(0.0, -40.0)
                            }
                            assertEquals(
                                Some(InputScrollDelta.Lines(1.0, 0.0)),
                                context.scrollRemaining
                            )
                        }
                        else -> {}
                    }
                }
            rig.router.rootScope.defaultAction =
                {
                    context,
                    event -> when (event) {
                        case Pointer(InputPointerEvent.Wheel(_, val delta, _, _)) -> {
                            assertEquals(original, delta)
                            context.consumeScroll(40.0) {
                                amount ->
                                amounts.add(amount);
                                amount
                            }
                            assertEquals(
                                Some(InputScrollDelta.Lines(0.0, 0.0)),
                                context.scrollRemaining
                            )
                        }
                        else -> {}
                    }
                }
            rig.wheel(8.0, 8.0, ScrollDelta.LineDelta(2.0, -3.0), scale = 3.0)
            assertEquals(3L, amounts.size)
            assertEquals(Point(10.0, -7.5), amounts[0L])
            assertEquals(Point(20.0, -40.0), amounts[1L])
            assertEquals(Point(40.0, 0.0), amounts[2L])
        }
    }

    @Test
    fun `pixel scroll is normalized once and propagation cancellation leaves the residual defaults`() {
        InputRig().use {
            rig ->
            val child = rig.area("child")
            val amounts = ArrayList<Point>()
            rig.frame {
                frame, canvas ->
                canvas.scale(2.0, 4.0)
                frame.place(canvas, child, Rect(0.0, 0.0, 40.0, 25.0))
            }
            child.scope.handler =
                {
                    context,
                    event -> when (event) {
                        case Pointer(
                            InputPointerEvent.Wheel(_, _, _, _)
                        ) -> context.stopPropagation()
                        else -> {}
                    }
                }
            child.scope.defaultAction =
                {
                    context,
                    event -> when (event) {
                        case Pointer(InputPointerEvent.Wheel(_, val delta, _, _)) -> {
                            assertEquals(InputScrollDelta.Pixels(8.0, -16.0), delta)
                            context.consumeScroll(10.0) {
                                amount ->
                                amounts.add(amount);
                                Point(2.0, -2.0)
                            }
                        }
                        else -> {}
                    }
                }
            rig.router.rootScope.defaultAction =
                {
                    context,
                    event -> when (event) {
                        case Pointer(InputPointerEvent.Wheel(_, _, _, _)) -> {
                            assertTrue(context.propagationStopped)
                            assertEquals(
                                Some(InputScrollDelta.Pixels(4.0, -8.0)),
                                context.scrollRemaining
                            )
                            context.consumeScroll(999.0) {
                                amount ->
                                amounts.add(amount);
                                amount
                            }
                        }
                        else -> {}
                    }
                }
            rig.wheel(8.0, 8.0, ScrollDelta.PixelDelta(16.0, -32.0), scale = 2.0)
            assertEquals(2L, amounts.size)
            assertEquals(Point(4.0, -4.0), amounts[0L])
            assertEquals(Point(4.0, -8.0), amounts[1L])
            rig.router.rootScope.captureHandler =
                {
                    context,
                    event -> when (event) {
                        case Pointer(
                            InputPointerEvent.Wheel(_, _, _, _)
                        ) -> context.preventDefault()
                        else -> {}
                    }
                }
            rig.wheel(8.0, 8.0, ScrollDelta.PixelDelta(16.0, -32.0), scale = 2.0)
            assertEquals(2L, amounts.size)
        }
    }

    @Test
    fun `rotated partial scroll uses the geometry captured before a handler publishes a new frame`() {
        InputRig().use {
            rig ->
            val child = rig.area("child")
            val amounts = ArrayList<Point>()
            rig.frame {
                frame, canvas ->
                canvas.concat(Transform(0.0, 1.0, -1.0, 0.0, 100.0, 0.0))
                frame.place(canvas, child, Rect(0.0, 0.0, 50.0, 50.0))
            }
            child.scope.handler =
                {
                    _,
                    event -> when (event) {
                        case Pointer(InputPointerEvent.Wheel(_, _, _, _)) -> rig.frame {
                            frame, canvas ->
                            canvas.scale(3.0, 3.0)
                            frame.place(canvas, child, Rect(0.0, 0.0, 50.0, 50.0))
                        }
                        else -> {}
                    }
                }
            child.scope.defaultAction =
                {
                    context,
                    event -> when (event) {
                        case Pointer(InputPointerEvent.Wheel(_, _, _, _)) -> {
                            assertEquals(Some(Point(20.0, 20.0)), context.localPosition)
                            context.consumeScroll(1.0) {
                                amount ->
                                amounts.add(amount);
                                Point(8.0, 0.0)
                            }
                            assertEquals(
                                Some(InputScrollDelta.Pixels(12.0, 0.0)),
                                context.scrollRemaining
                            )
                        }
                        else -> {}
                    }
                }
            rig.router.rootScope.defaultAction =
                {
                    context,
                    event -> when (event) {
                        case Pointer(InputPointerEvent.Wheel(_, _, _, _)) -> {
                            context.consumeScroll(1.0) {
                                amount ->
                                amounts.add(amount);
                                amount
                            }
                        }
                        else -> {}
                    }
                }
            rig.wheel(80.0, 20.0, ScrollDelta.PixelDelta(12.0, 8.0))
            assertEquals(2L, amounts.size)
            assertEquals(Point(8.0, -12.0), amounts[0L])
            assertEquals(Point(12.0, 0.0), amounts[1L])
        }
    }

    @Test
    fun `scroll borrows validate consumption and containment cancels the remaining default work`() {
        InputRig().use {
            rig ->
            val borrows = ArrayList<RoutedEventContext>()
            val counts = ArrayList<Point>()
            val child = rig.area("child")
            rig.frame { frame, canvas -> frame.place(canvas, child, Rect(0.0, 0.0, 50.0, 50.0)) }
            child.scope.handler =
                {
                    context,
                    event -> when (event) {
                        case Pointer(InputPointerEvent.Wheel(_, _, _, _)) -> {
                            assertFailsWith<IllegalStateException> {
                                context.consumeScroll(1.0) { point -> point }
                            }
                        }
                        else -> {}
                    }
                }
            child.scope.defaultAction =
                {
                    context,
                    event -> when (event) {
                        case Pointer(InputPointerEvent.Wheel(_, _, _, _)) -> {
                            borrows.add(context)
                            assertFailsWith<IllegalArgumentException> {
                                context.consumeScroll(0.0) { point -> point }
                            }
                            assertFailsWith<IllegalArgumentException> {
                                context.consumeScroll(1.0) { _ -> Point(-1.0, 0.0) }
                            }
                            assertFailsWith<IllegalArgumentException> {
                                context.consumeScroll(1.0) { _ -> Point(4.0, 0.0) }
                            }
                            assertFailsWith<IllegalStateException> {
                                context.consumeScroll(1.0) {
                                    _ ->
                                    context.consumeScroll(1.0) { point -> point };
                                    Point(0.0, 0.0)
                                }
                            }
                            assertEquals(
                                Some(InputScrollDelta.Lines(2.0, 3.0)),
                                context.scrollRemaining
                            )
                            context.consumeScroll(1.0) {
                                point ->
                                counts.add(point);
                                Point(1.0, 0.0)
                            }
                            assertEquals(
                                Some(InputScrollDelta.Lines(1.0, 3.0)),
                                context.scrollRemaining
                            )
                            context.preventDefault()
                            context.consumeScroll(1.0) {
                                _ -> fail(Some("prevented consumption ran"))
                            }
                        }
                        else -> {}
                    }
                }
            rig.router.rootScope.defaultAction =
                {
                    context,
                    event -> when (event) {
                        case Pointer(InputPointerEvent.Wheel(_, _, _, _)) -> fail(
                            Some("containment reached the parent")
                        )
                        case Keyboard(_) -> {
                            assertEquals(None, context.scrollRemaining)
                            assertFailsWith<IllegalStateException> {
                                context.consumeScroll(1.0) { point -> point }
                            }
                        }
                        else -> {}
                    }
                }
            rig.wheel(10.0, 10.0, ScrollDelta.LineDelta(2.0, 3.0))
            assertEquals(1L, counts.size)
            assertFailsWith<IllegalStateException> { borrows[0L].scrollRemaining }
            assertFailsWith<IllegalStateException> {
                borrows[0L].consumeScroll(1.0) { point -> point }
            }
            rig.router.event(WindowEvent.Keyboard(inputKey()))
            child.scope.defaultAction =
                {
                    context,
                    event -> when (event) {
                        case Pointer(InputPointerEvent.Wheel(_, _, _, _)) -> {
                            context.consumeScroll(1.0) {
                                _ -> fail(Some("zero delta invoked apply"))
                            }
                            context.preventDefault()
                        }
                        else -> {}
                    }
                }
            rig.wheel(10.0, 10.0, ScrollDelta.LineDelta(0.0, 0.0), ScrollPhase.MayBegin)
        }
    }
}
