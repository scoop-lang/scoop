package scoop.surface

import scoop.platform.concurrent.Thread
import scoop.test.*
import scoop.time.*

private class GroupClock: TimeSource {
    var reading = Duration.ZERO
    var calls = 0
    public override fun markNow(): TimeMark {
        calls += 1
        return TimeMark(this, reading)
    }
}

@Test
private class AnimationGroupTest {
    @Test
    fun `group visibility preserves local frame choices and closes only its own values`() {
        val clock = GroupClock()
        val completions = ArrayList<Double>()
        AnimationTimeline(clock).use {
            timeline ->
            val group = timeline.group(false)
            val visible = group.value(0.0)
            val muted = group.value(0.0)
            val outside = timeline.value(0.0)
            muted.isFrameEnabled = false
            visible.animateTo(
                100.0,
                AnimationSpec.Tween(Duration.seconds(1L)),
                onFinished = Some { result -> completions.add(result) }
            )
            muted.animateTo(100.0, AnimationSpec.Tween(Duration.seconds(1L)), Some(Repeat()))
            assertFalse(timeline.hasFrameWork)
            clock.reading = Duration.milliseconds(250L)
            val before = clock.calls
            group.isFrameEnabled = true
            assertEquals(before + 1, clock.calls)
            assertEquals(25.0, visible.value)
            assertEquals(25.0, muted.value)
            assertFalse(muted.isFrameEnabled)
            assertTrue(timeline.hasFrameWork)
            group.isFrameEnabled = false
            clock.reading = Duration.seconds(1L)
            timeline.advanceTo(clock.markNow())
            assertEquals(1L, completions.size)
            assertEquals(100.0, completions[0L])
            assertFalse(timeline.hasFrameWork)
            clock.reading = Duration.milliseconds(1250L)
            group.isFrameEnabled = true
            assertEquals(25.0, muted.value)
            assertFalse(muted.isFrameEnabled)
            assertFalse(timeline.hasFrameWork)
            outside.animateTo(1.0)
            Thread.start {
                assertFailsWith<IllegalStateException> { group.isFrameEnabled }
                assertFailsWith<IllegalStateException> { group.close() }
            }.use { thread -> thread.join() }
            group.close()
            group.close()
            assertEquals(AnimationState.Closed, visible.state)
            assertEquals(AnimationState.Closed, muted.state)
            assertEquals(AnimationState.Running, outside.state)
            assertTrue(group.isClosed)
            assertFailsWith<IllegalStateException> { group.value(2.0) }
            assertFailsWith<IllegalStateException> { group.isFrameEnabled = true }
            val empty = timeline.group()
            timeline.close()
            assertTrue(empty.isClosed)
            assertEquals(AnimationState.Closed, outside.state)
        }
    }

    @Test
    fun `group cleanup closes every member even when scheduling notification fails`() {
        val clock = GroupClock()
        AnimationTimeline(clock).use {
            timeline ->
            val group = timeline.group()
            val first = group.value(0.0)
            val second = group.value(1.0)
            first.animateTo(10.0)
            second.animateTo(20.0)
            timeline.scheduleChanged = { throw IllegalStateException(Some("schedule failure")) }
            assertFailsWith<ResourceUseException> { group.close() }
            assertTrue(group.isClosed)
            assertEquals(AnimationState.Closed, first.state)
            assertEquals(AnimationState.Closed, second.state)
            assertFalse(timeline.hasWork)
            group.close()
        }
    }
}
