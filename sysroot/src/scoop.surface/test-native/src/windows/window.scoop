package scoop.tests.surface

import scoop.window.*
import scoop.window.native.*
import scoop.tests.window.scheduleNativeMode

public fun observeWindow(window: Window, customContent: Boolean = false): ViewProbe {
    @Unsafe
    {
        return window.acquireNativeWindow().use {
            lease -> @Unsafe
            {
                return@use when (lease.handle) {
                    case Win32(val hwnd, _) -> ViewProbe(hwnd, customContent)
                }
            }
        }
    }
}

public fun surfaceNativeModeCount(): Int = 3

public fun surfaceDocumentCaret(window: Window, rect: LogicalRect?, cursor: Long): Boolean {
    @Unsafe
    {
        return window.acquireNativeWindow().use {
            lease -> @Unsafe
            {
                return@use when (lease.handle) {
                    case Win32(val hwnd, _) -> documentCaret(
                        hwnd,
                        rect != None,
                        rect?.origin?.x ?: 0.0,
                        rect?.origin?.y ?: 0.0,
                        rect?.size?.width ?: 0.0,
                        rect?.size?.height ?: 0.0,
                        cursor
                    )
                }
            }
        }
    }
}

@Extern(name = "scoop_window_test_document_caret")
private fun documentCaret(
    window: Ptr<Unit>,
    available: Boolean,
    x: Double,
    y: Double,
    width: Double,
    height: Double,
    cursor: Long
): Boolean

/** Reads the composed desktop at a logical point inside this window. */
public fun sampleWindowPixel(window: Window, x: Double, y: Double): Long {
    @Unsafe
    {
        return window.acquireNativeWindow().use {
            lease -> @Unsafe
            {
                return@use when (lease.handle) {
                    case Win32(val hwnd, _) -> desktopPixel(hwnd, x, y)
                }
            }
        }
    }
}

@Extern(name = "scoop_surface_test_desktop_pixel")
private fun desktopPixel(window: Ptr<Unit>, x: Double, y: Double): Long

public fun scheduleSurfaceNativeMode(window: Window, kind: Int) {
    @Unsafe
    {
        window.acquireNativeWindow().use {
            lease -> @Unsafe
            {
                when (lease.handle) {
                    case Win32(val hwnd, _) -> if (scheduleNativeMode(hwnd, kind, 250) != 1)
                        throw IllegalStateException(Some("cannot enter native modal loop"))
                }
            }
        }
    }
}
