package scoop.tests.surface

import scoop.window.*
import scoop.window.native.*
import scoop.tests.window.scheduleNativeMode

public fun observeWindow(window: Window, customContent: Boolean = false): ViewProbe {
    @Unsafe
    {
        return window.acquireNativeWindow().use {
            lease -> @Unsafe
            {
                return@use when (lease.handle) {
                    case AppKit(_, view) -> ViewProbe(view, customContent)
                }
            }
        }
    }
}

public fun surfaceNativeModeCount(): Int = 2

public fun surfaceDocumentCaret(window: Window, rect: LogicalRect?, cursor: Long): Boolean {
    @Unsafe
    {
        return window.acquireNativeWindow().use {
            lease -> @Unsafe
            {
                return@use when (lease.handle) {
                    case AppKit(_, view) -> documentCaret(
                        view,
                        rect != None,
                        rect?.origin?.x ?: 0.0,
                        rect?.origin?.y ?: 0.0,
                        rect?.size?.width ?: 0.0,
                        rect?.size?.height ?: 0.0,
                        cursor
                    )
                }
            }
        }
    }
}

@Extern(name = "scoop_surface_test_document_caret")
private fun documentCaret(
    view: Ptr<Unit>,
    available: Boolean,
    x: Double,
    y: Double,
    width: Double,
    height: Double,
    cursor: Long
): Boolean

public fun moveSurfacePointer(window: Window, x: Double, y: Double): Boolean {
    @Unsafe
    {
        return window.acquireNativeWindow().use {
            lease -> @Unsafe
            {
                return@use when (lease.handle) {
                    case AppKit(_, view) -> movePointer(view, x, y)
                }
            }
        }
    }
}

public fun sendSurfaceKey(
    window: Window,
    code: Int,
    pressed: Boolean,
    repeat: Boolean = false,
    command: Boolean = false,
    shift: Boolean = false
): Boolean {
    @Unsafe
    {
        return window.acquireNativeWindow().use {
            lease -> @Unsafe
            {
                return@use when (lease.handle) {
                    case AppKit(_, view) -> sendKey(view, code, pressed, repeat, command, shift)
                }
            }
        }
    }
}

@Extern(name = "scoop_surface_test_pointer_move")
private fun movePointer(view: Ptr<Unit>, x: Double, y: Double): Boolean

@Extern(name = "scoop_surface_test_key")
private fun sendKey(
    view: Ptr<Unit>,
    code: Int,
    pressed: Boolean,
    repeat: Boolean,
    command: Boolean,
    shift: Boolean
): Boolean

public fun scheduleSurfaceNativeMode(window: Window, kind: Int) {
    @Unsafe
    {
        window.acquireNativeWindow().use {
            lease -> @Unsafe
            {
                when (lease.handle) {
                    case AppKit(nativeWindow, _) -> scheduleNativeMode(nativeWindow, kind, 0.25)
                }
            }
        }
    }
}
