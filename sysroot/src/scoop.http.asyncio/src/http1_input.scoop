package scoop.http.asyncio

import scoop.asyncio.*
import scoop.http.*
import scoop.platform.io.UnexpectedEofException
import scoop.platform.time.MonotonicTimeSource
import scoop.time.Duration

internal suspend fun nextH1Event(state: H1State): Http1Event? {
    while (true) {
        val(ready, ended) =
            state.lock.withLock {
                val event = state.events.removeFirstOrNone()
                if (present(event))
                    return@withLock (event, false)
                h1Open(state)
                if (state.decoder.isSwitched)
                    throw IllegalStateException(Some("HTTP/1 transport has switched protocols"))
                (event, state.inputEnded)
            }
        if (present(ready))
            return ready
        if (ended)
            return None
        val received: Long? =
            if (state.input.readableBytes == 0L) {
                state.input.clear()
                val requested = state.input.writableBytes
                beginH1Io(state, true)
                val count = state.transport.readInto(state.input, requested)
                httpProgress(count, requested)
                progressH1Io(state, true, count > 0L)
                Some(count)
            } else
                None
        val next =
            state.lock.withLock {
                h1Open(state)
                if (present(received)) {
                    if (received!! > 0L && state.captureTimings)
                        state.inputReceivedAt = Some(MonotonicTimeSource.markNow())
                    if (received!! == 0L) {
                        state.inputEnded = true;
                        state.decoder.endInput()
                    }
                }
                if (state.input.readableBytes != 0L) {
                    if (state.captureTimings) {
                        val received = state.decoder.receiveWithProgress(state.input)
                        for (_ in 0L ..< received.startedMessages)
                            state.responseStarts!!.addLast(state.inputReceivedAt!!)
                    } else
                        state.decoder.receive(state.input)
                }
                while (true) {
                    val event = state.decoder.nextEvent()
                    if (!present(event))
                        break
                    state.events.addLast(event!!)
                }
                state.events.removeFirstOrNone()
            }
        if (present(next))
            return next
    }
}

internal fun advanceH1End(state: H1State, body: H1Input) {
    val listener = state.lock.withLock { advanceH1EndLocked(state, body) }
    if (present(listener))
        listener!!.dispose()
}

private fun advanceH1EndLocked(state: H1State, body: H1Input): Disposable? {
    if (present(body.bytes))
        return None
    while (state.events.size != 0L) {
        when (state.events.firstOrNone()!!) {
            case Trailers(val fields) -> {
                state.events.removeFirst()
                body.trailers = Some(fields)
            }
            case End(val keepAlive) -> {
                state.events.removeFirst()
                body.keepAlive = keepAlive
                body.life.completed = true
                resumeH1AfterRejection(state, body)
                state.incoming = None
                return completeH1BodyLocked(body.life)
            }
            else -> return None
        }
    }
    return None
}

internal fun resumeH1AfterRejection(state: H1State, body: H1Input) {
    if (
        !body.responseFinished ||
            !body.life.completed ||
            !state.decoder.isSwitched ||
            state.encoder.isSwitched
    )
        return
    state.decoder.resumeHttp1()
    if (state.events.size != 0L) {
        val switched =
            when (state.events.firstOrNone()!!) {
                case Switch -> true;
                else -> false
            }
        if (switched)
            state.events.removeFirst()
    }
}

private fun requireH1Head(state: H1State, role: HttpRole) {
    if (state.decoder.role != role)
        throw IllegalStateException(Some("wrong HTTP/1 receive role"))
    if (present(state.incoming))
        throw IllegalStateException(Some("previous HTTP/1 body is not complete"))
    if (role == HttpRole.Client && state.clientPending == 0L)
        throw IllegalStateException(Some("no HTTP/1 request is awaiting a response"))
}

private fun incomingH1(
    state: H1State,
    readIdle: Duration?,
    finalResponse: Boolean = false
): H1Input {
    val body = H1Input(finalResponse, readIdle)
    val listener =
        state.lock.withLock {
            state.incoming = Some(body)
            advanceH1EndLocked(state, body)
        }
    if (present(listener))
        listener!!.dispose()
    if (!body.life.completed)
        listenH1Body(state, body.life, httpJob(state.loop, true))
    return body
}

internal suspend fun receiveH1Request(state: H1State, readIdle: Duration?): Http1IncomingRequest? {
    val operation =
        beginH1Operation<Unit>(state, true, { requireH1Head(state, HttpRole.Server) }, readIdle)
    val result =
        try {
            operation.job.ensureActive()
            val next = nextH1Event(state)
            if (!present(next))
                None
            else
                when (next!!) {
                    case Request(val head) -> {
                        val body = incomingH1(state, readIdle)
                        state.lock.withLock {
                            state.requests.addLast(H1RequestContext(head.method, body))
                        }
                        Some(Http1IncomingRequest(head, AsyncHttp1Body(state, body)))
                    }
                    else -> throw IllegalStateException(Some("expected an HTTP/1 request head"))
                }
        } catch (error: Throwable) {
            failH1Operation(operation, error)
        }
    endH1Operation(operation)
    return result
}

internal suspend fun receiveH1Response(state: H1State, readIdle: Duration?): Http1IncomingResponse {
    val operation =
        beginH1Operation<Unit>(state, true, { requireH1Head(state, HttpRole.Client) }, readIdle)
    val result =
        try {
            operation.job.ensureActive()
            val next = nextH1Event(state)
            if (!present(next))
                throw UnexpectedEofException()
            when (next!!) {
                case Response(val head) -> {
                    if (head.status >= 200U || head.status == 101U)
                        state.lock.withLock { state.clientPending -= 1L }
                    val firstByteAt =
                        state.lock.withLock {
                            if (state.captureTimings)
                                Some(state.responseStarts!!.removeFirst())
                            else
                                None
                        }
                    Http1IncomingResponse(
                        head,
                        AsyncHttp1Body(
                            state,
                            incomingH1(state, readIdle, head.status >= 200U || head.status == 101U)
                        ),
                        firstByteAt
                    )
                }
                else -> throw IllegalStateException(Some("expected an HTTP/1 response head"))
            }
        } catch (error: Throwable) {
            failH1Operation(operation, error)
        }
    endH1Operation(operation)
    return result
}

internal suspend fun closeAfterH1Input(state: H1State, body: H1Input) {
    val close = state.lock.withLock { closeAfterH1InputLocked(state, body) }
    if (close)
        closeH1(state)
}

internal fun closeAfterH1InputLocked(state: H1State, body: H1Input): Boolean {
    if (state.closed || !body.life.completed || state.decoder.isSwitched)
        return false
    if (state.decoder.role == HttpRole.Client) {
        if (body.finalResponse && (!body.keepAlive || state.encoder.mustClose))
            state.closeAfterOutput = true
        return state.closeAfterOutput && !present(state.outgoing)
    }
    return body.responseFinished && !body.keepAlive
}
