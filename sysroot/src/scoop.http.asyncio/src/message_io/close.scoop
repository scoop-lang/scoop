package scoop.http.asyncio

import scoop.asyncio.*

internal suspend fun <T> closeMessageIo(state: MessageIo<T>) {
    if (state.lock.withLock { state.closed }) return
    val job = httpJob(state.loop, false)
    suspendCoroutine<Unit> { continuation ->
        val result: (Boolean, Job?) = state.lock.withLock {
            if (state.closed) (true, None)
            else {
                state.closeWaiters.add(continuation)
                if (!state.closing) { state.closing = true; state.closeJob = Some(job) }
                (false, state.active)
            }
        }
        val (closed, active) = result
        if (closed) continuation.resume(Unit)
        else {
            when (active) { case Some(val value) -> value.cancel(); case None -> {} }
            startMessageClose(state)
        }
    }
}

internal fun <T> startMessageClose(state: MessageIo<T>) {
    val start = state.lock.withLock {
        if (!state.closing || state.running || state.cleanupStarted) false
        else { state.cleanupStarted = true; true }
    }
    if (!start) return
    val job = state.closeJob!!
    val loop = state.loop
    context(job) { context(loop) {
        startCoroutine<Unit>(suspend {
            var failure = messageCleanup(None) { val cleanup = state.cleanup!!; cleanup() }
            when (state.owner) {
                case Some(val owner) -> {
                    try { owner.close() }
                    catch (error: Throwable) { failure = Some(when (failure) {
                        case Some(val primary) -> ResourceUseException(primary, error)
                        case None -> error
                    }) }
                }
                case None -> {}
            }
            when (failure) { case Some(val error) -> throw error; case None -> {} }
        }, MessageCloseCompletion(state))
    } }
}

private class MessageCloseCompletion<T>(val state: MessageIo<T>) : Continuation<Unit> {
    public override fun resume(value: Unit) { finish(None) }
    public override fun resumeWithException(exception: Throwable) { finish(Some(exception)) }
    private fun finish(failure: Throwable?) {
        val waiters = state.lock.withLock {
            state.closed = true
            state.endpoint = None
            state.owner = None
            state.cleanup = None
            state.closeJob = None
            val result = state.closeWaiters.toArray()
            state.closeWaiters.clear()
            result
        }
        for (waiter in waiters) when (failure) {
            case Some(val error) -> waiter.resumeWithException(error)
            case None -> waiter.resume(Unit)
        }
    }
}

internal fun messageCleanup(primary: Throwable?, block: () -> Unit): Throwable? {
    try { block(); return primary }
    catch (error: Throwable) { return Some(when (primary) {
        case Some(val first) -> ResourceUseException(first, error)
        case None -> error
    }) }
}
