package scoop.http.asyncio

import scoop.asyncio.*
import scoop.time.Duration

internal struct H1Operation<P>(
    val state: H1State,
    val reading: Boolean,
    val prepared: P,
    val job: Job,
    val cancellation: Disposable
)

internal fun <P> beginH1Operation(
    state: H1State,
    reading: Boolean,
    prepare: () -> P,
    idle: Duration? = None
): H1Operation<P> {
    val job = httpJob(state.loop, true)
    httpIdleLimit(idle)
    val prepared =
        state.lock.withLock {
            h1Open(state)
            if (
                if (reading)
                    state.readBusy
                else
                    state.writeBusy
            )
                throw IllegalStateException(Some("HTTP/1 direction is busy"))
            val value = prepare()
            val clock =
                if (present(idle))
                    Some(H1Idle(reading, idle!!))
                else
                    None
            if (reading) {
                state.readBusy = true
                state.readIdle = clock
            } else {
                state.writeBusy = true
                state.writeIdle = clock
            }
            value
        }
    val listener =
        job.invokeOnCancellation {
            error ->
            state.lock.withLock { terminateH1(state, error) }
            driveH1Close(state)
        }
    return H1Operation(state, reading, prepared, job, listener)
}

private fun h1ClosedFailure(error: Throwable, selected: Throwable): Throwable {
    if (error is IoClosedException)
        return selected
    if (error is ResourceUseException) {
        val primary = h1ClosedFailure(error.primaryFailure, selected)
        if (primary !== error.primaryFailure)
            return ResourceUseException(primary, error.cleanupFailure)
    }
    return error
}

internal fun <P> endH1Operation(operation: H1Operation<P>) {
    operation.cancellation.dispose()
    val state = operation.state
    val closing =
        state.lock.withLock {
            if (operation.reading) {
                state.readBusy = false
                state.readIdle = None
            } else {
                state.writeBusy = false
                state.writeIdle = None
            }
            state.closing
        }
    if (closing)
        driveH1Close(state)
}

internal suspend fun <P> failH1Operation(operation: H1Operation<P>, error: Throwable): Nothing {
    val state = operation.state
    val selected = state.lock.withLock { state.primary }
    val failure =
        if (present(selected))
            h1ClosedFailure(error, selected!!)
        else
            error
    endH1Operation(operation)
    failH1Operation(state, failure)
}

internal suspend fun failH1Operation(state: H1State, primary: Throwable): Nothing {
    val cleanup =
        try {
            closeH1(state);
            state.lock.withLock { state.closeFailure }
        }
        catch (error: Throwable) {
            Some(error)
        }
    when (cleanup) {
        case Some(val error) -> throw ResourceUseException(primary, error)
        case None -> throw primary
    }
}
