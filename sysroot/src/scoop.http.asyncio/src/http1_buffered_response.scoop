package scoop.http.asyncio

import scoop.asyncio.*
import scoop.http.*
import scoop.platform.io.WriteZeroException
import scoop.platform.memory.NativeByteBorrow
import scoop.platform.memory.NativeByteBuffer
import scoop.time.Duration

@GCLeaf
@Extern(name = "scoop_platform_memory_move")
private fun moveResponseBytes(destination: Ptr<Byte>, source: Ptr<Byte>, count: Long)

/** Body progress for one completed or failed immutable-array response operation. */
public class Http1ResponseProgress public constructor() {
    private var written: Long = 0L
    /** Actual accepted body bytes, readable after the associated send returns or throws. */
    public val writtenBytes: Long get() = written
    internal fun record(value: Long) {
        written = value
    }
}

private enum H1ResponseSource {
    Native(NativeByteBorrow)
    Bytes(Array<Byte>, Http1ResponseProgress?)
}

private class H1ResponseTransfer(val source: H1ResponseSource, val length: Long) {
    var headSize: Long = 0L
    var sent: Long = 0L

    fun bodyProgress(): Long =
        if (sent > headSize)
            sent - headSize
        else
            0L

    fun copyInto(buffer: NativeByteBuffer, offset: Long, count: Long) {
        when (source) {
            case Native(val borrow) -> @Unsafe
            {
                val pointer = borrow.pointer()!! + offset
                buffer.withWritableBytes {
                    destination, _ ->
                    @Unsafe
                    {
                        moveResponseBytes(destination!!, pointer, count)
                    }
                    count
                }
            }
            case Bytes(val bytes, _) -> buffer.writeBytes(bytes, offset, count)
        }
    }

    fun complete() {
        when (source) {
            case Native(val borrow) -> @Unsafe
            {
                borrow.complete(bodyProgress())
            }
            case Bytes(_, val progress) -> progress?.record(bodyProgress())
        }
    }
}

internal suspend fun sendH1BufferedResponse(
    state: H1State,
    head: HttpResponseHead,
    buffer: NativeByteBuffer,
    count: Long,
    writeIdle: Duration?
) {
    httpJob(state.loop, true)
    httpIdleLimit(writeIdle)
    httpCount(count, buffer.readableBytes)
    @Unsafe
    {
        val transfer =
            H1ResponseTransfer(H1ResponseSource.Native(buffer.borrowReadable(count)), count)
        sendH1CompleteResponse(state, head, transfer, writeIdle)
    }
}

internal suspend fun sendH1ArrayResponse(
    state: H1State,
    head: HttpResponseHead,
    bytes: Array<Byte>,
    count: Long,
    writeIdle: Duration?,
    progress: Http1ResponseProgress?
) {
    httpJob(state.loop, true)
    httpIdleLimit(writeIdle)
    httpCount(count, bytes.size)
    progress?.record(0L)
    val transfer = H1ResponseTransfer(H1ResponseSource.Bytes(bytes, progress), count)
    sendH1CompleteResponse(state, head, transfer, writeIdle)
}

private suspend fun sendH1CompleteResponse(
    state: H1State,
    head: HttpResponseHead,
    transfer: H1ResponseTransfer,
    writeIdle: Duration?
) {
    try {
        val operation =
            beginH1Operation<(H1Output, Array<Byte>)>(
                state,
                false,
                {
                    requireH1Output(state, HttpRole.Server)
                    val request =
                        state.requests.firstOrNone() ?:
                            throw IllegalStateException(Some("no HTTP/1 request to answer"))
                    val content = httpResponseAllowsContent(head, request.method)
                    val count = transfer.length
                    if (!content && count != 0L)
                        throw IllegalArgumentException(
                            Some("this HTTP response cannot carry a body")
                        )
                    val framing =
                        if (content)
                            Http1BodyFraming.Length(count)
                        else
                            Http1BodyFraming.Empty
                    val bytes = state.encoder.beginResponse(head, request.method, framing)
                    state.encoder.prepareBody(count)
                    state.encoder.finish()
                    val output =
                        H1Output(
                            head.status >= 200U || head.status == 101U,
                            Some(request),
                            writeIdle
                        )
                    state.outgoing = Some(output)
                    (output, bytes)
                },
                writeIdle
            )
        val body =
            try {
                operation.job.ensureActive()
                val(output, bytes) = operation.prepared
                writeH1BufferedResponse(state, bytes, transfer)
                completeH1Output(state, output)
                output
            } catch (error: Throwable) {
                failH1Operation(operation, error)
            }
        endH1Operation(operation)
        closeAfterH1Output(state, body)
    } finally {
        transfer.complete()
    }
}

private suspend fun writeH1BufferedResponse(
    state: H1State,
    head: Array<Byte>,
    transfer: H1ResponseTransfer
) {
    transfer.headSize = head.size
    if (head.size > Long.MAX_VALUE - transfer.length)
        throw ArithmeticException()
    val size = head.size + transfer.length
    val blockSize =
        if (size < 65536L)
            size
        else
            65536L
    state.output.clear()
    state.output.ensureWritable(blockSize)
    var position = 0L
    while (position < size) {
        state.output.clear()
        if (position < head.size) {
            val remaining = head.size - position
            val count =
                if (remaining < blockSize)
                    remaining
                else
                    blockSize
            state.output.writeBytes(head, position, count)
            position += count
        }
        val available = blockSize - state.output.readableBytes
        if (position >= head.size && position < size && available > 0L) {
            val offset = position - head.size
            val remaining = size - position
            val count =
                if (remaining < available)
                    remaining
                else
                    available
            transfer.copyInto(state.output, offset, count)
            position += count
        }
        while (state.output.readableBytes > 0L) {
            beginH1Io(state, false)
            val before = state.output.readableBytes
            val written =
                try {
                    state.transport.writeFrom(state.output, before)
                }
                finally {
                    transfer.sent += before - state.output.readableBytes
                }
            httpProgress(written, before)
            if (before - state.output.readableBytes != written)
                throw IllegalStateException(
                    Some("HTTP transport reported inconsistent write progress")
                )
            if (written == 0L)
                throw WriteZeroException()
            progressH1Io(state, false, true)
        }
    }
    flushH1Transport(state)
}
