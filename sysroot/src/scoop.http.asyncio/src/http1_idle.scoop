package scoop.http.asyncio

import scoop.http.HttpProtocol
import scoop.platform.time.MonotonicTimeSource
import scoop.time.Duration
import scoop.time.TimeMark

internal class H1Idle(val limit: Duration) {
    var clock: HttpIoClock? = None
}

// A wakeup belongs to the connection, never to an operation that may already have returned.
internal class H1IdleAlarm(val started: TimeMark, val delay: Duration) {
    var notification: Disposable? = None
}

internal suspend fun <T> withH1Idle(
    state: H1State,
    reading: Boolean,
    limit: Duration?,
    block: suspend () -> T
): T {
    if (limit == None)
        return block()
    val idle = H1Idle(limit!!)
    state.lock.withLock {
        if (reading)
            state.readIdle = Some(idle)
        else
            state.writeIdle = Some(idle)
    }
    try {
        return block()
    }
    finally {
        state.lock.withLock {
            if (reading)
                state.readIdle = None
            else
                state.writeIdle = None
        }
    }
}

internal fun beginH1Io(state: H1State, reading: Boolean) {
    val error: HttpIoTimeoutException? =
        state.lock.withLock {
            h1Open(state)
            val idle =
                if (reading)
                    state.readIdle
                else
                    state.writeIdle
            if (!present(idle))
                return@withLock None
            val value = idle!!
            val now = MonotonicTimeSource.markNow()
            val start = !present(value.clock)
            if (start)
                value.clock =
                    Some(
                        HttpIoClock(
                            if (reading)
                                HttpIoDirection.Read
                            else
                                HttpIoDirection.Write,
                            HttpProtocol.Http1,
                            0,
                            value.limit,
                            now
                        )
                    )
            val clock = value.clock!!
            val expired = clock.expired(now)
            if (present(expired))
                terminateH1(state, expired!!)
            else
                if (start)
                    armH1IdleLocked(state, reading, clock, now)
            expired
        }
    if (present(error)) {
        driveH1Close(state)
        throw error!!
    }
}

internal fun progressH1Io(state: H1State, reading: Boolean, progressed: Boolean) {
    val error: HttpIoTimeoutException? =
        state.lock.withLock {
            h1Open(state)
            val idle =
                if (reading)
                    state.readIdle
                else
                    state.writeIdle
            if (!present(idle))
                return@withLock None
            val clock = idle!!.clock!!
            val now = MonotonicTimeSource.markNow()
            val expired = clock.expired(now)
            if (present(expired))
                terminateH1(state, expired!!)
            else
                if (progressed)
                    clock.progress = now
            expired
        }
    if (present(error)) {
        driveH1Close(state)
        throw error!!
    }
}

// The state lock serializes replacement, callback selection, and connection cleanup.
private fun armH1IdleLocked(state: H1State, reading: Boolean, clock: HttpIoClock, now: TimeMark) {
    val remaining = clock.remaining(now)
    val previous =
        if (reading)
            state.readAlarm
        else
            state.writeAlarm
    when (previous) {
        case Some(val alarm) -> if (alarm.delay - (now - alarm.started) <= remaining)
            return
        case None -> {}
    }
    val alarm = H1IdleAlarm(now, remaining)
    if (reading)
        state.readAlarm = Some(alarm)
    else
        state.writeAlarm = Some(alarm)
    if (present(previous))
        previous!!.notification?.dispose()
    val job = state.ownerJob!!
    val loop = state.loop
    context(job) {
        context(loop) {
            alarm.notification =
                Some(
                    loop.schedule(
                        remaining,
                        { failure -> finishH1IdleTick(state, reading, alarm, failure) }
                    )
                )
        }
    }
}

private fun finishH1IdleTick(
    state: H1State,
    reading: Boolean,
    alarm: H1IdleAlarm,
    failure: Throwable?
) {
    try {
        state.lock.withLock {
            val current =
                if (reading)
                    state.readAlarm
                else
                    state.writeAlarm
            when (current) {
                case Some(val active) -> if (active !== alarm)
                    return@withLock
                case None -> return@withLock
            }
            if (reading)
                state.readAlarm = None
            else
                state.writeAlarm = None
            alarm.notification = None
            if (state.closing)
                return@withLock
            val idle =
                if (reading)
                    state.readIdle
                else
                    state.writeIdle
            if (!present(idle) || !present(idle!!.clock))
                return@withLock
            val clock = idle!!.clock!!
            val now = MonotonicTimeSource.markNow()
            val error: Throwable? =
                when (failure) {
                    case Some(val value) -> Some(value)
                    case None -> when (clock.expired(now)) {
                        case Some(val timeout) -> Some(timeout)
                        case None -> None
                    }
                }
            if (present(error))
                terminateH1(state, error!!)
            else
                armH1IdleLocked(state, reading, clock, now)
        }
    } catch (error: Throwable) {
        state.lock.withLock { terminateH1(state, error) }
    }
    driveH1Close(state)
}

// Called under the state lock; disposal runs after the lock is released.
internal fun retireH1IdleAlarms(state: H1State, actions: ArrayList<() -> Unit>) {
    val read = state.readAlarm
    val write = state.writeAlarm
    state.readAlarm = None
    state.writeAlarm = None
    if (present(read)) {
        val timer = read!!.notification
        if (present(timer))
            actions.add { timer!!.dispose() }
    }
    if (present(write)) {
        val timer = write!!.notification
        if (present(timer))
            actions.add { timer!!.dispose() }
    }
}
