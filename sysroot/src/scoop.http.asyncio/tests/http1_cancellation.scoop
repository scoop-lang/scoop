package scoop.http.asyncio

import scoop.asyncio.*
import scoop.http.*
import scoop.platform.concurrent.Thread
import scoop.platform.memory.NativeByteBuffer
import scoop.test.*

@Test
private class AsyncHttp1CancellationTests {
    @Test
    fun `borrowed body input is rejected before framing and leaves the connection usable`() {
        withHttp1 suspend {
            _, _, _, client, server ->
            val writer = client.sendRequest(request("POST"), Http1BodyFraming.Length(3L))
            NativeByteBuffer.allocate(3L).use suspend {
                buffer ->
                buffer.writeBytes("abc".toByteArray())
                @Unsafe
                {
                    val borrowed = buffer.borrowReadable(3L)
                    try {
                        try {
                            writer.writeFrom(buffer, 3L)
                            fail(Some("borrowed body input accepted"))
                        } catch (_: IllegalStateException) {}
                        assertEquals(0L, buffer.readPosition)
                        assertFalse(client.isClosed)
                    } finally {
                        borrowed.complete(0L)
                    }
                }
                assertEquals(3L, writer.writeFrom(buffer, 3L))
            }
            writer.finish()
            assertEquals("abc", String.fromUtf8(receiveBytes(server.receiveRequest()!!.body)))
            server.sendResponse(response()).finish()
            assertEquals(0L, receiveBytes(client.receiveResponse().body).size)
            assertTrue(client.isReusable && server.isReusable)
        }
    }

    @Test
    fun `cancellation remains primary when transport closure overtakes a pending read`() {
        withHttp1 suspend {
            scope, transport, _, client, server ->
            client.sendRequest(request()).finish()
            receiveBytes(server.receiveRequest()!!.body)
            server.sendResponse(response(), Http1BodyFraming.Length(1L))
            val incoming = client.receiveResponse()
            val release = AsyncGate()
            transport.readGate = Some(release)
            transport.readStarted = AsyncGate()
            val cancelled = AtomicBoolean(false)
            NativeByteBuffer.allocate(1L).use suspend {
                buffer ->
                val reading =
                    scope.launch suspend {
                        try {
                            incoming.body.readInto(buffer, 1L);
                            fail(Some("cancelled read succeeded"))
                        }
                        catch (_: CancellationException) {
                            cancelled.store(true)
                        }
                    }
                transport.readStarted.await()
                reading.cancel()
                transport.closeStarted.await()
                assertFalse(reading.isCompleted)
                release.signal()
                reading.join()
                buffer.clear()
                assertTrue(cancelled.load() && client.isClosed)
                assertEquals(1, transport.closes)
            }
        }
    }

    @Test
    fun `pending body cancellation and concurrent close await the same cleanup`() {
        withHttp1 suspend {
            scope, a, _, client, server ->
            client.sendRequest(request()).finish()
            receiveBytes(server.receiveRequest()!!.body)
            server.sendResponse(response(), Http1BodyFraming.Length(5L))
            val incoming = client.receiveResponse()
            val release = AsyncGate()
            a.closeGate = Some(release)
            a.readStarted = AsyncGate()
            val returned = AtomicBoolean(false)
            NativeByteBuffer.allocate(1L).use suspend {
                buffer ->
                val reading =
                    scope.launch suspend {
                        try {
                            incoming.body.readInto(buffer, 1L);
                            fail(Some("cancelled body read succeeded"))
                        }
                        catch (_: CancellationException) {
                            returned.store(true)
                        }
                        finally {
                            buffer.clear();
                            client.close()
                        }
                    }
                a.readStarted.await()
                buffer.clear()
                val cancelling = Thread.start { reading.cancel() }
                a.closeStarted.await()
                val first = scope.launch suspend { client.close() }
                val second = scope.launch suspend { client.close() }
                assertFalse(
                    returned.load() ||
                        reading.isCompleted ||
                        first.isCompleted ||
                        second.isCompleted
                )
                release.signal()
                reading.join();
                first.join();
                second.join();
                cancelling.join()
                assertTrue(returned.load() && client.isClosed)
                assertEquals(1, a.closes)
            }
        }
    }

    @Test
    fun `cancelling an idle unfinished writer closes its connection`() {
        withHttp1 suspend {
            scope, a, _, client, _ ->
            val created = AsyncGate()
            val release = AsyncGate()
            val sending =
                scope.launch suspend {
                    val writer = client.sendRequest(request("POST"), Http1BodyFraming.Length(5L))
                    created.signal()
                    try {
                        release.await()
                    } finally {
                        writer.close()
                    }
                }
            created.await()
            sending.cancel()
            a.closeStarted.await()
            release.signal();
            sending.join();
            client.close()
            assertTrue(client.isClosed)
            assertEquals(1, a.closes)
        }
    }

    @Test
    fun `unaccepted body and write and cleanup failures are preserved`() {
        withHttp1 suspend {
            _, a, _, client, _ ->
            val writer = client.sendRequest(request("POST"), Http1BodyFraming.Length(3L))
            a.failWrite = true;
            a.failClose = true
            NativeByteBuffer.allocate(3L).use suspend {
                buffer ->
                buffer.writeBytes("abc".toByteArray())
                try {
                    writer.writeFrom(buffer, 3L);
                    fail(Some("write failure ignored"))
                }
                catch (error: ResourceUseException) {
                    assertTrue(error.primaryFailure is TransportFailure)
                    assertTrue(error.cleanupFailure is CleanupFailure)
                }
                assertEquals(0L, buffer.readPosition)
                buffer.clear()
                assertTrue(client.isClosed)
                assertEquals(1, a.closes)
            }
        }
    }

    @Test
    fun `body progress survives partial payload and framing failures`() {
        for (
            scenario in [
                (Http1BodyFraming.Length(3L), 2L, 2L),
                (Http1BodyFraming.Chunked, 2L, 0L),
                (Http1BodyFraming.Chunked, 6L, 3L)
            ]
        ) {
            val(framing, failAfter, consumed) = scenario
            withHttp1 suspend {
                _, transport, _, client, _ ->
                val writer = client.sendRequest(request("POST"), framing)
                transport.failWriteAfter = Some(failAfter)
                NativeByteBuffer.allocate(3L).use suspend {
                    buffer ->
                    buffer.writeBytes("abc".toByteArray())
                    try {
                        writer.writeFrom(buffer, 3L)
                        fail(Some("partial write failure ignored"))
                    } catch (_: TransportFailure) {}
                    assertEquals(consumed, buffer.readPosition)
                    buffer.clear()
                    assertTrue(client.isClosed)
                    assertEquals(1, transport.closes)
                }
            }
        }
    }

    @Test
    fun `adoption validation and pre-cancellation retain caller ownership`() {
        val loop = eventLoop()
        loop.run {
            val scope = this;
            val(a, b) = rawPair(loop, scope)
            try {
                try {
                    AsyncHttp1Connection.takeOwnershipAsClient(
                        a,
                        scope,
                        limits = Http1Limits(maxStartLineBytes = 0L)
                    )
                    fail(Some("invalid limits accepted"))
                } catch (_: IllegalArgumentException) {
                    assertEquals(0, a.closes)
                }
                val child =
                    scope.launch suspend {
                        currentJobOrNone()!!.cancel()
                        try {
                            AsyncHttp1Connection.takeOwnershipAsClient(a, scope);
                            fail(Some("cancelled adoption succeeded"))
                        }
                        catch (_: CancellationException) {
                            assertEquals(0, a.closes)
                        }
                    }
                child.join()
                assertEquals(0L, a.reads + a.writes)
            } finally {
                a.close();
                b.close()
            }
        }
    }
}
