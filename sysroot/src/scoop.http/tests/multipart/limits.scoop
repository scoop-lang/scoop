package scoop.http

import scoop.test.*

@Test
private class MultipartLimitTests {
    @Test
    fun `header and field limits count actual input including line endings and folds`() {
        val wire = "--b\r\nX:a\r\n\r\nx\r\n--b--"
        MultipartDecoder(
            MultipartBoundary("b"),
            multipartLimits {
                this.maxHeaderBytes = 7L
                this.maxFields = 1L
            }
        ).use { decoder -> assertEquals(1L, feedMp(decoder, wire.toByteArray()).parts.size) }
        mpLimit(
            wire,
            multipartLimits { this.maxHeaderBytes = 6L },
            MultipartLimitKind.HeaderBytes,
            6L
        )
        mpLimit(wire, multipartLimits { this.maxFields = 0L }, MultipartLimitKind.Fields, 0L)
        mpLimit(
            "--b\r\nX:a\r\n\tb\r\n\r\nx\r\n--b--",
            multipartLimits { this.maxHeaderBytes = 10L },
            MultipartLimitKind.HeaderBytes,
            10L
        )
        mpLimit(
            "--b\r\nX:a\r\nX:b\r\n\r\nx\r\n--b--",
            multipartLimits { this.maxFields = 1L },
            MultipartLimitKind.Fields,
            1L
        )
    }

    @Test
    fun `part and transport padding limits distinguish empty multipart and empty parts`() {
        MultipartDecoder(MultipartBoundary("b"), multipartLimits { this.maxParts = 0L }).use {
            decoder -> assertEquals(1L, feedMp(decoder, "--b--".toByteArray()).ends)
        }
        mpLimit(
            "--b\r\n\r\n--b--",
            multipartLimits { this.maxParts = 0L },
            MultipartLimitKind.Parts,
            0L
        )
        mpLimit(
            "--b\r\n\r\nx\r\n--b\r\n\r\ny\r\n--b--",
            multipartLimits { this.maxParts = 1L },
            MultipartLimitKind.Parts,
            1L
        )
        MultipartDecoder(
            MultipartBoundary("b"),
            multipartLimits { this.maxBoundaryPaddingBytes = 1L }
        ).use {
            decoder -> assertEquals(
                1L,
                feedMp(decoder, "--b \r\n\r\nx\r\n--b--\t".toByteArray()).parts.size
            )
        }
        mpLimit(
            "--b \t\r\n\r\nx\r\n--b--",
            multipartLimits { this.maxBoundaryPaddingBytes = 1L },
            MultipartLimitKind.BoundaryPaddingBytes,
            1L
        )
        mpLimit(
            "--b\r\n\r\nx\r\n--b-- \t",
            multipartLimits { this.maxBoundaryPaddingBytes = 1L },
            MultipartLimitKind.BoundaryPaddingBytes,
            1L
        )
    }

    @Test
    fun `invalid configuration is rejected before any input exists`() {
        assertFailsWith<IllegalArgumentException> { multipartLimits { this.maxHeaderBytes = -1L } }
        assertFailsWith<IllegalArgumentException> { multipartLimits { this.maxFields = -1L } }
        assertFailsWith<IllegalArgumentException> { multipartLimits { this.maxParts = -1L } }
        assertFailsWith<IllegalArgumentException> {
            multipartLimits { this.maxBoundaryPaddingBytes = -1L }
        }
        assertFailsWith<IllegalArgumentException> { multipartLimits { this.dataChunkBytes = 0L } }
    }
}

private fun mpLimit(wire: String, limits: MultipartLimits, kind: MultipartLimitKind, limit: Long) {
    MultipartDecoder(MultipartBoundary("b"), limits).use {
        decoder ->
        val error =
            assertFailsWith<MultipartLimitException> { feedMp(decoder, wire.toByteArray(), 1L) }
        assertTrue(error.kind == kind)
        assertEquals(limit, error.limit)
    }
}
